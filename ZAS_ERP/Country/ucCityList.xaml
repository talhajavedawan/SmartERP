<UserControl x:Class="ZAS_ERP.Country.ucCityList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Country" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu>
            <MenuItem Header="Add City">
                <MenuItem Header="Add City" Click="MbtnAdd_Click">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Update City" Click="MbtnUpdate_Click">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Refresh" x:Name="mbtnRefresh" Click="MbtnRefresh_Click"/>
        </Menu>

        <TextBlock x:Name="lblHeading" Text="City List" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  />

        <dxg:GridControl x:Name="grdCntrlCityList" 
                         AutoGenerateColumns="AddNew"
                         EnableSmartColumnsGeneration="False"
                         Grid.Row="2">

            <dxg:GridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add New"
                                Click="MbtnAdd_Click" x:Name="mbtnAdd">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Update"
                                    x:Name="mbtnUpdate" Click="MbtnUpdate_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </dxg:GridControl.ContextMenu>

            <dxg:GridControl.View>
                <dxg:TableView x:Name="tblCityView"
                               AllowEditing="False"
                               AllowPerPixelScrolling="True"
                        RowAnimationKind="None"
                        ShowAutoFilterRow="True"
                        ShowTotalSummary="True"
                        WaitIndicatorType="Panel"/>
            </dxg:GridControl.View>

            <dxg:GridColumn FieldName="Id"
                            Visible="False"
                            ShowInColumnChooser="False"/>

            <dxg:GridColumn FieldName="CityName"
                            Header="City"
                            Visible="True"
                            AllowEditing="false"/>

            <dxg:GridColumn FieldName="Abbriviation"
                            Header="Abbriviation"
                            Visible="True"
                            AllowEditing="false"/>

            <dxg:GridColumn FieldName="PostalCode"
                            Header="Postal Code"
                            Visible="True"
                            AllowEditing="false"/>

            <dxg:GridColumn FieldName="country.CountryName"
                            Header="Country"
                            Visible="True"
                            AllowEditing="false"/>

            <dxg:GridColumn FieldName="country.CountryCode"
                            Header="Country Code"
                            Visible="True"
                            AllowEditing="false"/>
        </dxg:GridControl>
    </Grid>
</UserControl>
