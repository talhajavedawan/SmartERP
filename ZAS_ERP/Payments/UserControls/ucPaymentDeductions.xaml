<dx:DXWindow
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Payments.UserControls"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:Databases="clr-namespace:ERP_BL.Databases;assembly=ERP_BL"  x:Class="ZAS_ERP.Payments.UserControls.ucPaymentDeductions"
    mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="820" MaxHeight="600" MaxWidth="820" ResizeMode="NoResize" Closing="DXWindow_Closing" Loaded="UserControl_Loaded">
    <dx:DXWindow.Resources>
        <dx:EntitySimpleDataSource x:Key="EntitySimpleDataSource" ContextType="{x:Type Databases:DBContextERP}" Path="taxNames">
            <dx:DesignDataManager.DesignData>
                <dx:DesignDataSettings RowCount="5"/>
            </dx:DesignDataManager.DesignData>
        </dx:EntitySimpleDataSource>
    </dx:DXWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="lblHeadingDeductions" Text="Attach Payment Deductions" FontSize="11" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="0" FontFamily="Segoe UI Semibold"  />
        <dxg:GridControl x:Name="grdDeductions" Grid.Row="1"
                           SelectionMode="Cell"
                         dx:DXSerializer.SerializationID="grid">
            <dxg:GridControl.View>



                <dxg:TableView  ShowGroupPanel="False"
                           NewItemRowPosition="Bottom"
                           AllowColumnFiltering="False"
                          AutoWidth="True"
                           ShowHorizontalLines="True"
                           ShowVerticalLines="True"
                               InitNewRow="View_InitNewRow"
                               ShowCheckBoxSelectorInGroupRow="True"
                               x:Name="View"/>
            </dxg:GridControl.View>
            <dxg:GridColumn Header="Id"
                            FieldName="Id"
                            IsSmart="True" Visible="False"
                             VisibleIndex="0"/>
            <dxg:GridColumn  VisibleIndex="1"
                FieldName="deduction"
                          Header="Deduction"
                          IsSmart="True"
                          UnboundType="bound"
                          UnboundExpression="[title]" SortOrder="Ascending" SortIndex="0">
                <dxg:GridColumn.DisplayTemplate>
                    <ControlTemplate>
                        <TextBlock Text="{Binding RowData.Row.deduction.title}"/>
                    </ControlTemplate>
                </dxg:GridColumn.DisplayTemplate>
                <dxg:GridColumn.EditSettings>
                    <dxg:LookUpEditSettings x:Name="lookupDeductionsGrid"
                                      AutoPopulateColumns="False"
                                      IsPopupAutoWidth="False"
                                      DisplayMember="title"
                                      NullText="Select Item">
                        <dxg:LookUpEditSettings.PopupContentTemplate>
                            <ControlTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"
                                       MaxHeight="300"/>
                                    </Grid.RowDefinitions>
                                    <Button x:Name="btnAddItem"
                              Click="btnAddDeduction_Click"
                              VerticalAlignment="Center"
                              Content="--Add New--" />
                                    <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                        <dxg:GridColumn FieldName="title" />
                                    </dxg:GridControl>
                                </Grid>
                            </ControlTemplate>
                        </dxg:LookUpEditSettings.PopupContentTemplate>
                    </dxg:LookUpEditSettings>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>



            <dxg:GridColumn Header="Amount"
                            FieldName="Amount"
                             VisibleIndex="3"/>

            <dxg:GridColumn Header="Chart of Account"
                            FieldName="deduction.COA.accountName"
                             VisibleIndex="4"/>



        </dxg:GridControl>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
        <TextBlock x:Name="lblHeadingVAT" Text="Attach VAT"  FontSize="11" FontWeight="Bold"  HorizontalAlignment="Center"  FontFamily="Segoe UI Semibold"  />
            <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center">
                <dxe:CheckEdit Content="Adjusted" x:Name="chkIsAdjusted" Checked="ChkIsAdjusted_Checked" Unchecked="ChkIsAdjusted_Unchecked"/>
                <dxe:CheckEdit Content="Non-Adjusted" Margin="30 0 0 0" x:Name="chkNonAdjusted" Checked="ChkNonAdjusted_Checked" Unchecked="ChkNonAdjusted_Unchecked"/>
            </StackPanel>
        </Grid>
        <dxg:GridControl x:Name="grdVAT" Grid.Row="3"
                           SelectionMode="Cell"
                         dx:DXSerializer.SerializationID="grid">
            <dxg:GridControl.View>



                <dxg:TableView  ShowGroupPanel="False"
                           NewItemRowPosition="Bottom"
                           AllowColumnFiltering="False"
                          AutoWidth="True"
                           ShowHorizontalLines="True"
                           ShowVerticalLines="True"
                               InitNewRow="View_InitNewRow"
                               ShowCheckBoxSelectorInGroupRow="True"
                               x:Name="tblViewVAT"
                                CellValueChanged="TblViewVAT_CellValueChanged"/>
            </dxg:GridControl.View>
            <dxg:GridColumn Header="Id"
                            FieldName="Id"
                            IsSmart="True" Visible="False"
                             VisibleIndex="0"/>

            <!--<dxg:GridColumn Header="Is Adjusted"
                            FieldName="IsAdjusted"
                            AllowEditing="true"
                             VisibleIndex="0"
                            UnboundType="boolean">
                <dxg:GridColumn.CellTemplate>
                    <DataTemplate>
                        <CheckBox x:Name="chkIsAdjusted"  
                                   IsChecked="{Binding RowData.Row.IsChecked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Checked="ChkIsAdjusted_Checked" Unchecked="ChkIsAdjusted_Unchecked">
                        </CheckBox>
                    </DataTemplate>
                </dxg:GridColumn.CellTemplate>
                --><!--<dxg:GridColumn.EditSettings>
                    <dxe:CheckEditSettings ></dxe:CheckEditSettings>
                </dxg:GridColumn.EditSettings>--><!--
            </dxg:GridColumn>-->

            <!--<dxg:GridColumn Header="Non Adjusted"
                            FieldName="NonAdjusted"
                            AllowEditing="true"
                             VisibleIndex="1"
                            UnboundType="boolean">
                <dxg:GridColumn.CellTemplate>
                    <DataTemplate>
                        <CheckBox x:Name="chkNonAdjusted"  
                                   IsChecked="{Binding RowData.Row.IsChecked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Checked="ChkNonAdjusted_Checked" Unchecked="ChkNonAdjusted_Unchecked">
                        </CheckBox>
                    </DataTemplate>
                </dxg:GridColumn.CellTemplate>
            </dxg:GridColumn>-->

            <dxg:GridColumn  VisibleIndex="1"
                FieldName="taxName"
                          Header="VAT"
                          IsSmart="True"
                          UnboundType="bound"
                          UnboundExpression="[Name]" SortOrder="Ascending" SortIndex="0">
                <dxg:GridColumn.DisplayTemplate>
                    <ControlTemplate>
                        <TextBlock Text="{Binding RowData.Row.taxName.Name}"/>
                    </ControlTemplate>
                </dxg:GridColumn.DisplayTemplate>
                <dxg:GridColumn.EditSettings>
                    <dxg:LookUpEditSettings x:Name="lookupVAT"
                                      AutoPopulateColumns="False"
                                      IsPopupAutoWidth="False"
                                      DisplayMember="Name"
                                      NullText="Select Item">
                        <dxg:LookUpEditSettings.PopupContentTemplate>
                            <ControlTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"
                                       MaxHeight="300"/>
                                    </Grid.RowDefinitions>
                                    <Button x:Name="btnAddItem"
                              Click="btnAddDeduction_Click"
                              VerticalAlignment="Center"
                              Content="--Add New--" />
                                    <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                        <dxg:GridColumn FieldName="Name" />
                                    </dxg:GridControl>
                                </Grid>
                            </ControlTemplate>
                        </dxg:LookUpEditSettings.PopupContentTemplate>
                    </dxg:LookUpEditSettings>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>



            <dxg:GridColumn Header="Amount"
                            FieldName="Amount"
                             VisibleIndex="3"/>

            <dxg:GridColumn Header="Chart of Account"
                            FieldName="taxName.chartofAccount.accountName"
                             VisibleIndex="4"/>



        </dxg:GridControl>

        <!--<dxe:ListBoxEdit Grid.Row="4" x:Name="lstBoxVAT">
            
            <dxe:ListBoxEdit.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add More" x:Name="mbtnAddMore" Click="MbtnAddMore_Click"/>
                    <MenuItem Header="Delete" x:Name="mbtnDelete" Click="MbtnDelete_Click"/>
                </ContextMenu>
            </dxe:ListBoxEdit.ContextMenu>
            <StackPanel Orientation="Horizontal" Background="#577aae" Height="20" Grid.Row="3" VerticalAlignment="Center" x:Name="stackBillData">
                <TextBlock x:Name="txtId"  Text="0" Width="90" Visibility="Collapsed"/>
                <TextBlock Text="Adjusted" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Width="90"/>
                <TextBlock Text="Non-Adjusted" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Width="90"/>
                <TextBlock Text="VAT" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Width="200" Margin="15 0 0 0"/>
                <TextBlock Text="COA" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Width="150" Margin="15 0 0 0"/>
                <TextBlock Text="Percentage" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Width="100" Margin="15 0 0 0" />
                <TextBlock Text="Tax Amount" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Width="100" Margin="15 0 0 0" />
            </StackPanel>
            <local:ucTaxRow x:Name="ucVATrow"/>
        </dxe:ListBoxEdit>-->
        
        <Button Content="Save" FontSize="22" Grid.Row="5" Click="Button_Click"/>
    </Grid>
</dx:DXWindow>
