<dx:ThemedWindow
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Payments.UserControls.ucPaymentSharedReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Payments.UserControls"
        xmlns:loc="clr-namespace:ZAS_ERP"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    mc:Ignorable="d"
        Title="ucPaymentSharedReport" Icon="{dx:DXImage Image=Report_16x16.png}" Height="450" Width="800" Loaded="ThemedWindow_Loaded">
    <Window.Resources>
        <loc:MyConv x:Key="valueconverter"/>
    </Window.Resources>
    <Grid>
        <GroupBox>
            <Grid x:Name="reportMainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <dxr:RibbonControl Grid.Row="0" Grid.RowSpan="2" DockPanel.Dock="Top" RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
                    <dxr:RibbonDefaultPageCategory>
                        <dxr:RibbonPage  x:Name="lblHeading" Caption="Home" ToolTip="Report Name" >
                            <dxr:RibbonPageGroup  Caption="Clipboard">

                                <dxb:BarButtonItem x:Name="btnPrintPreview" KeyGesture="Ctrl+P"  Cursor="Hand" Content="Print Preview" ItemClick="BtnPrintPreview_ItemClick"  Glyph="{dx:DXImage Image=Printer_32x32.png}" LargeGlyph="{dx:DXImage Image=Printer_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnRename"  KeyGesture="Ctrl+X" Cursor="Hand" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_16x16.png}" />
                                <dxb:BarButtonItem x:Name="btnUpdate" KeyGesture="Ctrl+U" Cursor="Hand" Content="Update" ItemClick="MbtnUpdateReport1_Click" Glyph="{dx:DXImage Image=Reset_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnDelete" KeyGesture="Delete" Cursor="Hand" Content="Delete" ItemClick="MbtnDeleteReport1_Click" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>
                                <dxb:BarButtonItem x:Name="btnCopy2" KeyGesture="Ctrl+R" Cursor="Hand" Content="Refresh" ItemClick="MbtnRefreshReport1_Click"  Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                                <dxb:BarSplitButtonItem Content="Viewers" RibbonStyle="SmallWithText" Glyph="{dx:DXImage Image=Team_16x16.png}" >
                                    <dxb:BarSplitButtonItem.PopupControl>
                                        <dxb:PopupControlContainerInfo>
                                            <dxg:GridControl x:Name="grdEmployee"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                             MaxHeight="1000"
                                             MaxWidth="300"
                                                             
                                     Grid.Row="1"
                                     SelectionMode="Row"
                                      AllowInitiallyFocusedRow="False"
                                     >
                                                <dxg:GridControl.View>
                                                    <dxg:TableView x:Name="viewTableEmployee"
                               AutoWidth="True"
                                 ShowGroupPanel="False"
                              
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">
                                                    </dxg:TableView>

                                                </dxg:GridControl.View>
                                                <dxg:GridColumn x:Name="EmpId"
                                    FieldName="EmpId"
                                    IsSmart="True"
                                    Visible="False" />
                                                <dxg:GridColumn FieldName="person.Photo"
                                                VisibleIndex="0"
                                                    Header=" ">
                                                    <dxg:GridColumn.EditSettings>
                                                        <dxe:ImageEditSettings/>
                                                    </dxg:GridColumn.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn FieldName="person.FName"
                                                  VisibleIndex="1"
                                                    Header="First Name"/>
                                                <dxg:GridColumn FieldName="person.LName"
                                                  VisibleIndex="2"
                                                    Header="Last Name"/>
                                            </dxg:GridControl>
                                        </dxb:PopupControlContainerInfo>
                                    </dxb:BarSplitButtonItem.PopupControl>
                                </dxb:BarSplitButtonItem>

                            </dxr:RibbonPageGroup>
                            <!--<dxr:RibbonPageGroup Caption="Font">
                                <dxr:BarButtonGroup>
                                    <dxb:BarButtonItem Content="Export to Standard" Glyph="{dx:DXImage Image=Bold_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Italic" Glyph="{dx:DXImage Image=Italic_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Underline" Glyph="{dx:DXImage Image=Underline_16x16.png}"/>
                                </dxr:BarButtonGroup>

                            </dxr:RibbonPageGroup>-->
                        </dxr:RibbonPage>

                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>

                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <dxe:ImageEdit Grid.Column="0" Width="100" Height="100" ShowMenu="False" x:Name="UserImage" />
                    <StackPanel Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center">
                        <Label Content="Organized By" FontWeight="DemiBold" />
                        <TextBlock x:Name="txtUserName" FontWeight="SemiBold" Margin="10 0 0 0" TextWrapping="WrapWithOverflow" HorizontalAlignment="Left" Text="User Name"/>
                        <TextBlock x:Name="txtDesignation" Margin="10 5 0 0" TextWrapping="WrapWithOverflow" HorizontalAlignment="Left" Text="Designation"/>
                    </StackPanel>
                </Grid>
                <!--ReportGridControl-->
                <dxg:GridControl Grid.Row="2"
            AutoGenerateColumns="AddNew"
                                 Grid.ColumnSpan="2"
            EnableSmartColumnsGeneration="True"
            Name="grdPaymentRegister"
CustomUnboundColumnData="GrdPaymentList_CustomUnboundColumnData"
            MouseDoubleClick="GrdPaymentList_MouseDoubleClick"
                         >


                    <dxg:GridControl.View>
                        <dxg:TableView
                        AllowEditing="False"
                        AllowPerPixelScrolling="True"
                        Name="tblViewPayments"
                        RowAnimationKind="None"
                        ShowAutoFilterRow="True"
                        ShowTotalSummary="True"
                        WaitIndicatorType="Panel">

                        </dxg:TableView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn x:Name="colstatus"
                      FieldName="Status.Status"
                      Header="Status"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="1"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.Status.backcolor}"/>
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.Status.Status}"/>
                  </InlineUIContainer></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colTransactionType"
                      FieldName="transactionType"
                      Header="Module"
                      UnboundType="Bound"
                      AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="2"/>

                    <dxg:GridColumn x:Name="colTemplate"
                      FieldName="paymentAdminBillTemplate"
                      Header="Template"
                      UnboundType="Bound"
                      AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="3"/>

                    <dxg:GridColumn x:Name="colCreationDate"
                      FieldName="CreationDate"
                      Header="Creation Date"
                      UnboundType="Bound"
                            AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="4">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colCompany"
                      FieldName="company.CompanyName"
                      Header="Company"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="5"/>

                    <dxg:GridColumn x:Name="colDepartments"
                      FieldName="departments"
                      Header="Departments"
                      IsSmart="True"
                      Visible ="False"
                            ShowInColumnChooser="False"
                            AllowEditing="false"
                      VisibleIndex="6"/>

                    <dxg:GridColumn x:Name="colDeps"
                      FieldName="Depts"
                      Header="Departments"
                      UnboundType="string"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="7"/>

                    <dxg:GridColumn x:Name="colCreditCardBank"
                      FieldName="creditCardBank.BankName"
                      Header="Credit Card Bank"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="7"/>

                    <dxg:GridColumn x:Name="colCreditCardNo"
                      FieldName="primaryCreditCardNo.CardNumber"
                      Header="Primary Card #"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="8"/>

                    <dxg:GridColumn x:Name="colVendor"
                      FieldName="adminBill.vendor.company.CompanyName"
                      Header="Vendor"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="9"/>

                    <dxg:GridColumn x:Name="colDebitedDate"
                      FieldName="DebitedDate"
                      Header="Debited Date"
                      UnboundType="Bound"
                            AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="10">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colPaymentDate"
                      FieldName="PaymentDate"
                      Header="Payment Date"
                      UnboundType="Bound"
                            AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="11">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colSystemRefNo"
                      FieldName="SystemRefNo"
                      Header="System Ref #"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="12"/>

                    <dxg:GridColumn x:Name="colPaymentRefNo"
                      FieldName="PaymentRefNo"
                      Header="Payment Ref No"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="13"/>

                    <dxg:GridColumn x:Name="colCurrency"
                      FieldName="currency.CurrencyName"
                      Header="Currency"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="14"/>

                    <dxg:GridColumn x:Name="colPaymentRefNo1"
                      FieldName="PaymentRefNo1.BillReferenceNo"
                      Header="Payment Ref # 1"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="15"/>

                    <dxg:GridColumn x:Name="colPaymentAmount"
                      FieldName="PaymentAmount"
                      Header="Payment Amount"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="16">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colPaymentMethod"
                      FieldName="paymentMethod.MethodName"
                      Header="Payment Method"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="17"/>

                    <dxg:GridColumn x:Name="colBank"
                      FieldName="bank.BankName"
                      Header="Bank"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="18"/>

                    <dxg:GridColumn x:Name="colAccount"
                      FieldName="account.AccountNo"
                      Header="Account No"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="19"/>

                    <!--<dxg:GridColumn x:Name="colIndustryType"
                      FieldName="industryType.name"
                      Header="Industry Type"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="12"/>-->



                    <dxg:GridColumn x:Name="colInstrumentNo"
                      FieldName="InstrumentNo"
                      Header="Instrument #"
                      UnboundType="String"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="20"/>

                    <dxg:GridColumn x:Name="colInstrumentDate"
                      FieldName="InstrumentDate"
                      Header="Instrument Date"
                      UnboundType="Bound"
                            AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="21">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colBillCreationDate"
                      FieldName="BillCreationDate"
                      Header="Bill Creation Date"
                      UnboundType="Bound"
                            AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="22">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colBillFinanceRefNo"
                      FieldName="BillFinanceRefNo"
                      Header="Bill Fin Ref #"
                      UnboundType="String"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="23"/>

                    <dxg:GridColumn x:Name="colBillNumber"
                      FieldName="BillNumber"
                      Header="Bill Number"
                      UnboundType="String"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="24"/>

                    <dxg:GridColumn x:Name="colBillingMonth"
                      FieldName="BillingMonth"
                      Header="Billing Month"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="25" 
                            AllowEditing="false"
                      SortOrder="Ascending">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings MaskUseAsDisplayFormat="True" Mask="MMM yyyy" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colBillDueDate"
                      FieldName="BillDueDate"
                      Header="BillDueDate"
                      UnboundType="Bound"
                            AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="26">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>



                    <dxg:GridColumn x:Name="colBillAmount"
                      FieldName="BillAmount"
                      Header="Bill Amount"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="27">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colDebitedAmount"
                      FieldName="DebitedAmount"
                      Header="Debited Amount"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="true"
                      VisibleIndex="28">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colDeductions"
                      FieldName="Deductions"
                      Header="Deductions"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="29">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>







                    <dxg:GridColumn FieldName="Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="transactionGroupId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="AdminBill_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="adminBill" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="company_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="company" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="dept_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="department" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="creditCardBankId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="creditCardBank" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="PrimaryCreditCardNoId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="primaryCreditCardNo" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

                    <dxg:GridColumn FieldName="vendor_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="vendor" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

                    <dxg:GridColumn FieldName="PaymentRefNoId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="PaymentRefNo1" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

                    <dxg:GridColumn FieldName="currency_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="currency" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="statusId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="Status" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="paymentMethodId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="paymentMethod" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="bankId" UnboundType="Integer" Visible="False"/>
                    <dxg:GridColumn FieldName="bank" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="accountId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="account" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

                </dxg:GridControl>



                <TextBlock x:Name="reportId" Text="" Visibility="Hidden"/>
            </Grid>
        </GroupBox>


    </Grid>
</dx:ThemedWindow>
