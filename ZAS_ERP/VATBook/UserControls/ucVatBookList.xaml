                            IsSmart="True"
                            VisibleIndex="7"/>

                                            <dxg:GridColumn Header="System Ref #"
                            FieldName="SystemRefNo"
                            IsSmart="True"
                            VisibleIndex="8"/>

                                            <dxg:GridColumn Header="VAT Book Ref"
                            FieldName="vatBookRefNumber.VATBookReferenceNo"
                            IsSmart="True"
                            VisibleIndex="8"/>

