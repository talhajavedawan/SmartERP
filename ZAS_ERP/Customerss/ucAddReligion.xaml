<UserControl x:Class="ZAS_ERP.Customerss.ucAddReligion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Customerss"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="250" d:DesignWidth="350">
    <Grid>
        <dxlc:LayoutGroup  Header="                                        Religion"
                          View="GroupBox">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>

                <dxe:TextEdit Name="txtMethodName" NullText="Name" Height="20"/>
                <CheckBox Grid.Row="1" x:Name="chkIsActive" Content="Active " HorizontalAlignment="Center"/>

                <Button Content="Save" x:Name="btnSave" Grid.Row="2" Click="BtnSave_Click"/>
            </Grid>
        </dxlc:LayoutGroup>
    </Grid>
</UserControl>
