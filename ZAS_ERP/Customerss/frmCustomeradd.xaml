<dx:DXWindow xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        x:Class="ZAS_ERP.Customerss.frmCustomeradd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Customerss"
        xmlns:vali="clr-namespace:ZAS_ERP.Validations"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        
        
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
       Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Title="Customer Add"
        Height="800"
        Width="800"
        Unloaded="Wincustomeradd_Unloaded"
        x:Name="wincustomeradd"
        Loaded="wincustomeradd_Loaded"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="b2v"/>
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment"
                  Value="Center" />
                    <Setter Property="HorizontalAlignment"
                  Value="Right" />
                    <Setter Property="Foreground"
                  Value="Black" />

                    <Setter Property="Margin"
                  Value="10,10" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <DockPanel>
                <dx:DXTabControl>
                    <dx:DXTabControl.View>
                        <dx:TabControlScrollView HeaderLocation="Left"
                                     HideButtonShowMode="NoWhere"
                                     NewButtonShowMode="NoWhere"
                                     RemoveTabItemsOnHiding="False"
                                     ShowHeaderMenu="False"
                                     HeaderOrientation="Horizontal" />
                    </dx:DXTabControl.View>


                    <dx:DXTabItem Header="Customer Info" x:Name="tabCustomerInfo" IsEnabled="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">


                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>

                                <dxlc:GroupBox Header="Customer Company">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Company Name" />
                                        <dxe:TextEdit x:Name="txtBussinesName" IsEnabled="False"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TabIndex="0">

                                        </dxe:TextEdit>


                                        <TextBlock Grid.Column="2" Grid.Row="0" HorizontalAlignment="Left" Text="Industry " VerticalAlignment="Center"/>
                                        <dxg:LookUpEdit Grid.Column="4" Height="22" Grid.Row="0"
                                                    x:Name="lookupIndustry" FontWeight="Bold" IsEnabled="False"
                                                    PopupClosed="LookupIndustry_PopupClosed" 
                                                       
                                                        >
                                            <dxg:LookUpEdit.PopupContentTemplate>
                                                <ControlTemplate>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"></RowDefinition>
                                                            <RowDefinition Height="*"></RowDefinition>
                                                        </Grid.RowDefinitions>

                                                        <dxg:GridControl Grid.Row="1" AutoGenerateColumns="None" EnableSmartColumnsGeneration="True" Name="PART_GridControl" SelectionMode="MultipleRow" Loaded="PART_GridControl_Loaded">
                                                            <dxg:GridControl.View>
                                                                <dxg:TableView x:Name="tblIndustryType" ShowCheckBoxSelectorColumn="True"  />
                                                            </dxg:GridControl.View>
                                                        </dxg:GridControl>

                                                        <Button Content="Add New Industry" Click="Button_Click"/>

                                                    </Grid>



                                                </ControlTemplate>
                                            </dxg:LookUpEdit.PopupContentTemplate>

                                            <dxg:LookUpEdit.StyleSettings>
                                                <dxg:MultiSelectLookUpEditStyleSettings />
                                            </dxg:LookUpEdit.StyleSettings>

                                        </dxg:LookUpEdit>



                                        <TextBlock Grid.Row="1" Visibility="Collapsed"
                             x:Name="lbltIndustry">
                Industry :</TextBlock>


                                        <ComboBox Grid.Column="1" IsEnabled="True" Visibility="Collapsed"
                            VerticalAlignment="Center"
                            x:Name="cmbIndustry"
                            Grid.Row="1"
                            TabIndex="2"
                            SelectionChanged="cmbIndustry_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel  Orientation="Horizontal">
                                                        <TextBlock Text="{Binding id}"
                                     Visibility="Hidden" />
                                                        <TextBlock Text="{Binding name}"></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Column="0"
                             x:Name="lbltBussinesType"
                             Text="Bussines Type :"
                             Grid.Row="1">
                                        </TextBlock>


                                        <ComboBox Grid.Column="1" IsEnabled="False"
                            VerticalAlignment="Center"
                            Grid.Row="1"
                            x:Name="cmbBussinesType"
                            TabIndex="3" />


                                        <TextBlock Grid.Column="2"
                             HorizontalAlignment="Left"
                             x:Name="lblCurrency"
                             Text="Currency :"
                             Grid.Row="1">
                                        </TextBlock>



                                        <ComboBox x:Name="cmbCurrency" IsEnabled="False"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Grid.Row="1"
                           TabIndex="4" SelectionChanged="cmbCurrency_SelectedIndexChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel  Orientation="Horizontal">
                                                        <TextBlock Text="{Binding id}"
                                     Visibility="Hidden" />
                                                        <TextBlock Text="{Binding name}"></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>



                                        <CheckBox x:Name="chkisParent"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Grid.Column="1"
                                    Content="Parent"
                              Checked="chkisParent_Checked"
                                    Grid.Row="4"
                                    TabIndex="12" Foreground="Gray"/>

                                        <TextBlock Text="Customer Name"
                                x:Name="lblcustomername"
                                Visibility="{Binding IsChecked,ElementName=chkisParent,Converter={StaticResource b2v}}" 
                                Grid.Column="2"
                                Grid.Row="4" />


                                        <dxg:LookUpEdit x:Name="lookupCustomer"  IsEnabled="False"
                                  Grid.Column="3"
                                  Grid.Row="4"
                                     Visibility="{Binding IsChecked,ElementName=chkisParent,Converter={StaticResource b2v}}" 
                                  VerticalAlignment="Center"
                                  DisplayMember="company.CompanyName"
                                 AutoPopulateColumns="False"
                                  SelectedIndexChanged="lookupCustomer_SelectedIndexChanged">
                                            <dxg:LookUpEdit.PopupContentTemplate>
                                                <ControlTemplate>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"></RowDefinition>
                                                            <RowDefinition Height="*"></RowDefinition>
                                                        </Grid.RowDefinitions>

                                                        <dxg:GridControl Name="PART_GridControl"
                                           AutoPopulateColumns="True"
                                           Grid.Row="1" AllowInitiallyFocusedRow="False">
                                                            <dxg:GridControl.View>
                                                                <dxg:TreeListView Name="treeListView1"
                                                ShowAutoFilterRow="True"
                                                FadeSelectionOnLostFocus="False"
                                                ShowSelectionRectangle="True"
                                                TreeDerivationMode="Selfreference"
                                                KeyFieldName="Id"
                                                ParentFieldName="ParentID" />
                                                            </dxg:GridControl.View>
                                                            <dxg:GridColumn x:Name="colId"
                                            FieldName="Id"
                                            IsSmart="True"
                                            Visible="False" />
                                                            <dxg:GridColumn FieldName="company.CompanyName"
                                            IsSmart="True"
                                            Width="auto" />
                                                            <!--<dxg:GridColumn FieldName="company.IndustryType"
                                            IsSmart="True"
                                            Visible="False" />-->
                                                            <dxg:GridColumn x:Name="colBizType"
                                            FieldName="company.BizType"
                                            Visible="False"
                                            IsSmart="True" />
                                                            <dxg:GridColumn FieldName="contactPerson.FName"
                                            x:Name="colFname"
                                            IsSmart="True"
                                            Visible="True"
                                            Header="First Name"
                                            Width="auto" />
                                                            <dxg:GridColumn FieldName="contactPerson.LName"
                                            x:Name="colLname"
                                            IsSmart="True"
                                            Visible="True"
                                            Header="Last Name"
                                            Width="auto" />
                                                            <dxg:GridColumn FieldName="contact.ContactNo"
                                            IsSmart="True"
                                            x:Name="colcontactno"
                                            Visible="False"
                                            Header="Phone"
                                            Width="auto" />
                                                            <dxg:GridColumn FieldName="company.currency.CurrencyName"
                                            x:Name="colCurrency"
                                            IsSmart="True"
                                            Visible="False"
                                            Header="Currency" />
                                                            <dxg:GridColumn FieldName="contact.Fax"
                                            Visible="False"
                                            x:Name="colFax"
                                            IsSmart="True"
                                            Header="Fax" />
                                                            <dxg:GridColumn FieldName="contact.Email"
                                            x:Name="colEmail"
                                            IsSmart="True"
                                            Visible="False"
                                            Header="Email" />
                                                        </dxg:GridControl>
                                                    </Grid>
                                                </ControlTemplate>
                                            </dxg:LookUpEdit.PopupContentTemplate>
                                        </dxg:LookUpEdit>

                                        <CheckBox x:Name="chkisActive"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"        
                      Grid.Column="0" 
                      Content="IsActive"
                      Grid.Row="4"
                      IsChecked="True"
                      TabIndex="12" Foreground="Gray"/>
                                    </Grid>
                                </dxlc:GroupBox>





                                <dxlc:GroupBox Header="Billing Adress" Grid.Row="1">
                                    <Grid VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock Grid.Column="0"
                             Grid.Row="1"
                                                   HorizontalAlignment="Left"
                             x:Name="lbltAdressline1">
                Adress Line1:</TextBlock>
                                        <TextBox Grid.Column="2" IsEnabled="False"
                           Grid.Row="1"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           x:Name="txtAdressline1"
                           TabIndex="1" />
                                        <TextBlock Grid.Column="0"
                             Grid.Row="2"
                                                   HorizontalAlignment="Left"
                             x:Name="lbltAdressline2">
                Adress Line 2:</TextBlock>
                                        <TextBox Grid.Column="2" IsEnabled="False"
                           Grid.Row="2"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           x:Name="txtAdressline2"
                           TabIndex="7" />
                                        <TextBlock x:Name="lbltCity"
                             Grid.Column="0"
                                                   HorizontalAlignment="Left"
                             Grid.Row="4">
                Country :</TextBlock>
                                        <Grid Grid.Column="2"
                        Grid.Row="4"
                        HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <!--<TextBox Grid.Column="0" IsEnabled="False"
                             Margin="10,0"
                             VerticalAlignment="Center"
                             x:Name="txtCitya"
                             TabIndex="8">
                                                <TextBox.Text>
                                                    <Binding Path="onlychar"
                                 UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <vali:onlyalphareq />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>-->
                                            <dxg:LookUpEdit    Grid.Column="0" IsEnabled="False"  KeyUp="TxtCountry_KeyUp"
                                                                 FilterCondition="Contains" AutoComplete="True" 
                                                                 
                                                                 LostFocus="TxtCountry_LostFocus"
                                                                 Margin="10,0"
                                                                 VerticalAlignment="Center"
                                                                 x:Name="txtCountry"
                                                                 TabIndex="8"/>

                                            <TextBlock Grid.Column="1"
                               x:Name="lblState">
                State/Province :</TextBlock>
                                            <!--<TextBox >
                                                <TextBox.Text>
                                                    <Binding Path="onlychar"
                                 UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <vali:onlyalphareq />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>-->
                                            <dxg:LookUpEdit Grid.Column="2" IsEnabled="False"  FilterCondition="Contains" AutoComplete="True" LostFocus="TxtState_LostFocus" KeyUp="TxtState_KeyUp"
                             x:Name="txtState"
                             Grid.Row="3"
                             Margin="10,0"
                             VerticalAlignment="Center"
                             TabIndex="9"/>
                                        </Grid>
                                        <TextBlock Grid.Column="0"
                             Grid.Row="5"
                                                   HorizontalAlignment="Left"
                             x:Name="lbltCountry">
                City :</TextBlock>
                                        <Grid Grid.Column="2"                                               
                                              Margin="0,0,56,0"

                        Grid.Row="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1"
                               Grid.Row="4"
                               x:Name="lbltZIP">
                ZIP :</TextBlock>
                                            <TextBox Grid.Column="2" IsEnabled="False"
                             Grid.Row="4"
                             Margin="68,0,0,0"
                             VerticalAlignment="Center"
                             x:Name="txtZIP"
                             TabIndex="10">
                                                <TextBox.Text>
                                                    <Binding Path="onlychar"
                                 UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <vali:zipvalidation />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                            <TextBox Margin="10,0" IsEnabled="False"
                             VerticalAlignment="Center"
                             x:Name="txtCountrya"
                             TabIndex="11">
                                                <TextBox.Text>
                                                    <Binding Path="onlychar"
                                 UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <vali:onlyalphareq />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                            <dxg:LookUpEdit Margin="10,0" IsEnabled="False"  x:Name="txtCity" KeyUp="TxtCity_KeyUp"
                             VerticalAlignment="Center"
                             FilterCondition="Contains" AutoComplete="True"
                             TabIndex="11"/>
                                        </Grid>
                                        <TextBlock Grid.Column="0"
                             Grid.Row="3"
                                                   HorizontalAlignment="Left"
                             x:Name="lblRegionbil">
                Region:</TextBlock>

                                        <dxg:LookUpEdit  Grid.Column="2" IsEnabled="False"  FilterCondition="Contains" AutoComplete="True" Loaded="TxtRegionbil_Loaded" LostFocus="TxtRegionbil_LostFocus" KeyUp="TxtRegionbil_KeyUp"
                           Grid.Row="3"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           x:Name="txtRegionbil"
                           TabIndex="7"/>
                                    </Grid>
                                </dxlc:GroupBox>

                                <dxlc:GroupBox Header="Shipping Adress"
                             Grid.Row="2">
                                    <Grid VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="0"
                             Grid.Row="1"
                                                   HorizontalAlignment="Left"
                             x:Name="lblstAdressline1">
                Adress Line1:</TextBlock>
                                        <TextBox Grid.Column="2" IsEnabled="False"
                           Grid.Row="1"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           x:Name="txtsAdressline1"
                           TabIndex="12" />
                                        <TextBlock Grid.Column="0"
                             Grid.Row="2"
                                                   HorizontalAlignment="Left"
                             x:Name="lblstAdressline2">
                Adress Line 2:</TextBlock>
                                        <TextBox Grid.Column="2" IsEnabled="False"
                           Grid.Row="2"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           x:Name="txtsAdressline2"
                           TabIndex="13" />
                                        <TextBlock x:Name="lblstCity"
                             Grid.Column="0"
                             HorizontalAlignment="Left"                      
                             Grid.Row="5">
                City :</TextBlock>
                                        <Grid Grid.Column="2"
                        Grid.Row="5"
                                                Margin="0,0,56,0"
                        HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <dxg:LookUpEdit  Grid.Column="0" IsEnabled="False"  FilterCondition="Contains" AutoComplete="True"  KeyUp="TxtsCity_KeyUp"
                             Margin="10,0"
                             VerticalAlignment="Center"
                             x:Name="txtsCity"
                             TabIndex="14"/>
                                            <TextBlock Grid.Column="1"
                               Grid.Row="4"
                               x:Name="lblstZIP">
                ZIP :</TextBlock>
                                            <TextBox Grid.Column="2" IsEnabled="False"
                             Grid.Row="4"
                                                       Margin="68,0,0,0"
                             VerticalAlignment="Center"
                             x:Name="txtsZIP"
                             TabIndex="16">
                                                <TextBox.Text>
                                                    <Binding Path="onlychar"
                                 UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <vali:zipvalidation />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>


                                        </Grid>
                                        <TextBlock Grid.Column="0"
                             Grid.Row="4"
                                                   HorizontalAlignment="Left"
                             x:Name="lblstCountry">
                Country :</TextBlock>
                                        <Grid Grid.Column="2" Grid.Row="4">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>



                                            <dxg:LookUpEdit Margin="10,0" IsEnabled="False"  FilterCondition="Contains" AutoComplete="True"  LostFocus="TxtsCountry_LostFocus" KeyUp="TxtsCountry_KeyUp"
                                                             VerticalAlignment="Center"
                                                             x:Name="txtsCountry"
                                                             TabIndex="17"/>

                                            <TextBlock Grid.Column="1"
                                                       x:Name="lblsState">
                                                      State/Province :</TextBlock>

                                            <dxg:LookUpEdit Grid.Column="2" IsEnabled="False"  FilterCondition="Contains" AutoComplete="True"  LostFocus="TxtsState_LostFocus" KeyUp="TxtsState_KeyUp"
                                                                 x:Name="txtsState"
                                                                 Grid.Row="3"
                                                                 Margin="10,0"
                                                                 VerticalAlignment="Center"
                                                                 TabIndex="15" />

                                        </Grid>


                                        <TextBlock Grid.Column="0"
                             Grid.Row="3"
                                                   HorizontalAlignment="Left"
                             x:Name="lblRegionship">
                Region:</TextBlock>

                                        <dxg:LookUpEdit  Grid.Column="2" IsEnabled="False"  FilterCondition="Contains" AutoComplete="True" LostFocus="TxtRegionship_LostFocus" KeyUp="TxtRegionship_KeyUp"
                           Grid.Row="3"
                           Margin="10,0" 
                           VerticalAlignment="Center"
                           x:Name="txtRegionship"
                           TabIndex="7"/>
                                    </Grid>
                                </dxlc:GroupBox>


                            </Grid>
                        </ScrollViewer>
                    </dx:DXTabItem>


                    <dx:DXTabItem Header="Adress"  x:Name="tabAddressInfo" IsEnabled="False" Visibility="Collapsed"
                        IsTabStop="False">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>


                        </Grid>
                    </dx:DXTabItem>
                    <dx:DXTabItem Header="Tax Information" x:Name="tabTaxInformationInfo" IsEnabled="False">
                        <!--waqas work-->
                        <dx:DXTabControl>
                            <dx:DXTabItem Header="Tax Information">
                                <dxlc:LayoutGroup   View="Group" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="10"/>


                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>


                                        <Grid Grid.Column="4" Grid.Row="2">

                                        </Grid>
                                        <TextBlock Text="VAT #" HorizontalAlignment="Left" />
                                        <TextBox Grid.Column="1" IsEnabled="False"
                           VerticalAlignment="Center"
                           x:Name="txtVAT"
                           TabIndex="1">
                                            <TextBox.Text>
                                                <Binding Path="onlyalphanum"
                               UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <vali:digitvalidation />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>

                                        <TextBlock Grid.Column="3"
                             x:Name="lbltEIN">
                NTN # :</TextBlock>
                                        <TextBox Grid.Column="4" IsEnabled="False"
                           VerticalAlignment="Center"
                           x:Name="txtEIN"
                           TabIndex="1">
                                            <!--<TextBox.Text>
                                                <Binding Path="onlynum"
                               UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <vali:digitvalidation />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>-->
                                        </TextBox>


                                        <TextBlock Text="Sale Tax Registration #" Grid.Row="2" HorizontalAlignment="Left" />
                                        <TextBox Grid.Column="1" IsEnabled="False"
                           VerticalAlignment="Center" Grid.Row="2"
                           x:Name="txtRegistrationTaxNumber"
                           TabIndex="1">

                                        </TextBox>

                                    </Grid>



                                </dxlc:LayoutGroup>

                            </dx:DXTabItem>

                        </dx:DXTabControl>


                    </dx:DXTabItem>
                    <dx:DXTabItem Header="Contact" x:Name="tabContactInfo" IsEnabled="False"
                        IsTabStop="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">


                            <dxlc:GroupBox Header="Contact Information">
                                <Grid VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Left"
                         Grid.Row="2"
                        
                         x:Name="lbltPhonenum">
                Default Phone :</TextBlock>

                                    <Grid Grid.Row="2" Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" IsEnabled="False"
                         HorizontalAlignment="Stretch"
                         x:Name="txtPhonenum"
                         TabIndex="18">
                                            <TextBox.Text>
                                                <Binding Path="onlychar"
                             UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <vali:contactnumval />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
