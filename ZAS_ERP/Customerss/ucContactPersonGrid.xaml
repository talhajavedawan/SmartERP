<UserControl x:Class="ZAS_ERP.Customerss.ucContactPersonGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Customerss"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <dxr:RibbonControl Grid.Row="0"  RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
                    <dxr:RibbonDefaultPageCategory>
                        <dxr:RibbonPage x:Name="lblHeading"  Caption="Person Person     " ToolTip="Customer center">
                            <dxr:RibbonPageGroup  Caption="Clipboard">
                                <dxb:BarButtonItem x:Name="mbtnAddNew" Content="Add New" ItemClick="MbtnAddNew_ItemClick" Glyph="{dx:DXImage Image=AddNewDataSource_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnUpdate" Content="Update" ItemClick="MbtnUpdate_ItemClick" Glyph="{dx:DXImage Image=EditDataSource_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnSaveLayout" Content="Save Layout" ItemClick="MbtnSaveLayout_ItemClick" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>
                               
                                <dxb:BarButtonItem x:Name="mbtnRefresh" Content="Refresh" ItemClick="MbtnRefresh_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>

                                <dxb:BarButtonItem x:Name="mbtnAllContact" Content="All Contact" ItemClick="MbtnAllContact_ItemClick" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnActiveContact" Content="Active" ItemClick="MbtnActiveContact_ItemClick" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnInactiveContact" Content="In-Active" ItemClick="MbtnInactiveContact_ItemClick" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>

                            </dxr:RibbonPageGroup>
                          
                        </dxr:RibbonPage>

                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>


            </Grid>
            <TextBlock Grid.Row="1" Text="Contact Person Register" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="DemiBold"/>
            <dxg:GridControl x:Name="grdContactPersonsList" Grid.Row="2"
                            
                                     AutoGenerateColumns="None"
                                    
                                     SelectionMode="Row" MouseDoubleClick="GrdContactPersonsList_MouseDoubleClick">
                <dxg:GridControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add Contact Person"
                                  x:Name="btnAddContactPerson1" Click="Add_New_ContactClick" />
                        <MenuItem Header="Update Contact Person"
                                  x:Name="btnEditContactPerson1" Click="Edit_ContactClick" />
                    </ContextMenu>
                </dxg:GridControl.ContextMenu>

                <dxg:GridControl.View >
                    <dxg:TableView AllowPerPixelScrolling="True" 
                               ShowTotalSummary="True"
                               ShowAutoFilterRow="True" 
                               RowAnimationKind="None" 
                               WaitIndicatorType="Panel"
                               AllowEditing="False"
                               Name="tblViewLandTypeLst">
                    </dxg:TableView>
                </dxg:GridControl.View>



                <dxg:GridColumn FieldName="Id"
                                IsSmart="True"
                                Header="Id"
                                Visible="False"
                                ShowInColumnChooser="False"
                                VisibleIndex="1"
                                SortIndex="0" />

                <dxg:GridColumn FieldName="customerCompany.company.CompanyName"
                                IsSmart="True"
                                Header="company Name"
                                VisibleIndex="2"
                                SortIndex="0" />
                <dxg:GridColumn FieldName="person.FName"
                                IsSmart="True"
                                Header="Person Name"
                                VisibleIndex="3"
                                SortIndex="0" />
                <dxg:GridColumn FieldName="designation" 
                                IsSmart="True"
                                x:Name="colDesignation1"        
                                Header="Designation"
                              
                                VisibleIndex="4"
                                SortIndex="0" />
                <dxg:GridColumn FieldName="religion.ReligionName" 
                                IsSmart="True"     
                                Header="Religion"
                              
                                VisibleIndex="5"
                                SortIndex="0" />

          

                <dxg:GridColumn FieldName="person.DOB"
                                IsSmart="True"
                                x:Name="colDob1"
                                Header="DOB"
                              
                                VisibleIndex="6"
                                SortIndex="0" />

                <dxg:GridColumn FieldName="person.CNIC"
                                IsSmart="True"
                                x:Name="colCnic1"       
                                Header="CNIC"
                             
                                VisibleIndex="7"
                                SortIndex="0" />

                <dxg:GridColumn FieldName="contact.ContactNo" 
                                IsSmart="True"
                                x:Name="colContactNo1"        
                                Header="Phone 1"
                              
                                VisibleIndex="8"
                                SortIndex="0"/>

                <dxg:GridColumn FieldName="contact.SecondaryContact" 
                                IsSmart="True"
                                x:Name="colContactNo12"        
                                Header="Phone 2"
                               
                                VisibleIndex="9"
                                SortIndex="0"/>

                <dxg:GridColumn FieldName="contact.Email" 
                                IsSmart="True"
                                x:Name="colEmail1"        
                                Header="Email"
                              
                                VisibleIndex="10"
                                SortIndex="0" />
                <dxg:GridColumn FieldName="isActive" 
                                IsSmart="True"
                                Header="IsActive"
                                VisibleIndex="11"
                                SortIndex="0" />



            </dxg:GridControl>
        </Grid>
    
    </Grid>
</UserControl>
