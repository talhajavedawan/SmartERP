<UserControl x:Class="ZAS_ERP.Interest.UserControls.ucFrmInterestType"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Interest.UserControls" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400" Padding="5 5 5 5" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <dxlc:LayoutGroup View="GroupBox" Header="Add Interest Type" Orientation="Vertical">
            <dxlc:LayoutControl Height="50" Margin="0 30 0 0">
                <dxlc:LayoutItem Label="Interest Type  ">
                    <dxe:TextEdit x:Name="txtInterestType" Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" Height="25"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutControl>

            <dxlc:LayoutControl Height="50">
                <dxlc:LayoutItem Label="Is Active  ">
                    <dxe:CheckEdit x:Name="chkIsActive" Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" Height="25"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutControl>


            <!--</Grid>-->
        </dxlc:LayoutGroup>
        <Button  Content="Save" x:Name="btnSave" Click="BtnSave_Click" FontWeight="DemiBold" FontSize="20" Grid.Row="1"/>
    </Grid>

</UserControl>
