<UserControl x:Class="ZAS_ERP.Interest.UserControls.ucInterestList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Interest.UserControls" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
        d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu DockPanel.Dock="Top"
              x:Name="menuGrid">
            <MenuItem Header="Add New">
                <MenuItem Header="Add New"
                    Click="MbtnAdd_Click" >
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Edit Tax"
                    Click="MbtnUpdate_Click" >
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>


            <MenuItem Header="Refresh"
                      x:Name="mbtnRefresh"
                      Click="BtnRefresh_Click"/>
        </Menu>
        <TextBlock x:Name="lblHeading" Text="Interest Name List" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  />
        <Grid Background="White" Grid.Row="2" Height="auto">
            <dxg:GridControl AutoGenerateColumns="AddNew" 
                         EnableSmartColumnsGeneration="True" 
                         Name="grdCntrlInterestNameList">
                <!--PreviewMouseDown="GrdCntrlDeductionList_PreviewMouseDown"-->
                <dxg:GridControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add New"
                                Click="MbtnAdd_Click" x:Name="mbtnAdd">
                            <MenuItem.Icon>
                                <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Update Interest Name"
                                    x:Name="mbtnUpdate" Click="MbtnUpdate_Click">
                            <MenuItem.Icon>
                                <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </dxg:GridControl.ContextMenu>

                <dxg:GridControl.View >
                    <dxg:TableView AllowPerPixelScrolling="True" 
                               ShowTotalSummary="True"
                               ShowAutoFilterRow="True" 
                               RowAnimationKind="None" 
                               WaitIndicatorType="Panel"
                               AllowEditing="False"
                               Name="tblViewTaxNameLst">
                        <!--<dxg:TableView.RowCellMenuCustomizations>
                                <dxb:BarButtonItem Content="Add New" ItemClick="MbtnAddDeduction_ItemClick" x:Name="mbtnAddDeduction"/>
                                <dxb:BarButtonItem Content="Update" ItemClick="MbtnUpdateDeduction_ItemClick" x:Name="mbtnUpdateDeduction"/>
                            </dxg:TableView.RowCellMenuCustomizations>-->
                    </dxg:TableView>
                </dxg:GridControl.View>

                <dxg:GridColumn FieldName="Id"
                                Visible="False"
                                VisibleIndex="0"/>
                <dxg:GridColumn FieldName="Name"
                                Header="Interest Name"
                                Visible="True"
                                VisibleIndex="1"/>
                <dxg:GridColumn FieldName="interestType.TypeName"
                                Header="Interest Type"
                                Visible="True"
                                VisibleIndex="2"/>

                <dxg:GridColumn FieldName="percentage"
                                Header="Percentage"
                                Visible="True"
                                VisibleIndex="3">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" HorizontalContentAlignment="Left" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="chartofAccount.accountName"
                                Header="COA"
                                Visible="True"
                                VisibleIndex="4"/>

                <dxg:GridColumn FieldName="chartofAccount"
                                Visible="False"
                                VisibleIndex="5"/>

                <dxg:GridColumn FieldName="taxType"
                                Visible="False"
                                VisibleIndex="6"/>

                <dxg:GridColumn FieldName="COA_Id"
                                Visible="False"
                                VisibleIndex="7"/>

                <dxg:GridColumn FieldName="taxTypeId"
                                Visible="False"
                                VisibleIndex="8"/>
            </dxg:GridControl>
        </Grid>
    </Grid>
            
</UserControl>
