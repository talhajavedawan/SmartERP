<dx:DXWindow x:Class="ZAS_ERP.SaleOrderFolder.Windows.ucSaleReceiptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.SaleOrderFolder.Windows"
        xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:loc="clr-namespace:ZAS_ERP"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:local1="clr-namespace:ZAS_ERP.SaleOrderFolder.UserControls"

        mc:Ignorable="d"
        Title="ucSaleReceiptView" Height="450" Width="800" Loaded="Window_Loaded">
    
    <Grid>
        <GroupBox>
            <Grid x:Name="reportMainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <dxr:RibbonControl Grid.Row="0" DockPanel.Dock="Top"  RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
                    <dxr:RibbonDefaultPageCategory>
                        <dxr:RibbonPage x:Name="lblHeading" ToolTip="Report Name" Caption="Home"  >
                            <dxr:RibbonPageGroup  Caption="Clipboard">
                                <dxb:BarButtonItem x:Name="btnPrintPreview" KeyGesture="Ctrl+P"  Cursor="Hand" Content="Print Preview" ItemClick="BtnPrintPreview_ItemClick"  Glyph="{dx:DXImage Image=Printer_32x32.png}" LargeGlyph="{dx:DXImage Image=Printer_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnSaveAsNew" KeyGesture="Ctrl+N" Cursor="Hand" Content="Save as new" ItemClick="MbtnSaveAsNew1_Click" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>
                                <dxb:BarButtonItem x:Name="btnRename" KeyGesture="Ctrl+X" Cursor="Hand" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_32x32.png}" />
                                <dxb:BarButtonItem x:Name="btnUpdate" KeyGesture="Ctrl+U" Cursor="Hand" Content="Update" ItemClick="MbtnUpdateReport1_Click" Glyph="{dx:DXImage Image=Reset_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnDelete" KeyGesture="Delete" Cursor="Hand" Content="Delete" ItemClick="MbtnDeleteReport1_Click" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>
                                <dxb:BarButtonItem x:Name="btnCopy2" KeyGesture="Ctrl+R" Cursor="Hand" Content="Refresh" ItemClick="MbtnRefreshReport1_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToMemorizedReport1" Cursor="Hand" Content="Export to memorized" ItemClick="MbtnExportToMemorizedReport1_Click" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToStandardReport1" Cursor="Hand" ItemClick="MbtnExportToStandardReport1_Click" Content="Export to standard" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnDriectClose" Cursor="Hand" ItemClick="mbtnDriectClose_ItemClick" Content="Direct Close" />
                                <dxb:BarButtonItem x:Name="mbtnApprove" Cursor="Hand" ItemClick="mbtnApprove_ItemClick" Content="Approve" />
                            </dxr:RibbonPageGroup>
                            <!--<dxr:RibbonPageGroup Caption="Font">
                                <dxr:BarButtonGroup>
                                    <dxb:BarButtonItem Content="Export to Standard" Glyph="{dx:DXImage Image=Bold_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Italic" Glyph="{dx:DXImage Image=Italic_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Underline" Glyph="{dx:DXImage Image=Underline_16x16.png}"/>
                                </dxr:BarButtonGroup>

                            </dxr:RibbonPageGroup>-->
                        </dxr:RibbonPage>

                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>


                <!--ReportGridControl-->
                <Grid Grid.Row="2" Background="White">
                    <dxg:GridControl x:Name="grdSaleReceiptList"
                  SelectionMode="Row"  
                  ShowLoadingPanel="False"
                  CustomUnboundColumnData="GrdSaleReceiptList_CustomUnboundColumnData"           
                  MouseDoubleClick="GrdSaleReceiptList_MouseDoubleClick" 
                >


                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView"
                       
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       ShowAutoFilterRow="True"
                       Width="auto"
                       RowAnimationKind="None" WaitIndicatorType="Panel"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"              
                       ShowFixedTotalSummary="True"
                       ShowTotalSummary="True"  >


                                <dxg:TableView.FormatConditions>
                                    <dxg:DataBarFormatCondition FieldName="Sales" PredefinedFormatName="BlueGradientDataBar"/>
                                    <dxg:TopBottomRuleFormatCondition FieldName="Sales" Rule="TopItems" Threshold="5" PredefinedFormatName="BoldText" />


                                </dxg:TableView.FormatConditions>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridColumn x:Name="colstatus"
                      FieldName="saleReceiptStatus.Status"
                      Header="Status"
                      UnboundType="Bound"
                     Visible ="True"
                      VisibleIndex="1"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.saleReceiptStatus.backcolor}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.saleReceiptStatus.Status}"/>
                  </InlineUIContainer></TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <dxg:GridColumn Header="Serial No"
                            FieldName="Id"
                            IsSmart="True"
                                Visible="False"
                            Width="auto" VisibleIndex="2"/>

                        <dxg:GridColumn Header="Invoice No"
                            FieldName="saleInvoice.Id"
                            IsSmart="True"
                                
                            Width="auto" VisibleIndex="3"/>

                        <dxg:GridColumn Header="Receipt Type"
                            FieldName="receiptType"
                            IsSmart="True"
                                
                            Width="auto" VisibleIndex="4"/>

                        <dxg:GridColumn Header="Creation Date"
                            FieldName="CreationDate"
                            IsSmart="True"
                                
                            Width="auto" VisibleIndex="5"/>


                        <dxg:GridColumn Header="Company"
                            FieldName="company.CompanyName"
                            IsSmart="True"
                                
                            Width="auto" VisibleIndex="6"/>


                        <!--<dxg:GridColumn Header="Department"
                            FieldName="department.DeptName"
                            IsSmart="True"
                                
                            Width="auto" VisibleIndex="7"/>-->

                        <dxg:GridColumn Header="Department level 5"
                FieldName="departmentLevel5" UnboundType="string" x:Name="colDeptLevel5" ShowInColumnChooser="False"
                         IsSmart="True"
                            Width="auto"
                            />

                        <dxg:GridColumn Header="Department level 4"
                FieldName="departmentLevel4" UnboundType="string" x:Name="colDeptLevel4" ShowInColumnChooser="False"
                         IsSmart="True"
                            Width="auto"
                            />
                        <dxg:GridColumn Header="Department level 1" UnboundType="string" x:Name="colDeptLevel1" ShowInColumnChooser="False"
                            
                            FieldName="departmentLevel1" 
                           />
                        <dxg:GridColumn Header="Department level 2" UnboundType="string" x:Name="colDeptLevel2" ShowInColumnChooser="False"
                            FieldName="departmentLevel2"
                            />
                        <dxg:GridColumn Header="Department level 3"  UnboundType="string" x:Name="colDeptLevel3" ShowInColumnChooser="False"
                            FieldName="departmentLevel3"
                            />


                        <!--<dxg:GridColumn Header="Customer"
                            FieldName="Customer.company.CompanyName"
                            IsSmart="True"
                                
                            Width="auto" VisibleIndex="8"/>-->

                        <dxg:GridColumn Header="Customer"
                            FieldName="Customerr"
                            IsSmart="True"
                                UnboundType="string"
                            Width="auto" VisibleIndex="8"/>

                        <dxg:GridColumn Header="System Ref No"
                            FieldName="SystemRefNo"
                            IsSmart="True"
                                
                            Width="auto" VisibleIndex="9"/>

                        <dxg:GridColumn Header="Credited Date"
                            FieldName="CreditedDate"
                            IsSmart="True"
                                
                            Width="auto" VisibleIndex="5"/>


                        <dxg:GridColumn Header="Receipt Ref No"
                            FieldName="ReceiptRefNo"
                            IsSmart="True"
                                
                            Width="auto" VisibleIndex="10"/>

                        <dxg:GridColumn Header="Currency"
                            FieldName="Currency.CurrencyName"
                            IsSmart="True"
                                
                            Width="auto" VisibleIndex="11"/>

                        <dxg:GridColumn Header="Deductions"
                            FieldName="Deductionss"
                            IsSmart="True"
                                UnboundType="Decimal"
                            Width="auto" VisibleIndex="12"
                                SortMode="DisplayText"
                                ColumnFilterMode="DisplayText">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn Header="VAT"
                            FieldName="VAT"
                            IsSmart="True"
                                UnboundType="Decimal"
                            Width="auto" VisibleIndex="12"
                                SortMode="DisplayText"
                                ColumnFilterMode="DisplayText" SortOrder="Ascending" SortIndex="0">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn Header="Bank Charges"
                            FieldName="bankchargess"
                            IsSmart="True"
                                UnboundType="Decimal"
                            Width="auto" VisibleIndex="12"
                                SortMode="DisplayText"
                                ColumnFilterMode="DisplayText" SortOrder="Ascending" SortIndex="0">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>


                        <dxg:GridColumn Header="Collected Amount"
                            FieldName="CollectionAmount"
                            IsSmart="True"
                            Width="auto" VisibleIndex="13">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn Header="Total Collected Amount"
                            FieldName="TotalCollectionAmount"
                            IsSmart="True"
                            Width="auto" VisibleIndex="13">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn Header="Credited Amount"
                            FieldName="CreditedAmount"
                            IsSmart="True"
                                UnboundType="Decimal"
                            Width="auto" VisibleIndex="14">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn Header="Remaining Amount"
                            FieldName="RemainingAmount"
                            IsSmart="True"
                            UnboundType="Decimal"    
                            Width="auto" VisibleIndex="15">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>


                        <dxg:GridColumn Header="Collection Method"
                            FieldName="collectionMethod.MethodName"
                            IsSmart="True"
                                
                            Width="auto" VisibleIndex="16"/>

                        <dxg:GridColumn Header="Bank Name"
                                FieldName="bank.BankName"
                                IsSmart="True"
                                Width="auto" 
                                VisibleIndex="17"/>

                        <dxg:GridColumn Header="Account No"
                                FieldName="account.AccountNo"
                                IsSmart="True"     
                                Width="auto" 
                                VisibleIndex="18"/>

                        <dxg:GridColumn Header="Petty Cash Ref"
                                FieldName="PettyCashRef.BillReferenceNo"
                                IsSmart="True"     
                                Width="auto" 
                                VisibleIndex="18"/>

                        <dxg:GridColumn FieldName="GLPostingDate" Header="GL-Posting Date" IsSmart="True" />


                    </dxg:GridControl>
                </Grid>
            </Grid>
        </GroupBox>
        <Image
        x:Name="loadingGif"    
       
            
        Visibility="Hidden"
        Grid.Row="2"
            
         gif:AnimationBehavior.SourceUri="/ZAS_ERP;component/images/loadingReports.gif"   
        VerticalAlignment="Center"
        HorizontalAlignment="Center" RenderTransformOrigin="12.987,0.793" Margin="5,100,5,5" Width="60" />

        <dx:WaitIndicator x:Name="Loader"  DeferedVisibility="{Binding IsWaitIndicatorVisible}"  Content="{Binding WaitIndicatorText}">
            <dx:WaitIndicator.ContentTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" BorderBrush="PowderBlue" Padding="2" CornerRadius="6">
                        <StackPanel Orientation="Vertical"  >
                            <TextBlock Text="Please Wait"  FontSize="20"/>
                            <TextBlock Text="{Binding}" />
                        </StackPanel>
                    </Border>

                </DataTemplate>
            </dx:WaitIndicator.ContentTemplate>
        </dx:WaitIndicator>

    </Grid>
</dx:DXWindow>
