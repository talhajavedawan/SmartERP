<UserControl x:Class="ZAS_ERP.SaleOrderFolder.UserControls.ucFrmAddAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.SaleOrderFolder.UserControls"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Padding="5 5 5 5">
    <Grid>

        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Margin"
                Value="10,0" />
                <Setter Property="Foreground"
                Value="Gray" />
                <Setter Property="HorizontalAlignment"
                Value="Right" />
                <Setter Property="VerticalAlignment"
                Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <dx:DXTabControl>
            <dx:DXTabControl.View>
                <dx:TabControlScrollView HeaderLocation="Left"
                                 HideButtonShowMode="NoWhere"
                                 HeaderOrientation="Horizontal"
                                 AllowAnimation="True"
                                 ShowHeaderMenu="False"
                                 RemoveTabItemsOnHiding="False"
                                 NewButtonShowMode="NoWhere" />
            </dx:DXTabControl.View>

            <dx:DXTabItem Header="Account Information">
                <dxlc:LayoutGroup Header="Account Details" 
                                  Grid.Row="2"
                                          View="GroupBox" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <dxlc:LayoutControl Orientation="Horizontal" Grid.Row="0">
                            <dxlc:LayoutItem Label="Branch Name">
                                <dxg:LookUpEdit x:Name="cmbxBank" Margin="20 0 0 0" IsTextEditable="False" ValueMember="Id" DisplayMember="BankName" SelectedIndexChanged="CmbxBank_SelectedIndexChanged">
                                </dxg:LookUpEdit>
                            </dxlc:LayoutItem>
                        </dxlc:LayoutControl>

                        <dxlc:LayoutControl Orientation="Horizontal" Grid.Row="2">
                            <dxlc:LayoutItem Label="Branch Name">
                                <dxg:LookUpEdit x:Name="cmbxBranch" Margin="20 0 0 0" IsTextEditable="False" ValueMember="Id" DisplayMember="BankName" SelectedIndexChanged="CmbxBranch_SelectedIndexChanged">
                                </dxg:LookUpEdit>
                            </dxlc:LayoutItem>
                            <Separator Width="25" Background="Transparent" BorderBrush="Transparent"/>
                            <dxlc:LayoutItem Label="Account Type">
                                <dxe:ComboBoxEdit  IsTextEditable="False" x:Name="cmbxAccntType" Margin="0 0 0 0 "/>
                            </dxlc:LayoutItem>


                        </dxlc:LayoutControl>

                        <dxlc:LayoutControl Grid.Row="4">
                            <dxlc:LayoutItem Label="Currency "  Grid.Column="4" Height="22">
                                <dxg:LookUpEdit  IsTextEditable="False" Margin="38 0 0 0" x:Name="cmbxCurrency" DisplayMember="CurrencyName"/>
                            </dxlc:LayoutItem>

                            <Separator Width="25" Background="Transparent" BorderBrush="Transparent"/>

                            <dxlc:LayoutItem Label="Company " Grid.Column="2"  Height="22">
                                <dxg:LookUpEdit x:Name="cmbxCompany" 
                                    Margin="19 0 0 0"
                                    AutoPopulateColumns="True" 
                                    DisplayMember="CompanyName"
                                        IsTextEditable="False"
                                                GotFocus="CmbxCompany_GotFocus"
                                    SelectedIndexChanged="CmbxCompany_SelectedIndexChanged"/>
                            </dxlc:LayoutItem>
                        </dxlc:LayoutControl>

                        <dxlc:LayoutControl Grid.Row="6">
                            <dxlc:LayoutItem Label="Department"  Height="22" 
                                             Visibility="Collapsed">
                                <dxg:LookUpEdit  Height="22" 
                                         Margin="10 0 0 0"
                                            IsTextEditable="False" 
                                            AutoPopulateColumns="True" 
                                            DisplayMember="DeptName"
                                            x:Name="cmbxDepartment"
                                            GotFocus="CmbxDeptartment_GotFocus"
                                                 >
                                    <dxg:LookUpEdit.StyleSettings>
                                        <dxg:MultiSelectLookUpEditStyleSettings />
                                    </dxg:LookUpEdit.StyleSettings>

                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"></RowDefinition>
                                                    <RowDefinition Height="*"></RowDefinition>
                                                </Grid.RowDefinitions>

                                                <dxg:GridControl Name="PART_GridControl"
                                                         AutoPopulateColumns="True"
                                                         SelectionMode="MultipleRow"
                                                         Grid.Row="1">
                                                    <dxg:GridControl.View>
                                                        <dxg:TreeListView Name="treeListView1"
                                                                  ShowAutoFilterRow="True"
                                                                  TreeDerivationMode="Selfreference"
                                                                  KeyFieldName="Id"
                                                                  ParentFieldName="ParentID"
                                                                  />
                                                    </dxg:GridControl.View>
                                                </dxg:GridControl>
                                            </Grid>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>
                                </dxg:LookUpEdit>
                            </dxlc:LayoutItem>


                            <dxlc:LayoutItem Label="IBAN "  Height="22" >
                                <dxe:TextEdit x:Name="txtIban"
                                  Margin="60 0 0 0" />
                            </dxlc:LayoutItem>

                            <Separator Width="25" Background="Transparent" BorderBrush="Transparent"/>
                            <dxlc:LayoutItem Label="Account No.">
                                <dxe:TextEdit x:Name="txtAccntNo"
                                  Margin="8 0 0 0" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutControl>

                        <dxlc:LayoutControl Grid.Row="8">



                            
                            <dxlc:LayoutItem Label="Acount Name "  Height="22">
                                <dxe:TextEdit x:Name="txtAccntNick" Margin="15 0 0 0" />
                            </dxlc:LayoutItem>

                            <Separator Width="25" Background="Transparent" BorderBrush="Transparent"/>

                            <dxlc:LayoutItem Label="Nature "  Height="22">
                                <dxe:ComboBoxEdit x:Name="cmbxAccntNature" SelectedIndexChanged="CmbxAccntNature_SelectedIndexChanged" Margin="34 0 0 0"/>
                            </dxlc:LayoutItem>


                        </dxlc:LayoutControl>

                        <dxlc:LayoutControl Grid.Row="10">
                            <dxlc:LayoutGroup Orientation="Vertical">


                                <dxlc:LayoutItem Label="Chart of Account "   Height="22">
                                    <dxg:LookUpEdit x:Name="cmbcoaAccounts"
                    DisplayMember="accountName"
                    SelectedIndexChanged="CmbcoaAccounts_SelectedIndexChanged">
                                        <dxg:LookUpEdit.PopupContentTemplate>
                                            <ControlTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"></RowDefinition>
                                                        <RowDefinition Height="*"></RowDefinition>
                                                    </Grid.RowDefinitions>

                                                    <dxg:GridControl Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                                        <dxg:GridControl.View>
                                                            <dxg:TreeListView Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                                        </dxg:GridControl.View>
                                                        <dxg:GridColumn FieldName="Account Name"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                                    </dxg:GridControl>
                                                </Grid>
                                            </ControlTemplate>
                                        </dxg:LookUpEdit.PopupContentTemplate>
                                    </dxg:LookUpEdit>
                                </dxlc:LayoutItem>
                               
                            </dxlc:LayoutGroup>
                            <Separator Width="25" Background="Transparent" BorderBrush="Transparent"/>
                            <dxlc:LayoutItem Label="Category ">
                                <dxe:ComboBoxEdit Margin="22 0 0 0" x:Name="cmbxCategory" SelectedIndexChanged="CmbxCategory_SelectedIndexChanged"/>
                            </dxlc:LayoutItem>



                        </dxlc:LayoutControl>

                        

                        <dxlc:LayoutControl Grid.Row="12" x:Name="layoutCntrlVendor" Visibility="Collapsed">
                            <dxlc:LayoutItem Label="Industry">
                                <ComboBox Margin="48 0 0 0"
                            x:Name="cmbIndustry"
                            TabIndex="2"
                            SelectionChanged="cmbIndustry_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel  Orientation="Horizontal">
                                                <TextBlock Text="{Binding id}"
                                     Visibility="Hidden" />
                                                <TextBlock Text="{Binding name}"></TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                            </dxlc:LayoutItem>
                            
                            <Separator Width="25" Background="Transparent" BorderBrush="Transparent"/>
                            
                            <dxlc:LayoutItem Label="Vendor">
                                <dxg:LookUpEdit Margin="35 0 0 0"
                                                x:Name="cmbxVendor"
                                                DisplayMember="company.CompanyName"
                                                GotFocus="CmbxVendor_GotFocus">
                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"></RowDefinition>
                                                    <RowDefinition Height="*"></RowDefinition>
                                                </Grid.RowDefinitions>

                                                <dxg:GridControl Name="PART_GridControl"
                                                        AutoPopulateColumns="True"
                                                        Grid.Row="1">
                                                    <dxg:GridControl.View>
                                                        <dxg:TableView Name="tbleView1"
                                                                ShowAutoFilterRow="True"/>
                                                    </dxg:GridControl.View>
                                                    <dxg:GridColumn FieldName="company.CompanyName"
                                                                    Header="Company"
                                                                IsSmart="True"
                                                                Width="auto"
                                                                    VisibleIndex="1"/>

                                                    <dxg:GridColumn
                                                        FieldName="Id"
                                                        Visible="False"/>

                                                    <dxg:GridColumn
                                                        FieldName="isActive"
                                                        Visible="False"/>

                                                    <dxg:GridColumn
                                                        FieldName="IsSubsidary"
                                                        Visible="False"/>

                                                    <dxg:GridColumn
                                                        FieldName="ParentID"
                                                        Visible="False"/>

                                                    <dxg:GridColumn
                                                        FieldName="contactPerson"
                                                        Visible="False"/>

                                                    <dxg:GridColumn
                                                        FieldName="shippingAddress"
                                                        Visible="False"/>

                                                    <dxg:GridColumn
                                                        FieldName="billingAddres"
                                                        Visible="False"/>

                                                    <dxg:GridColumn
                                                        FieldName="contact"
                                                        Visible="False"/>

                                                    <dxg:GridColumn
                                                        FieldName="ParentVendor"
                                                        Visible="False"/>
                                                </dxg:GridControl>
                                            </Grid>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>
                                </dxg:LookUpEdit>
                            </dxlc:LayoutItem>
                        </dxlc:LayoutControl>

                        <dxlc:LayoutControl Grid.Row="14">

                            <dxlc:LayoutItem Label="Is Active">
                                <dxe:CheckEdit x:Name="chkIsActive"  Margin="20 0 0 0"/>
                            </dxlc:LayoutItem>

                            <Separator Width="25" Background="Transparent" BorderBrush="Transparent"/>
                            
                            <dxlc:LayoutItem Label="Is Adjustment">
                                <dxe:CheckEdit x:Name="chkIsAdjustment"  Margin="20 0 0 0"/>
                            </dxlc:LayoutItem>
                        </dxlc:LayoutControl>
                    </Grid>

                </dxlc:LayoutGroup>
            </dx:DXTabItem>

            <dx:DXTabItem Header="Departments"
                    TabIndex="9">
                <dxlc:GroupBox Header="Departments">
                    <dxlc:GroupBox.TitleBackground>
                        <LinearGradientBrush EndPoint="0.5,1"
                                 StartPoint="0.5,0">
                            <GradientStop Color="#FFE6E8EB"
                            Offset="0" />
                            <GradientStop Color="#FF6CA6FB"
                            Offset="1" />
                        </LinearGradientBrush>
                    </dxlc:GroupBox.TitleBackground>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <dxg:GridControl x:Name="gridDepartment"
                             AutoGenerateColumns="None"
                             Grid.ColumnSpan="2"
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">
                            <!--<dxg:GridControl.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Add New"
                            x:Name="btnAddDepartment"
                            Click="btnAddDepartment_Click" />
                  <MenuItem Header="Edit Department"
                            x:Name="btnEditDepartment"
                            Click="btnEditDepartment_Click" />
                  <Separator />
                  <MenuItem Header="Delete Department"
                            x:Name="btnDeleteDepartment"
                            Click="btnDeleteDepartment_Click" />
                </ContextMenu>
              </dxg:GridControl.ContextMenu>-->
                            <dxg:GridControl.View>
                                <dxg:TreeListView x:Name="griddeptview"
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">
                                    <!--<dxg:TableView.DataContext>
                  <Databases:DBContextERP />
                </dxg:TableView.DataContext>-->
                                </dxg:TreeListView>
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="Id"
                              x:Name="coldeptid"
                              IsSmart="True"
                              Visible="False" />
                            <dxg:GridColumn x:Name="coldeptname"
                              FieldName="DeptName"
                              IsSmart="True" />
                            <dxg:GridColumn x:Name="coldeptcode"
                              FieldName="Code"
                              IsSmart="True" />
                            <dxg:GridColumn FieldName="Abbrivation"
                              IsSmart="True"
                              x:Name="coldeptabr"
                              Visible="False" />
                            <dxg:GridColumn FieldName="Timestamp"
                              IsSmart="True"
                              x:Name="coldeptts"
                              Visible="False" />
                            <dxg:GridColumn FieldName="sectionId"
                              IsSmart="True"
                              Visible="False" />
                            <dxg:GridColumn FieldName="sections"
                              IsSmart="True"
                              Visible="False" />
                        </dxg:GridControl>
                    </Grid>
                </dxlc:GroupBox>
            </dx:DXTabItem>
        </dx:DXTabControl>





        <!--<Grid Grid.Column="1" Margin="0 0 0 50">
            <dxg:GridControl x:Name="gridDepartment"
                                 AutoGenerateColumns="None"
                                 Grid.ColumnSpan="2"
                                 SelectionMode="MultipleRow"
                                 AllowInitiallyFocusedRow="False">
                
                
                <dxg:GridControl.View>
                    <dxg:TreeListView x:Name="griddeptview"
                                          AutoWidth="True"
                                          KeyFieldName="Id"
