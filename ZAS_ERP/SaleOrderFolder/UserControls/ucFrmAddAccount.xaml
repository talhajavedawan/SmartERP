                                          UseIndicatorForSelection="True"
                                          FadeSelectionOnLostFocus="False"
                                          ShowSelectionRectangle="True">
                    </dxg:TreeListView>
                </dxg:GridControl.View>
                <dxg:GridColumn FieldName="Id"
                                    x:Name="coldeptid"
                                    IsSmart="True"
                                    Visible="False" />
                <dxg:GridColumn x:Name="coldeptname"
                                    FieldName="DeptName"
                                    IsSmart="True" />


            </dxg:GridControl>
        </Grid>-->

        <Grid VerticalAlignment="Bottom" Grid.Row="1">
            <Button Content="Save" FontSize="20" x:Name="btnSave" Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</UserControl>
