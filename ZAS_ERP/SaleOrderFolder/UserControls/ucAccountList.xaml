<UserControl x:Class="ZAS_ERP.SaleOrderFolder.UserControls.ucAccountList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.SaleOrderFolder.UserControls"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:local2="clr-namespace:ZAS_ERP.SaleOrderFolder.UserControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
   
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu DockPanel.Dock="Top"
              x:Name="menuGrid">
            <MenuItem Header="Add New" >
                <MenuItem Header="Add New"
                    Click="Add_New_AccountClick" >
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Edit Account"
                    Click="Edit_AccountClick">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>

            </MenuItem>

            <MenuItem Header="Account Categories" >
                <MenuItem Header="All" x:Name="mbtnAllAccounts"
                    Click="MbtnAllAccounts_Click" >
                    <!--<MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                    </MenuItem.Icon>-->
                </MenuItem>
                
                <MenuItem Header="Company" x:Name="mbtnCompanyAccounts"
                    Click="MbtnCompanyAccounts_Click" >
                    <!--<MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                    </MenuItem.Icon>-->
                </MenuItem>
                <MenuItem Header="Personal" x:Name="mbtnPersonalAccounts"
                    Click="MbtnPersonalAccounts_Click">
                    <!--<MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                    </MenuItem.Icon>-->
                </MenuItem>
                <MenuItem Header="Vendor" x:Name="mbtnVendorAccounts"
                    Click="MbtnVendorAccounts_Click">
                    <!--<MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                    </MenuItem.Icon>-->
                </MenuItem>
                <MenuItem Header="Customer" x:Name="mbtnCustomerAccounts"
                    Click="MbtnCustomerAccounts_Click">
                    <!--<MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                    </MenuItem.Icon>-->
                </MenuItem>
                

            </MenuItem>


            <MenuItem Header="Refresh"
                      x:Name="mbtnRefresh"
                      Click="BtnRefresh_Click"
                      />

            <MenuItem Header="Save Layout"
                      x:Name="mbtnSaveLayout"
                      Click="MbtnSaveLayout_Click"/>
        </Menu>


        <TextBlock x:Name="lblHeading" Text="Accounts List" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  />
        <!--Account list Usercontrol-->
        <Grid  Background="White" Grid.Row="2">
            <dxg:GridControl AutoGenerateColumns="AddNew" 
                         EnableSmartColumnsGeneration="True" 
                         Name="grdCntrlAccountList"
                             CustomUnboundColumnData="GrdCntrlAccountList_CustomUnboundColumnData">

                <dxg:GridControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add New"
                    Click="Add_New_AccountClick">
                            <MenuItem.Icon>
                                <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Edit Account"
                    x:Name="btnEditSaleOrder"
                    Click="Edit_AccountClick">
                            <MenuItem.Icon>
                                <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                            </MenuItem.Icon>
                        </MenuItem>

                    </ContextMenu>
                </dxg:GridControl.ContextMenu>
                
                <dxg:GridControl.View >
                    <dxg:TableView AllowPerPixelScrolling="True" 
                               ShowTotalSummary="True"
                               ShowAutoFilterRow="True" 
                               RowAnimationKind="None" 
                               WaitIndicatorType="Panel"
                               AllowEditing="False"
                               Name="tblViewLandTypeLst">
                        <dxg:TableView.RowCellMenuCustomizations>



                            <!--<dxb:BarButtonItem Content="Item 1"  />
                            <dxb:BarButtonItem Content="Add New Account" ItemClick="Add_New_ItemClick" x:Name="mbtnAddAccount"/>
                            <dxb:BarButtonItem Content="Update Account" ItemClick="Edit_ItemClick" x:Name="mbtnUpdateAccount"/>-->
                            

                        </dxg:TableView.RowCellMenuCustomizations>
                    </dxg:TableView>
                </dxg:GridControl.View>

                <dxg:GridColumn FieldName="mainBank.BankName"
                                Header="Bank Name"
                                VisibleIndex="0"
                                AllowEditing="false"/>
                
                <dxg:GridColumn FieldName="bank.BankName"
                                Header="Branch Name"
                                VisibleIndex="1"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="company.CompanyName"
                                Header="Company"
                                VisibleIndex="2"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="Departmentss"
                                Header="Departments"
                                UnboundType="string"
                                VisibleIndex="3"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="accountType"
                                Header="Account Type"
                                VisibleIndex="4"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="currency.CurrencyName"
                                Header="Currency Name"
                                VisibleIndex="5"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="COAaccount"
                                Header="COA Account"
                                VisibleIndex="6"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="AccountNo"
                                Header="Account No"
                                VisibleIndex="7"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="IBAN"
                                Header="IBAN"
                                VisibleIndex="8"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="accountNature"
                                Header="Account Nature"
                                UnboundType="string"
                                VisibleIndex="9"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="AccountNick"
                                Header="Account Name"
                                VisibleIndex="10"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="accountsCategory"
                                Header="Category"
                                VisibleIndex="11"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="COAaccount.accountName"
                                Header="COA"
                                VisibleIndex="12"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="industryType.name"
                                Header="Industry Type"
                                VisibleIndex="13"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="vendor.company.CompanyName"
                                Header="Vendor"
                                VisibleIndex="14"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="isActive"
                                Header="Is Active"
                                VisibleIndex="15"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="isAdjustmentAccount"
                                Header="Is Adjustment Account"
                                VisibleIndex="16"
                                AllowEditing="false"/>

                <dxg:GridColumn FieldName="company" Header="Company" VisibleIndex="2" Visible="False" ShowInColumnChooser="False" AllowEditing="false"/>
                <dxg:GridColumn FieldName="departments" Header="Department" VisibleIndex="2" Visible="False" ShowInColumnChooser="False" AllowEditing="false"/>
                <dxg:GridColumn FieldName="company" Header="Company" VisibleIndex="2" Visible="False" ShowInColumnChooser="False" AllowEditing="false"/>
                <dxg:GridColumn FieldName="departments" Header="Department" VisibleIndex="2" Visible="False" ShowInColumnChooser="False" AllowEditing="false"/>

            </dxg:GridControl>
        </Grid>
        
    </Grid>
</UserControl>
