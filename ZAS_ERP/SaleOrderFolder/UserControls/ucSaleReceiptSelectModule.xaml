<UserControl x:Class="ZAS_ERP.SaleOrderFolder.UserControls.ucSaleReceiptSelectModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.SaleOrderFolder.UserControls"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             d:DesignHeight="250" d:DesignWidth="400" Loaded="UserControl_Loaded">
    <Grid>
        <dxlc:LayoutGroup Header="Module" View="GroupBox" dx:ThemeManager.ThemeName="DeepBlue">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Select Module" FontSize="25" FontWeight="DemiBold" Grid.ColumnSpan="2"  HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                <dxe:ComboBoxEdit x:Name="cmbxModules" Grid.Row="1" Grid.ColumnSpan="2"  Width="250" Height="22" HorizontalAlignment="Center"/>

                <Button x:Name="btnContinue" Click="BtnContinue_Click" FontWeight="DemiBold" Grid.ColumnSpan="2" Grid.Row="2" Content="Continue"/>
            </Grid>
        </dxlc:LayoutGroup>
    </Grid>
</UserControl>
