                    </Grid>
                </Grid>
            </dx:DXTabItem>

            <dx:DXTabItem Header="Companies"
                    TabIndex="9">
                <dxlc:GroupBox Header="Companies">
                    <dxlc:GroupBox.TitleBackground>
                        <LinearGradientBrush EndPoint="0.5,1"
                                 StartPoint="0.5,0">
                            <GradientStop Color="#FFE6E8EB"
                            Offset="0" />
                            <GradientStop Color="#FF6CA6FB"
                            Offset="1" />
                        </LinearGradientBrush>
                    </dxlc:GroupBox.TitleBackground>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <dxg:GridControl x:Name="gridCompanies"
                             AutoGenerateColumns="None"
                             Grid.ColumnSpan="2"
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">
                            <!--<dxg:GridControl.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Add New"
                            x:Name="btnAddDepartment"
                            Click="btnAddDepartment_Click" />
                  <MenuItem Header="Edit Department"
