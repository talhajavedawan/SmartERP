            </dx:DXTabItem>
        </dx:DXTabControl>
        
        <Grid VerticalAlignment="Bottom" Height="50" Grid.Row="1">
            <Button Content="Save"  x:Name="btnSave" Click="BtnSave_Click"/>
        </Grid>
            
    </Grid>
</UserControl>
