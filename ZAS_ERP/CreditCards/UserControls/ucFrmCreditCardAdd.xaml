<UserControl x:Class="ZAS_ERP.CreditCards.UserControls.ucFrmCreditCardAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.CreditCards.UserControls"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="800" Loaded="UserControl_Loaded" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <dx:DXTabControl>
            <dx:DXTabControl.View>
                <dx:TabControlScrollView HeaderLocation="Left"
                                 HideButtonShowMode="NoWhere"
                                 HeaderOrientation="Horizontal"
                                 AllowAnimation="True"
                                 ShowHeaderMenu="False"
                                 RemoveTabItemsOnHiding="False"
                                 NewButtonShowMode="NoWhere" />
            </dx:DXTabControl.View>

            <dx:DXTabItem Header="Card Information">
                <dxlc:LayoutGroup View="GroupBox" Header="Credit Card" Orientation="Horizontal" Padding="5">
                    <dxlc:LayoutControl Orientation="Vertical" VerticalAlignment="Top" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="5"/>
                                <RowDefinition/>
                                <RowDefinition Height="5"/>
                                <RowDefinition/>
                                <RowDefinition Height="5"/>
                                <RowDefinition/>
                                <RowDefinition Height="5"/>
                                <RowDefinition/>
                                <RowDefinition Height="5"/>
                                <RowDefinition/>
                                <RowDefinition Height="5"/>
                                <RowDefinition/>
                                <RowDefinition Height="5"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>


                            <TextBlock Text="Holder Type: " Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxe:ComboBoxEdit x:Name="cmbxType" Grid.Column="1" Grid.Row="0" Height="22" IsTextEditable="False" SelectedIndexChanged="CmbxType_SelectedIndexChanged"/>

                            <TextBlock Text="Company: " Grid.Column="3" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxg:LookUpEdit x:Name="cmbxCompany"      Grid.Row="0"     Grid.Column="4"                              
                                   SelectedIndexChanged="CmbxCompany_SelectedIndexChanged"
                                            GotFocus="CmbxCompany_GotFocus"
                                   Height="22"
                                   TabIndex="3"
                                   AutoPopulateColumns="True" 
                                   DisplayMember="CompanyName"
                                   IsTextEditable="False"/>
                            <!--<Separator Height="5" BorderBrush="Transparent"/>-->

                            <TextBlock Text="Primary Holder: " Grid.Column="3" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxg:LookUpEdit x:Name="cmbxPrimaryHolder" 
                                            IsTextEditable="False"
                                            DisplayMember="Name"
                                            SelectedIndexChanged="CmbxPrimaryHolder_SelectedIndexChanged"
                                            GotFocus="CmbxPrimaryHolder_GotFocus"
                                    Grid.Row="2"
                                    Grid.Column="4"
                                            Height="22"  
                                            TabIndex="5"
                                            AutoPopulateColumns="True"/>


                            <!--<Separator Height="5" BorderBrush="Transparent"/>-->

                            <TextBlock Text="Secondary Holder: " x:Name="txtBlckSecondaryHolder" Grid.Column="0" Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxg:LookUpEdit x:Name="cmbxSecondaryCardHolder" 
                                    Grid.Column="1"
                                    Grid.Row="6"
                                            IsTextEditable="False"
                                            DisplayMember="Name"
                                            Height="22"  
                                            TabIndex="5"
                                            AutoPopulateColumns="True"/>




                            <!--<Separator Height="5" BorderBrush="Transparent"/>-->

                            <TextBlock Text="Card User: " Grid.Column="3" Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxg:LookUpEdit x:Name="cmbxCardUser" Grid.Column="4" Grid.Row="6"
                                            IsTextEditable="False"
                                            DisplayMember="Name"
                                            Height="22"  
                                            TabIndex="5"
                                            AutoPopulateColumns="True"/>

                            


                            <!--<Separator Height="5" BorderBrush="Transparent"/>-->

                            <TextBlock x:Name="txtBlkCardNo" Text="Credit Card #: " Grid.Column="3" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxe:TextEdit x:Name="txtCardNumber" Height="22"
                                  Grid.Column="4" Grid.Row="4"

                                          LostFocus="TxtCardNumber_LostFocus"
                                          PreviewTextInput="NumberValidationTextBox"/>
                            <!--MaskType="RegEx"
                  Mask="[+0-9]+" 
                                         
                                  MaskUseAsDisplayFormat="True"
                                  InvalidValueBehavior="AllowLeaveEditor"/>-->


                            <TextBlock x:Name="txtBlkPrimaryCardNo" Grid.Column="0"  Grid.Row="4" HorizontalAlignment="Right" Text="Primary Card #: " VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      Grid.Row="4"
                                      
                                                          x:Name="cmbxPrimaryCardNo"
                                                          Height="22"
                                                  GotFocus="CmbxPrimaryCardNo_GotFocus"
                                                  SelectionChanged="CmbxPrimaryCardNo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel  Orientation="Horizontal">
                                            <TextBlock 
                         Text="{Binding id}"
                         Visibility="Hidden" />
                                            <TextBlock Text="{Binding name}"
                         ></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>


                            <!--<Separator Height="5" BorderBrush="Transparent"/>-->
                            <!--<TextBlock x:Name="txtBlkSecondaryCardNo" Text="Secondary Card #: " Grid.Column="3" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxe:TextEdit x:Name="txtSecondaryCardNumber" IsEnabled="True" Grid.Column="4" Grid.Row="4" Height="22"
                                          PreviewTextInput="NumberValidationTextBox"/>-->
                            <!--MaskType="RegEx"
                  Mask="[+0-9]+"
                  MaskIgnoreBlank="False" 
                                  MaskUseAsDisplayFormat="True"
                                  InvalidValueBehavior="AllowLeaveEditor"/>-->

                            <!--<Separator Height="5" BorderBrush="Transparent"/>-->

                            <TextBlock Text="Bank: " Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxg:LookUpEdit x:Name="cmbxBank" Grid.Column="1" 
                                            GotFocus="CmbxBank_GotFocus"
                                            Grid.Row="2"
                                            IsTextEditable="False"
                                            DisplayMember="BankName"
                                            Height="22"  
                                            TabIndex="5"
                                            AutoPopulateColumns="True"/>

                            <!--<Separator Height="5" BorderBrush="Transparent"/>-->

                            <TextBlock Text="Issue Date: " Grid.Column="0" Grid.Row="8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxe:DateEdit x:Name="datIssueDate" Grid.Column="1" Grid.Row="8" Height="22"/>

                            <!--<Separator Height="5" BorderBrush="Transparent"/>-->

                            <TextBlock Text="Expiry Date: " Grid.Column="3" Grid.Row="8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxe:DateEdit x:Name="datExpDate" Grid.Column="4" Grid.Row="8" Height="22"/>


                            <!--<Separator Height="5" BorderBrush="Transparent"/>-->

                            <TextBlock Text="CVV (Optional): " Grid.Column="0" Grid.Row="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxe:TextEdit x:Name="txtCVV" MaskType="Numeric" Grid.Column="1" Grid.Row="10" Height="22"/>

                            <TextBlock Text="Type: " Grid.Column="3" Grid.Row="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxg:LookUpEdit Grid.Column="4"
                                      Grid.Row="10"
                                            DisplayMember="Type"
                                      x:Name="cmbxCardType"
                                      Height="22">
                                
                            </dxg:LookUpEdit>

                            <TextBlock Text="Currency: " Grid.Column="0" Grid.Row="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxg:LookUpEdit x:Name="cmbxCurrency" DisplayMember="CurrencyName"  Grid.Column="1" Grid.Row="12" Height="22"/>

                            <TextBlock Text="Limit: " Grid.Column="3" Grid.Row="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxe:TextEdit x:Name="txtLimit" MaskType="Numeric" 
                                                      Mask="n2"
                                                      MaskUseAsDisplayFormat="True" Grid.Column="4" Grid.Row="12" Height="22"/>


                            <TextBlock Text="Is Active: " Grid.Column="0" Grid.Row="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxe:CheckEdit x:Name="chkIsActive" Grid.Column="1" Grid.Row="14"/>
                        </Grid>
                    </dxlc:LayoutControl>
                </dxlc:LayoutGroup>
            </dx:DXTabItem>

            <dx:DXTabItem Header="Departments">
                <dxlc:GroupBox Header="Departments">
                    <dxlc:GroupBox.TitleBackground>
                        <LinearGradientBrush EndPoint="0.5,1"
                                 StartPoint="0.5,0">
                            <GradientStop Color="#FFE6E8EB"
                            Offset="0" />
                            <GradientStop Color="#FF6CA6FB"
                            Offset="1" />
                        </LinearGradientBrush>
                    </dxlc:GroupBox.TitleBackground>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <dxg:GridControl x:Name="gridDepartment"
                             AutoGenerateColumns="None"
                             Grid.ColumnSpan="2"
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">
                            <!--<dxg:GridControl.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Add New"
                            x:Name="btnAddDepartment"
                            Click="btnAddDepartment_Click" />
                  <MenuItem Header="Edit Department"
                            x:Name="btnEditDepartment"
                            Click="btnEditDepartment_Click" />
                  <Separator />
                  <MenuItem Header="Delete Department"
                            x:Name="btnDeleteDepartment"
                            Click="btnDeleteDepartment_Click" />
                </ContextMenu>
              </dxg:GridControl.ContextMenu>-->
                            <dxg:GridControl.View>
                                <dxg:TreeListView x:Name="griddeptview"
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">
                                    <!--<dxg:TableView.DataContext>
                  <Databases:DBContextERP />
                </dxg:TableView.DataContext>-->
                                </dxg:TreeListView>
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="Id"
                              x:Name="coldeptid"
                              IsSmart="True"
                              Visible="False" />
                            <dxg:GridColumn x:Name="coldeptname"
                              FieldName="DeptName"
                              IsSmart="True" />
                            <dxg:GridColumn x:Name="coldeptcode"
                              FieldName="Code"
                              IsSmart="True" />
                            <dxg:GridColumn FieldName="Abbrivation"
                              IsSmart="True"
                              x:Name="coldeptabr"
                              Visible="False" />
                            <dxg:GridColumn FieldName="Timestamp"
                              IsSmart="True"
                              x:Name="coldeptts"
                              Visible="False" />
                            <dxg:GridColumn FieldName="sectionId"
                              IsSmart="True"
                              Visible="False" />
                            <dxg:GridColumn FieldName="sections"
                              IsSmart="True"
                              Visible="False" />
                        </dxg:GridControl>
                    </Grid>
                </dxlc:GroupBox>
            </dx:DXTabItem>
        </dx:DXTabControl>


        
        
        <Button x:Name="btnSave" Content="Save" Height="40" Grid.Row="1" VerticalAlignment="Bottom" Click="BtnSave_Click"/>
    </Grid>
</UserControl>