<UserControl x:Class="ZAS_ERP.CreditCards.UserControls.ucCreditCardsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.CreditCards.UserControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu DockPanel.Dock="Top" x:Name="mainMenu" Width="auto" Margin="0,0,0,4" Grid.Row="0" >

            <MenuItem Header="Add">
                <MenuItem Header="Add new" Name="mbtnAddCreditCard" Click="MbtnAddCreditCard_Click">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Edit Credit Card" x:Name="mbtnEditCreditCard" Click="MbtnEditCreditCard_Click">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Refresh" x:Name="mbtnRefresh" Click="MbtnRefresh_Click"/>
            
        </Menu>

        <TextBlock x:Name="lblHeading" Text="Credit Cards List" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  />
        <Grid Grid.Row="2">
        <dxg:GridControl 
            AutoGenerateColumns="AddNew"
            EnableSmartColumnsGeneration="True"
            Name="grdCreditCard"
            MouseDoubleClick="GrdCreditCard_MouseDoubleClick"
            CustomUnboundColumnData="GrdCreditCard_CustomUnboundColumnData"
            Loaded="GrdCreditCard_Loaded"
            >

            <dxg:GridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add New"
                                Click="MbtnAdd_Click" x:Name="mbtnAdd">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Update"
                                    x:Name="mbtnUpdate" Click="MbtnUpdate_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </dxg:GridControl.ContextMenu>

            <dxg:GridControl.View>
                <dxg:TableView
                        AllowEditing="False"
                        AllowPerPixelScrolling="True"
                        Name="tblViewCreditCardLst"
                        RowAnimationKind="None"
                        ShowAutoFilterRow="True"
                        ShowTotalSummary="True"
                        WaitIndicatorType="Panel">
                    
                </dxg:TableView>
            </dxg:GridControl.View>

            <dxg:GridColumn x:Name="colId"
                      FieldName="Id"
                      Header="Id"
                      UnboundType="Bound"
                      Visible ="False" 
                      SortOrder="Ascending" 
                           VisibleIndex="1" 
                            ShowInColumnChooser="False"/>

            <dxg:GridColumn x:Name="colcardHolderType"
                      FieldName="cardHolderType"
                      Header="card Holder Type"
                      UnboundType="Bound" 
                      SortOrder="Ascending" 
                           VisibleIndex="2" />

                <dxg:GridColumn x:Name="colCompany"
                      FieldName="company.CompanyName"
                      Header="Company"
                      UnboundType="Bound" 
                      SortOrder="Ascending" 
                           VisibleIndex="3" />

                <dxg:GridColumn x:Name="colBank"
                      FieldName="bank.BankName"
                      Header="Bank"
                      UnboundType="Bound" 
                      SortOrder="Ascending" 
                           VisibleIndex="4" />

                <dxg:GridColumn x:Name="colPrimaryCardNumber"
                      FieldName="PrimaryCardNo.CardNumber"
                      Header="Primary Card Number"
                      UnboundType="bound"
                                Visible="False"
                                ShowInColumnChooser="False"
                      SortOrder="Ascending" 
                           VisibleIndex="25" />

                <dxg:GridColumn x:Name="colPrimaryNo"
                      FieldName="PrimaryCard#"
                      Header="Primary Card #"
                      UnboundType="string" 
                                AllowEditing="false"
                      SortOrder="Ascending" 
                           VisibleIndex="5"
                                UnboundExpression="Iif(IsNullOrEmpty([PrimaryCardNo]), [CardNumber], [PrimaryCardNo.CardNumber])"/>

                <dxg:GridColumn
                      FieldName="CardNumber"
                      Header="Card Number"
                            UnboundType="bound"
                    Visible="False"
                                ShowInColumnChooser="False"
                      SortOrder="Ascending" 
                           VisibleIndex="26"/>

                <dxg:GridColumn x:Name="colCardNumber"
                      FieldName="CardNumber1"
                      Header="Secondary Card #"
                            AllowEditing="false"
                      UnboundType="string"
                      SortOrder="Ascending" 
                           VisibleIndex="6" UnboundExpression="Iif(IsNullOrEmpty([PrimaryCardNo.CardNumber]), [PrimaryCardNo.CardNumber], [CardNumber])"/>

            

            <dxg:GridColumn x:Name="colPrimaryCardHolder"
                      FieldName="PrimaryCardHolder.Name"
                      Header="Primary Card Holder"
                      UnboundType="Bound" 
                      SortOrder="Ascending" 
                           VisibleIndex="7" />

            <dxg:GridColumn x:Name="colSecondaryCardHolder"
                      FieldName="SecondaryCardHolder.Name"
                      Header="Secondary Card Holder"
                      UnboundType="Bound" 
                      SortOrder="Ascending" 
                           VisibleIndex="8" />

            <dxg:GridColumn x:Name="colCardUser"
                      FieldName="CardUser.Name"
                      Header="Card User"
                      UnboundType="Bound" 
                      SortOrder="Ascending" 
                           VisibleIndex="9" />

            <dxg:GridColumn x:Name="colIssueDate"
                      FieldName="IssueDate"
                      Header="Issue Date"
                      UnboundType="Bound" 
                      SortOrder="Ascending" 
                           VisibleIndex="10" />

            <dxg:GridColumn x:Name="colExpiryDate"
                      FieldName="ExpiryDate"
                      Header="Expiry Date"
                      UnboundType="Bound" 
                      SortOrder="Ascending" 
                           VisibleIndex="11" />

            <dxg:GridColumn x:Name="colCVV"
                      FieldName="CVV"
                      Header="CVV"
                      UnboundType="Bound" 
                      SortOrder="Ascending" 
                           VisibleIndex="12" />

                <dxg:GridColumn x:Name="colCardType"
                      FieldName="creditCardType.Type"
                      Header="Card Type"
                      UnboundType="Bound" 
                      SortOrder="Ascending" 
                           VisibleIndex="13" />

                <dxg:GridColumn x:Name="colCurrency"
                      FieldName="currency.CurrencyName"
                      Header="Currency"
                      UnboundType="Bound" 
                      SortOrder="Ascending" 
                           VisibleIndex="14" />


                <dxg:GridColumn FieldName="currency" Header="Currency" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="15" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="currencyId" Header="currencyId" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="16" ShowInColumnChooser="False"/>

                <dxg:GridColumn FieldName="creditCardType" Header="creditCardType" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="17" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="creditCardTypeId" Header="creditCardTypeId" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="18" ShowInColumnChooser="False"/>
            
                <dxg:GridColumn FieldName="company" Header="Company" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="19" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="CompanyId" Header="Company" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="20" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="bank" Header="Bank" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="21" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="BankID" Header="Bank" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="22" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="PrimaryCardHolder" Header="Card Holder" Visible="False" UnboundType="Bound"  SortOrder="Ascending" VisibleIndex="23" ShowInColumnChooser="False"/>

                <dxg:GridColumn  FieldName="PrimaryCardHolderId" Header="Parent ID" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="24" ShowInColumnChooser="False"/>

                <dxg:GridColumn FieldName="SecondaryCardHolder" Header="Secondary Holder" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="25" ShowInColumnChooser="False"/>

                <dxg:GridColumn FieldName="SecondaryCardHolderId" Header="Secondary Holder" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="26" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="CardUser" Header="Card User" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="27" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="CardUserID" Header="Card User Id" Visible="False" UnboundType="Bound" VisibleIndex="28"
                      SortOrder="Ascending" 
                            ShowInColumnChooser="False"/>


                <dxg:GridColumn FieldName="PrimaryCardNo" Header="Primary Card No" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="29" ShowInColumnChooser="False"/>

                <dxg:GridColumn FieldName="PrimaryCardNoId" Header="Primary Card No Id" Visible="False" UnboundType="Bound" SortOrder="Ascending" VisibleIndex="30" ShowInColumnChooser="False"/>

            </dxg:GridControl>
        </Grid>
    </Grid>
</UserControl>