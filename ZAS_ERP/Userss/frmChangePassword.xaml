<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ZAS_ERP.Userss"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        x:Class="ZAS_ERP.Userss.frmChangePassword"
             mc:Ignorable="d"
             Height="300" WindowStartupLocation="CenterScreen"
             Width="350" Title="Change Password" x:Name="winChangePassword" 
        Loaded="winChangePassword_Loaded" Closing="winChangePassword_Closing">

   
    
        <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type Label}">
                <Setter Property="Margin"
                        Value="10,10" />
                <Setter Property="Foreground"
                        Value="Gray" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin"
                        Value="10,0" />
                <Setter Property="MaxWidth"
                        Value="350" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Label Content="User Name"
                   ToolTip="User Name"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"  />
            <Label Content="Old Password"
                   ToolTip="Old Password"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Grid.Row="1" />
            <!--textblock for displaying data in colunm 2 of grid from stored company data -->
            <TextBox x:Name="txtusername"
                     VerticalAlignment="Center"
                     Grid.Column="1"
                     Margin="20,5" IsReadOnly="True"/>
            <dxe:PasswordBoxEdit          VerticalAlignment="Center"
                                          x:Name="txtoldpassword"
                                          ToolTip="Enter old Password"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="20,5" />
            <Label Content="New Password"
                   x:Name="lblnewpassword"
                   ToolTip="New Password"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Grid.Row="2" />
            <dxe:PasswordBoxEdit          VerticalAlignment="Center"
                                          x:Name="txtnewpassword"
                                          ToolTip="Enter new Password"
                                          Grid.Row="2"
                                          Grid.Column="1"
                                          Margin="20,5" />
        <Label Content="Confirm Password"
               x:Name="lblConfirmpassword"
               ToolTip="New Password"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               Grid.Row="3" />
        <dxe:PasswordBoxEdit          VerticalAlignment="Center"
                                      x:Name="txtConfirmpassword"
                                      ToolTip="Enter Confirm Password"
                                      Grid.Row="3"
                                      Grid.Column="1"
                                      Margin="20,5" />
        <!--<Label Content="is Active"
                   ToolTip="isActive"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Grid.Row="4" />
            <CheckBox Grid.Row="4"
                      x:Name="chkisActive"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Margin="20,5" />-->
            <Button Grid.ColumnSpan="2"
                    Grid.Row="5"
                    Content="Change Password"
                    FontSize="22"
                    x:Name="btnUserSave"
                    Click="btnUserSave_Click" />
        </Grid>
        

  
</Window>
