<UserControl x:Class="ZAS_ERP.Userss.Polling.ucUsersVotedList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Userss.Polling"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <dxg:GridControl Name="grdUsers" 
                         SelectionMode="Row" 
                         AutoGenerateColumns="None">
            <dxg:GridControl.View>
                <dxg:TableView Name="tblViewUsers"/>
            </dxg:GridControl.View>

            <dxg:GridColumn FieldName="id"
                                    x:Name="colId"
                                    IsSmart="True"
                                    Visible="False"/>

            <dxg:GridColumn VisibleIndex="0" Width="auto" FieldName="employee.person.Photo" Header="Photo" >
                <dxg:GridColumn.EditSettings>
                    <dxe:ImageEditSettings MaxWidth="40" ShowMenu="False"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn x:Name="coluserName"
                                    FieldName="userName" VisibleIndex="1"
                                    Header="User"
                                    IsSmart="True"
                            AllowEditing="false"/>

        </dxg:GridControl>
    </Grid>
</UserControl>
