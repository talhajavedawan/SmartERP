<Window x:Class="ZAS_ERP.Userss.frmNewUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Userss"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        mc:Ignorable="d" Loaded="Window_Loaded" Unloaded="Window_Unloaded"
        HorizontalAlignment="Center"
        Title="New User"
        Height="500"
        Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="Gray"></Setter>
                <Setter Property="Margin"
                        Value="10,5"></Setter>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="VerticalAlignment" Value="Center"> 
                    
                </Setter>
                
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height=".6*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <dxlc:GroupBox Header="User Name and Password"
                       DisplayMode="Light"
                       AutomationProperties.IsRequiredForForm="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    
                    
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Text="User Name" ></TextBlock>
                <TextBlock Text="Password" Grid.Row="1"></TextBlock>
                <TextBlock Text="Confirm Password" Grid.Row="2"></TextBlock>
                <TextBox Grid.Column="1" x:Name="TxtUserName" ></TextBox>
                <PasswordBox Grid.Column="1" Grid.Row="1" x:Name="txtPassword" VerticalAlignment="Center"></PasswordBox>
                <PasswordBox Grid.Column="1"
                             x:Name="txtConfirmPassword"
                             VerticalAlignment="Center"
                             Grid.Row="2" ></PasswordBox>
                <TextBlock Grid.Column="0"
                           Grid.Row="3" VerticalAlignment="Center"
                           x:Name="lbltSupervisor">
                Employee :</TextBlock>
                <CheckBox Grid.Row="3"
                          x:Name="chkisActive"
                          Grid.Column="2" Content="isActive"
                          VerticalAlignment="Center"
                          Margin="50,0"/>
                <dxg:LookUpEdit x:Name="lookupEmployee"
                                Grid.Column="1"
                                Grid.Row="3"
                                VerticalAlignment="Center"
                                TabIndex="1"
                                DisplayMember="person.FName"
                                SelectedIndexChanged="LookupEmployee_SelectedIndexChanged">
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>
                                <dxg:GridControl Name="PART_GridControl"
                                                 AutoPopulateColumns="True"
                                                 Grid.Row="1">
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView Name="treeListView1"
                                                          ShowAutoFilterRow="True"
                                                          TreeDerivationMode="Selfreference"
                                                          KeyFieldName="Id"
                                                          ParentFieldName="SupervisorId" />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn x:Name="colId"
                                                    FieldName="Id"
                                                    IsSmart="True"
                                                    Visible="False" />
                                    <!--<dxg:GridColumn FieldName="person.FName"
                                                            IsSmart="True"
                                                            Width="auto" />
                                            -->
                                    <!--<dxg:GridColumn FieldName="company.IndustryType"
                                    IsSmart="True"
                                    Visible="False" />-->
                                    <!--
                                            <dxg:GridColumn x:Name="collastname"
                                                            FieldName="person.FName"
                                                            Visible="True"
                                                            IsSmart="True" />-->
                                    <dxg:GridColumn FieldName="person.FName"
                                                    x:Name="colFname"
                                                    IsSmart="True"
                                                    Visible="True"
                                                    Header="First Name"
                                                    Width="auto" />
                                    <dxg:GridColumn FieldName="person.LName"
                                                    x:Name="colLname"
                                                    IsSmart="True"
                                                    Visible="True"
                                                    Header="Last Name"
                                                    Width="auto" />
                                    <dxg:GridColumn FieldName="contact.ContactNo"
                                                    IsSmart="True"
                                                    x:Name="colcontactno"
                                                    Visible="False"
                                                    Header="Phone"
                                                    Width="auto" />
                                    <dxg:GridColumn FieldName="contact.Email"
                                                    x:Name="colEmail"
                                                    IsSmart="True"
                                                    Visible="False"
                                                    Header="Email" />
                                </dxg:GridControl>
                            </Grid>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>
            </Grid>
        </dxlc:GroupBox>
        <dxlc:GroupBox Header="Roles" Grid.Row="1"
                       CornerRadius="0"
                       DisplayMode="Light">
            <dxg:GridControl SelectionMode="MultipleRow"
                             x:Name="grdRoles"
                             Grid.Row="2"
                           
                             AutoGenerateColumns="None"
                             SelectionChanged="GrdRoles_SelectionChanged"
                             AllowInitiallyFocusedRow="False">
                <!--<dxg:GridControl.View>
                    <dxg:TableView x:Name="viewTable"
                                      AutoWidth="True"
                                      AllowEditing="False"
                           AllowGrouping="False"
                                  
                                      ColumnFilterPopupMode="Excel"
                                      UseIndicatorForSelection="True"
                                      
                                   ShowCheckBoxSelectorColumn="True"
                                      FadeSelectionOnLostFocus="False"
                                      ShowSelectionRectangle="True"></dxg:TableView>
                </dxg:GridControl.View>-->
                
                <dxg:GridControl.View>
                    <dxg:TreeListView x:Name="treeViews"
                                      NodeCheckStateChanged="TreeViews_NodeCheckStateChanged"
                                      
                        ShowCheckboxes="True"                     
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       ShowAutoFilterRow="True"
                       Width="auto"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       KeyFieldName="Id"
                       ParentFieldName="parentId">
                    </dxg:TreeListView>
                </dxg:GridControl.View>
                
                <!--<dxg:GridControl.DataContext>
              <Databases:Company />
            </dxg:GridControl.DataContext>-->
                <dxg:GridColumn x:Name="Id"
                                FieldName="Id"
                                IsSmart="True"
                                Visible="False" />
              
                <dxg:GridColumn x:Name="colName"
                      FieldName="Name"
                                Header="Name"
                      UnboundType="Bound"
                      AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="5"/>

                <dxg:GridColumn x:Name="colDescription"
                      FieldName="Description"
                                Header="Description"
                      UnboundType="Bound"
                      AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="4"/>

                <dxg:GridColumn x:Name="colCompany"
                      FieldName="Company"
                                Header="Company"
                      UnboundType="Bound"
                      AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="1"/>
                <dxg:GridColumn x:Name="colDepartment"
                      FieldName="Department"
                                Header="Department"
                      UnboundType="Bound"
                      AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="2"/>
                <dxg:GridColumn x:Name="colRoleName"
                      FieldName="RoleName"
                                Header="Role Name"
                      UnboundType="Bound"
                      AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="3"/>
                <!--<dxg:GridColumn FieldName="addressId" x:Name="coladressId" IsSmart="True" Visible="False" />-->
                <!--<dxg:GridColumn FieldName="address" IsSmart="True" x:Name="coladress" Visible="False" />-->
                <!--<dxg:GridColumn FieldName="contactId" Visible="False" x:Name="colcontactId" IsSmart="True" />-->
                <!--<dxg:GridColumn FieldName="contact" x:Name="colcontact" IsSmart="True" Visible="False" />-->
            </dxg:GridControl>
