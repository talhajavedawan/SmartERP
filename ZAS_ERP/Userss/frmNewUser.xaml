                                <TextBlock Text="{Binding description}"
                                           Visibility="Hidden" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="5">
