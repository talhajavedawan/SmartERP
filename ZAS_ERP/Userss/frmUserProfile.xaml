<Window x:Class="ZAS_ERP.Userss.frmUserProfile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Userss"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts"
        mc:Ignorable="d"
        Title="User Profile" Height="550" Width="900" Loaded="Window_Loaded" Unloaded="Window_Unloaded">
    <Window.Resources>
        <Style TargetType="{x:Type Button}" x:Key="bckgrnd">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="SnapsToDevicePixels" Value="True" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}">
                            <Grid Margin="0,0,0,0" >
                                <ContentPresenter x:Name="MyContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightSkyBlue" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <!--<Trigger Property="IsChecked" Value="true">
                                <Setter Property="Background" Value="LightSkyBlue" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5"/>

                            </Trigger>-->
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>

                            <!--<Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="OrangeRed" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".4*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height=".7*">
                
            </RowDefinition >
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid x:Name="grdComments"  Visibility="Collapsed"
              Width="400" Background="Gray" Panel.ZIndex="8" 
              VerticalAlignment="Stretch" Margin="0 30 0 0 " HorizontalAlignment="Left" Grid.Row="0"
                  Grid.RowSpan="8"
                  Grid.ColumnSpan="5">
            <dxg:GridControl AutoExpandAllGroups="True"  Height="600" Grid.Row="1"
                             dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" 
                             x:Name="grdCommentss">
                <!--#region Columns-->
                <dxg:GridControl.Columns>


                    <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                    <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                    <dxg:GridColumn Width="Auto" FieldName="Subject" />
                    <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                    <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                    <dxg:GridColumn Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                                                SortOrder="Descending" />
                </dxg:GridControl.Columns>
                <!--#endregion-->
                <dxg:GridControl.View>
                    <dxg:TableView 
                            x:Name="GrdCommenttableView" AllowEditing="False" DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                                    DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0" RowStyle="{StaticResource RowStyle}" ShowSearchPanelMode="Always" SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" ShowIndicator="False" ShowVerticalLines="False"
                            CompactPanelShowMode="Always" SwitchToCompactModeWidth="700"
                             NavigationStyle="Row"
                           >

                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>
                        </dxg:TableView.FormatConditions>
                        <!--#region CompactModeFilterItems-->
                        <!--<dxg:TableView.CompactModeFilterItems>
                            <dxg:CompactModeFilterItem DisplayValue="All" />
                            <dxg:CompactModeFilterItem DisplayValue="Read" EditValue="[isRead] = True" />
                            <dxg:CompactModeFilterItem DisplayValue="Unread" EditValue="[isRead] = False" />

                        </dxg:TableView.CompactModeFilterItems>-->
                        <!--#endregion-->

                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>

        </Grid>
        <Grid Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="250"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="100*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="*"/>              
             </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Left"
                                Orientation="Horizontal" >
                   
                    <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" 
                            Grid.Column="2" ToolTip="Add New Comment" 
                            Click="BtnAddComment_Click">
                        <Image  Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
                    </Button>
                    <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" 
                            Grid.Column="2"  ToolTip="CommentLog" Click="BtnCommentLog_Click">
                        <Image  Source="/ZAS_ERP;component/images/comments.png" ></Image>
                    </Button>
                   

                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <dx:SimpleButton  x:Name="btnEditInfo"  Width="30" VerticalAlignment="Center" 
                     VerticalContentAlignment="Center" HorizontalAlignment="Right" 
                     Height="25"  Style="{StaticResource ResourceKey=bckgrnd}" 
                     Click="BtnEditInfo_Click" 
                     IsEnabled="False"
                    Grid.Row="1" Grid.Column="1">
                    <Image Source="/ZAS_ERP;component/images/appbar.edit.png" HorizontalAlignment="Center" />
                </dx:SimpleButton>
              


            </Grid>
         

            <dxe:ImageEdit x:Name="img" ShowMenu="False" Visibility="Visible"
                           ShowMenuMode="Hover" MinHeight="250" Height="250" 
                            Grid.Row="2">
                <dxe:ImageEdit.Source>
                    <BitmapImage UriSource="/ZAS_ERP;component/images/users-vector-icon-png_260862.jpg" />
                </dxe:ImageEdit.Source>

                <dxe:ImageEdit.MenuTemplate>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <dxe:ImageEditToolButton ToolTip="Save" Name="btnBrowseImage" Click="BtnBrowseImage_Click"
                            ImageSource="/ZAS_ERP;component/images/browse.png"  />
                            <dxe:ImageEditToolButton ToolTip="Save" Name="btnSaveImage" Click="BtnSaveImage_Click"
                            ImageSource="/ZAS_ERP;component/images/Save-icon16x16.png"  />
                            <dxe:ImageEditToolButton ToolTip="Delete" Name="btnDelImage" Click="BtnDelImage_Click"
                            ImageSource="/ZAS_ERP;component/images/declineIcon16x16.png"/>
                        </StackPanel>
                    </ControlTemplate>
                </dxe:ImageEdit.MenuTemplate>


            </dxe:ImageEdit>
            <TextBlock Text="hthth" x:Name="lblUserName" TextWrapping="Wrap" 
                       FontFamily="Cambria"
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       FontWeight="Medium" 
                       FontSize="20"
                        Grid.Row="4">

            </TextBlock>
            <TextBlock  Text="htht" x:Name="lblDesignation" TextWrapping="Wrap" 
                       FontFamily="Cambria"
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       FontWeight="Light" 
                       FontSize="12"
                       Foreground="Gray"
                         Grid.Row="5">

            </TextBlock>
           
                <dxe:TextEdit AcceptsReturn="True"                                             
