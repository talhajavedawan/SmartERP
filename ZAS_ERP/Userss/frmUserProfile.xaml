                <TextBlock Margin="10" x:Name="txtPbarValue" Text="{Binding ElementName=pbarTarget, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />
