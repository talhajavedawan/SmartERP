                    HorizontalAlignment="Right" />
                <TextBlock Grid.Column="1"
                           Grid.Row="5"
                           x:Name="lbltotalClosedSaleOrders"                          
                    HorizontalAlignment="Right" />
                <TextBlock Margin="10,0"
                           Text="No. Pending SaleOrders"         Grid.Row="6"                 
                    HorizontalAlignment="Right" />
                <TextBlock Grid.Column="1"
                           Grid.Row="6"
                           x:Name="lbltotalPendingSaleOrders"                          
                    HorizontalAlignment="Right" />
                <TextBlock Margin="10,0"
                           Text="No. Of SaleOrders"         Grid.Row="7"                 
                    HorizontalAlignment="Right" />
                <TextBlock Grid.Column="1"
                           Grid.Row="7"
                           x:Name="lbltotalSaleOrders"                          
                    HorizontalAlignment="Right" />
            </Grid>
            <Grid>

            </Grid>
        </Grid>
