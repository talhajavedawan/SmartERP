        <dx:DXTabControl Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
            <dx:DXTabItem Header="Summary" Name="tabSummary">
                <Grid>
                    <Grid>
                        <ScrollViewer>
                        <StackPanel >
                           <dxlc:GroupBox Header="Personal Information"
                           Background="White"
