                    HorizontalAlignment="Right" />
                <TextBlock Grid.Column="1"
                           Grid.Row="3"
                           x:Name="lbltotalCommission"                          
                    HorizontalAlignment="Right" />
                <TextBlock Margin="10,0"
                           Text="Total Amount of SO "         Grid.Row="4"                 
                    HorizontalAlignment="Right" />
                <dxe:TextEdit Grid.Column="1"
                           Grid.Row="4"
                           x:Name="lbltotalAmountSaleOrders" Margin="10,0"                          
                    HorizontalAlignment="Stretch" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                <TextBlock Margin="10,0"
