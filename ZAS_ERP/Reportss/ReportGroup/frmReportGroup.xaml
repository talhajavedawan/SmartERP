<dx:DXWindow
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ZAS_ERP.Reportss"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        x:Class="ZAS_ERP.Reportss.frmReportGroup"
             mc:Ignorable="d"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        WindowStartupLocation="CenterScreen"
             Loaded="winReportGroupAdd_Loaded"
             Height="260"
             Width="400" Title=" Grid Report Group" x:Name="winReportGroupAdd" 
        Icon="/ZAS_ERP;component/images/icon-ReportForm.png">
  <Grid>



        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Grid Report Groups" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="DemiBold"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            
            
            
            <TextBlock Text="Grid Group Type" Margin="5" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"
           Grid.Row="0" />

            <dxe:ComboBoxEdit x:Name="gridReportTypes" Grid.Row="0" 
                        Margin="5"      
                       Grid.Column="1" 
                       EditValueChanged="GridReportTypes_EditValueChanged"></dxe:ComboBoxEdit>


            <TextBlock Text="Transaction Type" Margin="5" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"
           Grid.Row="1" />
            <dxe:ComboBoxEdit x:Name="gridTransactionType" Grid.Row="1" 
                        Margin="5"      
                       Grid.Column="1" 
                       EditValueChanged="gridTransactionType_EditValueChanged"></dxe:ComboBoxEdit>


            <TextBlock Text="Parent Group" Margin="5" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"
           Grid.Row="2" />


            <dxg:LookUpEdit x:Name="lookupParentGroup"
                    Grid.Column="1"
                    Grid.Row="2"
                            IsEnabled="False"
                            Margin="5"
                           DisplayMember="groupName"
                    SelectedIndexChanged="lookupGroup_SelectedIndexChanged"
                    TabIndex="3">
                <dxg:LookUpEdit.PopupContentTemplate>
                    <ControlTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <dxg:GridControl Name="PART_GridControl"
                             Grid.Row="1">
                                <dxg:GridControl.View>
                                    <dxg:TreeListView Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                </dxg:GridControl.View>
                                <dxg:GridColumn x:Name="colId"
                              FieldName="Id"
                              Visible="False" />
                                <dxg:GridColumn FieldName="group"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                <dxg:GridColumn FieldName="userId"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                <dxg:GridColumn FieldName="user"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                <dxg:GridColumn FieldName="parent"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                            </dxg:GridControl>
                        </Grid>
                    </ControlTemplate>
                </dxg:LookUpEdit.PopupContentTemplate>
            </dxg:LookUpEdit>

            <TextBlock Text="Report Group Name" Margin="5" FontWeight="DemiBold" Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center"
           ToolTip="Report Group Name"/>
            <dxe:TextEdit x:Name="txtGroupName"
                     Grid.Row="3" Margin="5"
                    Grid.Column="1"/>
        </Grid>


        <Button Grid.ColumnSpan="2"
            Grid.Row="5"
                IsEnabled="False"
            Content="Save"
            FontSize="26"
            x:Name="btnreportGroupSave"
            Click="btnreportGroupSave_Click" />

  </Grid>
</dx:DXWindow>
