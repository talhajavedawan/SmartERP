<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Reportss.winVendorFinder"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:local="clr-namespace:ZAS_ERP.Reportss"
        mc:Ignorable="d"
        Title="Vendor Finder" Height="450" Width="800" Loaded="DXWindow_Loaded">
    <Grid>
        <dxg:GridControl Grid.Row="2" x:Name="grdVendorFinder"
                         SelectionMode="Row"
                         AutoGenerateColumns="None">
            <dxg:GridControl.View>
                <dxg:TableView x:Name="tableView"
                             ShowGroupPanel="True" ShowIndicator="True" ShowVerticalLines="False"
                             SwitchToCompactModeWidth="700"
                             ShowAutoFilterRow="True"          
                             ShowFixedTotalSummary="True"
                             ShowSearchPanelMode="Always"          
                             SearchPanelNullText="Search"
                               ShowDataNavigator="True"           
                             ShowTotalSummary="True"  >
                </dxg:TableView>
            </dxg:GridControl.View>
            
            <dxg:GridColumn Header="Vendor Name" VisibleIndex="0"  FieldName="vendor.company.CompanyName" ReadOnly="True"  IsSmart="True"/>
            <dxg:GridColumn Header="Product Description" VisibleIndex="1" FieldName="OwnDescription" ReadOnly="True" IsSmart="True"/>
            <dxg:GridColumn Visible="True" VisibleIndex="2"  IsSmart="True" Header="Business Type" ReadOnly="True" FieldName="vendor.company.BizType" SortOrder="Descending" SortIndex="0" />
            <dxg:GridColumn Visible="True" VisibleIndex="3" IsSmart="True" Header="Industry Type" ReadOnly="True" FieldName="vendor.company.industryType.name" />
            <dxg:GridColumn Visible="True" VisibleIndex="4"  IsSmart="True" Header="Currency" ReadOnly="True" FieldName="vendor.company.currency.CurrencyName" />
            <dxg:GridColumn Visible="True" VisibleIndex="5"  IsSmart="True" Header="NTN Number" ReadOnly="True" FieldName="vendor.company.EmployeerNo" />
            <dxg:GridColumn VisibleIndex="6" FieldName="vendor.Rating" Header="Rating" ReadOnly="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:RatingEditSettings />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <!--contact person-->
            <dxg:GridColumn Visible="False" VisibleIndex="7" x:Name="colFname" IsSmart="True" ReadOnly="True" Header="First Name" FieldName="vendor.contactPerson.FName" ShowInColumnChooser="False" />
            <dxg:GridColumn Visible="False" VisibleIndex="8" x:Name="colLname" IsSmart="True" ReadOnly="True" Header="Last Name" FieldName="vendor.contactPerson.LName" ShowInColumnChooser="False"/>
            <!--Shipping person-->

            <dxg:GridColumn Visible="True"  IsSmart="True" Header="Shipping Address" ReadOnly="True" FieldName="vendor.shippingAddress.Line1" />
            <dxg:GridColumn Visible="True"  IsSmart="True" Header="Red Listed" ReadOnly="True" FieldName="vendor.isBlackList" />
            <dxg:GridColumn Visible="True"  IsSmart="True" Header="Shipping Country" ReadOnly="True" FieldName="vendor.shippingAddress.Country" />
            <dxg:GridColumn Visible="True"  IsSmart="True" Header="Shipping City" ReadOnly="True" FieldName="vendor.shippingAddress.City" />
            <dxg:GridColumn Visible="True"  IsSmart="True" Header="Shipping State" ReadOnly="True" FieldName="vendor.shippingAddress.State" />

            <!--Billing person-->

            <dxg:GridColumn Visible="True"  IsSmart="True" Header="Billing Address" ReadOnly="True" FieldName="vendor.billingAddres.Line1" />
            <dxg:GridColumn Visible="True"  IsSmart="True" Header="Billing Country" ReadOnly="True" FieldName="vendor.billingAddres.Country" />
            <dxg:GridColumn Visible="True"  IsSmart="True" Header="Billing City" ReadOnly="True" FieldName="vendor.billingAddres.City" />
            <dxg:GridColumn Visible="True"  IsSmart="True" Header="Billing State" ReadOnly="True" FieldName="vendor.billingAddres.State" />

            <dxg:GridColumn  Visible="True" x:Name="colcontactno" IsSmart="True" ReadOnly="True" Header="Phone" FieldName="vendor.contact.ContactNo" />
            <dxg:GridColumn Visible="True"  IsSmart="True" Header="Email" ReadOnly="True" FieldName="vendor.contact.Email" />
          

        </dxg:GridControl>

    </Grid>
</dx:DXWindow>
