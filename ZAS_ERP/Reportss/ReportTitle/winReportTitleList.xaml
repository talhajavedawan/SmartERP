<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" x:Class="ZAS_ERP.Reportss.ReportTitle.winReportTitleList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Reportss.ReportTitle"
        mc:Ignorable="d"
              WindowStartupLocation="CenterScreen"
              Title="Grid Report Title List"
              d:DesignHeight="450" d:DesignWidth="300" ResizeMode="NoResize" Loaded="UserControl_Loaded">
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <dx:DXTabControl Margin="0,0,0.2,0.4"   >
            <dx:DXTabItem  BorderColor="Orange" Visibility="Visible" Padding="2" ToolTip="Standard Groups" BackgroundColor="LightBlue" Cursor="Hand" x:Name="tabBtnStandardTitle"    Glyph="/ZAS_ERP;component/images/Team_32x32.png" >
                <Grid x:Name="grdStandardTitle">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".7*" />

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="1.4*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontWeight="Bold" FontSize="20" Text="Standard Titles"/>


                    <Menu DockPanel.Dock="Top" x:Name="menuFormList" Grid.Row="1">
                        <MenuItem Header="_Groups" x:Name="mbtnGroups">
                            <MenuItem Header="Add new Title" x:Name="mbtnNewStandardTitle" Click="mbtnNewStandardTitle_Click">
                                <MenuItem.Icon>
                                    <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem.Icon>
                                <Image Source="/ZAS_ERP;component/images/Team_32x32.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </Menu>
                    <dxg:GridControl x:Name="grdStandardTitles"
                       AutoGenerateColumns="None"
                       Grid.Row="2"        
                       SelectionMode="Row">
                        <dxg:GridControl.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add Standard Title" x:Name="btnNewStandardTitle" Click="btnNewStandardTitle_Click" >
                                    <MenuItem.Icon>
                                        <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Edit Standard Title" x:Name="btnEditStandardTitle" Click="btnEditStandardTitle_Click" >
                                    <MenuItem.Icon>
                                        <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                                    </MenuItem.Icon>
                                </MenuItem>s
                            </ContextMenu>
                        </dxg:GridControl.ContextMenu>
                        <dxg:GridControl.View>
                            <dxg:TableView 
                            AllowGrouping="False"
                            ShowGroupPanel="False"    
                            AllowEditing="False"
                            ShowSearchPanelMode="Default"
                            ColumnFilterPopupMode="Excel"
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True"/>
                        </dxg:GridControl.View>
                        <dxg:GridColumn Header="Title"
                            FieldName="titleName"
                            IsSmart="True"
                        />
                        <dxg:GridColumn Header="isActive"
                            FieldName="isActive"
                            IsSmart="True"
                        />
                        <dxg:GridColumn Header="Type"
                            FieldName="gridReportType"
                            IsSmart="True"/>
                    </dxg:GridControl>
                </Grid>
            </dx:DXTabItem>
            <dx:DXTabItem   x:Name="tabBtnMemorizedTitles" ToolTip="Memorized Titles" BackgroundColor="LightBlue" Cursor="Hand" BorderColor="LawnGreen" HeaderMenuIcon="" Padding="2"  Glyph="/ZAS_ERP;component/images/UserGroup_32x32.png">
                <Grid x:Name="grdMemorizedTitle">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".7*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="1.4*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontWeight="Bold" FontSize="20" Text="Memorized Titles"/>
                    <Menu DockPanel.Dock="Top" Grid.Row="1">
                        <MenuItem Header="_Titles"
                                  x:Name="mbtnMemorizedTitles">
                            <MenuItem Header="Add new Title"                             
                                    x:Name="mbtnNewMemorizedTitle"
                                    Click="mbtnNewMemorizedTitle_Click">
                                <MenuItem.Icon>
                                    <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem.Icon>
                                <Image Source="/ZAS_ERP;component/images/Team_32x32.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </Menu>
                    <dxg:GridControl x:Name="grdMemorizedTitles"
                       AutoGenerateColumns="None"
                       Grid.Row="2"           
                       SelectionMode="Row">

                        <dxg:GridControl.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add Memorized Title" x:Name="btnNewMemorizedTitle" Click="btnNewMemorizedTitle_Click" >
                                    <MenuItem.Icon>
                                        <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Edit Memorized Title" x:Name="btnEditMemorizedTitle" Click="btnEditMemorizedTitle_Click" >
                                    <MenuItem.Icon>
                                        <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </dxg:GridControl.ContextMenu>
                        <dxg:GridControl.View>
                            <dxg:TableView 
                            AllowGrouping="False"     
                            ShowGroupPanel="False"    
                            AllowEditing="False"
                            ShowSearchPanelMode="Default"
                            ColumnFilterPopupMode="Excel"
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" />
                        </dxg:GridControl.View>

                        <dxg:GridColumn Header="Title"
                            FieldName="titleName"
                            IsSmart="True"
                        />
                        <dxg:GridColumn Header="isActive"
                            FieldName="isActive"
                            IsSmart="True"
                        />
                        <dxg:GridColumn Header="Type"
                            FieldName="gridReportType"
                            IsSmart="True"/>
                    </dxg:GridControl>



                </Grid>

            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</dx:DXWindow>
