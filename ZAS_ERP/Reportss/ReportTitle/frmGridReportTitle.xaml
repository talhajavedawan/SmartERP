<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Reportss.ReportTitle.frmGridReportTitle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Reportss.ReportTitle" 
         xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" 
         xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
         xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
         mc:Ignorable="d"
         Title="Grid Report Title"
         Height="200" 
         Width="400" 
         ResizeMode="NoResize"
         WindowStartupLocation="CenterScreen"     
         Loaded="DXWindow_Loaded">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <dxlc:LayoutGroup   View="GroupBox" Header="Add Report Title" Orientation="Vertical">

            <dxlc:LayoutItem Label="Title Type">
                <dxe:ComboBoxEdit x:Name="titleTypes" Grid.Row="0" 
                           TabIndex="2"
                                 Margin="35,0,0,0"
                          
                           Grid.Column="1"   />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Grid Report Title">
                <TextBox x:Name="txtTitle"  Grid.Row="0" Grid.Column="1" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem   >
                <dxe:CheckEdit HorizontalAlignment="Center" Content="Is Active"  x:Name="checkIsActive"/>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>

        <Button x:Name="btnSave" Content="Save" Grid.Row="1" Click="btnSave_Click" />
    </Grid>
    </dx:DXWindow>
