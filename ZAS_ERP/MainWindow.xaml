                    x:Class="ZAS_ERP.MainWindow" mc:Ignorable="d" Title="ZAS-ERP" 
        MinHeight="480" MinWidth="800" 
        WindowState="Maximized" 
        WindowStartupLocation="CenterScreen"
        Width="1000" 
        x:Name="mainWindow"
        Loaded="mainWindow_Loaded"
        Icon="images/zasLogo.png"
        MouseMove="mainWindow_MouseMove"
                    KeyDown="mainWindow_KeyDown"
        Closing="mainWindow_Closing"
        DataContext="{Binding RelativeSource={RelativeSource Self}}" 
    >
    <!--<Window.CommandBindings>
        <CommandBinding Command="local:CustomCommands.MarkReadUnread" CanExecute="ExitCommand_CanExecute" Executed="ExitCommand_Executed" />
    </Window.CommandBindings>-->
    <Window.Resources>

        <Style TargetType="dxb:BarSubItemLinkControl">
            <EventSetter Event="PreviewMouseDown" Handler="SubItemPreviewMouseDown" />
        </Style>
        <Storyboard x:Key="MyStoryboard">
            <DoubleAnimation Storyboard.TargetName="btnGlow" 
                         Storyboard.TargetProperty="Opacity"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         From="1"
                         To="0.0"
                         Duration="0:0:1" />
        </Storyboard>



    </Window.Resources>
    <dxb:BarManager Name="barManager1">
        <Grid>



            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <DockPanel LastChildFill="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="25.5"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" MaxWidth="220"/>
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Panel.ZIndex="6" Grid.Row="1" Background="White" Width="auto" Margin="0 0 0 0" Grid.Column="2" x:Name="grdPollings" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <dx:SimpleButton Content="Active Pollings" x:Name="btnActivePollings" Click="BtnActivePollings_Click"/>
                                <dx:SimpleButton Content="InActive Pollings" Grid.Column="1" x:Name="btnInActivePollings" Click="BtnInActivePollings_Click"/>
                                <dx:SimpleButton Grid.Column="2" Content="Refresh Data" x:Name="btnRefreshData" Click="BtnRefreshData_Click"/>
                                <dx:SimpleButton Content="All Pollings" Grid.Column="3" x:Name="btnAllPollings" Click="BtnAllPollings_Click"/>
                            </Grid>
                            <dxg:GridControl SelectionMode="Row"
                                         x:Name="grdCntrlPollings"
                                         AutoGenerateColumns="None"
                                         AllowInitiallyFocusedRow="False"
                                         Grid.Row="1"
                                         CustomUnboundColumnData="GrdCntrlPollings_CustomUnboundColumnData"
                                         SelectionChanged="GrdCntrlPollings_SelectionChanged">
                                <dxg:GridControl.View>
                                    <dxg:TableView
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    UseIndicatorForSelection="True"                                    
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True"
                                    ShowGroupPanel="False"
                                    ShowSearchPanelMode="Never"/>
                                </dxg:GridControl.View>

                                <dxg:GridControl.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Create New Poll" x:Name="mbtnCreateNewPoll" Click="MbtnCreateNewPoll_Click"/>
                                        <MenuItem Header="Edit Selected Poll" x:Name="mbtnViewPoll" Click="MbtnViewPoll_Click"/>
                                        <MenuItem Header="Delete Selected Poll" x:Name="mbtnDeletePoll" Click="MbtnDeletePoll_Click"/>
                                    </ContextMenu>
                                </dxg:GridControl.ContextMenu>

                                <dxg:GridColumn FieldName="CreationDate"
                                            Header="Created on"
                                            IsSmart="True" 
                                            SortOrder="descending"
                                            VisibleIndex="0"/>

                                <dxg:GridColumn FieldName="Title"
                                            Header="Title"
                                            IsSmart="True" 
                                            Width="auto"
                                            VisibleIndex="1"/>

                                <dxg:GridColumn FieldName="taskGroup.GroupName"
                                            Header="Group Name"
                                            IsSmart="True" 
                                            VisibleIndex="2"/>

                                <dxg:GridColumn Header="Initiated By"
                                            FieldName="initiatedBy.employee.person.FName"
                                            IsSmart="True"
                                            Width="auto"
                                            VisibleIndex="3"/>

                                <dxg:GridColumn Header="Users In Favor"
                                            FieldName="UsersInFavor"
                                            UnboundType="Integer"
                                            IsSmart="True"
                                            VisibleIndex="4"/>

                                <dxg:GridColumn Header="Users Not In Favor"
                                            FieldName="UsersNotInFavor"
                                            UnboundType="Integer"
                                            IsSmart="True"
                                            VisibleIndex="5"/>

                                <dxg:GridColumn FieldName="ValidUntil"
                                            Header="Valid Until"
                                            IsSmart="True" 
                                            SortOrder="descending"
                                            VisibleIndex="6">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings Mask="g" MaskType="DateTime" MaskUseAsDisplayFormat="True"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            

                            <dxlc:LayoutGroup Header="Initiated By" View="GroupBox" Grid.ColumnSpan="3" Grid.Row="1">
                                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <Border Height="60" Width="60" CornerRadius="0,10,0,10" BorderBrush="DeepSkyBlue"  HorizontalAlignment="Center" BorderThickness="1">
                                        <Border.Background>
                                            <ImageBrush  x:Name="imgInitiatedBy" ImageSource="/ZAS_ERP;component/images/users-vector-icon-png_260862.jpg"/>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel Margin="10 0 0 0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtInitiatedBy" Text="Name" FontSize="12"/>
                                        <TextBlock x:Name="txtDesignation" Text="Desgnation" FontSize="10" Foreground="Gray"/>
                                    </StackPanel>
                                </StackPanel>
                            </dxlc:LayoutGroup>

                            <Grid Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Text="Valid Until" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5 5 0 10"/>
                                <dxe:DateEdit x:Name="datValidUntil" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="10 5 5 10" IsReadOnly="True" Mask="g" MaskType="DateTime" MaskUseAsDisplayFormat="True"/>
                            </Grid>


                            <dxlc:LayoutGroup Grid.Row="2" Grid.ColumnSpan="3" View="GroupBox" Header="Counters" Margin="0 5 0 0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <dx:SimpleButton x:Name="btnAgreedCount" Grid.Row="2" HorizontalAlignment="Center" Margin="0 0 0 0" Width="80" Click="BtnAgreedCount_Click">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Agreed"/>
                                            <TextBlock x:Name="txtAgreedUsersCount" Text="0" HorizontalAlignment="Center" FontSize="28" Foreground="ForestGreen"/>
                                        </StackPanel>
                                    </dx:SimpleButton>

                                    <dx:SimpleButton x:Name="btnNeutralCount" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" Margin="5 0 0 0" Width="80" Click="BtnNeutralCount_Click">
                                        <StackPanel>
                                            <TextBlock Text="Not Voted"/>
                                            <TextBlock x:Name="txtNeutralUsersCount" Text="0" HorizontalAlignment="Center" FontSize="28" Foreground="Orange"/>
                                        </StackPanel>
                                    </dx:SimpleButton>

                                    <dx:SimpleButton x:Name="btnDisagreedCount" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" Margin="5 0 0 0" Width="80" Click="BtnDisagreedCount_Click">
                                        <StackPanel>
                                            <TextBlock Text="Disagreed"/>
                                            <TextBlock x:Name="txtDisagreedUsersCount" Text="0" HorizontalAlignment="Center" FontSize="28" Foreground="Red"/>
                                        </StackPanel>
                                    </dx:SimpleButton>
                                </StackPanel>
                            </dxlc:LayoutGroup>

                            <Border BorderBrush="DeepSkyBlue" Grid.Row="3" Grid.ColumnSpan="3" BorderThickness="1" CornerRadius="5" Margin="10 10 10 10" Padding="3">
                                <dxe:TextEdit x:Name="txtPollTitle" Margin="0 0 0 0" TextWrapping="Wrap" IsReadOnly="True" FontSize="18"/>
                            </Border>

                            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" x:Name="grdVoteButtons">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <dx:SimpleButton Name="btnAgree"  Margin="5 0 0 10" Padding="3" Click="BtnAgree_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{dx:DXImage Image=Apply_16x16.png}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Agree" VerticalAlignment="Center" Margin="5 0 0 0"/>
                                    </StackPanel>
                                </dx:SimpleButton>

                                <dx:SimpleButton Name="btnDisagree" Grid.Row="4" Grid.Column="2" Margin="5 0 0 10" Click="BtnDisagree_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{dx:DXImage Image=Cancel_16x16.png}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Disagree"  Margin="5 0 0 0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </dx:SimpleButton>
                            </Grid>

                        </Grid>
                    </Grid>

                    <Grid Panel.ZIndex="5" Grid.Row="1" Width="auto" Margin="0 0 0 0" Grid.Column="2" HorizontalAlignment="Left" x:Name="changeLogsPanel" Visibility="Collapsed">
