                                IsSmart="True" 
                                             SortOrder="descending"
                                            Width="auto"/>
                            <dxg:GridColumn FieldName="settingkey"
                                            Header="Version"
                                IsSmart="True" 
                                            Width="auto"/>
                            <dxg:GridColumn Header="Description"
                                FieldName="settingValue"
                                IsSmart="True" />
                        </dxg:GridControl>
                    </Grid>

