<dxr:DXRibbonWindow xmlns:UserTasks="clr-namespace:ZAS_ERP.UserTasks"  xmlns:dxdash="http://schemas.devexpress.com/winfx/2008/xaml/dashboard"  xmlns:Calender="clr-namespace:ZAS_ERP.Calender"  xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
