                     Height="30"
                     x:Name="txtAdressline1"
                     TabIndex="5" />
            <TextBlock Grid.Column="1"
                       Grid.Row="2"
                       x:Name="lbltAdressline2">
                Adress Line 2:</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="2"
                     Margin="10,0"
                     Height="30"
                     x:Name="txtAdressline2"
                     TabIndex="6" />
            <TextBlock x:Name="lbltCity"
                       Grid.Column="1"
                       Grid.Row="3">
                City :</TextBlock>
            <Grid Grid.Column="2"
                  Grid.Row="3"
                  HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"
                       Grid.Row="3"
                       Margin="10,0"
                       Height="30"
                       x:Name="txtCity"
                       TabIndex="7">
                <TextBox.Text>
                  <Binding Path="onlychar"
                           UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                      <vali:onlyalphareq />
                    </Binding.ValidationRules>
                  </Binding>
                </TextBox.Text>
              </TextBox>
              <TextBlock Grid.Column="1"
                         Grid.Row="3"
                         x:Name="lblState">
                State :</TextBlock>
              <TextBox Grid.Column="2"
                       x:Name="txtState"
                       Grid.Row="3"
                       Margin="10,0"
                       Height="30"
                       TabIndex="8">
                <TextBox.Text>
                  <Binding Path="onlychar"
                           UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                      <vali:onlyalphareq />
                    </Binding.ValidationRules>
                  </Binding>
                </TextBox.Text>
              </TextBox>
            </Grid>
            <TextBlock Grid.Column="1"
                       Grid.Row="4"
                       x:Name="lbltZIP">
                ZIP :</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="4"
                     Margin="10,0"
                     Width="150"
                     Height="30"
                     HorizontalAlignment="Left"
                     x:Name="txtZIP"
                     TabIndex="8">
              <TextBox.Text>
                <Binding Path="onlychar"
                         UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <vali:zipvalidation />
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
            <TextBlock Grid.Column="1"
                       Grid.Row="5"
                       x:Name="lbltCountry">
                Country :</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="5"
                     Margin="10,0"
                     Height="30"
                     Width="150"
                     HorizontalAlignment="Left"
                     x:Name="txtCountry"
                     TabIndex="9">
              <TextBox.Text>
                <Binding Path="onlychar"
                         UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <vali:onlyalphareq />
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
          </Grid>
        </dxlc:GroupBox>
                </Border>
            </dx:DXTabItem>
