        utilities:WindowUtilities.CloseOnEscape="True">
    <Grid Background="#bed6f6">
    <Grid.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Margin"
                Value="10,0" />
        
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
      </Style>
            <Style TargetType="dxg:GridColumnHeader">
                <Setter Property="Foreground" Value="White"/>
            </Style>
        </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="35" />
    </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="company name" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" x:Name="lblCompanyName"/>
        </Grid>
        
    <dx:DXTabControl Grid.Row="1">
      <dx:DXTabControl.View>
        <dx:TabControlScrollView HeaderLocation="Left"
                                 HideButtonShowMode="NoWhere"
                                 HeaderOrientation="Horizontal"
                                 AllowAnimation="True"
                                 ShowHeaderMenu="False"
                                 RemoveTabItemsOnHiding="False"
                                 NewButtonShowMode="NoWhere" />
      </dx:DXTabControl.View>

            
                
          
      <dx:DXTabItem Header="Company Information">
                <Border BorderBrush="DeepSkyBlue" BorderThickness="2">
                    <dxlc:GroupBox Header="Company Information">
                        <Grid VerticalAlignment="Stretch"  Background="#bed6f6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20*" />
              <ColumnDefinition Width="91*" />
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="443*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="20" />
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="2"
                       Text="Bussines Name :"
                       Grid.Row="1"
                       x:Name="lbltBussinesName" />
            <TextBox Grid.Column="3"
                     Grid.Row="1"
                     Margin="10,0"
                     Height="30"
                     x:Name="txtBussinesName"
                     TabIndex="1" />
            <!--<TextBlock Text="*"
                       Foreground="Red"
                       Grid.Column="4"
                       Grid.Row="1"
                       Background="White" />-->
            <TextBlock Grid.Column="2"
                       Grid.Row="2"
                       x:Name="lbltIndustry">
                Industry :</TextBlock>
            <ComboBox Grid.Column="3"
                      Height="30"
                      Margin="10,0"
                      x:Name="cmbIndustry"
                      Grid.Row="2"
                      TabIndex="2"
                      VerticalAlignment="Center"
                      
                      SelectionChanged="cmbIndustry_SelectionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel  Orientation="Horizontal">
                    <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                    <TextBlock Text="{Binding name}"></TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <!--<TextBlock Text="*"
                       Foreground="Red"
                       Grid.Column="4"
                       Grid.Row="2"
                       Background="White" />-->
            <TextBlock Grid.Column="2"
                       x:Name="lbltBussinesType"
                       Grid.Row="3">
                Bussines Type :</TextBlock>
            <ComboBox Grid.Column="3"
                      Margin="10,0"
                      Grid.Row="3"
                      x:Name="cmbBussinesType"
                      Height="30"
                      TabIndex="3" />
            <!--<TextBlock Text="*"
                       Foreground="Red"
                       Grid.Column="3"
                       Grid.Row="3"
                       Margin="10,0" />-->
            <TextBlock Grid.Column="2"
                       x:Name="lbltEIN"
                       Grid.Row="4">
                EIN/Employeer # :</TextBlock>
            <TextBox Grid.Column="3"
                     Grid.Row="4"
                     Height="30"
                     Margin="10,0"
                     x:Name="txtEIN"
                     TabIndex="4">
              <TextBox.Text>
                <Binding Path="onlychar"
                         UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <vali:digitvalidation />
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
            <TextBlock Grid.Column="2"
                       x:Name="lblCurrency"
                       Grid.Row="5">
               Base Currency :</TextBlock>
            <ComboBox x:Name="cmbCurrency"
                      Grid.Column="3"
                      Height="30"
                      Margin="10,0"
                      Grid.Row="5"
                      SelectionChanged="cmbCurrency_SelectedIndexChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                    <TextBlock Text="{Binding name}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
                        <CheckBox x:Name="chkisActive"
                      VerticalAlignment="Center"
                      Grid.Column="5" Content="IsActive"
                      Grid.Row="7"
                      IsChecked="True"
                      TabIndex="12" Foreground="Gray"/>
                            <CheckBox x:Name="chkLinkable"
                      VerticalAlignment="Center"
                      Grid.Column="5" Content="isLinkable"
                      Grid.Row="6"
                      TabIndex="12" Foreground="Gray"/>
                        </Grid>
        </dxlc:GroupBox>
            </Border>
            </dx:DXTabItem>
      
            <dx:DXTabItem Header="Adress"
                    TabIndex="5">
                <Border BorderBrush="DeepSkyBlue" BorderThickness="2">
