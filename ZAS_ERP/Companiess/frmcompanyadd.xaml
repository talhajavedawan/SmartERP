<Window x:Class="ZAS_ERP.Companiess.frmcompanyadd"
        mc:Ignorable="d"
        Title="Company Information"
        Height="450"
        Width="780"
        Unloaded="WincompanyAdd_Unloaded"
        Loaded="wincompanyAdd_Loaded"
        x:Name="wincompanyAdd"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
