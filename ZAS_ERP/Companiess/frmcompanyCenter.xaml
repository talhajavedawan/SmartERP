<dx:DXWindow x:Name="loa"
        x:Class="ZAS_ERP.Companiess.frmcompanyCenter"
        mc:Ignorable="d"
        Title="Company Center"
        WindowStyle="ThreeDBorderWindow"
        Loaded="loa_Loaded"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Companiess"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:Databases="clr-namespace:ERP_BL.Databases;assembly=ERP_BL"
        xmlns:ComponentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Unloaded="Loa_Unloaded"
        Width="900"
        Height="680"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.Resources>
      <Style TargetType="{x:Type Label}">
        <Setter Property="Margin"
                Value="10,0" />
        <Setter Property="Foreground"
                Value="Gray" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
      </Style>
      <Style TargetType="TextBlock">
        <Setter Property="HorizontalAlignment"
                Value="Left" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="10,0" />
      </Style>
    </Grid.Resources>
    <dx:DXTabControl TabContentCacheMode="CacheAllTabs">
      <dx:DXTabControl.View>
        <dx:TabControlScrollView />
      </dx:DXTabControl.View>
      <dx:DXTabItem Header="Company"
                    Height="22"
                    VerticalAlignment="Top">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".3*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width=".7*" />
          </Grid.ColumnDefinitions>
          <dxg:GridControl SelectionMode="Row"
                           x:Name="gridCompany"
                           AutoGenerateColumns="None"
                           SelectionChanged="gridCompany_SelectionChanged">
            <dxg:GridControl.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Add New"
                          x:Name="btnNewCompany"
                          Click="btnNewCompany_Click" />
                <MenuItem Header="Edit Company"
                          x:Name="btnEditCompany"
                          Click="btnEditCompany_Click" />
                <Separator />
                <MenuItem Header="Delete Company"
                          x:Name="btnDeleteCompany"
                          Click="btnDeleteCompany_Click" />
              </ContextMenu>
            </dxg:GridControl.ContextMenu>
            <dxg:GridControl.View>
              <dxg:TreeListView x:Name="viewTable"
                                AutoWidth="True"
                                KeyFieldName="Id"
                                ParentFieldName="ParentID"
                                TreeDerivationMode="Selfreference"
                                AutoExpandAllNodes="True"
                                AllowEditing="False"
                                FocusedRowChanged="select_FocusedRowChanged"
                                >
               
              </dxg:TreeListView>
            </dxg:GridControl.View>
            <!--<dxg:GridControl.DataContext>
              <Databases:Company />
            </dxg:GridControl.DataContext>-->
            <dxg:GridColumn x:Name="colId"
                            FieldName="Id"
                            IsSmart="True"
                            Visible="False" />
            <dxg:GridColumn FieldName="CompanyName"
                            IsSmart="True" />
            <dxg:GridColumn FieldName="industryType.name"
                            IsSmart="True" />
            <dxg:GridColumn x:Name="colBizType"
                            FieldName="BizType"
                            Visible="False"
                            IsSmart="True" />
            <dxg:GridColumn FieldName="EmployeerNo"
                            x:Name="colEmployeerNo"
                            IsSmart="True"
                            Visible="False" />
            <!--<dxg:GridColumn FieldName="addressId" x:Name="coladressId" IsSmart="True" Visible="False" />-->
            <!--<dxg:GridColumn FieldName="address" IsSmart="True" x:Name="coladress" Visible="False" />-->
            <!--<dxg:GridColumn FieldName="contactId" Visible="False" x:Name="colcontactId" IsSmart="True" />-->
            <!--<dxg:GridColumn FieldName="contact" x:Name="colcontact" IsSmart="True" Visible="False" />-->
          </dxg:GridControl>
          <Grid x:Name="gridcompanyinfo"
                Background="LightGray"
                Grid.Column="2">
            <!--<Grid.DataContext>
              <Databases:Department />
            </Grid.DataContext>-->
            <Grid.RowDefinitions>
              <RowDefinition Height="240*" />
              <RowDefinition Height="19*" />
              <RowDefinition Height="220*" />
            </Grid.RowDefinitions>
            <dxlc:GroupBox Header="Company Information"
                           Background="White">
              <dxlc:GroupBox.TitleBackground>
                <LinearGradientBrush EndPoint="0.5,1"
                                     StartPoint="0.5,0">
                  <GradientStop Color="#FFE6E8EB"
                                Offset="0" />
                  <GradientStop Color="#FF6CA6FB"
                                Offset="1" />
                </LinearGradientBrush>
              </dxlc:GroupBox.TitleBackground>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                  <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Label Content="Company Name"
                       ToolTip="Company Name"
                       HorizontalAlignment="Right" />
                <Label Content="Adress Line 1"
                       ToolTip="Adress"
                       HorizontalAlignment="Right"
                       Grid.Row="1" />
                <Label Content="Main Phone"
                       ToolTip="Phone#"
                       HorizontalAlignment="Right"
                       Grid.Row="2" />
                <Label Content="FAX"
                       ToolTip="FAX#"
                       HorizontalAlignment="Right"
                       Grid.Row="3" />
                <Label Content="Email"
                       ToolTip="Email"
                       HorizontalAlignment="Right"
                       Grid.Row="4" />
                <Label Content="Website"
                       ToolTip="Website"
                       HorizontalAlignment="Right"
                       Grid.Row="5" />
                <!--textblock for displaying data in colunm 2 of grid from stored company data -->
                <TextBlock x:Name="lblconatctname"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.CompanyName}"
                           ToolTip="contact Name"
                           HorizontalAlignment="Left"
                           Grid.Column="1" />
                <TextBlock x:Name="lblcontactadress"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.address.Line1}"
                           ToolTip="Contact Adress"
                           Grid.Row="1"
                           Grid.Column="1" />
                <TextBlock x:Name="lblmainPhone"
                           ToolTip="Phone#"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.contact.ContactNo}"
                           Grid.Row="2"
                           Grid.Column="1" />
                <TextBlock x:Name="lblfax"
                           ToolTip="FAX#"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.contact.Fax}"
                           Grid.Row="3"
                           Grid.Column="1" />
                <TextBlock x:Name="lblemail"
                           ToolTip="Email"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.contact.Email}"
                           Grid.Row="4"
                           Grid.Column="1" />
                <TextBlock x:Name="lblwebsite"
                           ToolTip="Email"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.contact.Website}"
                           Grid.Row="5"
                           Grid.Column="1" />
                <!-- column 3 labels-->
                <Label Content="State"
                       ToolTip="State"
                       HorizontalAlignment="Right"
                       Grid.Column="2" />
                <Label Content="Adress Line 2"
                       ToolTip=" Adress"
                       HorizontalAlignment="Right"
                       Grid.Column="2"
                       Grid.Row="1" />
                <Label Content="EIN / NTN"
                       ToolTip="Employeer Identification Number or National Tax Number"
                       HorizontalAlignment="Right"
                       Grid.Column="2"
                       Grid.Row="2" />
                <Label Content="Industry Type"
                       ToolTip="Industry"
                       HorizontalAlignment="Right"
                       Grid.Column="2"
                       Grid.Row="3" />
                <Label Content="Bussines Type"
                       ToolTip="Bussines"
                       HorizontalAlignment="Right"
                       Grid.Column="2"
                       Grid.Row="4" />
                <!--textblock for displaying data in colunm 4 of grid from stored company data -->
                <TextBlock x:Name="lblState"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.address.State}"
                           ToolTip="State Name"
                           HorizontalAlignment="Left"
                           Grid.Column="3" />
                <TextBlock x:Name="lbladressline2"
                           ToolTip="Contact Adress"
                           Grid.Row="1"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.address.Line2}"
                           Grid.Column="3" />
                <TextBlock x:Name="lblEIN"
                           ToolTip="EIN/NTN"
                           HorizontalAlignment="Left"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.EmployeerNo}"
                           Grid.Row="2"
                           Grid.Column="3" />
                <TextBlock x:Name="lblindustry"
                           ToolTip="Industry"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.IndustryType}"
                           HorizontalAlignment="Left"
                           Grid.Row="3"
                           Grid.Column="3" />
                <TextBlock x:Name="lblBizType"
                           ToolTip="Bussines Type"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.BizType}"
                           HorizontalAlignment="Left"
                           Grid.Row="4"
                           Grid.Column="3" />
                <TextBlock x:Name="llbadressid"
                           ToolTip="Contact Adress"
                           Visibility="Hidden"
                           Grid.Row="6"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.address.Id}"
                           Grid.Column="3" />
                <TextBlock x:Name="lblcontactid"
                           ToolTip="Contact Adress"
                           Visibility="Hidden"
                           Grid.Row="7"
                           Text="{Binding ElementName=gridCompany,Path=CurrentItem.contact.Id}"
                           Grid.Column="2" />
              </Grid>
            </dxlc:GroupBox>
            <dxlc:GroupBox Header="Relationship"
                           Background="White"
                           Grid.Row="1"
                           Grid.RowSpan="2">
              <dxg:GridControl x:Name="gridCompanyDepartment"
                               AutoGenerateColumns="None"
                               Grid.ColumnSpan="2"
                               IsEnabled="False">
                <dxg:GridControl.View>
                  <dxg:TreeListView x:Name="gridcompdeptview"
                                    AutoWidth="True"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID"
                                    TreeDerivationMode="Selfreference"
                                    AutoExpandAllNodes="True"
                                    IsSynchronizedWithCurrentItem="True"
                                    ></dxg:TreeListView>
                </dxg:GridControl.View>
                <dxg:GridColumn FieldName="Id"
                                IsSmart="True"
                                Visible="False" />
                <dxg:GridColumn FieldName="DeptName"
                                IsSmart="True" />
                <dxg:GridColumn FieldName="Code"
                                IsSmart="True" />
                <dxg:GridColumn FieldName="Abbrivation"
                                IsSmart="True"
                                Visible="True" />
                <dxg:GridColumn FieldName="Timestamp"
                                IsSmart="True"
                                Visible="False" />
              </dxg:GridControl>
              <!--<ItemsControl 
                            Name="pnldepartments">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0" />
                      </Grid.ColumnDefinitions>
                     
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding deptname}"></TextBlock>
                          <TextBlock Text="_" />
                          <TextBlock Text="{Binding secname}"></TextBlock>
                         
                        </StackPanel>
                    
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>-->
            </dxlc:GroupBox>
          </Grid>
          <GridSplitter Grid.Column="1"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Center" />
        </Grid>
      </dx:DXTabItem>
      <dx:DXTabItem Header="Department" x:Name="tabDepartment" MouseUp="tabDepartment_MouseUp">
        <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="183*" />
            <!--<ColumnDefinition Width="45*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="533*" />-->
          </Grid.ColumnDefinitions>

                    <TextBlock Text="All Departments" x:Name="lblDepartment"
                               FontWeight="Bold"
                               FontSize="25"
                               HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Vertical" Grid.Row="1" Margin="0 10 0 10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <dxe:CheckEdit VerticalAlignment="Center" x:Name="chkProcurementType" Content="Procurement Type" Checked="ChkProcurementType_Checked" Unchecked="ChkProcurementType_Unchecked"/>
                            <dxe:CheckEdit VerticalAlignment="Center" x:Name="chkInventoryType" Margin="10 0 0 0" Content="Inventory Type" Checked="ChkInventoryType_Checked" Unchecked="ChkInventoryType_Unchecked"/>
                            <dxe:CheckEdit VerticalAlignment="Center" x:Name="chkVendorBillType" Margin="10 0 0 0" Content="Vendor Bill Type" Checked="ChkVendorBillType_Checked" Unchecked="ChkVendorBillType_Unchecked"/>
                            <dxe:CheckEdit VerticalAlignment="Center" x:Name="chkInterBankTransType" Margin="10 0 0 0" Content="Inter-Bank Transfer Type" Checked="ChkInterBankTransType_Checked" Unchecked="ChkInterBankTransType_Unchecked"/>
                            <dxe:CheckEdit VerticalAlignment="Center" x:Name="chkInterCompanyTransType" Margin="10 0 0 0" Content="Inter-Company Transfer Type" Checked="ChkInterCompanyTransType_Checked" Unchecked="ChkInterCompanyTransType_Unchecked"/>
                            <dxe:CheckEdit VerticalAlignment="Center" x:Name="chkHRMType" Margin="10 0 0 0" Content="HRM Type" Checked="ChkHRMType_Checked" Unchecked="ChkHRMType_Unchecked"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <dxe:CheckEdit VerticalAlignment="Center" x:Name="chkLoansAdvancesType" Content="Loans Advances Type" Checked="ChkLoansAdvancesType_Checked" Unchecked="ChkLoansAdvancesType_Unchecked"/>
                            <dxe:CheckEdit VerticalAlignment="Center" x:Name="chkTaskType" Margin="10 0 0 0" Content="Task Type" Checked="ChkTaskType_Checked" Unchecked="ChkTaskType_Unchecked"/>
                            <dxe:CheckEdit VerticalAlignment="Center" x:Name="chkTravelingRecordType" Margin="10 0 0 0" Content="Traveling Record Type" Checked="ChkTravelingRecordType_Checked" Unchecked="ChkTravelingRecordType_Unchecked"/>
                            <dxe:CheckEdit VerticalAlignment="Center" x:Name="chkAdminBillType" Margin="10 0 0 0" Content="Admin Bill Type" Checked="ChkAdminBillType_Checked" Unchecked="ChkAdminBillType_Unchecked"/>
                            <dxe:CheckEdit VerticalAlignment="Center" x:Name="chkDocumentType" Margin="10 0 0 0" Content="Document Type" Checked="ChkDocumentType_Checked" Unchecked="ChkDocumentType_Unchecked"/>
                        </StackPanel>
                    </StackPanel>

                    <Menu Grid.Row="2" HorizontalAlignment="Center">
                        <MenuItem Header="Save Layout" Name="mbtnSaveLayout" Click="MbtnSaveLayout_Click"/>
                        <MenuItem Header="Refresh" x:Name="mbtnRefresh" Click="MbtnRefresh_Click"/>
                        <MenuItem Header="Add New" x:Name="mbtnAddNew" Click="MbtnAddNew_Click"/>
                        <MenuItem Header="Update" x:Name="mbtnUpdate" Click="MbtnUpdate_Click"/>
                        <MenuItem Header="View All" x:Name="mbtnAllDepartment" Click="mbtnAllDepartment_Click"/>
                        <MenuItem Header="Active" x:Name="mbtnActiveDepartment" Click="mbtnActiveDepartment_Click"/>
                        <MenuItem Header="In-Active" x:Name="mbtnInActiveDepartment" Click="mbtnInActiveDepartment_Click"/>
                    </Menu>

                    <dxg:GridControl x:Name="grdDepartment"
                           AutoGenerateColumns="None"
                           Grid.ColumnSpan="2"
                           Grid.Row="3"
                                     CustomUnboundColumnData="GrdDepartment_CustomUnboundColumnData">
            <dxg:GridControl.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Add New"
                          x:Name="btnAddDepartment"
                          Click="btnAddDepartment_Click" />
                <MenuItem Header="Edit Department"
                          x:Name="btnEditDepartment"
                          Click="btnEditDepartment_Click" />
                <Separator />
                <MenuItem Header="Delete Department"
                          x:Name="btnDeleteDepartment"
                          Click="btnDeleteDepartment_Click" />
              </ContextMenu>
            </dxg:GridControl.ContextMenu>
            <dxg:GridControl.View>
              <dxg:TreeListView x:Name="griddeptview"
                                 KeyFieldName="Id"
                            ParentFieldName="ParentID"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            AutoExpandAllNodes="True"      
                            Width="auto"
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoPopulateServiceColumns="False"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True"      
                            ShowTotalSummary="True"    
                                FocusedRowChanged="griddeptview_FocusedRowChanged"
                                CustomUnboundColumnData="Griddeptview_CustomUnboundColumnData"
                                RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FilterMode="Extended"
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True">
                <!--<dxg:TableView.DataContext>
                  <Databases:DBContextERP />
                </dxg:TableView.DataContext>-->
              </dxg:TreeListView>
            </dxg:GridControl.View>
            
              <dxg:GridColumn FieldName="Id"
                            x:Name="coldeptid"
                            IsSmart="True"
                            Visible="False" />
            
              <dxg:GridColumn x:Name="coldeptname"
                            FieldName="DeptName"
                            IsSmart="True" />
                        
              <dxg:GridColumn FieldName="Companiess"
                                        UnboundType="String"
                                        Visible="True"/>

                        <dxg:GridColumn FieldName="DeptLevel"
                                        Header="Department Level"
                                        UnboundType="String"
                                        Visible="True"/>

                        <dxg:GridColumn x:Name="coldeptcode"
                            FieldName="Code"
                            IsSmart="True" />
            
              <dxg:GridColumn FieldName="Abbrivation"
                            IsSmart="True"
                            x:Name="coldeptabr"/>
            
              <dxg:GridColumn FieldName="Timestamp"
                            IsSmart="True"
                            x:Name="colTimeStamp"/>

                        <dxg:GridColumn FieldName="IsParent"
                            IsSmart="True"
                            x:Name="colIsParent"/>
                        
                        <dxg:GridColumn FieldName="IsSubsidary"
                            IsSmart="True"
                            x:Name="colIsSubsidary"/>

                        <dxg:GridColumn FieldName="IsAdminBillType"
                            IsSmart="True"
                            x:Name="colIsAdminBillType"/>

                        <dxg:GridColumn FieldName="IsManagerial"
                            IsSmart="True"
                            x:Name="colIsManagerial"/>

                        <dxg:GridColumn FieldName="parentDepartment.DeptName"
                                        Header="Parent Dept"
                            IsSmart="True"
                            x:Name="colIsParentDept"/>

                        <dxg:GridColumn FieldName="isActive"
                            IsSmart="True"
                            x:Name="colIsActive"/>

                        <dxg:GridColumn FieldName="IsProcurementType"
                            IsSmart="True"
                            x:Name="colIsProcurementType"/>

                        <dxg:GridColumn FieldName="IsInquiryType"
                            IsSmart="True"
                            x:Name="colIsInquiryType"/>

                        <dxg:GridColumn FieldName="IsOfferType"
                            IsSmart="True"
                            x:Name="colIsOfferType"/>

                        <dxg:GridColumn FieldName="IsSaleOrderType"
                            IsSmart="True"
                            x:Name="colIsSaleOrderType"/>

                        <dxg:GridColumn FieldName="IsSaleInvoiceType"
                            IsSmart="True"
                            x:Name="colIsSaleInvoiceType"/>

                        <dxg:GridColumn FieldName="IsSaleReceiptType"
                            IsSmart="True"
                            x:Name="colIsSaleReceiptType"/>

                        <dxg:GridColumn FieldName="IsPurchaseOrderType"
                            IsSmart="True"
                            x:Name="colIsPurchaseOrderType"/>

                        <dxg:GridColumn FieldName="IsPurchaseInvoiceType"
                            IsSmart="True"
                            x:Name="colIsPurchaseInvoiceType"/>

                        <dxg:GridColumn FieldName="IsPaymentType"
                            IsSmart="True"
                            x:Name="colIsPaymentType"/>

                        <dxg:GridColumn FieldName="IsInventoryType"
                            IsSmart="True"
                            x:Name="colIsInventoryType"/>

                        <dxg:GridColumn FieldName="IsVendorBillType"
                            IsSmart="True"
                            x:Name="colIsVendorBillType"/>

                        <dxg:GridColumn FieldName="IsInterBankTransferType"
                            IsSmart="True"
                            x:Name="colIsInterBankTransferType"/>

                        <dxg:GridColumn FieldName="IsInterCompTransferType"
                            IsSmart="True"
                            x:Name="colIsInterCompTransferType"/>

                        <dxg:GridColumn FieldName="IsLoansAdvancesType"
                            IsSmart="True"
                            x:Name="colIsLoansAdvancesType"/>

                        <dxg:GridColumn FieldName="IsAssetType"
                            IsSmart="True"
                            x:Name="colIsAssetType"/>

                        <dxg:GridColumn FieldName="IsRentalContractType"
                            IsSmart="True"
                            x:Name="colIsRentalContractType"/>

                        <dxg:GridColumn FieldName="IsRentalOrderType"
                            IsSmart="True"
                            x:Name="colIsRentalOrderType"/>

                        <dxg:GridColumn FieldName="IsRentalInvoiceType"
                            IsSmart="True"
                            x:Name="colIsRentalInvoiceType"/>

                        <dxg:GridColumn FieldName="IsRentalReceiptType"
                            IsSmart="True"
                            x:Name="colIsRentalReceiptType"/>

                        <dxg:GridColumn FieldName="IsDocumentType"
                            IsSmart="True"
                            x:Name="colIsDocumentType"/>
                        <!--<dxg:GridColumn FieldName="sectionId" IsSmart="True" Visible="False" />
            <dxg:GridColumn FieldName="sections" IsSmart="True" Visible="False" />-->
          </dxg:GridControl>
          <Grid x:Name="griddepartmentinfo"
                Background="LightGray"
                Grid.Column="3"
                Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <dxlc:GroupBox Header="Department Information"
                           Background="White">
              <dxlc:GroupBox.TitleBackground>
                <LinearGradientBrush EndPoint="0.5,1"
                                     StartPoint="0.5,0">
                  <GradientStop Color="#FFE6E8EB"
                                Offset="0" />
                  <GradientStop Color="#FF6CA6FB"
                                Offset="1" />
                </LinearGradientBrush>
              </dxlc:GroupBox.TitleBackground>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width=".5*" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="1*" />
                  <RowDefinition Height="1*" />
                  <RowDefinition Height="1*" />
                  <RowDefinition Height="1*" />
                  <RowDefinition Height="1*" />
                  <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Label Content="Department Name"
                       ToolTip="Department Name"
                       HorizontalAlignment="Right" />
                <Label Content="Department Code"
                       ToolTip="Department Code"
                       HorizontalAlignment="Right"
                       Grid.Row="1" />
                <Label Content="Abrivation"
                       ToolTip="Maximum 3 Uppercase Letter "
                       HorizontalAlignment="Right"
                       Grid.Row="2" />
                <!--<Label Content="Discription"
                       ToolTip="Discription about Department"
                       HorizontalAlignment="Right"
                       Grid.Row="3" />-->
                <Label Content="Creation Date"
                       ToolTip="Select Creation date"
                       HorizontalAlignment="Right"
                       Grid.Row="3" />
                <TextBlock x:Name="lblDepartmentName"
                           Grid.Column="1"
                           Text="{Binding ElementName=gridDepartment,Path=CurrentItem.DeptName}" />
                <TextBlock x:Name="lblDepartmentCode"
                           Grid.Column="1"
                           Text="{Binding ElementName=gridDepartment,Path=CurrentItem.Code}"
                           Grid.Row="1" />
                <TextBlock x:Name="lblAbr"
                           Grid.Column="1"
                           Text="{Binding ElementName=gridDepartment,Path=CurrentItem.Abbrivation}"
                           Grid.Row="2" />
                <!--<TextBlock x:Name="txtdiscription"
                              Grid.Column="1"
                           Text="{Binding ElementName=gridDepartment,Path=CurrentItem.disc}"
                           Text="{Binding ElementName=griddepartmentinfo,Path=CurrentItem}"
                              Grid.Row="3" />-->
                <dxe:DateEdit Grid.Column="1"
                              DateTime="{Binding ElementName=gridDepartment,Path=CurrentItem.Timestamp}"
                              Grid.Row="3"
                              Height="26"
                              Margin="10,0"
                              IsEnabled="False" />
              </Grid>
            </dxlc:GroupBox>
            <!--<dxlc:GroupBox Header="Relationship"
                           Background="White"
                           Grid.Row="2">
              -->
