<dx:DXWindow x:Class="ZAS_ERP.Companiess.DepartmentLevel.Windows.winfrmDepartmentLevel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Companiess.DepartmentLevel.Windows" 
       xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        mc:Ignorable="d"
        Title="Department Level" Height="280" Width="450" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Grid Background="White">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Margin"
                Value="10,0" />
                <Setter Property="HorizontalAlignment"
                Value="Left" />
                <Setter Property="VerticalAlignment"
                Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition  Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="lblHeading" Text="Department Level"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="17"
                                       Foreground="Black"          
                                       OpacityMask="Black"
                                       FontWeight="DemiBold"/>

        <dx:DXTabControl Grid.Row="1">
            <dx:DXTabItem Header="Detail">
                <dxlc:LayoutGroup 
                                          View="Group" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="auto"/>

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="auto"/>



                        </Grid.RowDefinitions>

                        <TextBlock Text=" Level Title" HorizontalAlignment="Left"  />
                        <dxe:TextEdit x:Name="txtLevel"  Grid.Row="0" Grid.Column="1" />

                        <TextBlock Text="isParent" Grid.Column="0" HorizontalAlignment="Left" Grid.Row="2"/>
                        <CheckBox x:Name="chkIsParent"
                                      Grid.Row="2"
                    Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                    Checked="chkIsParent_Checked"
                    Unchecked="chkIsParent_Unchecked"
                   />

                        <Grid Grid.Row="4" Grid.ColumnSpan="2" x:Name="grdParentLevels" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Parent Level"
                 x:Name="lblParentLevel"
                 ToolTip="Select Parent Level "
                 HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                 Visibility="Visible" />
                            <dxg:LookUpEdit x:Name="lookupParentLevel"
                          Grid.Column="1"
                          Grid.Row="4" Margin="10"
                          DisplayMember="Title"
                          AutoPopulateColumns="True"
                          Visibility="Visible"
                           >
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <dxg:GridControl Name="PART_GridControl"
                                 AutoPopulateColumns="True" AutoGenerateColumns="AddNew" AllowInitiallyFocusedRow="False">
                                            <dxg:GridControl.View>
                                                <dxg:TreeListView Name="treeListView1"
                                      FadeSelectionOnLostFocus="False"
                                      ShowSelectionRectangle="True"
                                      TreeDerivationMode="Selfreference"
                                      KeyFieldName="Id"
                                      ParentFieldName="ParentID" />
                                            </dxg:GridControl.View>
                                            <dxg:GridColumn FieldName="Id"
                                  x:Name="coldeptid"
                                  IsSmart="True"
                                  Visible="False" />
                                            <dxg:GridColumn x:Name="Title"
                                  FieldName="Title"
                                  IsSmart="True" />
                                        </dxg:GridControl>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>

                        </Grid>



                    </Grid>
                </dxlc:LayoutGroup>
            </dx:DXTabItem>
        </dx:DXTabControl>
        <Grid Grid.Row="2">
            <Button
                     FontSize="17"
                                               
                                       OpacityMask="Black"
                                       FontWeight="ExtraBold"         
                Content="Save"  x:Name="btnSave" Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</dx:DXWindow>
