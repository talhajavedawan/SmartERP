<dx:DXWindow  
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
              
    x:Class="ZAS_ERP.Companiess.DepartmentLevel.Windows.winDepartmentLevelList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Companiess.DepartmentLevel.Windows" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        mc:Ignorable="d"
        Title="winDepartmentLevelList" Height="450" Width="800" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu DockPanel.Dock="Top"
              Grid.Row="0"
              x:Name="menuGrid"
              Grid.ColumnSpan="3">
            <MenuItem Header="_Refresh"
                      x:Name="mbtnRefresh"
                      Click="mbtnRefresh_Click"></MenuItem>
           
        </Menu>


        <dxg:GridControl x:Name="gridDepartmentLevels"
                             AutoGenerateColumns="None"
                             Grid.Row="1"
                             SelectionMode="Row"
                             AllowInitiallyFocusedRow="False">
            <dxg:GridControl.View>
                <dxg:TreeListView x:Name="griddeptview"
                                       KeyFieldName="Id"
                            ParentFieldName="ParentID"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            AutoExpandAllNodes="True"      
                            Width="auto"
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoPopulateServiceColumns="False"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True"      
                            ShowTotalSummary="True"    
                            RowAnimationKind="None"
                            WaitIndicatorType="Panel"      
                            FilterMode="Extended"
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True">
              
                </dxg:TreeListView>
            </dxg:GridControl.View>
            <dxg:GridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add New"
                          x:Name="btnNewDepartmentLevel"
                          Click="btnNewDepartmentLevel_Click" />
                    <MenuItem Header="Edit Department Level"
                          x:Name="btnEditDepartmentLevel"
                          Click="btnEditDepartmentLevel_Click" />
                    <Separator />
                 
                </ContextMenu>
            </dxg:GridControl.ContextMenu>
            <dxg:GridColumn FieldName="Id"
                              x:Name="coldeptid"
                              IsSmart="True"
                              Visible="False" />
            <dxg:GridColumn x:Name="Title"
                              FieldName="Title"
                              IsSmart="True" />
        </dxg:GridControl>

    </Grid>
    </dx:DXWindow>
