        <dxe:TextEdit Grid.Row="1" Grid.Column="1" Mask="n0" TabIndex="3" MaskType="Numeric" VerticalAlignment="Center" x:Name="txtYear"/>
        <TextBlock Text="Field"
               Grid.Row="1" Grid.Column="2"/>
        <ComboBox x:Name="cmbField"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                      Grid.Row="1"
                      TabIndex="4" SelectionChanged="CmbField_SelectionChanged"
                     >
