                        <TextBlock Text="{Binding name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="btnLoad" Click="BtnLoad_Click" Grid.Row="2" TabIndex="5" Grid.ColumnSpan="4" VerticalAlignment="Center" Margin="10" Content="Load"/>
        <Button x:Name="btnGraph" Visibility="Collapsed" Click="BtnGraph_Click" Grid.Row="2" TabIndex="6" Grid.Column="3" VerticalAlignment="Center" Margin="10" Content="Generate Graph"/>

        <dxg:GridControl x:Name="grdActualAchivedTarget"
                       AutoGenerateColumns="None"
                       Grid.Row="3"
                       Grid.Column="0"
                         Grid.ColumnSpan="5"
                       SelectionMode="Row"
                       MouseDoubleClick="GrdActualAchivedTarget_MouseDoubleClick">
            <dxg:GridControl.View>
                <dxg:TableView AllowEditing="False"   AllowResizing="False" NavigationStyle="Cell" ShowFixedTotalSummary="True" ShowTotalSummary="True">
                    <dxg:TableView.FormatConditions>
                        
                        <dxg:FormatCondition Expression="[achivedTarget] &gt;= [target]" FieldName="IndviualAward" ApplyToRow="True">
                            <dx:Format Background="#FF29C71E" Foreground="White" FontSize="12" TextDecorations="{x:Null}">
                                <dx:Format.Icon>
                                    <BitmapImage UriSource="pack://application:,,,/DevExpress.Xpf.Core.v21.2;component/Core/ConditionalFormatting/Images/IconSets/Symbols3_1.png" UriCachePolicy="{x:Null}"/>
                                </dx:Format.Icon>
                            </dx:Format>
                        </dxg:FormatCondition>
                        <dxg:FormatCondition Expression="[achivedTarget] &gt;= [target]" FieldName="achivedTarget">
                            <dx:Format FontStyle="Italic" TextDecorations="{x:Null}">
                                <dx:Format.Icon>
                                    <BitmapImage UriSource="pack://application:,,,/DevExpress.Xpf.Core.v21.2;component/Core/ConditionalFormatting/Images/IconSets/Flags3_1.png" UriCachePolicy="{x:Null}"/>
                                </dx:Format.Icon>
                            </dx:Format>
                        </dxg:FormatCondition>
                    </dxg:TableView.FormatConditions>
                    
                </dxg:TableView>
            </dxg:GridControl.View>

            <dxg:GridColumn Header="Company"
                            FieldName="company"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn FieldName="department" 
                            UnboundType="String"
                            Header="Department"
                            />
            <dxg:GridColumn FieldName="currency" 
                            Header="Currency"
                            />

            <dxg:GridColumn FieldName="year" 
                            Header="Year"
                            />
            <dxg:GridColumn FieldName="name" Header="Month"
                            
                            AllowEditing="False" />
            <dxg:GridColumn FieldName="target" 
                            Header="Target"
                            
                             UnboundType="Decimal"        AllowEditing="False" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
                <!--<dxg:GridColumn.EditSettings>
                    <dxe:ProgressBarEditSettings ContentDisplayMode="Value" Minimum="{ Binding achivedTarget}" Maximum="{ Binding target}" NullValue="0" />

                </dxg:GridColumn.EditSettings>-->
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="achivedTarget"
                            Header="Achived Target"
                             UnboundType="Decimal"        AllowEditing="False" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
                <!--<dxg:GridColumn.EditSettings>
