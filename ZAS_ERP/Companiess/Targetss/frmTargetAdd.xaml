<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Targetss"
        xmlns:Validations="clr-namespace:ZAS_ERP.Validations"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        x:Class="ZAS_ERP.Targetss.frmTargetAdd"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        utilities:WindowUtilities.CloseOnEscape="True"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="Add Item"
        Height="450"
        Width="800" Loaded="winItemAdd_Loaded"
        x:Name="winItemAdd" Closing="winItemAdd_Closing">
    <Grid >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground"
                Value="DarkGray" />
                <Setter Property="VerticalAlignment"
                Value="Center" />
                <Setter Property="HorizontalAlignment"
                Value="Right" />
                <Setter Property="Margin"
                Value="10,10" />
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin"
                Value="10,5" />
                <Setter Property="VerticalAlignment"
                Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />

            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />


            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <dxg:LookUpEdit x:Name="lookupCompany"
                          Grid.Column="1"
                          Grid.Row="0"
                          VerticalAlignment="Center"
                          TabIndex="0"
                          DisplayMember="CompanyName"
                          AutoPopulateColumns="False"
                          >
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <!--<Button x:Name="btnAddCompany"
                          Click="btnAddCompany_Click"
                          VerticalAlignment="Center"
                          Content="Add New" />-->
                        <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1">
                            <dxg:GridControl.View>
                                <dxg:TableView Name="tableView1"
                                     ShowAutoFilterRow="True" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="CompanyName"
                                    IsSmart="True" />
                            <dxg:GridColumn FieldName="IndustryType"
                                    IsSmart="True"
                                    Visible="False" />
                            <dxg:GridColumn x:Name="colBizType"
                                    FieldName="BizType"
                                    Visible="False"
                                    IsSmart="True" />
                            <dxg:GridColumn FieldName="EmployeerNo"
                                    x:Name="colEmployeerNo"
                                    IsSmart="True"
                                    Visible="False" />
                            <dxg:GridColumn FieldName="addressId"
                                    x:Name="coladressId"
                                    IsSmart="True"
                                    Visible="False" />
                            <dxg:GridColumn FieldName="address"
                                    IsSmart="True"
                                    x:Name="coladress"
                                    Visible="False" />
                            <dxg:GridColumn FieldName="contactId"
                                    Visible="False"
                                    x:Name="colcontactId"
                                    IsSmart="True" />
                            <dxg:GridColumn FieldName="contact"
                                    x:Name="colcontact"
                                    IsSmart="True"
                                    Visible="False" />
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>
        <TextBlock VerticalAlignment="Center"
                     Grid.Row="0"
                     Text="Company" />
        <dxg:LookUpEdit x:Name="lookupDepartment"
                      Grid.Column="3"
                      Grid.Row="0"
                      DisplayMember="DeptName"
                      VerticalAlignment="Center"
                      AutoPopulateColumns="False"
                      TabIndex="1"
                     >
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--<Button x:Name="btnAddDepartment"
                      Click="btnAddDepartment_Click"
                      VerticalAlignment="Center"
                      Content="Add New" />-->
                        <dxg:GridControl x:Name="PART_GridControl"
                               AutoPopulateColumns="True"
                               Grid.Row="1">
                            <dxg:GridControl.View>
                                <dxg:TreeListView x:Name="treeListView1"
                                    ShowAutoFilterRow="True"
                                    TreeDerivationMode="Selfreference"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="Id"
                                x:Name="coldeptid"
                                IsSmart="True"
                                Visible="False" />
                            <dxg:GridColumn x:Name="coldeptcode"
                                FieldName="Code"
                                IsSmart="True" />
                            <dxg:GridColumn x:Name="coldeptname"
                                FieldName="DeptName"
                                IsSmart="True" />
                            <dxg:GridColumn FieldName="Abbrivation"
                                IsSmart="True"
                                x:Name="coldeptabr" />
                            <dxg:GridColumn FieldName="Timestamp"
                                IsSmart="True"
                                x:Name="coldeptts"
                                Visible="False" />
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>
        <TextBlock Grid.Column="2"
                       x:Name="lblCurrency"
                       Grid.Row="1">
                Currency</TextBlock>
        <ComboBox x:Name="cmbCurrency"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                      Grid.Row="1"
                      TabIndex="3"
                     >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock VerticalAlignment="Center"
                 Grid.Column="2"
                 Grid.Row="0"
                 Text="Department" />



        <TextBlock Text="Target Year"
               Grid.Row="1" />
        <dxe:TextEdit Grid.Row="1" Grid.Column="1" TabIndex="2" x:Name="datYear" VerticalAlignment="Center" MaskType="Numeric"></dxe:TextEdit>
        <TextBlock Text="Target Type"
               Grid.Row="2" Grid.Column="2"/>
        <ComboBox x:Name="cmbTargetType"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                      Grid.Row="2"
                      TabIndex="5"
                     >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="isActive"
               Grid.Row="2" />
        <CheckBox Grid.Column="1" TabIndex="4"
             Grid.Row="2" x:Name="chkIsActive" IsChecked="True"
             VerticalAlignment="Center" Margin="10,5"/>
        <dxg:GridControl x:Name="grdItems"
                         Grid.Row="3"
                        TabIndex="6"
                               Grid.ColumnSpan="4"
                         SelectionMode="Cell">
            <dxg:GridControl.TotalSummary>
                <dxg:GridSummaryItem FieldName="target" SummaryType="Sum"/>
                <dxg:GridSummaryItem FieldName="IndviualAward" SummaryType="Sum"/>
                <dxg:GridSummaryItem FieldName="TotalAward" SummaryType="Sum"/>
                <dxg:GridSummaryItem FieldName="NoOfEmployees" SummaryType="Max"/>
            </dxg:GridControl.TotalSummary>
            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                           ShowGroupPanel="False"
                           AllowColumnFiltering="False"
                           ShowHorizontalLines="True"
                           ShowVerticalLines="True"
                           x:Name="view"
                           
                           RowUpdated="view_RowUpdated" ShowTotalSummary="True" >
                    <!--<dxg:TableView.RowCellMenuCustomizations>
                -->
                    <!--<dxb:BarButtonItem Name="deleteRowItem"
                               Content="Delete"
                               Glyph="{dx:DXImage Image=Cancel_32x32.png}"
                               ItemClick="deleteRowItem_ItemClick" />-->
                    <!--
                <dxb:BarButtonItem Name="deleteRowItema"
                                   Content="Delete"
                                   Glyph="{dx:DXImage Image=Delete_32x32.png}"
                                   Command="{x:Static dxg:GridCommands.DeleteFocusedRow}" />
              </dxg:TableView.RowCellMenuCustomizations>-->
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridColumn FieldName="name"
                          Header="Target"
                          IsSmart="True"
                          UnboundType="String"
                                    ReadOnly="True"
                          >

            </dxg:GridColumn>

            <dxg:GridColumn FieldName="target"
                          Header="Target Amount"
                          UnboundExpression="decimal" ShowValidationAttributeErrors="False"
                           >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Visible="False" ShowInColumnChooser="False" FieldName="IndviualAward"
                        Header="Indviual Award" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="NoOfEmployees"
                          Header="No.Of Employees">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="TotalAward"
                          Header="Award" UnboundExpression="[IndviualAward] * [NoOfEmployees]" UnboundType="Decimal">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

        </dxg:GridControl>
        <!--<TextBlock Text="January"
               Grid.Row="2" Grid.Column="0"  />
        <dxe:TextEdit VerticalAlignment="Center"  EditValueChanged="TxtExtra_EditValueChanged"

                     Grid.Column="1" NullValue="0" NullText="0"
                     Grid.Row="2" ToolTip="Target for month of January"
                     TabIndex="5" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtJanuary" />
        <TextBlock Text="Feburary"
               ToolTip="Target for month of Faburary"
               Grid.Row="2" Grid.Column="2" />
        <dxe:TextEdit VerticalAlignment="Center"  EditValueChanged="TxtExtra_EditValueChanged"

                     Grid.Column="3" NullValue="0" NullText="0"
                     Grid.Row="2" ToolTip="Target for month of Faburary"
                     TabIndex="6" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtFeburary" />
        <TextBlock Text="March" 
               Grid.Row="3" Grid.Column="0"  />
        <dxe:TextEdit VerticalAlignment="Center"  EditValueChanged="TxtExtra_EditValueChanged"

                     Grid.Column="1" NullValue="0" NullText="0"
                     Grid.Row="3" ToolTip="Target for month of March"
                     TabIndex="7" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtMarch" />
        <TextBlock Text="April"
               ToolTip="Target for month of April"
               Grid.Row="3" Grid.Column="2" />
        <dxe:TextEdit VerticalAlignment="Center"  EditValueChanged="TxtExtra_EditValueChanged"

                     Grid.Column="3" NullValue="0" NullText="0"
                     Grid.Row="3" ToolTip="Target for month of April"
                     TabIndex="8" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtApril" />
        <TextBlock Text="May"
               Grid.Row="4" Grid.Column="0"  />
        <dxe:TextEdit VerticalAlignment="Center"  EditValueChanged="TxtExtra_EditValueChanged"

                     Grid.Column="1" NullValue="0" NullText="0"
                     Grid.Row="4" ToolTip="Target for month of May"
                     TabIndex="9" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtMay" />
        <TextBlock Text="June"
               ToolTip="Target for month of June"
               Grid.Row="4" Grid.Column="2" />
        <dxe:TextEdit VerticalAlignment="Center"  EditValueChanged="TxtExtra_EditValueChanged"

                     Grid.Column="3" NullValue="0" NullText="0"
                     Grid.Row="4" ToolTip="Target for month of June"
                     TabIndex="10" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtJune" />
        <TextBlock Text="July"
               Grid.Row="5" Grid.Column="0"  />
        <dxe:TextEdit VerticalAlignment="Center"  EditValueChanged="TxtExtra_EditValueChanged"

                     Grid.Column="1"  NullValue="0" NullText="0"
                     Grid.Row="5" ToolTip="Target for month of July"
                     TabIndex="11" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtJuly" />
        <TextBlock Text="August"
               ToolTip="Target for month of August"
               Grid.Row="5" Grid.Column="2" />
        <dxe:TextEdit VerticalAlignment="Center" EditValueChanged="TxtExtra_EditValueChanged"
                     Grid.Column="3"  NullValue="0" NullText="0"
                     Grid.Row="5" ToolTip="Target for month of August"
                     TabIndex="12" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtAugust" />
        <TextBlock Text="September"
               Grid.Row="6" Grid.Column="0"  />
        <dxe:TextEdit VerticalAlignment="Center" EditValueChanged="TxtExtra_EditValueChanged"
                     Grid.Column="1"  NullValue="0" NullText="0"
                     Grid.Row="6" ToolTip="Target for month of September"
                     TabIndex="13" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtSeptember" />
        <TextBlock Text="October"
               ToolTip="Target for month of October"
               Grid.Row="6" Grid.Column="2" />
        <dxe:TextEdit VerticalAlignment="Center" EditValueChanged="TxtExtra_EditValueChanged"
                     Grid.Column="3"  NullValue="0" NullText="0"
                     Grid.Row="6" ToolTip="Target for month of October"
                     TabIndex="14" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtOctober" />
        <TextBlock Text="November"
               Grid.Row="7" Grid.Column="0"  />
        <dxe:TextEdit VerticalAlignment="Center" EditValueChanged="TxtExtra_EditValueChanged"
                     Grid.Column="1" NullValue="0" NullText="0"
                     Grid.Row="7" ToolTip="Target for month of November"
                     TabIndex="15" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtNovember" />
        <TextBlock Text="Decmeber" 
               ToolTip="Target for month of December"
               Grid.Row="7" Grid.Column="2" />
        <dxe:TextEdit VerticalAlignment="Center" EditValueChanged="TxtExtra_EditValueChanged"
                     Grid.Column="3"  NullValue="0" NullText="0"
                     Grid.Row="7" ToolTip="Target for month of December"
                     TabIndex="16" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtDecember" />
        <TextBlock Text="Extra Target"
               ToolTip="Extra Target"
               Grid.Row="8" />
        <dxe:TextEdit VerticalAlignment="Center" EditValueChanged="TxtExtra_EditValueChanged"
                     Grid.Column="1"  NullValue="0" NullText="0"
                     Grid.Row="8" ToolTip="Extra Target"
                     TabIndex="17" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtExtra"  />
        <TextBlock Text="Total Target"
               ToolTip="Total Target"
               Grid.Row="8" Grid.Column="2" />
        <dxe:TextEdit VerticalAlignment="Center"
                     Grid.Column="3"  NullValue="0" NullText="0"
                     Grid.Row="8" ToolTip="Total Target"
                     TabIndex="18" MaskType="Numeric" Mask="n2"
                          MaskUseAsDisplayFormat="True"
                                 x:Name="txtTotal"  IsReadOnly="True"/>-->




        <Button Content="Save"
            Grid.Row="11"
            FontSize="24"
            x:Name="btnSaveTarget"
            Click="btnSaveTarget_Click"
            FontWeight="Medium"
            Grid.ColumnSpan="4"  />
    </Grid>
</Window>
