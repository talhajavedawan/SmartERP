<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ZAS_ERP.Targetss"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        x:Class="ZAS_ERP.Targetss.frmTargetTypeAdd"
        WindowStartupLocation="CenterScreen"
             mc:Ignorable="d"
             Height="300"
             Width="350" Title="Target Type" x:Name="winTargetTypeAdd" 
        Loaded="winTargetTypeAdd_Loaded" Closing="winTargetTypeAdd_Closing">
  <Grid Margin="0,20,0,0">
    <Grid.Resources>
      <Style TargetType="{x:Type Label}">
        <Setter Property="Margin"
                Value="10,10" />
        <Setter Property="Foreground"
                Value="Gray" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
      </Style>
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Margin"
                Value="10,0" />
        <Setter Property="MaxWidth"
                Value="350" />
      </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width=" auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height=" auto" />
      <RowDefinition Height=" auto" />
            <RowDefinition Height=" auto" />

            <RowDefinition Height="*" />
      <RowDefinition Height=" 50" />
    </Grid.RowDefinitions>
    <Label Content="Target Type"
           ToolTip="Target Type"
           HorizontalAlignment="Right" />
    
    <TextBox x:Name="txtMeasure"
             Grid.Column="1"  VerticalAlignment="Center"/>
        <Label Content="Frequency"
           ToolTip="Select Frequency"
           HorizontalAlignment="Right"
           Grid.Row="1" />
        <ComboBox x:Name="cmbFrequency"
                Margin="10,0"
                
                VerticalAlignment="Center"
                Grid.Column="1"
                Grid.Row="1" />
        <Label Content="Hierarchical Index"
           ToolTip="Select Unique Hierarchical Index(Higher index# means higher priority level)"
           HorizontalAlignment="Right"
           Grid.Row="2" />
        <dxe:SpinEdit x:Name="spnHierarchicalIndex"
                Margin="10,0"
                MinValue="1"
                      
                      MaxValue="100"
                VerticalAlignment="Center"
                Grid.Column="1"
                Grid.Row="2" />
        <Label Content="isActive"
           ToolTip="Unselect to make it inActive"
           HorizontalAlignment="Right"
           Grid.Row="3" />
        <CheckBox x:Name="chkisactive"
                Margin="10,0"
                IsChecked="True"
                VerticalAlignment="Center"
                Grid.Column="1"
                Grid.Row="3" />
     
    
    
    <Button Grid.ColumnSpan="2"
            Grid.Row="4"
            Content="Save"
            FontSize="26"
            x:Name="btnMeasureSave"
            Click="btnMeasureSave_Click" />

  </Grid>
</Window>
