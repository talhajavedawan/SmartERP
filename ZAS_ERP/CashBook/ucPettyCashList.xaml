<UserControl x:Class="ZAS_ERP.CashBook.ucPettyCashList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="35"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <dxr:RibbonControl Grid.Row="0" DockPanel.Dock="Top"  RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
            <dxr:RibbonDefaultPageCategory>
                <dxr:RibbonPage x:Name="lblHeading"  Caption="Cash Book" ToolTip="List of Petty Cashes">
                    <dxr:RibbonPageGroup  Caption="Clipboard">
                        <dxb:BarButtonItem x:Name="mbtnAddNew" Content="Add New" Glyph="{dx:DXImage Image=AddNewDataSource_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                        <dxb:BarButtonItem x:Name="mbtnUpdate" Content="Update" Glyph="{dx:DXImage Image=EditDataSource_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                        <dxb:BarButtonItem x:Name="mbtnSaveLayout" Content="Save Layout" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>
                        <!--<dxb:BarButtonItem x:Name="btnRename" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_32x32.png}" />-->
                        <dxb:BarButtonItem x:Name="mbtnDelete" Content="Delete" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>
                        <dxb:BarButtonItem x:Name="mbtnRefresh" Content="Refresh" ItemClick="MbtnRefresh_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>

                        <dxb:BarButtonItem ToolTip="Expand" x:Name="mbtnExpand" Content="Expand" Glyph="{dx:DXImage Image=Stretch_32x32.png}" LargeGlyph="{dx:DXImage Image=Stretch_32x32.png}"/>
                        <dxb:BarButtonItem ToolTip="Collapse" x:Name="mbtnCollapse" Content="Collapse" Glyph="{dx:DXImage Image=Squeeze_32x32.png}" LargeGlyph="{dx:DXImage Image=Squeeze_32x32.png}"/>
                        <dxb:BarButtonItem ToolTip="Export to Report" x:Name="mbtnExport" Content="Export to Report" IsVisible="False" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                    </dxr:RibbonPageGroup>
                    <!--<dxr:RibbonPageGroup Caption="Font">
                                <dxr:BarButtonGroup>
                                    <dxb:BarButtonItem Content="Export to Standard" Glyph="{dx:DXImage Image=Bold_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Italic" Glyph="{dx:DXImage Image=Italic_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Underline" Glyph="{dx:DXImage Image=Underline_16x16.png}"/>
                                </dxr:BarButtonGroup>

                            </dxr:RibbonPageGroup>-->
                </dxr:RibbonPage>

            </dxr:RibbonDefaultPageCategory>
        </dxr:RibbonControl>

        <TextBlock Grid.Row="1" x:Name="txtHeader" Text="Petty Cash" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="25" FontWeight="Bold"/>

        <dxg:GridControl x:Name="grdPettyCash"
                    Margin="5,5,5,5"        
                          SelectionMode="Row"
                          Grid.Row="2" 
                         AutoGenerateColumns="None"
                          Grid.ColumnSpan="3"
                         MouseDoubleClick="GrdListTransactions_MouseDoubleClick"
                          CustomUnboundColumnData="GrdListTransactions_CustomUnboundColumnData"       
                         dx:DXSerializer.SerializationID="grid"
                         CustomSummary="GrdPettyCash_CustomSummary">

            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                           ShowGroupPanel="True"
                           AllowColumnFiltering="True"
                           ShowHorizontalLines="True"
                           ShowVerticalLines="True"
                           ColumnFilterPopupMode="Excel"
                           NavigationStyle="Row"
                           ShowAutoFilterRow="True"       
                           Width="auto"   
                           RowAnimationKind="None" WaitIndicatorType="Panel"
                           ShowFixedTotalSummary="True"
                           ShowTotalSummary="True"
                           AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                           x:Name="view1"
                              ColumnHeaderClick="View1_ColumnHeaderClick" 
                               CellValueChanged="View1_CellValueChanged"
                               />
            </dxg:GridControl.View>

            <dxg:GridColumn FieldName="Id"
                            ReadOnly="True"
                            Visible="False"  
                            ShowInColumnChooser="False"
                            VisibleIndex="1"  
                            Header="Id" />

            <dxg:GridColumn Header="Creation Date"
                            FieldName="CreationDate"
                            IsSmart="True"
                            VisibleIndex="2"/>

            <dxg:GridColumn Header="Module"
                            FieldName="TransactionType"
                            IsSmart="True"
                            VisibleIndex="3"/>

            <dxg:GridColumn Header="Company"
                            FieldName="company.CompanyName"
                            IsSmart="True"
                            VisibleIndex="4"/>
            
            <dxg:GridColumn Header="Department"
                            FieldName="department.DeptName" 
                            VisibleIndex="5"  
                            UnboundExpression="[department.parentDepartment.DeptName] +' '+ [department.DeptName]"/>

            <dxg:GridColumn Header="Original Currency"
                            FieldName="OriginalCurrency.CurrencyName"
                            IsSmart="True"
                            VisibleIndex="6"/>

            <dxg:GridColumn Header="Finance Ref #"
                            FieldName="FinanceRefNo"
                            IsSmart="True"
                            VisibleIndex="7"/>

            <dxg:GridColumn Header="System Ref #"
                            FieldName="SystemRefNo"
                            IsSmart="True"
                            VisibleIndex="8"/>

            <dxg:GridColumn Header="Petty Cash Ref"
                            FieldName="PettyCashRef.BillReferenceNo"
                            IsSmart="True"
                            VisibleIndex="8"/>

            <dxg:GridColumn Header="Receipt (OC)"
                            FieldName="debit"
                            IsSmart="True"
                            VisibleIndex="9">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Payment (OC)"
                            FieldName="credit"
                            IsSmart="True"
                            VisibleIndex="10">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="MER"
                            FieldName="MER"
                            IsSmart="True"
                            VisibleIndex="11"
                            Visible="False"
                            ShowInColumnChooser="False">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Balance (OC)"
                            FieldName="balanceAmount"
                            UnboundType="Decimal"
                            IsSmart="True"
                            Width="200"
                            VisibleIndex="12">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Total"
                            FieldName="total"
                            IsSmart="True"
                            VisibleIndex="13"
                            Visible="False"
                            ShowInColumnChooser="False">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridControl.TotalSummary>

                <dxg:GridSummaryItem FieldName="debit" SummaryType="Sum" DisplayFormat="n2"/>
                <dxg:GridSummaryItem FieldName="credit" SummaryType="Sum" DisplayFormat="n2"/>
                <dxg:GridSummaryItem FieldName="balanceAmount" SummaryType="Custom" DisplayFormat="Balance={0:n2}"/>
            </dxg:GridControl.TotalSummary>

        </dxg:GridControl>
    </Grid>
</UserControl>
