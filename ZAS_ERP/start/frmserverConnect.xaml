<Window xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.start"
        xmlns:Custom="http://schemas.devexpress.com/winfx/2008/xaml/editors/internal"
        xmlns:view="clr-namespace:ZAS_ERP.Usercontrols"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        x:Class="ZAS_ERP.start.frmserverConnect"
        mc:Ignorable="d"
      
        Title="frmserverConnect"
        Height="430"
        Width="330"
        x:Name="frmServerWindow"
     
      
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Chromeless" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border BorderThickness="0" Width="40" Height="40">
                            <ContentPresenter/>
                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

   


    <Grid>
    <Grid Visibility="Hidden">
      <dx:DXTabControl>
        <dx:DXTabItem x:Name="tabCustomers"
                      Header="Customers"
                      ></dx:DXTabItem>
      </dx:DXTabControl>
      <dxg:GridControl>
        <dxg:GridControl.Columns>
          <dxg:GridColumn />
        </dxg:GridControl.Columns>
      </dxg:GridControl>
      <dxg:LookUpEdit></dxg:LookUpEdit>
    </Grid>
    <Grid 
    >
    
    <Grid.ColumnDefinitions>
    
      <ColumnDefinition Width="300*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="3*" />
      <RowDefinition Height="3*" />
      <RowDefinition Height="30" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>

          


            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.5*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                
                    <ColumnDefinition/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition/>
                 
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <ToggleButton x:Name="btnLanToggle" 
                              Width="40" Height="40"
                              
                              Style="{StaticResource Chromeless}"  
                              ToolTip="Connect Office LAN"                           
                              Cursor="Hand">

                        <Image x:Name="btnLan"
                     
                              MouseLeftButtonDown="BtnLan_MouseLeftButtonDown"
                      
                       Cursor="Hand"
                       ToolTip="Connect Office LAN"
                     Source="/ZAS_ERP;component/images/lan.png"
                       />

                    </ToggleButton>
                    <TextBlock x:Name="txtLan" 
                        Text="Connect Office LAN" 
                           Grid.Row="2"
                           FontSize="9" HorizontalAlignment="Center" />

                </Grid>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <ToggleButton Name="btnWanToggle" Grid.Column="1"
                              Style="{StaticResource Chromeless}"
                              ToolTip="Connect WAN"
                                  >

                        <Image x:Name="btnWan"
                              
                               Source="/ZAS_ERP;component/images/wan.png" Cursor="Hand"
                        Grid.Column="1" 
                        MouseLeftButtonDown="BtnWan_MouseLeftButtonDown"
                       ToolTip="Connect WAN"
                       Visibility="Collapsed"
                       />


                    </ToggleButton>
                    <TextBlock x:Name="txtWan" Text="Connect WAN" Grid.Column="1"
                           Grid.Row="2"
                           Visibility="Collapsed"
                           FontSize="9" HorizontalAlignment="Center"/>
                </Grid>

                <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <ToggleButton Name="btnIpToggle" Grid.Column="2"
                              Style="{StaticResource Chromeless}"
                              ToolTip="Connect WAN">
                        <Image x:Name="btnIp" Source="/ZAS_ERP;component/images/ipPsd.png" Cursor="Hand"
                        Grid.Column="2"
                      Height="40" Width="40"
                       
                       ToolTip="Enter Server/Ip"
                        HorizontalAlignment="Left"
                       Visibility="Visible"
                       MouseLeftButtonDown="BtnIp_MouseLeftButtonDown"
                       MouseRightButtonDown="BtnIp_MouseRightButtonDown"/>

                    </ToggleButton>
                    <TextBlock x:Name="txtIp" Text="Enter Ip Address" Grid.Column="2"
                           Grid.Row="2"
                           Visibility="Visible"
                           FontSize="9" HorizontalAlignment="Center"/>

                </Grid>

                





                <dxe:ComboBoxEdit NullText="Server/Ip"
                         x:Name="cmbserverAdress"
                         HorizontalAlignment="Center"                
                         Grid.Row="1" Grid.ColumnSpan="4"
                         VerticalAlignment="Center"
                         Width="250" 
                              />
            </Grid>
        
 
    <!--<Label x:Name="lblipAdress"
           Content="Server/IP :"
           HorizontalAlignment="Right"
           Margin="10"
           Grid.Row="1"
           VerticalAlignment="Center"
           Width="71" />-->
    <!--<Label x:Name="lblport"
           Content="Port # :"
           HorizontalAlignment="Center"
           Margin="29,72,0,0"
           Grid.Row="1"
           VerticalAlignment="Top"
           Width="71" />
    <TextBox x:Name="textBox"
             Grid.Column="1"
             HorizontalAlignment="Left"
             Height="23"
             Margin="10,71,0,0"
             Grid.Row="1"
             TextWrapping="Wrap"
             VerticalAlignment="Top"
             Width="200"
             MaxLength="6"
             MaxLines="1" />-->
      <dxe:ButtonClose Grid.Column="2"
                       x:Name="btnclose"
                       Click="btncloseclick"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"></dxe:ButtonClose>
      
      <Label x:Name="lblstatusBar"
           Content="{Binding currentStatus}"
           HorizontalAlignment="Center"
           Grid.ColumnSpan="3"
           Grid.Row="2"
           VerticalAlignment="Bottom" />
    <!--<TextBlock x:Name="textBlock"
               HorizontalAlignment="Center"
              
               TextWrapping="Wrap"
               Text="Welcome to ZAS-ERP                                                                "
               VerticalAlignment="Center"
               Width="160"
               FontSize="16"
               FontWeight="Bold"
               Grid.Column="1" />-->
            <Image Source="/ZAS_ERP;component/images/zasLogo.png" Height="130" Width="130" />


            <Button x:Name="btnconnectServer"
        
                    IsEnabled="False"
            HorizontalAlignment="Center"
          Grid.Column="1"
            Grid.Row="3"
          Content="Connect"
            VerticalAlignment="Center"
            Click="btnconnectServer_Click" >
            
                    
            </Button>
        
            <Grid Grid.Row="4" Background="#05628e">

                <TextBlock Text="Welcome to ZAS-ERP"
                       Foreground="White"
                           TextWrapping="Wrap"
                           FontFamily="aries"
                           FontWeight="DemiBold" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        
        </Grid>
  </Grid>
</Window>
