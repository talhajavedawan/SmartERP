<Page
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ZAS_ERP.start"
      xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
      xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    x:Class="ZAS_ERP.start.pageDbConnect"
      mc:Ignorable="d" 
      d:DesignHeight="430" d:DesignWidth="330"
      Loaded="Page_Loaded"
      Title="pageDbConnect">

    <Page.Resources>
        <Style x:Key="Chromeless" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border BorderThickness="0" Width="15" Height="15">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>


        <dxe:ImageEdit VerticalAlignment="Bottom"
                Source="/ZAS_ERP;component/images/zasLogo.png"
                Width="130" 
                Height="130"
                MouseDown="Image_MouseDown"/>

        <dxe:TextEdit Text="Login"
                  IsReadOnly="True" IsEnabled="False"
                   Grid.Row="1" VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="25"  FontFamily="arial" FontWeight="DemiBold"/>




        <dxlc:LayoutControl Grid.Row="2"  >
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition/>
                    <RowDefinition Height="10"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label x:Name="lblipAdress"
          
           HorizontalAlignment="Center"
          
           Grid.Row="0"
           VerticalAlignment="Top"
           Width="71"
           Height="22" />
                <Label x:Name="lblUsername"
         
           HorizontalAlignment="Center"
       
           Grid.Row="2"
           VerticalAlignment="Top"
           Width="71"
           Height="22" />
                <dxe:ComboBoxEdit x:Name="cmbdbSelect"
                          NullText=" Please Select DataBase"
                      HorizontalAlignment="Center"
                   
                      Grid.Row="1"
                      VerticalAlignment="Center"
                      Width="250"
                      Height="22"
                      SelectedIndex="1"
                      TabIndex="0"
                      SelectedIndexChanged="cmbdbSelect_SelectedIndexChanged"  />
                <dxe:PasswordBoxEdit x:Name="txtUsername"
            KeyUp="TxtUsername_KeyUp"
             TabIndex="1"
             NullText="Enter Your User Name"
             HorizontalAlignment="Center"
             Height="23"
             
             Grid.Row="3"
             TextWrapping="Wrap"
         
             Width="250"
             MaxLength="14"
              IsEnabled="False" />
                <dxe:TextEdit MaxLength="14" Grid.Row="3"  KeyUp="TxtPassword_KeyUp"
                       Height="22"   Width="250" 
                       x:Name="txtPassword" 
                       Visibility="Collapsed"
                    EditValue="{Binding Password, ElementName=txtpasswordBox}"
                    />




                <ToggleButton Style="{StaticResource Chromeless}" 
                         Grid.Row="3" VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                          Margin="270,0,40.6,22" 
                          Padding="5,2"
                          x:Name="btn">


                    <Image x:Name="imgEye" Source="/ZAS_ERP;component/images/Eview.png" 
                      
                       MouseLeftButtonDown="Image_MouseLeftButtonDown"/>


                </ToggleButton>
            </Grid>
        </dxlc:LayoutControl>
           
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>
            <!--<Button x:Name="btnlogindb" Click="btnlogindb_Click" Width="90" Height="30" HorizontalAlignment="Right" >
                <Image Source="/ZAS_ERP;component/images/next.png" HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>-->
            <!--</Button>-->
        </Grid>






        <Grid Grid.Row="4" Background="#05628e">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label  x:Name="lblstatusBar"
                  
                       Foreground="White"
                    FontFamily="aries"
                    FontWeight="DemiBold"
                       HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Column="1" Padding="0 0 40 0"/>
            <Label x:Name="lblVersion" Content="0.0.0" Padding="10 0 10 0"
               HorizontalAlignment="Left"
                VerticalAlignment="Center"
                   Foreground="White" Grid.Column="0"
               />
        </Grid>


    </Grid>
</Page>
