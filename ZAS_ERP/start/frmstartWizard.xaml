<Window x:Class="ZAS_ERP.start.frmstartWizard"
        mc:Ignorable="d"
        Title="frmstartWizard"
        MinHeight="450"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.start"
        xmlns:vali="clr-namespace:ZAS_ERP.Validations"
        ResizeMode="NoResize"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        Loaded="Window_Loaded"
        Style="{StaticResource bluewindowstyle}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
  <Grid Name="main">
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Height="50">
      <ProgressBar Width="800"
                   Minimum="0"
                   Maximum="100"
                   x:Name="progWizardbar"
                   HorizontalAlignment="Stretch"
                   Margin="-3,0,-2,-3">
        <ProgressBar.Foreground>
          <LinearGradientBrush EndPoint="0,1"
                               StartPoint="0,0">
            <GradientStop Color="#FF5585EC"
                          Offset="1" />
            <GradientStop Color="#FFB2CAFF"
                          Offset="0.377" />
          </LinearGradientBrush>
        </ProgressBar.Foreground>
      </ProgressBar>
    </StackPanel>
    <DockPanel MinHeight="400"
               Grid.ColumnSpan="2">
      <dxco:Wizard x:Name="wizardgroup">
        <dxco:Wizard.FooterTemplate>
          <DataTemplate>
            <dxco:WizardDialogFooter>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130*" />
                  <ColumnDefinition Width="131*" />
                  <ColumnDefinition Width="130*" />
                </Grid.ColumnDefinitions>
                <dxco:WizardButton Grid.Column="0"
                                   Content="Cancel"
                                   
                                   x:Name="btnWizardCancel"
                                   Click="WizardButton_Cancel" />
                <!--dxco:Wizard.IsButtonCancel="True"-->
                <dxco:WizardButton Grid.Column="1"
                                   Content="Back"
                                   Click="WizardButton_back"
                                   x:Name="btnWizardBack"
                                   dxco:Wizard.IsButtonBack="True" />
                <dxco:WizardButton Grid.Column="2"
                                   Content="Next"
                                   IsDefault="True"
                                   x:Name="btnWizardNext"
                                   Click="WizardButton_next"
                                   dxco:Wizard.IsButtonNext="True" />
                <dxco:WizardButton Grid.Column="2" 
                                   Content="Create Comapny"
                                   x:Name="btnWizardNewCompany"
                                   Click="WizardButton_NewCompany"
                                   dxco:Wizard.IsButtonFinish="True" />
              </Grid>
            </dxco:WizardDialogFooter>
          </DataTemplate>
        </dxco:Wizard.FooterTemplate>
        <dxco:WelcomeWizardPage ShowFooter="True"
                                Header="Lets get started!"
                                Title="Welcome to ZAS-ERP">
          <Grid VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20*" />
              <ColumnDefinition Width="91*" />
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="443*" />
              <ColumnDefinition Width="111*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="20" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="2"
                       Text="Bussines Name :"
                       Grid.Row="1"
                       Margin="20"
                       x:Name="lbltBussinesName">
                </TextBlock>
            <TextBox Grid.Column="3"
                     Grid.Row="1"
                     Margin="20"
                     TabIndex="0"
                     x:Name="txtBussinesName"></TextBox>
            <TextBlock Text="*"
                       Margin="0,15,0,0"
                       Foreground="Red"
                       Grid.Column="4"
                       Grid.Row="1"
                       Background="White" />
            <TextBlock Grid.Column="2"
                       Grid.Row="2"
                       x:Name="lbltIndustry"
                       Margin="20">
                Industry :</TextBlock>
            <ComboBox Grid.Column="3"
                      x:Name="cmbIndustry"
                      Grid.Row="2"
                      Margin="20"
                      TabIndex="1"             
                      VerticalAlignment="Center"
                      
                      SelectionChanged="cmbIndustry_SelectionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel  Orientation="Horizontal">
                    <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                    <TextBlock Text="{Binding name}"></TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="*"
                       Margin="0,15,0,0"
                       Foreground="Red"
                       Grid.Column="4"
                       Grid.Row="2"
                       Background="White" />
            <TextBlock Grid.Column="2"
                       x:Name="lbltBussinesType"
                       Grid.Row="3"
                       Margin="20">
                Bussines Type :</TextBlock>
            <ComboBox Grid.Column="3"
                      Grid.Row="3" TabIndex="2"
                      x:Name="cmbBussinesType"
                      Margin="20"></ComboBox>
            <TextBlock Text="*"
                       Margin="0,15,0,0"
                       Foreground="Red"
                       Grid.Column="4"
                       Grid.Row="3"
                       Background="White" />
            <TextBlock Grid.Column="2"
                       x:Name="lbltEIN"
                       Grid.Row="4"
                       Margin="20">
                EIN/Employeer # :</TextBlock>
            <TextBox Grid.Column="3"
                     Grid.Row="4"
                     Margin="20"
                     TabIndex="3"
                     x:Name="txtEIN" KeyDown="txtEIN_KeyDown" />
          </Grid>
        </dxco:WelcomeWizardPage>
        <dxco:WizardPage Header="Enter Adress"
                         Title="Welcome to ZAS-ERP">
          <Grid VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="4*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="20" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="1"
                       Grid.Row="1"
                       Margin="20"
                       x:Name="lbltAdressLine1">
                Adress Line 1:</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="1"
                     Margin="20"
                     TabIndex="5"
                     x:Name="txtAdressLine1"></TextBox>
            <TextBlock Grid.Column="1"
                       Grid.Row="2"
                       Margin="20"
                       x:Name="lbltAdressLine2">
                Adress Line 2:</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="2"
                     Margin="20"
                     TabIndex="6"
                     x:Name="txtAdressLine2"></TextBox>
            
            <TextBlock x:Name="lbltCity"
                       Grid.Column="1"
                       Grid.Row="3"
                       Margin="20">
              
                City :</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="3"
                     Margin="20"
                     TabIndex="7"
                     x:Name="txtCity">
              <TextBox.Text>
                <Binding Path="onlychar"
                         UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <vali:onlyalphareq />
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
            <TextBlock Grid.Column="1"
                       Grid.Row="4"
                       Margin="20"
                       x:Name="lblState">
                State :</TextBlock>
            <Grid Grid.Column="2"
                  Grid.Row="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <TextBox  x:Name="txtstate"
                        HorizontalAlignment="Stretch"
                     TabIndex="8"   VerticalAlignment="Center"
                        Margin="20,0">
                <TextBox.Text>
                  <Binding Path="onlychar"
                           UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                      <vali:onlyalphareq />
                    </Binding.ValidationRules>
                  </Binding>
                </TextBox.Text>
              </TextBox>
            <TextBlock Grid.Column="1"
                       
                       
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         x:Name="lbltZIP">
                ZIP :</TextBlock>
              <TextBox Grid.Column="2"
                       Margin="20,0" TabIndex="9"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       x:Name="txtZIP">
                <TextBox.Text>
                  <Binding Path="onlychar"
                           UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                      <vali:zipvalidation />
                    </Binding.ValidationRules>
                  </Binding>
                </TextBox.Text>
              </TextBox>
            </Grid>
              <TextBlock Grid.Column="1"
                       Grid.Row="5"
                       Margin="20"
                       x:Name="lbltCountry">
                Country :</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="5"
                     Margin="20" TabIndex="10"
                     x:Name="txtCountry">
              <TextBox.Text>
                <Binding Path="onlychar"
                         UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <vali:onlyalphareq />
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
          </Grid>
        </dxco:WizardPage>
        <dxco:WizardPage Header="Enter Contact Details..."
                         Title="Welcome to ZAS-ERP">
          <Grid VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="4*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="20" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="1"
                       Grid.Row="1"
                       Margin="15"
                       x:Name="lbltPhonenum">
                Phone :</TextBlock>
            <DockPanel HorizontalAlignment="Stretch"
                       Grid.Column="2"
                       Grid.Row="1">
              <TextBox MinWidth="160"
                       Margin="15" TabIndex="11"
                       x:Name="txtPhonenum">
                <TextBox.Text>
                  <Binding Path="onlychar"
                           UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                      <vali:contactnumval />
                    </Binding.ValidationRules>
                  </Binding>
                </TextBox.Text>
              </TextBox>
              <TextBlock HorizontalAlignment="Center"
                         Grid.Column="1"
                         x:Name="lbltFaxnum"
                         Grid.Row="1"
                         Margin="40,15,20,15">     Fax :</TextBlock>
              <TextBox HorizontalAlignment="Right"
                       Margin="15"
                       MinWidth="160" TabIndex="12"
                       x:Name="txtFaxnum">
                <TextBox.Text>
                  <Binding Path="onlychar"
                           UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                      <vali:contactnumval />
                    </Binding.ValidationRules>
                  </Binding>
                </TextBox.Text>
              </TextBox>
            </DockPanel>
            <TextBlock Grid.Column="1"
                       Grid.Row="2"
                       Margin="15" 
                       x:Name="lbltEmail">
                Email :</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="2"
                     Margin="15" TabIndex="13"
                     x:Name="txtEmail">
              <TextBox.Text>
                <Binding Path="onlychar"
                         UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <vali:emailreq />
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
            <TextBlock Grid.Column="1"
                       Grid.Row="3"
                       x:Name="lbltWebsite"
                       Margin="15">
                Website :</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="3"
                     Margin="15" TabIndex="14"
                     x:Name="txtWebsite">
              <TextBox.Text>
                <Binding Path="onlychar"
                         UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <vali:urlvalidation />
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
            <TextBlock Grid.Column="1"
                       Grid.Row="4"
                       Margin="15"
                       x:Name="lbltPage1">
                Page :</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="4"
                     x:Name="txtPage1" TabIndex="15"
                     Margin="15">
              <TextBox.Text>
                <Binding Path="onlychar"
                         UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <vali:urlvalidation />
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
            <TextBlock Grid.Column="1"
                       Grid.Row="5"
                       Margin="15"
                       x:Name="lbltPage2">
                Page :</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="5" TabIndex="16"
                     x:Name="txtPage2"
                     Margin="15">
              <TextBox.Text>
                <Binding Path="onlychar"
                         UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <vali:urlvalidation />
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
            <TextBlock Grid.Column="1"
                       Grid.Row="6"
                       Margin="15"
                       x:Name="lbltPage3">
                Page :</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="6"
                     Margin="15" TabIndex="17"
                     x:Name="txtPage3">
              <TextBox.Text>
                <Binding Path="onlychar"
                         UpdateSourceTrigger="PropertyChanged">
                  <Binding.ValidationRules>
                    <vali:urlvalidation />
                  </Binding.ValidationRules>
                </Binding>
              </TextBox.Text>
            </TextBox>
          </Grid>
        </dxco:WizardPage>
        <dxco:CompletionWizardPage Title="Welcome to ZAS-ERP"
                                   Header="Last Step, Lets setup Your Administrator Account">
          <Grid VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="4*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="20" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="1"
                       Grid.Row="1"
                       Margin="20"
                       x:Name="lbltUsername">
               Username :</TextBlock>
            <TextBox Grid.Column="2"
                     Grid.Row="1"
                     Margin="20"
                     x:Name="txtUsername"
                     IsEnabled="False">Administrator</TextBox>
            <TextBlock Grid.Column="1"
                       Grid.Row="4"
                       Margin="20"
                       x:Name="lbltPassword">
                Password :</TextBlock>
            <PasswordBox Grid.Column="2" TabIndex="18"
                     Grid.Row="4"
                     x:Name="txtPassword"
                     Margin="20" />
            <TextBlock Text="*"
                       Margin="0,15,0,0"
                       Foreground="Red"
                       Grid.Column="3"
                       Grid.Row="2"
                       Background="White" />
          </Grid>
        </dxco:CompletionWizardPage>
        <ProgressBar Height="10"
                     Width="100" />
      </dxco:Wizard>
    </DockPanel>
  </Grid>
</Window>