        <Grid x:Name="grdComments"  Visibility="Collapsed" Width="500" Background="Gray" Panel.ZIndex="5" VerticalAlignment="Stretch" Margin="35" HorizontalAlignment="Left">
            <dxg:GridControl AutoExpandAllGroups="True"  
