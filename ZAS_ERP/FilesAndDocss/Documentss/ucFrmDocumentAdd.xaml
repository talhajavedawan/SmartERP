                            SortOrder="Descending" />
                </dxg:GridControl.Columns>
                <!--#endregion-->
                <dxg:GridControl.View>
                    <dxg:TableView 
                            x:Name="GrdCommenttableView" AllowEditing="False" DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                                    DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0" RowStyle="{StaticResource RowStyle}" ShowSearchPanelMode="Always" SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" ShowIndicator="False" ShowVerticalLines="False"
                            CompactPanelShowMode="Always" SwitchToCompactModeWidth="700"
                             NavigationStyle="Row"
                           >

                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />


                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Changed')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Traveling Record Approved')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Traveling Record UnApproved')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Traveling Record Voided')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="Orange" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Traveling Record UnVoided')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="Orange" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>


                            <!--<dxg:TopBottomRuleFormatCondition Rule="TopItems" Threshold="20" FieldName="Profit">
                                <dx:Format Background="Purple"/>
                            </dxg:TopBottomRuleFormatCondition>-->
                            <!--<dxg:FormatCondition Expression="Contains([Symbol], 'Status of Receipt has been changed')" FieldName="Comment" PredefinedFormatName="LightRedFillWithDarkRedText">-->

                            <!--<dxg:FormatCondition Expression="Contains('Status of Receipt has been changed')" FieldName="Comment" PredefinedFormatName="LightRedFillWithDarkRedText">-->

                            <!--</dxg:FormatCondition>-->
                        </dxg:TableView.FormatConditions>
                        <!--#region CompactModeFilterItems-->
                        <!--<dxg:TableView.CompactModeFilterItems>
