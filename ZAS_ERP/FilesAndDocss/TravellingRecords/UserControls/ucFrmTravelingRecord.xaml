                                      MaskType="Numeric"
                                      MaskUseAsDisplayFormat="True"/>
                    </Grid>

                </Grid>
            </dxlc:LayoutGroup>

            
            <dx:SimpleButton x:Name="btnSave" Click="BtnSave_Click" Content="Save" FontWeight="Bold" Grid.Row="7" Height="30" Grid.ColumnSpan="3" Margin="0 10 0 0"/>

        
        </Grid>
        <Grid Name="grdProgressBar" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Height="80" Width="280" Background="LightGray" Panel.ZIndex="6">
            <ProgressBar x:Name="pbarDownloading" Grid.ColumnSpan="2" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center"  Minimum="0" Maximum="100" Height="25" Width="280" Foreground="LightGreen"/>
            <Label Content="Downloading..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Blue"/>
            <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Margin="10,5" x:Name="txtInvoiced" Foreground="Blue" Text="Downloading" FontSize="16" FontWeight="DemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />
                <TextBlock Margin="10,5" x:Name="txtPbarValue" Foreground="Blue" FontWeight="DemiBold" FontSize="16"  Text="{Binding ElementName=pbarTarget , Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />
            </StackPanel>-->
        </Grid>
    </Grid>
</UserControl>
