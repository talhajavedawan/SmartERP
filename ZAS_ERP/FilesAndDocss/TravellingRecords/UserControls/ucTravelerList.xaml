<UserControl x:Class="ZAS_ERP.FilesAndDocss.TravellingRecords.UserControls.ucTravelerList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.FilesAndDocss.TravellingRecords.UserControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Menu>
                <MenuItem Header="Add Traveler">
                    <MenuItem Header="Add Traveler" Click="MbtnAdd_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Update Traveler" Click="MbtnEdit_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Refresh" x:Name="mbtnRefresh" Click="MbtnRefresh_Click"/>
            </Menu>

            <TextBlock x:Name="lblHeading" Text="Travelers List" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  />

            <Grid Background="White" Grid.Row="2" Height="auto">
                <dxg:GridControl AutoGenerateColumns="None" 
                         EnableSmartColumnsGeneration="True" 
                         Name="grdCntrlTravelerList">
                    <dxg:GridControl.DetailDescriptor>
                        <dxg:DataControlDetailDescriptor ShowHeader="True"
                                         x:Name="detailGridResidentCountry"
                                         ItemsSourcePath="ResidentCountries">
                            <dxg:DataControlDetailDescriptor.DataControl>
                                <dxg:GridControl x:Name="grdResidentCountries" 
                                                 SelectionMode="Row" 
                                                 dx:DXSerializer.SerializationID="grid">
                                    <dxg:GridControl.View>
                                        <dxg:TableView DetailHeaderContent="All Resident Countries"
                                                       HeaderHorizontalAlignment="Center"
                                                       ShowGroupPanel="False" 
                                                       FilterRowDelay="1000"      
                                                       RowAnimationKind="Opacity" 
                                                       WaitIndicatorType="Panel"
                                                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                                       ShowFixedTotalSummary="False"
                                                       ShowTotalSummary="False"                
                                                       HorizontalScrollbarVisibility="Visible"
                                                       ShowHorizontalLines="True"
                                                       ShowVerticalLines="True"      
                                                       ColumnFilterPopupMode="Excel"  
                                                       NavigationStyle="Row"
                                                       AutoWidth="True"/>
                                    </dxg:GridControl.View>

                                    <dxg:GridColumn Header="Resident Country"
                            FieldName="country.CountryName"
                            IsSmart="True"
                            VisibleIndex="0"
                                    AllowEditing="false"/>

                                    <dxg:GridColumn Header="From Date"
                            FieldName="fromDate"
                            IsSmart="True"
                            VisibleIndex="5"
                                    AllowEditing="false">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings x:Name="datArrivalDate"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>

                                    <dxg:GridColumn Header="To Date"
                            FieldName="toDate"
                            IsSmart="True"
                            VisibleIndex="6"
                                    AllowEditing="false">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl>

                            </dxg:DataControlDetailDescriptor.DataControl>
                        </dxg:DataControlDetailDescriptor>
                    </dxg:GridControl.DetailDescriptor>

                    <dxg:GridControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add New"
                            x:Name="mbtnAdd"
                            Click="MbtnAdd_Click">
                                <MenuItem.Icon>
                                    <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Edit"
                            x:Name="mbtnEdit"
                            Click="MbtnEdit_Click">
                                <MenuItem.Icon>
                                    <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </dxg:GridControl.ContextMenu>

                    <dxg:GridColumn FieldName="Name"
                                    Header="Traveler Name"
                                    AllowEditing="false"/>

                    <dxg:GridColumn FieldName="residentCountry.CountryName"
                                    Header="Resident Country"
                                    AllowEditing="false"
                                    Visible="False"
                                    ShowInColumnChooser="False"/>

                    <dxg:GridColumn FieldName="isActive"
                                    Header="is Active"
                                    AllowEditing="false"/>
                </dxg:GridControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
