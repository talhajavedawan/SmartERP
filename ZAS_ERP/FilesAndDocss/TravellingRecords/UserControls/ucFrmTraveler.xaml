<UserControl x:Class="ZAS_ERP.FilesAndDocss.TravellingRecords.UserControls.ucFrmTraveler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:local="clr-namespace:ZAS_ERP.FilesAndDocss.TravellingRecords.UserControls"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="450" Loaded="UserControl_Loaded">
    <Grid>
        <dxlc:LayoutGroup Header="Traveler" View="GroupBox">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>


                <dxlc:LayoutItem Label="Name "  Margin="20 0 0 0" LabelHorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Center">
                    <dxe:TextEdit  Name="txtTravelerName"/>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Active " Margin="20 10 0 0" LabelHorizontalAlignment="Right" Grid.Row="1" VerticalAlignment="Center">
                    <CheckBox x:Name="chkIsActive"/>
                </dxlc:LayoutItem>

                <dxg:GridControl x:Name="grdResidentCountries" 
                                 Grid.Row="2"
                                 Margin="0 10 0 0"
                                 SelectionMode="Cell" 
                                 CustomUnboundColumnData="GrdResidentCountries_CustomUnboundColumnData"
                                 dx:DXSerializer.SerializationID="grid">
                    <dxg:GridControl.View>
                        <dxg:TableView  ShowGroupPanel="False"
                                        NewItemRowPosition="Bottom"
                                        AllowColumnFiltering="False"
                                        ShowTotalSummary="True"
                                        RowAnimationKind="None" 
                                        WaitIndicatorType="Panel"
                                        ShowHorizontalLines="True"
                                        ShowVerticalLines="True"
                                        InitNewRow="View_InitNewRow"
                                        Name="tblViewResidentCountries"
                                        CellValueChanged="TblViewResidentCountries_CellValueChanged">
                            <dxg:TableView.RowCellMenuCustomizations>
                                <!--<dxb:BarButtonItem Name="deleteRowItem"
                               Content="Delete"
                               Glyph="{dx:DXImage Image=Cancel_32x32.png}"
                               ItemClick="deleteRowItem_ItemClick" />-->
                                <dxb:BarButtonItem Name="deleteRowItema"
                                                    Content="Delete"
                                                    Glyph="{dx:DXImage Image=Delete_32x32.png}"
                                                    Command="{x:Static dxg:GridCommands.DeleteFocusedRow}" />
                            </dxg:TableView.RowCellMenuCustomizations>
                        </dxg:TableView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn  VisibleIndex="1"
                                     FieldName="country"
                                     Header="Country"
                                     IsSmart="True"
                                     UnboundType="bound"
                                     UnboundExpression="[CountryName]" 
                                     SortOrder="Ascending" 
                                     SortIndex="0">
                        <dxg:GridColumn.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RowData.Row.country.CountryName}"></TextBlock>
                            </ControlTemplate>
                        </dxg:GridColumn.DisplayTemplate>
                        <dxg:GridColumn.EditSettings>
                            <dxg:LookUpEditSettings x:Name="lookupCountry"
                                      AutoPopulateColumns="False"
                                      IsPopupAutoWidth="False"
                                      DisplayMember="CountryName"
                                      NullText="Select Item">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                <dxg:GridColumn FieldName="CountryName" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEditSettings.PopupContentTemplate>
                            </dxg:LookUpEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn Header="From Date"
                            AllowMoving="false"
                            FieldName="fromDate"
                            IsSmart="True"
                            VisibleIndex="5"
                                    AllowEditing="true">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings x:Name="datArrivalDate"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn Header="To Date"
                            AllowMoving="false"
                            FieldName="toDate"
                            IsSmart="True"
                            VisibleIndex="6"
                                    AllowEditing="true">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                </dxg:GridControl>

                <Button Content="Save" x:Name="btnSave" Grid.Row="3" Click="BtnSave_Click"/>
            </Grid>
        </dxlc:LayoutGroup>
    </Grid>
</UserControl>
