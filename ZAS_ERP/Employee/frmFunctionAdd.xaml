<Window x:Class="ZAS_ERP.Employee.frmFunctionAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Employee"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        mc:Ignorable="d"
        Title="Add Function" Height="280" Width="600" Loaded="Window_Loaded">
    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground"
                Value="DarkGray" />
                <Setter Property="VerticalAlignment"
                Value="Center" />
                <Setter Property="HorizontalAlignment"
                Value="Right" />
                <Setter Property="Margin"
                Value="10,10" />
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin"
                Value="10,5" />
                <Setter Property="VerticalAlignment"
                Value="Center" />
            </Style>
            <Style TargetType="{x:Type dxe:ComboBoxEdit}">
                <Setter Property="Margin"
                Value="10,5" />
                <Setter Property="VerticalAlignment"
                Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid >
            <ScrollViewer Padding="5 5 5 5 ">
                <StackPanel >
                    <dxlc:LayoutGroup View="GroupBox" 
                              Header="Functions" 
                              Height="200">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>

                                <ColumnDefinition Width="20"/>
                                
                                <ColumnDefinition/>
                                <ColumnDefinition/>

                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Title" ToolTip="Function Title" />
                            <TextBox Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Width="150"
                                     x:Name="txtTitle"/>

                            <TextBlock Text="Is Active" Grid.Column="3"/>
                            <CheckBox Grid.Column="4" VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      x:Name="chckIsActive"/>

                            <TextBlock Grid.Column="0" Grid.Row="1"  Text="Function Type "/>
                            <dxe:ComboBoxEdit Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" Width="150" Height="22"
                                          Name="cmbxFunctionType"
                                          TabIndex="1"/>

                            <TextBlock Text="Company" Grid.Column="0"  Grid.Row="1" Visibility="Collapsed"/>

                            <dxg:LookUpEdit  Name="cmbxCompany" Visibility="Collapsed"
                                                      AutoPopulateColumns="True" 
                                                      DisplayMember="CompanyName"
                                                    VerticalAlignment="Center"
                                             Margin ="10,5"
                                       IsTextEditable="False"
                                              Grid.Column="1"
                                              Grid.Row="1"
                                             SelectedIndexChanged="CmbxCompany_SelectedIndexChanged"
                                             >

                            </dxg:LookUpEdit>
                            <TextBlock Text="Departments" Grid.Column="3"  Grid.Row="1" Visibility="Collapsed"/>
                           
                            <!--Hidden TextBlock for Function Id for Edit/Update-->
                            <TextBlock Name="fnId" Visibility="Collapsed"/>
                            <!--<dxe:ComboBoxEdit Grid.Column="4"
                                              Grid.Row="1"
                                              
                                             
                            x:Name="cmbxDepart"
                           />-->
                            <dxg:LookUpEdit  
                                Visibility="Collapsed"
                                        AutoPopulateColumns="True" 
                                        DisplayMember="DeptName"
                                        VerticalAlignment="Center"
                                        Margin ="10,5"
                                        IsTextEditable="False"
                                        Grid.Column="4"
                                        Grid.Row="1"  
                                        x:Name="cmbxDepart"
                                >
                            </dxg:LookUpEdit>

                            <TextBlock Text="Is Subsidary" Grid.Column="0"  Grid.Row="2"
                                       Visibility="Collapsed"/>
                            <dxe:CheckEdit Grid.Column="1"
                                           Visibility="Collapsed"
                                              Grid.Row="2"
                                              Checked="ChckSubsidary_Checked"
                                           Unchecked="ChckSubsidary_Unchecked"
                                              Width="150"
                            x:Name="chckSubsidary"
                           />
                            <TextBlock Text="Parent" Grid.Column="3"  Grid.Row="2" Visibility="Collapsed"/>
                        
                            <dxg:LookUpEdit  
                                Visibility="Collapsed"
                                        AutoPopulateColumns="True" 
                                        DisplayMember="Title"
                                        VerticalAlignment="Center"
                                        Margin ="10,5"
                                        IsTextEditable="False"
                                        Grid.Column="4"
                                         Grid.Row="2"
                                         x:Name="cmbxParent"
                                         IsEnabled="False">
                            </dxg:LookUpEdit>

                        </Grid>
                            <!--<dxlc:LayoutControl Orientation="Vertical">



                            --><!--<dxlc:LayoutItem Height="5"/>--><!--

                            <dxlc:LayoutItem Label="Title:          " Width="250">
                                <dxe:TextEdit Name="txtTitle"/>
                            </dxlc:LayoutItem>

                            <dxlc:LayoutItem Height="5"/>

                            <dxlc:LayoutItem Label="Is Active:       " Width="250">
                                <dxe:CheckEdit Name="fnxIsActive"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Height="5"/>
                            <dxlc:LayoutItem Label="Status Color: " Width="250">
                                <dxe:PopupColorEdit Name="assetStatusColorEdit"/>
                            </dxlc:LayoutItem>
                            <TextBlock Name ="assetStatusId" Visibility="Collapsed" HorizontalAlignment="Left" Height="14" Margin="463,10,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="24"/>

                        </dxlc:LayoutControl>-->
                    </dxlc:LayoutGroup>
                    <!--<Separator BorderBrush="Transparent" Background="Transparent" Height="10"/>

                    <dxlc:LayoutGroup View="GroupBox" 
                              Header="Function Info" 
                              Height="170">
                        <dxlc:LayoutControl Orientation="Vertical">



                            --><!--<dxlc:LayoutItem Height="5"/>--><!--

                            <dxlc:LayoutItem Label="Status:          " Width="250">
                                <dxe:TextEdit Name="assetStatvusTxtbx"/>
                            </dxlc:LayoutItem>

                            <dxlc:LayoutItem Height="5"/>

                            <dxlc:LayoutItem Label="Is Active:       " Width="250">
                                <dxe:CheckEdit Name="assetStatusIsActivve"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Height="5"/>
                            <dxlc:LayoutItem Label="Status Color: " Width="250">
                                <dxe:PopupColorEdit Name="assetStatuvsColorEdit"/>
                            </dxlc:LayoutItem>
                            <TextBlock Name ="assdetStatusId" Visibility="Collapsed" HorizontalAlignment="Left" Height="14" Margin="463,10,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="24"/>

                        </dxlc:LayoutControl>
                    </dxlc:LayoutGroup>-->


                </StackPanel>
                
            </ScrollViewer>
             

        </Grid>
        <Button x:Name="btnFnxSave" Content="Save" Height="35" VerticalAlignment="Bottom" Click="BtnFnxSave_Click"/>

    </Grid>
</Window>
