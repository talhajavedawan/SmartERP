<UserControl x:Class="ZAS_ERP.Employee.ucAddressInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Employee"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <TextBlock Name="lblfaRegister" Text="Address and Contact" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="0" FontFamily="Segoe UI Semibold"  />
        <dxg:GridControl
            Grid.Row="1"
                        Name="grdEmployeeRegisters"
                        AutoGenerateColumns="AddNew" 
                        Margin="0 0 0 40"
                         EnableSmartColumnsGeneration="True" 
                         CustomUnboundColumnData="GrdEmployeeRegisters_CustomUnboundColumnData"
                        >

            <dxg:GridControl.View >
                <dxg:TableView AllowPerPixelScrolling="True" 
                               ShowTotalSummary="True"
                               ShowAutoFilterRow="True" 
                               RowAnimationKind="None" 
                               WaitIndicatorType="Panel"
                               AllowEditing="True"
                              
                               >
                    <dxg:TableView.RowCellMenuCustomizations>



                        <!--<dxb:BarButtonItem Name="viewHistoryMenuItem"  Content="View History"  ItemClick="ViewHistoryMenuItem_ItemClick"/>-->
                    </dxg:TableView.RowCellMenuCustomizations>
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridColumn Header="First Name"
                            FieldName="person.FName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Last Name"
                            FieldName="person.LName"
                            IsSmart="True"
                            Width="auto" />
<!--First address-->
            <dxg:GridColumn Header="Line 1"
                            FieldName="address.Line1"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Line 2"
                            FieldName="address.Line2"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Zip"
                            FieldName="address.Zip"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="City"
                            FieldName="address.City"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="State"
                            FieldName="address.State"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Country"
                            FieldName="address.Country"
                            IsSmart="True"
                            Width="auto" />
 <!--second address-->
            <dxg:GridColumn Header="Line 1"
                            FieldName="address2.Line1"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Line 2"
                            FieldName="address2.Line2"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Zip"
                            FieldName="address2.Zip"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="City"
                            FieldName="address2.City"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="State"
                            FieldName="address2.State"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Country"
                            FieldName="address2.Country"
                            IsSmart="True"
                            Width="auto" />

            <!--contact-->
            <dxg:GridColumn Header="Contact No"
                            FieldName="contact.ContactNo"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Secondary Contact"
                            FieldName="contact.SecondaryContact"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Email"
                            FieldName="contact.Email"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Official Skype"
                            FieldName="contact.OfficialSkype"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Official Teams"
                            FieldName="contact.OfficialTeams"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Personal Skype"
                            FieldName="contact.PersonalSkype"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Personal Teams"
                            FieldName="contact.PersonalTeams"
                            IsSmart="True"
                            Width="auto" />

        </dxg:GridControl>
        <Button Name="saveGriddata" Content="Save" Click="SaveGriddata_Click" VerticalAlignment="Bottom" Height="45" Grid.Row="1"/>

    </Grid>
</UserControl>
