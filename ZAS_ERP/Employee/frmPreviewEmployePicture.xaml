<Window x:Class="ZAS_ERP.Employee.frmPreviewEmployePicture"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Employee"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Title="frmPreviewEmployePicture" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>

        <dxe:ImageEdit x:Name="empImage" Grid.Column="0" Grid.Row="1" 
                                       ShowMenu="False" 
                                       ShowMenuMode="Hover" 
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="Fill"
                                           SnapsToDevicePixels="True"
                                       
                                       >




        </dxe:ImageEdit>
    </Grid>
</Window>
