<dx:DXWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Employeess"
        xmlns:Custom="http://schemas.devexpress.com/winfx/2008/xaml/charts/rangecontrolclient"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        xmlns:vali="clr-namespace:ZAS_ERP.Validations"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        x:Class="ZAS_ERP.Employeess.frmEmployeeAdd"
        mc:Ignorable="d"
        x:Name="winEmployeeAdd"
        Loaded="winemployeeadd_Loaded"
        Unloaded="WinEmployeeAdd_Unloaded"
        Title="Add Employee"
        Height="800"
        Width="800"
        xmlns:loc="clr-namespace:ZAS_ERP"
        
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <Style TargetType="{x:Type Button}" x:Key="bckgrnd">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="SnapsToDevicePixels" Value="True" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}">
                            <Grid Margin="0,0,0,0" >
                                <ContentPresenter x:Name="MyContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightSkyBlue" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <!--<Trigger Property="IsChecked" Value="true">
                                <Setter Property="Background" Value="LightSkyBlue" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5"/>

                            </Trigger>-->
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>

                            <!--<Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="OrangeRed" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="loc:CustomCommands.ReplytoComment" CanExecute="Command_CanExecute" Executed="Command_Executed" />
    </Window.CommandBindings>

    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment"
                Value="Center" />
                <Setter Property="HorizontalAlignment"
                Value="Right" />
                <Setter Property="Foreground"
                Value="Black" />
                <Setter Property="Margin"
                Value="10,10" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />

            <RowDefinition Height="50" />
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Left"
                                Orientation="Horizontal" >
            <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">
                <Image Source="/ZAS_ERP;component/images/log.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1"  Click="BtnMarkReviewed_Click"
                            ToolTip="Approve - Mark as Reviewed">
                <Image Source="/ZAS_ERP;component/images/approve.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnReject" Grid.Column="2" ToolTip="Reject" Click="BtnReject_Click">
                <Image Source="/ZAS_ERP;component/images/reject.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2"
                    ToolTip="Add New Comment" Click="BtnAddComment_Click">
                <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2"  
                    ToolTip="CommentLog" Click="BtnCommentLog_Click">
                <Image Source="/ZAS_ERP;component/images/comments.png" ></Image>
            </Button>
            <Button x:Name="btnAttachNew" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Info" Click="BtnAttachNew_Click">
                <Image x:Name="imgAttachNew"  Source="/ZAS_ERP;component/images/clipattachment.png"></Image>
            </Button>
            <Button x:Name="btnAttachmentList" Width="30" Height="30" Grid.Column="3" ToolTip="Info" Click="BtnAttachmentList_Click">
                <Image  Source="/ZAS_ERP;component/images/ListAttachment.png"></Image>
            </Button>
            <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnTrackingWindow" Grid.Column="2" ToolTip="360 View" Click="BtnTrackingWindow_Click">
                <Image  Source="/ZAS_ERP;component/images/360Arrow.png" ></Image>
            </Button>
            <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnSetVoid" Visibility="Visible" Grid.Column="2" ToolTip="360 View" Click="BtnSetVoid_Click">
                <Image  Source="/ZAS_ERP;component/images/void_order.png" ></Image>
            </Button>

        </StackPanel>

        <Grid Panel.ZIndex="5" Visibility="Collapsed" x:Name="gridTracker" Width="500"   
              HorizontalAlignment="Left" Background="White" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="btnCollapse" Click="BtnCollapse_Click" Content="Collapse"></Button>
                <TextBlock Text="Activity Tracker" FontWeight="Bold" FontSize="26" Foreground="Black" Margin="30,5"></TextBlock>
                <Button x:Name="btnexpand" Click="Btnexpand_Click" Content="Expand"></Button>

            </StackPanel>
            <dxg:GridControl x:Name="grdUsers" Visibility="Visible"
                     Grid.Row="1" MaxHeight="520"
                     Grid.RowSpan="5" HorizontalAlignment="Left"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             
                     SelectionMode="Row" 
                             
                             
                      CustomUnboundColumnData="GrdUsers_CustomUnboundColumnData"   
                    AutoGenerateColumns="None">
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       
                                   AutoWidth="True"
                       Width="auto"
                       AllowGrouping="False"
                                   ShowGroupPanel="False"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       
                       >

                    </dxg:TableView>
                </dxg:GridControl.View>
                <dxg:GridColumn Header="User Name"
                            FieldName="User.userName"
                            IsSmart="True"
                            Width="auto" />
                <!--<dxg:GridColumn FieldName="Name" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>-->
                <dxg:GridColumn FieldName="Timestamp" UnboundType="String" ReadOnly="True" Width="auto">
                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                </dxg:GridColumn>
                <dxg:GridColumn Header="Info"
                            FieldName="Info"
                            IsSmart="True"
                            Width="auto" />
                <dxg:GridColumn 
                            FieldName="Comment"
                            IsSmart="True"
                            Width="auto" />
                <!--<dxg:GridColumn FieldName="isActive"  >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>-->
                <!--<dxg:GridColumn FieldName="SupervisorName" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Departments" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Companies" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>-->
            </dxg:GridControl>
        </Grid>

        <Grid x:Name="grdComments"  Visibility="Collapsed"
              Width="400" Background="Gray" Panel.ZIndex="5" 
              VerticalAlignment="Stretch" 
              Margin="35 0 0 0 " 
              HorizontalAlignment="Left" Grid.Row="1">
            <dxg:GridControl AutoExpandAllGroups="True"  
                             Height="600" Grid.Row="1" 
                             dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" 
                             x:Name="grdCommentss"
                            
                           >
                <!--ShowAllTableValuesInFilterPopup="True"-->
                <!--#region Columns-->
                <dxg:GridControl.Columns>


                    <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                    <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                    <dxg:GridColumn Width="Auto" FieldName="Subject" />
                    <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                    <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                    <dxg:GridColumn Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                                                SortOrder="Descending" />
                </dxg:GridControl.Columns>
                <!--#endregion-->
                <dxg:GridControl.View>
                    <dxg:TableView 
                            x:Name="GrdCommenttableView" 
                            AllowEditing="False" 
                            DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                            DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0"
                            RowStyle="{StaticResource RowStyle}" 
                            ShowSearchPanelMode="Always" 
                            SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" 
                            ShowIndicator="False" ShowVerticalLines="False"
                            CompactPanelShowMode="Always" 
                            SwitchToCompactModeWidth="700"
                            NavigationStyle="Row"
                           >
                        <!--ShowFilterPanelMode=""-->

                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>
                        </dxg:TableView.FormatConditions>
                        <!--#region CompactModeFilterItems-->
                        <dxg:TableView.CompactModeFilterItems>
                            <!--<dxg:CompactModeFilterItem DisplayValue="" />-->
                            <dxg:CompactModeFilterItem DisplayValue="Subject" EditValue="[Subject] = ''" />
                            <dxg:CompactModeFilterItem DisplayValue="From" EditValue="[Assignee.person.FName] = 'Usama Khalid'" />
                            <dxg:CompactModeFilterItem DisplayValue="CC" EditValue="[isRead] = False" />
                            <dxg:CompactModeFilterItem DisplayValue="Tag To" EditValue="[isRead] = False" />
                            <dxg:CompactModeFilterItem DisplayValue="Category" EditValue="[isRead] = False" />
                            <dxg:CompactModeFilterItem DisplayValue="Comment" EditValue="[isRead] = False" />

                        </dxg:TableView.CompactModeFilterItems>
                        <!--#endregion-->
                        <!--<dxg:TableView.CompactModeFilterItems>
                            <dxg:CompactModeFilterItem DisplayValue="All" />
                            <dxg:CompactModeFilterItem DisplayValue="Read" EditValue="[isRead] = True" />
                            <dxg:CompactModeFilterItem DisplayValue="Unread" EditValue="[isRead] = false" />


                        </dxg:TableView.CompactModeFilterItems>-->
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>

        </Grid>

        <Grid x:Name="grdAttachments"   Width="300" Visibility="Collapsed" Background="Gray"
              Panel.ZIndex="5" VerticalAlignment="Top" Margin="210,00,65,35" 
              HorizontalAlignment="Left" Grid.Row="1">
            <TreeView x:Name="treeViewAttachments" >
                <TreeView.Resources>
                    <HierarchicalDataTemplate  DataType="{x:Type loc:TreeItem}" ItemsSource="{Binding Items}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding name}"
                                                   Grid.Column="0"
                         
                                                   HorizontalAlignment="Stretch" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text=" [" Foreground="Blue" />
                                <TextBlock Text="{Binding Items.Count}" Foreground="Blue" />
                                <TextBlock Text="]" Foreground="Blue" />
                            </StackPanel>
                        </Grid>
                    </HierarchicalDataTemplate>
                    <DataTemplate  DataType="{x:Type loc:cmbitem}" >
                        <StackPanel>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />

                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />

                                </Grid.ColumnDefinitions>
                                <!--<CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>-->
                                <TextBlock Text="{Binding id}"
                                                          Visibility="Collapsed" />
                                <TextBlock Text="{Binding description}"
                                                          Visibility="Collapsed" />
                                <Button Content="Open" Margin="5,0" x:Name="btnDownloadAttachment" Click="BtnDownloadAttachment_Click" Foreground="Blue"  Tag="{Binding description}"></Button>

                                <TextBlock Text="   "
                                                         Background="{Binding bcolor}"
                                                         Width="20"
                                                         Margin="0,0,5,0" Grid.Column="1"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" >
                                    <TextBlock Text="{Binding name}"
                                                         Grid.Column="1"
                         
                                                         HorizontalAlignment="Stretch" />

                                    <!--<TextBlock Text=" [" Foreground="Blue" />-->
                                    <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                                    <!--<TextBlock Text="]" Foreground="Blue" />-->
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                    <!--<HierarchicalDataTemplate DataType="{x:Type self:cmbitem}"  >
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />

                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="1*" />
                                                    
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>
                                                <TextBlock Text="{Binding id}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="{Binding description}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="   "
                         Background="{Binding bcolor}"
                         Width="20"
                         Margin="0,0,5,0" Grid.Column="1"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding name}"
                         Grid.Column="1"
                         
                         HorizontalAlignment="Stretch" />
                                                
                                                    <TextBlock Text=" [" Foreground="Blue" />
                                                    <TextBlock Text="{Binding fcolor}" Foreground="Blue" />
                                                    <TextBlock Text="]" Foreground="Blue" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>-->
                </TreeView.Resources>
            </TreeView>
        </Grid>

        <Grid x:Name="grdAttach"   Width="250" Visibility="Collapsed"  Background="White" 
              Panel.ZIndex="5" VerticalAlignment="Top" Margin="175,0,65,35" 
              HorizontalAlignment="Left" Grid.Row="1">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />

                    <ColumnDefinition Width="1*" />

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Category"
                         
                         
                                                 Margin="5,0,5,0" Grid.Column="0"/>
                <ComboBox x:Name="cmbCategory"
                                              Grid.Column="3"
                                              VerticalAlignment="Center"
                                                  Margin="5,5"
                                              Grid.Row="0"
                                              TabIndex="0"
                                              >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Text="{Binding id}"
                                                  Visibility="Hidden" />
                                <TextBlock Text="{Binding name}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>


                <!--<TextBlock Text=" [" Foreground="Blue" />-->
                <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.ColumnSpan="2" Content="Select file" Margin="5" x:Name="btnAttachment" Click="BtnAttachment_Click" Foreground="Blue"  Tag="{Binding description}"></Button>
                <!--<TextBlock Text="]" Foreground="Blue" />-->

            </Grid>

        </Grid>



        <DockPanel Grid.Row="1">
            <dx:DXTabControl SelectionChanged="DXTabControl_SelectionChanged" >
                <dx:DXTabControl.View>
                    <dx:TabControlScrollView HeaderLocation="Left"
                                   HideButtonShowMode="NoWhere"
                                   NewButtonShowMode="NoWhere"
                                   RemoveTabItemsOnHiding="False"
                                   ShowHeaderMenu="False"
                                   HeaderOrientation="Horizontal" />
                </dx:DXTabControl.View>
                <dx:DXTabItem Header="Personal Information"
                      Height="22"
                      IsSelected="True"
                      Name="tabPersonalInfo">
                    <ScrollViewer>

                        <StackPanel MaxHeight="1000"  >



                            <Grid x:Name="grdPersonalInfo">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="0" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>

                                </Grid.RowDefinitions>

                                <StackPanel  Grid.Column="5">
                                    <dxe:ImageEdit ToolTip="Signature" x:Name="UserSignature" Grid.Column="5"   ShowMenu="False" 
                                       ShowMenuMode="Hover" 
                                       Height="150" Width="150">

                                        <dxe:ImageEdit.MenuTemplate>
                                            <ControlTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <dxe:ImageEditToolButton ToolTip="Add new " Name="btnBrowseImage" Click="BtnUserSignature_Click" ImageSource="/ZAS_ERP;component/images/browse.png" IsEnabled="True"
                            />

                                                    <dxe:ImageEditToolButton ToolTip="Delete" Name="btnDelSignatureImage" Click="BtnDelSignatureImage_Click"  ImageSource="/ZAS_ERP;component/images/declineIcon16x16.png"
                           />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </dxe:ImageEdit.MenuTemplate>

                                    </dxe:ImageEdit>
                                    <TextBlock Text="User Signature" HorizontalAlignment="Center" x:Name="userSignatureTxt"/>
                                </StackPanel>


                                <StackPanel Grid.Column="2">
                                    <dxe:ImageEdit x:Name="userImage" Grid.Column="2"
                                       ShowMenu="False" 
                                       ShowMenuMode="Hover" 
                                       Height="150" Width="150"
                                       
                                       >
                                        <dxe:ImageEdit.Source>
                                            <BitmapImage UriSource="/ZAS_ERP;component/images/users-vector-icon-png_260862.jpg" />
                                        </dxe:ImageEdit.Source>

                                        <dxe:ImageEdit.MenuTemplate>
                                            <ControlTemplate>
                                                <StackPanel Orientation="Horizontal">

                                                    <!--<dxe:ImageEditClearToolButton Click="BtnDelImage_Click"/>-->

                                                    <!--<dxe:ImageEditToolSeparator/>-->

                                                    <!--<dxe:ImageEditCopyToolButton />-->

                                                    <!--<dxe:ImageEditCutToolButton ToolTip="Delete Picture" Click="BtnDelImage_Click"/>-->

                                                    <!--<dxe:ImageEditSaveToolButton  ToolTip="Save Picture " Click="BtnSaveImage_Click"/>-->
                                                    <!--<dxe:ImageEditLoadToolButton ToolTip="Browse Picture" Click="ImageEditLoadToolButton_Click_2"/>-->
                                                    <dxe:ImageEditToolButton ToolTip="Add new" x:Name="btnBrowseImage" Click="BtnBrowseImage_Click"
                                        ImageSource="/ZAS_ERP;component/images/browse.png" IsEnabled="True" />
                                                    <dxe:ImageEditToolButton ToolTip="Save" x:Name="btnSaveImage" Click="BtnSaveImage_Click"
                                        ImageSource="/ZAS_ERP;component/images/Save-icon16x16.png" IsEnabled="False"  />
                                                    <dxe:ImageEditToolButton ToolTip="Delete" x:Name="btnDelImage" Click="BtnDelImage_Click"
                                         ImageSource="/ZAS_ERP;component/images/declineIcon16x16.png"/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </dxe:ImageEdit.MenuTemplate>


                                    </dxe:ImageEdit>
                                    <TextBlock Text="User Image" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock VerticalAlignment="Center"
                       Grid.Column="1"
                       Grid.Row="3"
                       Text="Employee ID" />
                                <TextBox x:Name="txtEmpId"
                      VerticalAlignment="Center"
                      Grid.Column="2"
                      Grid.Row="3"/>

                                <TextBlock VerticalAlignment="Center"
                       Grid.Column="1"
                       Grid.Row="2"
                       Text=" Is Admin Bill Type" />

                                <CheckBox x:Name="chkIsAdminBillType"
                      VerticalAlignment="Center"
                      Grid.Column="2"
                      Grid.Row="2"
                      TabIndex="12"/>


                                <TextBlock VerticalAlignment="Center"
                       Grid.Column="4"
                       Grid.Row="3"
                       Text="Show In Task Module" Visibility="Collapsed"/>

                                <Grid Grid.Row="3" Grid.Column="5" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="chkIsTaskType"
                      VerticalAlignment="Center" Content="Show In Task Module"
                      Grid.Column="0"
                      Grid.Row="3"
                      TabIndex="12"/>

                                    <CheckBox x:Name="chkIsMultiUser"
                      VerticalAlignment="Center" Content="Is Multi User"
                      Grid.Column="1"
                      Grid.Row="2"
                      TabIndex="12"/>

                                    <CheckBox x:Name="chkisActive"
                      VerticalAlignment="Center" Content="Is Active"
                      Grid.Column="5"
                      Grid.Row="1"
                      IsChecked="True"
                      TabIndex="12"  
                      Visibility="Visible"/>
                                </Grid>
                                

                                <TextBlock VerticalAlignment="Center"
                       Grid.Column="4"
                       Grid.Row="1"
                       Text=" isActive" 
                       Visibility="Collapsed"/>

                             

                                <TextBlock Text="First Name"
                       Grid.Column="1"
                       Grid.Row="4" />

                                <TextBox x:Name="txtfirstName"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Grid.Row="4"
                     TabIndex="0"
                     Grid.Column="2">
                                    <Binding Path="only"
                         UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <vali:onlyalphareq />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox>
                                <TextBlock x:Name="label1"
                       VerticalAlignment="Center"
                       Grid.Row="5"
                       Grid.Column="1"><Run Text="Father Name" /></TextBlock>
                                <TextBox VerticalAlignment="Center"
                     Grid.Column="2"
                     TabIndex="2"
                     x:Name="txtfathername"
                     Grid.Row="5">
                                    <Binding Path="onlychar"
                         UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <vali:onlyalphareq />
                                        </Binding.ValidationRules>
