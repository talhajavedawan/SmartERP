<Window x:Class="ZAS_ERP.Employee.frmQualificationAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Employee"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Title="Add Qualification" Height="450" Width="800" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <ScrollViewer>
        <dxlc:LayoutGroup Header="Degree Details" 
                                          View="GroupBox" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical"
                                          Height="385"
                                              Margin="0 0 0 0"
                          VerticalAlignment="Top"
                          Padding="0 0 0 0">

            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutItem Label="Degree" Width="40">
                  
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Width="60">
                    <dxe:ToggleSwitch Name="degreeSwitch"  HorizontalAlignment="Left"
                                        Checked="DegreeSwitch_Checked"  
                                      IsChecked="False"
                                      Unchecked="DegreeSwitch_Unchecked"
                                          />

                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Certificate" Width="60">

                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <Separator BorderBrush="Transparent" Background="Transparent" Height="5"/>

            <dxlc:LayoutGroup Orientation="Horizontal" Name="grpDegreeTitle">
                <dxlc:LayoutItem Label="Degree Type: ">
                    <dxe:ComboBoxEdit  x:Name="cmbxDegreeType" Margin="20 0 0 0">

                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>

                    <dxlc:LayoutItem Label="Degree Title: " Margin="10,0,0,-0.857">
                    <dxe:TextEdit  x:Name="txtDegreeTitle" Margin="25 0 0 0"
                                   NullText="For Example: FSC,I.Com or MA,M.Com ">

                    </dxe:TextEdit>
                </dxlc:LayoutItem>
              

            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal" Name="grpCertTitle" Visibility="Collapsed">
                <dxlc:LayoutItem Label="Certification Title: ">
                    <dxe:TextEdit  x:Name="txtCertTitle" Margin="0 0 0 0">

                    </dxe:TextEdit>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Awarding Body: " Visibility="Collapsed">
                    <dxe:TextEdit  x:Name="txtAwarding" Margin="20 0 0 0">

                    </dxe:TextEdit>
                </dxlc:LayoutItem>


            </dxlc:LayoutGroup>

            <Separator BorderBrush="Transparent" Background="Transparent" Height="5"/>

            <dxlc:LayoutGroup Orientation="Horizontal" Name="grpSubjects">
                <dxlc:LayoutItem Label="Subjects/Majors: " Margin="0 0 0 0">
                        <dxe:TextEdit x:Name="txtSubject" Margin="5 0 0 0"/>
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>
            <Separator BorderBrush="Transparent" Background="Transparent" Height="5"/>


            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutItem Label="Obtained Marks: ">
                    <dxe:TextEdit  x:Name="txtObtMarks" Margin="4 0 0 0"
                                    MaskType="Numeric" Mask="n2"
                                    
                                   NullText="Enter Total Marks or GPA">
                    </dxe:TextEdit>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Total Marks: " Margin="10 0 0 0">
                    <dxe:TextEdit x:Name="txtTotMarks" MaskType="Numeric" 
                                  Margin="30 0 0 0" Mask="n2"
                                  NullText="Obtained Marks or CGPA"/>
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>

            <Separator BorderBrush="Transparent" Background="Transparent" Height="5"/>


            <dxlc:LayoutGroup Orientation="Horizontal" Name="grpPercent">
                <dxlc:LayoutItem Label="Percentage: ">
                    <dxe:TextEdit x:Name="txtPercent" Margin="31 0 0 0" MaskType="Numeric" Mask="n2" 
                                    MaskUseAsDisplayFormat="True" GotFocus="TxtPercent_GotFocus">

                    </dxe:TextEdit>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Division/Grade: " Margin="10 0 0 0">
                    <dxe:TextEdit x:Name="txtDiv" Margin="10 0 0 0"
                                  NullText="1st Div./ A grade"/>
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>

            <Separator BorderBrush="Transparent" Background="Transparent" Height="5"/>


            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutItem Label="Start Date: ">
                    <dxe:DateEdit x:Name="dateStarting" Margin="37 0 0 0">

                    </dxe:DateEdit>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="End Date: " Margin="10 0 0 0">
                    <dxe:DateEdit x:Name="datePassing" Margin="40 0 0 0"/>
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>

            <Separator BorderBrush="Transparent" Background="Transparent" Height="5"/>


            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutItem Label="Institute: ">
                    <dxe:TextEdit x:Name="txtInst" Margin="45 0 0 0">

                    </dxe:TextEdit>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Country: " Margin="10 0 0 0">
                    <dxe:TextEdit x:Name="txtCountry" Margin="45 0 0 0"/>
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>

            <Separator BorderBrush="Transparent" Background="Transparent" Height="5"/>


            <dxlc:LayoutGroup Orientation="Horizontal" Name="grpLatest">
                <dxlc:LayoutItem Label="Is Latest: ">
                    <dxe:CheckEdit x:Name="chckIsLatest" Margin="47 0 0 0">

                    </dxe:CheckEdit>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Distinction: " Margin="10 0 0 0">
                    <dxe:CheckEdit x:Name="chckIsDistint" Margin="32 0 0 0"/>
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>

            <Separator BorderBrush="Transparent" Background="Transparent" Height="5"/>


            <dxlc:LayoutGroup Orientation="Horizontal" Name="grpDist">
                <dxlc:LayoutItem Label="Distinction Detail: ">
                    <dxe:TextEdit x:Name="txtDist" Margin="0 0 0 0">

                    </dxe:TextEdit>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Compeleted: " Margin="10 0 0 0">
                    <dxe:CheckEdit x:Name="chckIsComp" Margin="24 0 0 0"/>
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal" Name="grpValid" Visibility="Collapsed">
                <dxlc:LayoutItem Label="Is Valid: " Width="70" Margin="0 0 0 0">
                    <dxe:CheckEdit x:Name="chckIsValid" Margin="10 0 0 0"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Valid Till: " Margin="100 0 0 0">
                    <dxe:DateEdit x:Name="validTill" Margin="9 0 0 0">

                    </dxe:DateEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Score: "  Margin="80 0 0 0">
                    <dxe:TextEdit x:Name="txtScore" Margin="9 0 0 0">

                    </dxe:TextEdit>
                </dxlc:LayoutItem>


            </dxlc:LayoutGroup>

        </dxlc:LayoutGroup>
        </ScrollViewer>
        <Button Name="saveDegree" Content="Save" 
                VerticalAlignment="Bottom" Height="35"
                Click="SaveDegree_Click"/>
    </Grid>
</Window>
