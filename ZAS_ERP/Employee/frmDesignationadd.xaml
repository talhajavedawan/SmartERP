<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Employeess"
        xmlns:Validations="clr-namespace:ZAS_ERP.Validations"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        x:Class="ZAS_ERP.Employeess.frmDesignationadd"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="Designation"
        Height="250"
        Width="550" Loaded="winDesignationAdd_Loaded"
        x:Name="winDesignationAdd" Closing="winDesignationAdd_Closing">

    <!--xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"-->
    <Grid Margin="0,10,0,0">
    <Grid.Resources>
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="DarkGray" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Setter Property="Margin"
                Value="10,10" />
      </Style>
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Margin"
                Value="10,5" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
      </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Width=".7*" />
      <ColumnDefinition Width=".1*" />
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Width=".7*" />
      <ColumnDefinition Width=".05*" />
        </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      
      <RowDefinition Height="*" />
      <RowDefinition Height="50" />
    </Grid.RowDefinitions>
    <TextBlock Text="Title" ToolTip="Deignation Title" />
    <TextBox Grid.Column="1"
              x:Name="txtTitle"
               />

        <TextBlock Text="Is Subsidary" Grid.Column="3"  />
        <CheckBox Grid.Column="4"
              x:Name="txtTityle"
                  VerticalAlignment="Center"
               />

        <TextBlock Text="Company"
               Grid.Row="1" />
        <dxg:LookUpEdit x:Name="lookupCompany"
                      Grid.Column="1"
                      Grid.Row="1" Margin="10,5"
                      VerticalAlignment="Center"
                      AutoPopulateColumns="False"
                      DisplayMember="CompanyName"
                      SelectedIndexChanged="lookupCompany_SelectedIndexChanged"
                      TabIndex="1">
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--<Button x:Name="btnAddCompany"
                      Click="btnAddCompany_Click"
                      VerticalAlignment="Center"
                      Content="Add New" />-->
                        <dxg:GridControl x:Name="PART_GridControl"
                               AutoPopulateColumns="True"
                               Grid.Row="1">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tableView1"
                                 ShowAutoFilterRow="True" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="CompanyName"
                                IsSmart="True" />
                            <!--<dxg:GridColumn FieldName="IndustryType"
                                IsSmart="True"
                                Visible="False" />-->
                            <dxg:GridColumn x:Name="colBizType"
                                FieldName="BizType"
                                Visible="False"
                                IsSmart="True" />
                            <!--<dxg:GridColumn FieldName="EmployeerNo"
                                x:Name="colEmployeerNo"
                                IsSmart="True"
                                Visible="False" />-->
                            <!--<dxg:GridColumn FieldName="addressId"
                                x:Name="coladressId"
                                IsSmart="True"
                                Visible="False" />
                <dxg:GridColumn FieldName="address"
                                IsSmart="True"
                                x:Name="coladress"
                                Visible="False" />
                <dxg:GridColumn FieldName="contactId"
                                Visible="False"
                                x:Name="colcontactId"
                                IsSmart="True" />
                <dxg:GridColumn FieldName="contact"
                                x:Name="colcontact"
                                IsSmart="True"
                                Visible="False" />-->
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>

        <TextBlock Text="Parent" Grid.Column="3" 
                   Grid.Row="1" />
        <dxg:LookUpEdit Grid.Column="4"
                  Grid.Row="1"
              x:Name="txtTitylef"
                  VerticalAlignment="Center"
               />

        <TextBlock Text="Department"
               Grid.Row="2"  />
        <dxg:LookUpEdit x:Name="lookupDepartment"
                      Grid.Column="1"
                      Grid.Row="2" Margin="10,5"
                      DisplayMember="DeptName"
                      VerticalAlignment="Center"
                      AutoPopulateColumns="False"
                      SelectedIndexChanged="lookupDepartment_SelectedIndexChanged"
                      TabIndex="2"
                      GotFocus="lookupDepartment_GotFocus">
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--<Button x:Name="btnAddDepartment"
                      Click="btnAddDepartment_Click"
                      VerticalAlignment="Center"
                      Content="Add New" />-->
                        <dxg:GridControl x:Name="PART_GridControl"
                               AutoPopulateColumns="True"
                               Grid.Row="1">
                            <dxg:GridControl.View>
                                <dxg:TreeListView x:Name="treeListView1"
                                    ShowAutoFilterRow="True"
                                    TreeDerivationMode="Selfreference"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="Id"
                                x:Name="coldeptid"
                                IsSmart="True"
                                Visible="False" />
                            <dxg:GridColumn x:Name="coldeptcode"
                                FieldName="Code"
                                IsSmart="True" />
                            <dxg:GridColumn x:Name="coldeptname"
                                FieldName="DeptName"
                                IsSmart="True" />
                            <dxg:GridColumn FieldName="Abbrivation"
                                IsSmart="True"
                                x:Name="coldeptabr" />
                            <dxg:GridColumn FieldName="Timestamp"
                                IsSmart="True"
                                x:Name="coldeptts"
                                Visible="False" />
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>
        <TextBlock Text="Reports to"
               ToolTip="The Person or title to whom this position will report to(Lead/Manager/Senior)"
               Grid.Row="3" />
        <dxg:LookUpEdit x:Name="lookupParentDesignation"
                      Grid.Column="1"
                      Grid.Row="3" Margin="10,5"
                      DisplayMember="Title"
                      VerticalAlignment="Center"
                      AutoPopulateColumns="False"
                      SelectedIndexChanged="LookupParentDesignation_SelectedIndexChanged"
                      TabIndex="2"
                      >
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--<Button x:Name="btnAddDepartment"
                      Click="btnAddDepartment_Click"
                      VerticalAlignment="Center"
                      Content="Add New" />-->
                        <dxg:GridControl x:Name="PART_GridControl"
                               AutoPopulateColumns="True"
                               Grid.Row="1">
                            <dxg:GridControl.View>
                                <dxg:TreeListView x:Name="treeListView1"
                                    ShowAutoFilterRow="True"
                                    TreeDerivationMode="Selfreference"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="Id"
                                x:Name="coldeptid"
                                IsSmart="True"
                                Visible="False" />
                            <dxg:GridColumn x:Name="coldeptcode"
                                FieldName="Code"
                                IsSmart="True" />
                            <dxg:GridColumn x:Name="coldeptname"
                                FieldName="DeptName"
                                IsSmart="True" />
                            <dxg:GridColumn FieldName="Abbrivation"
                                IsSmart="True"
                                x:Name="coldeptabr" />
                            <dxg:GridColumn FieldName="Timestamp"
                                IsSmart="True"
                                x:Name="coldeptts"
                                Visible="False" />
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>
    <!--<TextBlock Text="Item's Nature"
               ToolTip="Unit of Measure"
               Grid.Row="4" />
    <ComboBox VerticalAlignment="Center"
              Grid.Column="1"
              Grid.Row="4"
              x:Name="cmbItemNature"
              Margin="10,5"
              SelectionChanged="cmbItemNature_SelectionChanged"
              TabIndex="4"
              DisplayMemberPath="{Binding name}">
     
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <StackPanel  Orientation="Horizontal">
            <TextBlock Text="{Binding id}"
                       Visibility="Hidden" />
            <TextBlock Text="{Binding name}"></TextBlock>
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="Category"
               Grid.Row="5" />
   
    <dxg:LookUpEdit x:Name="lookupCategory"
                    Grid.Column="1"
                    Grid.Row="5"
                    VerticalAlignment="Center"
                    
Margin="10,5"                    SelectedIndexChanged="lookupCategory_SelectedIndexChanged"
                    TabIndex="3">
      <dxg:LookUpEdit.PopupContentTemplate>
        <ControlTemplate>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="auto"></RowDefinition>
              <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Button x:Name="btnAddCategory"
                    Click="btnAddCategory_Click"
                    VerticalAlignment="Center"
                    Content="Add New" Foreground="BlueViolet" />
            <dxg:GridControl Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
              <dxg:GridControl.View>
                <dxg:TreeListView Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId" />
              </dxg:GridControl.View>
              <dxg:GridColumn x:Name="colId"
                              FieldName="Id"
                              
                              Visible="False" />
              <dxg:GridColumn FieldName="category"
                              IsSmart="True"
                              Width="auto" />
            </dxg:GridControl>
          </Grid>
        </ControlTemplate>
      </dxg:LookUpEdit.PopupContentTemplate>
    </dxg:LookUpEdit>
    <TextBlock Text="isActive"
               Grid.Row="6" />
    <CheckBox Grid.Column="1"
             Grid.Row="6" x:Name="chkIsActive" IsChecked="True"
             VerticalAlignment="Center" Margin="10,5"/>-->
    <Button Content="Save"
            Grid.Row="8"
            FontSize="24"
            x:Name="btnSaveDesignation"
            Click="btnSaveDesignation_Click"
            FontWeight="Medium"
            Grid.ColumnSpan="3"  />
  </Grid>
</Window>
