<UserControl x:Class="ZAS_ERP.Employee.ucFrmEmployeeDataRetrievalDateAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Employee" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Employees Data Retrieval Dates" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="18"/>

        <dxlc:LayoutGroup View="GroupBox"
                          Header="Employee Data Retrieval Dates"
                          Grid.Row="1">

            <dxg:GridControl AutoGenerateColumns="None" 
                             EnableSmartColumnsGeneration="False"
                             Name="grdCntrlDataRetrievalDates"
                             MouseDoubleClick="grdCntrlDataRetrievalDates_MouseDoubleClick"
                             CustomUnboundColumnData="grdCntrlDataRetrievalDates_CustomUnboundColumnData"
                             ShowLoadingPanel="{Binding IsLoading}">
                <dxg:GridControl.View>
                    <dxg:TableView AllowPerPixelScrolling="True"
                                   ShowTotalSummary="True"
                                   ShowAutoFilterRow="True"
                                   RowAnimationKind="None"
                                   WaitIndicatorType="Panel"
                                   AllowEditing="False"
                                   ShowGroupPanel="False"
                                   CellValueChanged="tableViewDataRetrievalDates_CellValueChanged"
                                   ShowCheckBoxSelectorInGroupRow="True"
                                   Name="tableViewDataRetrievalDates">

                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition ApplyToRow="True" IsEnabled="True">
                                <!-- Define the condition -->
                                <dxg:FormatCondition.Expression>
                                    <![CDATA[
                [RetrievalDate] != null AND
                [InquiryDataRetrievalDate] != null AND [RetrievalDate] = [InquiryDataRetrievalDate] AND
                [OfferDataRetrievalDate] != null AND [RetrievalDate] = [OfferDataRetrievalDate] AND
                [SODataRetrievalDate] != null AND [RetrievalDate] = [SODataRetrievalDate] AND
                [MemorandumSaleDataRetrievalDate] != null AND [RetrievalDate] = [MemorandumSaleDataRetrievalDate] AND
                [SIDataRetrievalDate] != null AND [RetrievalDate] = [SIDataRetrievalDate] AND
                [PODataRetrievalDate] != null AND [RetrievalDate] = [PODataRetrievalDate] AND
                [PIDataRetrievalDate] != null AND [RetrievalDate] = [PIDataRetrievalDate] AND
                [VendorBillDataRetrievalDate] != null AND [RetrievalDate] = [VendorBillDataRetrievalDate] AND
                [SRDataRetrievalDate] != null AND [RetrievalDate] = [SRDataRetrievalDate] AND
                [FixedAssetsDataRetrievalDate] != null AND [RetrievalDate] = [FixedAssetsDataRetrievalDate] AND
                [IBTDataRetrievalDate] != null AND [RetrievalDate] = [IBTDataRetrievalDate] AND
                [AdminBillDataRetrievalDate] != null AND [RetrievalDate] = [AdminBillDataRetrievalDate] AND
                [PaymentDataRetrievalDate] != null AND [RetrievalDate] = [PaymentDataRetrievalDate] AND
                [LoansAdvancesDataRetrievalDate] != null AND [RetrievalDate] = [LoansAdvancesDataRetrievalDate]
            ]]>
                                </dxg:FormatCondition.Expression>

                                <!-- Define the format (background color) -->
                                <dx:Format Background="#FF92B250">
                                    <dx:Format.Icon>
                                        <BitmapImage UriSource="pack://application:,,,/DevExpress.Xpf.Core.v21.2;component/Core/ConditionalFormatting/Images/IconSets/Symbols23_1.png" UriCachePolicy="{x:Null}"/>
                                    </dx:Format.Icon>
                                </dx:Format>
                            </dxg:FormatCondition>
                        </dxg:TableView.FormatConditions>

                    </dxg:TableView>
                </dxg:GridControl.View>

                <dxg:GridColumn Header="Employee Name"
                                FieldName="person.FullName"
                                AllowMoving="false"
                                IsSmart="True"
                                VisibleIndex="0"
                                AllowEditing="true"/>

                <dxg:GridColumn Header="Retrieval Date"
                                FieldName="RetrievalDate"
                                AllowMoving="false"
                                IsSmart="True"
                                VisibleIndex="1"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn FieldName="AllowOpenTransactions"
                            AllowMoving="false"
                            AllowEditing="true"
                            Header="Allow Open Transactions"
                            VisibleIndex="2">
                    <dxg:GridColumn.EditSettings>
                        <dxe:CheckEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Inquiry"
                                FieldName="InquiryDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="3"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Offer"
                                FieldName="OfferDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="4"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Sale Order"
                                FieldName="SODataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="5"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Memorandum Sale"
                                FieldName="MemorandumSaleDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="6"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Sale Invoice"
                                FieldName="SIDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="7"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Purchase Order"
                                FieldName="PODataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="8"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Purchase Invoice"
                                FieldName="PIDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="9"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Vendor Bill"
                                FieldName="VendorBillDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="10"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Sale Receipt"
                                FieldName="SRDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="11"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Fixed Assets"
                                FieldName="FixedAssetsDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="12"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Inter-Bank Transfer"
                                FieldName="IBTDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="13"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Admin Bill"
                                FieldName="AdminBillDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="14"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Payments"
                                FieldName="PaymentDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="15"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Loan Advances"
                                FieldName="LoansAdvancesDataRetrievalDate"
                                IsSmart="True"
                                VisibleIndex="16"
                                AllowEditing="true">
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

            </dxg:GridControl>

        </dxlc:LayoutGroup>


        <dx:SimpleButton Grid.Row="2"
                         Click="btnSave_Click"
                         x:Name="btnSave"
                         Content="Save" 
                         FontWeight="Bold" 
                         FontSize="18" 
                         Height="35"/>

    </Grid>
</UserControl>
