<Window x:Class="ZAS_ERP.Employee.frmDepartmentSelect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Employee"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxe1="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        mc:Ignorable="d"
        Title="Department Selection" Height="150" Width="400"
        ResizeMode="NoResize" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <!--<ColumnDefinition/>
            <ColumnDefinition/>-->

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <dxlc:LayoutGroup Header="Select Department for comments" 
                                          View="GroupBox" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical"
                                         Height="80" 
                                            VerticalAlignment="Top">

            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutItem Label="Department: " VerticalAlignment="Center">
                    <dxe1:LookUpEdit x:Name="cmbDep"
                                    AutoPopulateColumns="True" 
                            DisplayMember="DeptName"
                            IsTextEditable="False"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>


            
        </dxlc:LayoutGroup>
        <Button Grid.Row="1" Height="30" Content="Select" Name="btnSelectDepart" Click="BtnSelectDepart_Click"/>
    </Grid>
</Window>
