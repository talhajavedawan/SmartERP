<UserControl x:Class="ZAS_ERP.Employee.ucPersonalInfoGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Employee"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"

             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

  
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <TextBlock Name="lblfaRegister" Text="Personal Information" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="0" FontFamily="Segoe UI Semibold"  />
        <dxg:GridControl
            Grid.Row="1"
                        Name="grdEmployeeRegisters"
                        AutoGenerateColumns="AddNew" 
                        Margin="0 0 0 40"
                         EnableSmartColumnsGeneration="True" 
                         CustomUnboundColumnData="GrdEmployeeRegisters_CustomUnboundColumnData"
                        >

            <dxg:GridControl.View >
                <dxg:TableView AllowPerPixelScrolling="True" 
                               ShowTotalSummary="True"
                               ShowAutoFilterRow="True" 
                               RowAnimationKind="None" 
                               WaitIndicatorType="Panel"
                               AllowEditing="True"
                              
                               >
                    <dxg:TableView.RowCellMenuCustomizations>



                        <!--<dxb:BarButtonItem Name="viewHistoryMenuItem"  Content="View History"  ItemClick="ViewHistoryMenuItem_ItemClick"/>-->
                    </dxg:TableView.RowCellMenuCustomizations>
                </dxg:TableView>
            </dxg:GridControl.View>
                <dxg:GridColumn Header="EmployeeId"
                           FieldName="EmployeeId"
                            IsSmart="True"
                            Width="auto" />
                <dxg:GridColumn Header="First Name"
                            FieldName="person.FName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Last Name"
                            FieldName="person.LName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Father Name"
                            FieldName="person.FatherName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="CNIC"
                            FieldName="person.CNIC"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Gender"
                            FieldName="person.Gender"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="DOB"
                            FieldName="person.DOB"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Marital Status"
                            FieldName="MaritalStatus"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Is Disable"
                            FieldName="Disability"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Disablitity"
                            FieldName="DisDescription"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Is Active"
                            FieldName="isActive"
                            IsSmart="True"
                            Width="auto" />
          

            </dxg:GridControl>
        <Button Name="saveGriddata" Content="Save" Click="SaveGriddata_Click" VerticalAlignment="Bottom" Height="45" Grid.Row="1"/>
        
    </Grid>
        <Image
        x:Name="loadingGif"    
         
        Visibility="Hidden"
        Grid.Row="1"
         gif:AnimationBehavior.SourceUri="/ZAS_ERP;component/images/LoadingColorDot.gif"   
        VerticalAlignment="Center"
        HorizontalAlignment="Center" RenderTransformOrigin="12.987,0.793" Margin="5,100,5,5" Width="60" />

    </Grid>
</UserControl>
