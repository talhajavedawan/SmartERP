  <Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width=".7*" />
        <!--<ColumnDefinition Width="auto" />
        <ColumnDefinition Width="1*" />-->
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="1.4*" />
      </Grid.RowDefinitions>
      <Menu DockPanel.Dock="Top"
            x:Name="menuFormList"
            Grid.ColumnSpan="3">
        <MenuItem Header="_Designations"
                  x:Name="mbtnDesignations">
          <MenuItem Header="Add new Designation"
                    x:Name="mbtnNewDesignation"
                    Click="mbtnNewDesignation_Click"></MenuItem>
          <MenuItem Header="Edit Designation"
                    x:Name="mbtnEditDesignation"
                    Click="mbtnEditDesignation_Click"></MenuItem>
        </MenuItem>
  
      </Menu>
     
        
        
        <!--gridcntrol Start-->
      <dxg:GridControl x:Name="grdDesignations"
                       AutoGenerateColumns="AddNew"
                       Grid.Row="1"
                       SelectionMode="Row"
                       MouseDoubleClick="grdDesignations_MouseDoubleClick"
                Visibility="Collapsed">

        <dxg:GridControl.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Add New"
                      x:Name="btnNewDesignations"
                      Click="mbtnNewDesignation_Click" />
            <MenuItem Header="Edit"
                      x:Name="btnEditDesignations"
                      Click="mbtnEditDesignation_Click" />
            
          </ContextMenu>
        </dxg:GridControl.ContextMenu>
        <dxg:GridControl.View>
          
          <dxg:TreeListView x:Name="viewgrdDesignations"
                                                      KeyFieldName="Id"
                            ParentFieldName="parentId"
                             AllowEditing="False"
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoExpandAllNodes="True"
                            AutoPopulateServiceColumns="True"
                            ColumnFilterPopupMode="Excel"
                            FilterMode="Extended"
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" />
        </dxg:GridControl.View>
                <dxg:GridColumn FieldName="company.CompanyName" Header="Company"> </dxg:GridColumn>
                <dxg:GridColumn FieldName="department.DeptName" Header="Department"></dxg:GridColumn>
                <dxg:GridColumn FieldName="parentDesignation" Header="Manager"></dxg:GridColumn>
                

            </dxg:GridControl>


            <!--gridcntrol End-->


            <dxg:GridControl AutoGenerateColumns="AddNew" 
                 EnableSmartColumnsGeneration="True" 
                Name="grdDesig"   Grid.Row="1">
                    <!--ItemsSource="{Binding Customers}"-->
                <dxg:GridControl.View>
                    <dxg:TreeListView Name="treeListView" 
                          AutoWidth="True"
                          KeyFieldName="DesigId" ParentFieldName="ParentId"
                          TreeDerivationMode="Selfreference"  AllowEditing="False"
                           AutoExpandAllNodes="True"/>
                </dxg:GridControl.View>
                <dxg:GridControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add New"
                      x:Name="btnNecwDesignations"
                      Click="mbtnNewDesignation_Click" />
                        <MenuItem Header="Edit"
                      x:Name="btnEditcDesignations"
                      Click="mbtnEditDesignation_Click" />

                    </ContextMenu>
                </dxg:GridControl.ContextMenu>

                <dxg:GridColumn FieldName="Title" Header="Title"
                                 IsSmart="True"
                                Width="auto"/>

                <!--<dxg:GridColumn FieldName="company.CompanyName" Header="Company"></dxg:GridColumn>
                <dxg:GridColumn FieldName="department.DeptName" Header="Department"></dxg:GridColumn>
