<dx:DXWindow x:Class="ZAS_ERP.Employeess.frmEmployeeCenter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"

        xmlns:local="clr-namespace:ZAS_ERP.Employeess"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        mc:Ignorable="d"
        xmlns:views="clr-namespace:ZAS_ERP.Usercontrols"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:self="clr-namespace:ZAS_ERP"

        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        Title="Employee Center" x:Name="winemployeemain" Loaded="winemployeemain_Loaded" 
       
        Height="600" Width="1100" 
        Unloaded="Winemployeemain_Unloaded"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition  Height="30" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>
            <!--<Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>-->

            <!--Grid Row 1-->
            <dxb:MainMenuControl Height="30"
                               VerticalAlignment="Top"
                               BarItemDisplayMode="ContentAndGlyph"
                                 Grid.Row="0">
                <dxb:BarSubItem Content="Add new Employee"
                            Glyph="/ZAS_ERP;component/images/appbar.user.add.png" >
                    <dxb:BarButtonItem Content="Add new"
                                 ItemClick="BarSubItem_ItemClick"
                                 Glyph="/ZAS_ERP;component/images/appbar.user.add.png" />
                    <dxb:BarButtonItem  Content="New Transactions"></dxb:BarButtonItem>
                    <dxb:BarButtonItem Content="Edit"
                           x:Name="mbtneditemplyee"      ItemClick="mbtneditemplyee_ItemClick"
                                 Glyph="/ZAS_ERP;component/images/appbar.edit.png" />
                    <dxb:BarButtonItem  Content="New Transactions"></dxb:BarButtonItem>
                </dxb:BarSubItem>
                <dxb:BarSubItem Content="New Transactions">
                    <dxb:BarButtonItem x:Name="btnestimates"
                                 Content="Estimates" />
                    <dxb:BarButtonItem x:Name="btnsalesOrders"
                                 Content="New" />
                </dxb:BarSubItem>
                <dxb:BarButtonItem x:Name="btnExpandGrid"
                                 Content="Expand" 
                                           ItemClick="BtnExpandGrid_ItemClick"/>
                <dxb:BarButtonItem x:Name="btnCollapsedGrid"
                                 Content="Collapsed" 
                                           ItemClick="BtnCollapsedGrid_ItemClick"/>
            </dxb:MainMenuControl>

            <!--Grid Row 2-->


            <Grid Grid.Row="1" Name="contentGrid">
                <!--<Grid.RowDefinitions>
                    <RowDefinition  Height="30" />
                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Name="leftGrid"  Width="auto"  Grid.Column="0">
                    <dx:DXTabControl Name="empTabControl" SelectionChanged="DXTabControl_SelectionChanged">
                        <dx:DXTabItem Header="Employees" 
                                      Name="emplyeesTab" 
                                      MouseUp="EmplyeesTab_MouseUp"
                                     >
                            <Grid>
                                <!--<Grid.ColumnDefinitions>
                  <ColumnDefinition Width="53*" />
                  <ColumnDefinition Width="201*" />
                </Grid.ColumnDefinitions>-->
                                <Grid.RowDefinitions>
                                    <!--<RowDefinition Height=".1*" />-->
                                    <RowDefinition Height="1.4*" />
                                </Grid.RowDefinitions>
                                <!--<dx:DXDockPanel Grid.Row="0"
                                Grid.ColumnSpan="2">
                  <dx:DropDownButton HorizontalAlignment="Right"
                                     MinWidth="210" />
                  <dx:SimpleButton Content="GO"
                                   HorizontalAlignment="Right" />
                </dx:DXDockPanel>-->
                                <dxg:GridControl x:Name="grdemployee"
                                 AutoGenerateColumns="None"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 EnableSmartColumnsGeneration="True"
                                 SelectionChanged="grdemployee_SelectionChanged"
                                 SelectionMode="Row"
                                 CustomUnboundColumnData="Grdemployee_CustomUnboundColumnData">
                                    <dxg:GridControl.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add New"
                                x:Name="btnNewEmployee"
                                Click="btnNewEmployee_Click" />
                                            <MenuItem Header="Edit Employee"
                                x:Name="btnEditEmployee"
                                Click="btnEditEmployee_Click" />
                                            <!--<Separator />
                      <MenuItem Header="Delete Employee"
                                x:Name="btnDeleteEmployee"
                                Click="btnDeleteEmployee_Click" />-->
                                        </ContextMenu>
                                    </dxg:GridControl.ContextMenu>
                                    <dxg:GridControl.View>
                                        <dxg:TableView
                                            AllowEditing="False"
                                            AllowPerPixelScrolling="True" 
                                            ShowTotalSummary="True"
                                            ShowAutoFilterRow="True" 
                                            RowAnimationKind="None" 
                                            WaitIndicatorType="Panel"
                                            >
                                            <dxg:TableView.RowCellMenuCustomizations>
                                                <!--<dxb:BarButtonItem Name="viewHistoryMenuItem"  Content="View History"  ItemClick="ViewHistoryMenuItem_ItemClick"/>-->
                                            </dxg:TableView.RowCellMenuCustomizations>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="person.FName"
                                                    Header="First Name"
                                                     IsSmart="True"
                                                     Width="auto" />
                                    <dxg:GridColumn FieldName="person.LName"
                                                    Header="Last Name"
                                                    IsSmart="True"
                                                    Width="auto"/>

                                    <dxg:GridColumn FieldName="CoreCompany.CompanyName"
                                                    Header="Core Company"
                                                     IsSmart="True"
                                                     Width="auto" />
                                    <dxg:GridColumn FieldName="CoreDepartment.DeptName"
                                                    Header="Core Department"
                                                    IsSmart="True"
                                                    Width="auto"/>
                                </dxg:GridControl>
                            </Grid>
                        </dx:DXTabItem>
                        <dx:DXTabItem Name="registersTab" Header="Registers" MouseUp="RegistersTab_MouseUp" >
                            <Grid Background="White">
                                <TreeView Name="empTreeView" 
                                          SelectedItemChanged="EmpTreeView_SelectedItemChanged" 
                                         >

                                    <TreeView.Resources>

                                        <HierarchicalDataTemplate DataType="{x:Type self:cmbitem}" ItemsSource="{Binding Items}" >
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />

                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="1*" />

                                                </Grid.ColumnDefinitions>
                                                <!--<CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>-->
                                                <TextBlock Text="{Binding id}" Visibility="Collapsed" />
                                                <TextBlock Text="{Binding description}" Visibility="Collapsed" />
                                                <TextBlock Text="   " Background="{Binding bcolor}"
                                                            Width="20"
                                                            Margin="0,0,5,0" Grid.Column="1"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding name}" Grid.Column="1"
                                                                HorizontalAlignment="Stretch" />

                                                    <!--<TextBlock Text=" [" Foreground="Blue" />-->
                                                    <!--<TextBlock Text="{Binding fcolor}" Foreground="Blue" />-->
                                                    <!--<TextBlock Text="]" Foreground="Blue" />-->
                                                </StackPanel>
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                        <Style
                                          TargetType="TreeViewItem" >
                                            <Setter Property="IsExpanded" Value="True"/>
                                        </Style>
                                    </TreeView.Resources>

                                </TreeView>
                                <TreeView Name="employeeRecordTree" 
                                      SelectedItemChanged="EmployeeRecordTree_SelectedItemChanged" Visibility="Collapsed">
                                    <TreeViewItem Name="empRegister" Header="Employee Register" 
                                              IsExpanded="True" 
                                              IsEnabled="True">
                                        <TreeViewItem Name="personalInfo" Header="Personal Info"/>
                                        <TreeViewItem Name="address"  Header="Address and Contact"/>
                                        <!--<TreeViewItem Name="contact"  Header="Contact"/>-->
                                        <TreeViewItem Name="employmentInfo"  Header="Employment Info" IsEnabled="False"/>
                                        <TreeViewItem Name="depts"  Header="Depts. and Companies" IsEnabled="False"/>
                                        <TreeViewItem Name="sales"  Header="Sales Target" IsEnabled="False"/>
                                    </TreeViewItem>
                                </TreeView>
                            </Grid>



                        </dx:DXTabItem>
                    </dx:DXTabControl>
                </Grid>

                <GridSplitter Name="GridSplitter" Grid.Column="1"  VerticalAlignment="Stretch" Width="3"  HorizontalAlignment="Stretch"  />

                <Grid Name="rightGrid" Grid.Column="2" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="0.5*" />
                            <RowDefinition  Height="5" />
                            <RowDefinition Height="0.5*" />
                        </Grid.RowDefinitions>

                        <Grid   Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                             Grid.Row="0"
                             Grid.Column="0"
                             Margin="10,0">
                                <TextBlock x:Name="lblinfoheader"
                               Text="Employee Information"
                              FontSize="36"
                              VerticalAlignment="Center"
                              TextDecorations="{x:Null}" />

                            </StackPanel>
                            <Rectangle Height="3"
                            Fill="Gray"
                            VerticalAlignment="Bottom"
                            Margin="10,0" />
                            <StackPanel  Orientation="Horizontal"
                             Grid.Column="1">
                                <Image Source="/ZAS_ERP;component/images/appbar.pin.png"
                                 HorizontalAlignment="Left"
                                 Width="30" />
                                <TextBlock Text="NOTE"
                               FontSize="16"
                             VerticalAlignment="Center" />
                            </StackPanel>
                            <Rectangle Height="3"
                              Grid.Column="1"
                               Fill="Gray"
                              VerticalAlignment="Bottom"
                             Margin="10,0" />
                            <StackPanel Grid.Column="2"
                            Grid.Row="1"></StackPanel>
                            <Grid Grid.Row="1"
                             Grid.Column="0">

                                <Grid.Resources>
                                    <Style TargetType="Label">
                                        <Setter Property="Foreground"
                                         Value="DarkGray"></Setter>
                                        <Setter Property="Margin"
                                         Value="10,0"></Setter>
                                    </Style>
                                </Grid.Resources>
                                <dxlc:GroupBox Header="Employee Information"
                                Background="White" Margin="5">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Label Content="Name"
                                      ToolTip="Name"
                                         HorizontalAlignment="Right" />
                                        <Label Content="CNIC"
                                        ToolTip="CINC"
                                          HorizontalAlignment="Right"
                                         Grid.Row="1" />
                                        <Label Content="Main Phone"
                                            ToolTip="Phone#"
                                              HorizontalAlignment="Right"
                                              Grid.Row="2" />
                                        <Label Content="FAX"
                                             ToolTip="FAX#"
                                             HorizontalAlignment="Right"
                                             Grid.Row="3" />
                                        <Label Content="Email"
                                         ToolTip="Email"
                           HorizontalAlignment="Right"
                           Grid.Row="4" />
                                        <Label Content="Website"
                           ToolTip="Website"
                           HorizontalAlignment="Right"
                           Grid.Row="5" />
                                        <!--textblock for displaying data in colunm 2 of grid from stored company data -->
                                        <TextBlock x:Name="lblconatctname"
                           Text="{Binding ElementName=grdemployee,Path=CurrentItem.person.FName }"
                           ToolTip="contact Name"
                           HorizontalAlignment="Left"
                           Grid.Column="1" />
                                        <TextBlock x:Name="lblcnic"
                           Text="{Binding ElementName=grdemployee,Path=CurrentItem.person.CNIC}"
                           ToolTip="Contact Adress"
                           Grid.Row="1"
                           Grid.Column="1" />
                                        <TextBlock x:Name="lblmainPhone"
                           ToolTip="Phone#"
                           Text="{Binding ElementName=grdemployee,Path=CurrentItem.contact.ContactNo}"
                           Grid.Row="2"
                           Grid.Column="1" />
                                        <TextBlock x:Name="lblfax"
                           ToolTip="FAX#"
                           Text="{Binding ElementName=grdemployee,Path=CurrentItem.contact.Fax}"
                           Grid.Row="3"
                           Grid.Column="1" />
                                        <TextBlock x:Name="lblemail"
                           ToolTip="Email"
                           Text="{Binding ElementName=grdemployee,Path=CurrentItem.contact.Email}"
                           Grid.Row="4"
                           Grid.Column="1" />
                                        <TextBlock x:Name="lblwebsite"
                           ToolTip="Email"
                           Text="{Binding ElementName=grdemployee,Path=CurrentItem.contact.Website}"
                           Grid.Row="5"
                           Grid.Column="1" />
                                        <!-- column 3 labels-->
                                        <Label Content="Father Name"
                       ToolTip="Father Name"
                       HorizontalAlignment="Right"
                       Grid.Column="2" />
                                        <Label Content="DOB"
                       ToolTip="Date of Birth"
                       HorizontalAlignment="Right"
                       Grid.Column="2"
                       Grid.Row="1" />
                                        <Label Content="Joined"
                       ToolTip="Date of Joining"
                       HorizontalAlignment="Right"
                       Grid.Column="2"
                       Grid.Row="2" />

                                        <!--textblock for displaying data in colunm 4 of grid from stored company data -->
                                        <TextBlock x:Name="lblfather"
                           Text="{Binding ElementName=grdemployee,Path=CurrentItem.person.FatherName}"
                           ToolTip="State Name"
                           HorizontalAlignment="Left"
                           Grid.Column="3" />
                                        <TextBlock x:Name="lbldateofb"
                           ToolTip="DoB"
                           Grid.Row="1"
                           Text="{Binding ElementName=grdemployee,Path=CurrentItem.person.DOB}"
                           Grid.Column="3" />
                                        <TextBlock x:Name="lbljoinedDate"
                           ToolTip="joining date"
                           HorizontalAlignment="Left"
                           Text="{Binding ElementName=grdemployee,Path=CurrentItem.JoinDate}"
                           Grid.Row="2"
                           Grid.Column="3" />

                                    </Grid>
                                </dxlc:GroupBox>
                            </Grid>

                        </Grid>

                        <GridSplitter Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Height="3" />

                        <Grid  Grid.Row="2">
                            <DockPanel >
                                <Grid VerticalAlignment="Stretch" >
                                    <Grid.Resources>
                                        <Style TargetType="Label">
                                            <Setter Property="Foreground"
                        Value="DarkGray"></Setter>
                                            <Setter Property="Margin"
                        Value="10,0"></Setter>
                                        </Style>
                                        <Style TargetType="dx:DropDownButton">
                                            <Setter Property="Margin"
                        Value="10,5"></Setter>
                                        </Style>
                                    </Grid.Resources>
                                    <dx:DXTabControl>
                                        <dx:DXTabItem Header="Companies/Departments">
                                            <dxlc:GroupBox Header="Employee's Companies and Departments "
                               Background="White"
                               Margin="5">
                                                <dxg:GridControl SelectionMode="Row"
                                   x:Name="gridCompany"
                                   AutoGenerateColumns="None"
                                  SelectionChanged="gridCompany_SelectionChanged">


                                                    <dxg:GridControl.View>
                                                        <dxg:TableView x:Name="viewTable"
                                        AutoWidth="True"
                                       
                                        AllowEditing="False"
                                  AllowMasterDetail="True"

                                     AllowPerPixelScrolling="False"></dxg:TableView>
                                                    </dxg:GridControl.View>
                                                    <!--<dxg:GridControl.DataContext>
              <Databases:Company />
            </dxg:GridControl.DataContext>-->
                                                    <dxg:GridColumn x:Name="colId"
                                    FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                                    <dxg:GridColumn FieldName="CompanyName"
                                    IsSmart="True" />
                                                    <dxg:GridColumn FieldName="IndustryType"
                                    IsSmart="True" />
                                                    <dxg:GridColumn x:Name="colBizType"
                                    FieldName="BizType"
                                    Visible="False"
                                    IsSmart="True" />
                                                    <dxg:GridColumn FieldName="EmployeerNo"
                                    x:Name="colEmployeerNo"
                                    IsSmart="True"
                                    Visible="False" />
                                                    <!--<dxg:GridColumn FieldName="addressId" x:Name="coladressId" IsSmart="True" Visible="False" />-->
                                                    <!--<dxg:GridColumn FieldName="address" IsSmart="True" x:Name="coladress" Visible="False" />-->
                                                    <!--<dxg:GridColumn FieldName="contactId" Visible="False" x:Name="colcontactId" IsSmart="True" />-->
                                                    <!--<dxg:GridColumn FieldName="contact" x:Name="colcontact" IsSmart="True" Visible="False" />-->

                                                    <dxg:GridControl.DetailDescriptor >
                                                        <dxg:DataControlDetailDescriptor ShowHeader="True"
                                                     x:Name="detailGridDescriptor"
                                                  ItemsSourcePath="departments">
                                                            <dxg:DataControlDetailDescriptor.DataControl>
                                                                <dxg:GridControl x:Name="gridCompanyDepartment"
                                   Grid.Column="0"
                                   Grid.Row="7"
                                  
                                   AutoGenerateColumns="None"
                                   Grid.ColumnSpan="4"
                                   IsEnabled="False"
                                   MaxHeight="200">
                                                                    <dxg:GridControl.View>
                                                                        <dxg:TableView x:Name="gridcompdeptview"
                                        AutoWidth="True"
                                       
                                        IsSynchronizedWithCurrentItem="True"></dxg:TableView>
                                                                    </dxg:GridControl.View>

                                                                    <dxg:GridColumn FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                                                    <dxg:GridColumn FieldName="DeptName"
                                    IsSmart="True" />
                                                                    <dxg:GridColumn FieldName="Code"
                                    IsSmart="True" />
                                                                    <dxg:GridColumn FieldName="Abbrivation"
                                    IsSmart="True"
                                    Visible="True" />
                                                                    <dxg:GridColumn FieldName="Timestamp"
                                    IsSmart="True"
                                    Visible="False" />
                                                                </dxg:GridControl>
                                                            </dxg:DataControlDetailDescriptor.DataControl>
                                                        </dxg:DataControlDetailDescriptor>
                                                    </dxg:GridControl.DetailDescriptor>
                                                </dxg:GridControl>
                                            </dxlc:GroupBox>
                                        </dx:DXTabItem>
                                        <dx:DXTabItem Header="Transactions" />
                                        <dx:DXTabItem Header="Contacts" />
                                        <dx:DXTabItem Header="To Do's">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition MinHeight="40"
                                   MaxHeight="60" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition MinHeight="40"
                                   MaxHeight="60" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Label Content="TYPE"
                           Grid.Row="0"></Label>
                                                    <dx:DropDownButton x:Name="dbtnType"></dx:DropDownButton  >
                                                    <Label Content="STATUS"></Label>
                                                    <dx:DropDownButton x:Name="dbtnStatus"></dx:DropDownButton>
                                                    <Label Content="DATE"></Label>
                                                    <dx:DropDownButton x:Name="dbtnDate"></dx:DropDownButton>
                                                </StackPanel>
                                                <dxg:GridControl Margin="10"
                                   Grid.Row="1"
                                   MaxHeight="800"
                                   MinHeight="150" />
                                                <StackPanel  Orientation="Horizontal"
                               Grid.Row="2">
                                                    <dx:DropDownButton Content="Manage To Do's"
                                       x:Name="dbtnmanagetodo"
                                       MinWidth="80"></dx:DropDownButton>
                                                    <dx:DropDownButton MinWidth="80"
                                       x:Name="dbtnrunReports"
                                       Content="Run Reports"></dx:DropDownButton>
                                                </StackPanel>
                                            </Grid>
                                        </dx:DXTabItem>
                                        <dx:DXTabItem Header="Notes" />
                                        <dx:DXTabItem Header="Sent Email" />
                                    </dx:DXTabControl>
                                </Grid>
                            </DockPanel>

                        </Grid>

                    </Grid>

                    <Grid Name="registersGrid" 
                    Background="White" 
                      Panel.ZIndex="8" Visibility="Collapsed">


                        <!--<dxg:GridControl
                        Name="grdEmployeeRegisters"
                        AutoGenerateColumns="AddNew" 
                        Margin="0 0 0 40"
                         EnableSmartColumnsGeneration="True" 
                         CustomUnboundColumnData="GrdEmployeeRegisters_CustomUnboundColumnData"
                        >

                        <dxg:GridControl.View >
                            <dxg:TableView AllowPerPixelScrolling="True" 
                               ShowTotalSummary="True"
                               ShowAutoFilterRow="True" 
                               RowAnimationKind="None" 
                               WaitIndicatorType="Panel"
                               AllowEditing="True"
                              
                               >
                                <dxg:TableView.RowCellMenuCustomizations>



                                    -->
                        <!--<dxb:BarButtonItem Name="viewHistoryMenuItem"  Content="View History"  ItemClick="ViewHistoryMenuItem_ItemClick"/>-->
                        <!--
                                </dxg:TableView.RowCellMenuCustomizations>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridColumn Header="First Name"
                            FieldName="person.FName"
                            IsSmart="True"
                            Width="auto" />
                        <dxg:GridColumn Header="Last Name"
                            FieldName="person.LName"
                            IsSmart="True"
                            Width="auto" />
                        <dxg:GridColumn Header="Father Name"
                            FieldName="person.FatherName"
                            IsSmart="True"
                            Width="auto" />
                        <dxg:GridColumn Header="CNIC"
                            FieldName="person.CNIC"
                            IsSmart="True"
                            Width="auto" />
                        <dxg:GridColumn Header="Gender"
                            FieldName="person.Gender"
                            IsSmart="True"
                            Width="auto" />
                        <dxg:GridColumn Header="DOB"
                            FieldName="person.DOB"
                            IsSmart="True"
                            Width="auto" />
                        <dxg:GridColumn Header="Marital Status"
                            FieldName="MaritalStatus"
                            IsSmart="True"
                            Width="auto" />
                        <dxg:GridColumn Header="Is Disable"
                            FieldName="Disability"
                            IsSmart="True"
                            Width="auto" />
                        <dxg:GridColumn Header="Disablitity"
                            FieldName="DisDescription"
                            IsSmart="True"
                            Width="auto" />
                        <dxg:GridColumn Header="Is Active"
                            FieldName="isActive"
                            IsSmart="True"
                            Width="auto" />

                    </dxg:GridControl>
                    <Button Name="saveGriddata" Content="Save" Click="SaveGriddata_Click" VerticalAlignment="Bottom" Height="45"/>-->

                    </Grid>

                </Grid>

            </Grid>
        </Grid>
        <!--<Grid>
        <Grid.RowDefinitions>
          <RowDefinition MinHeight="25"
                         Height="1*"
                         MaxHeight="35" />
          <RowDefinition Height="7*" />
          <RowDefinition Height="5" />
          <RowDefinition Height="7*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.5*"
                            MinWidth="280" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.ColumnSpan="3" >
        
        </DockPanel>
        <DockPanel Grid.Row="1"
                   Grid.RowSpan="3"
                   Grid.Column="0" Name="lftDocPanel">
          
        </DockPanel>
                
              
                
        
 
      </Grid>-->
        <Image
        x:Name="loadingGif"    
       
            
        Visibility="Hidden"
        Grid.Row="2"
            
         gif:AnimationBehavior.SourceUri="/ZAS_ERP;component/images/loading.gif"   
        VerticalAlignment="Center"
        HorizontalAlignment="Center" RenderTransformOrigin="12.987,0.793" Margin="5,100,5,5" Width="60" />

    </Grid>
</dx:DXWindow>
