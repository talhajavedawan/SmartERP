<Window x:Class="ZAS_ERP.Accountss.frmAccountHeadAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Accountss"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Title="Account Add" Height="350" Width="700">
    <Grid  Margin="0,10,0,0">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground"
                Value="DarkGray" />
                <Setter Property="VerticalAlignment"
                Value="Center" />
                <Setter Property="HorizontalAlignment"
                Value="Right" />
                <Setter Property="Margin"
                Value="10,10" />
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin"
                Value="10,5" />
                <Setter Property="VerticalAlignment"
                Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />

            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <TextBlock Text="Account Number" />
        <TextBox Grid.Column="1"
              x:Name="txtAccountNumber"
               />

        <TextBlock Text="Account Name"
               Grid.Row="0" Grid.Column="2" />
        <TextBox Grid.Column="3"
             Grid.Row="0"
             x:Name="txtAccountName" />
        <TextBlock Text="Account Discription"
               Grid.Row="1"  />
        <TextBox Grid.Column="1"
             Grid.Row="1"
             x:Name="txtAccountDiscription" />
        <TextBlock Text="Type"
               ToolTip="Account Type"
               Grid.Row="1" Grid.Column="2" />
        <ComboBox 
              VerticalAlignment="Center"
              Grid.Column="3"
              Grid.Row="1"
              x:Name="cmbtype"
              Margin="10,5"
              
              TabIndex="4"
              DisplayMemberPath="{Binding name}"
      >

            <!--<ComboBoxItem>
        <Button Content="Add New"
                Foreground="BlueViolet" Height="20"></Button>
      </ComboBoxItem>-->
            <ComboBox.ItemTemplate>
                <DataTemplate>



                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                       Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Currency"
               
               Grid.Row="2" />
        <ComboBox x:Name="cmbCurrency"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Grid.Row="2" Margin="10,0"
                           TabIndex="4" >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                                     Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Balance"
               Grid.Row="2" Grid.Column="2" />

        <dxe:TextEdit MaskType="Numeric" Mask="n2" VerticalAlignment="Center"
          Margin="10,0"         IsReadOnly="True"       MaskUseAsDisplayFormat="True" Grid.Row="2" Grid.Column="3" x:Name="txtbalance" ></dxe:TextEdit>
        <TextBlock Text="isSubsidory" Grid.Column="2" Grid.Row="3"></TextBlock>
        <Grid
                              Grid.Column="3"
                              Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto">

                </ColumnDefinition>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="chkissubsidroy"
                          Margin="10,0"
                            VerticalAlignment="Center"
                            Checked="chkissubsidroy_Checked"
                            Unchecked="chkissubsidroy_Unchecked"
                            TabIndex="5"></CheckBox>

            <TextBlock TextWrapping="Wrap" 
                    Text="Check the box if this is a Subsidory Account"
                             Grid.Column="1"
                                 ></TextBlock>
            
        </Grid>
        <TextBlock TextWrapping="Wrap"  Visibility="Hidden"
                    Text="Parent Account" x:Name="lblParentAccount"
                             Grid.Column="0" Grid.Row="4"
                                 ></TextBlock>
        <dxg:LookUpEdit x:Name="lookupParentAccount" 
                                  Grid.Column="1" Visibility="Hidden"
                                  Grid.ColumnSpan="3"
                                  Grid.Row="4" Margin="10,0"
                                  VerticalAlignment="Center"
                                  DisplayMember="Number"
                                 AutoPopulateColumns="False"
                                  SelectedIndexChanged="LookupParentAccount_SelectedIndexChanged">
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <!--<Button x:Name="btnAddCustomer"
                                  Click="btnAddCustomer_Click"
                                  VerticalAlignment="Center"
                                  Content="Add New" />-->
                        <dxg:GridControl Name="PART_GridControl"
                                           AutoPopulateColumns="True"
                                           Grid.Row="1" AllowInitiallyFocusedRow="False">
                            <dxg:GridControl.View>
                                <dxg:TreeListView Name="treeListView1"
                                                ShowAutoFilterRow="True"
                                                FadeSelectionOnLostFocus="False"
                                                ShowSelectionRectangle="True"
                                                TreeDerivationMode="Selfreference"
                                                KeyFieldName="Id"
                                                ParentFieldName="ParentID" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn x:Name="colId"
                                            FieldName="Id"
                                            IsSmart="True"
                                            Visible="False" />
                            <dxg:GridColumn FieldName="AccountNumber"
                                            IsSmart="True"
                                            Width="auto" />
                            <!--<dxg:GridColumn FieldName="company.IndustryType"
                                            IsSmart="True"
                                            Visible="False" />-->
                            <dxg:GridColumn 
                                            FieldName="Name"
                                            Visible="True"
                                            IsSmart="True" />
                            <dxg:GridColumn FieldName="Type"
                                            
                                            IsSmart="True"
                                            Visible="True"
                                            
                                            Width="auto" />




                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>
        <TextBlock Text="isActive"
               Grid.Row="3" />
        <CheckBox Grid.Column="1"
             Grid.Row="3" x:Name="chkIsActive" IsChecked="True"
             VerticalAlignment="Center" Margin="10,5"/>
        
        <Button Content="Save"
            Grid.Row="8"
            FontSize="24"
            x:Name="btnSave"
            Click="BtnSave_Click"
            FontWeight="Medium"
            Grid.ColumnSpan="4"  />
    </Grid>
</Window>
