<dx:DXWindow
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:Databases="clr-namespace:ERP_BL.Databases;assembly=ERP_BL" x:Class="ZAS_ERP.ChartofAccounts.Windows.winBalanceSheet"
        mc:Ignorable="d"
       Title="Balance Sheet"  WindowState="Maximized"  Height="450" Width="600"  Loaded="Window_Loaded">
    <dx:DXWindow.Resources>
        <dx:EntitySimpleDataSource x:Key="EntitySimpleDataSource" ContextType="{x:Type Databases:DBContextERP}" Path="Companies">
            <dx:DesignDataManager.DesignData>
                <dx:DesignDataSettings RowCount="5"/>
            </dx:DesignDataManager.DesignData>
        </dx:EntitySimpleDataSource>
    </dx:DXWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Margin="5,5,5,5" Grid.ColumnSpan="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <TextBlock Text="Company" FontWeight="DemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,5,5,5" Grid.Column="0"/>
            <dxg:LookUpEdit x:Name="mbtnAllCompanies" Grid.Column="1" Grid.ColumnSpan="4" MinWidth="110"  Margin="5,5,5,5" EditValueChanged="mbtnAllCompanies_EditValueChanged"    ItemsSource="{Binding Data, Source={StaticResource EntitySimpleDataSource}}" DisplayMember="CompanyName"    >
                <dxg:LookUpEdit.StyleSettings>
                    <dxg:LookUpEditStyleSettings/>
                </dxg:LookUpEdit.StyleSettings>

            </dxg:LookUpEdit>
            <dxe:TextEdit Grid.Column="5" Margin="5,5,5,5" FontWeight="DemiBold" Background="Orange" IsReadOnly="True" HorizontalContentAlignment="Center" Text="To"/>
            <dxe:DateEdit x:Name="dateTo" Margin="5,5,5,5" NullText="Select Date" Grid.ColumnSpan="2" Grid.Column="6"  FontWeight="DemiBold"  />
            <dx:SimpleButton x:Name="btnDateFilter" ToolTip="Filter by date range" Grid.Column="8" Margin="5,5,5,5" Content="Apply" Cursor="Hand" Click="BtnDateFilter_Click"  />



        </Grid>



        <Grid Grid.ColumnSpan="2" Grid.Row="1" >
            <TextBlock x:Name="lblHeading" 
                       
                       Text="Chart of Accounts Balance Sheet"
                       FontSize="22" FontWeight="Bold"
                       FontFamily="Segoe UI Semibold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextDecorations="Underline"
                        />
        </Grid>
        <dxg:GridControl x:Name="grdAssets"
                        Grid.Row="2"
                         Margin="5,5,5,5"
                         MouseDoubleClick="grdAssets_MouseDoubleClick"
                         CustomUnboundColumnData="grdAssets_CustomUnboundColumnData"
                        SelectionMode="Row">
            <dxg:GridControl.View>
                <dxg:TableView x:Name="assetsView"
                            ShowGroupFooters="True"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            ShowTotalSummary="True"    
                               
                            Width="auto"      
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True" 
                            ShowGroupPanel="False"   
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" >
                    <dxg:TableView.GroupSummaryItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Background="Bisque">
                                <TextBlock Text="Total:   "/>
                                <TextBlock Text="{Binding Value}" Background="LightBlue"/>
                            </StackPanel>
                        </DataTemplate>
                    </dxg:TableView.GroupSummaryItemTemplate>
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridControl.GroupSummary>
                <dxg:GridSummaryItem FieldName="balanceOC" 
        ShowInGroupColumnFooter="balanceOC" DisplayFormat="Total Balance (OC): {0:n2}"  SummaryType="Sum" />
                <dxg:GridSummaryItem DisplayFormat="Total Balance (PKR): {0:n2}" FieldName="balancePKR"
        ShowInGroupColumnFooter="balancePKR" SummaryType="Sum" />
            </dxg:GridControl.GroupSummary>
            <dxg:GridControl.TotalSummary >
                <dxg:GridSummaryItem  FieldName="balanceOC"  SummaryType="Sum"   DisplayFormat="{}{0:n2}" />
                <dxg:GridSummaryItem  FieldName="balancePKR" SummaryType="Sum" DisplayFormat="{}{0:n2}" />

            </dxg:GridControl.TotalSummary>
            <dxg:GridColumn Header="Id"
                            Binding="{Binding Id}"
                            IsSmart="True"
                            Visible="False"
                            VisibleIndex="0"
                             />
            <dxg:GridColumn Header="Creation Date"
                            Binding="{Binding creationDate}"
                            VisibleIndex="1"
                            Visible="False"
                            IsSmart="True"
                             >
                <dxg:GridColumn.EditSettings>
                    <dxe:DateEditSettings Mask="f"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Name"
                            VisibleIndex="2"
                            FieldName="accountName"
                            Image="{dx:DXImage Image=Accounting_16x16.png}"
                            IsSmart="True" SortOrder="Ascending" SortIndex="0"
                             />
            <dxg:GridColumn Header="Type"
                            FieldName="accountType"
                            VisibleIndex="4"
                            IsSmart="True"
                            GroupIndex="0" SortOrder="Ascending"
                             />
            <dxg:GridColumn Header="Company"
                            FieldName="Company"
                            Visible="False"
                            VisibleIndex="4"
                            UnboundType="String"
                            Image="{dx:DXImage Image=Home_16x16.png}"                      
                           />
            <dxg:GridColumn Header="Department"
                            FieldName="Department"
                            Visible="False"
                            AllowSorting="false"
                            UnboundType="String"
                           VisibleIndex="5"
                             Image="{dx:DXImage Image=Home_16x16.png}"
                            />
            <dxg:GridColumn Header="Currency"
                            Binding="{Binding Currency.CurrencyName}"
                            Visible="True"                            
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            VisibleIndex="6"
                            AllowSorting="false"
                             />
            <dxg:GridColumn FieldName="balanceOC"
                            ReadOnly="True"
                            VisibleIndex="7"
                            AllowSorting="false"
                            UnboundType="Decimal"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            Header="Balance (OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="balancePKR"
                            ReadOnly="True"
                            VisibleIndex="7"
                            AllowSorting="false"
                            UnboundType="Decimal"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            Header="Balance (PKR)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Reconciled Date"
                            FieldName="reconcilationDate"
                            UnboundType="DateTime"
                            VisibleIndex="16"
                            AllowSorting="false"
                            Visible="True"                            
                             Image="{dx:DXImage Image=Time_16x16.png}" />
        </dxg:GridControl>
        <dxg:GridControl x:Name="grdLiability"
                          Grid.Row="2"
                          Margin="5,5,5,5"
                         CustomUnboundColumnData="grdLiability_CustomUnboundColumnData"
                          Grid.Column="1"
                         MouseDoubleClick="grdLiability_MouseDoubleClick"
                          SelectionMode="Row">
            <dxg:GridControl.View>
                <dxg:TableView x:Name="libilityView"
                            ShowGroupFooters="True"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            ShowTotalSummary="True"      
                            Width="auto"      
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True" 
                            ShowGroupPanel="False"   
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" >
                    <dxg:TableView.GroupSummaryItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Background="Bisque">
                                <TextBlock Text="Total:   "/>
                                <TextBlock Text="{Binding Value}" Background="LightBlue"/>
                            </StackPanel>
                        </DataTemplate>
                    </dxg:TableView.GroupSummaryItemTemplate>
                </dxg:TableView>

            </dxg:GridControl.View>
            <dxg:GridControl.GroupSummary>
                <dxg:GridSummaryItem FieldName="balanceOC" 
        ShowInGroupColumnFooter="balanceOC" DisplayFormat="Total Balance (OC): {0:n2}"  SummaryType="Sum" />
                <dxg:GridSummaryItem DisplayFormat="Total Balance (PKR): {0:n2}" FieldName="balancePKR"
        ShowInGroupColumnFooter="balancePKR" SummaryType="Sum" />
            </dxg:GridControl.GroupSummary>
            <dxg:GridControl.TotalSummary >
                <dxg:GridSummaryItem  FieldName="balanceOC"  SummaryType="Sum"   DisplayFormat="{}{0:n2}" />
                <dxg:GridSummaryItem  FieldName="balancePKR" SummaryType="Sum" DisplayFormat="{}{0:n2}" />

            </dxg:GridControl.TotalSummary>
            <dxg:GridColumn Header="Id"
                            Binding="{Binding Id}"
                            IsSmart="True"
                            Visible="False"
                            VisibleIndex="0"
                             />
            <dxg:GridColumn Header="Creation Date"
                            Binding="{Binding creationDate}"
                            VisibleIndex="1"
                            Visible="False"
                            IsSmart="True"
                             >
                <dxg:GridColumn.EditSettings>
                    <dxe:DateEditSettings Mask="f"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Name"
                            VisibleIndex="2"
                            FieldName="accountName"
                            Image="{dx:DXImage Image=Accounting_16x16.png}"
                            IsSmart="True" SortOrder="Ascending" SortIndex="0"
                             />
            <dxg:GridColumn Header="Type"
                            FieldName="accountType"
                            VisibleIndex="4"
                            IsSmart="True"
                            GroupIndex="0" SortOrder="Ascending"
                             />
   
            <dxg:GridColumn Header="Department"
                            FieldName="Department"
                            Visible="False"
                            AllowSorting="false"
                            UnboundType="String"
                            
                           VisibleIndex="5"
                             Image="{dx:DXImage Image=Home_16x16.png}"
      
                            />
            <dxg:GridColumn Header="Currency"
                            Binding="{Binding Currency.CurrencyName}"
                            Visible="True"                            
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            VisibleIndex="6"
                            AllowSorting="false"
                             />
            <dxg:GridColumn FieldName="balanceOC"
                            ReadOnly="True"
                            VisibleIndex="7"
                            AllowSorting="false"
                            UnboundType="Decimal"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            Header="Balance (OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="balancePKR"
                            ReadOnly="True"
                            VisibleIndex="7"
                            AllowSorting="false"
                            UnboundType="Decimal"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            Header="Balance (PKR)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Reconciled Date"
                            FieldName="reconcilationDate"
                            UnboundType="DateTime"
                            VisibleIndex="16"
                            AllowSorting="false"
                            Visible="True"                            
                             Image="{dx:DXImage Image=Time_16x16.png}" />
        </dxg:GridControl>
    </Grid>
</dx:DXWindow>
