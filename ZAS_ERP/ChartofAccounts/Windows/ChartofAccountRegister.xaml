<dx:DXWindow
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.ChartofAccounts.Windows.ChartofAccountRegister"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:self="clr-namespace:ZAS_ERP"
        mc:Ignorable="d"
        Title="Chart of Accounts" Height="auto" Width="auto" WindowStartupLocation="CenterScreen" Loaded="DXWindow_Loaded" WindowState="Maximized" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" >
    <Grid>
        <dxb:BarManager  Grid.Row="1" x:Name="faBarManager">

            <dxb:BarManager.Bars>
                <dxb:Bar Caption="Options">

                    <dxb:Bar.DockInfo>
                        <dxb:BarDockInfo ContainerType="Top"/>
                    </dxb:Bar.DockInfo>

                    <dxb:BarButtonItem x:Name="addCOABarItem" ToolTip="Add new account" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       Glyph="/ZAS_ERP;component/images/icon-Add-ReportGroups.png" 
                                       Content="Add new" ItemClick="AddCOABarItem_ItemClick"/>
                    <!--<dxb:BarButtonItem x:Name="grdCollapse" 
                                       ItemClick="GrdCollapse_ItemClick"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/collapse1.png"
                                       ToolTip="Collapse" 
                                       Content="Collapse Grid" />

                    <dxb:BarButtonItem ToolTip="Expand" x:Name="grdExpand" 
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/expand1.png"
                                       ItemClick="GrdExpand_ItemClick"
                                       Content="Expand Grid" />-->
                </dxb:Bar>


            </dxb:BarManager.Bars>
            <Grid>

                <Grid.Resources>

                </Grid.Resources>
              
                <Grid x:Name="faRightGrid" Grid.Row="1">
                </Grid>
            </Grid>
        </dxb:BarManager>

    </Grid>
</dx:DXWindow>
