<dx:DXWindow xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" 
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.ChartofAccounts.Windows.JournalEntries"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:loc="clr-namespace:ZAS_ERP"     
    mc:Ignorable="d"
        Title="General Journal Voucher" Height="auto" Width="auto" WindowStartupLocation="CenterScreen" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" WindowState="Maximized" Loaded="Window_Loaded" Unloaded="DXWindow_Unloaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="b2v" />
        
    </Window.Resources>
    <!--</Window.Resources>-->
    <Window.CommandBindings>
        <CommandBinding Command="loc:CustomCommands.ReplytoComment" CanExecute="Command_CanExecute" Executed="Command_Executed" />
    </Window.CommandBindings>
    <Grid dx:ThemeManager.ThemeName="DeepBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Left" dx:ThemeManager.ThemeName="None"
                 Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">
                    <Image Margin="-12" Source="/ZAS_ERP;component/images/log.png"></Image>
                </Button>
                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1" Click="BtnMarkReviewed_Click"  ToolTip="Approve - Mark as Reviewed">
                    <Image Margin="-12" Source="/ZAS_ERP;component/images/approve.png"></Image>
                </Button>
                <!--<Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnReject" Grid.Column="2" Click="BtnReject_Click"  ToolTip="Reject">
                        <Image Margin="-12" Source="/ZAS_ERP;component/images/closeLogo32x32.png"></Image>
                </Button>-->
                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnDirectClose" Grid.Column="2" Click="BtnDirectClose_Click"  ToolTip="Direct Close">
                    <Image Margin="-12" Source="/ZAS_ERP;component/images/closeLogo32x32.png"></Image>
                </Button>
                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" Click="BtnAddComment_Click"  ToolTip="Add New Comment">
                    <Image Margin="-12" Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
                </Button>
                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2" Click="BtnCommentLog_Click"  ToolTip="CommentLog">
                    <Image Margin="-12" Source="/ZAS_ERP;component/images/comments.png" ></Image>
                </Button>
                <Button x:Name="btnAttachNew" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Info" Click="BtnAttachNew_Click">
                    <Image x:Name="imgAttachNew" Margin="-12" Source="/ZAS_ERP;component/images/clipattachment.png"></Image>
                </Button>
                <Button x:Name="btnAttachmentList" Width="30" Height="30" Grid.Column="3" ToolTip="Info" Click="BtnAttachmentList_Click">
                    <Image Margin="-15" Source="/ZAS_ERP;component/images/ListAttachment.png"></Image>
                </Button>
                
                <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnSetVoid" Visibility="Collapsed" Grid.Column="2" Click="BtnSetVoid_Click"  ToolTip="Void">
                    <Image Margin="-15" Source="/ZAS_ERP;component/images/void_order.png" ></Image>
                </Button>
            </StackPanel>
            <Grid Panel.ZIndex="5" Visibility="Collapsed" Grid.RowSpan="4" x:Name="gridTracker" Width="500" Margin="35"  HorizontalAlignment="Left" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="btnCollapse" Click="BtnCollapse_Click" Content="Collapse"></Button>
                    <TextBlock Text="Activity Tracker" FontWeight="Bold" FontSize="26" Foreground="Black" Margin="30,5"></TextBlock>
                    <Button x:Name="btnexpand" Click="Btnexpand_Click" Content="Expand"></Button>

                </StackPanel>
                <dxg:GridControl x:Name="grdUsers" Visibility="Visible"
                     Grid.Row="1" MaxHeight="520"
                     Grid.RowSpan="5" HorizontalAlignment="Left"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             
                     SelectionMode="Row" 
                             
                             
                      CustomUnboundColumnData="GrdUsers_CustomUnboundColumnData"   
                    AutoGenerateColumns="None">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       
                                   AutoWidth="True"
                       Width="auto"
                       AllowGrouping="False"
                                   ShowGroupPanel="False"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       
                       >

                        </dxg:TableView>
                    </dxg:GridControl.View>
                    <dxg:GridColumn Header="User Name"
                            FieldName="User.userName"
                            IsSmart="True"
                            Width="auto" />
                    <!--<dxg:GridColumn FieldName="Name" UnboundType="String" ReadOnly="True" >
                    -->
                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                    <!--
                </dxg:GridColumn>-->
                    <dxg:GridColumn FieldName="Timestamp" UnboundType="String" ReadOnly="True" Width="auto">
                        <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Info"
                            FieldName="Info"
                            IsSmart="True"
                            Width="auto" />
                    <dxg:GridColumn 
                            FieldName="Comment"
                            IsSmart="True"
                            Width="auto" />
                    <!--<dxg:GridColumn FieldName="isActive"  >
                    -->
                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                    <!--
                </dxg:GridColumn>-->
                    <!--<dxg:GridColumn FieldName="SupervisorName" UnboundType="String" ReadOnly="True" >
                    -->
                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                    <!--
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Departments" UnboundType="String" ReadOnly="True" >
                    -->
                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                    <!--
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Companies" UnboundType="String" ReadOnly="True" >
                    -->
                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                    <!--
                </dxg:GridColumn>-->
                </dxg:GridControl>
            </Grid>
            <Grid x:Name="grdComments"  Visibility="Collapsed" Grid.RowSpan="4" Width="400"  Background="Gray" Panel.ZIndex="5" VerticalAlignment="Stretch" Margin="35" HorizontalAlignment="Left">
                <dxg:GridControl AutoExpandAllGroups="True" Height="auto" VerticalAlignment="Stretch" Grid.Row="1"  dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">
                    <!--#region Columns-->
                    <dxg:GridControl.Columns>


                        <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                        <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                        <dxg:GridColumn Width="Auto" FieldName="Subject" />
                        <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                        <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                        <dxg:GridColumn
                            Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Descending" />
                    </dxg:GridControl.Columns>
                    <!--#endregion-->
                    <dxg:GridControl.View>
                        <dxg:TableView 
                            x:Name="GrdCommenttableView" AllowEditing="False" DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                                    DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0" RowStyle="{StaticResource RowStyle}" ShowSearchPanelMode="Always" SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" ShowIndicator="False" ShowVerticalLines="False"
                            CompactPanelShowMode="Always" SwitchToCompactModeWidth="700"
                             NavigationStyle="Row"
                           >

                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                    <dxg:FormatCondition.Format>
                                        <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>

                                <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Changed')">
                                    <dxg:FormatCondition.Format>
                                        <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>


                            </dxg:TableView.FormatConditions>
                            <!--#region CompactModeFilterItems-->
                            <!--<dxg:TableView.CompactModeFilterItems>
                            <dxg:CompactModeFilterItem DisplayValue="All" />
                            <dxg:CompactModeFilterItem DisplayValue="Read" EditValue="[isRead] = True" />
                            <dxg:CompactModeFilterItem DisplayValue="Unread" EditValue="[isRead] = False" />

                        </dxg:TableView.CompactModeFilterItems>-->
                            <!--#endregion-->

                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>

            </Grid>
            <Grid x:Name="grdAttachments" Grid.RowSpan="4"   Width="300" Visibility="Visible" Background="Gray" Panel.ZIndex="5" VerticalAlignment="Top" Margin="210,30,65,35" HorizontalAlignment="Left">
                <TreeView x:Name="treeViewAttachments" >
                    <TreeView.Resources>
                        <HierarchicalDataTemplate  DataType="{x:Type loc:TreeItem}" ItemsSource="{Binding Items}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding name}"
                         Grid.Column="0"
                         
                         HorizontalAlignment="Stretch" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text=" [" Foreground="Blue" />
                                    <TextBlock Text="{Binding Items.Count}" Foreground="Blue" />
                                    <TextBlock Text="]" Foreground="Blue" />
                                </StackPanel>
                            </Grid>
                        </HierarchicalDataTemplate>
                        <DataTemplate  DataType="{x:Type loc:cmbitem}" >
                            <StackPanel>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />

                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="1*" />

                                    </Grid.ColumnDefinitions>
                                    <!--<CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>-->
                                    <TextBlock Text="{Binding id}"
                         Visibility="Collapsed" />
                                    <TextBlock Text="{Binding description}"
                         Visibility="Collapsed" />
                                    <Button Content="Open" Margin="5,0" x:Name="btnDownloadAttachment" Click="BtnDownloadAttachment_Click" Foreground="Blue"  Tag="{Binding description}"></Button>

                                    <TextBlock Text="   "
                         Background="{Binding bcolor}"
                         Width="20"
                         Margin="0,0,5,0" Grid.Column="1"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" >
                                        <TextBlock Text="{Binding name}"
                         Grid.Column="1"
                         
                         HorizontalAlignment="Stretch" />

                                        <!--<TextBlock Text=" [" Foreground="Blue" />-->
                                        <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                                        <!--<TextBlock Text="]" Foreground="Blue" />-->
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                        <!--<HierarchicalDataTemplate DataType="{x:Type self:cmbitem}"  >
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />

                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="1*" />
                                                    
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>
                                                <TextBlock Text="{Binding id}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="{Binding description}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="   "
                         Background="{Binding bcolor}"
                         Width="20"
                         Margin="0,0,5,0" Grid.Column="1"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding name}"
                         Grid.Column="1"
                         
                         HorizontalAlignment="Stretch" />
                                                
                                                    <TextBlock Text=" [" Foreground="Blue" />
                                                    <TextBlock Text="{Binding fcolor}" Foreground="Blue" />
                                                    <TextBlock Text="]" Foreground="Blue" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>-->
                    </TreeView.Resources>
                </TreeView>
            </Grid>
            <Grid x:Name="grdAttach"   Width="250" Visibility="Collapsed"  Grid.RowSpan="4" Background="White"  Panel.ZIndex="5" VerticalAlignment="Top" Margin="175,32,65,35" HorizontalAlignment="Left">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />

                        <ColumnDefinition Width="1*" />

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Category"
                         
                         
                         Margin="5,0,5,0" Grid.Column="0"/>
                    <ComboBox x:Name="cmbCategory"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                          Margin="5,5"
                      Grid.Row="0"
                      TabIndex="0"
                      >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel  Orientation="Horizontal">
                                    <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                                    <TextBlock Text="{Binding name}"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>


                    <!--<TextBlock Text=" [" Foreground="Blue" />-->
                    <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.ColumnSpan="2" Content="Select file" Margin="5" x:Name="btnAttachment" Click="BtnAttachment_Click" Foreground="Blue"  Tag="{Binding description}"></Button>
                    <!--<TextBlock Text="]" Foreground="Blue" />-->

                </Grid>

            </Grid>






            <Grid x:Name="grdEntryList"  Grid.RowSpan="2"  Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <dxlc:GroupBox Grid.Row="0"
                               Padding="2"
                               Header="Voucher Details"
                               Opacity="0.9"
                               Margin="10 10 10 10"
                               CornerRadius="4"
                               Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                               DisplayMode="Default"
                               VerticalAlignment="Top" 
                               HorizontalContentAlignment="Center" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            
                        </Grid.RowDefinitions>
                        
                        
                        <TextBlock Grid.Column="1" 
                               x:Name="lblEntryDate" 
                                   Margin="5,5,5,5"
                                   Text="Creation Date" ToolTip="Creation Date"
                                   Cursor="Hand"
                                                          FontWeight="DemiBold" 
TextAlignment="Center"
                               />
                        <dxe:DateEdit x:Name="datPosting" Margin="5,5,5,5"
                                      Grid.Column="2"  />
                        <TextBlock 
                               x:Name="lblEntryNo" 
                          
                               Grid.Column="1" 
                            Margin="5,5,5,5"
                            Grid.Row="1"
                            Text="Entry No:"
                                                          FontWeight="DemiBold" 
TextAlignment="Center"
                              
                              
                               />
                        <dxe:TextEdit x:Name="txtEntryNo"
                                      Grid.Column="2" 
                                      Margin="5,5,5,5"
                                      Grid.Row="1"
                                        ToolTip="Entry No."
                                      Cursor="Hand"
                                      Mask="n2"/>
                        <TextBlock 
                               x:Name="lblVoucherRefNo" 
                               Grid.Column="1" 
                            Margin="5,5,5,5"
                            Grid.Row="2"
                                                       FontWeight="DemiBold" 
TextAlignment="Center"
                               Text="Voucher Ref No:"
                                 />
                        <dxe:TextEdit x:Name="txtVoucherRefNo" 
                                      Grid.Column="2"
                                      Grid.Row="2"
                                      Margin="5,5,5,5"
                                      Mask="n2"/>
                        <TextBlock x:Name="label1Change"
                                   Margin="5,5,5,5"
                                                FontWeight="DemiBold" 

                     Grid.Row="0"
                                   TextAlignment="Center"
                     Grid.Column="5"
                               
                     ><Run Text="Status" /></TextBlock>
                        <Grid Grid.Column="6" 
                              Grid.ColumnSpan="1"
                    Grid.Row="0" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox VerticalAlignment="Center"
                    Grid.Column="0"
                    Grid.Row="0" 
                                      Cursor="Hand" 
                                      ToolTip="Status"
                                      Margin="5,5,5,5"
                    x:Name="cmbJVStatus"
                    SelectionChanged="CmbJVStatus_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"></ColumnDefinition>
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding id}"
                             Visibility="Hidden" />
                                            <TextBlock Text="   "
                             Background="{Binding bcolor}"
                             Width="20"
                             Margin="10,0" />
                                            <TextBlock Text="{Binding name}"
                             Grid.Column="1"
                             Foreground="{Binding fcolor}"
                             HorizontalAlignment="Stretch"></TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                       
                        <TextBlock
                           Grid.Column="5"
                            Margin="5,5,5,5"
                            TextAlignment="Center"
                         
                            Text="MER"
                          Grid.Row="2"
                           FontWeight="DemiBold" 
                            />
                        <dxe:TextEdit x:Name="txtMER" 
                                      Grid.Column="6"
                                      Margin="5,5,5,5"
                                      Grid.Row="2"
                                      MaskType="Numeric"
                                      Mask="n2">
                        </dxe:TextEdit>
                        <TextBlock
                           Grid.Column="5"
                            TextAlignment="Center"
                            Text="Currency"
                            Margin="5,5,5,5"
                          Grid.Row="1"
                           FontWeight="DemiBold" 
                            />
                        <dxg:LookUpEdit Grid.Column="6" Height="22" 
                                    Grid.Row="1"
                                        Margin="5,5,5,5"
                                              IsTextEditable="False" 
                                              x:Name="cmbxCurrency"
                                     ToolTip="Currency"
                                        Cursor="Hand"
                                            DisplayMember="CurrencyName"
                                              SelectedIndexChanged="CmbxCurrency_SelectedIndexChanged">

                        </dxg:LookUpEdit>
                        <TextBlock Grid.Column="3" FontWeight="DemiBold" Margin="5,5,5,5" Grid.Row="0" HorizontalAlignment="Center" Text="Company " VerticalAlignment="Center"/>
                        <dxg:LookUpEdit x:Name="cmbxCompany"  Grid.Column="4"
                                    Margin="5,5,5,5"
                                        Grid.Row="0"
                                        ToolTip="Company"
                                         Cursor="Hand"
                                    AutoPopulateColumns="True" 
                                    DisplayMember="CompanyName"
                                    IsTextEditable="False"
                                            SelectedIndexChanged="CmbxCompany_SelectedIndexChanged"/>
                        <TextBlock Grid.Column="3" Grid.Row="1" Margin="5,5,5,5" FontWeight="DemiBold" HorizontalAlignment="Center" Text="Department " VerticalAlignment="Center"/>

                        <dxg:LookUpEdit x:Name="lookupDepartment"
                          Grid.Column="4"
                                        Margin="5,5,5,5"
                                        Grid.Row="1"
                                        ToolTip="Department"
                                        Cursor="Hand"
                          TabIndex="6"
                          VerticalAlignment="Center"
                          AutoPopulateColumns="True"
                          DisplayMember="DeptName"
                          GotFocus="lookupDepartment_GotFocus"
                          SelectedIndexChanged="lookupDepartment_SelectedIndexChanged">
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Button x:Name="btnAddDepartment"
                          Click="btnAddDepartment_Click"
                          VerticalAlignment="Center"
                          Content="--Add New--" />
                                        <dxg:GridControl Name="PART_GridControl"
                                   AutoPopulateColumns="True"
                                   Grid.Row="1">
                                            <dxg:GridControl.View>
                                                <dxg:TreeListView Name="treeListView1"
                                        ShowAutoFilterRow="True"
                                        TreeDerivationMode="Selfreference"
                                        KeyFieldName="Id"
                                        ParentFieldName="ParentID" />
                                            </dxg:GridControl.View>
                                            <dxg:GridColumn FieldName="Id"
                                    x:Name="coldeptid"
                                    IsSmart="True"
                                    Visible="False" />
                                            <dxg:GridColumn x:Name="coldeptname"
                                    FieldName="DeptName"
                                    IsSmart="True" />
                                            <dxg:GridColumn x:Name="coldeptcode"
                                    FieldName="Code"
                                    IsSmart="True" />
                                            <dxg:GridColumn FieldName="Abbrivation"
                                    IsSmart="True"
                                    x:Name="coldeptabr"
                                    Visible="True" />
                                            <dxg:GridColumn FieldName="Timestamp"
                                    IsSmart="True"
                                    x:Name="coldeptts"
                                    Visible="False" />
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>



                        <TextBlock Grid.Column="3" Grid.Row="2" Margin="5,5,5,5" FontWeight="DemiBold" HorizontalAlignment="Center" Text="Employee " VerticalAlignment="Center"/>
                        <dxg:LookUpEdit x:Name="cmbxEmpId" Grid.Row="2" Grid.Column="4"
                                        SelectedIndexChanged="CmbxEmpId_SelectedIndexChanged"
                                 Margin="5,5,5,5"
                                        ToolTip="Employee"
                                        Cursor="Hand"
                                  DisplayMember="person.FName"
                                            IsTextEditable="False"
                                        GotFocus="CmbxEmpId_GotFocus"
                                            >
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>

                                        <dxg:GridControl Name="PART_GridControl"
                                                             AutoPopulateColumns="True"
                                                             Grid.Row="1">
                                            <dxg:GridControl.View>
                                                <dxg:TableView AllowPerPixelScrolling="True" 
                                                               ShowTotalSummary="True"
                                                               ShowAutoFilterRow="True" 
                                                               RowAnimationKind="None" 
                                                                WaitIndicatorType="Panel"
                                                                AllowEditing="False"
                                                                ShowCheckBoxSelectorInGroupRow="True"
                                                    Name="tblViewLandTypeLst"/>
                                            </dxg:GridControl.View>

                                            <dxg:GridColumn Header="EmpId"
                                                            FieldName="EmpId"
                                                            IsSmart="True"
                                                            Width="auto" VisibleIndex="1"/>
                                            <dxg:GridColumn Header="First Name"
                                                            FieldName="person.FName"
                                                            IsSmart="True"
                                                            Width="auto" VisibleIndex="2"/>
                                            <dxg:GridColumn Header="Last Name"
                                                            FieldName="person.LName"
                                                            IsSmart="True"
                                                            Width="auto" VisibleIndex="3"/>
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>

                    </Grid>
                </dxlc:GroupBox>
                <Grid Grid.Column="1"   Grid.Row="1" DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:JournalEntries}, Mode=FindAncestor}}">
                    <dxg:GridControl x:Name="grdJournalEntry"
                         SelectionMode="Cell"              
                          Margin="3,3,3,3"
                          ItemsSource="transactions"
                          CustomUnboundColumnData="GrdJournalEntry_CustomUnboundColumnData"           
                         dx:DXSerializer.SerializationID="grid">
                        <dxg:GridControl.View>
                            <dxg:TableView AutoWidth="True"
                           ShowGroupPanel="False"
                           NewItemRowPosition="Bottom"
                           AllowColumnFiltering="False"
                           ShowTotalSummary="True"
                           ShowHorizontalLines="True"
                           ShowVerticalLines="True"
                                           
                           x:Name="view"      
                           >
                                <dxg:TableView.RowCellMenuCustomizations>
                                   
                                    <dxb:BarButtonItem Name="deleteRowItema"
                                   Content="Delete"
                                   Glyph="{dx:DXImage Image=Delete_32x32.png}"
                                   Command="{x:Static dxg:GridCommands.DeleteFocusedRow}" />
                                </dxg:TableView.RowCellMenuCustomizations>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="transactionRefno"
                          Header="Transaction Ref"
                           Validate="GridColumn_Validate"             
                          VisibleIndex="0"/>
                        <dxg:GridColumn x:Name="accountName"
                            FieldName="account"
                          Header="ACCOUNT"
                          IsSmart="True"
                          VisibleIndex="1" 
                           Validate="AccountName_Validate"           
                          UnboundType="bound"
                          UnboundExpression="[accountName]">
                            <dxg:GridColumn.DisplayTemplate>
                                <ControlTemplate>
                                    <TextBlock Text="{Binding RowData.Row.account.accountName}"></TextBlock>
                                </ControlTemplate>
                            </dxg:GridColumn.DisplayTemplate>
                            <dxg:GridColumn.EditSettings>
                                <dxg:LookUpEditSettings x:Name="lookupAccountsinGrid"
                                      AutoPopulateColumns="False"
                                                       
                                      IsPopupAutoWidth="False"           
                                      DisplayMember="accountName"
                                      NullText="Select Item">
                                    <dxg:LookUpEditSettings.PopupContentTemplate>
                                        <ControlTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"></RowDefinition>
                                                    <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                                </Grid.RowDefinitions>
                                                <Button x:Name="btnAddItem"
                              Click="btnAddItem_Click"
                              VerticalAlignment="Center"
                              Content="--Add New--" />
                                                <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                    <dxg:GridControl.View>
                                                        <dxg:TreeListView x:Name="grdAccountsTree"
                            KeyFieldName="Id"
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            ParentFieldName="parentId"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            Width="auto"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoExpandAllNodes="False"
                            AutoPopulateServiceColumns="True"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            ShowTotalSummary="True" 
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FilterMode="Extended"
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" />
                                                    </dxg:GridControl.View>
                                                    <dxg:GridColumn FieldName="accountName" />
                                                    <dxg:GridColumn FieldName="accountType" />
                                                </dxg:GridControl>
                                            </Grid>
                                        </ControlTemplate>
                                    </dxg:LookUpEditSettings.PopupContentTemplate>
                                </dxg:LookUpEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="memo"
                          Header="MEMO"
                          VisibleIndex="2"/>
                        <dxg:GridColumn FieldName="isAdjustment"
                          Header="isAdjustment"
                          UnboundExpression="decimal"
                          VisibleIndex="3"  >
                        </dxg:GridColumn>
                        <dxg:GridColumn x:Name="debitAmount"
                            FieldName="debit"
                          Header="DEBIT" 
                           Validate="DebitAmount_Validate"             
                                       
                          VisibleIndex="4"  >
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>



                        <dxg:GridColumn x:Name="creditAmount"
                            Validate="CreditAmount_Validate"            
                            FieldName="credit"
                          Header="CREDIT"
                          VisibleIndex="5">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="amountMER"
                          Header="Amount MER"
                           ReadOnly="True"             
                                        UnboundType="decimal"
                          VisibleIndex="6">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>


                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem x:Name="debitSummery" FieldName="debit"  SummaryType="Sum" DisplayFormat="n2"/>
                            <dxg:GridSummaryItem x:Name="creditSummery"  FieldName="credit" SummaryType="Sum" DisplayFormat="n2"/>
                            <dxg:GridSummaryItem x:Name="amountMERSummery"  FieldName="amountMER" SummaryType="Sum" DisplayFormat="n2"/>
                        </dxg:GridControl.TotalSummary>

                       

                    </dxg:GridControl>

                </Grid>
            </Grid>


        </Grid>
        <Button x:Name="btnSave" Content="Save" Height="30" Click="BtnSave_Click" ToolTip="Save" Cursor="Hand" Grid.Row="3" />
        <Grid Panel.ZIndex="5" x:Name="grdVoid" Visibility="Collapsed" 
              VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <!--<TextBox  Width="250"  VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="SearchTermTextBox" Margin="5"/>-->
            <TextBlock IsHitTestVisible="False" x:Name="txtVoid" 
                       Text="-VOID-" FontSize="200" 
                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" Foreground="Chocolate" Opacity="0.3">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTermTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.RenderTransform>

                    <RotateTransform CenterX="0" CenterY="0" Angle="-45" />

                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Grid>

</dx:DXWindow>
