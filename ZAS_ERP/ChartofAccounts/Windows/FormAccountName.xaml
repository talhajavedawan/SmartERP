<dx:DXWindow
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
    x:Class="ZAS_ERP.ChartofAccounts.Windows.formAccountName"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    Loaded="DXWindow_Loaded"
    mc:Ignorable="d"
        Title="Add new Account: Account Name"  WindowState="Normal"  WindowStartupLocation="CenterScreen"  Height="700" Width="825" >
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="b2v"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <dx:DXTabControl  
                     Grid.Row="0" Grid.RowSpan="2"   x:Name="grpbasicinfo"
                    
                    MinHeight="200"
                              Margin="0 10 0 0">


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1* "/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="6* "/>
                    <ColumnDefinition Width="auto "/>
                    <ColumnDefinition Width="6* "/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="5" Header="Basic Information">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="lblAccountType" 
               
               FontWeight="DemiBold"
               Grid.Column="0" 
               HorizontalAlignment="Right"
               VerticalAlignment="Center" 
               Content="Account type"
               Margin="20,20,20,20"/>
                        <ComboBox x:Name="cmbAccountType"
                   Grid.Row="1" 
                   Grid.Column="1"
                   Cursor="Hand"
                   HorizontalAlignment="Stretch"
                   ToolTip="Select Account Type"
                   VerticalContentAlignment="Top"
                   SelectionChanged="CmbAccountType_SelectionChanged"
                   Margin="15,15,15,15"
                      >

                        </ComboBox>
                        <Label Grid.Row="1" 
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Left"
                           HorizontalAlignment="Left"
                           FontWeight="DemiBold" 
                           Content="Account Name"
                           Margin="15,15,15,15" />
                        <dxe:TextEdit x:Name="txtAccountName" Grid.Row="1" 
                                  Grid.Column="3"
                                  
                                  ToolTip="Account Name"        
                                  Margin="15,15,15,15"
                                  NullText="Account Name" />
                    </Grid>

                </GroupBox>
                <Label x:Name="lblAccountCurrency" 
               Visibility="Collapsed" Grid.Row="1" 
               FontWeight="DemiBold" Grid.Column="1" 
               HorizontalAlignment="Left" 
               VerticalAlignment="Center"  
               Content="Account currency" 
               Margin="20,20,20,20"/>
                <dx:DXTabControl Grid.Column="0" 
                   Margin="10,10,10,10"
                        Grid.Row="2" Grid.ColumnSpan="5">
                    <dx:DXTabControl.View>
                        <dx:TabControlStretchView HeaderLocation="Top" HideButtonShowMode="NoWhere" RemoveTabItemsOnHiding="False" ShowHeaderMenu="False" DragDropMode="ReorderAndMove"/>
                    </dx:DXTabControl.View>

                    <dx:DXTabItem Header="Account Details"   Cursor="Hand" ToolTip="Account Details" >
                        <dxlc:GroupBox 
                        DisplayMode="Default"
                    Header="Chart of Account Detail"
                        Grid.ColumnSpan="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="auto"/>

                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="9*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="1" Grid.Row="1" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>


                                    <CheckBox x:Name="isTrialBalance" 
                              FontWeight="DemiBold" 
                              IsChecked="True"        
                              Content="Active for Trial Balance"
                              ToolTip="Active/InActive"        
                              Grid.Row="1" 
                              Cursor="Hand"
                              Grid.Column="3" 
                             VerticalAlignment="Center"
                           HorizontalContentAlignment="Center"
                           HorizontalAlignment="Center" 
                             
                              />


                                    <CheckBox x:Name="isActive" 
                              FontWeight="DemiBold" 
                                      
                              Content="isActive"
                              ToolTip="Active/InActive"        
                              Grid.Row="2" 
                              Cursor="Hand"
                              Grid.Column="2" 
                             VerticalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           HorizontalAlignment="Stretch" 
                              Margin="15,15,15,15"
                              />
                                    <CheckBox x:Name="isSubAccount" 
                              FontWeight="DemiBold" 
                              Content="Sub-account" 
                              ToolTip="isSubAccount"        
                              Cursor="Hand"
                                      
                              Grid.Row="2" 
                              Grid.Column="0" 
                              VerticalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                              
                              Margin="15,15,15,15"  />
                                    <dxg:LookUpEdit x:Name="cmbParentAccounts"
                    Grid.Column="1"
                                            
                                  ToolTip="Select Parent Account"
                                     Cursor="Hand"
                                    ShowNullText="True"
                                    NullText="Select Parent"
                    Grid.Row="2"
                    Visibility="{Binding IsChecked,ElementName=isSubAccount,Converter={StaticResource b2v}}"                
                    VerticalAlignment="Center"
                    SelectedIndexChanged="CmbParentAccounts_SelectedIndexChanged"
                    Margin="15,15,15,15"
                    >
                                        <dxg:LookUpEdit.PopupContentTemplate>
                                            <ControlTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"></RowDefinition>
                                                        <RowDefinition Height="*"></RowDefinition>
                                                    </Grid.RowDefinitions>

                                                    <dxg:GridControl Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                                        <dxg:GridControl.View>
                                                            <dxg:TreeListView Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                                        </dxg:GridControl.View>
                                                        <dxg:GridColumn FieldName="Account Name"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                                    </dxg:GridControl>
                                                </Grid>
                                            </ControlTemplate>
                                        </dxg:LookUpEdit.PopupContentTemplate>
                                    </dxg:LookUpEdit>

                                    <CheckBox x:Name="isCurrency"
                              Grid.Row="1" 
                              Grid.Column="0"
                                      
                                      ToolTip="isCurrency"
                              FontWeight="DemiBold" 
                              Content="Currency" 
                              Cursor="Hand"
                             VerticalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           HorizontalAlignment="Stretch" 
                              Margin="15,15,15,15"
                              />



                                    <dxg:LookUpEdit Grid.Column="1" Height="22" 
                                    Grid.Row="1"
                                            
                                    ShowNullText="True"
                                    ToolTip="Select Currency"        
                                    Visibility="{Binding IsChecked,ElementName=isCurrency,Converter={StaticResource b2v}}"                
                                    Cursor="Hand"
                                     VerticalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                                    NullText="Select Currency"
                                              IsTextEditable="False" 
                                              x:Name="cmbxCurrency"
                                     Margin="15,15,15,15"
                                            DisplayMember="CurrencyName"
                                              SelectedIndexChanged="CmbxCurrency_SelectedIndexChanged">

                                    </dxg:LookUpEdit>









                                    <!--<dxg:LookUpEdit x:Name="lookupCompany"
                          Grid.Column="1"
                          Grid.Row="1"
                          TabIndex="5"
                                    
                                    Cursor="Hand"
                                    ShowNullText="True"
                                    NullText="Select Company"
                          DisplayMember="CompanyName"
                          AutoPopulateColumns="False"
                          VerticalAlignment="Center"
                          Margin="15,15,15,15"          
                          SelectedIndexChanged="lookupCompany_SelectedIndexChanged">
                        <dxg:LookUpEdit.StyleSettings>
                            <dxg:LookUpEditStyleSettings />
                        </dxg:LookUpEdit.StyleSettings>
                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    -->
                                    <!--<Button x:Name="btnAddCompany"
                            Click="btnAddCompany_Click"
                            VerticalAlignment="Center"
                            Content="Add New" />-->
                                    <!--
                                    <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                                        <dxg:GridControl.View>
                                            <dxg:TableView Name="tableView1"
                                     ShowAutoFilterRow="True" />
                                        </dxg:GridControl.View>
                                        <dxg:GridColumn FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                    
                                        -->
                                    <!--<dxg:GridColumn FieldName="IndustryType"
                                      IsSmart="True"
                                      Visible="False" />-->
                                    <!--
                                        <dxg:GridColumn x:Name="colBizType"
                                    FieldName="BizType"
                                    Visible="False"
                                    IsSmart="True" />
                                        <dxg:GridColumn FieldName="EmployeerNo"
                                    x:Name="colEmployeerNo"
                                    IsSmart="True"
                                    Visible="False" />
                                    </dxg:GridControl>
                                </Grid>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>-->

                                </Grid>
                             
                                <dxlc:GroupBox Header="Optional"
                          FontWeight="Bold" 
                          Grid.Column="1" 
                          Grid.Row="3" 
                        
                          Grid.ColumnSpan="1">
                                    <ScrollViewer Grid.Row="0" Padding="0 0 0 0" >
                                        
                                 
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="70"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="50"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Column="0" Grid.Row="1" 
                               VerticalAlignment="Top"
                               Content="Description" 
                               Margin="5,5,5,5"/>
                                        <dxe:TextEdit x:Name="txtDescription"
                                      Grid.Column="1"
                                      Grid.Row="1" 
                                              
                                      ToolTip="Account Description"        
                                      Grid.ColumnSpan="3" 
                                      VerticalContentAlignment="Top"
                                      NullText="Description"
                                      ShowNullText="True" 
                                      VerticalScrollBarVisibility="Visible" 
                                      dx:ScrollBarExtensions.ScrollBarMode="Standard"
                                      ScrollViewer.CanContentScroll="True"
                                      TextWrapping="Wrap"  
                                      AcceptsReturn="True" 
                                      Margin="5,5,5,5" />
                                        <Label x:Name="lblBankAccountNo" Grid.Column="0" 
                               Grid.Row="2" 
                               VerticalAlignment="Top"
                               Content="Bank Account no." 
                               Margin="5,5,5,5"/>
                                        <dxe:TextEdit x:Name="txtBankAccountNo"
                                      Grid.Column="1" 
                                      Grid.Row="2" 
                                              
                                      Grid.ColumnSpan="3"
                                      NullText="Bank account number"
                                      VerticalContentAlignment="Center"   
                                      TextWrapping="Wrap" 
                                      AcceptsReturn="True"
                                      Margin="5,5,5,5" />
                                        <Label x:Name="lblRoutingNo"
                               Grid.Column="0" 
                               Grid.Row="3" 
                               VerticalAlignment="Top" 
                               Content="Routing no."
                               Margin="5,5,5,5"/>
                                        <dxe:TextEdit x:Name="txtAccountRoutingNo" 
                                      Grid.Column="1" 
                                      Grid.Row="3" 
                                              
                                      Grid.ColumnSpan="3"  
                                      NullText="Routing number" 
                                     VerticalContentAlignment="Center"   
                                      TextWrapping="Wrap" 
                                      AcceptsReturn="True"
                                      Margin="5,5,5,5"/>
                                        <Label x:Name="lblCreditCardNo"
                            Grid.Column="0" 
                               Grid.Row="4" 
                               VerticalAlignment="Top" 
                               Content="Credit Card Account no."
                               Margin="5,5,5,5"/>
                                        <dxe:TextEdit x:Name="txtCreditCardAccountNo" 
                                      Grid.Column="1" 
                                      Grid.Row="4" 
                                              
                                      Grid.ColumnSpan="3"  
                                      NullText="Credit card account number" 
                                      VerticalContentAlignment="Center"   
                                      TextWrapping="Wrap" 
                                      AcceptsReturn="True"
                                      Margin="5,5,5,5" />
                                        <Label x:Name="lblAccountNo" Grid.Column="0" 
                               Grid.Row="5" 
                               VerticalAlignment="Top"
                               Content="Account no." 
                               Margin="5,5,5,5"/>
                                        <dxe:TextEdit x:Name="txtAccountNo"
                                      Grid.Column="1" 
                                      Grid.Row="5" 
                                      Grid.ColumnSpan="3"
                                              
                                      NullText="Account number"
                                      VerticalContentAlignment="Center"   
                                      TextWrapping="Wrap" 
                                      AcceptsReturn="True"
                                      Margin="5,5,5,5" />

                                            <Label x:Name="lblAssociatedCompany" Grid.Column="0" 
                               Grid.Row="6" 
                               VerticalAlignment="Top"
                               Content="Associated Company" 
                               Margin="5,5,5,5"/>

                                            <dxg:LookUpEdit x:Name="lookupAssociatedCompany"
                          Grid.Column="1" 
                                      Grid.Row="6" 
                                      Grid.ColumnSpan="3"
                          TabIndex="5"
                          DisplayMember="CompanyName"
                          AutoPopulateColumns="False"
                          VerticalAlignment="Center"
                          >
                                                <dxg:LookUpEdit.StyleSettings>
                                                    <dxg:LookUpEditStyleSettings />
                                                </dxg:LookUpEdit.StyleSettings>
                                                <dxg:LookUpEdit.PopupContentTemplate>
                                                    <ControlTemplate>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto"></RowDefinition>
                                                                <RowDefinition Height="*"></RowDefinition>
                                                            </Grid.RowDefinitions>
                                                            <!--<Button x:Name="btnAddCompany"
                            Click="btnAddCompany_Click"
                            VerticalAlignment="Center"
                            Content="Add New" />-->
                                                            <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                                                                <dxg:GridControl.View>
                                                                    <dxg:TableView Name="tableView1"
                                     ShowAutoFilterRow="True" />
                                                                </dxg:GridControl.View>
                                                                <dxg:GridColumn FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                                                <dxg:GridColumn FieldName="CompanyName"
                                    IsSmart="True" />
                                                                <!--<dxg:GridColumn FieldName="IndustryType"
                                      IsSmart="True"
                                      Visible="False" />-->
                                                                <dxg:GridColumn x:Name="colBizType"
                                    FieldName="BizType"
                                    Visible="False"
                                    IsSmart="True" />
                                                                <dxg:GridColumn FieldName="EmployeerNo"
                                    x:Name="colEmployeerNo"
                                    IsSmart="True"
                                    Visible="False" />
                                                                <!--<dxg:GridColumn FieldName="addressId"
                                      x:Name="coladressId"
                                      IsSmart="True"
                                      Visible="False" />
                      <dxg:GridColumn FieldName="address"
                                      IsSmart="True"
                                      x:Name="coladress"
                                      Visible="False" />
                      <dxg:GridColumn FieldName="contactId"
                                      Visible="False"
                                      x:Name="colcontactId"
                                      IsSmart="True" />-->
                                                                <!--<dxg:GridColumn FieldName="contact"
                                      x:Name="colcontact"
                                      IsSmart="True"
                                      Visible="False" />-->
                                                            </dxg:GridControl>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </dxg:LookUpEdit.PopupContentTemplate>
                                            </dxg:LookUpEdit>



                                            <StackPanel Grid.Column="1" 
                                    Grid.ColumnSpan="4" 
                                    Visibility="Collapsed"
                                    Orientation="Horizontal"
                                    Grid.Row="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Button x:Name="btnOpeningBalance" 
                                        Grid.Column="0"  
                                        Grid.Row="0"
                                        Content="Enter Opening Balance" 
                                        Margin="5,0,5,0"
                                        Click="BtnOpeningBalance_Click"/>
                                                <dxe:TextEdit  x:Name="txtOpeningBalance" 
                                               Grid.Column="1" 
                                               Grid.Row="0" 
                                               Width="110"  
                                               IsReadOnly="True" 
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Center" 
                                               MaskUseAsDisplayFormat="True"  
                                               Mask="n2" 
                                               TextWrapping="Wrap" 
                                               AcceptsReturn="True" 
                                               Margin="10,0,0,0" 
                                               MaskType="Numeric" 
                                               NullText="0.00"  />
                                                <Label x:Name="lblAsof" 
                                    Content="as of"  
                                       Grid.Column="2" 
                                       Grid.Row="0" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="20,0,0,0" />
                                                <Label x:Name="lblOpeningDate"
                                       Grid.Column="3"
                                       Grid.Row="0" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" 
                                       Margin="20,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    </ScrollViewer>
                                </dxlc:GroupBox>
                            </Grid>
                        </dxlc:GroupBox>
                    </dx:DXTabItem>
                    <dx:DXTabItem Header="Companies"  ToolTip="Companies"  Cursor="Hand" >
                        <dxlc:GroupBox 
                               DisplayMode="Default"
                        Margin="10,10,10,10"
                        Padding="5">
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="25" FontWeight="DemiBold" Background="Beige" Text="All Companies" />
                                <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="25" FontWeight="DemiBold" Background="Beige" Grid.Column="2" Text="Selected Companies" />
                                <dxg:GridControl x:Name="grdCompany"
                                     Margin="15,15,15,15" 
                                     Grid.Column="0"
                                     SelectionChanged="GrdCompany_SelectionChanged"
                                     Grid.Row="2"
                                     SelectionMode="Row"
                                     AllowInitiallyFocusedRow="False"
                                     >
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView x:Name="viewTable"
                               AutoWidth="True"
                                  KeyFieldName="Id"
                                                  ParentFieldName="ParentID"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">

                                        </dxg:TreeListView>

                                    </dxg:GridControl.View>
                                    <dxg:GridColumn Header="Id"
                            VisibleIndex="0"
                            FieldName="Id"
                          Visible="False"
                            Width="auto" />
                                    <dxg:GridColumn Header="Company Name"
                            VisibleIndex="1"
                            FieldName="CompanyName"
                            IsSmart="True"
                            />

                                    <dxg:GridColumn VisibleIndex="2" Header="Industry Type" FieldName="industryType.name"
                                IsSmart="True" />
                                </dxg:GridControl>
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <dx:SimpleButton x:Name="btnSelectCompany"  Grid.Row="0"  VerticalAlignment="Bottom" Margin="5,5,5,5" Glyph="{dx:DXImage SvgImages/Icon Builder/Actions_Arrow4Right.svg}" Click="btnSelectCompany_Click" />
                                    <dx:SimpleButton x:Name="btnUnSelectCompany"  Grid.Row="1" Margin="5,5,5,5" VerticalAlignment="Top" Glyph="{dx:DXImage SvgImages/Icon Builder/Actions_Arrow1Left.svg}" Click="btnUnSelectCompany_Click"/>
                                </Grid>
                                <dxg:GridControl x:Name="grdFinalCompanies"
                                     Margin="15,15,15,15" 
                                     Grid.Column="2"
                                     Grid.Row="2"
                                     SelectionMode="Row"
                                     AllowInitiallyFocusedRow="False"
                                     >
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView x:Name="FinalCompanyView"
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">
                                        </dxg:TreeListView>
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn Header="Id"
                            VisibleIndex="0"
                            FieldName="Id"
                          Visible="False"
                            Width="auto" />
                                    <dxg:GridColumn Header="Company Name"
                            VisibleIndex="1"
                            FieldName="CompanyName"
                            IsSmart="True"
                            />

                                    <dxg:GridColumn VisibleIndex="2" Header="Industry Type" FieldName="industryType.name"
                                IsSmart="True" />
                                </dxg:GridControl>


                            </Grid>
                        </dxlc:GroupBox>

                    </dx:DXTabItem>
                    <dx:DXTabItem Header="Departments"  ToolTip="Departments"  Cursor="Hand">
                        <dxlc:GroupBox  DisplayMode="Default"
                        Margin="10,10,10,10"
                        Padding="5">


                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="25" FontWeight="DemiBold" Background="Beige" Text="All Departments" />
                                <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="25" FontWeight="DemiBold" Background="Beige" Grid.Column="2" Text="Selected Departments" />
                                <dxg:GridControl x:Name="grdDepartment"
                                     Margin="15,15,15,15" 
                                     Grid.Column="0"
                                     SelectionChanged="GrdDepartment_SelectionChanged"
                                     Grid.Row="2"
                                     SelectionMode="Row"
                                     AllowInitiallyFocusedRow="False"
                                     Visibility="{Binding IsChecked,ElementName=isDepartment,Converter={StaticResource b2v}}">
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView x:Name="viewTableDepartment"
                               AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"            
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">

                                        </dxg:TreeListView>

                                    </dxg:GridControl.View>
                                    <dxg:GridColumn Header="Id"
                            VisibleIndex="2"
                            FieldName="Id"
                            IsSmart="True"
                                            Visible="False"
                           />
                                    <dxg:GridColumn Header="Department Name"
                            VisibleIndex="1"
                            FieldName="DeptName"
                            IsSmart="True"
