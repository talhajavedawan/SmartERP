<dx:DXWindow
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.ChartofAccounts.Windows.GernalJournal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    mc:Ignorable="d"
        Title="GernalJournal" Height="450" Width="800" Loaded="DXWindow_Loaded">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
   

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblHeading" Text="General Journal" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" FontFamily="Segoe UI Semibold" Margin="311,0,310,-1.2"  />
        </Grid>

        <dxg:GridControl x:Name="grdListEntries"
                    Margin="5,5,5,5"
                         Grid.Row="2"
                         SelectionMode="Row" 
                         ShowBorder="True"
                         MouseDoubleClick="GrdListEntries_MouseDoubleClick"                         
                         dx:DXSerializer.SerializationID="grid">
            <dxg:GridControl.View>
                <dxg:TreeListView AutoWidth="True"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       ShowAutoFilterRow="True"
                       Width="auto" 
                             
                               HorizontalScrollbarVisibility="Visible"
                               ShowHorizontalLines="True"
                           ShowVerticalLines="True"
                               
                       FilterRowDelay="1000"      
                       RowAnimationKind="Opacity" WaitIndicatorType="Panel"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       ShowFixedTotalSummary="True"
                       ShowTotalSummary="True"   
                           x:Name="view1" ShowFilterPanelMode="ShowAlways" >
                </dxg:TreeListView>
            </dxg:GridControl.View>

            <dxg:GridColumn FieldName="transactionRefno"
                          ReadOnly="True"
                          Image="{dx:DXImage Image=ShapeLabels_16x16.png}"
                          VisibleIndex="1"      
                            AllowSorting="false"
                          Header="Transaction Ref." />
            <dxg:GridColumn FieldName="PostingDate"
                          ReadOnly="True"
                          VisibleIndex="2" 
                            AllowSorting="false"
                                                         Image="{dx:DXImage Image=Time_16x16.png}"
                           Header="GL-Posting Date" AllowColumnFiltering="Default" FilterPopupMode="DateAlt" AutoFilterCondition="Contains" />

            <dxg:GridColumn FieldName="chartofAccount.accountName"
                        ReadOnly="True"
                        VisibleIndex="3"
                            AllowSorting="false"
                               Image="{dx:DXImage Image=Accounting_16x16.png}"
                        Header="Account" >
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="chartofAccount.accountType"
                        ReadOnly="True"
                        Image="{dx:DXImage Image=ShapeLabels_16x16.png}"
                        VisibleIndex="4"       
                            AllowSorting="false"
                        Header="Account Type" >
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="company.CompanyName"
                        ReadOnly="True"
                        VisibleIndex="5" 
                        Visible="True"
                        Image="{dx:DXImage Image=Home_16x16.png}"   
                        Header="Company" >
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="department.DeptName"
                          ReadOnly="True"
                        VisibleIndex="6" 
                        Visible="True"
                        Image="{dx:DXImage Image=BODepartment_16x16.png}"
                        Header="Department" >
            </dxg:GridColumn>
            <dxg:GridColumn 
                        FieldName="memo" 
                        ReadOnly="True" 
                        Header="Memo" 
                Visible="False"
                AllowSorting="false"
                        VisibleIndex="7" 
                />
            <dxg:GridColumn 
                FieldName="debitPKR"
                UnboundType="Decimal" 
                AllowSorting="false"
                          ReadOnly="True"
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          VisibleIndex="8"   
                          Header="Debit (PKR)" UnboundExpression="[debit] * [MER]" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="creditPKR"
                          ReadOnly="True" 
                            UnboundType="Decimal"
                            AllowSorting="false"
                          VisibleIndex="9"                                           
         Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Credit (PKR)" UnboundExpression="[credit] * [MER]" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="MER"
                          ReadOnly="True"
                            AllowSorting="false"
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Visible="True"  
                          VisibleIndex="10"
                          Header="MER">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="balancePKR"
                          ReadOnly="True"
                            AllowSorting="false"
                            Visible="False"
                            UnboundType="Decimal"
                          VisibleIndex="11"
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Balance (PKR)" UnboundExpression="[total] * [MER]" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn 
                        FieldName="currency.CurrencyName" 
                        ReadOnly="True"         
                        AllowSorting="false"
                        Header="OC"
                        Image="{dx:DXImage Image=Currency2_16x16.png}"
                        VisibleIndex="12" 
                />
            <dxg:GridColumn FieldName="debit"
                          ReadOnly="True"
                          Visible="True"  
                            AllowSorting="false"
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          VisibleIndex="13"
                          Header="Debit(OC)">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="credit"
                          ReadOnly="True"
                          Visible="True"  
                            AllowSorting="false"
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          VisibleIndex="14"
                          Header="Credit(OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="balanceOC"
                          ReadOnly="True"
                            Visible="False"
                          VisibleIndex="15"                                                          AllowSorting="False"
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Balance(OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridControl.TotalSummary >
                <!--<dxg:GridSummaryItem x:Name="sumTotalDebitPKR" FieldName="debitPKR"  SummaryType="Sum"   DisplayFormat="{}{0:n2}" />-->
                <!--<dxg:GridSummaryItem FieldName="creditPKR" SummaryType="Sum" DisplayFormat="{}{0:n2}" />-->
                <!--<dxg:GridSummaryItem FieldName="balanceOC" SummaryType="Sum" DisplayFormat="{}{0:n2}"  />-->
                <!--<dxg:GridSummaryItem FieldName="debit" SummaryType="Sum" DisplayFormat="{}{0:n2}" />-->
                <!--<dxg:GridSummaryItem FieldName="credit" SummaryType="Sum" DisplayFormat="{}{0:n2}" />-->
                <!--<dxg:GridSummaryItem FieldName="balancePKR" SummaryType="Sum" DisplayFormat="{}{0:n2}" />-->
            </dxg:GridControl.TotalSummary>
        </dxg:GridControl>

    </Grid>
</dx:DXWindow>
