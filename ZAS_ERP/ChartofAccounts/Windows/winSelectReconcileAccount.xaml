<dx:DXWindow xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" 
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.ChartofAccounts.Windows.winSelectReconcileAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d"
        Title="Begin Reconcilation"  Height="420" Width="800" MaxHeight="420" MaxWidth="800" MinWidth="800" MinHeight="420" Loaded="DXWindow_Loaded" WindowStartupLocation="CenterScreen" >
    <Grid>
        <dxlc:GroupBox Header="Select an account to reconcile, and then enter the ending balance from your account statement">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="1" Grid.Column="1"
            Text="Account"  HorizontalAlignment="Left" VerticalAlignment="Center" />
                <dxg:LookUpEdit x:Name="lookupReconcileAccounts"
                                Grid.Row="1"
                                MinWidth="20"
                    Grid.Column="3"       
                                  ToolTip="Select Account"
                                     Cursor="Hand"
                                    ShowNullText="True"
                                    SelectedIndexChanged="LookupReconcileAccounts_SelectedIndexChanged"
                                    NullText="Select Account"
                    VerticalAlignment="Center"
                    DisplayMember="accountName"
                    
                    >
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>

                                <dxg:GridControl Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="Account Name"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                </dxg:GridControl>
                            </Grid>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>

                <TextBlock Grid.Row="3" Grid.Column="1"
            Text="Statement Date"  HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Statement Date" Cursor="Hand" />
                <dxe:DateEdit x:Name="dateDatePeriod" Grid.Row="3" Grid.Column="3" />

                <TextBlock Grid.Row="5" Grid.Column="1"
            Text="Beginning Balance"  HorizontalAlignment="Left" VerticalAlignment="Center" />
                <dxe:TextEdit x:Name="txtbiginningBalance" Grid.Row="5" Grid.Column="3" Text="0" IsReadOnly="True"
                              MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                <TextBlock Grid.Row="7" Grid.Column="1"
            Text="Ending Balance"  HorizontalAlignment="Left" VerticalAlignment="Center" />
                <dxe:TextEdit x:Name="txtEndingBalance" Grid.Row="7" Text="0" Grid.Column="3" 
                              MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>

                <dxlc:GroupBox Grid.Column="1" Grid.Row="9" Grid.ColumnSpan="4" IsEnabled="False"
                       Header="Enter any service charge or interest earned"
                       >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            

                            <ColumnDefinition Width="5"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="auto"/>


                            <RowDefinition Height="5"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   HorizontalAlignment="Center"
                    Text="Service Charge"/>
                        <dxe:TextEdit x:Name="txtServiceCharge" Grid.Row="3" Grid.Column="1"
                                      MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center"
                    Text="Date"/>
                        <dxe:DateEdit x:Name="datService" Grid.Row="3" Grid.Column="3" />

                        <TextBlock Grid.Row="1" Grid.Column="5"
                                   HorizontalAlignment="Center"
                    Text="Exchange Rate"/>
                        <dxe:TextEdit x:Name="txtServiceExchange"  Grid.Row="3" Grid.Column="5"
                                      MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="7" HorizontalAlignment="Center"
                    Text="Account"/>
                        
                        <dxg:LookUpEdit x:Name="lookupServiceAccounts"
                                Grid.Row="3"
                                Grid.Column="7"            
                                  ToolTip="Select Account"
                                     Cursor="Hand"
                                    ShowNullText="True"
                                    NullText="Select Account"
                                        DisplayMember="accountName"
                                        SelectedIndexChanged="LookupServiceAccounts_SelectedIndexChanged"
                    VerticalAlignment="Center"
                    >
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>

                                        <dxg:GridControl Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                            <dxg:GridControl.View>
                                                <dxg:TreeListView Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                            </dxg:GridControl.View>
                                            <dxg:GridColumn FieldName="Account Name"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>
                       
                        <TextBlock Grid.Row="1" Grid.Column="9"
                                   HorizontalAlignment="Center"
                    Text="Department"/>
                        <dxg:LookUpEdit x:Name="lookupServiceDepartment"
                          Grid.Column="9"
                                        Cursor="Hand"
                                        ToolTip="Departments"
                                        ShowNullText="True"
                                        SelectedIndexChanged="LookupServiceDepartment_SelectedIndexChanged"
                                    NullText="Select Department"
                          Grid.Row="3"
                          VerticalAlignment="Center"
                          AutoPopulateColumns="True"
                          DisplayMember="DeptName"
                          >
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <dxg:GridControl Name="PART_GridControl"
                                   AutoPopulateColumns="True"
                                   Grid.Row="1">
                                            <dxg:GridControl.View>
                                                <dxg:TreeListView Name="treeListView1"
                                        ShowAutoFilterRow="True"
                                        TreeDerivationMode="Selfreference"
                                        KeyFieldName="Id"
                                        ParentFieldName="ParentID" />
                                            </dxg:GridControl.View>
                                            <dxg:GridColumn FieldName="Id"
                                    x:Name="coldeptid"
                                    IsSmart="True"
                                    Visible="False" />
                                            <dxg:GridColumn x:Name="coldeptname"
                                    FieldName="DeptName"
                                    IsSmart="True" />
                                            <dxg:GridColumn x:Name="coldeptcode"
                                    FieldName="Code"
                                    IsSmart="True" />
                                            <dxg:GridColumn FieldName="Abbrivation"
                                    IsSmart="True"
                                    x:Name="coldeptabr"
                                    Visible="True" />
                                            <dxg:GridColumn FieldName="Timestamp"
                                    IsSmart="True"
                                    x:Name="coldeptts"
                                    Visible="False" />
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>

                        
                        <TextBlock Grid.Row="5" Grid.Column="1"
                                   HorizontalAlignment="Center"
                    Text="Interest Earned"/>
                        <dxe:TextEdit x:Name="txtInterestEarned" Grid.Row="7" Grid.Column="1"
                                      MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>

                        <TextBlock Grid.Row="5" Grid.Column="3" HorizontalAlignment="Center"
                    Text="Date"/>
                        <dxe:DateEdit x:Name="datInterestDate" Grid.Row="7" Grid.Column="3" />

                        <TextBlock Grid.Row="5" Grid.Column="5"
                                   HorizontalAlignment="Center"
                    Text="Exchange Rate"/>
                        <dxe:TextEdit x:Name="txtInterestExchange" Grid.Row="7" Grid.Column="5" 
                                      MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>

                        <TextBlock Grid.Row="5" Grid.Column="7" HorizontalAlignment="Center"
                    Text="Account"/>

                        <dxg:LookUpEdit x:Name="lookupInterestAccounts"
                                Grid.Row="7"
                    Grid.Column="7"
                                            
                                  ToolTip="Select Account"
                                     Cursor="Hand"
                                    ShowNullText="True"
                                        SelectedIndexChanged="LookupInterestAccounts_SelectedIndexChanged"
                                    NullText="Select Account"
                    DisplayMember="accountName"
                    VerticalAlignment="Center"
                    
                    >
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>

                                        <dxg:GridControl Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                            <dxg:GridControl.View>
                                                <dxg:TreeListView Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                            </dxg:GridControl.View>
                                            <dxg:GridColumn FieldName="Account Name"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>

                        <TextBlock Grid.Row="5" Grid.Column="9"
                                   HorizontalAlignment="Center"
                    Text="Department"/>
                        <dxg:LookUpEdit x:Name="lookupInterestDepartment"
                          Grid.Column="9"
                          Grid.Row="7"
                          Cursor="Hand"
                                        ShowNullText="True"
                                    NullText="Select Department"
                                        ToolTip="Departments"
                                        SelectedIndexChanged="LookupInterestDepartment_SelectedIndexChanged"
                          VerticalAlignment="Center"
                          AutoPopulateColumns="True"
                          DisplayMember="DeptName"
                          >
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        
                                        <dxg:GridControl Name="PART_GridControl"
                                   AutoPopulateColumns="True"
                                   Grid.Row="1">
                                            <dxg:GridControl.View>
                                                <dxg:TreeListView Name="treeListView1"
                                        ShowAutoFilterRow="True"
                                        TreeDerivationMode="Selfreference"
                                        KeyFieldName="Id"
                                        ParentFieldName="ParentID" />
                                            </dxg:GridControl.View>
                                            <dxg:GridColumn FieldName="Id"
                                    x:Name="coldeptid"
                                    IsSmart="True"
                                    Visible="False" />
                                            <dxg:GridColumn x:Name="coldeptname"
                                    FieldName="DeptName"
                                    IsSmart="True" />
                                            <dxg:GridColumn x:Name="coldeptcode"
                                    FieldName="Code"
                                    IsSmart="True" />
                                            <dxg:GridColumn FieldName="Abbrivation"
                                    IsSmart="True"
                                    x:Name="coldeptabr"
                                    Visible="True" />
                                            <dxg:GridColumn FieldName="Timestamp"
                                    IsSmart="True"
                                    x:Name="coldeptts"
                                    Visible="False" />
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>

                    </Grid>

                </dxlc:GroupBox>

                <Grid Grid.Row="11" Grid.Column="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>
                    <dx:SimpleButton  x:Name="btnContinue"
                        Grid.Column="2" Grid.Row="1"
                                                          ToolTip="Continue"
                             Cursor="Hand"
Click="BtnContinue_Click"
                    Content="Continue"/>
                    <dx:SimpleButton  x:Name="btnCancel"
                        Grid.Column="4" Grid.Row="1"
                             ToolTip="Cancel"
                             Cursor="Hand"
                             Click="BtnCancel_Click"
                    Content="Cancel"/>
                </Grid>
                
            </Grid>
        </dxlc:GroupBox>
    </Grid>

  
    
  
</dx:DXWindow>
