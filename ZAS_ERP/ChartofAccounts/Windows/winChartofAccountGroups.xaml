<dx:DXWindow x:Class="ZAS_ERP.ChartofAccounts.Windows.winChartofAccountGroups"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
        mc:Ignorable="d"
        Title="Add Chart of Account Group" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Add Chart of Account Group" TextDecorations="Underline" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="DemiBold"/>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Title" HorizontalAlignment="Left" Grid.Column="0" VerticalAlignment="Center"  FontWeight="DemiBold" Margin="5"/>
            <dxe:TextEdit x:Name="txtTitle"  Grid.Column="1"/>   
            <TextBlock Text="Reference No" HorizontalAlignment="Left" Grid.Column="2" VerticalAlignment="Center"  FontWeight="DemiBold" Margin="5"/>
            <dxe:TextEdit x:Name="txtReference"  Grid.Column="3"/>
        </Grid>



        <dx:DXTabControl Grid.Row="2">
            <!--Companies-->
            <dx:DXTabItem Header="Companies" >
                <dxlc:LayoutGroup View="GroupBox"  Orientation="Horizontal"  Header="Companies Selection">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"  Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="All Companies"  VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="DemiBold"  FontSize="12" />
                        </Grid>
                        <Grid Grid.Row="3">
                            <dxg:GridControl SelectionMode="Row"
                                             x:Name="gridAllCompany"
                                             AutoGenerateColumns="None"
                                             AllowInitiallyFocusedRow="False">

                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="viewTable"
                                    AutoWidth="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    UseIndicatorForSelection="True"                                    
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True"
                                                   ShowGroupPanel="False"
                                                   ShowSearchPanelMode="Always"/>
                                </dxg:GridControl.View>
                                <dxg:GridColumn x:Name="colId"
                                FieldName="Id"
                                IsSmart="True"
                                Visible="False" />
                                <dxg:GridColumn FieldName="CompanyName"
                                IsSmart="True" />
                                <dxg:GridColumn FieldName="IndustryType"
                                IsSmart="True" />
                                <dxg:GridColumn x:Name="colBizType"
                                FieldName="BizType"
                                Visible="False"
                                IsSmart="True" />
                                <dxg:GridColumn FieldName="EmployeerNo"
                                x:Name="colEmployeerNo"
                                IsSmart="True"
                                Visible="False" />
                            </dxg:GridControl>
                        </Grid>
                        <Grid Grid.Row="3" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Image Source="/ZAS_ERP;component/images/Forward_32x32.png" Grid.Row="1"  Height="32" Width="32"   x:Name="imgLeftToRightComp" MouseDown="ImgLeftToRightComp_MouseDown" MouseUp="ImgLeftToRightComp_MouseUp" Margin="10,0,10,0"/>

                            <Image Source="/ZAS_ERP;component/images/Backward_32x32.png" Grid.Row="2" Height="32" Width="32"   x:Name="imgRightToLeftComp" MouseDown="ImgRightToLeftComp_MouseDown" MouseUp="ImgRightToLeftComp_MouseUp"  Margin="10,0,10,0" />
                        </Grid>

                        <Grid Grid.Row="0"   Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Selected Companies" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="DemiBold"  FontSize="12" />


                        </Grid>
                        <Grid Grid.Row="3" Grid.Column="2">
                            <dxg:GridControl SelectionMode="Row"
                                             x:Name="gridSelectedCompanies"
                                             AutoGenerateColumns="None"
                                             AllowInitiallyFocusedRow="False"
                                             Grid.Row="1"
                                             >

                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="viewSelectedCompanies"
                                    AutoWidth="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    UseIndicatorForSelection="True"                                    
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True"
                                                   ShowGroupPanel="False"
                                                   ShowSearchPanelMode="Always"/>
                                </dxg:GridControl.View>
                                <dxg:GridColumn
                                FieldName="Id"
                                IsSmart="True"
                                Visible="False" />
                                <dxg:GridColumn FieldName="CompanyName"
                                IsSmart="True" />
                                <dxg:GridColumn FieldName="IndustryType"
                                IsSmart="True" />
                                <dxg:GridColumn
                                FieldName="BizType"
                                Visible="False"
                                IsSmart="True" />
                                <dxg:GridColumn FieldName="EmployeerNo"
                                IsSmart="True"
                                Visible="False" />
                            </dxg:GridControl>
                        </Grid>


                    </Grid>
                </dxlc:LayoutGroup>
            </dx:DXTabItem>

            <!--Departments-->
            <dx:DXTabItem Header="Departments"
                              ToolTip="Select All Departments in which Employee is working currently"
                              TabIndex="9"
                              Name="tabComp">
                <dxlc:LayoutGroup View="GroupBox"  
                           Header="Departments Selection">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"  Grid.Column="0">
                            <TextBlock  Text="All Departments" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="DemiBold"  FontSize="12"/>

                        </Grid>

                        <Grid Grid.Row="0"   Grid.Column="2">
                            <TextBlock  Text="Selected Department" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="DemiBold"  FontSize="12"/>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Image Source="/ZAS_ERP;component/images/Forward_32x32.png" Grid.Row="1"  x:Name="imgLeftToRightDept" MouseDown="ImgLeftToRightDept_MouseDown" Width="32" Height="32"  MouseUp="ImgLeftToRightDept_MouseUp" Margin="10,0,10,0"/>
                            <Image Source="/ZAS_ERP;component/images/Backward_32x32.png" MouseDown="ImgRightToLeftDept_MouseDown" MouseUp="ImgRightToLeftDept_MouseUp"  Grid.Row="2" Name="imgRightToLeftDept"  Height="32" Width="32"  Margin="10,0,10,0"/>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="2">
                            <dxg:GridControl x:Name="gridSelectedDepartments"
                               AutoGenerateColumns="None"
                               AllowInitiallyFocusedRow="False"
                              
                               SelectionMode="Row">

                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="griddeptviewSelected"
                                    AutoWidth="True"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID"
                                    TreeDerivationMode="Selfreference"
                                    AutoExpandAllNodes="True"
                                    UseIndicatorForSelection="True"
                                    ShowSearchPanelMode="Always"
                                    IsSynchronizedWithCurrentItem="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True">

                                    </dxg:TreeListView>
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="Id"
                              
                                IsSmart="True"
                                Visible="False" />
                                <dxg:GridColumn 
                                FieldName="DeptName"
                                IsSmart="True" />
                                <dxg:GridColumn 
                                FieldName="Code"
                                IsSmart="True" />
                                <dxg:GridColumn FieldName="Abbrivation"
                                IsSmart="True"
                                
                                Visible="False" />
                                <dxg:GridColumn FieldName="Timestamp"
                                IsSmart="True"
                                
                                Visible="False" />
                                <dxg:GridColumn FieldName="sectionId"
                                IsSmart="True"
                                Visible="False" />
                                <dxg:GridColumn FieldName="sections"
                                IsSmart="True"
                                Visible="False" />
                            </dxg:GridControl>
                        </Grid>



                        <Grid Grid.Row="3">
                            <dxg:GridControl x:Name="gridAllDepartment"
                               AutoGenerateColumns="None"
                               AllowInitiallyFocusedRow="False"
                              
                               SelectionMode="Row">

                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="griddeptview"
                                    AutoWidth="True"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID"
                                    TreeDerivationMode="Selfreference"
                                    AutoExpandAllNodes="True"
                                    UseIndicatorForSelection="True"
                                   ShowSearchPanelMode="Always"
                                    IsSynchronizedWithCurrentItem="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True">

                                    </dxg:TreeListView>
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="Id"
                                x:Name="coldeptid"
                                IsSmart="True"
                                Visible="False" />
                                <dxg:GridColumn x:Name="coldeptname"
                                FieldName="DeptName"
                                IsSmart="True" />
                                <dxg:GridColumn x:Name="coldeptcode"
                                FieldName="Code"
                                IsSmart="True" />
                                <dxg:GridColumn FieldName="Abbrivation"
                                IsSmart="True"
                                x:Name="coldeptabr"
                                Visible="False" />
                                <dxg:GridColumn FieldName="Timestamp"
                                IsSmart="True"
                                x:Name="coldeptts"
                                Visible="False" />
                                <dxg:GridColumn FieldName="sectionId"
                                IsSmart="True"
                                Visible="False" />
                                <dxg:GridColumn FieldName="sections"
                                IsSmart="True"
                                Visible="False" />
                            </dxg:GridControl>
                        </Grid>



                    </Grid>
                </dxlc:LayoutGroup>
            </dx:DXTabItem>
            <!--Employees-->
            <dx:DXTabItem Header="Employees"
                              TabIndex="9"
                              Name="tabEmployees">
                <dxlc:LayoutGroup View="GroupBox"  
                           Header="Employees Selection">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"  Grid.Column="0">
                            <TextBlock  Text="All Employees" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="DemiBold"  FontSize="12"/>

                        </Grid>

                        <Grid Grid.Row="0"   Grid.Column="2">
                            <TextBlock  Text="Selected Employees" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="DemiBold"  FontSize="12"/>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Image Source="/ZAS_ERP;component/images/Forward_32x32.png" Grid.Row="1"  x:Name="imgLeftToRightEmp" MouseDown="imgLeftToRightEmp_MouseDown" Width="32" Height="32"  MouseUp="imgLeftToRightEmp_MouseUp" Margin="10,0,10,0"/>
                            <Image Source="/ZAS_ERP;component/images/Backward_32x32.png" MouseDown="imgRightToLeftEmp_MouseDown" MouseUp="imgRightToLeftEmp_MouseUp"  Grid.Row="2" Name="imgRightToLeftEmp"  Height="32" Width="32"  Margin="10,0,10,0"/>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="2">
                            <dxg:GridControl x:Name="gridSelectedEmployee"
                               AutoGenerateColumns="None"
                               AllowInitiallyFocusedRow="False"
                              
                               SelectionMode="Row">

                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="gridemployeeviewSelected"
                                    AutoWidth="True"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID"
                                    TreeDerivationMode="Selfreference"
                                    AutoExpandAllNodes="True"
                                    UseIndicatorForSelection="True"
                                    ShowSearchPanelMode="Always"
                                    IsSynchronizedWithCurrentItem="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True">

                                    </dxg:TreeListView>
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="person.FName"
                                             VisibleIndex="1"
                                                    Header="First Name"/>
                                <dxg:GridColumn FieldName="person.LName"
                                                    Header="Last Name"   VisibleIndex="2"/>
                                <dxg:GridColumn FieldName="empFunction.Title"
                                            VisibleIndex="3"
                                                    Header="Function"/>

                            </dxg:GridControl>
                        </Grid>



                        <Grid Grid.Row="3">
                            <dxg:GridControl x:Name="gridAllEmployee"
                               AutoGenerateColumns="None"
                               AllowInitiallyFocusedRow="False"
                              
                               SelectionMode="Row">

                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="gridemployeeview"
                                    AutoWidth="True"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID"
                                    TreeDerivationMode="Selfreference"
                                    AutoExpandAllNodes="True"
                                    UseIndicatorForSelection="True"
                                   ShowSearchPanelMode="Always"
                                    IsSynchronizedWithCurrentItem="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True">

                                    </dxg:TreeListView>
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="person.FName"
                                             VisibleIndex="1"
                                                    Header="First Name"/>
                                <dxg:GridColumn FieldName="person.LName"
                                                    Header="Last Name"   VisibleIndex="2"/>
                                <dxg:GridColumn FieldName="empFunction.Title"
                                            VisibleIndex="3"
                                                    Header="Function"/>
                            </dxg:GridControl>
                        </Grid>



                    </Grid>
                </dxlc:LayoutGroup>
            </dx:DXTabItem>
