<dx:DXWindow
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:Databases="clr-namespace:ERP_BL.Databases;assembly=ERP_BL" x:Class="ZAS_ERP.ChartofAccounts.Windows.winProfitandLoss"
        mc:Ignorable="d"
        Title="Profit and Loss"  Height="450" Width="800" Loaded="Window_Loaded" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <dx:DXWindow.Resources>
        <dx:EntitySimpleDataSource x:Key="EntitySimpleDataSource" ContextType="{x:Type Databases:DBContextERP}" Path="Companies">
            <dx:DesignDataManager.DesignData>
                <dx:DesignDataSettings RowCount="5"/>
            </dx:DesignDataManager.DesignData>
        </dx:EntitySimpleDataSource>
    </dx:DXWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="5,5,5,5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <TextBlock Text="Company" FontWeight="DemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,5,5,5" Grid.Column="0"/>
                <dxg:LookUpEdit x:Name="mbtnAllCompanies" Grid.Column="1" Grid.ColumnSpan="3" MinWidth="110"  Margin="5,5,5,5" EditValueChanged="mbtnAllCompanies_EditValueChanged"  ItemsSource="{Binding Data, Source={StaticResource EntitySimpleDataSource}}" DisplayMember="CompanyName"  >
                    <dxg:LookUpEdit.StyleSettings>
                        <dxg:LookUpEditStyleSettings/>
                    </dxg:LookUpEdit.StyleSettings>

                </dxg:LookUpEdit>

                <dxe:TextEdit Text="From" Margin="5,5,5,5" FontWeight="DemiBold" Background="LightGreen" IsReadOnly="True" HorizontalContentAlignment="Center" Grid.Column="4"/>
                <dxe:DateEdit x:Name="dateFrom" Margin="5,5,5,5" NullText="Select Date" Grid.Column="5" FontWeight="DemiBold"   >

                </dxe:DateEdit>
                <dxe:TextEdit Grid.Column="6" Margin="5,5,5,5" FontWeight="DemiBold" Background="Orange" IsReadOnly="True" HorizontalContentAlignment="Center" Text="To"/>
                <dxe:DateEdit x:Name="dateTo" Margin="5,5,5,5" NullText="Select Date" Grid.Column="7" FontWeight="DemiBold"  >

                </dxe:DateEdit>
                <dx:SimpleButton x:Name="btnDateFilter" ToolTip="Filter by date range" Grid.Column="8" Margin="5,5,5,5" Content="Apply" Cursor="Hand" Click="BtnDateFilter_Click"  />



            </Grid>

            <TextBlock x:Name="lblHeading" 
                       Grid.Row="1"
                       Text=" Chart of Accounts Profit and Loss" 
                       FontSize="22" FontWeight="Bold"
                       FontFamily="Segoe UI Semibold"
                      HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextDecorations="Underline"
                        />
        </Grid>
        <dxg:GridControl x:Name="grdPLAccounts"
                           Grid.Row="2"
                           SelectionMode="Row"
                           CustomSummary="grdPLAccounts_CustomSummary"
                           MouseDoubleClick="GrdPLAccounts_MouseDoubleClick"
                           CustomUnboundColumnData="grdPLAccounts_CustomUnboundColumnData"
                         
                         
                       >
            <dxg:GridControl.View>
                <dxg:TableView x:Name="grdPandL"
                               ShowGroupFooters="True"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            ShowTotalSummary="True"      
                            Width="auto"      
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True" 
                            ShowGroupPanel="False"   
                               
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" Margin="0,-2,0,2" />

            </dxg:GridControl.View>
            <dxg:GridControl.GroupSummary>
                <dxg:GridSummaryItem FieldName="balanceOC" 
        ShowInGroupColumnFooter="balanceOC" DisplayFormat="Total Balance (OC): {0:n2}"  SummaryType="Sum" />
                <dxg:GridSummaryItem DisplayFormat="Total Balance (PKR): {0:n2}" FieldName="balancePKR"
        ShowInGroupColumnFooter="balancePKR" SummaryType="Sum" />
            </dxg:GridControl.GroupSummary>
            <dxg:GridColumn Header="Id"
                            Binding="{Binding Id}"
                            IsSmart="True"
                            Visible="False"
                            VisibleIndex="0"
                             />
            <dxg:GridColumn Header="Creation Date"
                            Binding="{Binding creationDate}"
                            VisibleIndex="1"
                            Visible="False"
                            IsSmart="True"
                             >
                <dxg:GridColumn.EditSettings>
                    <dxe:DateEditSettings Mask="f"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Name"
                            VisibleIndex="2"
                            FieldName="accountName"
                            Image="{dx:DXImage Image=Accounting_16x16.png}"
                            IsSmart="True" SortOrder="Ascending" SortIndex="0"
                             />
            <dxg:GridColumn Header="Creator"
                            FieldName="user.userName"
                            IsSmart="True"
                             Image="{dx:DXImage Image=User_16x16.png}"
                            VisibleIndex="3"
                            />
            <dxg:GridColumn Header="Type"
                            FieldName="accountType"
                            VisibleIndex="4"
                            IsSmart="True"
                            GroupIndex="0" SortOrder="Ascending"
                             />
            <dxg:GridColumn Header="isActive"
                            FieldName="AisActive"
                            IsSmart="True"
                              Image="{dx:DXImage Image=CheckBox_16x16.png}"  
                            VisibleIndex="5"
                             />
            <dxg:GridColumn Header="Account Number"
                            Binding="{Binding accountNo}"
                            Visible="False"
                            VisibleIndex="6"
                            IsSmart="True"
                             />
            <dxg:GridColumn Header="Bank Account Number"
                            Binding="{Binding bankAccountNo}"
                            Visible="False"
                            VisibleIndex="7"
                            IsSmart="True"
                            />
            <dxg:GridColumn Header="Routing number"
                            Binding="{Binding routingNo}"
                            IsSmart="True"
                            Visible="False"
                            VisibleIndex="8"
                             />
            <dxg:GridColumn Header="CreditCard number"
                            Binding="{Binding creditCardNo}"
                            VisibleIndex="9" 
                            IsSmart="True"
                            Visible="False"
                           />
            <dxg:GridColumn Header="Company"
                            FieldName="Company"
                            Visible="True"
                            VisibleIndex="4"
                            UnboundType="String"
                            Image="{dx:DXImage Image=Home_16x16.png}"                      
                           />
            <dxg:GridColumn Header="Department"
                            FieldName="Department"
                            Visible="True"
                            AllowSorting="false"
                            UnboundType="String"
                           VisibleIndex="5"
                             Image="{dx:DXImage Image=Home_16x16.png}"
      
                            />
            <dxg:GridColumn Header="Currency"
                            Binding="{Binding Currency.CurrencyName}"
                            Visible="True"                            
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            VisibleIndex="6"
                            AllowSorting="false"
                             />
            <dxg:GridColumn FieldName="balanceOC"
                            ReadOnly="True"
                            VisibleIndex="7"
                            AllowSorting="false"
                            UnboundType="Decimal"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            Header="Balance (OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="balancePKR"
                            ReadOnly="True"
                            VisibleIndex="7"
                            AllowSorting="false"
                            UnboundType="Decimal"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            Header="Balance (PKR)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Reconciled Date"
                            FieldName="reconcilationDate"
                            UnboundType="DateTime"
                            VisibleIndex="16"
                            AllowSorting="false"
                            Visible="True"                            
                             Image="{dx:DXImage Image=Time_16x16.png}" />
            <dxg:GridControl.TotalSummary >
                <dxg:GridSummaryItem  FieldName="balanceOC"  SummaryType="custom"   DisplayFormat="{}{0:n2}" />
                <dxg:GridSummaryItem  FieldName="balancePKR" SummaryType="custom" DisplayFormat="{}{0:n2}" />

            </dxg:GridControl.TotalSummary>
        </dxg:GridControl>
        <Grid  Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblGrossProfit" 
                       Grid.Column="0"
                       Text=" Total Gross Profit (OC):" 
                       FontSize="16" FontWeight="Bold"
                       FontFamily="Segoe UI Semibold"
                      HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                      
                        />
            <dxe:TextEdit x:Name="txtGrossProfitOC" 
                          Grid.Column="1"
                          NullText="0" 
                          NullValue="0"
                          FontSize="22" FontWeight="Bold"
                          FontFamily="Segoe UI Semibold"
                          IsReadOnly="True"
                          MaskShowPlaceHolders="True"
                          Margin="5,5,5,5"
                          Text="0"
                          VerticalAlignment="Center"
                      
                    
                        MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
            <TextBlock x:Name="lblGrossProfitpkR" 
                       Grid.Column="2"
                       Text=" Total Gross Profit (PKR):" 
                       FontSize="16" FontWeight="Bold"
                       FontFamily="Segoe UI Semibold"
                       
                      HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                      
                        />
            <dxe:TextEdit x:Name="txtGrossProfitPKR" 
                          Grid.Column="3"
                       NullText="0" 
                          NullValue="0"
                          Text="0"
                       FontSize="22" FontWeight="Bold"
                       FontFamily="Segoe UI Semibold"
                       IsReadOnly="True"
                        Margin="5,5,5,5"
                       VerticalAlignment="Center" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
        </Grid>

        <dxg:GridControl x:Name="grdexpennseAccounts"
                           Grid.Row="4"
                           SelectionMode="Row"
                           MouseDoubleClick="grdexpennseAccounts_MouseDoubleClick"
                           CustomUnboundColumnData="grdexpennseAccounts_CustomUnboundColumnData"
                         CustomSummary="grdexpennseAccounts_CustomSummary"
                       >
            <dxg:GridControl.View>
                <dxg:TableView x:Name="grdExpense"
                               ShowGroupFooters="True"
                            AllowEditing="False"
                            NavigationStyle="Row"
                             ShowTotalSummary="True"      
                            Width="auto"      
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True" 
                            ShowGroupPanel="False"   
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" />

            </dxg:GridControl.View>
            <dxg:GridControl.GroupSummary>
                <dxg:GridSummaryItem FieldName="balanceOC" 
        ShowInGroupColumnFooter="balanceOC" DisplayFormat="Total Balance (OC): {0:n2}"  SummaryType="Sum" />
                <dxg:GridSummaryItem DisplayFormat="Total Balance (PKR): {0:n2}" FieldName="balancePKR"
        ShowInGroupColumnFooter="balancePKR" SummaryType="Sum" />

            </dxg:GridControl.GroupSummary>
            <dxg:GridColumn Header="Id"
                            Binding="{Binding Id}"
                            IsSmart="True"
                            Visible="False"
                            VisibleIndex="0"
                             />
            <dxg:GridColumn Header="Creation Date"
                            Binding="{Binding creationDate}"
                            VisibleIndex="1"
                            Visible="False"
                            IsSmart="True" 
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:DateEditSettings Mask="f"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Name"
                            VisibleIndex="2"
                            FieldName="accountName"
                              Image="{dx:DXImage Image=Accounting_16x16.png}"
                            IsSmart="True"  SortIndex="0" 
                             />
            <dxg:GridColumn Header="Creator"
                            FieldName="user.userName"
                            IsSmart="True"
                            VisibleIndex="3"
                                  Image="{dx:DXImage Image=User_16x16.png}"
                           />
            <dxg:GridColumn Header="Type"
                            FieldName="accountType"
                            VisibleIndex="4"
                            IsSmart="True"
                            SortOrder="Descending"
                            GroupIndex="0" 
                             />
            <dxg:GridColumn Header="isActive"
                            FieldName="AisActive"
                            IsSmart="True"
                            VisibleIndex="5" 
                            />
            <dxg:GridColumn Header="Account Number"
                            Binding="{Binding accountNo}"
                            Visible="False"
                            VisibleIndex="6"
                            IsSmart="True" 
                             />
            <dxg:GridColumn Header="Bank Account Number"
                            Binding="{Binding bankAccountNo}"
                            Visible="False"
                            VisibleIndex="7"
                            IsSmart="True" 
                            />
            <dxg:GridColumn Header="Routing number"
                            Binding="{Binding routingNo}"
                            IsSmart="True"
                            Visible="False"
                            VisibleIndex="8" Width="120"
                             />
            <dxg:GridColumn Header="CreditCard number"
                            Binding="{Binding creditCardNo}"
                            VisibleIndex="9"
                            IsSmart="True"
                            Visible="False" 
                             />
            <dxg:GridColumn Header="Company"
                            FieldName="Company"
                            Visible="True"
                            VisibleIndex="4"
                            UnboundType="String"
                            Image="{dx:DXImage Image=Home_16x16.png}"                       
                            />
            <dxg:GridColumn Header="Department"
                            FieldName="Department"
                            Visible="True"
                            AllowSorting="false"
                            UnboundType="String"
                            VisibleIndex="5"
                             Image="{dx:DXImage Image=Home_16x16.png}"
                            />
            <dxg:GridColumn Header="Currency"
                            Binding="{Binding Currency.CurrencyName}"
                            Visible="True"                            
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            VisibleIndex="6"
                            AllowSorting="false"
                            />
            <dxg:GridColumn FieldName="balanceOC"
                            ReadOnly="True"
                            VisibleIndex="7"
                            AllowSorting="false"
                            UnboundType="Decimal"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            Header="Balance (OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="balancePKR"
                            ReadOnly="True"
                            VisibleIndex="7"
                            AllowSorting="false"
                            UnboundType="Decimal"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            Header="Balance (PKR)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Reconciled Date"
                            FieldName="reconcilationDate"
                            UnboundType="DateTime"
                            VisibleIndex="16"
                            AllowSorting="false"
                            Visible="True"                            
                             Image="{dx:DXImage Image=Time_16x16.png}"

                           />
            <dxg:GridControl.TotalSummary >
                <dxg:GridSummaryItem  FieldName="balanceOC"  SummaryType="custom"   DisplayFormat="{}{0:n2}" />
                <dxg:GridSummaryItem   FieldName="balancePKR" SummaryType="custom" DisplayFormat="{}{0:n2}" />

            </dxg:GridControl.TotalSummary>
        </dxg:GridControl>
        <Grid  Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblNetProfit" 
                       Grid.Column="0"
                       Text=" Total Net Profit (OC):" 
                       FontSize="16" FontWeight="Bold"
                       FontFamily="Segoe UI Semibold"
                      HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                      
                        />
            <dxe:TextEdit x:Name="txtNetProfit" 
                          Grid.Column="1"
                          NullText="0" 
                          NullValue="0"
                          FontSize="22" FontWeight="Bold"
                          FontFamily="Segoe UI Semibold"
                          IsReadOnly="True"
                          Margin="5,5,5,5"
                          Text="0"
                          VerticalAlignment="Center"
                      
                    
                        MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
            <TextBlock x:Name="lblNetProfitpkR" 
                       Grid.Column="2"
                       Text=" Total Net Profit (PKR):" 
                       FontSize="16" FontWeight="Bold"
                       FontFamily="Segoe UI Semibold"
                      HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                      
                        />
            <dxe:TextEdit x:Name="txtNetProfitPKR" 
                          Grid.Column="3"
                       NullText="0" 
                          NullValue="0"
                       FontSize="22" FontWeight="Bold"
                       FontFamily="Segoe UI Semibold"
                       IsReadOnly="True"
                        Margin="5,5,5,5"
                          Text="0"
                       VerticalAlignment="Center" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
        </Grid>
    </Grid>

</dx:DXWindow>
