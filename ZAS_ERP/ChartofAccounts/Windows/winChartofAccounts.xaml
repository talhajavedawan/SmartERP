<dx:DXWindow x:Class="ZAS_ERP.ChartofAccounts.Windows.winChartofAccounts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
        mc:Ignorable="d"
        Title="winChartofAccounts" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid Grid.Row="2"  >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <dx:DXTabControl Grid.Row="1"  >
            <dx:DXTabItem  Header="Groups" x:Name="tabStandard">
                <dxg:GridControl x:Name="grdChartofAccountsGroups" SelectionMode="Row"   SelectionChanged="grdChartofAccountsGroups_SelectionChanged" Visibility="Visible" Grid.Row="0" AutoGenerateColumns="None"
            EnableSmartColumnsGeneration="True">

                    <dxg:GridControl.View>
                        <dxg:TreeListView     
                            x:Name="tblChartofAccountListView"
                            ShowSearchPanelFindButton="True"
                            KeyFieldName="Id"
                            ParentFieldName="parentId"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            Width="auto"
                                
                            AutoWidth="True"
                            CustomUnboundColumnData="tblChartofAccountListView_CustomUnboundColumnData"
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoPopulateServiceColumns="False"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True"      
                            ShowTotalSummary="True" 
                            RowAnimationKind="None"
                            WaitIndicatorType="Panel"      
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True"   
                            AutoExpandAllNodes="True"
                                >
                            <dxg:TreeListView.FormatConditions>
                                <dxg:FormatCondition Expression="[totalAccounts] &lt;&gt; ?" FieldName="totalAccounts">
                                    <dx:Format Background="#FF9BBB59"/>
                                </dxg:FormatCondition>
                            </dxg:TreeListView.FormatConditions>
                        </dxg:TreeListView>

                    </dxg:GridControl.View>

                    <dxg:GridColumn FieldName="Title"
                                    Header="Group Name"
                                    VisibleIndex="0"
                                    AllowEditing="false"
                                    HorizontalHeaderContentAlignment="Center"
                                    Width="auto"
                               />
                    <dxg:GridColumn FieldName="totalAccounts"
                            ReadOnly="True"
                            VisibleIndex="1"
                                        HorizontalHeaderContentAlignment="Center"
                            Width="auto"
                            UnboundType="Decimal"
                            Header="Total Accounts" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" HorizontalContentAlignment="Center" Mask="d" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControl>

            </dx:DXTabItem>


        </dx:DXTabControl>



        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <dxe:TextEdit x:Name="txtGridChartofAccounts"  Grid.Column="1"  HorizontalAlignment="Left" VerticalAlignment="Top" IsEnabled="False" FontWeight="DemiBold" FontSize="18"   Text=" Chart of Accounts" />
            <dx:SimpleButton x:Name="btnLoanBalances"  Grid.Row="1"  Cursor="Hand" Content="Load Balance" FontWeight="DemiBold"  Grid.Column="3" Visibility="Visible" Click='btnLoanBalances_Click' />
            <dxg:GridControl x:Name="grdAccounts" Grid.Row="2"
                                     AutoGenerateColumns="None"
                                     MouseDoubleClick="grdAccountListing_MouseDoubleClick"
                                     SelectionMode="Row" 
                             
                                     AutoExpandAllGroups="True"
                                     IsRecursiveExpand="True" 
                                     AllowInitiallyFocusedRow="False" 
                                     >

                <dxg:GridControl.View>
                    <dxg:TreeListView x:Name="grdAccountsTree"
                            KeyFieldName="Id"
                            ParentFieldName="parentId"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            AutoExpandAllNodes="True"      
                            Width="auto"
                                   CustomUnboundColumnData="GrdAccountsTree_CustomUnboundColumnData"
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoPopulateServiceColumns="False"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True"      
                            ShowTotalSummary="True"    
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FilterMode="Extended"
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" >
                        <dxg:TreeListView.NodeSummary>
                            <dxg:TreeListSummaryItem x:Name="ocSummary" FieldName="balanceOC" SummaryType="Sum" />

                        </dxg:TreeListView.NodeSummary>
                    </dxg:TreeListView>

                </dxg:GridControl.View>

                <dxg:GridColumn Header="Name"
                          VisibleIndex="2"
                             Image="{dx:DXImage Image=Accounting_16x16.png}"   
                            FieldName="accountName"
                                                  
AllowSorting="false"
                            Width="auto" />
                <dxg:GridColumn Header="Type"
                            FieldName="accountType"
                           VisibleIndex="1"
                          
                    AllowSorting="false"                                     Image="{dx:DXImage Image=ShapeLabels_16x16.png}"

                            Width="auto" />

                <dxg:GridColumn Header="Company"
                            FieldName="Company"
                            Visible="True"
                            VisibleIndex="4"
                            UnboundType="String"
                            Image="{dx:DXImage Image=Home_16x16.png}"                      
                            />
                <dxg:GridColumn Header="Department"
                            FieldName="Department"
                            Visible="True"
                            AllowSorting="false"
                            UnboundType="String"
                           VisibleIndex="5"
                             Image="{dx:DXImage Image=Home_16x16.png}"
      
                             />
                <dxg:GridColumn Header="Currency"
                            Binding="{Binding Currency.CurrencyName}"
                            Visible="True"                            
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            VisibleIndex="6"
                            AllowSorting="false"
                             />
                <dxg:GridColumn FieldName="BalanceOC"
                            ReadOnly="True"
                            VisibleIndex="7"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Balance (OC)" >
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn FieldName="BalancePKR"
                            ReadOnly="True"
                            VisibleIndex="7"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Balance (PKR)" >
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn Header="Reconciled Date"
                            FieldName="reconcilationDate"
                            UnboundType="DateTime"
                            VisibleIndex="16"
                            
                            AllowSorting="false"
                            Visible="True"                            
                             Image="{dx:DXImage Image=Time_16x16.png}"

                            Width="auto" />

            </dxg:GridControl>
        </Grid>





    </Grid>
</dx:DXWindow>
