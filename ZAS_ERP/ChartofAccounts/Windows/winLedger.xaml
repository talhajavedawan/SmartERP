<dx:DXWindow xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"  x:Class="ZAS_ERP.ChartofAccounts.Windows.winLedger"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
             xmlns:local1="clr-namespace:ZAS_ERP.ChartofAccounts"
             mc:Ignorable="d"
            

    Title="Accounts Ledger" Height="450" Width="800" WindowStartupLocation="CenterScreen" WindowState="Maximized" Loaded="Window_Loaded" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">



    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto" MinHeight="61"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>



            <Label Grid.Column="3" Grid.Row="1" FontWeight="DemiBold" Content="From"/>
            <dxe:DateEdit x:Name="dateFrom" Cursor="Hand" ToolTip="From" Grid.Row="1"  Grid.Column="5" />

            <Label Grid.Column="7" Grid.Row="1" FontWeight="DemiBold" Content="To"/>
            <dxe:DateEdit x:Name="dateTo" Cursor="Hand" ToolTip="To" Grid.Row="1" Grid.Column="9" />
            <Button x:Name="btnApply" ToolTip="Apply Filter" Content="Apply Filter" Grid.Row="1" FontWeight="DemiBold" Cursor="Hand" Grid.Column="11" Click="BtnApply_Click"/>
            <TextBlock x:Name="lblHeading" Grid.Row="3" Grid.ColumnSpan="13"  Text="Accounts Ledger" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center"  FontFamily="Segoe UI Semibold"  />
            <TextBlock x:Name="lblCompany" Grid.Row="3" Grid.Column="0"  Text="Company :" FontSize="20" FontWeight="DemiBold"  HorizontalAlignment="Right" Margin="5,5,5,5" VerticalAlignment="Center"  FontFamily="Segoe UI Semibold"  />
            <TextBlock x:Name="txtCompany" Grid.Row="3" Grid.Column="1"    FontWeight="DemiBold" FontSize="16"   HorizontalAlignment="Left" VerticalAlignment="Center"   FontFamily="Segoe UI Semibold"  />
            <dxlc:LayoutGroup Grid.Row="3" Grid.Column="9"  Grid.ColumnSpan="3"  HorizontalAlignment="Center" VerticalAlignment="Center">
                <dxlc:LayoutItem  Height="20"  FontWeight="DemiBold" Label="Opening Balance(OC)">
                    <dxe:TextEdit  x:Name="txtOpeningBalanceOC" IsReadOnly="True" Text="0"  NullText="0.00" NullValue="0" Mask="n2" MaskUseAsDisplayFormat="True" MaskType="Numeric" />
                </dxlc:LayoutItem> 
                <dxlc:LayoutItem  Height="20"  FontWeight="DemiBold" Label="Opening Balance(MER)">
                    <dxe:TextEdit  x:Name="txtOpeningBalanceMER" IsReadOnly="True" Text="0"   NullText="0.00" NullValue="0" Mask="n2" MaskUseAsDisplayFormat="True" MaskType="Numeric" />
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>

           
        </Grid>

        <Menu DockPanel.Dock="Top"
              x:Name="menuGrid"
              dx:ThemeManager.ThemeName="DeepBlue">
            <MenuItem Header="_Print Preview"
                      x:Name="mbtnPrintPreview"
                      ToolTip="Print Preview"
                      Cursor="Hand"
                      Click="MbtnPrintPreview_Click"></MenuItem>

            <MenuItem Header="Refresh"
                      x:Name="mbtnRefresh"
                      ToolTip="Refresh"
                      Cursor="Hand"
                      Click="MbtnRefresh_Click"></MenuItem>
            <MenuItem Header="Save Layout"
                          x:Name="mbtnSaveLayout"
                      ToolTip="Save Layout"
                      Cursor="Hand"
                          Click="MbtnSaveLayout_Click"></MenuItem>

        </Menu>
        <dxg:GridControl x:Name="grdListEntries"
                    Margin="5,5,5,5"
                         Grid.Row="2"
                         SelectionMode="Row" 
                         ShowBorder="True"
                         CustomUnboundColumnData="grdListEntries_CustomUnboundColumnData"
                         MouseDoubleClick="GrdListEntries_MouseDoubleClick"                         
                         dx:DXSerializer.SerializationID="grid">
            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       ShowAutoFilterRow="True"
                       Width="auto" 
                               HorizontalScrollbarVisibility="Visible"
                               ShowHorizontalLines="True"
                           ShowVerticalLines="True"
                               AllowFilterEditor="false"
                               SearchPanelAllowFilter="False"
                       FilterRowDelay="1000"      
                       RowAnimationKind="Opacity" WaitIndicatorType="Panel"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       ShowFixedTotalSummary="True"
                       ShowTotalSummary="True"   
                           x:Name="view1" ShowFilterPanelMode="ShowAlways" >
                </dxg:TableView>
            </dxg:GridControl.View>

            <dxg:GridColumn FieldName="SaleInvoiceId"
                          ReadOnly="True"
                          VisibleIndex="0"
                         
                          Visible="False"  
                          Header="SaleInvoiceId" />
            <dxg:GridColumn FieldName="InterBankId"
                          ReadOnly="True"
                          Visible="False"        
                          
                          VisibleIndex="1"          
                          Header="InterBankId" />
            <dxg:GridColumn FieldName="SaleReceiptId"
                          ReadOnly="True"
                          VisibleIndex="2"      
                        
                          Visible="False"   
                          Header="SaleReceiptId" />

            <dxg:GridColumn FieldName="coaTransactionsType"
                          ReadOnly="True"
                          Image="{dx:DXImage Image=ShapeLabels_16x16.png}"
                          VisibleIndex="0"      
                          
                          Header="Transaction Type" />
            <dxg:GridColumn FieldName="transactionRefno"
                          ReadOnly="True"
                          Image="{dx:DXImage Image=ShapeLabels_16x16.png}"
                          VisibleIndex="1"      
                            AllowSorting="false"
                             FilterPopupMode="Disabled"
                          Header="Transaction Ref." />
            <dxg:GridColumn FieldName="creationDate"
                          ReadOnly="True"
                          VisibleIndex="2" 
                            
                            
                                                         Image="{dx:DXImage Image=Time_16x16.png}"
                          Header="GL-Posting Date"   AutoFilterCondition="Contains" />

            <dxg:GridColumn FieldName="account.accountName"
                        ReadOnly="True"
                        VisibleIndex="3"
                            
                            
                        Header="Account" >
            </dxg:GridColumn>




            <dxg:GridColumn FieldName="account.accountType"
                        ReadOnly="True"
                        Image="{dx:DXImage Image=ShapeLabels_16x16.png}"
                        VisibleIndex="4"       
                         
                        Header="Account Type" >
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="company.CompanyName"
                        ReadOnly="True"
                        VisibleIndex="5" 
                           
                        Visible="True"
                        Image="{dx:DXImage Image=Home_16x16.png}"   
                        Header="Company" >
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="department.DeptName"
                          ReadOnly="True"
                           
                        VisibleIndex="6" 
                        
                        Visible="True"
                        Image="{dx:DXImage Image=BODepartment_16x16.png}"
                        Header="Department" >
            </dxg:GridColumn>
            <dxg:GridColumn 
                        FieldName="memo" 
                        ReadOnly="True" 
                 FilterPopupMode="Disabled"
                        Header="Memo" 
                AllowSorting="false"
                        VisibleIndex="7" 
                />
            <dxg:GridColumn 
                        FieldName="isReconciled" 
                        ReadOnly="True" 
                        Header="Is Reconciled" 
                AllowSorting="false"
                     
                />
            <dxg:GridColumn 
                        FieldName="isReconciled" 
                        ReadOnly="True" 
                        Header="Is Reconciled" 
                AllowSorting="false"
                     
                />

            <dxg:GridColumn 
                        FieldName="reconcilationDate" 
                        ReadOnly="True" 
                        Header="Reconciliation Date" 
                AllowSorting="false"
                     
                />
            <dxg:GridColumn 
                FieldName="debitPKR"
                UnboundType="Decimal" 
                AllowSorting="false"
                 FilterPopupMode="Disabled"
                          ReadOnly="True"
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          VisibleIndex="8"   
                          Header="Debit (PKR)" UnboundExpression="[debit] * [MER]" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="creditPKR"
                          ReadOnly="True" 
                            UnboundType="Decimal"
                            
                          VisibleIndex="9"                                           
         Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Credit (PKR)" UnboundExpression="[credit] * [MER]" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="MER"
                          ReadOnly="True"
                       
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Visible="True"  
                          VisibleIndex="10"
                          Header="MER">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="balance"
                          ReadOnly="True"
                     
                            UnboundType="Decimal"
                          VisibleIndex="11"
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Balance (PKR)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn 
                        FieldName="currency.CurrencyName" 
                        ReadOnly="True"         
                        AllowSorting="false"
                 FilterPopupMode="Disabled"
                        Header="OC"
                        Image="{dx:DXImage Image=Currency2_16x16.png}"
                        VisibleIndex="12" 
                />
            <dxg:GridColumn FieldName="debit"
                          ReadOnly="True"
                          Visible="True"  
                         
                           
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          VisibleIndex="13"
                          Header="Debit(OC)">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="credit"
                          ReadOnly="True"
                          Visible="True"  
                     
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          VisibleIndex="14"
                          Header="Credit(OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <!--<dxg:GridColumn FieldName="balanceOC"
                          ReadOnly="True"
                          UnboundType="Decimal"  
                             FilterPopupMode="Disabled"
                          VisibleIndex="15"                                                          AllowSorting="False"
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Balance(OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>-->
            <dxg:GridColumn FieldName="balanceAmount"
                          ReadOnly="True"  
                          UnboundType="Decimal"  
                          VisibleIndex="16"  
                          Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Balance(OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Total"
                            FieldName="total"
                            IsSmart="True"
                            VisibleIndex="13"
                            Visible="False"
                            ShowInColumnChooser="False">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridControl.TotalSummary >
                <dxg:GridSummaryItem x:Name="sumTotalDebitPKR" FieldName="debitPKR"  SummaryType="Sum"   DisplayFormat="{}{0:n2}" />
                <dxg:GridSummaryItem FieldName="creditPKR" SummaryType="Sum" DisplayFormat="{}{0:n2}" />
                <dxg:GridSummaryItem FieldName="balance" SummaryType="Sum" DisplayFormat="{}{0:n2}"  />
                <dxg:GridSummaryItem FieldName="debit" SummaryType="Sum" DisplayFormat="{}{0:n2}" />
                <dxg:GridSummaryItem FieldName="credit" SummaryType="Sum" DisplayFormat="{}{0:n2}" />
            </dxg:GridControl.TotalSummary>
        </dxg:GridControl>

        <Grid Grid.Row="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <dxlc:LayoutGroup Grid.Column="3">
                <dxlc:LayoutItem  FontWeight="DemiBold" Label="Closing Balance(OC)">
                    <dxe:TextEdit  x:Name="txtClosingBalanceOC" IsReadOnly="True" Text="0"  NullText="0.00" NullValue="0" Mask="n2" MaskUseAsDisplayFormat="True" MaskType="Numeric" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem  FontWeight="DemiBold" Label="Closing Balance(MER)">
                    <dxe:TextEdit  x:Name="txtClosingBalanceMER" IsReadOnly="True" Text="0" NullText="0.00" NullValue="0" Mask="n2" MaskUseAsDisplayFormat="True" MaskType="Numeric" />
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>
        </Grid>
        
        <Image
        x:Name="loadingGif"    
       
            
        Visibility="Hidden"
        Grid.Row="2"
            
         gif:AnimationBehavior.SourceUri="/ZAS_ERP;component/images/loadingReports.gif"   
        VerticalAlignment="Center"
        HorizontalAlignment="Center" RenderTransformOrigin="12.987,0.793" Margin="366,217,366,123" Width="60" Height="0"/>
    </Grid>
</dx:DXWindow>
