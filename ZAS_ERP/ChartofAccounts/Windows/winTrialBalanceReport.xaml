<dx:DXWindow x:Class="ZAS_ERP.ChartofAccounts.Windows.winTrialBalanceReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows" 
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:Databases="clr-namespace:ERP_BL.Databases;assembly=ERP_BL" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        mc:Ignorable="d"
        Title="winTrialBalanceReport" Height="450" Width="800" Loaded="Window_Loaded">
    <Window.Resources>
        <dx:EntitySimpleDataSource x:Key="EntitySimpleDataSource" ContextType="{x:Type Databases:DBContextERP}" Path="Companies">
            <dx:DesignDataManager.DesignData>
                <dx:DesignDataSettings RowCount="5"/>
            </dx:DesignDataManager.DesignData>
        </dx:EntitySimpleDataSource>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <dxr:RibbonControl  DockPanel.Dock="Top"  RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
            <dxr:RibbonDefaultPageCategory>
                <dxr:RibbonPage x:Name="lblHeading1" ToolTip="Report Name" Caption="Home"  >
                    <dxr:RibbonPageGroup  Caption="Clipboard">
                        <dxb:BarButtonItem x:Name="btnPrintPreview" KeyGesture="Ctrl+P" Cursor="Hand" Content="Print Preview" ItemClick="BtnPrintPreview_ItemClick"  Glyph="{dx:DXImage Image=Printer_32x32.png}" LargeGlyph="{dx:DXImage Image=Printer_32x32.png}"/>
                        <dxb:BarButtonItem x:Name="btnSaveAsNew" KeyGesture="Ctrl+N" Cursor="Hand" Content="Save as new" ItemClick="MbtnSaveAsNew1_Click" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>
                        <dxb:BarButtonItem x:Name="btnRename" KeyGesture="Ctrl+X" Cursor="Hand" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_32x32.png}" />
                        <dxb:BarButtonItem x:Name="btnUpdate" KeyGesture="Ctrl+U" Cursor="Hand" Content="Update" ItemClick="MbtnUpdateReport1_Click" Glyph="{dx:DXImage Image=Reset_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                        <dxb:BarButtonItem x:Name="btnDelete" KeyGesture="Delete" Cursor="Hand" Content="Delete" ItemClick="MbtnDeleteReport1_Click" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>
                        <dxb:BarButtonItem x:Name="btnCopy2" KeyGesture="Ctrl+R" Cursor="Hand" Content="Refresh" ItemClick="btnRefresh_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                        <dxb:BarButtonItem x:Name="mbtnExportToMemorizedReport1" Cursor="Hand" Content="Export to memorized" ItemClick="MbtnExportToMemorizedReport1_Click" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                        <dxb:BarButtonItem x:Name="mbtnExportToStandardReport1" Cursor="Hand" ItemClick="MbtnExportToStandardReport1_Click" Content="Export to standard" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                        <dxb:BarButtonItem x:Name="mbtnShareReport" Cursor="Hand" ItemClick="mbtnShareReport_ItemClick" Content="Share Report" Glyph="{dx:DXImage Image=Convert_32x32.png}"/>

                    </dxr:RibbonPageGroup>

                </dxr:RibbonPage>

            </dxr:RibbonDefaultPageCategory>
        </dxr:RibbonControl>

    <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
       
            




        <TextBlock   Text="As of" FontSize="16" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  Margin="15" />
        <dxe:DateEdit x:Name="datAsof" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"  Margin="15" NullText="Select Date"/>
        <TextBlock   Text="Company" Grid.Column="4"  FontSize="16" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold" Margin="15"  />
        <dxg:LookUpEdit x:Name="mbtnAllCompanies" Grid.Column="5" Grid.Row="1" Margin="15" NullText="Select Company"  ItemsSource="{Binding Data, Source={StaticResource EntitySimpleDataSource}}" DisplayMember="CompanyName"   >
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings/>
            </dxg:LookUpEdit.StyleSettings>
        </dxg:LookUpEdit>
        <TextBlock   Text=" Reporting Currency" Grid.Column="4" FontSize="22" Visibility="Collapsed" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold" Margin="15"  />

        <dxg:LookUpEdit x:Name="mbtnAllCurrencies" Grid.Column="5" Grid.Row="1" Visibility="Collapsed" Margin="15" NullText="Select Currency"  ItemsSource="{Binding Data, Source={StaticResource EntitySimpleDataSource}}" DisplayMember="CurrencyName"   >
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings/>
            </dxg:LookUpEdit.StyleSettings>
        </dxg:LookUpEdit>





        <TextBlock   Text="From" Grid.Column="0" FontSize="16" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="2" FontFamily="Segoe UI Semibold" Margin="15"  />

        <dxe:DateEdit x:Name="datFrom" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"  Margin="15" NullText="Select Date"/>


        <TextBlock   Text="To" Grid.Column="4"  FontSize="16" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="2" FontFamily="Segoe UI Semibold" Margin="15"  />

        <dxe:DateEdit x:Name="datTo" Grid.Column="5" Grid.Row="2"  Margin="15" NullText="Select Date"/>






        <TextBlock x:Name="lblHeading"  Text="Trial Balance as of:" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.ColumnSpan="7" Grid.Row="3" FontFamily="Segoe UI Semibold"   />
        <TextBlock x:Name="lblAsOf"  Text="As of:" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.ColumnSpan="7" Grid.Row="4" FontFamily="Segoe UI Semibold"   />



        <dxg:GridControl x:Name="grdTrialBalanceList"
                         MouseDoubleClick="GrdTrialBalanceList_MouseDoubleClick"
                         Grid.Row="5"
                         Grid.ColumnSpan="8"
                         CustomUnboundColumnData="grdTrialBalanceList_CustomUnboundColumnData"
                         SelectionMode="Row"
                         dx:DXSerializer.SerializationID="grid">
            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       ShowAutoFilterRow="True"
                       Width="auto"
                             
                       RowAnimationKind="None" WaitIndicatorType="Panel"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       ShowFixedTotalSummary="True"
                       ShowTotalSummary="True"   
                           x:Name="view1">
                </dxg:TableView>
            </dxg:GridControl.View>

            <dxg:GridColumn Header="Id"
                            Binding="{Binding Id}"
                         
                            Visible="False"
                            Width="auto" />
            <dxg:GridColumn Header="Name"
                          VisibleIndex="2"
                             Image="{dx:DXImage Image=Accounting_16x16.png}"   
                            FieldName="accountName"
                                                  
AllowSorting="false"
                             />
            <dxg:GridColumn Header="Type"
                            FieldName="accountType"
                           VisibleIndex="1"
                        
                          Image="{dx:DXImage Image=ShapeLabels_16x16.png}"

                             />



            <dxg:GridColumn Header="Creation Date"
                            Binding="{Binding creationDate}"
                            VisibleIndex="1"
                         
                            Visible="False"
                             Image="{dx:DXImage Image=Time_16x16.png}"

                            
                            Width="auto" >
                <dxg:GridColumn.EditSettings>
                    <dxe:DateEditSettings Mask="f"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>




            <dxg:GridColumn FieldName="debit"
                            ReadOnly="True"
                            VisibleIndex="7"
                          
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Debit (OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="debitPKR"
                            ReadOnly="True"
                            VisibleIndex="7"
                        
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Debit (PKR)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="credit"
                            ReadOnly="True"
                            VisibleIndex="7"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Credit (OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="creditPKR"
                            ReadOnly="True"
                            VisibleIndex="7"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Credit (PKR)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <!--<dxg:GridColumn FieldName="debitRC"
                            ReadOnly="True"
                            VisibleIndex="7"
                        
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Debit (RC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="creditRC"
                            ReadOnly="True"
                            VisibleIndex="7"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Credit (RC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>-->
            <dxg:GridControl.TotalSummary>
                <dxg:GridSummaryItem FieldName="debit" SummaryType="Sum" DisplayFormat="n2"/>
                <dxg:GridSummaryItem FieldName="credit" SummaryType="Sum" DisplayFormat="n2"/>
                <dxg:GridSummaryItem FieldName="debitPKR" SummaryType="Sum" DisplayFormat="n2"/>
                <dxg:GridSummaryItem FieldName="creditPKR" SummaryType="Sum" DisplayFormat="n2"/>
            </dxg:GridControl.TotalSummary>
        </dxg:GridControl>

    </Grid>
    </Grid>

</dx:DXWindow>
