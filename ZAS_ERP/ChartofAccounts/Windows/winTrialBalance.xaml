<dx:DXWindow
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    x:Class="ZAS_ERP.ChartofAccounts.Windows.winTrialBalance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:Databases="clr-namespace:ERP_BL.Databases;assembly=ERP_BL"
    mc:Ignorable="d"
        Title="Trial Balance"  WindowState="Maximized"  Height="450" Width="600"  Loaded="Window_Loaded">
    <Window.Resources>
    <dx:EntitySimpleDataSource x:Key="EntitySimpleDataSource" ContextType="{x:Type Databases:DBContextERP}" Path="Companies">
        <dx:DesignDataManager.DesignData>
            <dx:DesignDataSettings RowCount="5"/>
        </dx:DesignDataManager.DesignData>
    </dx:EntitySimpleDataSource>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/> 
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock   Text="As of" FontSize="16" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="0" FontFamily="Segoe UI Semibold"  Margin="15" />
        <dxe:DateEdit x:Name="datAsof" Grid.Column="1" Grid.Row="0"  Margin="15" NullText="Select Date"/>
        <TextBlock   Text="Company" Grid.Column="2" FontSize="16" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="0" FontFamily="Segoe UI Semibold" Margin="15"  />
        <dxg:LookUpEdit x:Name="mbtnAllCompanies" Grid.Column="3" Grid.Row="0" Margin="15" NullText="Select Company"  ItemsSource="{Binding Data, Source={StaticResource EntitySimpleDataSource}}" DisplayMember="CompanyName"   >
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings/>
            </dxg:LookUpEdit.StyleSettings>
        </dxg:LookUpEdit>
        <TextBlock   Text=" Reporting Currency" Grid.Column="4" FontSize="22" Visibility="Collapsed" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="0" FontFamily="Segoe UI Semibold" Margin="15"  />

        <dxg:LookUpEdit x:Name="mbtnAllCurrencies" Grid.Column="5" Grid.Row="0" Visibility="Collapsed" Margin="15" NullText="Select Currency"  ItemsSource="{Binding Data, Source={StaticResource EntitySimpleDataSource}}" DisplayMember="CurrencyName"   >
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings/>
            </dxg:LookUpEdit.StyleSettings>
        </dxg:LookUpEdit>




        <dx:SimpleButton x:Name="btnRefresh" Content="Refresh" Grid.Row="1"  Grid.Column="5" Margin="15" FontWeight="Bold" Click="btnRefresh_Click"/>
        <dx:SimpleButton x:Name="btnExportToReport" Visibility="Visible" Content="Export to Report" Grid.Row="0" Grid.Column="5" Margin="15" FontWeight="Bold" Click="btnExportToReport_Click"/>

        <TextBlock   Text="From" Grid.Column="0" FontSize="16" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold" Margin="15"  />

        <dxe:DateEdit x:Name="datFrom" Grid.Column="1" Grid.Row="1"  Margin="15" NullText="Select Date"/>


        <TextBlock   Text="To" Grid.Column="2" FontSize="16" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold" Margin="15"  />

        <dxe:DateEdit x:Name="datTo" Grid.Column="3" Grid.Row="1"  Margin="15" NullText="Select Date"/>






        <TextBlock x:Name="lblHeading"  Text="Trial Balance as of:" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.ColumnSpan="7" Grid.Row="2" FontFamily="Segoe UI Semibold"   />
        <TextBlock x:Name="lblAsOf"  Text="As of:" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.ColumnSpan="7" Grid.Row="3" FontFamily="Segoe UI Semibold"   />
        
        

        <dxg:GridControl x:Name="grdTrialBalanceList"
                         MouseDoubleClick="GrdTrialBalanceList_MouseDoubleClick"
                         Grid.Row="4"
                         ShowLoadingPanel="False"
                         
                         Grid.ColumnSpan="8"
                         CustomUnboundColumnData="grdTrialBalanceList_CustomUnboundColumnData"
                         SelectionMode="Row"
                         dx:DXSerializer.SerializationID="grid">
            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       ShowAutoFilterRow="True"
                       Width="auto"
                             
                       RowAnimationKind="None" WaitIndicatorType="Panel"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       ShowFixedTotalSummary="True"
                       ShowTotalSummary="True"   
                           x:Name="view1">
                </dxg:TableView>
            </dxg:GridControl.View>

            <dxg:GridColumn Header="Id"
                            Binding="{Binding Id}"
                         
                            Visible="False"
                            Width="auto" />
            <dxg:GridColumn Header="Name"
                          VisibleIndex="2"
                             Image="{dx:DXImage Image=Accounting_16x16.png}"   
                            FieldName="accountName"
                                                  
AllowSorting="false"
                             />
            <dxg:GridColumn Header="Type"
                            FieldName="accountType"
                           VisibleIndex="1"
                          GroupIndex="1"
                          Image="{dx:DXImage Image=ShapeLabels_16x16.png}"

                             />
     
          

            <dxg:GridColumn Header="Creation Date"
                            Binding="{Binding creationDate}"
                            VisibleIndex="1"
                         
                            Visible="False"
                             Image="{dx:DXImage Image=Time_16x16.png}"

                            
                            Width="auto" >
                <dxg:GridColumn.EditSettings>
                    <dxe:DateEditSettings Mask="f"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>



          
            <dxg:GridColumn FieldName="debit"
                            ReadOnly="True"
                            VisibleIndex="7"
                          
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Debit (OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="debitPKR"
                            ReadOnly="True"
                            VisibleIndex="7"
                        
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Debit (PKR)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="credit"
                            ReadOnly="True"
                            VisibleIndex="7"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Credit (OC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="creditPKR"
                            ReadOnly="True"
                            VisibleIndex="7"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Credit (PKR)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <!--<dxg:GridColumn FieldName="debitRC"
                            ReadOnly="True"
                            VisibleIndex="7"
                        
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Debit (RC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="creditRC"
                            ReadOnly="True"
                            VisibleIndex="7"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Credit (RC)" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>-->
            <dxg:GridControl.TotalSummary>
                <dxg:GridSummaryItem FieldName="debit" SummaryType="Sum" DisplayFormat="n2"/>
                <dxg:GridSummaryItem FieldName="credit" SummaryType="Sum" DisplayFormat="n2"/>
                <dxg:GridSummaryItem FieldName="debitPKR" SummaryType="Sum" DisplayFormat="n2"/>
                <dxg:GridSummaryItem FieldName="creditPKR" SummaryType="Sum" DisplayFormat="n2"/>
            </dxg:GridControl.TotalSummary>
        </dxg:GridControl>

    </Grid>
</dx:DXWindow>
