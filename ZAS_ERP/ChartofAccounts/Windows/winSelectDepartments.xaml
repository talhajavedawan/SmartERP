<dx:DXWindow x:Class="ZAS_ERP.ChartofAccounts.Windows.winSelectDepartments"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxlc="http://schemas.microsoft.com/netfx/2007/xaml/presentation"
        mc:Ignorable="d"
        Title="Profit and Loss Department Selection" Height="400" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid dx:ThemeManager.ThemeName="DeepBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <dxlc:GroupBox Grid.Row="0" Background="Transparent" >
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Column="1"
                   Grid.Row="1"
                   Grid.ColumnSpan="2"
                   HorizontalAlignment="Center"
                   FontWeight="DemiBold"
                   FontSize="15"        
                   TextDecorations="Underline"
            Text="Please select Departments to see Profit and Loss"/>


                <dxg:GridControl x:Name="grdDepartments"
                                  Margin="0 10 0 0"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     Grid.Row="2"
                                 Grid.RowSpan="2"
                                     SelectionMode="MultipleRow"
                                      AllowInitiallyFocusedRow="False"
                                    >
                    <dxg:GridControl.View>
                        <dxg:TreeListView x:Name="viewTable"
                               AutoWidth="True"
                                  KeyFieldName="Id"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">

                        </dxg:TreeListView>

                    </dxg:GridControl.View>
                    <dxg:GridColumn Header="Department Name"
                            VisibleIndex="3"
                            FieldName="DeptName"
                            IsSmart="True"
                            Width="auto" />
                </dxg:GridControl>

            </Grid>
        </dxlc:GroupBox>

        <dx:SimpleButton 
            x:Name="btnContinue"
    Background="Red"
    Content="Continue"
       
                Grid.Row="1"
            Cursor="Hand"
            ToolTip="Continue"
            Click="BtnContinue_Click"
     />
    </Grid>
</dx:DXWindow>
