<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.ChartofAccounts.Windows.winChartofAccountGroupList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.Windows" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        mc:Ignorable="d"
        Title="Chart of Account Groups" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Menu DockPanel.Dock="Top"
              x:Name="menuGrid"
              Grid.ColumnSpan="3">
            <MenuItem Header="Refresh"
                      x:Name="mbtnRefresh"
                      Cursor="Hand"
                      ToolTip="Refresh"
                      Click="MbtnRefresh_Click"/>
        </Menu>
        <dx:DXTabControl 
                     x:Name="grpbasicinfo"
                     Grid.Column="1"
                     Grid.Row="1"
                     MinHeight="200">
            <dx:DXTabItem Header="Groups" >
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition  Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" FontSize="18"   FontWeight="DemiBold" VerticalAlignment="Center" Text="Groups"/>

                    <dxg:GridControl x:Name="grdCOAGroups"
                                     Grid.Row="1"
                         SelectionMode="Row" 
                      AutoGenerateColumns="None"
                             SelectionChanged="grdCOAGroups_SelectionChanged"
                                             AllowInitiallyFocusedRow="False"
                         MouseDoubleClick="grdCOAGroups_MouseDoubleClick"                         
                         >
                        <dxg:GridControl.View>
                            <dxg:TableView  AutoWidth="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    UseIndicatorForSelection="True"                                    
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True"
                                                   ShowGroupPanel="False"
                                   
                                                   ShowSearchPanelMode="Never"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       ShowFixedTotalSummary="False"
                       ShowTotalSummary="False"   
                           x:Name="view1" ShowFilterPanelMode="Never" >
                            </dxg:TableView>
                        </dxg:GridControl.View>

                        <dxg:GridColumn FieldName="Title"
                          ReadOnly="True"
                          VisibleIndex="0"
                          Header="Title" />
                        <dxg:GridColumn FieldName="referenceNo"
                          ReadOnly="True"
                          VisibleIndex="0"
                          Header="Reference No" />
                        <dxg:GridControl.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add New Group"
                      x:Name="btnNewGroup"
                      Click="btnNewGroup_Click"       
                       >
                                    <MenuItem.Icon>
                                        <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                               


                            </ContextMenu>
                        </dxg:GridControl.ContextMenu>
                    </dxg:GridControl>

                    <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" FontSize="18"  FontWeight="DemiBold" VerticalAlignment="Center" Text="Companies"/>

                    <dxg:GridControl      Grid.Row="1" Grid.Column="1"
                SelectionMode="Row"
                                             x:Name="gridAllCompany"
                                             AutoGenerateColumns="None"
                                             AllowInitiallyFocusedRow="False">

                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="viewTable"
                                   
                                    AutoWidth="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    UseIndicatorForSelection="True"                                    
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True"
                                                   ShowGroupPanel="False"
                                   
                                                   ShowSearchPanelMode="Never"/>
                        </dxg:GridControl.View>
                        <dxg:GridColumn x:Name="colId"
                                FieldName="Id"
                                IsSmart="True"
                                Visible="False" />
                        <dxg:GridColumn FieldName="CompanyName"
                                IsSmart="True" />
                        <dxg:GridColumn FieldName="IndustryType"
                                IsSmart="True" />
                        <dxg:GridColumn x:Name="colBizType"
                                FieldName="BizType"
                                Visible="False"
                                IsSmart="True" />
                        <dxg:GridColumn FieldName="EmployeerNo"
                                x:Name="colEmployeerNo"
                                IsSmart="True"
                                Visible="False" />
                    </dxg:GridControl>
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" FontSize="18" FontWeight="DemiBold" VerticalAlignment="Center" Text="Departments"/>
                    <dxg:GridControl Grid.Row="1" Grid.Column="2"
                
                
                x:Name="gridAllDepartment"
                               AutoGenerateColumns="None"
                               AllowInitiallyFocusedRow="False"
                              
                               SelectionMode="Row">

                        <dxg:GridControl.View>
                            <dxg:TreeListView x:Name="griddeptview"
                                    AutoWidth="True"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID"
                                    TreeDerivationMode="Selfreference"
                                    AutoExpandAllNodes="True"
                                    UseIndicatorForSelection="True"
                                   ShowSearchPanelMode="Never"
                                    IsSynchronizedWithCurrentItem="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True">

                            </dxg:TreeListView>
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="Id"
                                x:Name="coldeptid"
                                IsSmart="True"
                                Visible="False" />
                        <dxg:GridColumn x:Name="coldeptname"
                                FieldName="DeptName"
                                IsSmart="True" />
                        <dxg:GridColumn x:Name="coldeptcode"
                                FieldName="Code"
                                IsSmart="True" />
                        <dxg:GridColumn FieldName="Abbrivation"
                                IsSmart="True"
                                x:Name="coldeptabr"
                                Visible="False" />
                        <dxg:GridColumn FieldName="Timestamp"
                                IsSmart="True"
                                x:Name="coldeptts"
                                Visible="False" />
                        <dxg:GridColumn FieldName="sectionId"
                                IsSmart="True"
                                Visible="False" />
                        <dxg:GridColumn FieldName="sections"
                                IsSmart="True"
                                Visible="False" />
                    </dxg:GridControl>
                    <TextBlock Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" FontSize="18" FontWeight="DemiBold" VerticalAlignment="Center" Text="Employees"/>

                    <dxg:GridControl    Grid.Row="1" Grid.Column="3"
                
                
                x:Name="gridAllEmployee"
                               AutoGenerateColumns="None"
                               AllowInitiallyFocusedRow="False"
                              
                               SelectionMode="Row">

                        <dxg:GridControl.View>
                            <dxg:TreeListView x:Name="gridemployeeview"
                                    AutoWidth="True"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID"
                                    TreeDerivationMode="Selfreference"
                                    AutoExpandAllNodes="True"
                                    UseIndicatorForSelection="True"
                                   ShowSearchPanelMode="Never"
                                    IsSynchronizedWithCurrentItem="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True">

                            </dxg:TreeListView>
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="person.FName"
                                             VisibleIndex="1"
                                                    Header="First Name"/>
                        <dxg:GridColumn FieldName="person.LName"
                                                    Header="Last Name"   VisibleIndex="2"/>
                        <dxg:GridColumn FieldName="empFunction.Title"
                                            VisibleIndex="3"
                                                    Header="Function"/>
                    </dxg:GridControl>

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="18" FontWeight="DemiBold" VerticalAlignment="Center" Text="Chart of Accounts"/>

                    <dxg:GridControl    Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                
                
                x:Name="gridGroupChartofAccounts"
                               AutoGenerateColumns="None"
                               AllowInitiallyFocusedRow="False"
                              
                               SelectionMode="Row">

                        <dxg:GridControl.View>
                            <dxg:TreeListView x:Name="gridAccountseview"
                                    AutoWidth="True"
                                    KeyFieldName="Id"
                                    ParentFieldName="parentId"
                                    TreeDerivationMode="Selfreference"
                                    AutoExpandAllNodes="True"
                                    UseIndicatorForSelection="True"
                                   ShowSearchPanelMode="Never"
                                    IsSynchronizedWithCurrentItem="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True">

                            </dxg:TreeListView>
                        </dxg:GridControl.View>
                        <dxg:GridColumn Header="Type"
                            FieldName="accountType"
                           VisibleIndex="1"
                          
                    AllowSorting="false"                                     Image="{dx:DXImage Image=ShapeLabels_16x16.png}"

                             />
                        <dxg:GridColumn Header="Name"
                          VisibleIndex="2"
                             Image="{dx:DXImage Image=Accounting_16x16.png}"   
                            FieldName="accountName"
                                                  
AllowSorting="false"
                             />
                        <dxg:GridColumn Header="Associated Company"
                            FieldName="associatedCompany"
                            Visible="True"
                            VisibleIndex="4"
                            Image="{dx:DXImage Image=Home_16x16.png}"                      
                             />
                    </dxg:GridControl>
                </Grid>
            </dx:DXTabItem>
            <dx:DXTabItem Header="Group Chart of Accounts" >
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition  Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                       
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" FontSize="18"  FontWeight="DemiBold" VerticalAlignment="Center" Text="Groups"/>

                    <dxg:GridControl Grid.Row="1"
                        x:Name="grdCOAGroupsLinks"
                           
                         SelectionMode="Row" 
                      AutoGenerateColumns="None"
                             SelectionChanged="grdCOAGroupsLinks_SelectionChanged"
                                             AllowInitiallyFocusedRow="False"
                         MouseDoubleClick="grdCOAGroupsLinks_MouseDoubleClick"                        
                         >
                        <dxg:GridControl.View>
                            <dxg:TableView  AutoWidth="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    UseIndicatorForSelection="True"                                    
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True"
                                                   ShowGroupPanel="False"
                                   
                                                   ShowSearchPanelMode="Never"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       ShowFixedTotalSummary="False"
                       ShowTotalSummary="False"   
                           ShowFilterPanelMode="Never" >
                            </dxg:TableView>
                        </dxg:GridControl.View>

                        <dxg:GridColumn FieldName="Title"
                          ReadOnly="True"
                          VisibleIndex="0"
                          Header="Title" />
                        <dxg:GridColumn FieldName="referenceNo"
                          ReadOnly="True"
                          VisibleIndex="0"
                          Header="Reference No" />
                      
                    </dxg:GridControl>

     

                    <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" FontSize="18" FontWeight="DemiBold" VerticalAlignment="Center" Text="Chart of Accounts"/>

                    <dxg:GridControl    Grid.Row="3" Grid.Column="0"
                
                
                x:Name="gridGroupChartofAccountsLinks"
                               AutoGenerateColumns="None"
                               AllowInitiallyFocusedRow="False"
                              
                               SelectionMode="Row">

                        <dxg:GridControl.View>
                            <dxg:TreeListView x:Name="gridAccountseviewLinks"
                                    AutoWidth="True"
                                    KeyFieldName="Id"
                                    ParentFieldName="parentId"
                                    TreeDerivationMode="Selfreference"
                                    AutoExpandAllNodes="True"
                                    UseIndicatorForSelection="True"
                                   ShowSearchPanelMode="Never"
                                    IsSynchronizedWithCurrentItem="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True">

                            </dxg:TreeListView>
                        </dxg:GridControl.View>
                        <dxg:GridColumn Header="Type"
                            FieldName="accountType"
                           VisibleIndex="1"
                          
                    AllowSorting="false"                                     Image="{dx:DXImage Image=ShapeLabels_16x16.png}"

                             />
                        <dxg:GridColumn Header="Name"
                          VisibleIndex="2"
                             Image="{dx:DXImage Image=Accounting_16x16.png}"   
                            FieldName="accountName"
                                                  
AllowSorting="false"
                             />
                        <dxg:GridColumn Header="Associated Company"
                            FieldName="associatedCompany"
                            Visible="True"
                            VisibleIndex="4"
                            Image="{dx:DXImage Image=Home_16x16.png}"                      
                             />
                    </dxg:GridControl>
                </Grid>
            </dx:DXTabItem>
        </dx:DXTabControl>


       
        
        

    </Grid>
</dx:DXWindow>
