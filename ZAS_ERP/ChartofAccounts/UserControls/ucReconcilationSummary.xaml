<UserControl x:Class="ZAS_ERP.ChartofAccounts.UserControls.ucReconcilationSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.UserControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="450"  d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Menu DockPanel.Dock="Top"
              x:Name="menuGrid"
              Grid.ColumnSpan="3">
                <MenuItem Header="Print Preview"
                      x:Name="mbtnPrintPreview"
                      Click="MbtnPrintPreview_Click"/>
            </Menu>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>
                <TextBlock x:Name="lblCompany" Grid.Row="0"   Text="Account Companies" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center"  FontFamily="Segoe UI Semibold"  />
                <TextBlock x:Name="lblHeading" Grid.Row="1"  Text="Reconcilation Summary" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center"  FontFamily="Segoe UI Semibold"  />
                <TextBlock x:Name="lblAccount" Grid.Row="2"   Text="Accounts Details" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center"  FontFamily="Segoe UI Semibold"  />
            </Grid>


            <dxg:GridControl x:Name="grdReconciledSummary"
                    Margin="5,5,5,5"
                         Grid.Row="2"
                             
                         SelectionMode="Row"
                         
                         MouseDoubleClick="GrdReconciledSummary_MouseDoubleClick"
                         >
                <dxg:GridControl.View>
                    <dxg:TableView 
                        AutoWidth="True"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"                                            
                       Width="auto"
                        ShowGroupFooters="True"
                                   ShowGroupPanel="False"
                       FilterRowDelay="1000"      
                       RowAnimationKind="Opacity" WaitIndicatorType="Panel"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       ShowFixedTotalSummary="True"
                       ShowTotalSummary="True"   
                           x:Name="view1" ShowFilterPanelMode="ShowAlways" >

                    </dxg:TableView>

                </dxg:GridControl.View>
                <dxg:GridControl.GroupSummary>
                    <dxg:GridSummaryItem DisplayFormat="Total Amount: {0:n2}" FieldName="amount"
        ShowInGroupColumnFooter="amount" SummaryType="Sum" />

                </dxg:GridControl.GroupSummary>
                <dxg:GridColumn FieldName="amount"
                                        VisibleIndex="4"
                                ActualVisibleIndex="4"
                          Header="Amount" >
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <!--<dxg:GridColumn FieldName="balance"
                                        VisibleIndex="5"
                                ActualVisibleIndex="5"
                          Header="Balance" >
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>-->
                <dxg:GridColumn FieldName="transactionType"
                          ReadOnly="True"
                                                       GroupIndex="1"

                          Header="Type"  />
                <dxg:GridColumn FieldName="reconcilationTransaction"
                          ReadOnly="True"
                           GroupIndex="2"
                          Header="Transaction"  />
            </dxg:GridControl>
        </Grid>
    </Grid>
</UserControl>
