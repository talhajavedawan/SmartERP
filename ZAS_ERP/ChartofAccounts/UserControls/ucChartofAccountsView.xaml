<Window x:Class="ZAS_ERP.ChartofAccounts.UserControls.ucChartofAccountsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.UserControls"
       xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Title="ucChartofAccountsView" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <GroupBox>
            <Grid x:Name="reportMainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <dxr:RibbonControl Grid.Row="0" DockPanel.Dock="Top"  RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
                    <dxr:RibbonDefaultPageCategory>
                        <dxr:RibbonPage x:Name="lblHeading" ToolTip="Report Name" Caption="Home"  >
                            <dxr:RibbonPageGroup  Caption="Clipboard">
                                <dxb:BarButtonItem x:Name="btnPrintPreview" KeyGesture="Ctrl+P" Cursor="Hand" Content="Print Preview" ItemClick="BtnPrintPreview_ItemClick"  Glyph="{dx:DXImage Image=Printer_32x32.png}" LargeGlyph="{dx:DXImage Image=Printer_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnSaveAsNew" KeyGesture="Ctrl+N" Cursor="Hand" Content="Save as new" ItemClick="MbtnSaveAsNew1_Click" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>
                                <dxb:BarButtonItem x:Name="btnRename" KeyGesture="Ctrl+X" Cursor="Hand" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_32x32.png}" />
                                <dxb:BarButtonItem x:Name="btnUpdate" KeyGesture="Ctrl+U" Cursor="Hand" Content="Update" ItemClick="MbtnUpdateReport1_Click" Glyph="{dx:DXImage Image=Reset_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnDelete" KeyGesture="Delete" Cursor="Hand" Content="Delete" ItemClick="MbtnDeleteReport1_Click" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>
                                <dxb:BarButtonItem x:Name="btnCopy2" KeyGesture="Ctrl+R" Cursor="Hand" Content="Refresh" ItemClick="MbtnRefreshReport1_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToMemorizedReport1" Cursor="Hand" Content="Export to memorized" ItemClick="MbtnExportToMemorizedReport1_Click" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToStandardReport1" Cursor="Hand" ItemClick="MbtnExportToStandardReport1_Click" Content="Export to standard" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                            </dxr:RibbonPageGroup>
                          
                        </dxr:RibbonPage>

                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>


                <!--ReportGridControl-->
                <dxg:GridControl x:Name="grdAccounts"
                       Grid.Row="2"
                       Margin="2,2,2,2"
                        SelectionMode="Row"
                       MouseDoubleClick="GrdAccounts_MouseDoubleClick"
                       >
                    <dxg:GridControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add New Account"
                      x:Name="btnNewAccount"
                      Click="BtnNewAccount_Click"       
                       >
                                <MenuItem.Icon>
                                    <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Edit Account"
                      x:Name="btnEditAccount"
                              Click="BtnEditAccount_Click"
                      >

                                <MenuItem.Icon>
                                    <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            

                        </ContextMenu>
                    </dxg:GridControl.ContextMenu>
                    <dxg:GridControl.View>
                        <dxg:TreeListView x:Name="grdAccountsTree"
                            KeyFieldName="Id"
                            ParentFieldName="parentId"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            AutoExpandAllNodes="True"      
                            Width="auto"
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoPopulateServiceColumns="False"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True"      
                            ShowTotalSummary="True"    
                                  CustomUnboundColumnData="GrdAccountsTree_CustomUnboundColumnData"
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FilterMode="Extended"
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" >
                            <dxg:TreeListView.NodeSummary>
                                <dxg:TreeListSummaryItem x:Name="ocSummary" FieldName="balanceOC" SummaryType="Sum" />

                            </dxg:TreeListView.NodeSummary>
                        </dxg:TreeListView>

                    </dxg:GridControl.View>
                    <dxg:GridColumn Header="Id"
                            Binding="{Binding Id}"
                         
                            Visible="False"
                          AllowSorting="false"
                            Width="auto" />
                    <dxg:GridColumn Header="Name"
                          VisibleIndex="2"
                             Image="{dx:DXImage Image=Accounting_16x16.png}"   
                            FieldName="accountName"
                                                  
AllowSorting="false"
                            Width="auto" />
                    <dxg:GridColumn Header="Type"
                            FieldName="accountType"
                           VisibleIndex="1"
                          
                    AllowSorting="false"                                     Image="{dx:DXImage Image=ShapeLabels_16x16.png}"

                            Width="auto" />
                    <dxg:GridColumn Header="isActive"
                            FieldName="isActive"                           
                             Image="{dx:DXImage Image=CheckBox_16x16.png}"   
VisibleIndex="15" AllowSorting="false"
                         
                           
                            Width="auto" />
                    <dxg:GridColumn Header="Account Number"
                            Binding="{Binding accountNo}"
                            Visible="False"
                            AllowSorting="false"

                            
                            
                            Width="auto" />
                    <dxg:GridColumn Header="Bank Account Number"
                            Binding="{Binding bankAccountNo}"
                            Visible="False"
                         AllowSorting="false"

                         
                            Width="auto" />
                    <dxg:GridColumn Header="Routing number"
                            Binding="{Binding routingNo}"
                          
                            Visible="False"
                            AllowSorting="false"

                      
                            Width="auto" />
                    <dxg:GridColumn Header="CreditCard number"
                            Binding="{Binding creditCardNo}"
                           AllowSorting="false"

                            Visible="False"
                            Width="auto" />

                    <dxg:GridColumn Header="Creation Date"
                            Binding="{Binding creationDate}"
                            VisibleIndex="1"
                            AllowSorting="false"
                            Visible="False"
                             Image="{dx:DXImage Image=Time_16x16.png}"

                            
                            Width="auto" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="f"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn Header="as of"
                            FieldName="openingBalanceTotalDate"
                          
                            Visible="False"                           

                         AllowSorting="false"
                            Width="auto" SortOrder="Ascending" SortIndex="0" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="F"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Creator"
                            Binding="{Binding user.userName}"
                             Image="{dx:DXImage Image=User_16x16.png}"
                           
                            VisibleIndex="3" 
                            AllowSorting="false"

                            Width="auto" />

                    <dxg:GridColumn Header="Debit Increase"
                            FieldName="isDebitIncrease"
                         
                            VisibleIndex="10"
                            Visible="False"     
                            AllowSorting="false"
                            Width="auto" />
                    <dxg:GridColumn Header="Company"
                            FieldName="Company"
                            Visible="True"
                            VisibleIndex="4"
                            UnboundType="String"
                            Image="{dx:DXImage Image=Home_16x16.png}"                      
                            Width="auto" />
                    <dxg:GridColumn Header="Department"
                            FieldName="Department"
                            Visible="True"
                            AllowSorting="false"
                            UnboundType="String"
                           VisibleIndex="5"
                             Image="{dx:DXImage Image=Home_16x16.png}"
      
                            Width="auto" />
                    <dxg:GridColumn Header="Currency"
                            Binding="{Binding Currency.CurrencyName}"
                            Visible="True"                            
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                            VisibleIndex="6"
                            AllowSorting="false"
                            Width="auto" />
                    <dxg:GridColumn FieldName="balanceOC"
                            ReadOnly="True"
                            VisibleIndex="7"
                            AllowSorting="false"
                            UnboundType="Decimal"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Balance (OC)" />

                    <dxg:GridColumn FieldName="balancePKR"
                            ReadOnly="True"
                            VisibleIndex="7"
                            AllowSorting="false"
                            UnboundType="Decimal"
                            Image="{dx:DXImage Image=Currency2_16x16.png}"
                          Header="Balance (PKR)" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn Header="Reconciled Date"
                            FieldName="reconcilationDate"
                            UnboundType="DateTime"
                            VisibleIndex="16"
                            AllowSorting="false"
                            Visible="True"                            
                             Image="{dx:DXImage Image=Time_16x16.png}"

                            Width="auto" />

                </dxg:GridControl>
            </Grid>
        </GroupBox>
        <Image
        x:Name="loadingGif"    
       
            
        Visibility="Hidden"
        Grid.Row="2"
            
         gif:AnimationBehavior.SourceUri="/ZAS_ERP;component/images/loadingReports.gif"   
        VerticalAlignment="Center"
        HorizontalAlignment="Center" RenderTransformOrigin="12.987,0.793" Margin="5,100,5,5" Width="60" />

        <dx:WaitIndicator x:Name="Loader"  DeferedVisibility="{Binding IsWaitIndicatorVisible}"  Content="{Binding WaitIndicatorText}">
            <dx:WaitIndicator.ContentTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" BorderBrush="PowderBlue" Padding="2" CornerRadius="6">
                        <StackPanel Orientation="Vertical"  >
                            <TextBlock Text="Please Wait"  FontSize="20"/>
                            <TextBlock Text="{Binding}" />
                        </StackPanel>
                    </Border>

                </DataTemplate>
            </dx:WaitIndicator.ContentTemplate>
        </dx:WaitIndicator>

    </Grid>
</Window>
