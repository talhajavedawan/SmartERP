<dx:DXWindow xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"  xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ChartofAccounts.UserControls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  x:Class="ZAS_ERP.ChartofAccounts.UserControls.ucClearTransaction"
             mc:Ignorable="d" 
              
             d:DesignHeight="150" MaxHeight="150" d:DesignWidth="400" MaxWidth="400" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontWeight="DemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Clear Transactions by Company and Department"/>
        <dxlc:LayoutGroup Grid.Row="1" >

            <dxlc:LayoutItem Label="Company" Margin="5,5,5,5">
                <dxg:LookUpEdit x:Name="lookupCompany"  
                                   
                                        Grid.Row="0"
                                        ToolTip="Company"
                                         Cursor="Hand"
                                    AutoPopulateColumns="True" 
                                    DisplayMember="CompanyName"
                                    IsTextEditable="False"
                                            SelectedIndexChanged="lookupCompany_SelectedIndexChanged"/>

            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Department" Margin="5,5,5,5">
                <dxg:LookUpEdit x:Name="lookupDepartment"
                          
                                        
                                      
                                        ToolTip="Department"
                                        Cursor="Hand"
                          TabIndex="6"
                          VerticalAlignment="Center"
                          AutoPopulateColumns="True"
                          DisplayMember="DeptName"
                         
                          SelectedIndexChanged="lookupDepartment_SelectedIndexChanged">
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>
                                <dxg:GridControl Name="PART_GridControl"
                                   AutoPopulateColumns="True"
                                   Grid.Row="1">
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView Name="treeListView1"
                                        ShowAutoFilterRow="True"
                                        TreeDerivationMode="Selfreference"
                                        KeyFieldName="Id"
                                        ParentFieldName="ParentID" />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="Id"
                                    x:Name="coldeptid"
                                    IsSmart="True"
                                    Visible="False" />
                                    <dxg:GridColumn x:Name="coldeptname"
                                    FieldName="DeptName"
                                    IsSmart="True" />
                                    <dxg:GridColumn x:Name="coldeptcode"
                                    FieldName="Code"
                                    IsSmart="True" />
                                    <dxg:GridColumn FieldName="Abbrivation"
                                    IsSmart="True"
                                    x:Name="coldeptabr"
                                    Visible="True" />
                                    <dxg:GridColumn FieldName="Timestamp"
                                    IsSmart="True"
                                    x:Name="coldeptts"
                                    Visible="False" />
                                </dxg:GridControl>
                            </Grid>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>

            </dxlc:LayoutItem>

        </dxlc:LayoutGroup>
        <dx:SimpleButton Content="Proceed"  Click="SimpleButton_Click"  Grid.Row="2" />
    </Grid>
</dx:DXWindow>
