<dxr:DXRibbonWindow xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" x:Class="ZAS_ERP.ExchangeRates.UserControls.ucExchangeRateAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.ExchangeRates.UserControls"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ShowTitle="True" Title="Add Exchange Rates" Loaded="UserControl_Loaded">


        <Grid>
            <Grid.ColumnDefinitions>
                
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>  
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

        <dx:SimpleButton x:Name="btnVoid" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" HorizontalAlignment="Left"  Glyph="{dx:DXImageGrayscale Image=Delete_32x32.png}" Content="Mark as Void" MinHeight="20"  Click="BtnVoid_Click"/>
            
        <TextBlock x:Name="lblHeading" Text="Add New Exchange Rates" Grid.Column="1"   
                   FontWeight="Bold"  
                   TextDecorations="underline"
                   FontStyle="Italic"                
                   Grid.ColumnSpan="3" FontSize="30"   
                   HorizontalAlignment="Center" Grid.Row="3" FontFamily="Segoe UI Semibold"  ></TextBlock>

        <dxlc:GroupBox Grid.Row="5"  Grid.Column="1"  ShowShadow="Always" Padding="2" Header="Exchange Rate Group Detail" DisplayMode="Normal" Grid.ColumnSpan="3" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>


                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Content="Select Type"/>
                <ComboBox x:Name="cmbExchangeTypes" Grid.Row="1" Grid.Column="3"/>
                <Label Grid.Row="1" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left" Content="Select Year"/>
                <dxe:SpinEdit HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="7"
                              x:Name="datEffectiveFrom" 
                              Value="2019"
                              VerticalAlignment="Center" 
                              MinValue="2000" 
                              MaxValue="2050" ></dxe:SpinEdit>
                <Label Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Content="Base Currency"/>
                <ComboBox x:Name="cmbBaseCurrencies"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                      Grid.Row="3"
                       >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                                <TextBlock Text="{Binding name}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Label Grid.Row="3" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left" Content="Transaction Currency"/>
                <ComboBox x:Name="cmbTransCurrencies"
                      Grid.Column="7"
                      VerticalAlignment="Center"
                      Grid.Row="3"
                     >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                                <TextBlock Text="{Binding name}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            </dxlc:GroupBox>
        <dxg:GridControl x:Name="grdExchangeRates"
            Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" ShowBorder="True">
            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                                               ShowGroupPanel="False"
                                               NewItemRowPosition="Bottom"
                                               AllowColumnFiltering="False"
                                               ShowHorizontalLines="True"
                                               ShowVerticalLines="True"
                                               x:Name="view">
                </dxg:TableView>
                </dxg:GridControl.View>
                <dxg:GridColumn FieldName="company"
                                            Header="Company"
                                            IsSmart="True"
                                            UnboundType="bound"
                                            SortOrder="Descending" SortIndex="0">
                    <dxg:GridColumn.DisplayTemplate>
                        <ControlTemplate>
                            <TextBlock Text="{Binding RowData.Row.company.CompanyName}"></TextBlock>
                        </ControlTemplate>
                    </dxg:GridColumn.DisplayTemplate>
                    <dxg:GridColumn.EditSettings>
                        <dxg:LookUpEditSettings x:Name="lookupCompanyGrid"
                                            AutoPopulateColumns="False"
                                            IsPopupAutoWidth="False"  
                                            DisplayMember="CompanyName"
                                            NullText="Select Item">
                            <dxg:LookUpEditSettings.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                        </Grid.RowDefinitions>

                                        <dxg:GridControl x:Name="PART_GridControl"
                                                                    ShowBorder="True"
                                                                    MaxHeight="300"
                                                                    Grid.Row="1">
                                            <dxg:GridColumn FieldName="CompanyName" />

                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEditSettings.PopupContentTemplate>
                        </dxg:LookUpEditSettings>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="rateJan"
                          Header=" January">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="rateFeb"
                          Header=" February">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="rateMar"
                          Header=" March">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="rateApr"
                          Header=" April">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="rateMay"
                          Header=" May">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="rateJun"
                          Header=" June">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="rateJul"
                          Header=" July">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="rateAug"
                          Header=" August">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="rateSep"
                          Header=" September">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="rateOct"
                          Header=" October">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="rateNov"
                          Header=" November">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
            <dxg:GridColumn FieldName="rateDec"
                          Header=" December">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
        </dxg:GridControl>

            <Button x:Name="btnSave" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4" FontWeight="DemiBold" ToolTip="Save Exchange Rate" Content="Save" Click="BtnSave_Click"/>
        </Grid>
</dxr:DXRibbonWindow> 
