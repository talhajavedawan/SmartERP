<dxr:DXRibbonWindow
    x:Class="ZAS_ERP.ExchangeRates.UserControls.ucExchangeRegister"
       xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Productss"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        WindowStartupLocation="CenterScreen"
        utilities:WindowUtilities.CloseOnEscape="True"
        mc:Ignorable="d"
        Title="Exchange Rates Register"    Height="450"
                 
        Width="700" WindowStyle="SingleBorderWindow" Loaded="DXRibbonWindow_Loaded" >
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <!--<ColumnDefinition Width=".7*" />
        <ColumnDefinition Width="auto" />-->
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="1.4*" />
                
            </Grid.RowDefinitions>
            <dxr:RibbonControl RibbonTitleBarVisibility="Collapsed"
                        RibbonStyle="OfficeSlim"
                            ToolbarShowMode="Hide"  
                        ShowApplicationButton="False" 
                        MinimizationButtonVisibility="Visible" PageCategoryAlignment="Left"
                               >
                <dxr:RibbonDefaultPageCategory Caption="{x:Null}">
                    <dxr:RibbonPage Caption="Exchange Rates">
                        <dxr:RibbonPageGroup Caption="{x:Null}" ShowCaptionButton="False"  >
                            <dxb:BarButtonItem x:Name="barNewRate" Content="New" ItemClick="BarNewRate_ItemClick" Glyph="{dx:DXImageGrayscale Image=Add_32x32.png}"/>
                            <dxb:BarButtonItem x:Name="barEditRate" Content="Edit" ItemClick="BarEditRate_ItemClick" Glyph="{dx:DXImageGrayscale Image=Edit_32x32.png}" />
                            <dxb:BarButtonItem x:Name="barVoidRates" Content="Void Rates" ItemClick="BarVoidRates_ItemClick" Glyph="{dx:DXImage Image=ListBox_32x32.png}"/>
                            <dxb:BarButtonItem x:Name="barRefreshRates" Content="Refresh" ItemClick="BarRefreshRates_ItemClick" Glyph="{dx:DXImageGrayscale Image=Refresh_32x32.png}" />
                            <dxb:BarButtonItem x:Name="barVoid" Content="Mark as Void/Un-Void" ItemClick="BarVoid_ItemClick" Glyph="{dx:DXImageGrayscale Image=Delete_32x32.png}" />
                            <dxb:BarButtonItem x:Name="barSaveLayout" Content="Save Layout" ItemClick="BarVoid_ItemClick" Glyph="{dx:DXImageGrayscale Image=Delete_32x32.png}" />
                        </dxr:RibbonPageGroup>
                    </dxr:RibbonPage>
                </dxr:RibbonDefaultPageCategory>
            </dxr:RibbonControl>

            <Grid  Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="lblHeading" Text="Exchange Rates Register"    
                   FontWeight="Bold"  
                  
                   FontStyle="Italic"                
                   Grid.ColumnSpan="3" FontSize="22"   
                   HorizontalAlignment="Center" Grid.Row="0" FontFamily="Segoe UI Semibold"  ></TextBlock>
                <dxg:GridControl x:Name="grdExchangesGroups"
                       AutoGenerateColumns="None"
                     Grid.Row="1"
                       SelectionMode="Row"
                                 
                       MouseDoubleClick="GrdExchangesGroups_MouseDoubleClick"
                       >
                    <dxg:GridControl.View>
                        <dxg:TableView ShowFixedTotalSummary="True" AllowGrouping="False" AutoWidth="True"  ShowGroupPanel="False" ShowTotalSummary="True"/>
                    </dxg:GridControl.View>
                    <dxg:GridControl.DetailDescriptor>
                        <dxg:DataControlDetailDescriptor ShowHeader="True"
                                         x:Name="grdExchangeGroupDet"
                                         ItemsSourcePath="exchangeRates">
                            <dxg:DataControlDetailDescriptor.DataControl>
                                <dxg:GridControl x:Name="grdExchangeRates" SelectionMode="Row" 
                                         
                                         dx:DXSerializer.SerializationID="grid" >
                                    <dxg:GridControl.View>
                                        <dxg:TableView DetailHeaderContent="All Rates"
                              
                                               ShowGroupPanel="False" 
                                               FilterRowDelay="1000"      
                                               RowAnimationKind="Opacity" WaitIndicatorType="Panel"
                                               AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                               ShowFixedTotalSummary="True"
                                               ShowTotalSummary="True"                
                                               HorizontalScrollbarVisibility="Visible"
                                               ShowHorizontalLines="True"
                                               ShowVerticalLines="True"      
                                               Width="auto"                 
                                               ColumnFilterPopupMode="Excel"  
                                               NavigationStyle="Row"
                                               AutoWidth="True"
                                               />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="Id"
                                                        Header="Id"
                                                        IsSmart="True"
                                                        VisibleIndex="0"
                                                
                                                        Visible="False"
                                                        ReadOnly="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings Mask="g" MaskUseAsDisplayFormat="True"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="company.CompanyName"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        VisibleIndex="4"
                                                        Header="Company"  >
                                    </dxg:GridColumn>

                                    <dxg:GridColumn FieldName="rateJan"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="January">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="rateFeb"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="February">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="rateMar"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="March">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="rateApr"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="April">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="rateMay"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="May">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="rateJun"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="June">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="rateJul"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="July">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="rateAug"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="August">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="rateSep"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="September">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="rateOct"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="October">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="rateNov"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="November">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="rateDec"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="December">
                                    </dxg:GridColumn>

                                </dxg:GridControl>

                            </dxg:DataControlDetailDescriptor.DataControl>
                        </dxg:DataControlDetailDescriptor>
                    </dxg:GridControl.DetailDescriptor>
                    <dxg:GridColumn FieldName="Id"
                                        x:Name="Id"
                                        IsSmart="True"      
                                        Header="Id"
                                        VisibleIndex="1"   
                                        ReadOnly="True"
                                Visible="False"
                                        AllowMoving="false"  
                                        AllowSorting="false" 
                                                   
                                        SortOrder="Ascending" SortIndex="0"/>
                    <dxg:GridColumn FieldName="ExchangeType"
                                        x:Name="ExchangeType"
                                        IsSmart="True"
                                        Header="Exchange Type"                            
                                        VisibleIndex="2"   
                                        AllowSorting="false" 
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        />
                    <dxg:GridColumn FieldName="Transaction_Currency.CurrencyName"
                                        x:Name="transactionCurrency"
                                        IsSmart="True"
                                        Header="Transaction Currency"
                                        VisibleIndex="3"       
                                        ReadOnly="True"
                                        AllowSorting="false" 
                                        AllowMoving="false"  
                                        Visible="True"
                                        />
                    <dxg:GridColumn FieldName="Base_Currency.CurrencyName"
                                        x:Name="baseCurrency"
                                        IsSmart="True"
                                        Header="Base Currency"
                                       
                                        VisibleIndex="3"       
                                        ReadOnly="True"
                                        AllowSorting="false" 
                                        AllowMoving="false"  
                                        Visible="True"/>
                    <dxg:GridColumn FieldName="Addedbyuser.userName"
                                        x:Name="addedBy"
                                        IsSmart="True"
                                        Header="Added By"
                                        VisibleIndex="4"       
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        AllowSorting="false" 
                                        >
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Editedbyuser.userName"
                                        x:Name="editedBy"
                                        IsSmart="True"
                                        Header="Edited By"
                                        VisibleIndex="5"      
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        AllowSorting="false" 
                                        >

                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="LastUpdated"
                                        x:Name="lastUpdated"
                                        IsSmart="True"
                                        Header="Last Updated"
                                        VisibleIndex="6"      
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        AllowSorting="false" 
                                        >

                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="TargetYear"
                                        x:Name="TargetYear"
                                        IsSmart="True"
                                        Header="Target Year"
                                        VisibleIndex="6"  
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        AllowSorting="false" 
                                        >

                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="isVoid"
                                        x:Name="isVoid"
                                        IsSmart="True"
                                        Header="isVoid"
                                        VisibleIndex="7"  
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        AllowSorting="false" 
                                        >

                    </dxg:GridColumn>

                </dxg:GridControl>
            </Grid>
            
        </Grid>
    </Grid>
</dxr:DXRibbonWindow> 
