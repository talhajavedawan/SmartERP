<Window xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        x:Class="ZAS_ERP.BussinessLogicss.frmSalesExchangeRateList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Productss"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        WindowStartupLocation="CenterScreen"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        mc:Ignorable="d"
        Title="List of Sales Exchange Rates"
        x:Name="winSalesExchangeRateList"
        Loaded="winSalesExchangeRateList_Loaded"
        Unloaded="WinSalesExchangeRateList_Unloaded"
        Height="450"
        Width="450">
  <Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width=".7*" />
        
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="1.4*" />
      </Grid.RowDefinitions>
      <Menu DockPanel.Dock="Top"
            x:Name="menuFormList"
            Grid.ColumnSpan="3">
                <MenuItem Header="_Target Rev Exchange Rate"
                  x:Name="mbtnSalesExchangeRate">
                    <MenuItem Header="Add new Target Rev Exchange Rate"
                    x:Name="mbtnNewSalesExchangeRate"
                    Click="mbtnNewSalesExchangeRate_Click"></MenuItem>
                    <MenuItem Header="Edit Target Rev Exchange Rate"
                    x:Name="mbtnEditSalesExchangeRate"
                    Click="mbtnEditSalesExchangeRate_Click"></MenuItem>
        </MenuItem>
                <MenuItem Header="Save Layout"
                          x:Name="mbtnSaveLayout"
                          Click="MbtnSaveLayout_Click"></MenuItem>
      </Menu>
     
      <dxg:GridControl x:Name="grdSalesExchangeRate"
                       AutoGenerateColumns="None"
                       Grid.Row="1"
                       Grid.Column="2"
                       SelectionMode="Row"
                       MouseDoubleClick="grdSalesExchangeRate_MouseDoubleClick"
                       
                       >
        <dxg:GridControl.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Add New"
                      x:Name="btnNewSalesExchangeRate"
                      Click="mbtnNewSalesExchangeRate_Click" />
            <MenuItem Header="Edit"
                      x:Name="btnEditSalesExchangeRate"
                      Click="mbtnEditSalesExchangeRate_Click" />
          </ContextMenu>
        </dxg:GridControl.ContextMenu>
                <dxg:GridColumn Header="Company"
                            FieldName="company.CompanyName"
                            IsSmart="True"
                             />
                <dxg:GridColumn Header="Base Currency"
                            FieldName="Base_Currency.CurrencyName"
                            IsSmart="True"
                             />
                <dxg:GridColumn Header=" Tareget Currency"
                            FieldName="Target_Currency.CurrencyName"
                            IsSmart="True"
                             />
                <dxg:GridColumn Header=" Effective From"
                            FieldName="effectiveFrom"
                            IsSmart="True"
                             />
                <dxg:GridColumn Header=" Effective To"
                            FieldName="effectiveTo"
                            IsSmart="True"
                             />
                <dxg:GridColumn Header=" Exchange Rate"
                            FieldName="exchangerate"
                            IsSmart="True"
                             />
                <dxg:GridColumn Header=" Last Updated"
                            FieldName="LastUpdated"
                            IsSmart="True"
                             />
                <dxg:GridColumn Header=" Last Updated"
                            FieldName="LastUpdated"
                            IsSmart="True"
                             />
            </dxg:GridControl>
     
    </Grid>
  </Grid>
</Window>
