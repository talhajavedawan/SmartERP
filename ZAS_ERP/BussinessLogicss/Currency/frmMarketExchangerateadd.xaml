<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.BussinessLogicss"
        xmlns:Validations="clr-namespace:ZAS_ERP.Validations"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        x:Class="ZAS_ERP.BussinessLogicss.frmMarketExchangeRateadd"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        utilities:WindowUtilities.CloseOnEscape="True"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="Market Exchange Rate"
        Height="380"
        Width="500" Loaded="winExchangeRateadd_Loaded"
        x:Name="winExchangerateadd" Closing="winExchangeRateadd_Closing">
  <Grid Margin="0,20,0,0" >
    <Grid.Resources>
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="DarkGray" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Setter Property="Margin"
                Value="10,10" />
      </Style>
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Margin"
                Value="10,5" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
      </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Width=".7*" />
      <ColumnDefinition Width="auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
      <RowDefinition Height="50" />
    </Grid.RowDefinitions>
        <dxg:LookUpEdit x:Name="lookupCompany"
                          Grid.Column="1"
                          Grid.Row="0"
                          TabIndex="1"
                          DisplayMember="CompanyName"
                          AutoPopulateColumns="False"
                          VerticalAlignment="Center"
                          SelectedIndexChanged="lookupCompany_SelectedIndexChanged">
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings />
            </dxg:LookUpEdit.StyleSettings>
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <!--<Button x:Name="btnAddCompany"
                            Click="btnAddCompany_Click"
                            VerticalAlignment="Center"
                            Content="Add New" />-->
                        <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView Name="tableView1"
                                     ShowAutoFilterRow="True" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                            <dxg:GridColumn FieldName="CompanyName"
                                    IsSmart="True" />
                            <!--<dxg:GridColumn FieldName="IndustryType"
                                      IsSmart="True"
                                      Visible="False" />-->
                            <dxg:GridColumn x:Name="colBizType"
                                    FieldName="BizType"
                                    Visible="False"
                                    IsSmart="True" />
                            <dxg:GridColumn FieldName="EmployeerNo"
                                    x:Name="colEmployeerNo"
                                    IsSmart="True"
                                    Visible="False" />
                            <!--<dxg:GridColumn FieldName="addressId"
                                      x:Name="coladressId"
                                      IsSmart="True"
                                      Visible="False" />
                      <dxg:GridColumn FieldName="address"
                                      IsSmart="True"
                                      x:Name="coladress"
                                      Visible="False" />
                      <dxg:GridColumn FieldName="contactId"
                                      Visible="False"
                                      x:Name="colcontactId"
                                      IsSmart="True" />-->
                            <!--<dxg:GridColumn FieldName="contact"
                                      x:Name="colcontact"
                                      IsSmart="True"
                                      Visible="False" />-->
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>
        <TextBlock VerticalAlignment="Center"
                     Grid.Row="0"
                     Text="Company" />



        <TextBlock Grid.Column="0"
                       x:Name="lblbaseCurrency"
                       Grid.Row="3">
               Target Currency</TextBlock>
        <ComboBox x:Name="cmbbaseCurrency"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Grid.Row="1"
                IsEnabled="True"
                       >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="0"
                       x:Name="lblCurrency"
                       Grid.Row="1">
               Orignal Currency</TextBlock>
        <ComboBox x:Name="cmbCurrency"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Grid.Row="3"
                      TabIndex="24"
                      SelectionChanged="cmbCurrency_SelectedIndexChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <dxe:TextEdit x:Name="txtexchangerate"
                     Text="1" 
                     VerticalAlignment="Center"
                     Grid.Column="1"
                     TabIndex="23" MaskType="Numeric" Mask="n4"
                     Grid.Row="2"></dxe:TextEdit>
        <TextBlock VerticalAlignment="Center"
                       Grid.Column="0"
                       Grid.Row="2"
                       Text="Exchange Rate"
                       x:Name="lblexchangerate" />
        <!--<TextBlock Text="Variation %"
               Grid.Row="4" />

        <dxe:TextEdit x:Name="txtVariationPercent"
                     Text="0" 
                     VerticalAlignment="Center"
                     Grid.Column="1"
                     TabIndex="23" MaskType="Numeric" Mask="n"
                     Grid.Row="4"></dxe:TextEdit>-->
        <TextBlock Text="Effective From"
               Grid.Row="6" />
        <dxe:DateEdit Grid.Column="1"
             Grid.Row="6" x:Name="datEffectiveFrom" 
             VerticalAlignment="Center" />
        <TextBlock Text="Effective To"
               Grid.Row="7" />
        <dxe:DateEdit Grid.Column="1"
             Grid.Row="7" x:Name="datEffectiveTo" 
             VerticalAlignment="Center" />
 
        <Button Content="Save"
            Grid.Row="9"
            FontSize="24"
            x:Name="btnSave"
            Click="btnSaveExchangeRate_Click"
            FontWeight="Medium"
            Grid.ColumnSpan="3"  />
  </Grid>
</Window>
