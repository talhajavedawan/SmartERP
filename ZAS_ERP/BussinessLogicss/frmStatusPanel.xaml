<Window x:Class="ZAS_ERP.BussinessLogicss.frmStatusPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.BussinessLogicss"
        mc:Ignorable="d"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        Title="frmStatusPanel" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
    
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width=".3*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
    <ListBox x:Name="lsttransactions" Margin="10"
             SelectionChanged="lsttransactions_SelectionChanged">
      <ListBoxItem x:Name="lstitemInquiry"
                   Content="Inquiry Statuses"></ListBoxItem>
      <ListBoxItem x:Name="lstitemOffer"
                   Content="Offer Statuses"></ListBoxItem>
            <ListBoxItem x:Name="lstitemSO"
                   Content="Sale Order Statuses"></ListBoxItem>
            <ListBoxItem x:Name="lstitemPO"
                   Content="Purchase Order Statuses"></ListBoxItem>
    </ListBox>
    <Grid x:Name="gridStatus"  Grid.Column="1"/>
  </Grid>
</Window>
