<UserControl x:Class="ZAS_ERP.BackgroundUpload.ucFrmBackgroundGroupList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.BackgroundUpload"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" 
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxm="http://schemas.devexpress.com/winfx/2008/xaml/map"
             mc:Ignorable="d" Loaded="UserControl_Loaded" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!--<Style x:Key="Chromeless" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border BorderThickness="0" Width="40" Height="40">
                            <ContentPresenter/>
                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>-->

        <Style x:Key="RoundCorner" TargetType="{x:Type Button}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="grid">
                            <Border x:Name="border" CornerRadius="22" BorderBrush="Black" BorderThickness="1">
                                <Border.Background>
                                    <RadialGradientBrush GradientOrigin="0.496,1.052">
                                        <RadialGradientBrush.RelativeTransform>
                                            <TransformGroup>
                                                <ScaleTransform CenterX="0.5" CenterY="0.5" 
                                                        ScaleX="1.5" ScaleY="1.5"/>
                                                <TranslateTransform X="0.02" Y="0.3"/>
                                            </TransformGroup>
                                        </RadialGradientBrush.RelativeTransform>
                                        <GradientStop Offset="1" Color="#bed6f6"/>
                                        <GradientStop Offset="0.3" Color="#bed6f6"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontWeight="Bold">
                                </ContentPresenter>
                            </Border>

                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border">
                                    <Setter.Value>
                                        <RadialGradientBrush GradientOrigin="0.496,1.052">
                                            <RadialGradientBrush.RelativeTransform>
                                                <TransformGroup>
                                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1.5" ScaleY="1.5"/>
                                                    <TranslateTransform X="0.02" Y="0.3"/>
                                                </TransformGroup>
                                            </RadialGradientBrush.RelativeTransform>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                            <GradientStop Color="#FF303030" Offset="0.3"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#FF33962B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="grid" Value="0.25"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        
        <dxr:RibbonControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" DockPanel.Dock="Top"  RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
            <dxr:RibbonDefaultPageCategory>
                <dxr:RibbonPage x:Name="lblHeading"  ToolTip="Background Groups">
                    <dxr:RibbonPage.Caption>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/ZAS_ERP;component/images/UserGroup_32x32.png" Width="20" Height="20"/>
                            <TextBlock x:Name="txtGrpName" Text="Group 1" VerticalAlignment="Center" FontWeight="Bold" Margin="5 0 0 0" Foreground="Green"/>
                        </StackPanel>
                    </dxr:RibbonPage.Caption>
                    <dxr:RibbonPageGroup  Caption="Clipboard">
                        <dxb:BarButtonItem x:Name="mbtnAddNew" Content="Add New Group" ItemClick="MbtnAddNew_ItemClick" Glyph="{dx:DXImage Image=AddNewDataSource_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                        <dxb:BarButtonItem x:Name="mbtnUpdate" Content="Update Group" ItemClick="MbtnUpdate_ItemClick" Glyph="{dx:DXImage Image=EditDataSource_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                        <dxb:BarButtonItem x:Name="mbtnSaveLayout" Content="Save Layout" ItemClick="MbtnSaveLayout_ItemClick" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>
                        <!--<dxb:BarButtonItem x:Name="btnRename" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_32x32.png}" />-->
                        <dxb:BarButtonItem x:Name="mbtnDelete" Content="Delete" ItemClick="MbtnDelete_Click" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>
                        <dxb:BarButtonItem x:Name="mbtnRefresh" Content="Refresh Groups" ItemClick="MbtnRefresh_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                        

                        <dxb:BarButtonItem ToolTip="Expand" x:Name="mbtnExpand" Content="Expand" ItemClick="MbtnExpand_ItemClick" Glyph="{dx:DXImage Image=Stretch_32x32.png}" LargeGlyph="{dx:DXImage Image=Stretch_32x32.png}"/>
                        <dxb:BarButtonItem ToolTip="Collapse" x:Name="mbtnCollapse" Content="Collapse" ItemClick="MbtnCollapse_ItemClick" Glyph="{dx:DXImage Image=Squeeze_32x32.png}" LargeGlyph="{dx:DXImage Image=Squeeze_32x32.png}"/>
                       
                    </dxr:RibbonPageGroup>
                   
                </dxr:RibbonPage>

            </dxr:RibbonDefaultPageCategory>
        </dxr:RibbonControl>


        <Border BorderBrush="DeepSkyBlue" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Grid.Row="2" Margin="2 2 0 3">
            <dxg:GridControl x:Name="grdCntrlGroupList" Visibility="Visible" Grid.Row="2" AutoGenerateColumns="AddNew"    
                         SelectedItemChanged="GrdCntrlGroupList_SelectedItemChanged"
            EnableSmartColumnsGeneration="True">

                <dxg:GridControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="mbtnAddNewGroup" Header="Add New Group" Click="BtnAddItem_Click"/>
                        <MenuItem x:Name="mbtnUpdateNewGroup" Header="Update Group" Click="MenuGroupUpdate_Click"/>
                        <MenuItem x:Name="mbtnDeleteNewGroup" Header="Delete Group Images" Click="MenuItemDeleteGroup_Click" IsEnabled="True"/>
                        <MenuItem x:Name="mbtnViewGroupImage" Header="Uploaded History" Click="mbtnViewGroupImage_Click"/>
                    </ContextMenu>
                </dxg:GridControl.ContextMenu>
                <dxg:GridControl.View>
                    <dxg:TreeListView
                        x:Name="tblGroupListView" 
                            ShowSearchPanelFindButton="True"
                    ShowSearchPanelMode="Always"
                            KeyFieldName="Id"
                        ParentFieldName="parentId"
                    CustomUnboundColumnData="tblGroupListView_CustomUnboundColumnData"
                    ShowIndicator="False"
                        
                 
                    />
                </dxg:GridControl.View>

                <dxg:GridColumn FieldName="creationDate"
                                    Header="Creation Date"
                                    VisibleIndex="0"
                                    AllowEditing="false"
                                Visible="False"/>

                <dxg:GridColumn FieldName="GroupName" Image="{dx:DXImage Image=Team_16x16.png}"
                                    Header="Group Name"
                                    VisibleIndex="1"
                                    AllowEditing="false"/>

                <!--<dxg:GridColumn FieldName="comp" Image="{dx:DXImage Image=Home_16x16.png}"
                                    Header="Company Name"
                                    VisibleIndex="2"
                                    AllowEditing="false" UnboundType="String"/>
            <dxg:GridColumn FieldName="dept" Image="{dx:DXImage Image=BO_Department.png}"
                                    Header="Department Name"
                                    VisibleIndex="3"
                                    AllowEditing="false" UnboundType="String"/>

            <dxg:GridColumn FieldName="emp" Image="{dx:DXImage Image=User_16x16.png}"
                                    Header="Employee Name"
                                    VisibleIndex="4" Width="auto"
                                    AllowEditing="false" UnboundType="String"/>-->




                <dxg:GridColumn FieldName="Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="GroupCreatorId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="GroupCreator" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="users" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="parentId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="parentGroup" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="isBackground" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            </dxg:GridControl>
        </Border>
           

     

        <!--<dx:SimpleButton x:Name="btnSave" Click="btnSave_Click" FontWeight="DemiBold" Grid.Row="2" Content="Add" FontSize="20"/>-->




        <Border BorderBrush="DeepSkyBlue" Background="#bed6f6" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Grid.Row="1" Height="30">
            
       
        <Grid Grid.Row="1"   >
            <StackPanel Orientation = "Horizontal" HorizontalAlignment="Center">
                <Image Source="/ZAS_ERP;component/images/Team_32x32.png" Width="24" Height="24"  />
                <Label Content="Background Group List" HorizontalAlignment="Center" FontWeight="Bold" />
            </StackPanel>
           
        
        </Grid>

        </Border>

        <Border BorderBrush="DeepSkyBlue" Background="#bed6f6" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Grid.Row="1" Grid.Column="4" Height="30">
            
        
            <Grid Grid.Row="1"  Grid.Column="4">
            <StackPanel Orientation = "Horizontal" HorizontalAlignment="Center">
                    <Image Source="/ZAS_ERP;component/images/UserGroup_32x32.png" Width="20" Height="20" Margin="0 0 5 0"/>
                    <TextBlock x:Name="lblData" Text="Group" VerticalAlignment="Center" FontWeight="Bold"  Foreground="Black"/>
            </StackPanel>


        </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="2" >
           
            <Label Content="[Background Wallpaper Engine]" HorizontalAlignment="Center" Grid.Column="1" FontWeight="Bold" FontSize="12" Foreground="Green"/> 
        </Grid>

        <Border BorderBrush="DeepSkyBlue" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Grid.Row="2" Grid.Column="4" Margin="0 2 0 0">
            
     
        <Grid Grid.Row="2" Grid.Column="4" x:Name="groupDataGrid">
           
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                  
                    <RowDefinition Height="*"/>
                   
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <dxg:GridControl x:Name="grdCntrlSelectedUser" 
                                 Margin="0 0 0 0"
                                  Grid.Row="2"
                                 AutoGenerateColumns="None"
                                 
                                 SelectionMode="Row"
                                 AllowInitiallyFocusedRow="False">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tblViewSelectedUser"    
                                       ShowAutoFilterRow="True"
                                        AutoWidth="True"
                                       ShowGroupPanel="False"
                                        ShowIndicator="False"      
                                        IsSynchronizedWithCurrentItem="True"
                                        AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True"
                                  
                               >

                        </dxg:TableView>
                    </dxg:GridControl.View>


                    <dxg:GridColumn FieldName="id"
                                    x:Name="colIdList"
                                    IsSmart="True"
                                    Visible="False">
                     
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="coluserNameList"
                                    FieldName="userName"
                                    Header="User Name"
                                    IsSmart="True">
                      

                    </dxg:GridColumn>
                    <dxg:GridColumn MaxWidth="40" Header="Photo" VisibleIndex="0" FieldName="employee.person.Photo" HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ImageEditSettings ShowMenu="False" MaxWidth="40" HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControl>

                <dxg:GridControl x:Name="grdCntrlSelectedComp" 
                                  Margin="0 0 0 3"
                                 AutoGenerateColumns="None"
                                 Grid.Row="0"
                                 SelectionMode="Row"
                                 AllowInitiallyFocusedRow="False">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tblViewSelectedComp"
                                           ShowAutoFilterRow="True"
                                        
                                                  AutoWidth="True"
                                ShowGroupPanel="False"
                                                ShowIndicator="False" 
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                 
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True"
                                   
                               >

                        </dxg:TableView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn FieldName="id"
                                   
                                    IsSmart="True"
                                    Visible="False"/>

                    <dxg:GridColumn
                                    FieldName="CompanyName"
                                    Header="Companies"
                                    IsSmart="True"/>
                </dxg:GridControl>

                <dxg:GridControl x:Name="grdCntrlSelectedDept" 
                                Margin="0 0 0 3"
                                 Grid.Row="1"
                                 AutoGenerateColumns="None"
                                 
                                 SelectionMode="Row"
                                 AllowInitiallyFocusedRow="False">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tblViewSelectedDept"
                                           ShowAutoFilterRow="True"
                                        
                                                  AutoWidth="True"
                               
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowGroupPanel="False"
                                                ShowIndicator="False" 
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True"
                                   
                               >

                        </dxg:TableView>
                    </dxg:GridControl.View>


                    <dxg:GridColumn
                                    FieldName="DeptName"
                                    Header="Departments"
                                    IsSmart="True"/>
                </dxg:GridControl>

            </Grid>
        </Grid>
        </Border>
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
                
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/> 
                </Grid.ColumnDefinitions>
                <dx:SimpleButton  Grid.Column="0"  FontWeight="DemiBold" FontSize="12" x:Name="btnUpload" Click="btnUpload_Click" Margin="0 0 5 0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/ZAS_ERP;component/images/coaAdd.png" Width="19" Height="19" Margin="0,0,5,0"/>
                        <TextBlock Text="Upload" Grid.Column="1" Foreground="Green">
                          
                          
                        </TextBlock>
                    </Grid>
                        
                      
                  
                </dx:SimpleButton>
                <dx:SimpleButton Grid.Column="1"  FontWeight="DemiBold" FontSize="12" x:Name="btnPreview" Click="btnPreview_Click" Margin="0 0 5 0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/ZAS_ERP;component/images/Show_32x32.png" Width="19" Height="19"  Margin="0,0,5,0"/>
                        <TextBlock Text="Preview" Grid.Column="1" Foreground="Green"/>
                    </Grid>
                </dx:SimpleButton>
                <dx:SimpleButton  Grid.Column="2"  FontWeight="DemiBold" FontSize="12" x:Name="btnApply" Click="btnApply_Click" Margin="0 0 5 0" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/ZAS_ERP;component/images/todo.png" Width="19" Height="19"  Margin="0,0,5,0"/>
                        <TextBlock Text="Apply" Grid.Column="1" Foreground="Green"/>
                    </Grid>
                </dx:SimpleButton>
                <dx:SimpleButton  Grid.Column="3"  FontWeight="DemiBold" FontSize="12" x:Name="btnInstantChange" Click="btnInstantChange_Click" Margin="0 0 5 0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{dx:DXImage Image=RefreshAllPivotTable_32x32.png}" Width="19" Height="19"  Margin="0,0,5,0"/>
                        <TextBlock Text="Instant Change" Grid.Column="1" Foreground="Green"/>
                    </Grid>

                </dx:SimpleButton>
                <dx:SimpleButton  Grid.Column="4"  FontWeight="DemiBold" FontSize="12" x:Name="btnUploadHistory" Click="btnUploadHistory_Click" Margin="0 0 5 0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{dx:DXImage Image=State_Validation_Information_48x48.png}" Width="19" Height="19"  Margin="0,0,5,0"/>
                        <TextBlock Text="Uploaded Detail" Grid.Column="1" Foreground="Green"/>
                    </Grid>
                </dx:SimpleButton>

            </Grid>
            <Border Grid.Row="1"  BorderThickness="2"   BorderBrush="DeepSkyBlue" Margin="1,10,2,6" >
                <!--<Border.Style>
                    <Style TargetType="Border">


                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="13" Color="Blue" ShadowDepth="0"/>
                            </Setter.Value>
                        </Setter>


                    </Style>
                </Border.Style>-->
               
                 
                    <Grid x:Name="grdImagePreview" Background="#bed6f6" Margin="0,0,0,0">
                   
                </Grid>

                   
                
            </Border>
           
         

        </Grid>
   

    </Grid>
</UserControl>
