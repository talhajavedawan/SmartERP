<UserControl x:Class="ZAS_ERP.BackgroundUpload.ucSelectOption"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.BackgroundUpload"
              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
              d:DesignHeight="250" d:DesignWidth="400">
    <Grid>
        <dxlc:LayoutGroup Header="Background" 
                          View="GroupBox" 
                         dx:ThemeManager.ThemeName="DeepBlue">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>


                <TextBlock Text="Please Select from the below Options"
                            Foreground="#05628e"
                        VerticalAlignment="Center"                      
                        HorizontalAlignment="Center"   
                         FontFamily="Century Gothic"
                         FontSize="14"
                         FontStretch="UltraExpanded"
                         FontStyle="Italic"
                         FontWeight="UltraBold"
                           
                        
                          
                           Grid.ColumnSpan="2" 
                          />

                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="Share All" 
                         GroupName="Select"
                         FontStyle="Italic" Grid.Column="1"
                    Grid.Row="0"
                    Foreground="#05628e"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                    FontWeight="DemiBold"
                    x:Name="btnShareAll"
                   />
                    <RadioButton Content="Set Specific" 
                         GroupName="Select"
                         FontStyle="Italic" Grid.Column="1"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Grid.Row="1"
                         Foreground="#05628e"
                         FontWeight="DemiBold"
                         x:Name="btnSetSpecific"
                         />
                    <RadioButton Content="Set Groups" 
                         GroupName="Select"
                         FontStyle="Italic" Grid.Column="1"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Grid.Row="2"
                         Foreground="#05628e"
                         FontWeight="DemiBold"
                         x:Name="btnSetGroups"
                         />

                </Grid>


                <!--<dxe:ComboBoxEdit x:Name="cmbxModules" Grid.Row="1" Grid.ColumnSpan="2"  Width="250" Height="22" HorizontalAlignment="Center"/>-->

                <Button x:Name="btnContinue" Click="BtnContinue_Click" FontWeight="DemiBold" Grid.ColumnSpan="2" Grid.Row="2" Content="Continue"/>
            </Grid>
        </dxlc:LayoutGroup>
    </Grid>
</UserControl>
