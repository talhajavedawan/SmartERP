<UserControl x:Class="ZAS_ERP.BackgroundUpload.ucFrmGroupListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.BackgroundUpload" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="400" d:DesignWidth="900">
    <UserControl.Resources>
        <!--<Style x:Key="Chromeless" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border BorderThickness="0" Width="40" Height="40">
                            <ContentPresenter/>
                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>-->

        <Style x:Key="FocusedCellStyle" TargetType="dxg:LightweightCellEditor">
            <Style.Triggers>
                <Trigger Property="dxg:DataViewBase.IsFocusedCell" Value="True">
                    <Setter Property="Background" Value="LightGreen" />
                    <Setter Property="Foreground" Value="DarkGreen" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FocusedRowStyle" TargetType="dxg:RowControl">
            <Style.Triggers>
                <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True">
                    <Setter Property="Background" Value="Gray" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProgressBarStyle" TargetType="dxe:ProgressBarEditSettings">
            <Setter Property="ContentDisplayMode" Value="Value"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Black" HorizontalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="RoundCorner" TargetType="{x:Type Button}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="grid">
                            <Border x:Name="border" CornerRadius="8" BorderBrush="Black" BorderThickness="2">
                                <Border.Background>
                                    <RadialGradientBrush GradientOrigin="0.496,1.052">
                                        <RadialGradientBrush.RelativeTransform>
                                            <TransformGroup>
                                                <ScaleTransform CenterX="0.5" CenterY="0.5" 
                                                        ScaleX="1.5" ScaleY="1.5"/>
                                                <TranslateTransform X="0.02" Y="0.3"/>
                                            </TransformGroup>
                                        </RadialGradientBrush.RelativeTransform>
                                        <GradientStop Offset="1" Color="#00000000"/>
                                        <GradientStop Offset="0.3" Color="#FFFFFFFF"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontWeight="Bold">
                                </ContentPresenter>
                            </Border>

                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border">
                                    <Setter.Value>
                                        <RadialGradientBrush GradientOrigin="0.496,1.052">
                                            <RadialGradientBrush.RelativeTransform>
                                                <TransformGroup>
                                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1.5" ScaleY="1.5"/>
                                                    <TranslateTransform X="0.02" Y="0.3"/>
                                                </TransformGroup>
                                            </RadialGradientBrush.RelativeTransform>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                            <GradientStop Color="#FF303030" Offset="0.3"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#FF33962B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="grid" Value="0.25"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#bed6f6">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="*"/>
                <!--<ColumnDefinition Width="*"/>-->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Group Name:" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBox  x:Name="txtItemTitle" Grid.Column="1" Height="23" Grid.Row="0" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="10 0 10 0">
                <TextBox.BorderBrush>
                    <LinearGradientBrush EndPoint="1,1" StartPoint="1,0">
                        <GradientStop Color="Green" Offset="1"/>
                        <GradientStop Color="Green" Offset="0.75"/>
                        <GradientStop Color="Green" Offset="0.75"/>
                        <GradientStop Color="Green" Offset="1"/>
                    </LinearGradientBrush>
                </TextBox.BorderBrush>
            </TextBox>
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="colCompWidth"/>
                <ColumnDefinition Width="*" x:Name="colDeptWidth" />
                <ColumnDefinition Width="*"/>
               
            </Grid.ColumnDefinitions>

            <dxg:GridControl x:Name="grdCntrlCompanies"  Margin="10 0 10 10"
                             AutoGenerateColumns="None"
                            
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">

                <dxg:GridControl.View>
                    <dxg:TreeListView x:Name="gridCompanyView"
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True"
                                                  ShowAutoFilterRow="True">
                    </dxg:TreeListView>
                </dxg:GridControl.View>

                <dxg:GridColumn FieldName="Id"
                              x:Name="colCategoryId"
                              IsSmart="True"
                              Visible="False"/>

                <dxg:GridColumn x:Name="colCompanyName"
                              FieldName="CompanyName"
                                            Header="Company"
                              IsSmart="True"/>

            </dxg:GridControl>

            <dxg:GridControl x:Name="gridDepartment"  Margin="10 0 10 10"
                             AutoGenerateColumns="None"
                             Grid.Column="1"
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">
               
                <dxg:GridControl.View>
                    <dxg:TreeListView x:Name="griddeptview"
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True"
                                  ShowAutoFilterRow="True"               >
                    
                    </dxg:TreeListView>
                </dxg:GridControl.View>
                <dxg:GridColumn FieldName="Id"
                              x:Name="coldeptid"
                              IsSmart="True"
                              Visible="False" />
                <dxg:GridColumn x:Name="coldeptname"
                              FieldName="DeptName"
                              IsSmart="True" />
                <dxg:GridColumn x:Name="coldeptcode"
                              FieldName="Code"
                              IsSmart="True" />
                <dxg:GridColumn FieldName="Abbrivation"
                              IsSmart="True"
                              x:Name="coldeptabr"
                              Visible="False" />
                <dxg:GridColumn FieldName="Timestamp"
                              IsSmart="True"
                              x:Name="coldeptts"
                              Visible="False" />
                <dxg:GridColumn FieldName="sectionId"
                              IsSmart="True"
                              Visible="False" />
                <dxg:GridColumn FieldName="sections"
                              IsSmart="True"
                              Visible="False" />
            </dxg:GridControl>

            <dxg:GridControl x:Name="grdCntrlUsers" 
                                 Margin="10 0 10 10"
                                 Grid.Column="2"
                                 AutoGenerateColumns="None"
                                 
                                 SelectionMode="MultipleRow"
                                 AllowInitiallyFocusedRow="False">
                <dxg:GridControl.View>
                    <dxg:TreeListView x:Name="gridUsersView"
                                          AutoWidth="True"
                                          KeyFieldName="id"
                                          TreeDerivationMode="Selfreference"
                                          AutoExpandAllNodes="True"
                                          IsSynchronizedWithCurrentItem="True"
                                          AllowEditing="False"
                                          ShowCheckboxes="True"
                                          UseIndicatorForSelection="True"
                                          FadeSelectionOnLostFocus="False"
                                          ShowSelectionRectangle="True"       
                                          ShowAutoFilterRow="True">
                    </dxg:TreeListView>
                </dxg:GridControl.View>

                <dxg:GridColumn FieldName="id"
                                    x:Name="colId"
                                    IsSmart="True"
                                    Visible="False"/>

                <dxg:GridColumn x:Name="coluserName"
                                    FieldName="userName"
                                    Header="User"
                                    IsSmart="True"/>

                <dxg:GridColumn 
                                    FieldName="employee.empFunction.Title"
                                    Header="Function"
                                    IsSmart="True"
                    VisibleIndex="2"/>
            </dxg:GridControl>
            <dxg:GridControl x:Name="grdCntrlUsersList" 
                                 Margin="10 0 10 10"
                                 Grid.Column="0"
                                 AutoGenerateColumns="None"
                                 
                                 SelectionMode="Row"
                                 AllowInitiallyFocusedRow="False">
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="gridUsersViewList"
                                           ShowAutoFilterRow="True"
                                        
                                                  AutoWidth="True"
                               
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                 
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True"
                                    CellStyle="{StaticResource FocusedCellStyle}" 
                               RowStyle="{StaticResource FocusedRowStyle}">

                        <!--<dxg:TableView.RowStyle>
                            <Style TargetType="dxg:RowControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                                        <Setter Property="Background" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxg:TableView.RowStyle>-->

                    </dxg:TableView>
                </dxg:GridControl.View>

                <dxg:GridColumn FieldName="id"
                                    x:Name="colIdList"
                                    IsSmart="True"
                                    Visible="False"/>

                <dxg:GridColumn x:Name="coluserNameList"
                                    FieldName="userName"
                                    Header="Users List"
                                    IsSmart="True"/>
                <dxg:GridColumn 
                                    FieldName="employee.empFunction.Title"
                                    Header="Function"
                                    IsSmart="True"
                    VisibleIndex="2"/>
            </dxg:GridControl>
            <dxg:GridControl x:Name="grdCntrlUsersSelectedList" 
                                 Margin="10 0 10 10"
                                 Grid.Column="2"
                                 AutoGenerateColumns="None"
                                 
                                 SelectionMode="Row"
                                 AllowInitiallyFocusedRow="False">
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="gridUsersViewSelectedList"
                                          ShowAutoFilterRow="True"
                                        
                                                  AutoWidth="True"
                               
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                 
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">
                    </dxg:TableView>
                </dxg:GridControl.View>

                <dxg:GridColumn FieldName="id"
                                   
                                    IsSmart="True"
                                    Visible="False"/>

                <dxg:GridColumn 
                                    FieldName="userName"
                                    Header="Selected User"
                                    IsSmart="True"/>

                <dxg:GridColumn 
                                    FieldName="employee.empFunction.Title"
                                    Header="Function"
                                    IsSmart="True"
                    VisibleIndex="2"/>
            </dxg:GridControl>

            <dx:SimpleButton ToolTip="Insert To Selected Employee" Grid.Column="1" FontWeight="Bold"  Height="30" Width="80" x:Name="btnLeftMove" Click="btnLeftMove_Click" Margin="5,5,5,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/ZAS_ERP;component/images/Forward_32x32.png"  Margin="0,0,5,0"/>




                </Grid>



            </dx:SimpleButton>
            <dx:SimpleButton ToolTip="Remove From Selected Employee"   Grid.Column="1"  Height="30" Width="80" FontWeight="Bold"  x:Name="btnRightMove" Click="btnRightMove_Click" Margin="5,95,5,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/ZAS_ERP;component/images/Backward_32x32.png" Margin="0,0,5,0"/>
                </Grid>



            </dx:SimpleButton>


            <Border BorderBrush="Green" BorderThickness="2"  CornerRadius="4" Grid.Column="3" Panel.ZIndex="6"  Visibility="Collapsed" Padding="10"  x:Name="grdHelp" Margin="20,0,20,20" HorizontalAlignment="Right">
                <Border.Background>
                    <SolidColorBrush Color="Azure" Opacity="1" />
                </Border.Background>

                <Grid   >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                <Label Content="Step 1: Please enter a group name e.g (Abc)"/>
                    <Label Grid.Row="1" Content="Step 2: Please mark tick[Has parent] to &#10; enable parent groups "/>
                <Label Grid.Row="2" Content="Step 3: Please select Company to load Department"/>
                <Label Grid.Row="3" Content="Step 4: Please select Department to load user's"/>
                    <Label Grid.Row="4" Content="Step 5: Please select User and press save button to &#10; create a new group"/>
                    <Label Grid.Row="5" Content="Step 6: if you want to close me click on question mark &#10; shown above!"/>
                   

                </Grid>
            </Border>

        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Parent Group:" VerticalAlignment="Center"  HorizontalAlignment="Right"/>


            <dxg:LookUpEdit x:Name="lookupParentGroup" 
                            DisplayMember="GroupName"
                            Grid.Column="1"
                            Margin="10 0 0 0"
                            Height="25"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            AutoPopulateColumns="True"
                            PopupOpened="LookupParentGroup_PopupOpened" SelectedIndexChanged="lookupParentGroup_SelectedIndexChanged">
                <dxg:LookUpEdit.PopupContentTemplate>
                    <ControlTemplate>
                        <dxg:GridControl Name="PART_GridControl"
                                         AutoGenerateColumns="None"
                                         AutoPopulateColumns="True">
                            <dxg:GridControl.View>
                                <dxg:TreeListView KeyFieldName="Id" 
                                                  ParentFieldName="parentId"
                                                  ShowAutoFilterRow="True"
                                                  TreeDerivationMode="Selfreference"/>
                            </dxg:GridControl.View>

                            <dxg:GridColumn FieldName="creationDate"
                                            IsSmart="True"
                                            Visible="False"
                                            VisibleIndex="6"/>

                            <dxg:GridColumn FieldName="GroupName"
                                    Header="Group Name"
                                    VisibleIndex="0"
                                    AllowEditing="false"/>


                            <dxg:GridColumn FieldName="Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                            <dxg:GridColumn FieldName="GroupCreatorId" VisibleIndex="2" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                            <dxg:GridColumn FieldName="GroupCreator" VisibleIndex="3" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                            <dxg:GridColumn FieldName="users" VisibleIndex="4" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                            <dxg:GridColumn FieldName="parentId" VisibleIndex="5" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                            <dxg:GridColumn FieldName="parentGroup" VisibleIndex="7" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                        </dxg:GridControl>
                    </ControlTemplate>
                </dxg:LookUpEdit.PopupContentTemplate>
            </dxg:LookUpEdit>

            <dxe:CheckEdit x:Name="chkHasParent" Grid.Column="2" Content="Has Parent" Margin="10 0 0 0"
                               Checked="ChkHasParent_Checked"
                               Unchecked="ChkHasParent_Unchecked"/>
            <Button Style="{DynamicResource RoundCorner}" 
        Height="20" 
        HorizontalAlignment="Right" Grid.Column="3"
        Width="20" Margin="5,5,15,5" Click="Help_Button_Click"
         >

                <Image 
                     
                      ToolTip="Please Select Company to load departments and then user will load on the basis of selected data"
                     Source="/ZAS_ERP;component/images/help.png"
                       />
                
            </Button>
        </Grid>
        <Grid Grid.Row="3">
            <dx:SimpleButton x:Name="btnSave" Click="btnSave_Click" FontWeight="DemiBold" Grid.Row="2" Content="Save" FontSize="17"/>
        </Grid>

      
        
        
    </Grid>
</UserControl>
