<UserControl x:Class="ZAS_ERP.HR.Salary.EmploymentSalary.UserControls.ucEmploymentSalaryRegister"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.HR.Salary.EmploymentSalary.UserControls"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="35"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <dxr:RibbonControl Grid.Row="0" DockPanel.Dock="Top"  RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
            <dxr:RibbonDefaultPageCategory>
                <dxr:RibbonPage x:Name="lblHeading"  Caption="Employment Salary" ToolTip="List of Petty Cashes">
                    <dxr:RibbonPageGroup  Caption="Clipboard">
                        <dxb:BarButtonItem x:Name="mbtnAddNew" ItemClick="MbtnAddNew_ItemClick" Content="Add New" Glyph="{dx:DXImage Image=AddNewDataSource_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                        <dxb:BarButtonItem x:Name="mbtnUpdate" ItemClick="MbtnUpdate_ItemClick" Content="Update" Glyph="{dx:DXImage Image=EditDataSource_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                        <!--<dxb:BarButtonItem x:Name="mbtnSaveLayout" ItemClick="MbtnSaveLayout_ItemClick" Content="Save Layout" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>-->
                        <!--<dxb:BarButtonItem x:Name="btnRename" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_32x32.png}" />-->
                        <dxb:BarButtonItem x:Name="mbtnDelete" Content="Delete" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>
                        <!--<dxb:BarButtonItem x:Name="mbtnRefresh" Content="Refresh" ItemClick="MbtnRefresh_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>-->

                        <dxb:BarButtonItem ToolTip="Expand" x:Name="mbtnExpand" Content="Expand" Glyph="{dx:DXImage Image=Stretch_32x32.png}" LargeGlyph="{dx:DXImage Image=Stretch_32x32.png}"/>
                        <dxb:BarButtonItem ToolTip="Collapse" x:Name="mbtnCollapse" Content="Collapse" Glyph="{dx:DXImage Image=Squeeze_32x32.png}" LargeGlyph="{dx:DXImage Image=Squeeze_32x32.png}"/>
                        <dxb:BarButtonItem ToolTip="Export to Report" x:Name="mbtnExport" Content="Export to Report" IsVisible="False" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                    </dxr:RibbonPageGroup>
                    <!--<dxr:RibbonPageGroup Caption="Font">
                                <dxr:BarButtonGroup>
                                    <dxb:BarButtonItem Content="Export to Standard" Glyph="{dx:DXImage Image=Bold_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Italic" Glyph="{dx:DXImage Image=Italic_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Underline" Glyph="{dx:DXImage Image=Underline_16x16.png}"/>
                                </dxr:BarButtonGroup>

                            </dxr:RibbonPageGroup>-->
                </dxr:RibbonPage>

            </dxr:RibbonDefaultPageCategory>
        </dxr:RibbonControl>

        <Menu DockPanel.Dock="Top"
              x:Name="menuGrid" Grid.Row="1" HorizontalAlignment="Center">
            <MenuItem Header="_Print Preview"
                      x:Name="mbtnPrintPreview"
                      Click="MbtnPrintPreview_Click"/>
            <MenuItem Header="Export To Report"
                      x:Name="mbtnExportToReport"
                      Click="MbtnExportToReport_Click"
                      />
            <MenuItem Header="Refresh"
                      x:Name="mbtnRefresh"
                      Click="MbtnRefresh_Click"/>

            <MenuItem Header="Save Layout"
                      x:Name="mbtnSaveLayout"
                      Click="MbtnSaveLayout_Click"/>


            <MenuItem Header="Approve" VerticalAlignment="Center"
                          x:Name="mbtnApprove" Click="MbtnApprove_Click"/>
            <MenuItem x:Name="mbtnPending" Click="MbtnPending_Click" VerticalAlignment="Center">
                <MenuItem.Template>
                    <dxg:DefaultControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Approvals">
                                <TextBlock.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Background" Value="Transparent"/>

                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#c0ddeb"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Resources>
                            </TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0" FontWeight="Bold" x:Name="txtApprovalcount" Text="{Binding ApprovalCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </dxg:DefaultControlTemplate>
                </MenuItem.Template>
            </MenuItem>

           

            <MenuItem 
                          x:Name="mbtnApprovedUnapproved"
                          Click="MbtnApprovedUnapproved_Click"
                VerticalAlignment="Center">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Employment Salary Register">
                                <TextBlock.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Background" Value="Transparent"/>

                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#c0ddeb"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Resources>
                            </TextBlock>

                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->

                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtApproveUnapproved" Text="{Binding ApproveunapprovedCount}" Foreground="Blue"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>


           
        </Menu>
        
        <TextBlock Grid.Row="2" x:Name="txtHeader" Text="Employment Salary Contracts" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="25" FontWeight="Bold"/>

        <dxg:GridControl x:Name="grdEmploymentSalary"
                    Margin="5,5,5,5"        
                          SelectionMode="Row"
                          Grid.Row="3" 
                         AutoGenerateColumns="None"
                          Grid.ColumnSpan="3"
                         dx:DXSerializer.SerializationID="grid"
                         CustomUnboundColumnData="GrdEmploymentSalary_CustomUnboundColumnData">
            <dxg:GridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add New"
                                Click="MbtnAdd_Click" x:Name="mbtnAdd">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Update"
                                    x:Name="mbtnEdit" Click="MbtnEdit_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </dxg:GridControl.ContextMenu>

            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                           ShowGroupPanel="True"
                           AllowColumnFiltering="True"
                           ShowHorizontalLines="True"
                           ShowVerticalLines="True"
                           ColumnFilterPopupMode="Excel"
                           NavigationStyle="Row"
                           ShowAutoFilterRow="True"       
                           Width="auto"   
                           RowAnimationKind="None" WaitIndicatorType="Panel"
                           ShowFixedTotalSummary="True"
                           ShowTotalSummary="True"
                           AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                           x:Name="view1"/>
            </dxg:GridControl.View>

            <dxg:GridColumn FieldName="Id"
                            ReadOnly="True"
                            Visible="False"  
                            ShowInColumnChooser="False"
                            VisibleIndex="1"  
                            Header="Id" />

            <dxg:GridColumn Header="Creation Date"
                            FieldName="CreationDate"
                            IsSmart="True"
                            VisibleIndex="2"/>

            <dxg:GridColumn Header="Company"
                            FieldName="company.CompanyName"
                            IsSmart="True"
                            VisibleIndex="4"/>

            <dxg:GridColumn Header="Department"
                            FieldName="department.DeptName" 
                            VisibleIndex="5"  
                            UnboundExpression="[department.parentDepartment.DeptName] +' '+ [department.DeptName]"/>

            <dxg:GridColumn Header="Employee"
                            FieldName="Employee"
                            IsSmart="True"
                            UnboundType="string"
                            VisibleIndex="6"/>

            <dxg:GridColumn Header="Creator"
                            FieldName="Creator"
                            IsSmart="True"
                            UnboundType="string"
                            VisibleIndex="6"/>

            <dxg:GridColumn Header="System Ref #"
                            FieldName="SystemRef"
                            IsSmart="True"
                            VisibleIndex="8"/>

            <dxg:GridColumn Header="Basic Salary"
                            FieldName="BasicSalary"
                            IsSmart="True"
                            VisibleIndex="9">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="From Date"
                            FieldName="FromDate"
                            IsSmart="True"
                            VisibleIndex="10"/>

            <dxg:GridColumn Header="To Date"
                            FieldName="ToDate"
                            IsSmart="True"
                            VisibleIndex="11"/>

        </dxg:GridControl>
    </Grid>
</UserControl>
