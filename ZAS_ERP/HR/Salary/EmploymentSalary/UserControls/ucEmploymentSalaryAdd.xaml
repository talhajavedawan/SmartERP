<UserControl x:Class="ZAS_ERP.HR.Salary.EmploymentSalary.UserControls.ucEmploymentSalaryAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.HR.Salary.EmploymentSalary.UserControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:loc="clr-namespace:ZAS_ERP"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="460" d:DesignWidth="900" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <UserControl.CommandBindings>
        <CommandBinding Command="loc:CustomCommands.ReplytoComment" CanExecute="Command_CanExecute" Executed="Command_Executed" />
    </UserControl.CommandBindings>

    <UserControl.Resources>
        <DataTemplate x:Key="borderTemplate">
            <Border x:Name="border"
                    Width="44" 
                        Background="White" 
                        BorderThickness="2" 
                        BorderBrush="#FF333333" 
                        CornerRadius="10"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Background" TargetName="border" Value="#9F9ABA59"/>
                    <Setter Property="BorderThickness" TargetName="border" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="false">
                    <Setter Property="Background" TargetName="border" Value="#6DFF0000"/>
                    <Setter Property="BorderThickness" TargetName="border" Value="0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="thumbTemplate">
            <Ellipse x:Name="thumb"
                         Fill="#FF333333" 
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         Width="10" Height="10" Margin="8,0"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Fill" TargetName="thumb" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="1"  Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Left"
                 Grid.Column="0" Orientation="Horizontal" Margin="0 5 0 0">
                <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">
                    <Image Source="/ZAS_ERP;component/images/log.png"></Image>
                </Button>
                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1"  Click="BtnMarkReviewed_Click"  ToolTip="Approve - Mark as Reviewed">
                    <Image Source="/ZAS_ERP;component/images/approve.png"></Image>
                </Button>
                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" ToolTip="Add New Comment" Click="BtnAddComment_Click">
                    <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
                </Button>
                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2"  ToolTip="CommentLog" Click="BtnCommentLog_Click">
                    <Image Source="/ZAS_ERP;component/images/comments.png" ></Image>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Panel.ZIndex="5" Visibility="Collapsed" Margin="35" x:Name="gridTracker" Width="500"  HorizontalAlignment="Left" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="btnCollapse" Click="BtnCollapse_Click" Content="Collapse"></Button>
                <TextBlock Text="Activity Tracker" FontWeight="Bold" FontSize="26" Foreground="Black" Margin="30,5"></TextBlock>
                <Button x:Name="btnexpand" Click="Btnexpand_Click" Content="Expand"></Button>

            </StackPanel>
            <dxg:GridControl x:Name="grdUsers" Visibility="Visible"
                     Grid.Row="1" MaxHeight="520"
                     Grid.RowSpan="5" HorizontalAlignment="Left"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             
                     SelectionMode="Row" 
                             
                             
                      CustomUnboundColumnData="GrdUsers_CustomUnboundColumnData"   
                    AutoGenerateColumns="None">
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       
                                   AutoWidth="True"
                       Width="auto"
                       AllowGrouping="False"
                                   ShowGroupPanel="False"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       
                       >

                    </dxg:TableView>
                </dxg:GridControl.View>
                <dxg:GridColumn Header="User Name"
                            FieldName="User.userName"
                            IsSmart="True"
                            Width="auto" />
                <!--<dxg:GridColumn FieldName="Name" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>-->
                <dxg:GridColumn FieldName="Timestamp" UnboundType="String" ReadOnly="True" Width="auto">
                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                </dxg:GridColumn>
                <dxg:GridColumn Header="Info"
                            FieldName="Info"
                            IsSmart="True"
                            Width="auto" />
                <dxg:GridColumn 
                            FieldName="Comment"
                            IsSmart="True"
                            Width="auto" />
                <!--<dxg:GridColumn FieldName="isActive"  >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>-->
                <!--<dxg:GridColumn FieldName="SupervisorName" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Departments" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Companies" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>-->
            </dxg:GridControl>
        </Grid>

        <Grid x:Name="grdComments"  Visibility="Collapsed" Width="500" Background="Gray" Panel.ZIndex="5" VerticalAlignment="Stretch" Margin="35" HorizontalAlignment="Left">
            <dxg:GridControl AutoExpandAllGroups="True"  
                             Height="620" Grid.Row="1"  dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">
                <!--#region Columns-->
                <dxg:GridControl.Columns>


                    <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                    <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                    <dxg:GridColumn Width="Auto" FieldName="Subject" />
                    <dxg:GridColumn Width="Auto" FieldName="Comment">
                        <!--<dxg:GridColumn.Style>
                            <Style >
                                <Style.Triggers>
                                    <Trigger Property="Header" Value="Status Changed">
                                        <Setter Property="Background" Value="LightGreen"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </dxg:GridColumn.Style>-->
                        <!--<dxg:GridColumn.Appea>
                            <dxe:HighligterAppearance>
                            
                        </dxe:HighligterAppearance>-->
                    </dxg:GridColumn>
                    <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                    <dxg:GridColumn
                            Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Descending" />
                </dxg:GridControl.Columns>
                <!--#endregion-->
                <dxg:GridControl.View>
                    <dxg:TableView 
                            x:Name="GrdCommenttableView" AllowEditing="False" DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                                    DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0" RowStyle="{StaticResource RowStyle}" ShowSearchPanelMode="Always" SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" ShowIndicator="False" ShowVerticalLines="False"
                            CompactPanelShowMode="Always" SwitchToCompactModeWidth="700"
                             NavigationStyle="Row"
                           >

                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />


                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Changed')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Loans and Advance Approved')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Loans and Advance UnApproved')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Loans and Advance Voided')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="Orange" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Payments UnVoided')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="Orange" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>


                            <!--<dxg:TopBottomRuleFormatCondition Rule="TopItems" Threshold="20" FieldName="Profit">
                                <dx:Format Background="Purple"/>
                            </dxg:TopBottomRuleFormatCondition>-->
                            <!--<dxg:FormatCondition Expression="Contains([Symbol], 'Status of Receipt has been changed')" FieldName="Comment" PredefinedFormatName="LightRedFillWithDarkRedText">-->

                            <!--<dxg:FormatCondition Expression="Contains('Status of Receipt has been changed')" FieldName="Comment" PredefinedFormatName="LightRedFillWithDarkRedText">-->

                            <!--</dxg:FormatCondition>-->
                        </dxg:TableView.FormatConditions>
                        <!--#region CompactModeFilterItems-->
                        <!--<dxg:TableView.CompactModeFilterItems>
                            <dxg:CompactModeFilterItem DisplayValue="All" />
                            <dxg:CompactModeFilterItem DisplayValue="Read" EditValue="[isRead] = True" />
                            <dxg:CompactModeFilterItem DisplayValue="Unread" EditValue="[isRead] = False" />

                        </dxg:TableView.CompactModeFilterItems>-->
                        <!--#endregion-->

                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>

        </Grid>

        
        <Grid Panel.ZIndex="5" x:Name="grdVoid" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <!--<TextBox  Width="250"  VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="SearchTermTextBox" Margin="5"/>-->
            <TextBlock IsHitTestVisible="False" x:Name="txtVoid" Text="-VOID-" FontSize="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,50" Foreground="Chocolate" Opacity="0.3">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTermTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>


        <Grid Margin="0 0 0 40" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <!--<RowDefinition Height="30"/>
                <RowDefinition Height="*"/>-->
            </Grid.RowDefinitions>
            <dx:DXTabControl Margin="0 40 0 0" Padding="10" Panel.ZIndex="6" >
                <dx:DXTabItem Header="Employment Salary Info" x:Name="tabLoansAdavncesInfo">
                    <dxlc:LayoutGroup
                        x:Name="grpLoansAdvancesInfo"
                        Grid.Row="2"     
                        View="Group" 
                        IsCollapsible="False" 
                        IsCollapsed="False"                
                        Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>


                            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="3">
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Employment Salary"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="24"
                                       Foreground="Black"
                                           FontWeight="Bold"/>

                                    <TextBlock Text=" (ref no.)"
                                       x:Name="lblLoansAdvancesRefNo"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       Foreground="Black"/>
                                </StackPanel>

                            </Grid>

                            <Grid Grid.Row="4" Visibility="Collapsed" Grid.Column="0" Margin="0 0 0 5" Grid.RowSpan="2" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" >

                                    <TextBlock Text="Status"
                                       x:Name="lblStage"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       Foreground="Black"/>
                                </StackPanel>


                                <Border CornerRadius="10" Grid.Column="0" Background="LightGray" x:Name="grdUnderApproval">
                                    <TextBlock Text="Under Approval" Padding="5 5 5 5" TextAlignment="Center" TextWrapping="WrapWithOverflow" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                                </Border>

                                <Border CornerRadius="10" Grid.Column="1" Background="LightGray" x:Name="grdApproved" Margin="2 0 0 0">
                                    <TextBlock Text="Approved" Padding="5 5 5 5" Grid.Column="1" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                                </Border>

                                <Border CornerRadius="10" Grid.Column="2" Background="LightGray" x:Name="grdUnderClosing" Margin="2 0 0 0">
                                    <TextBlock Text="Under Closing" Padding="5 5 5 5" Grid.Column="2" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                                </Border>

                                <Border CornerRadius="10" Grid.Column="3" Background="LightGray" x:Name="grdClosed" Margin="2 0 0 0">
                                    <TextBlock Text="Closed" Padding="5 5 5 5" Grid.Column="3" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                                </Border>

                            </Grid>

                            <Grid Grid.Column="0" Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="Creation date " VerticalAlignment="Center"/>
                                <dxe:DateEdit Grid.Column="1" 
                                              Height="22"
                                              Name="datCreationDate"
                                              TabIndex="2" 
                                              IsEnabled="False" 
                                              FontWeight="Black"/>
                            </Grid>

                            <Grid Grid.Column="2" Grid.Row="2" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="System ref# " VerticalAlignment="Center"/>
                                <dxe:TextEdit Grid.Column="1" IsReadOnly="True" TabIndex="8" Height="22" x:Name="txtSystemRef"/>

                            </Grid>

                            <Grid Grid.Column="0" Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>
                                <TextBlock  Text="Company " VerticalAlignment="Center"/>
                                <dxg:LookUpEdit Grid.Row="2" Grid.Column="1" Height="22" x:Name="lookupCompany" 
                                SelectedIndexChanged="LookupCompany_SelectedIndexChanged" 
                                DisplayMember="CompanyName" 
                                ValueMember="Id"
                                AutoPopulateColumns="False">
                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl" SelectionMode="Row" AutoGenerateColumns="None">
                                                <dxg:GridControl.View>
                                                    <dxg:TableView/>
                                                </dxg:GridControl.View>

                                                <dxg:GridColumn Header="Company"
                                    FieldName="CompanyName"
                                                AllowEditing="false"/>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>
                                </dxg:LookUpEdit>
                            </Grid>

                            <Grid Grid.Column="0" Grid.Row="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="3" Text="Department " VerticalAlignment="Center" />
                                <dxg:LookUpEdit Grid.Row="3" Grid.Column="1" 
                                                Height="22" 
                                                x:Name="lookupDepartment" 
                                                GotFocus="LookupDepartment_GotFocus"
                                DisplayMember="DeptName" SelectedIndexChanged="LookupDepartment_SelectedIndexChanged"
                                ValueMember="Id"
                                AutoPopulateColumns="False">
                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl" SelectionMode="Row" AutoGenerateColumns="None">
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView KeyFieldName="Id" ParentFieldName="ParentID"/>
                                                </dxg:GridControl.View>

                                                <dxg:GridColumn Header="Department"
                                    FieldName="DeptName"
                                                AllowEditing="false"/>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>
                                </dxg:LookUpEdit>
                            </Grid>

                            <Grid Grid.Column="0" Grid.Row="10" x:Name="grdEmployee">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Employee" Grid.Row="0" VerticalAlignment="Center"/>
                                <dxg:LookUpEdit Grid.Row="0" Grid.Column="1" Height="22" x:Name="lookupEmployee" 
                                                GotFocus="LookupEmployee_GotFocus"
                                DisplayMember="person.FName"
                                                ValueMember="EmpId"
                                AutoPopulateColumns="False">
                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl" SelectionMode="Row" AutoGenerateColumns="None">
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView KeyFieldName="Id" ParentFieldName="ParentID"/>
                                                </dxg:GridControl.View>

                                                <dxg:GridColumn Header="First Name"
                                                                FieldName="person.FName"
                                                                AllowEditing="false"/>

                                                <dxg:GridColumn Header="Last Name"
                                                                FieldName="person.LName"
                                                                AllowEditing="false"/>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>
                                </dxg:LookUpEdit>

                               
                            </Grid>
                            <Grid Grid.Column="2" Grid.Row="0" x:Name="grdCreator">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="1" Text="Creator " VerticalAlignment="Center" />
                                <dxe:TextEdit Grid.Row="1" Grid.Column="1" Height="22" x:Name="txtCreator" IsReadOnly="True"/>
                            </Grid>

                            <Grid Grid.Column="2" Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Basic Salary" VerticalAlignment="Center"/>
                                <dxe:TextEdit x:Name="txtBasicSalary"        
                                              Text="0"
                                              Grid.Column="1"
                                              MaskType="Numeric" 
                                              Mask="n2" 
                                              MaskUseAsDisplayFormat="True"/>
                            </Grid>

                            <Grid Grid.Column="2" Grid.Row="8" Visibility="Visible" x:Name="grdApplicantType">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="From Date" Grid.Row="2" VerticalAlignment="Center"/>
                                <dxe:DateEdit Grid.Column="1" 
                                              Height="22"
                                              Name="datFromDate"
                                              TabIndex="2" 
                                              FontWeight="Black"/>
                            </Grid>


                            <Grid Grid.Column="2" Grid.Row="10" Visibility="Visible" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="To Date " Grid.Row="2" VerticalAlignment="Center"/>
                                <dxe:DateEdit Grid.Column="1" 
                                              Height="22"
                                              Name="datToDate"
                                              TabIndex="2" 
                                              FontWeight="Black"/>
                            </Grid>


                            <Grid Grid.Column="2" Grid.Row="6" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Active " Grid.Row="2" VerticalAlignment="Center"/>
                                <dxe:CheckEdit Grid.Column="1" x:Name="chkIsActive"/>
                            </Grid>




                            <Grid Grid.Column="0" Grid.ColumnSpan="3" Height="150" Grid.Row="12" Visibility="Visible" Margin="0.2,0.4,0.4,3.8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Description" Grid.Row="0" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" x:Name="txtDescription" AcceptsReturn="True" AcceptsTab="True" SpellCheck.IsEnabled="True"/>
                            </Grid>
                        </Grid>
                    </dxlc:LayoutGroup>
                </dx:DXTabItem>
            </dx:DXTabControl>
        </Grid>

        <dx:SimpleButton x:Name="btnSave" Click="BtnSave_Click" Height="40" VerticalAlignment="Bottom" Content="Save" FontWeight="Bold" FontSize="20"/>
        <Grid Name="grdProgressBar" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Height="100" Width="300" Background="LightGray">
            <ProgressBar x:Name="pbarDownloading" Grid.ColumnSpan="2" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center"  Minimum="0" Maximum="100" Height="25" Width="280" Foreground="LightGreen"/>
            <Label Content="Downloading..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Blue"/>
            <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Margin="10,5" x:Name="txtInvoiced" Foreground="Blue" Text="Downloading" FontSize="16" FontWeight="DemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />
                <TextBlock Margin="10,5" x:Name="txtPbarValue" Foreground="Blue" FontWeight="DemiBold" FontSize="16"  Text="{Binding ElementName=pbarTarget , Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />
            </StackPanel>-->
        </Grid>
    </Grid>
</UserControl>
