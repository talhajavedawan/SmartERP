                        <dxb:BarButtonItem 
                                       Content="Close All" 
                                       BarItemDisplayMode="Content"  
                                       ItemClick="ViewCloseAll_Click" />

                    </dxb:BarSubItem>-->
                    <!--<dxb:BarButtonItem x:Name="refreshAssetBarItem" ToolTip="Refresh" BarItemDisplayMode="ContentAndGlyph" Glyph="/ZAS_ERP;component/images/FixedAssetsImages/AddTenant.png" LargeGlyph="/ZAS_ERP;component/images/FixedAssetsImages/refresh.png"
                                       ItemClick="RefreshAssetBarItem_ItemClick" IsEnabled="False"
                                       IsVisible="False"/>-->

                </dxb:Bar>


            </dxb:BarManager.Bars>
            <Grid>

                <Grid.Resources>


                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="250*"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="faLeftGrid"  Grid.Column="0" Background="White">
                    <TabControl x:Name="leaveTabControl" SelectionChanged="LeaveTabControl_SelectionChanged">
                        <TabItem Header="Leaves" x:Name="leaveTabItem">
                            <Grid Background="White">
                                <TreeView Name="leaveTreeView" SelectedItemChanged="LeaveTreeView_SelectedItemChanged">

                                    <TreeView.Resources>

                                        <HierarchicalDataTemplate DataType="{x:Type self:cmbitem}" ItemsSource="{Binding Items}" >
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />

                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="1*" />

                                                </Grid.ColumnDefinitions>
                                                <!--<CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>-->
                                                <TextBlock Text="{Binding id}" Visibility="Collapsed" />
                                                <TextBlock Text="{Binding description}" Visibility="Collapsed" />
                                                <TextBlock Text="   " Background="{Binding bcolor}"
                                                            Width="20"
                                                            Margin="0,0,5,0" Grid.Column="1"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding name}" Grid.Column="1"
                                                                HorizontalAlignment="Stretch" />

                                                    <!--<TextBlock Text=" [" Foreground="Blue" />-->
                                                    <!--<TextBlock Text="{Binding fcolor}" Foreground="Blue" />-->
                                                    <!--<TextBlock Text="]" Foreground="Blue" />-->
                                                </StackPanel>
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                        <Style
                                          TargetType="TreeViewItem" >
                                            <Setter Property="IsExpanded" Value="True"/>
                                        </Style>
                                    </TreeView.Resources>
                                    <!--<TreeViewItem Name="faTreeMain"  Header="Fixed Asset" MouseDoubleClick="FaTreeItem_MouseDoubleClick" MouseUp="FaTreeItem_MouseUp" IsExpanded="True" >

                                        <TreeViewItem Header="All Fixed Assets" Name="faTreeItem"  MouseDoubleClick="TreeViewItemBuilding_MouseDoubleClick" MouseUp="TreeViewItem_MouseUp">
                                            <TreeViewItem Header="Open" Name="treeviewItemAssetsOpen"/>
                                            <TreeViewItem Header="Close" Name="treeviewItemAssetsClose"/>
                                        </TreeViewItem>
                                        
                                        <TreeViewItem Header="Land and Building" Name="treeviewItemLands"  MouseDoubleClick="TreeViewItemBuilding_MouseDoubleClick" MouseUp="TreeViewItem_MouseUp">
                                            <TreeViewItem Header="Open" Name="treeviewItemLandsOpen"/>
                                            <TreeViewItem Header="Close" Name="treeviewItemLandsClose"/>
                                        </TreeViewItem>
                                        <TreeViewItem Header="Vehicles"  Name="treeViewItemVehicles"  MouseUp="VehicleTreeViewItem_MouseUp">
                                            <TreeViewItem Header="Open" Name="treeViewItemVehiclesOpen"/>
                                            <TreeViewItem Header="Close" Name="treeViewItemVehiclesClose"/>

                                        </TreeViewItem>


                                        <TreeViewItem Header="Machinery">
                                            <TreeViewItem Header="Open"/>
                                            <TreeViewItem Header="Close"/>

                                        </TreeViewItem>

                                        <TreeViewItem Header="Computers">
                                            <TreeViewItem Header="Open"/>
                                            <TreeViewItem Header="Close"/>

                                        </TreeViewItem>
                                    </TreeViewItem>-->
                                </TreeView>
                            </Grid>
                        </TabItem>
                        <!--<TabItem Header="Transactions" x:Name="faTransactionTabItem">
                            <Grid Background="White"/>
                        </TabItem>-->
                    </TabControl>

                </Grid>
                <GridSplitter x:Name="GridSplitter"  Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                <Grid x:Name="faRightGrid"  Grid.Column="2" Background="White" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="9*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            
                        </Grid.ColumnDefinitions>
                        <dxe:DateEdit 
                                  MaskUseAsDisplayFormat="True" Mask="yyyy"
                                 Name="dateEditYear"
                                  ShowClearButton="True" UseLayoutRounding="True"
                                    PopupFooterButtons="OkCancel" 
                                      Grid.Column="4"
                            NullText="Year"
                            VerticalAlignment="Center">
                            <dxe:DateEdit.StyleSettings>
                                <dxe:DateEditPickerStyleSettings/>
                            </dxe:DateEdit.StyleSettings>
                        </dxe:DateEdit>

                        <dxe:DateEdit Name="dateMonth"
                                   MaskUseAsDisplayFormat="True" Mask="MM" 
                                  ShowClearButton="True" UseLayoutRounding="True" 
                                  PopupFooterButtons="OkCancel" 
                                 Grid.Column="2"
                              NullText="Month"
                                  VerticalAlignment="Center"  >
                            <dxe:DateEdit.StyleSettings>
                                <dxe:DateEditPickerStyleSettings/>
                            </dxe:DateEdit.StyleSettings>
                        </dxe:DateEdit>
                        <dxe:DateEdit Name="dateDay"
                                   MaskUseAsDisplayFormat="True" Mask="dd" UseLayoutRounding="True"
                                  ShowClearButton="True"
                                  PopupFooterButtons="OkCancel" 
                                      Grid.Column="0"
                              NullText="Day"   VerticalAlignment="Center">
                            <dxe:DateEdit.StyleSettings>

                                <dxe:DateEditPickerStyleSettings/>
                            </dxe:DateEdit.StyleSettings>
                        </dxe:DateEdit>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button   VerticalAlignment="Center"   Content="Clear Filter"
                                  Name="clearDateFilter" HorizontalAlignment="Right" 
                                  Click="ClearDateFilter_Click"/>
                            <Separator Width="3"/>
                            <Button   VerticalAlignment="Center"  Content="Apply Filter"
                                  Name="applyDateFilter" HorizontalAlignment="Left"  
                                  Click="ApplyDateFilter_Click"/>
                        </StackPanel>
                        

                        <dxg:LookUpEdit x:Name="lookUpEmployee"
                                        Grid.Column="8"
                                       
                                        VerticalAlignment="Center"
                                       
                                        DisplayMember="person.FName"
                                        
                                        
                                        SelectedIndexChanged="LookUpEmployee_SelectedIndexChanged">
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>

                                        </Grid.RowDefinitions>
                                        <Button Content="Remove" Foreground="Red" Click="RemoveEmployeeButton_Click"></Button>
                                        <dxg:GridControl Name="PART_GridControl"
                                                         AutoPopulateColumns="True"
                                                         Grid.Row="1">
                                            <dxg:GridControl.View>
                                                <dxg:TreeListView Name="treeListView1"
                                                                  ShowAutoFilterRow="True"
                                                                  TreeDerivationMode="Selfreference"
                                                                  KeyFieldName="Id"
                                                                  ParentFieldName="SupervisorId" />
                                            </dxg:GridControl.View>
                                            <dxg:GridColumn x:Name="colId"
                                                            FieldName="Id"
                                                            IsSmart="True"
                                                            Visible="False" />
                                            <!--<dxg:GridColumn FieldName="person.FName"
                                                            IsSmart="True"
                                                            Width="auto" />
                                            -->
                                            <!--<dxg:GridColumn FieldName="company.IndustryType"
                                    IsSmart="True"
                                    Visible="False" />-->
                                            <!--
                                            <dxg:GridColumn x:Name="collastname"
                                                            FieldName="person.FName"
                                                            Visible="True"
                                                            IsSmart="True" />-->
                                            <dxg:GridColumn FieldName="person.FName"
                                                            x:Name="colFname"
                                                            IsSmart="True"
                                                            Visible="True"
                                                            Header="First Name"
                                                            Width="auto" />
                                            <dxg:GridColumn FieldName="person.LName"
                                                            x:Name="colLname"
                                                            IsSmart="True"
                                                            Visible="True"
                                                            Header="Last Name"
                                                            Width="auto" />
                                            <dxg:GridColumn FieldName="contact.ContactNo"
                                                            IsSmart="True"
                                                            x:Name="colcontactno"
                                                            Visible="False"
                                                            Header="Phone"
                                                            Width="auto" />

                                            <dxg:GridColumn FieldName="contact.Email"
                                                            x:Name="colEmail"
                                                            IsSmart="True"
                                                            Visible="False"
                                                            Header="Email" />
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>

                    </Grid>
                    <Grid  Grid.Row="1" Name="grdLeavesMain">
                        
                    </Grid>
                        
                    <!--<mdi:MdiContainer x:Name="faMdiContainer" Theme="Aero" Background="Transparent">


                    </mdi:MdiContainer>-->
                    <!--<GridControls:ucGridControlFixedAssets />-->


                </Grid>


            </Grid>
        </dxb:BarManager>

    </Grid>
</Window>
