        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Loaded="Window_Loaded"
        Height="450" Width="800">
    <Window.Resources>
      
            <Style TargetType="dxe:DXScrollViewer">
            <Setter Property="dx:ScrollBarExtensions.AllowMouseScrolling" Value="False"/>
        </Style>
       
    </Window.Resources>
    <Grid>


        <dxb:BarManager  Grid.Row="1" x:Name="leavesBarManager">

            <dxb:BarManager.Items>

            </dxb:BarManager.Items>

            <dxb:BarManager.Bars>
                <dxb:Bar Caption="faOp">

                    <dxb:Bar.DockInfo>
                        <dxb:BarDockInfo ContainerType="Top" />
                    </dxb:Bar.DockInfo>
                    <dxb:BarButtonItem x:Name="mbtnLeaveRegister" ToolTip="Leaves Register" 
                                       BarItemDisplayMode="ContentAndGlyph" 
                                      
                                       ItemClick="MbtnLeaveRegister_ItemClick" 
                                       LargeGlyph="/ZAS_ERP;component/images/checklist.png" />
                    <dxb:BarSubItem x:Name="mbtnLeaves" 
                                       ToolTip="Add Leaves" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       LargeGlyph="/ZAS_ERP;component/images/leaves-logo.png" 
                                       Glyph="/ZAS_ERP;component/images/leaves-logo.png" 
                                       ItemClick="MbtnLeaves_ItemClick" IsEnabled="False">
                        <dxb:BarButtonItem x:Name="mbtnAddLeaves" 
                                       Content="Add Leaves" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       LargeGlyph="/ZAS_ERP;component/images/coaAdd.png" 
                                       Glyph="/ZAS_ERP;component/images/coaAdd.png" 
                                       ItemClick="MbtnAddLeaves_ItemClick" />
                        
                        <dxb:BarButtonItem x:Name="mbtnAdjustLeaves" 
                                       Content="Adjust Leaves" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       LargeGlyph="/ZAS_ERP;component/images/leave-adjust.png" 
                                       Glyph="/ZAS_ERP;component/images/leave-adjust.png" 
                                       ItemClick="MbtnAdjustLeaves_ItemClick" />
                        
                        <dxb:BarButtonItem x:Name="mbtnAllocateLeaves" 
                                       Content="Allocate Leaves" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       LargeGlyph="/ZAS_ERP;component/images/allocate-logo.png" 
                                       Glyph="/ZAS_ERP;component/images/allocate-logo.png" 
                                       ItemClick="MbtnAllocateLeaves_ItemClick" />
                        <!--<dxb:BarButtonItem x:Name="addVehicleSubItem" 
                                       Content="Add Vehicle" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/Car-icon3.png" 
                                       ItemClick="AddVehicleSubItem_ItemClick"/>
                        <dxb:BarButtonItem x:Name="addBMachinerySubItem" 
                                       Content="Add Furniture" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/Settings-icon.png" 
                                       ItemClick="AddAssetBarItem_ItemClick1"
