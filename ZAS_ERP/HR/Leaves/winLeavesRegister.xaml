                                       LargeGlyph="/ZAS_ERP;component/images/FixedAssetsImages/Computer-icon.png" 
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/Computer-icon.png" 
                                       IsEnabled="False"
                                       ItemClick="AddAssetBarItem_ItemClick2"/>-->



                    </dxb:BarSubItem>

                    <dxb:BarButtonItem 
                                       ToolTip="Collapse" 
                                       ItemClick="CollapseGridBarItem_ItemClick" 
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/collapse1.png" 
                                       LargeGlyph="/ZAS_ERP;component/images/FixedAssetsImages/collapse1.png"/>

                    <dxb:BarButtonItem 
                                       ToolTip="Expand" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       LargeGlyph="/ZAS_ERP;component/images/FixedAssetsImages/expand1.png" 
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/expand1.png" 
                                       ItemClick="ExpandGridBarItem_ItemClick" />
                    <!--<dxb:BarButtonItem x:Name="editAssetBarItem" Content="Edit Asset" BarItemDisplayMode="ContentAndGlyph" Glyph="/ZAS_ERP;component/images/FixedAssetsImages/EditAsset1.png" LargeGlyph="/ZAS_ERP;component/images/FixedAssetsImages/EditAsset1.png"/>-->
                    <!--<dxb:BarButtonItem x:Name="deleteAssetBarItem" Content="Delete Asset" BarItemDisplayMode="ContentAndGlyph" Glyph="/ZAS_ERP;component/images/FixedAssetsImages/DeleteAsset1.png" LargeGlyph="/ZAS_ERP;component/images/FixedAssetsImages/DeleteAsset1.png" ItemClick="DeleteAssetBarItem_ItemClick"/>-->


                    <dxb:BarButtonItem 
                                       ToolTip="Renew Leaves" 
                                       BarItemDisplayMode="ContentAndGlyph" 
                                       Name="renewLeaves"
                                       LargeGlyph="/ZAS_ERP;component/images/renew.png" 
                                       Glyph="/ZAS_ERP;component/images/renew.png" 
                                       ItemClick="RenewLeaves_ItemClick" 
                        IsEnabled="False"/>

                    <dxb:BarSubItem x:Name="ManageAssetBarItem" 
                                       ToolTip="Manage" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       LargeGlyph="/ZAS_ERP;component/images/FixedAssetsImages/manageIcon.png" 
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/manageIcon.png" 
                                       IsEnabled="False">
                        <dxb:BarButtonItem x:Name="manageLists" 
                                       Content="Manage Lists" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       LargeGlyph="/ZAS_ERP;component/images/FixedAssetsImages/listIcon.png" 
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/listIcon.png" 
                                       ItemClick="ManageLists_ItemClick" 
                                          />

                        <dxb:BarButtonItem x:Name="manageRoles" 
                                       Content="Manage User Roles" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/Lock-icon.png" 
                                       ItemClick="ManageRoles_ItemClick_1"
                                           IsEnabled="False"
                                           IsVisible="False"/>
                        <!--<dxb:BarButtonItem x:Name="addBMachinerySubItem" 
                                       Content="Add Machinery" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/Settings-icon.png" 
                                       ItemClick="AddAssetBarItem_ItemClick"/>
                        <dxb:BarButtonItem x:Name="addComputerSubItem" 
                                       Content="Add Computers" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       LargeGlyph="/ZAS_ERP;component/images/FixedAssetsImages/Computer-icon.png" 
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/Computer-icon.png" 
                                       ItemClick="AddAssetBarItem_ItemClick"/>-->



                    </dxb:BarSubItem>


                    <!--<dxb:BarSubItem x:Name="ViewMdiBarItem" 
                                       ToolTip="View" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       LargeGlyph="/ZAS_ERP;component/images/FixedAssetsImages/winView.png" 
                                       Glyph="/ZAS_ERP;component/images/FixedAssetsImages/winView.png" 
                                       IsEnabled="False"
                                    IsVisible="False">
                        <dxb:BarButtonItem 
                                       Content="Cascade" 
                                       BarItemDisplayMode="Content"  
                                       ItemClick="ViewCascasde_Click" />

                        <dxb:BarButtonItem 
                                       Content="Vertically" 
                                       BarItemDisplayMode="Content"  
                                       ItemClick="ViewVertically_Click" />
                        <dxb:BarButtonItem 
                                       Content="Horizontally" 
                                       BarItemDisplayMode="Content"  
