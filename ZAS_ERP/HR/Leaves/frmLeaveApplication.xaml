<UserControl x:Class="ZAS_ERP.Leaves.frmLeaveApplication"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Leaves"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
             xmlns:Serialization="clr-namespace:DevExpress.Xpf.LayoutControl.Serialization;assembly=DevExpress.Xpf.LayoutControl.v21.2" xmlns:dxm="http://schemas.devexpress.com/winfx/2008/xaml/map"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"

             xmlns:loc="clr-namespace:ZAS_ERP"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800"
             Name="frmLeaveApp"
             Loaded="UserControl_Loaded">
    <UserControl.CommandBindings>
        <CommandBinding Command="loc:CustomCommands.ReplytoComment" CanExecute="Command_CanExecute" Executed="Command_Executed" />
    </UserControl.CommandBindings>
    <UserControl.Resources>

        <Style TargetType="dxe:DXScrollViewer">
            <Setter Property="dx:ScrollBarExtensions.AllowMouseScrolling" Value="False" />
        </Style>

    </UserControl.Resources>
    <Grid>
        <!--<ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto">-->
            <Grid Margin="0 0 0 50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                <StackPanel Panel.ZIndex="5" VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                                Orientation="Horizontal">
                    <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click" Visibility="Collapsed">
                        <!--<Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">-->

                            <Image Source="/ZAS_ERP;component/images/log.png"></Image>
                    </Button>
                    <Button Height="30" Width="30" Margin="5,0,0,0" 
                            x:Name="btnApproveLeave" Grid.Column="1"  
                            Click="BtnApproveLeave_Click"  
                            ToolTip="Approve" Visibility="Collapsed">
                        <Image Source="/ZAS_ERP;component/images/approve.png"></Image>
                    </Button>
                    <Button Height="30" Width="30" Margin="5,0,0,0" 
                            x:Name="btnReject" Grid.Column="2" 
                            ToolTip="Reject" Click="BtnReject_Click" Visibility="Collapsed">
                        <Image Source="/ZAS_ERP;component/images/reject.png"></Image>
                    </Button>
                    <Button Height="30" Width="30" Margin="5,0,0,0" 
                            x:Name="btnAddComment" Grid.Column="2" 
                            ToolTip="Add New Comment" 
                            Click="BtnAddComment_Click">
                        <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
                    </Button>
                    <Button Height="30" Width="30" Margin="5,0,0,0" 
                            x:Name="btnCommentLog" 
                            Grid.Column="2" 
                            ToolTip="CommentLog" Click="BtnCommentLog_Click">
                        <Image Source="/ZAS_ERP;component/images/comments.png"></Image>
                    </Button>
                    <Button x:Name="btnAttachNew" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Info" Click="BtnAttachNew_Click" Visibility="Collapsed">
                        <Image x:Name="imgAttachNew" Margin="-12" Source="/ZAS_ERP;component/images/clipattachment.png"></Image>
                    </Button>
                    <Button x:Name="btnAttachmentList" Width="30" Height="30" Grid.Column="3" ToolTip="Info" Click="BtnAttachmentList_Click" Visibility="Collapsed">
                        <Image Source="/ZAS_ERP;component/images/ListAttachment.png"></Image>
                    </Button>
                    <Button Height="30" Width="30" Margin="5,0,0,0" 
                            x:Name="btnTrackingWindow" Grid.Column="2" 
                            ToolTip="360 View" Click="BtnTrackingWindow_Click" Visibility="Collapsed">
                        <Image Source="/ZAS_ERP;component/images/360Arrow.png"></Image>
                    </Button>
                    <Button Height="30" Width="30" Margin="5,0,0,0" 
                            x:Name="btnSetVoid" 
                            Visibility="Visible" Grid.Column="2" 
                            ToolTip="Void/Unvoid" Click="BtnSetVoid_Click">
                        <Image Source="/ZAS_ERP;component/images/void_order.png"></Image>
                    </Button>
                    
                </StackPanel>
                <StackPanel VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                    Orientation="Vertical"
                    Name="stckStatus"
                    Visibility="Visible"
                    Margin="0 0 20 0"
                    >
                    <Grid Background="Beige"
                           >
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!--<TextBlock Text="Leave"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       Foreground="Black"
                                           FontWeight="Bold"/>-->

                            <TextBlock Text=" Leave Status"
                                       x:Name="lblLeaveStatusHeading"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       Padding="15 5 15 5"
                                       Foreground="Black"
                                       FontWeight="Bold" />
                        </StackPanel>

                    </Grid>
                    <Grid Background="Beige"
                           >
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <TextBlock Text="Status"
                                       x:Name="lblStage"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       Padding="15 2 15 5"
                                       Foreground="Black"
                                       />
                        </StackPanel>

                    </Grid>
                </StackPanel>
                </Grid>
                <!--<Grid VerticalAlignment="Top" HorizontalAlignment="Right" Background="Beige">-->
                    
                <!--</Grid>-->

                <Grid Panel.ZIndex="5" Visibility="Collapsed" x:Name="gridTracker" Width="500" Margin="35" HorizontalAlignment="Left"
                      Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="btnCollapse" Click="BtnCollapse_Click" Content="Collapse"></Button>
                        <TextBlock Text="Activity Tracker" FontWeight="Bold" FontSize="26" Foreground="Black" Margin="30,5"></TextBlock>
                        <Button x:Name="btnexpand" Click="Btnexpand_Click" Content="Expand"></Button>

                    </StackPanel>
                    <dxg:GridControl x:Name="grdUsers" Visibility="Visible"
                     Grid.Row="1" 
                                     MaxHeight="520"
                     Grid.RowSpan="5" HorizontalAlignment="Left"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             
                     SelectionMode="Row" 
                             
                             
                      CustomUnboundColumnData="GrdUsers_CustomUnboundColumnData"   
                    AutoGenerateColumns="None">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       
                                   AutoWidth="True"
                       Width="auto"
                       AllowGrouping="False"
                                   ShowGroupPanel="False"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       
                       >

                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridColumn Header="User Name"
                            FieldName="User.userName"
                            IsSmart="True"
                            Width="auto" />

                        <dxg:GridColumn FieldName="Timestamp" UnboundType="String" ReadOnly="True" Width="auto">

                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Info"
                            FieldName="Info"
                            IsSmart="True"
                            Width="auto" />
                        <dxg:GridColumn FieldName="Comment"
                            IsSmart="True"
                            Width="auto" />

                    </dxg:GridControl>
                </Grid>
                
                <Grid x:Name="grdComments" Visibility="Collapsed" Width="400" 
                      Background="Gray" Panel.ZIndex="6" VerticalAlignment="Stretch" 
                      Margin=" 35 -25 0 0" HorizontalAlignment="Left"
                      Grid.Row="1">
                    <dxg:GridControl AutoExpandAllGroups="True"  
                                     Height="620" 
                                     Grid.Row="1" 
                                     dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" 
                                     x:Name="grdCommentss">

                        <dxg:GridControl.Columns>


                            <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender" />
                            <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee" />
                            <dxg:GridColumn Width="Auto" FieldName="Subject" />
                            <dxg:GridColumn Width="Auto" FieldName="Comment" />
                            <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category" />
                            <dxg:GridColumn Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                                                SortOrder="Descending" />
                        </dxg:GridControl.Columns>


                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="GrdCommenttableView" 
                                AllowEditing="False" 
                                DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                                DataRowTemplate="{StaticResource CommentRowTemplate}"
                                LeftGroupAreaIndent="0" 
                                RowStyle="{StaticResource RowStyle}"
                                ShowSearchPanelMode="Always" 
                                SearchPanelNullText="Search Comment Box"
                                ShowGroupPanel="True" 
                                ShowIndicator="False" 
                                ShowVerticalLines="False"
                                CompactPanelShowMode="Always"
                                SwitchToCompactModeWidth="700"
                                NavigationStyle="Row"
                       
                                   >

                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition ApplyToRow="True" Expression=" Contains([Subject], 'Status Changed')">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>

                                </dxg:TableView.FormatConditions>


                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>

                </Grid>


                <Grid x:Name="grdAttachments" Width="300" Visibility="Collapsed" Background="Gray" Panel.ZIndex="5" VerticalAlignment="Top" Margin="210,30,65,35" HorizontalAlignment="Left"
                      >
                    <TreeView x:Name="treeViewAttachments">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type loc:TreeItem}" ItemsSource="{Binding Items}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding name}"
                                                   Grid.Column="0"
                         
                                                   HorizontalAlignment="Stretch" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text=" [" Foreground="Blue" />
                                        <TextBlock Text="{Binding Items.Count}" Foreground="Blue" />
                                        <TextBlock Text="]" Foreground="Blue" />
                                    </StackPanel>
                                </Grid>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type loc:cmbitem}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />

                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="1*" />

                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding isActive}" IsEnabled="False" />

                                        <TextBlock Text="{Binding id}"
                                                          Visibility="Collapsed" />
                                        <TextBlock Text="{Binding description}"
                                                          Visibility="Collapsed" />
                                        <Button Content="Open" Margin="5,0" x:Name="btnDownloadAttachment" Click="BtnDownloadAttachment_Click" Foreground="Blue" Tag="{Binding description}"></Button>

                                        <TextBlock Text="   "
                                                         Background="{Binding bcolor}"
                                                         Width="20"
                                                         Margin="0,0,5,0" Grid.Column="1" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding name}"
                                                         Grid.Column="1"
                         
                                                         HorizontalAlignment="Stretch" />


                                            <TextBlock Text=" [" Foreground="Blue" />

                                            <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />

                                            <TextBlock Text="]" Foreground="Blue" />

                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>

                        </TreeView.Resources>
                    </TreeView>
                </Grid>

                <Grid x:Name="grdAttach" Width="250" Visibility="Collapsed" Background="White" Panel.ZIndex="5" VerticalAlignment="Top" Margin="175,32,65,35" HorizontalAlignment="Left"
                      >
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />

                            <ColumnDefinition Width="1*" />

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Category"
                         
                         
                                                 Margin="5,0,5,0" Grid.Column="0" />
                        <ComboBox x:Name="cmbCategory"
                                              Grid.Column="3"
                                              VerticalAlignment="Center"
                                                  Margin="5,5"
                                              Grid.Row="0"
                                              TabIndex="0"
                                              >
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding id}"
                                                  Visibility="Hidden" />
                                        <TextBlock Text="{Binding name}"></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>


                        <!--<TextBlock Text=" [" Foreground="Blue" />-->
                        <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.ColumnSpan="2" Content="Select file" Margin="5" x:Name="btnAttachment" Click="BtnAttachment_Click" Foreground="Blue" Tag="{Binding description}"></Button>
                        <!--<TextBlock Text="]" Foreground="Blue" />-->

                    </Grid>

                </Grid>

                <Grid Margin="0 0 0 0" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Name="grdAdminControls" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="Employee: " VerticalAlignment="Center" />
                            <dxg:LookUpEdit Grid.Column="1" Name="cmbEmployee"
                                        AutoPopulateColumns="False" 
                                        DisplayMember="person.FName"                                                  
                                        IsTextEditable="False"
                                        EditValueChanged="CmbEmployee_EditValueChanged">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <dxg:GridControl Name="PART_GridControl">

                                            <dxg:GridControl.Columns>
                                                <dxg:GridColumn Header="First Name"
                            FieldName="person.FName"
                            IsSmart="True"
                            Width="auto" />
                                                <dxg:GridColumn Header="Last Name"      
                            FieldName="person.LName"
                            IsSmart="True"
                            Width="auto" />
                                            </dxg:GridControl.Columns>
                                        </dxg:GridControl>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>


                            </dxg:LookUpEdit>
                        </Grid>
                        
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="Leave Status: " VerticalAlignment="Center" />
                            <ComboBox x:Name="cmbxLeaveStatus"
                                    Grid.Column="1" 
                                    
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="ColorEditStatus_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"></ColumnDefinition>
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding id}"
                                                             Visibility="Hidden" />
                                            <TextBlock Text="   "
                                                              Background="{Binding bcolor}"
                                                             Width="20"
                                                             Margin="10,0" />
                                            <TextBlock Text="{Binding name}"
                                                             Grid.Column="1"
                                                             Foreground="{Binding fcolor}"
                                                             HorizontalAlignment="Stretch"></TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Grid>
                        <dxlc:LayoutGroup Header="Leave Application Form" 
                                          View="GroupBox" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical"
                                                      Grid.Row="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Column="0" Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="First Name: " VerticalAlignment="Center" />
                                <dxe:TextEdit Name="txtFname" Grid.Column="1"
                                                     IsReadOnly="True"
                                                     Height="22"
                                       >

                                </dxe:TextEdit>
                            </Grid>

                            <Grid Grid.Column="2" Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="Last Name: " VerticalAlignment="Center" />
                                <dxe:TextEdit Name="txtLname" Grid.Column="1"
                                                     IsReadOnly="True"
                                                     Height="22"
                                       >

                                </dxe:TextEdit>


                                <!--</dxg:LookUpEdit>-->
                            </Grid>

                            <Grid Grid.Column="0" Grid.Row="2" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="Position: " VerticalAlignment="Center" />
                                <dxe:TextEdit Height="22"
                                       Name="txtPosition" Grid.Column="1"
                                                     IsReadOnly="True"
                                                     >
                                </dxe:TextEdit>
                            </Grid>

                            <!--<Grid Grid.Column="2" Grid.Row="2" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="Department: " VerticalAlignment="Center"/>
                                <dxe:TextEdit Height="22" x:Name="txtDept" Grid.Column="1"></dxe:TextEdit>
                            </Grid>-->
                            <Grid Grid.Column="2" Grid.Row="2" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="Leave Type: " VerticalAlignment="Center" />
                                <!--<dxe:TextEdit Height="22" x:Name="txtDept" Grid.Column="1"></dxe:TextEdit>-->
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--<StackPanel Orientation="Horizontal">-->
                                    <RadioButton Content="Annual" Grid.Column="0" 
                                                     VerticalAlignment="Center" 
                                                     GroupName="leaveType"
                                                     Name="radAnnual"
                                                  Checked="RadAnnual_Checked" />
                                    <RadioButton Content="Casual" Grid.Column="1" 
                                                 VerticalAlignment="Center" 
                                                     GroupName="leaveType"
                                                     Name="radCasual"
                                                 IsChecked="false"
                                                 Checked="RadCasual_Checked" />
                                    <RadioButton Content="Half Day" Grid.Column="2" 
                                                 VerticalAlignment="Center" 
                                                     GroupName="leaveType"
                                                     Name="radHalf"
                                                 Checked="RadHalf_Checked" />
                                    <RadioButton Content="Adjustment" Grid.Column="4" 
                                                 VerticalAlignment="Center" 
                                                     GroupName="leaveType"
                                                     Name="radAdjustment"
                                                 Checked="RadAdjustment_Checked"
                                                 Unchecked="RadAdjustment_Unchecked"
                                                 Visibility="Visible" />
                                    <dxe:CheckEdit Visibility="Collapsed" Name="chkIsHalf" Content="is Half  " Grid.Column="3" ToolTip="Half day Adjustment"
                                                   Checked="ChkIsHalf_Checked"
                                                   Unchecked="ChkIsHalf_Unchecked" />
                                    <!--</StackPanel>-->                                   

                                </Grid>
                            </Grid>


                            <Grid Grid.Column="0" Grid.Row="4" 
                                  Name="grdDateFrom" Visibility="Visible">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                     
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25" />
                                        <!--<RowDefinition Height="10"/>-->
                                        <!--<RowDefinition/>-->
                                    </Grid.RowDefinitions>

                                    <TextBlock VerticalAlignment="Center" 
                                               Text="From Date " Grid.Column="0" Grid.Row="0"
                                               />

                                    <!--<TextBlock VerticalAlignment="Center" Text="Rental basis: " Grid.Column="0" Grid.Row="2"/>-->
                                    <dxe:DateEdit Height="22" 
                                                  x:Name="dateFrom" Grid.Row="0" 
                                                  Grid.Column="3" 
                                                  IsEnabled="True" 
                                                  Margin="0 0 0 0"
                                                  EditValueChanged="DateFrom_EditValueChanged" />
                                </Grid>
                            </Grid>
                            <Grid Grid.Column="0" Grid.Row="4" 
                                  Name="grdTimeFrom" 
                                  Visibility="Collapsed"
                                  >
                                <Grid>
                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25" />
                                        <!--<RowDefinition Height="10"/>-->
                                        <!--<RowDefinition/>-->
                                    </Grid.RowDefinitions>

                                    <TextBlock VerticalAlignment="Center" 
                                               Text="From Time " 
                                               Grid.Column="0" Grid.Row="0"
                                               />

                                    <!--<TextBlock VerticalAlignment="Center" Text="Rental basis: " Grid.Column="0" Grid.Row="2"/>-->
                                    <dxe:DateEdit Height="22" 
                                                  x:Name="TimeFrom" Grid.Row="0" 
                                                  Grid.Column="3" 
                                                  IsEnabled="True" 
                                                  Margin="0 0 0 0"
                                                  Mask="HH:mm:ss"
                                                  MaskUseAsDisplayFormat="True"
                                                  UseLayoutRounding="True"
                                  ShowClearButton="True"
                                  PopupFooterButtons="OkCancel" 
                                                  EditValueChanged="TimeFrom_EditValueChanged">
                                        <dxe:DateEdit.StyleSettings>
                                        <dxe:DateEditPickerStyleSettings />
                                        </dxe:DateEdit.StyleSettings>
                                    </dxe:DateEdit>
                                </Grid>
                            </Grid>
                            <Grid Grid.Column="2" Grid.Row="4" 
                                  Name="grdDateTo" Visibility="Visible">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                       
