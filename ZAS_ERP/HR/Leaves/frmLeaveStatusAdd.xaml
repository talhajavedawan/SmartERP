<Window x:Class="ZAS_ERP.HR.Leaves.frmLeaveStatusAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Height="230" Width="508" Padding="3 3 3 3" Title="Leave Status" 
        x:Name="winLeaveStatusAdd" >
    <Grid>
        <Grid Margin="0 0 0 35">
            <dxlc:LayoutGroup View="GroupBox" Header="Leaves Status" Height="170">
                <dxlc:LayoutControl Orientation="Vertical">



                    <!--<dxlc:LayoutItem Height="5"/>-->

                    <dxlc:LayoutItem Label="Status:          " Width="250">
                        <dxe:TextEdit Name="leaveStatusTxtbx"/>
                    </dxlc:LayoutItem>

                    <dxlc:LayoutItem Height="5"/>

                    <dxlc:LayoutItem Label="Is Active:       " Width="250">
                        <dxe:CheckEdit Name="leaveStatusIsActive"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Height="5"/>
                    <dxlc:LayoutItem Label="Status Color: " Width="250">
                        <dxe:PopupColorEdit Name="leaveStatusColorEdit"/>
                    </dxlc:LayoutItem>
                    <TextBlock Name ="leaveStatusId" Visibility="Collapsed" HorizontalAlignment="Left" Height="14" 
                               Margin="463,10,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="24"/>

                </dxlc:LayoutControl>
            </dxlc:LayoutGroup>


        </Grid>
        <Button x:Name="btnLeaveStatusSave" Content="Save" Height="35" 
                VerticalAlignment="Bottom" Click="BtnLeaveStatusSave_Click"/>

    </Grid>
</Window>
