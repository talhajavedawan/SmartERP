<Window x:Class="ZAS_ERP.HR.Leaves.AddAllocationWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.HR.Leaves"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Title="Allocate Leaves"
        Height="250" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <dxlc:LayoutGroup Header="" View="GroupBox">
            <dxlc:LayoutGroup.GroupBoxStyle>
                <Style TargetType="dxlc:GroupBox">
                    <Setter Property="TitleForeground" Value="White" />
                    <Setter Property="TitleBackground" Value="SteelBlue"/>
                </Style>
            </dxlc:LayoutGroup.GroupBoxStyle>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>

                    <RowDefinition Height="30*"/>
                    <!--<RowDefinition/>-->

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Year: " VerticalAlignment="Center" 
                   FontSize="14" HorizontalAlignment="Right" 
                   Grid.Column="0"
                   Grid.Row="0"/>
                <TextBlock
                    Name="txtYear"
                    Text="2021" VerticalAlignment="Center" 
                   FontSize="14" HorizontalAlignment="Left" 
                   Grid.Column="2"
                   Grid.Row="0"/>
                

                <TextBlock Text="Name: " VerticalAlignment="Center" 
                   FontSize="14" HorizontalAlignment="Right" 
                   Grid.Column="0"
                   Grid.Row="1"/>
                <TextBlock 
                    Name="txtName"
                    Text="" VerticalAlignment="Center" 
                   FontSize="14" HorizontalAlignment="Left" 
                   Grid.Column="2"
                   Grid.Row="1"/>
                <TextBlock Text="Allocated Annual" VerticalAlignment="Center" 
                   FontSize="14" HorizontalAlignment="Right" 
                   Grid.Column="0"
                   Grid.Row="2"/>
                <dxe:TextEdit Name="txtannual" 
                    Text="" VerticalAlignment="Center" 
                   FontSize="14" HorizontalAlignment="Left" 
                   Grid.Column="2"
                         Width="100"
                   Grid.Row="2"
                    
                      MaskType="Numeric" Mask="n2" 
                       MaskUseAsDisplayFormat="True"/>
                <TextBlock Text="Allocated Casual" VerticalAlignment="Center" 
                   FontSize="14" HorizontalAlignment="Right" 
                   Grid.Column="0"
                   Grid.Row="3"/>
                <dxe:TextEdit Name="txtCasual" Text="" VerticalAlignment="Center" 
                   FontSize="14" HorizontalAlignment="Left" 
                   Grid.Column="2"
                         Width="100"
                   Grid.Row="3"  
                                                              MaskType="Numeric" Mask="n2" 
                                                              MaskUseAsDisplayFormat="True"/>
                <TextBox Name="txtId" Visibility="Collapsed"/>

                <Button Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="3" Content="Allocate"
                        Name="btnAllocate" Click="BtnAllocate_Click"/>
                <!--<Grid Grid.Column="0"
              Grid.ColumnSpan="3"
              Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                 Name="btnAvoidTag"
                Content="Avoid"
                Click="BtnAvoidTag_Click"/>
                    <Button Grid.Column="1"
                Name="btnSaveTag"
                Content="Notify"
                Click="BtnSaveTag_Click"/>

                </Grid>-->
            </Grid>
        </dxlc:LayoutGroup>

    </Grid>
</Window>
