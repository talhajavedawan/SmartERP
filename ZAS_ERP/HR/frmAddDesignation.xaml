<Window x:Class="ZAS_ERP.HR.frmAddDesignation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.HR"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
           Height="350" Width="508" Padding="3 3 3 3" Title="Designations" x:Name="winDesignationAdd" Loaded="WinDesignationAdd_Loaded" >
    <Grid>
        <Grid Margin="0 0 0 35">
            <dxlc:LayoutGroup View="GroupBox" Header="Designations" Height="330">
                <dxlc:LayoutControl Orientation="Vertical">



                    <dxlc:LayoutItem Height="5"/>
                    <dxlc:LayoutItem Visibility="Collapsed" Label="Company:              " Width="250">
                        <dxg:LookUpEdit  Name="cmbxCompanies" Grid.Column="1"
                                                      AutoPopulateColumns="True" 
                                                      DisplayMember="CompanyName"
                                                     Height="22"
                                       IsTextEditable="False"
                                          Margin="10 0 0 0 "/>
                    </dxlc:LayoutItem>

                    <dxlc:LayoutItem Height="5"/>

                    <dxlc:LayoutItem Visibility="Collapsed" Label="Department:          " Width="250">
                        <dxg:LookUpEdit 
                                                    Name="cmbxDepartments" 
                                                    Grid.Column="1"
                                    AutoPopulateColumns="True" 
                                        Height="22"
                                    DisplayMember="DeptName"
                                        IsTextEditable="False"
                             Margin="10 0 0 0 "
                                   />
                    </dxlc:LayoutItem >
                    <dxlc:LayoutItem Height="5"/>

                    <dxlc:LayoutItem Label="Desgnation:              " Width="250">
                        <dxe:TextEdit Name="desgnationTxtbx"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Height="5"/>
                    <dxlc:LayoutItem Label="Is Active:                   " Width="250">
                        <dxe:CheckEdit Name="chckisActive"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Height="5"/>

                    <dxlc:LayoutItem Label="Is Subsidary:          " Width="250">
                        <dxe:CheckEdit Name="desigIsSubsidary" 
                                       Margin="10 0 0 0 "
                                       IsChecked="False"
                                       Checked="DesigIsSubsidary_Checked"
                                       Unchecked="DesigIsSubsidary_Unchecked"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Height="5"/>
                    <dxlc:LayoutItem Label="Parent Designation:  " Width="250">
                        <dxg:LookUpEdit  Name="cmbxDesignations" 
                                                      AutoPopulateColumns="True" 
                                                      DisplayMember="Title"
                                                      Height="22"
                                                      IsEnabled="False"
                                                      IsTextEditable="False">

                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>

                                        <dxg:GridControl Name="PART_GridControl"
                                                             AutoPopulateColumns="True"
                                                             Grid.Row="1">
                                            <dxg:GridControl.View>
                                                <dxg:TreeListView Name="treeListView1"
                                                                      ShowAutoFilterRow="True"
                                                                      TreeDerivationMode="Selfreference"                                                                   
                                                                       KeyFieldName="DesigId" 
                                                                       ParentFieldName="ParentId"
                                                                  AutoExpandAllNodes="True"/>
                                            </dxg:GridControl.View>
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Height="5"/>

                    <dxlc:LayoutItem Label="Annual Leaves:          " Width="250">
                        <dxe:TextEdit Name="txtAnnuaLeaves"
                                      MaskType="Numeric"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Height="5"/>

                    <dxlc:LayoutItem Label="Casual Leaves:           " Width="250">
                        <dxe:TextEdit Name="txtCasualLeaves"
                                      MaskType="Numeric"/>
                    </dxlc:LayoutItem>
                    <TextBlock Name ="designationId" Visibility="Collapsed" HorizontalAlignment="Left" Height="14" Margin="463,10,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="24"/>
                    
                </dxlc:LayoutControl>
            </dxlc:LayoutGroup>


        </Grid>
        <Button x:Name="btnSaveDesignations" 
                Content="Save" Height="35" VerticalAlignment="Bottom" 
                Click="BtnSaveDesignations_Click"/>

    </Grid>
</Window>
