<UserControl x:Class="ZAS_ERP.TemplateFields.ucFrmBill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.TemplateFields"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Padding="10 10 10 10" Loaded="UserControl_Loaded">
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Label x:Name="lblFirstName" Content="First Name " Grid.Row="0" Tag="FirstName" Visibility="Collapsed"/>
        <dxe:TextEdit Grid.Row="0" Grid.Column="1" x:Name="txtFirstName" Visibility="Collapsed"/>

        <Label x:Name="lblLastName" Content="Last Name " Grid.Row="0" Grid.Column="3" Tag="LastName" Visibility="Collapsed"/>
        <dxe:TextEdit Grid.Row="0" Grid.Column="4" x:Name="txtLastName" Visibility="Collapsed"/>

        <Label x:Name="lblCompany" Content="Company " Grid.Row="2" Tag="Company" Visibility="Collapsed"/>
        <dxe:TextEdit Grid.Row="2" Grid.Column="1" x:Name="txtCompany" Visibility="Collapsed"/>

        <Label x:Name="lblDepartment" Content="Department " Grid.Row="2" Grid.Column="3" Tag="Department" Visibility="Collapsed"/>
        <dxe:TextEdit Grid.Row="2" Grid.Column="4" x:Name="txtDepartment" Visibility="Collapsed"/>

        <Label x:Name="lblEmployee" Content="Employee " Grid.Row="4" Tag="Employee" Visibility="Collapsed"/>
        <dxe:TextEdit Grid.Row="4" Grid.Column="1" x:Name="txtEmployee" Visibility="Collapsed"/>

        <Label x:Name="lblUser" Content="User " Grid.Row="4" Grid.Column="3" Tag="User" Visibility="Collapsed"/>
        <dxe:TextEdit Grid.Row="4" Grid.Column="4" x:Name="txtUser" Visibility="Collapsed"/>
    </Grid>
</UserControl>
