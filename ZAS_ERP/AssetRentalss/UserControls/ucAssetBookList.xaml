<UserControl x:Class="ZAS_ERP.AssetRentalss.UserControls.ucAssetBookList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.AssetRentalss.UserControls" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="lblHeading" Text="Asset Cost Book" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="0" FontFamily="Segoe UI Semibold"  ></TextBlock>
        <dxg:GridControl Grid.Row="3"
            AutoGenerateColumns="None"
            EnableSmartColumnsGeneration="True"
            Name="grdAssetBook"
                         CustomUnboundColumnData="grdAssetBook_CustomUnboundColumnData"
                         MouseDoubleClick="grdAssetBook_MouseDoubleClick">

            <dxg:GridColumn FieldName="billTypeee"
                            Header="Type"
                            AllowEditing="false"
                            ShowInColumnChooser="True"
                            UnboundType="String"/>

            <dxg:GridColumn FieldName="assetRental.AssetNumber"
                            Header="Asset #"
                            AllowEditing="false"
                            ShowInColumnChooser="True"/>

            <dxg:GridColumn FieldName="SystemRefNo"
                            Header="Bill System Ref #"
                            AllowEditing="false"
                            ShowInColumnChooser="True"/>

            <dxg:GridColumn FieldName="assetRental.AssetName"
                            Header="Asset Name"
                            AllowEditing="false"
                            ShowInColumnChooser="True"/>

            <dxg:GridColumn FieldName="PurchasingCost"
                            Header="Purchasing Cost"
                            AllowEditing="false"
                            ShowInColumnChooser="True"
                            UnboundType="Decimal"/>

            <dxg:GridColumn FieldName="ProgressiveCost"
                            Header="Progressive Cost"
                            AllowEditing="false"
                            ShowInColumnChooser="True"
                            UnboundType="Decimal"/>

        </dxg:GridControl>
    </Grid>
</UserControl>
