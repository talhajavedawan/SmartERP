<UserControl x:Class="ZAS_ERP.AssetRentalss.UserControls.ucFrmAssetSubNatureAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.AssetRentalss.UserControls" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="400" Loaded="UserControl_Loaded">
    <Grid>
        <dxlc:LayoutGroup Header="Asset Sub Nature"
                                  Margin="0 0 0 45"
                                          View="GroupBox" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical">
            <dxlc:LayoutControl Orientation="Vertical" VerticalAlignment="Center">
                <dxlc:LayoutItem Label="Sub Nature Name:" Width="270">
                    <dxe:TextEdit Margin="2 0 0 0" x:Name="txtAssetSubNature"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Height="10"/>

                <dxlc:LayoutItem Label="Asset Nature:" Width="270">
                    <dxg:LookUpEdit Grid.Column="1" Height="22" 
                                            IsTextEditable="False" 
                                            AutoPopulateColumns="False"
                                            DisplayMember="NatureName"
                                            x:Name="lookupAssetNature"        
                                            TabIndex="4">
                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <dxg:GridControl Name="PART_GridControl"
                                                             AutoPopulateColumns="True"
                                                             Grid.Row="1">
                                        <dxg:GridControl.View>
                                            <dxg:TreeListView Name="treeListView1"
                                                                      ShowAutoFilterRow="True"
                                                                      TreeDerivationMode="Selfreference"
                                                                      KeyFieldName="Id"
                                                                      ParentFieldName="ParentID"/>
                                        </dxg:GridControl.View>

                                        <dxg:GridColumn Header="Nature Name"
                                                            FieldName="NatureName"
                                                            AllowEditing="false"/>
                                    </dxg:GridControl>
                                </Grid>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Height="10"/>
                <dxlc:LayoutItem Label="Is Active:" Width="270">
                    <dxe:CheckEdit Margin="55 0 0 0" x:Name="chkIsActive" />
                </dxlc:LayoutItem>

            </dxlc:LayoutControl>
        </dxlc:LayoutGroup>
        <Button Content="Save" x:Name="btnSave" Height="40" VerticalAlignment="Bottom" Click="btnSave_Click"/>

    </Grid>
</UserControl>
