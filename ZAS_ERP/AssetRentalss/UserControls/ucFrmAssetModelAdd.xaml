<UserControl x:Class="ZAS_ERP.AssetRentalss.UserControls.ucFrmAssetModelAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.AssetRentalss.UserControls" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="400" Loaded="UserControl_Loaded">
    <Grid>

        <dx:DXTabControl>
            <dx:DXTabItem Header="Asset Model">
                <dxlc:LayoutGroup Header="Asset Model"
                                  Margin="0 0 0 45"
                                          View="GroupBox" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical">
                    <dxlc:LayoutControl Orientation="Vertical" VerticalAlignment="Center">
                        <dxlc:LayoutItem Label="Model Number:" Width="270">
                            <dxe:TextEdit Margin="2 0 0 0" x:Name="txtAssetModel"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Height="10"/>

                        <dxlc:LayoutItem Label="Asset Nature:" Width="270">
                            <dxg:LookUpEdit Grid.Column="1" Height="22" Margin="15 0 0 0"
                                            IsTextEditable="False" 
                                            AutoPopulateColumns="False"
                                            DisplayMember="NatureName"
                                            x:Name="lookupAssetNature"        
                                            TabIndex="4"
                                    SelectedIndexChanged="lookupAssetNature_SelectedIndexChanged">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>

                                            <dxg:GridControl Name="PART_GridControl"
                                                             AutoPopulateColumns="True"
                                                             Grid.Row="1">
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView Name="treeListView1"
                                                                      ShowAutoFilterRow="True"
                                                                      TreeDerivationMode="Selfreference"
                                                                      KeyFieldName="Id"
                                                                      ParentFieldName="ParentID"/>
                                                </dxg:GridControl.View>

                                                <dxg:GridColumn Header="Nature Name"
                                                            FieldName="NatureName"
                                                            AllowEditing="false"/>
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>

                        <dxlc:LayoutItem Height="10"/>
                        <dxlc:LayoutItem Label="Is Active:" Width="270">
                            <dxe:CheckEdit Margin="55 0 0 0" x:Name="chkIsActive" />
                        </dxlc:LayoutItem>

                    </dxlc:LayoutControl>
                </dxlc:LayoutGroup>
            </dx:DXTabItem>

            <dx:DXTabItem Header="Asset Sub-Nature">
                <dxlc:GroupBox Header="Asset Sub-Nature">
                    <dxlc:GroupBox.TitleBackground>
                        <LinearGradientBrush EndPoint="0.5,1"
                                 StartPoint="0.5,0">
                            <GradientStop Color="#FFE6E8EB"
                            Offset="0" />
                            <GradientStop Color="#FF6CA6FB"
                            Offset="1" />
                        </LinearGradientBrush>
                    </dxlc:GroupBox.TitleBackground>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <dxg:GridControl x:Name="grdAssetSubNature"
                                         SelectionChanged="grdAssetSubNature_SelectionChanged"
                             AutoGenerateColumns="None"
                             Grid.ColumnSpan="2"
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="griddeptview"
                                              AutoWidth="True"
                                              IsSynchronizedWithCurrentItem="True"
                                              AllowEditing="False"
                                              ShowCheckBoxSelectorColumn="True"
                                              UseIndicatorForSelection="True"
                                              FadeSelectionOnLostFocus="False"
                                              ShowSelectionRectangle="True">
                                </dxg:TableView>
                            </dxg:GridControl.View>

                            <dxg:GridColumn Header="Id"
                                            FieldName="Id"
                                            AllowEditing="false"
                                            Visible="False"
                                            ShowInColumnChooser="False"/>

                            <dxg:GridColumn Header="Nature Name"
                                            FieldName="NatureName"           
                                            AllowEditing="false"/>

                        </dxg:GridControl>
                    </Grid>
                </dxlc:GroupBox>
            </dx:DXTabItem>


            <dx:DXTabItem Header="Asset Brand">
                <dxlc:GroupBox Header="Asset Brand">
                    <dxlc:GroupBox.TitleBackground>
                        <LinearGradientBrush EndPoint="0.5,1"
                                 StartPoint="0.5,0">
                            <GradientStop Color="#FFE6E8EB"
                            Offset="0" />
                            <GradientStop Color="#FF6CA6FB"
                            Offset="1" />
                        </LinearGradientBrush>
                    </dxlc:GroupBox.TitleBackground>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <dxg:GridControl x:Name="grdAssetBrand"
                             AutoGenerateColumns="None"
                             Grid.ColumnSpan="2"
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="gridBrandView"
                                              AutoWidth="True"
                                              IsSynchronizedWithCurrentItem="True"
                                              AllowEditing="False"
                                              ShowCheckBoxSelectorColumn="True"
                                              UseIndicatorForSelection="True"
                                              FadeSelectionOnLostFocus="False"
                                              ShowSelectionRectangle="True">
                                </dxg:TableView>
                            </dxg:GridControl.View>

                            <dxg:GridColumn Header="Id"
                                            FieldName="Id"
                                            AllowEditing="false"
                                            Visible="False"
                                            ShowInColumnChooser="False"/>

                            <dxg:GridColumn Header="Brand Name"
                                            FieldName="BrandName"           
                                            AllowEditing="false"/>

                        </dxg:GridControl>
                    </Grid>
                </dxlc:GroupBox>
            </dx:DXTabItem>
    
        </dx:DXTabControl>
        <Button Content="Save" x:Name="btnSave" Height="40" VerticalAlignment="Bottom" Click="btnSave_Click"/>

    </Grid>
</UserControl>
