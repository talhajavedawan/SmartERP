                                                            FieldName="assetRentalLocation.LocationTitle"
                                                            AllowEditing="false"/>

                                                            <dxg:GridColumn Header="City Name"
                                                            FieldName="city.CityName"
                                                            AllowEditing="false"/>

                                                            <dxg:GridColumn Header="Country Name"
