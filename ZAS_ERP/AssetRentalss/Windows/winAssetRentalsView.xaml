<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
              x:Class="ZAS_ERP.AssetRentalss.Windows.winAssetRentalsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
              xmlns:local="clr-namespace:ZAS_ERP.AssetRentalss.Windows" 
              xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" 
              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="ucLoansView"  mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="DXWindow_Loaded">
    <Grid>
        <GroupBox>
            <Grid x:Name="reportMainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <dxr:RibbonControl Grid.Row="0" DockPanel.Dock="Top"  RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
                    <dxr:RibbonDefaultPageCategory>
                        <dxr:RibbonPage x:Name="lblHeading" ToolTip="Report Name" Caption="Home"  >
                            <dxr:RibbonPageGroup  Caption="Clipboard">
                                <dxb:BarButtonItem x:Name="btnDelete" KeyGesture="Delete" Cursor="Hand" Content="Delete Report" ItemClick="MbtnDeleteReport1_Click" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>

                                <dxb:BarButtonItem x:Name="btnPrintPreview" KeyGesture="Ctrl+P" Cursor="Hand" Content="Print Preview" ItemClick="BtnPrintPreview_ItemClick"  Glyph="{dx:DXImage Image=Printer_32x32.png}" LargeGlyph="{dx:DXImage Image=Printer_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnSaveAsNew" KeyGesture="Ctrl+N" Cursor="Hand" Content="Save as new" ItemClick="MbtnSaveAsNew1_Click" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>
                                <dxb:BarButtonItem x:Name="btnRename" KeyGesture="Ctrl+X" Cursor="Hand" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_32x32.png}" />
                                <dxb:BarButtonItem x:Name="btnUpdate" KeyGesture="Ctrl+U" Cursor="Hand" Content="Update" ItemClick="MbtnUpdateReport1_Click" Glyph="{dx:DXImage Image=Reset_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnCopy2" KeyGesture="Ctrl+R" Cursor="Hand" Content="Refresh" ItemClick="MbtnRefreshReport1_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToMemorizedReport1" Cursor="Hand" Content="Export to memorized" ItemClick="MbtnExportToMemorizedReport1_Click" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToStandardReport1" Cursor="Hand" ItemClick="MbtnExportToStandardReport1_Click" Content="Export to standard" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnShareReport" Cursor="Hand" ItemClick="mbtnShareReport_ItemClick" Content="Share Report" Glyph="{dx:DXImage Image=Convert_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnDriectClose" Cursor="Hand" ItemClick="mbtnDriectClose_ItemClick" Content="Direct Close" />
                                <dxb:BarButtonItem x:Name="mbtnApprove" Cursor="Hand" ItemClick="mbtnApprove_ItemClick" Content="Approve" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxg:GridControl Grid.Row="2"
            AutoGenerateColumns="None"
            EnableSmartColumnsGeneration="True"
            Name="grdAssetRentalList"
                         CustomUnboundColumnData="grdCntrlAssetRental_CustomUnboundColumnData"
                         MouseDoubleClick="grdCntrlAssetRental_MouseDoubleClick">

                    <dxg:GridControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add New"
                                Click="mbtnAdd_Click" x:Name="mbtnAdd">
                                <MenuItem.Icon>
                                    <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Update"
                                    x:Name="mbtnUpdate" Click="mbtnUpdate_Click">
                                <MenuItem.Icon>
                                    <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </dxg:GridControl.ContextMenu>

                    <dxg:GridControl.View>
                        <dxg:TableView
                        AllowEditing="False"
                        AllowPerPixelScrolling="True"
                        Name="tblViewList"
                        RowAnimationKind="None"
                        ShowAutoFilterRow="True"
                        ShowTotalSummary="True"
                        WaitIndicatorType="Panel">

                        </dxg:TableView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn x:Name="colstatus"
                      FieldName="Status.Status"
                      Header="Status"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="0" AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.Status.backcolor}"/>
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.Status.Status}"/>
                  </InlineUIContainer></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colName"                      
                            FieldName="AssetName"                      
                            Header="Asset Name"                      
                            UnboundType="Bound"                      
                            Visible ="True" 
                            SortOrder="Ascending" 
                            VisibleIndex="0" />

                    <dxg:GridColumn x:Name="colAssetType"                      
                            FieldName="assetType.TypeName"                      
                            Header="Asset Type"                      
                            UnboundType="Bound"                      
                            Visible ="True" 
                            SortOrder="Ascending" 
                            VisibleIndex="2" />

                    <dxg:GridColumn x:Name="colAssetNature"                      
                            FieldName="AssetNature.NatureName"                      
                            Header="Asset Nature"                      
                            UnboundType="Bound"                      
                            Visible ="True" 
                            SortOrder="Ascending" 
                            VisibleIndex="3" />

                    <dxg:GridColumn x:Name="colAssetSubNature"                      
                            FieldName="assetSubNature.NatureName"                      
                            Header="Asset Sub Nature"                      
                            UnboundType="Bound"                      
                            Visible ="True" 
                            SortOrder="Ascending" 
                            VisibleIndex="3" />

                    <dxg:GridColumn x:Name="colAssetBrand"                      
                            FieldName="assetBrand.BrandName"                      
                            Header="Asset Brand"                      
                            UnboundType="Bound"                      
                            Visible ="True" 
                            SortOrder="Ascending" 
                            VisibleIndex="3" />

                    <dxg:GridColumn x:Name="colAssetModel"                      
                            FieldName="assetModel.ModelNumber"
                            Header="Asset Model"                      
                            UnboundType="Bound"                      
                            Visible ="True" 
                            SortOrder="Ascending" 
                            VisibleIndex="3" />



                    <dxg:GridColumn x:Name="colSerialNumber"
                            FieldName="SerialNumber"
                            Header="Serial Number"
                            UnboundType="Bound"                      
                            Visible ="True" 
                            SortOrder="Ascending" 
                            VisibleIndex="3" />

                    <dxg:GridColumn x:Name="colDescription"                      
                            FieldName="Description"                      
                            Header="Description"                      
                            UnboundType="Bound"                      
                            Visible ="True" 
                            SortOrder="Ascending" 
                            VisibleIndex="3" />

                    <dxg:GridColumn x:Name="colAssetNumberr"                      
                            FieldName="AssetNumberr"                      
                            Header="Asset #"                      
                            UnboundType="string"
                            Visible ="True"
                            SortOrder="Ascending"
                            VisibleIndex="3" />

                    <dxg:GridColumn x:Name="colVendor"
                            FieldName="Vendorr"                      
                            Header="Vendor"                      
                            UnboundType="String"
                            Visible ="True"
                            SortOrder="Ascending"
                            VisibleIndex="3" />

                    <dxg:GridColumn x:Name="colHolder"
                            FieldName="AssetHolderr"                      
                            Header="Asset Holder"                      
                            UnboundType="String"
                            Visible ="True"
                            SortOrder="Ascending"
                            VisibleIndex="3" />

                    <dxg:GridColumn x:Name="colCreationDate"
                            FieldName="CreationDate"
                            Header="Creation Date"
                            UnboundType="Bound"
                            AllowEditing="false"
                            Visible ="True"
                            VisibleIndex="1">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colCompany"                      
                            FieldName="company.CompanyName"                      
                            Header="Company"                      
                            UnboundType="Bound"                      
                            Visible ="True"
                            AllowEditing="false"
                            VisibleIndex="2"/>

                    <dxg:GridColumn x:Name="colDepartments"                      
                            FieldName="department.DeptName"                      
                            Header="Department"                        
                            IsSmart="True"
                            AllowEditing="false"                      
                            VisibleIndex="3"/>

                    <dxg:GridColumn FieldName="isRentable"                      
                            Header="Is Rentable"                      
                            UnboundType="Bound"                      
                            Visible ="True" 
                            VisibleIndex="4" />

                    <dxg:GridColumn FieldName="isSubsidary"                      
                            Header="Is Subsidary"                      
                            UnboundType="Bound"                      
                            Visible ="True" 
                            VisibleIndex="5" />

                    <dxg:GridColumn x:Name="colParentAsset"                      
                            FieldName="parentAsset.AssetName"                      
                            Header="Parent Asset Name"                        
                            IsSmart="True"
                            AllowEditing="false"                      
                            VisibleIndex="6"/>

                    <dxg:GridColumn x:Name="colAddress"                      
                            FieldName="assetRentalLocation.LocationTitle"                      
                            Header="Location"                        
                            IsSmart="True"
                            AllowEditing="false"                      
                            VisibleIndex="7"/>

                    <dxg:GridColumn x:Name="colUnit"                      
                            FieldName="assetRentalUnit.UnitNo"                      
                            Header="Unit #"                        
                            IsSmart="True"
                            AllowEditing="false"                      
                            VisibleIndex="7"/>

                    <dxg:GridColumn FieldName="city.CityName"
                            Header="City"                        
                            IsSmart="True"
                            AllowEditing="false"                      
                            VisibleIndex="8"/>

                    <dxg:GridColumn FieldName="country.CountryName"                      
                            Header="Country"                        
                            IsSmart="True"
                            AllowEditing="false"                      
                            VisibleIndex="9"/>

                    <dxg:GridColumn FieldName="ProgressiveeCost" 
                            Header="Progressive Cost"
                            IsSmart="True"
                            AllowEditing="false"
                            UnboundType="decimal"
                            VisibleIndex="9">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="PurchasingggCost" 
                            Header="Purchasing Cost"
                            IsSmart="True"
                            AllowEditing="false"
                            UnboundType="decimal"
                            VisibleIndex="9">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="ProgressiveCostManual" 
                            Header="Progressive Cost (Manual)"
                            IsSmart="True"
                            AllowEditing="false"
                            UnboundType="decimal"
                            VisibleIndex="9">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="PurchasingCostManual" 
                            Header="Purchasing Cost (Manual)"
                            IsSmart="True"
                            AllowEditing="false"
                            UnboundType="decimal"
                            VisibleIndex="9">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="isLeased"                      
                            Header="Is Leased"                        
                            IsSmart="True"
                            AllowEditing="false"                      
                            VisibleIndex="9"/>

                    <dxg:GridColumn FieldName="isSubsidary"                      
                            Header="Is Active"                        
                            IsSmart="True"
                            AllowEditing="false"                      
                            VisibleIndex="9"/>

                </dxg:GridControl>

            </Grid>

        </GroupBox>


        <Image
        x:Name="loadingGif"    
       
            
        Visibility="Hidden"
        Grid.Row="2"
            
         gif:AnimationBehavior.SourceUri="/ZAS_ERP;component/images/loadingReports.gif"   
        VerticalAlignment="Center"
        HorizontalAlignment="Center" RenderTransformOrigin="12.987,0.793" Margin="5,100,5,5" Width="60" />
    </Grid>
</dx:DXWindow>
