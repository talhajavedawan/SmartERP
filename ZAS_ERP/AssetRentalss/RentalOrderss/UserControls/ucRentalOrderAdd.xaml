                                            FieldName="rentalContractId" 
                                            Visible="False" 
                                            ShowInColumnChooser="False"
                                            IsSmart="True"
                                            Width="auto" 
                                            VisibleIndex="0"/>

                            <dxg:GridColumn Header="Contract Creation Date"
                                            FieldName="rentalContract.CreationDate"
                                            IsSmart="True" 
                                            Image="{dx:DXImage Image=Time_16x16.png}"
                                            Width="auto" 
                                            VisibleIndex="0"/>

                            <dxg:GridColumn Header="From Date"
                                            FieldName="fromDate"
                                            IsSmart="True"
                                            VisibleIndex="2"
                                            AllowEditing="true">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                            <dxg:GridColumn Header="To Date"
                                            FieldName="toDate"
                                            IsSmart="True"
                                            VisibleIndex="3"
                                            AllowEditing="true">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                            <dxg:GridColumn Header="Month"
                                            FieldName="RentMonth"
                                            IsSmart="True"
                                            VisibleIndex="4"
                                            AllowEditing="true">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings MaskUseAsDisplayFormat="True" 
                                                          Mask="MMMyyyy" 
                                                          PopupFooterButtons="OkCancel" 
                                                          NullText="Month">
                                        <dxe:DateEditSettings.StyleSettings>
                                            <dxe:DateEditPickerStyleSettings/>
                                        </dxe:DateEditSettings.StyleSettings>
                                    </dxe:DateEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>


                            <dxg:GridColumn x:Name="currencyName"
                                            FieldName="currency"
                                            Header="Currency"
                                            IsSmart="True"
                                            VisibleIndex="5"
                                            UnboundType="bound"
                                            UnboundExpression="[CurrencyName]">
                                <dxg:GridColumn.DisplayTemplate>
                                    <ControlTemplate>
                                        <TextBlock Text="{Binding RowData.Row.currency.CurrencyName}"></TextBlock>
                                    </ControlTemplate>
                                </dxg:GridColumn.DisplayTemplate>
                                <dxg:GridColumn.EditSettings>
                                    <dxg:LookUpEditSettings x:Name="lookupCurrency"
                                      AutoPopulateColumns="False"
                                      IsPopupAutoWidth="False"
                                      DisplayMember="code"
                                      NullText="Select Item">
