                    <dxlc:LayoutGroup Grid.Row="6"  
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Margin="5 10 5 0"
                                      View="GroupBox"
                                      Header="Rental Orders">

                        <dxg:GridControl AutoGenerateColumns="AddNew" 
                                         EnableSmartColumnsGeneration="True"
                                         Name="grdCntrlRentalOrders"
                                         MouseDoubleClick="grdCntrlRentalOrders_MouseDoubleClick"
                                         CustomUnboundColumnData="grdCntrlRentalOrders_CustomUnboundColumnData"
                                         ShowLoadingPanel="{Binding IsLoading}"
                                         MaxHeight="300"
                                         Height="150">

                            <dxg:GridControl.View>
                                <dxg:TableView AllowPerPixelScrolling="True" 
                                       ShowTotalSummary="True"
                                       ShowAutoFilterRow="True" 
                                       RowAnimationKind="None" 
                                       WaitIndicatorType="Panel"
                                       AllowEditing="False" 
                                       ShowGroupPanel="False"
                                       CellValueChanged="TableViewPayment_CellValueChanged"       
                                       ShowCheckBoxSelectorInGroupRow="True"
                                       Name="tableViewPayment">
                                    <dxg:TableView.FormatConditions>
                                        <dxg:FormatCondition ApplyToRow="True" Expression="[AmountDue] = 0" FieldName="AmountDue" IsEnabled="True">
                                            <dx:Format Background="#FF92B250">
                                                <dx:Format.Icon>
                                                    <BitmapImage UriSource="pack://application:,,,/DevExpress.Xpf.Core.v21.2;component/Core/ConditionalFormatting/Images/IconSets/Symbols23_1.png" UriCachePolicy="{x:Null}"/>
                                                </dx:Format.Icon>
                                            </dx:Format>
                                        </dxg:FormatCondition>
                                    </dxg:TableView.FormatConditions>
                                </dxg:TableView>
                            </dxg:GridControl.View>

                            <dxg:GridColumn Header="id"
                                            FieldName="id" 
                                            Visible="False" 
                                            ShowInColumnChooser="False"
                                            IsSmart="True"
                                            Width="auto" 
                                            VisibleIndex="0"/>

