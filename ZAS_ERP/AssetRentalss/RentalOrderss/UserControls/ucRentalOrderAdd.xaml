                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid Background="White">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Grid Margin="10 5 5 0" Grid.Row="0" Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="From " VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <dxe:DateEdit Grid.Column="1" Height="22" x:Name="datFromDate"
                                              EditValueChanged="datFromDate_EditValueChanged"/>
                                </Grid>

                                <Grid Margin="10 5 5 0" Grid.Row="1" Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="To " VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <dxe:DateEdit Grid.Column="1" Height="22" x:Name="datToDate"
