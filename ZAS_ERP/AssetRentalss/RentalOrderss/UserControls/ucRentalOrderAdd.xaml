                                </Grid>

                                <Grid Margin="0 5 5 0" Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Collected Amount " VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <dxe:TextEdit Text="0" Grid.Column="1" IsReadOnly="True" Height="22" x:Name="txtCollectedAmount" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                                </Grid>

                                <Grid Margin="0 5 5 5" Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Remaining Collection " VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <dxe:TextEdit Text="0" Grid.Column="1" IsReadOnly="True" Height="22" x:Name="txtUnCollectedAmount" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                                </Grid>

                            </Grid>

                        </Grid>

