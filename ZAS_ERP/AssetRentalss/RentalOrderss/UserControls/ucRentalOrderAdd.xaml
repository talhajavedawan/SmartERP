                                            <ControlTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"></RowDefinition>
                                                        <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                                    </Grid.RowDefinitions>

                                                    <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                        <dxg:GridColumn FieldName="CurrencyName" />
                                                        <dxg:GridColumn FieldName="Symbol" />
                                                        <dxg:GridColumn FieldName="Abbrivation" />
                                                        
                                                    </dxg:GridControl>
                                                </Grid>
                                            </ControlTemplate>
                                        </dxg:LookUpEditSettings.PopupContentTemplate>
                                    </dxg:LookUpEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                        </dxg:GridControl>

                    </dxlc:LayoutGroup>
                </Grid>
            </dxlc:LayoutGroup>

            <dx:SimpleButton x:Name="btnSave" Click="btnSave_Click" Grid.Row="2" Content="Save" FontWeight="Bold" FontSize="20" Height="35"/>
        </Grid>
        <Grid Name="grdProgressBar" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Height="100" Width="300" Background="LightGray">
