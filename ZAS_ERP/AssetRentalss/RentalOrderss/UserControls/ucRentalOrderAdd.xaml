                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Remaining Invoice " VerticalAlignment="Center" HorizontalAlignment="Right"/>
