                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" HorizontalAlignment="Right" Text="System ref#  " VerticalAlignment="Center"/>
                        <dxe:TextEdit Grid.Column="1" IsReadOnly="True" TabIndex="8" Height="22" x:Name="txtSystemRef"/>

                    </Grid>

                    <Grid Grid.Column="2" Grid.Row="1" Margin="0 5 0 0">
