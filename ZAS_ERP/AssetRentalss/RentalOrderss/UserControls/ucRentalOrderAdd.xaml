                                                Foreground="{Binding fcolor}"
                                                HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Column="4" Grid.Row="2" Margin="0 5 0 0">
