                                                    <TextBlock Text="{Binding name}"></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0 5 5 0" Grid.Row="1" Grid.Column="0">
