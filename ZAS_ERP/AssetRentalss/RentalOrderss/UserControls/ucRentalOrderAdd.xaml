                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>
                    </Grid>

                    <Grid Grid.Column="2" Grid.Row="0" Margin="0 5 0 0">
                        <Grid.ColumnDefinitions>
