                                </Grid>

                                <Grid Margin="0 5 5 0" Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Rent Amount " VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <dxe:TextEdit Text="0" Grid.Column="1" EditValueChanged="txtRentAmount_EditValueChanged" IsReadOnly="True" Height="22" x:Name="txtRentAmount" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                                </Grid>

                                <Grid Margin="0 5 5 5" Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Amount(MER) " VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <dxe:TextEdit Text="0" Grid.Column="1" IsReadOnly="True" Height="22" x:Name="txtRentAmountMER" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
