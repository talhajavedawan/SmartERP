<dx:DXWindow x:Class="ZAS_ERP.PopupNotificatios.frmCreatePopupImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.PopupNotificatios"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d"  Title="Notification Pannel" WindowStartupLocation="CenterScreen" 
             Height="450" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="1">
            
        </Grid>
        
        <Grid Grid.Row="1" Grid.Column="1" x:Name="grdImage">
         

        </Grid>
        
        <Grid Grid.Row="3" Grid.Column="1">
            <Grid.ColumnDefinitions>
              
                <ColumnDefinition/>
                <ColumnDefinition/>
               

            </Grid.ColumnDefinitions>
           
         
            <dx:SimpleButton  x:Name="btnPreview" Grid.Column="0"
                            Click="BtnPreview_Click" 
                            FontWeight="DemiBold" 
                              FontSize="10"
                            VerticalAlignment="Bottom"  
                            Height="30"
                            Content="Preview Version" Margin="5,5,5,5"  />
            <dx:SimpleButton  x:Name="btnPreviewImageNoti" Grid.Column="1"
                            Click="BtnPreviewImageNoti_Click" 
                            FontWeight="DemiBold" 
                              FontSize="10"
                            VerticalAlignment="Bottom"  
                            Height="30"
                            Content="Preview Image" Margin="5,5,5,5" />

        </Grid>
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
              
           

            </Grid.ColumnDefinitions>
            <dx:SimpleButton  x:Name="btnAdd" 
                            Click="BtnAdd_Click" 
                            FontWeight="DemiBold" 
                            VerticalAlignment="Bottom"  
                            Height="30"
                              FontSize="12"
                            Content="Upload" Margin="5,5,5,5" />

        </Grid>
        <Grid Grid.Row="4" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <dx:SimpleButton  x:Name="btnSave" Grid.Column="0"
                            Click="BtnSave_Click" 
                            FontWeight="DemiBold" 
                            VerticalAlignment="Bottom"  
                            Height="30"
                              FontSize="10"
                            Content="Save version" Margin="5,5,5,5" />
            <dx:SimpleButton  x:Name="btnSaves" Grid.Column="1"
                            Click="BtnSaves_Click" 
                            FontWeight="DemiBold" 
                            VerticalAlignment="Bottom"  
                            Height="30"
                              FontSize="10"
                            Content="Save image Notification" Margin="5,5,5,5" />
        </Grid>

    </Grid>
</dx:DXWindow>
