<Window x:Class="ZAS_ERP.PopupNotificatios.frmShowPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.PopupNotificatios"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d" 
         SizeToContent="WidthAndHeight"
         
       
      
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
       
        Title="Notificatios" Topmost="True">
   
    <!--<Window.Background>
        <ImageBrush Stretch="Fill" Opacity="0.5"/>
    </Window.Background>-->

    <!--<Window.Background>
        <ImageBrush Stretch="Fill" Opacity="0.5" ImageSource="pack://application:,,,/ZAS_ERP;component/images/flag.jpg" />
    </Window.Background>-->

  
    <Border Background="AliceBlue" 
        BorderBrush="Black" 
        BorderThickness="0" 
            Padding="3"
        >
       
    
        <Grid Background="AliceBlue" >



            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="3*"/>

            </Grid.RowDefinitions>



            <dxe:ButtonClose 
                     HorizontalAlignment="Right
                         " IsCancel="True" 
                         IsTabStop="False"
                         
                     VerticalAlignment="Top"
                         x:Name="btnclose" 
                         Click="btncloseclick" Panel.ZIndex="5">
            </dxe:ButtonClose>



            <Grid Grid.Row="0" Background="SkyBlue" Panel.ZIndex="3">
                <!--<Label    
                
            Content="ZAS Notifications" 
            VerticalAlignment="Center"                    
            HorizontalAlignment="Center"                 
            FontWeight="DemiBold" 
            FontSize="20"
          
          
            Foreground="SlateBlue"
            />-->
                <TextBlock 
            Padding="40,10,10,10"
            x:Name="notificationTitle"
            Grid.Row="0" Width="400"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"           
            FontWeight="UltraBold"
           FontSize="18"
             TextWrapping="Wrap" /> 
            </Grid>




            <!--<Label 
            x:Name="notificationLabel"
            Grid.Row="2" Grid.Column="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"           
            FontSize="16"/>-->






            <ScrollViewer HorizontalScrollBarVisibility="Auto" Grid.Row="2">




                <TextBlock x:Name="notificationLabel"
                   Grid.Row="2" Grid.Column="1"
                   Padding="20 10 10 10"
                   Width="490"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   
                   TextWrapping="Wrap" 
                   />

            </ScrollViewer>




        </Grid>
    </Border>

</Window>