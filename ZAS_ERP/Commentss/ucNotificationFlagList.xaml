<UserControl x:Class="ZAS_ERP.Commentss.ucNotificationFlagList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Commentss"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblHeading" Text="Notification Flag List" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="0" FontFamily="Segoe UI Semibold"  />

        <dxg:GridControl x:Name="grdFlag"
                       MaxHeight="1300"
                       AutoGenerateColumns="AddNew"
                       Grid.Row="1"
                       SelectionMode="Row" >
            <dxg:GridControl.Columns>

                <dxg:GridColumn x:Name="colBackColor"
                      FieldName="backcolor"
                      Header="Flag Color"
                                       
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="1"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                    <dxg:GridColumn.CellTemplate>
                        <!--<DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PART_Editor">
                                            <InlineUIContainer>
                                                <Polygon Points="0,0 15,8, 0,15" Width="25" Margin="5 3 0 0" Stroke="{Binding RowData.Row.notificationFlag.backcolor}" Fill="{Binding RowData.Row.notificationFlag.backcolor}"/>
                      
                                            -->
                        <!--<TextBlock x:Name="PART_Editor1" Width="20" Margin="10,0"
                                                       Background="{Binding RowData.Row.notificationFlag.backcolor}"/>-->
                        <!--
                  
                                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2" 
                          Text="{Binding RowData.Row.notificationFlag.Status}"/>
                  </InlineUIContainer>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>-->

                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    
                                </Grid.ColumnDefinitions>
                                <TextBlock Padding="5 5 5 5" TextAlignment="Center" x:Name="PART_Editor">
                                    <InlineUIContainer>
                     <Polygon Points="0,0 25,10, 0,18" Width="40" Margin="5 3 0 0" Stroke="{Binding RowData.Row.backcolor}" Fill="{Binding RowData.Row.backcolor}"/>
                  </InlineUIContainer>
                                    <Run Text=" "/></TextBlock>
                            </Grid>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add New Flag"
                      x:Name="btnNewFlag"
                      Click="BtnNewFlag_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Edit Flag"
                      x:Name="btnEditFlag"
                      Click="BtnEditFlag_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </dxg:GridControl.ContextMenu>
        </dxg:GridControl>
    </Grid>
</UserControl>
