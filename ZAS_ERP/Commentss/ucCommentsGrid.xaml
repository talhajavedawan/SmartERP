<UserControl xmlns:dxn="http://schemas.devexpress.com/winfx/2008/xaml/navbar"  x:Class="ZAS_ERP.Commentss.ucCommentsGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Commentss"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:emoji="http://schemas.microsoft.com/xps/2005/06"
             mc:Ignorable="d" 
             xmlns:loc="clr-namespace:ZAS_ERP"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             d:DesignHeight="650" d:DesignWidth="1000" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <dxe:ButtonClose Grid.Column="2"
                       x:Name="btnclose"
                       Click="btncloseclick"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"/>

        <Border Grid.Column="0" BorderThickness="2" Padding="0" BorderBrush="Gray">
            <Grid>
                <Grid.RowDefinitions >
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />

                    </Grid.ColumnDefinitions>
                    <dx:SimpleButton  Style="{StaticResource Simplebutton}"  Height="25" Grid.Column="0" x:Name="mbtnInboxNotification" Click="mbtnInboxNotification_Click"  >
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{dx:DXImage Image=Inbox_16x16.png}" Width="18" Height="18"  Margin="0,0,5,0"/>

                            <TextBlock  Text="Inbox" VerticalAlignment="Center"/>
                        </StackPanel>
                    </dx:SimpleButton>
                    <dx:SimpleButton  Style="{StaticResource Simplebutton}"  Height="25"  Grid.Column="1" x:Name="mbtnSaveLayout" Click="MbtnSaveLayout_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{dx:DXImage Image=Save_16x16.png}" Width="18" Height="18"  Margin="0,0,5,0"/>

                            <TextBlock  Text="Save Layout" VerticalAlignment="Center"/>
                        </StackPanel>
                    </dx:SimpleButton>
                    <dx:SimpleButton Style="{StaticResource Simplebutton}" Grid.Column="2" x:Name="mbtnAllUnreadNotification" Click="mbtnAllUnreadNotification_Click" >
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{dx:DXImage Image=NextComment_16x16.png}" Width="18" Height="18"  Margin="5,0,5,0"/>
                            <TextBlock Text="Unread" Margin="0 0 0 0" Foreground="Black" />

                            <TextBlock Margin="5 0 0 0"  FontWeight="Bold" x:Name="txtUnReadcount" Width="70" Text="{Binding unReadCount}" Foreground="Red"/>
                        </StackPanel>
                    </dx:SimpleButton>

                    <dx:SimpleButton Style="{StaticResource Simplebutton}" Grid.Column="3" x:Name="mbtnAllPendingNotification" Click="MbtnAllPendingNotification_Click" >
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{dx:DXImage Image=NextComment_16x16.png}" Width="18" Height="18"  Margin="5,0,5,0"/>
                            <TextBlock Text="Pending" Margin="0 0 0 0" Foreground="Black" />

                            <TextBlock Margin="5 0 0 0"  FontWeight="Bold" x:Name="txtPendingCount" Width="70" Text="{Binding pendingCount}" Foreground="Red"/>
                        </StackPanel>
                    </dx:SimpleButton>

                    <dx:SimpleButton Style="{StaticResource Simplebutton}" Grid.Column="4" x:Name="mbtnRefNotification" Click="MbtnRefreshNotification_Click" Foreground="Black">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{dx:DXImage Image=Refresh2_16x16.png}" Width="18" Height="18"  Margin="5,0,5,0"/>
                            <TextBlock Text="Refresh" Margin="0 0 0 0" Foreground="Black" />

                        </StackPanel>
                    </dx:SimpleButton>

                    <dx:SimpleButton Style="{StaticResource Simplebutton}"   Grid.Column="5" x:Name="mbtnSentNotification" Click="MbtnSentNotification_Click" Foreground="Black">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{dx:DXImage Image=Outbox_16x16.png}" Width="18" Height="18"  Margin="5,0,5,0"/>
                            <TextBlock Text="Sent" Margin="0 0 0 0" Foreground="Black" />

                        </StackPanel>
                    </dx:SimpleButton>


                </Grid>
                <dxg:GridControl AutoExpandAllGroups="True"   
                                 SelectionMode="MultipleRow"  
                                 Grid.Row="1"   
                                 x:Name="grdNotifications"
                                 FilterChanged="GrdNotifications_FilterChanged"
                                 CustomUnboundColumnData="GrdNotifications_CustomUnboundColumnData"
                                 SelectionChanged="GrdNotifications_SelectionChanged">


                    <!--#region Columns-->
                    <dxg:GridControl.Columns>

                        <dxg:GridColumn x:Name="colFlag"
                      FieldName="notificationFlag.Flag"
                      Header="Flag"
                                       Image="{dx:DXImage Image=Status_16x16.png}"
                      UnboundType="Bound"
                      
                      VisibleIndex="1"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                            <dxg:GridColumn.CellTemplate>
                                <!--<DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PART_Editor">
                                            <InlineUIContainer>
                                                <Polygon Points="0,0 15,8, 0,15" Width="25" Margin="5 3 0 0" Stroke="{Binding RowData.Row.notificationFlag.backcolor}" Fill="{Binding RowData.Row.notificationFlag.backcolor}"/>
                      
                                            -->
                                <!--<TextBlock x:Name="PART_Editor1" Width="20" Margin="10,0"
                                                       Background="{Binding RowData.Row.notificationFlag.backcolor}"/>-->
                                <!--
                  
                                        </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2" 
                          Text="{Binding RowData.Row.notificationFlag.Status}"/>
                  </InlineUIContainer>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>-->

                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PART_Editor">
                                            <InlineUIContainer>
                                                <Polygon Points="0,0 15,8, 0,15" Width="25" Margin="5 3 0 0" Stroke="{Binding RowData.Row.notificationFlag.backcolor}" Fill="{Binding RowData.Row.notificationFlag.backcolor}"/>
                                            </InlineUIContainer><Run Text=" "/>
                                            <InlineUIContainer>
                                                <TextBlock x:Name="PART_Editor2" Text="{Binding RowData.Row.notificationFlag.Flag}" Foreground="Black" FontWeight="Bold"  VerticalAlignment="Center" Margin="0 -3 0 0"/>
                                            </InlineUIContainer>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <dxg:GridColumn Header="Module" Width="Auto" UnboundType="String" FieldName="TransactionType" Image="{dx:DXImage Image=BOTask_16x16.png}"/>
                        <dxg:GridColumn Header="From" Width="Auto" UnboundType="String" FieldName="FromUser" Image="{dx:DXImage Image=User_16x16.png}"/>
                        <dxg:GridColumn Width="Auto" Header="To" UnboundType="String" FieldName="ToUser" Image="{dx:DXImage Image=User_16x16.png}"/>
                        <dxg:GridColumn Width="Auto" Header="CC" UnboundType="String" FieldName="CCuser" Image="{dx:DXImage Image=User_16x16.png}"/>
                        <dxg:GridColumn Width="Auto" FieldName="Title" Image="{dx:DXImage Image=Edit_16x16.png}"/>
                        <dxg:GridColumn Width="Auto" FieldName="Description" Image="{dx:DXImage Image=ModelEditor_DetailView.png}"/>

                        <dxg:GridColumn Width="Auto" FieldName="isPending" Image="{dx:DXImage Image=ModelEditor_DetailView.png}"/>

                        <dxg:GridColumn Width="Auto" FieldName="billSystemRef" Binding="{Binding  BillReferenceNo}" Header="Bill Ref" Image="{dx:DXImage Image=HighlightField_16x16.png}" />
                        <dxg:GridColumn Width="Auto" FieldName="poSystemRef" Binding="{Binding  PoReferenceNo}" Header="PO System Ref" Image="{dx:DXImage Image=HighlightField_16x16.png}"/>
                        <dxg:GridColumn Image="{dx:DXImage Image=Time_16x16.png}"
                            Width="Auto" FieldName="Timestamp" GroupIndex="0" Header="Received" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Ascending">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <!--#endregion-->
                    <dxg:GridControl.View>
                        <dxg:TableView MouseDoubleClick="TableView_MouseDoubleClick"  ShowCheckBoxSelectorColumn="True"
                            x:Name="tableView" AllowEditing="False"   FocusedRowChanged="TableView_FocusedRowChanged"
                            LeftGroupAreaIndent="0" ShowSearchPanelMode="Always" SearchPanelNullText="Search Notification Box"
                            ShowGroupPanel="True" ShowIndicator="False" ShowVerticalLines="False"
                            CompactPanelShowMode="Always" SwitchToCompactModeWidth="700"
                             NavigationStyle="Row">


                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                    <dxg:FormatCondition.Format>
                                        <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>

                                <dxg:FormatCondition ApplyToRow="True" Expression="[isPending] = True" FieldName="isPending">
                                    <dx:Format Background="#FFE0E090" Foreground="Green" TextDecorations="{x:Null}"/>
                                </dxg:FormatCondition>
                                <dxg:UniqueDuplicateRuleFormatCondition FieldName="notificationFlag.Flag" Rule="Duplicate">
                                    <dx:Format Foreground="Black" FontFamily="Arial Black" TextDecorations="{x:Null}"/>
                                </dxg:UniqueDuplicateRuleFormatCondition>
                            </dxg:TableView.FormatConditions>
                            <!--#region CompactModeFilterItems-->
                            <dxg:TableView.CompactModeFilterItems>
                                <dxg:CompactModeFilterItem DisplayValue="All" />
                                <dxg:CompactModeFilterItem DisplayValue="Read" EditValue="[isRead] = True" />
                                <dxg:CompactModeFilterItem DisplayValue="Unread" EditValue="[isRead] = false" />


                            </dxg:TableView.CompactModeFilterItems>
                            <!--#endregion-->

                            <dxg:TableView.RowStyle>
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Style.Triggers>
                                        <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="True">
                                            <Setter Property="Background" Value="SkyBlue" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </dxg:TableView.RowStyle>



                        </dxg:TableView>


                    </dxg:GridControl.View>
                </dxg:GridControl>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="125" />
                    </Grid.ColumnDefinitions>
                    <dx:SimpleButton Style="{StaticResource Simplebutton}"  Name="mbtnMarkAsRead" Click="MbtnMarkAsRead_Click" Grid.Column="0" Foreground="Black">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{dx:DXImage Image=CheckBox_32x32.png}" Width="18" Height="18"  Margin="0,0,5,0"/>

                            <TextBlock  Text="Mark Read" VerticalAlignment="Center"/>
                        </StackPanel>
                    </dx:SimpleButton>
                    <dx:SimpleButton Style="{StaticResource Simplebutton}"  Name="mbtnCounter" Grid.Column="1" Foreground="Black">
                        <StackPanel Orientation="Horizontal" Margin="5 0 5 0">
                            <TextBlock Text="Count" Foreground="Black" />
                            <TextBlock Margin="5,0" FontWeight="Bold" x:Name="txtCounter" Width="40" Text="{Binding counter}" Foreground="Red"/>
                        </StackPanel>
                    </dx:SimpleButton>
                    <dx:SimpleButton Style="{StaticResource Simplebutton}"  Name="mbtnSelectedCounter" Grid.Column="2" Foreground="Black">
                        <StackPanel Orientation="Horizontal" Margin="5 0 5 0">
                            <Image Source="{dx:DXImage Image=CheckBox2_16x16.png}" Width="18" Height="18"  Margin="0,0,2,0"/>

                            <TextBlock Text="Selected" Foreground="Black" />
                            <TextBlock Margin="5,0" FontWeight="Bold" x:Name="txtSelected" Width="70" Text="{Binding selectedCounter}" Foreground="Red"/>
                        </StackPanel>
                    </dx:SimpleButton>
                    <dx:SimpleButton Style="{StaticResource Simplebutton}"  Name="mbtnFilteredCounter" Grid.Column="3" Foreground="Black">
                        <StackPanel Orientation="Horizontal" Margin="5 0 5 0">
                            <Image Source="{dx:DXImage Image=CheckBox2_16x16.png}" Width="18" Height="18"  Margin="0,0,2,0"/>

                            <TextBlock Text="Filtered" Foreground="Black" />
                            <TextBlock Margin="5,0" FontWeight="Bold" x:Name="txtFiltered" Width="70" Text="{Binding selectedCounter}" Foreground="Red"/>
                        </StackPanel>
                    </dx:SimpleButton>
                    <dx:SimpleButton Visibility="Collapsed" Style="{StaticResource Simplebutton}" Content="Load 20 More" Grid.Column="4" x:Name="mbtnMoreNotifications" Click="MbtnLoadMoreNotification_Click" Foreground="Black"/>
                    <dxe:DateEdit x:Name="datFrom" NullText="From" Grid.Column="4"/>
                    <dxe:DateEdit x:Name="datTo" NullText="To" Grid.Column="5"/>

                    <dx:SimpleButton Style="{StaticResource Simplebutton}" x:Name="mbtnLoad" Content="Load" Click="MbtnLoadMoreNotification_Click" Grid.Column="6" Foreground="Black"/>
                    <dx:SimpleButton Style="{StaticResource Simplebutton}" x:Name="mbtnLoadAll" Click="MbtnLoadAll_Click" Content="Load All" Grid.Column="7" Foreground="Black"/>
                    <dx:SimpleButton Style="{StaticResource Simplebutton}" x:Name="mbtnMarkAsUnread" Click="MbtnMarkAsUnread_Click"  Grid.Column="8" Foreground="Black">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{dx:DXImage Image=CheckBox_32x32.png}" Width="18" Height="18"  Margin="5,0,5,0"/>

                            <TextBlock  Text="Mark UnRead" VerticalAlignment="Center"/>
                        </StackPanel>
                    </dx:SimpleButton>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>

                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <dx:SimpleButton Style="{StaticResource Simplebutton}"  Name="mbtnMarkAsPending" Click="MbtnMarkAsPending_Click" Grid.Column="0" Foreground="Black">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{dx:DXImage Image=CheckBox_32x32.png}" Width="18" Height="18"  Margin="0,0,5,0"/>

                            <TextBlock  Text="Mark Pending" VerticalAlignment="Center"/>
                        </StackPanel>
                    </dx:SimpleButton>
                    <dx:SimpleButton Style="{StaticResource Simplebutton}" x:Name="mbtnUnMarkAsPending" Click="MbtnUnMarkAsPending_Click"  Grid.Column="8" Foreground="Black">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{dx:DXImage Image=CheckBox_32x32.png}" Width="18" Height="18"  Margin="5,0,5,0"/>

                            <TextBlock  Text="UnMark Pending" VerticalAlignment="Center"/>
                        </StackPanel>
                    </dx:SimpleButton>

                </Grid>
            </Grid>
        </Border>
        <GridSplitter x:Name="GridSplitter"  Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
        <Border Grid.Column="2"  BorderThickness="2" Padding="5" BorderBrush="Gray">
            <dx:DXTabControl Padding="5" SelectionChanged="DXTabControl_SelectionChanged">
                <dx:DXTabItem x:Name="tabNotification">
                    <dx:DXTabItem.Header>
                        <StackPanel Width="110" Orientation="Horizontal">
                            <Image Source="/ZAS_ERP;component/images/bell.png" Height="15" Width="15" Margin="0,0,5,0"/>
                            <TextBlock Text="Notification" FontWeight="DemiBold"/>
                        </StackPanel>
                    </dx:DXTabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="120"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <dxe:TextEdit x:Name="txtId" Visibility="Collapsed"/>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Height="100" Width="100" CornerRadius="20,5,20,5" BorderBrush="DeepSkyBlue" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush  x:Name="UserImage" ImageSource="/ZAS_ERP;component/images/users-vector-icon-png_260862.jpg"/>
                                </Border.Background>
                            </Border>
                            <StackPanel Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtUserName" FontWeight="DemiBold" Margin="10 0 0 0" TextWrapping="WrapWithOverflow" HorizontalAlignment="Left" Text="User Name"/>
                                <TextBlock x:Name="txtDesignation" Margin="10 5 0 0" TextWrapping="WrapWithOverflow" HorizontalAlignment="Left" Text="Designation"/>
                            </StackPanel>
                        </Grid>

                        <!--<StackPanel Orientation="Horizontal" Grid.Row="1">
                    <TextBlock Text="Company: " Grid.Row="1" FontWeight="DemiBold" Height="22" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCompany" TextWrapping="WrapWithOverflow" Text="Transaction Type" Grid.Row="1" FontWeight="DemiBold" Height="22" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Row="2">
                    <TextBlock Text="Deparment: " Grid.Row="1" FontWeight="DemiBold" Height="22" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtDepartment" Text="Transaction Type" Grid.Row="2" FontWeight="DemiBold" Height="22" VerticalAlignment="Center"/>
                </StackPanel>-->
                        <StackPanel Grid.Row="1" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" >
                                <TextBlock Text="Flag: " FontWeight="Bold" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Width="200" Height="25"
                                        TabIndex="10" x:Name="cmbNotificationFlag" SelectionChanged="CmbNotificationFlag_SelectionChanged">
                                    <ComboBox.ItemTemplate>

                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding id}" Visibility="Hidden" />
                                                <!--<TextBlock Text="   " Background="{Binding bcolor}"
                                                Width="20" Margin="10,0" />-->
                                                <Polygon Points="0,0 15,8, 0,15" Width="25" Margin="5 3 0 0" Height="22" Stroke="{Binding bcolor}" Fill="{Binding bcolor}"/>
                                                <TextBlock Text="{Binding name}" Grid.Column="1" Margin="5 3 0 0"
                                                Foreground="{Binding fcolor}"
                                                HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Image Source="/ZAS_ERP;component/images/glowon.png" ToolTip="Click to turn Off Glow" x:Name="imgGlowOn" MouseUp="ImgGlowOn_MouseUp" Margin="5 0 0 5" Height="30" Width="30" Visibility="Collapsed"/>
                                <Image Source="/ZAS_ERP;component/images/glowoff.png" ToolTip="Click to turn On Glow" x:Name="imgGlowOff" MouseUp="ImgGlowOff_MouseUp" Margin="5 0 0 5" Height="30" Width="30" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Module: " Grid.Row="1" FontWeight="Bold" Height="22" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTransactionType" Text="Transaction Type" TextWrapping="WrapWithOverflow" Grid.Row="3" FontWeight="SemiBold" Height="22" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <emoji:TextBox IsReadOnly="True" TextWrapping="WrapWithOverflow" VerticalScrollBarVisibility="Visible"
                 Grid.Row="2" Grid.RowSpan="2" x:Name="txtComment" MinHeight="50"   ></emoji:TextBox>

                        <dx:SimpleButton x:Name="btnSave" FontWeight="Bold" FontSize="18" Grid.Row="5" Click="BtnSave_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{dx:DXImage Image=Action_Validation_Validate_32x32.png}" Width="25" Height="25"  Margin="0,0,2,0"/>
                                <TextBlock Text="Save"/>
                            </StackPanel>
                        </dx:SimpleButton>
                    </Grid>
                </dx:DXTabItem>
                <dx:DXTabItem x:Name="tabModuleDetails">
                    <dx:DXTabItem.Header>
                        <StackPanel Width="110" Orientation="Horizontal">
                            <Image Source="{dx:DXImage Image=BOTask_16x16.png}" Height="15" Width="15" Margin="0,0,5,0"/>
                            <TextBlock Text="Mobile View" FontWeight="DemiBold"/>
                        </StackPanel>
                    </dx:DXTabItem.Header>

                    <Grid>


                        <Grid x:Name="grdAttach1"   Width="250" Visibility="Collapsed"  Background="White"  Panel.ZIndex="5" VerticalAlignment="Top" Margin="0,65,0,0" HorizontalAlignment="Center">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />

                                    <ColumnDefinition Width="1*" />

                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Category"
                         
                         
                         Margin="5,0,5,0" Grid.Column="0"/>
                                <ComboBox x:Name="cmbCategory1"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                          Margin="5,5"
                      Grid.Row="0"
                      TabIndex="0"
                      >
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel  Orientation="Horizontal">
                                                <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                                                <TextBlock Text="{Binding name}"></TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>


                                <!--<TextBlock Text=" [" Foreground="Blue" />-->
                                <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                                <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.ColumnSpan="2" Content="Select file" Margin="5" x:Name="btnAttachment1" Click="BtnAttachment1_Click" Foreground="Blue"  Tag="{Binding description}"></Button>
                                <!--<TextBlock Text="]" Foreground="Blue" />-->

                            </Grid>

                        </Grid>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="25"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="1" Margin="0 5 0 0">



                                    <StackPanel Grid.Row="1" Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Center"
                 Grid.Column="1" Orientation="Horizontal">

                                        <dx:SimpleButton Height="30" Padding="2" Width="30" Margin="0,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1"  Click="BtnMarkReviewed_Click"  ToolTip="Approve - Mark as Reviewed">
                                            <Image Source="/ZAS_ERP;component/images/approve.png"></Image>
                                        </dx:SimpleButton>
                                        <dx:SimpleButton Padding="2" Height="30" Width="30" Margin="5,0,0,0" Visibility="Collapsed" x:Name="btnReject" Grid.Column="2" ToolTip="Reject">
                                            <Image Source="/ZAS_ERP;component/images/reject.png"></Image>
                                        </dx:SimpleButton>
                                        <dx:SimpleButton Padding="2" Height="30" Width="30" Margin="5,0,0,0" x:Name="btnClose" Grid.Column="2" 
                    Click="BtnClose_Click"  ToolTip="Direct Close">
                                            <Image Source="/ZAS_ERP;component/images/block-icon.png"></Image>
                                        </dx:SimpleButton>
                                        <dx:SimpleButton Padding="2" Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" ToolTip="Add New Comment" Click="BtnAddComment_Click">
                                            <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
                                        </dx:SimpleButton>

                                        <dx:SimpleButton Padding="2" Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnSetVoid" Visibility="Visible" Click="BtnSetVoid_Click" Grid.Column="2" ToolTip="Void">
                                            <Image Source="/ZAS_ERP;component/images/void_order.png" ></Image>
                                        </dx:SimpleButton>
