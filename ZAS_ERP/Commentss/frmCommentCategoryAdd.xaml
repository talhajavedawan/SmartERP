<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ZAS_ERP.Commentss"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        x:Class="ZAS_ERP.Commentss.frmCommentCategoryAdd"
             mc:Ignorable="d"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        WindowStartupLocation="CenterOwner"
             Height="300"
             Width="500" Title=" Comment Category" x:Name="winCommentCategoryAdd" 
        Loaded="winCommentCategoryAdd_Loaded" Closing="winCommentCategoryAdd_Closing">
    <Grid Margin="0,20,0,0">
        <Grid.Resources>
            <Style TargetType="{x:Type Label}">
                <Setter Property="Margin"
                Value="10,10" />
                <Setter Property="Foreground"
                Value="Gray" />
                <Setter Property="VerticalAlignment"
                Value="Center" />
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin"
                Value="10,0" />
                <Setter Property="MaxWidth"
                Value="350" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=" auto" />
            <ColumnDefinition Width=".8*" />
            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height=" auto" />
            <RowDefinition Height=" auto" />
            <RowDefinition Height="auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height=" 50" />
        </Grid.RowDefinitions>
        <Label Content="Comment Category"
           ToolTip="Comment Category"
           HorizontalAlignment="Right" />
        <TextBox x:Name="txtcommentCategory"
             Grid.Column="1"
             VerticalAlignment="Center" />


        <Label Content="Discription"
           HorizontalAlignment="Right"
           Grid.Row="1" />
        <TextBox x:Name="txtDiscription"
             Grid.Column="1" Grid.Row="1"
             VerticalAlignment="Center" MinLines="2" Margin="10" />
        <Label Content="isActive"
           ToolTip="Unselect to make it inActive"
           HorizontalAlignment="Right"
           Grid.Row="3" />
        <CheckBox x:Name="chkisactive"
                Margin="10,0"
                IsChecked="True"
                Grid.Column="1"
                Grid.Row="3" />
        <dxg:GridControl x:Name="gridTransactionTypes"
                             AutoGenerateColumns="AddNew"
                             Grid.ColumnSpan="1"
                         Grid.Column="2"
                         Grid.RowSpan="4"
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">
            
            <dxg:GridControl.View>
                <dxg:TreeListView x:Name="griddeptview"
                                  AutoWidth="True"
                                  
                                 
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">
                    <!--<dxg:TableView.DataContext>
                  <Databases:DBContextERP />
                </dxg:TableView.DataContext>-->
                </dxg:TreeListView>
            </dxg:GridControl.View>
         
            
        </dxg:GridControl>
