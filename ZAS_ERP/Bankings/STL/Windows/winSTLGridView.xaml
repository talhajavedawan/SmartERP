<dx:DXWindow x:Class="ZAS_ERP.Bankings.STL.Windows.winSTLGridView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SaleInvoicess.UserControls"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:loc="clr-namespace:ZAS_ERP"
        xmlns:dxnav="http://schemas.devexpress.com/winfx/2008/xaml/navigation"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        mc:Ignorable="d"
        Title="winSTLGridView" Height="auto" Width="800" 
             Icon="/ZAS_ERP;component/images/Report_16x16.png" 
             WindowState="Maximized" Loaded="Window_Loaded">

    <Window.Resources>
        <loc:MyConv x:Key="valueconverter"></loc:MyConv>

    </Window.Resources>
    <Grid>
        <GroupBox>
            <Grid x:Name="reportMainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>


                <dxr:RibbonControl Grid.Row="0" DockPanel.Dock="Top"  RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
                    <dxr:RibbonDefaultPageCategory>
                        <dxr:RibbonPage x:Name="lblHeading" ToolTip="Report Name" Caption="Home">
                            <dxr:RibbonPageGroup  Caption="Clipboard">
                                <dxb:BarButtonItem x:Name="btnDelete" KeyGesture="Delete" Cursor="Hand" Content="Delete Report" ItemClick="MbtnDeleteReport1_Click" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>
                                <dxb:BarButtonItem x:Name="btnPrintPreview" KeyGesture="Ctrl+P"  Cursor="Hand" Content="Print Preview" ItemClick="BtnPrintPreview_ItemClick"  Glyph="{dx:DXImage Image=Printer_32x32.png}" LargeGlyph="{dx:DXImage Image=Printer_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnSaveAsNew" KeyGesture="Ctrl+N" Cursor="Hand" Content="Save as new" ItemClick="MbtnSaveAsNew1_Click" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>
                                <dxb:BarButtonItem x:Name="btnRename" KeyGesture="Ctrl+X" Cursor="Hand" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_32x32.png}" />
                                <dxb:BarButtonItem x:Name="btnUpdate" KeyGesture="Ctrl+U"  Cursor="Hand" Content="Update" ItemClick="MbtnUpdateReport1_Click" Glyph="{dx:DXImage Image=Reset_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnCopy2" KeyGesture="Ctrl+R" Cursor="Hand" Content="Refresh" ItemClick="MbtnRefreshReport1_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToMemorizedReport1" Cursor="Hand" Content="Export to memorized" ItemClick="MbtnExportToMemorizedReport1_Click" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToStandardReport1" Cursor="Hand" ItemClick="MbtnExportToStandardReport1_Click" Content="Export to standard" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                                <!--<dxb:BarButtonItem x:Name="mbtnShareReport" Cursor="Hand" ItemClick="mbtnShareReport_ItemClick" Content="Share Report" Glyph="{dx:DXImage Image=Convert_32x32.png}"/>-->
                                <!--<dxb:BarButtonItem x:Name="mbtnDriectClose" Cursor="Hand" ItemClick="mbtnDriectClose_ItemClick" Content="Direct Close" />
                                <dxb:BarButtonItem x:Name="mbtnApprove" Cursor="Hand" ItemClick="mbtnApprove_ItemClick" Content="Approve" />-->
                            </dxr:RibbonPageGroup>
                            <!--<dxr:RibbonPageGroup Caption="Font">
                                <dxr:BarButtonGroup>
                                    <dxb:BarButtonItem Content="Export to Standard" Glyph="{dx:DXImage Image=Bold_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Italic" Glyph="{dx:DXImage Image=Italic_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Underline" Glyph="{dx:DXImage Image=Underline_16x16.png}"/>
                                </dxr:BarButtonGroup>

                            </dxr:RibbonPageGroup>-->
                        </dxr:RibbonPage>

                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>

                <!--ReportGridControl-->
                <dxg:GridControl Grid.Row="2"
                                 Grid.ColumnSpan="3"
            AutoGenerateColumns="AddNew"
            EnableSmartColumnsGeneration="True"
            Name="grdSTLRegister"
            CustomUnboundColumnData="grdSTLRegister_CustomUnboundColumnData"
            MouseDoubleClick="grdSTLRegister_MouseDoubleClick"
                         >
                    <dxg:GridControl.View>
                        <dxg:TableView
                        AllowEditing="False"
                        AllowPerPixelScrolling="True"
                        Name="tblViewPayments"
                        RowAnimationKind="None"
                    
                        ShowAutoFilterRow="True"
                        ShowTotalSummary="True"
                        WaitIndicatorType="Panel">
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition FieldName="paymentDueDays" ValueRule="Less" Value1="16" ApplyToRow="true">
                                    <dx:Format Background="#FFFF0000"/>
                                </dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>

                        </dxg:TableView>
                    </dxg:GridControl.View>




                    <dxg:GridColumn 
                      FieldName="Id"
                      Header="Id"
                    
                      
                      Visible ="True"
                      />

                    <dxg:GridColumn x:Name="CreationDate"
                      FieldName="CreationDate"
                      Header="Creation Date"

                      Visible ="True"
                      VisibleIndex="3"/>
                    <dxg:GridColumn FieldName="stlStatus.isActive"
                      x:Name="colisOpen"
                      IsSmart="True"
                      Header="Open"
                      Visible="False"
                     >
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock TextAlignment="Center"
                       Text="{Binding RowData.Row.stlStatus.isActive}" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colCompany"
                      FieldName="company.CompanyName"
                      Header="Company"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="5"/>
                    <dxg:GridColumn Header="Vendor"
                            FieldName="vendor.company.CompanyName"
                            IsSmart="True"
                            Width="auto" />
                    <dxg:GridColumn Header="Customer"
                            FieldName="customer.company.CompanyName"
                            IsSmart="True"
                            Width="auto" />
                    <dxg:GridColumn x:Name="colDepartments"
                      FieldName="department.DeptName"
                      Header="Department"
                     />
                    <dxg:GridColumn x:Name="user"
                      FieldName="user.userName"
                      Header="Creator"
                      Visible ="True"
                      AllowEditing="false"
                      VisibleIndex="7"/>

                    <dxg:GridColumn x:Name="stlStatus"
                      FieldName="stlStatus.Status"
                      Header="Status"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="1"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.stlStatus.backcolor}"/>
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.stlStatus.Status}"/>
                  </InlineUIContainer></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>


                    <dxg:GridColumn x:Name="LastStatusChangeDate"
                      FieldName="LastStatusChangeDate"
                      Header="Last Status Change Date"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="8"/>

                    <dxg:GridColumn x:Name="paymentMaturityDate"
                      FieldName="paymentMaturityDate"
                      Header="PMD"
                      HeaderToolTip="Payment Maturity Date"
                      Visible ="True"
                            AllowEditing="false"
                     />
                    <dxg:GridColumn x:Name="stlPaymentDate"
                      FieldName="stlPaymentDate"
                      Header="SPD"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="9"/>




                    <dxg:GridColumn
                      FieldName="creditTenureNo"
                      Header="CT"
                      HeaderToolTip="Credit Tenure"
                     />

                    <dxg:GridColumn x:Name="extendedCreditTenure"
                      FieldName="extendedCreditTenure"
                      Header="EPD"
                      HeaderToolTip="Extended Payment Date"
                      Visible ="True"
                      AllowEditing="false"
                     />




                    <dxg:GridColumn x:Name="extendedCreditTenureNo"
                      FieldName="extendedCreditTenureNo"
                      Header="ET"
                            HeaderToolTip="Extended Tenure"
                            VisibleIndex="13"/>

                  

                    <dxg:GridColumn 
                      FieldName="paymentDueDays1"
                      Header="PDD"
                                                    IsSmart="True" 

                                    UnboundType="Decimal"
                      HeaderToolTip="Payment Due Days"
                            VisibleIndex="13"/>

                    <dxg:GridColumn 
                      FieldName="stlUtilizedDays1"
                      Header="SUD"
                      UnboundType="Decimal"      
                      HeaderToolTip="STL Utilized Days"
                      Visible ="True"
                     />
                    <dxg:GridColumn x:Name="interest"
                      FieldName="interest.percentage"
                      Header="IP"
                      HeaderToolTip="Interest Percentage"
                    >

                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="InterestAmount"
                            Header="IATD"
                            HeaderToolTip="Interest amount tenure date"
                            IsSmart="True" 
                            Visible="False" 
                           >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="InterestAmountIAC"
                            Header="IACD"
                            HeaderToolTip="Interest amount currenct date"
                            IsSmart="True" 
                            UnboundType="Decimal"
                            Visible="False" 
                          />

                    <dxg:GridColumn FieldName="SER"
                            Header="SER"
                            HeaderToolTip="Sales Exchange Rate"
                            IsSmart="True" 
                             >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="STLAmountSER"
                            HeaderToolTip="STL Amount(SER)"
                            Header="SA (SER)"
                            IsSmart="True" 
                             >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="MER"
                            Header="MER"
                            HeaderToolTip="Market Exchange Rate"
                            IsSmart="True" 
                             >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="STLAmountMER"
                            HeaderToolTip="STL Amount(MER)"
                            Header="SA (MER)"
                            IsSmart="True" 
                             >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="interestAmountCurrency"
                      FieldName="interestAmountCurrency.CurrencyName"
                      Header="IAC"
                           HeaderToolTip="Interest Amount Currency" 
                            >

                    </dxg:GridColumn>



                    <dxg:GridColumn x:Name="paymentAmountOC"
                      FieldName="paymentAmountOC"
                      Header="PAOC" 
                            HeaderToolTip="Payment Amount (OC)"
                              >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="paymentCurrency"
                      FieldName="paymentCurrency.CurrencyName"
                      Header="PC"
              HeaderToolTip="Payment Currency"

              
                      VisibleIndex="27">

                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="stlPaymentAmountOC"
                      FieldName="stlPaymentAmountOC"
                                                        HeaderToolTip="STL Payment Amount (OC)"

                      Header="SPA"
                      
                 >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn x:Name="stlCurrency"
                      FieldName="stlCurrency.CurrencyName"
                      Header="SC"
                      HeaderToolTip="STL Currency"

                      VisibleIndex="33">

                    </dxg:GridColumn>


                    <dxg:GridColumn x:Name="settlmentAmount"
                      FieldName="settlmentAmount"
                      Header="SSA"
                      HeaderToolTip="STL Settlement Amount"
                     
                          >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn x:Name="settlmentBalance"
                      FieldName="settlmentBalance"
                      Header="SBSA"
                            HeaderToolTip="STL Balance Settlement Amount"
                             >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="cashMarginAmount"
                            Header="CMA"
                            IsSmart="True" 
                            Visible="False" 
                            HeaderToolTip="Cash Margin Amount"
                          >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="cashMarginCurrency.CurrencyName"
                            Header="CMC"
                            IsSmart="True" 
                            Visible="False" 
                            HeaderToolTip="Cash Margin Currency"
                          />
                    <dxg:GridColumn FieldName="cashMarginPerc.Name"
                            Header="CMP"
                            IsSmart="True" 
                            Visible="False" 
                            HeaderToolTip="Cash Margin %"
                          />

                    <dxg:GridColumn x:Name="marginReversal"
                      FieldName="marginReversal"
                      Header="CMR"
                      HeaderToolTip="Cash Margin Reversal"
                      >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>



                    <dxg:GridColumn x:Name="stage"
                      FieldName="stage"
                      Header="Stage"
                   
                      VisibleIndex="16">

                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="isVoid"
                      FieldName="isVoid"
                      Header="isVoid"
                      />

                    <dxg:GridColumn x:Name="isReviewed"
                      FieldName="isReviewed"
                      Header="isReviewed"
          />

                    <dxg:GridColumn x:Name="needReview"
                      FieldName="needReview"
                      Header="Need Review"
            
                      VisibleIndex="19"/>

                    <dxg:GridColumn x:Name="PendingForClosing"
                      FieldName="PendingForClosing"
                      Header="Pending For Closing"
                   
                      VisibleIndex="20"/>

                    <dxg:GridColumn x:Name="PendingForReApproval"
                      FieldName="PendingForReApproval"
                      Header="Pending For ReApproval"
                   
                      VisibleIndex="21">

                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="isApproved"
                      FieldName="isApproved"
                      Header="isApproved"
                   
                      VisibleIndex="22"/>

                    <dxg:GridColumn x:Name="ApprovedDate"
                      FieldName="ApprovedDate"
                      Header="Approved Date"
                    
                      VisibleIndex="23"/>

                    <dxg:GridColumn x:Name="isReApproved"
                      FieldName="isReApproved"
                      Header="isReApproved"
                  
                      VisibleIndex="24"/>



                    <dxg:GridColumn x:Name="ClosingDate"
                      FieldName="ClosingDate"
                      Header="Closing Date"
                    
                      VisibleIndex="25"/>

                    <dxg:GridColumn x:Name="paymentBank"
                      FieldName="paymentBank.BankName"
                      HeaderToolTip="Payment Bank"
                      Header="PB"
                  
                      VisibleIndex="26">

                    </dxg:GridColumn>



                    <dxg:GridColumn x:Name="paymentAccount"
                      FieldName="paymentAccount.AccountNo"
                      Header="PAcc"
                      HeaderToolTip="Payment Account"
                    
                      VisibleIndex="28"/>









                    <dxg:GridColumn x:Name="stlBank"
                      FieldName="stlBank.BankName"
                      HeaderToolTip="STL Bank"
                      Header="SB"
                            
                            >

                    </dxg:GridColumn>





                    <dxg:GridColumn x:Name="stlAccount"
                      FieldName="stlAccount.AccountNo"
                      HeaderToolTip="STL Account"
                            Header="SAcc"
                      
                      VisibleIndex="34">

                    </dxg:GridColumn>


                    <dxg:GridColumn FieldName="cashMarginbank.BankName" 
                            Header="Cash Margin bank"
                            IsSmart="True" 
                          />
                    <dxg:GridColumn FieldName="cashMarginCurrency.CurrencyName" 
                            Header="Cash Margin Currency"
                            IsSmart="True" 
                            />


                    <dxg:GridColumn FieldName="cashMarginAccount.AccountNo" 
                            
                            Header="CashMargin Account"
                            IsSmart="True" 
                            Visible="False" />
                    <dxg:GridColumn FieldName="cashMarginPercent"
                            Header="CashMargin Percent"
                            IsSmart="True"
                           />




                </dxg:GridControl>
                <TextBlock x:Name="reportId" Text="" Visibility="Hidden"/>

               

            </Grid>
        </GroupBox>

        <Image
        x:Name="loadingGif"    
       
            
        Visibility="Hidden"
        Grid.Row="2"
            
         gif:AnimationBehavior.SourceUri="/ZAS_ERP;component/images/loadingReports.gif"   
        VerticalAlignment="Center"
        HorizontalAlignment="Center" RenderTransformOrigin="12.987,0.793" Margin="5,100,5,5" Width="60" />
    </Grid>
</dx:DXWindow>
