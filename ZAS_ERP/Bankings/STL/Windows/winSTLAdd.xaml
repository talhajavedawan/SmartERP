<dx:DXWindow x:Class="ZAS_ERP.Bankings.STL.winSTLAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vali="clr-namespace:ZAS_ERP.Validations"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:loc="clr-namespace:ZAS_ERP"
        xmlns:local="clr-namespace:ZAS_ERP.Bankings.STL" xmlns:dxnav="http://schemas.devexpress.com/winfx/2008/xaml/navigation"
             mc:Ignorable="d"
        Title="Short-Term Loan"       d:DesignHeight="1000"
             d:DesignWidth="1000" WindowState="Maximized" WindowStartupLocation="CenterScreen" Loaded="DXWindow_Loaded">

    <dx:DXWindow.CommandBindings>
        <CommandBinding Command="loc:CustomCommands.ReplytoComment" CanExecute="Command_CanExecute" Executed="Command_Executed" />
        <CommandBinding Command="loc:CustomCommands.ChangeFlag" CanExecute="Resend_CanExecute" Executed="Resend_Executed" />
    </dx:DXWindow.CommandBindings>

    <dx:DXWindow.Resources>
        <BooleanToVisibilityConverter x:Key="b2v"/>
        <DataTemplate x:Key="borderTemplate">
            <Border x:Name="border"
                    Width="44" 
                        Background="White" 
                        BorderThickness="2" 
                        BorderBrush="#FF333333" 
                        CornerRadius="10"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Background" TargetName="border" Value="Green"/>
                    <Setter Property="BorderThickness" TargetName="border" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="false">
                    <Setter Property="Background" TargetName="border" Value="#6DFF0000"/>
                    <Setter Property="BorderThickness" TargetName="border" Value="0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="thumbTemplate">
            <Ellipse x:Name="thumb"
                         Fill="#FF333333" 
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         Width="10" Height="10" Margin="8,0"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Fill" TargetName="thumb" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </dx:DXWindow.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Visibility="Visible">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Left"
                 Grid.Column="0" Orientation="Horizontal" Margin="0 5 0 0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click" dx:ThemeManager.ThemeName="None">
                            <Image Source="/ZAS_ERP;component/images/log.png"></Image>
                        </Button>
                        <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1"  Click="BtnMarkReviewed_Click"  ToolTip="Approve - Mark as Reviewed" dx:ThemeManager.ThemeName="None">
                            <Image Source="/ZAS_ERP;component/images/approve.png"></Image>
                        </Button>
                        <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnClose" Click="BtnClose_Click" Grid.Column="2" ToolTip="Direct Close" dx:ThemeManager.ThemeName="None">
                            <Image Source="/ZAS_ERP;component/images/block-icon.png"></Image>
                        </Button>
                        <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" ToolTip="Add New Comment" Click="BtnAddComment_Click" dx:ThemeManager.ThemeName="None">
                            <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
                        </Button>
                        <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2"  ToolTip="CommentLog" Click="BtnCommentLog_Click" dx:ThemeManager.ThemeName="None">
                            <Image Source="/ZAS_ERP;component/images/comments.png" ></Image>
                        </Button>

                        <Button x:Name="btnAttachNew" Visibility="Collapsed" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Attach a File" Click="BtnAttachNew_Click" dx:ThemeManager.ThemeName="None">
                            <Image x:Name="imgAttachNew" Source="/ZAS_ERP;component/images/clipattachment.png"></Image>
                        </Button>
                        <Button x:Name="btnAttachmentList" Visibility="Collapsed" Width="30" Height="30" Grid.Column="3" ToolTip="Attachment List" Click="BtnAttachmentList_Click" dx:ThemeManager.ThemeName="None">
                            <Image Source="/ZAS_ERP;component/images/ListAttachment.png"></Image>
                        </Button>
                        <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnTrackingWindow" Click="BtnTrackingWindow_Click" Grid.Column="2" ToolTip="360 View" dx:ThemeManager.ThemeName="None">
                            <Image Source="/ZAS_ERP;component/images/360Arrow.png" ></Image>
                        </Button>
                        <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnSetVoid" Visibility="Visible" Click="BtnSetVoid_Click" Grid.Column="2" ToolTip="Void" dx:ThemeManager.ThemeName="None">
                            <Image Source="/ZAS_ERP;component/images/void_order.png" ></Image>
                        </Button>
                        <Button x:Name="btnAttachNew1" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Attach document" Click="BtnAttachNew1_Click" dx:ThemeManager.ThemeName="None">
                            <Image x:Name="imgAttachNew1"  Source="{dx:DXImage Image=Attachment_32x32.png}"></Image>
                        </Button>
                        <Button x:Name="btnAttachmentList1"  Width="30" Height="30" Grid.Column="3" ToolTip="List of Attachments" Click="BtnAttachmentList1_Click" dx:ThemeManager.ThemeName="None">
                            <Image  Source="{dx:DXImage Image=ListNumbers_32x32.png}"></Image>
                        </Button>
                        <Button x:Name="btnStageTracking"  Width="30" Height="30"  Grid.Column="3" Margin="5,5,5,5" ToolTip="Orders Stage Tracking" Click="btnStageTracking_Click" Visibility="Visible">
                            <Image   Source="{dx:DXImage Image=PackageProduct_32x32.png}"></Image>
                        </Button>
                    </StackPanel>
                    <dx:SimpleButton Height="30" Glyph="{dx:DXImage Image=Accounting_16x16.png}" Content="Gernal Journal" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center"  Cursor="Hand" Margin="5,0,0,0" x:Name="btnGJournal" Visibility="Visible" Grid.Column="2" Click="BtnGJournal_Click"  ToolTip="Gernal Journal"/>
                    <dx:SimpleButton Height="30" Glyph="{dx:DXImage Image=Accounting_16x16.png}" Content="Create IBT" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center"  Cursor="Hand" Margin="5,0,0,0" x:Name="btnCreateIBT" Visibility="Visible" Grid.Column="2" Click="btnCreateIBT_Click"  ToolTip="Create IBT"/>
                    <dx:SimpleButton Height="30" Glyph="{dx:DXImage Image=Accounting_16x16.png}" Content="Create ICBT" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center"  Cursor="Hand" Margin="5,0,0,0" x:Name="btnCreateICBT" Visibility="Visible" Grid.Column="2" Click="btnCreateICBT_Click"  ToolTip="Create ICBT"/>

                </StackPanel>
                <Grid x:Name="gridOrderStageTrack"   Grid.RowSpan="2"  Visibility="Collapsed"    Panel.ZIndex="5" VerticalAlignment="Top"  Margin="180,45,65,35" HorizontalAlignment="Left">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <dxnav:TileNavPane  VerticalAlignment="Center">
                            <dxnav:TileNavPane.NavButtons>
                                <dxnav:NavButton x:Name="btnOrderStageByTrack"    FontWeight="Bold" Content="   Orders Tracking" ToolTip="Orders Tracking" Cursor="Hand" GlyphAlignment="Left"  AllowGlyphTheming="True" HorizontalAlignment="Stretch" />
                                <dxnav:NavButton x:Name="btnRefresh" Content="Refresh" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top"  Glyph="{dx:DXImageGrayscale Image=Refresh_32x32.png}" Click="btnRefresh_Click"/>
                                <dxnav:NavButton x:Name="btnExpand" Content="Expand" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top" Glyph="{dx:DXImage Image=CollapseFieldPivotTable_32x32.png}"  Click="btnExpand_Click_1"/>
                                <dxnav:NavButton x:Name="btnCollapsed" Content="Collapse" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top" Glyph="{dx:DXImage Image=ExpandFieldPivotTable_32x32.png}"   Click="btnCollapsed_Click"/>


                            </dxnav:TileNavPane.NavButtons>
                        </dxnav:TileNavPane>
                        <Grid  Grid.Row="1" >
                            <dxg:GridControl x:Name="grdOrdersTracking" MinHeight="500"   MaxHeight="790"  SelectionMode="Row"   AllowInitiallyFocusedRow="True" Grid.Row="2">
                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="grdTrackingTree"
                                        KeyFieldName="Id"
                                                       MouseDoubleClick="TreeListView_MouseDoubleClick"
                            ParentFieldName="ParentId"
                           AllowEditing="False"
                            NavigationStyle="Row"
                            Width="auto"
                            AutoWidth="True"      
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoPopulateServiceColumns="False"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True"      
                            ShowTotalSummary="True"    
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True"                           
                                                       >
                                        <dxg:TreeListView.FormatConditions>
                                            <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Closed">
                                                <dx:Format Background="#FFFF0000"/>
                                            </dxg:FormatCondition>
                                            <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Approved">
                                                <dx:Format Background="#FF9BBB59"/>
                                            </dxg:FormatCondition>
                                            <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Under Closing">
                                                <dx:Format Background="#FFF79646"/>
                                            </dxg:FormatCondition>

                                            <dxg:FormatCondition FieldName="Stage" ValueRule="Equal" Value1="Under Approval" ApplyToRow="false">
                                                <dx:Format Background="#8E4CACC7"/>
                                            </dxg:FormatCondition>
                                            <dxg:FormatCondition FieldName="Stage" ValueRule="Equal" Value1="Void" ApplyToRow="false">
                                                <dx:Format Background="#FFBFBFBF"/>
                                            </dxg:FormatCondition>
                                        </dxg:TreeListView.FormatConditions>

                                    </dxg:TreeListView>
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="Id" Visible="False"/>
                                <dxg:GridColumn FieldName="GroupId" Header="Group Id"  Visible="False" />
                                <dxg:GridColumn FieldName="Stage" VisibleIndex="7" Header="Stage"  Image="{dx:DXImage Image=Action_Show_PivotGrid_Designer.png}"/>

                                <dxg:GridColumn 
                                    VisibleIndex="6"
                                          FieldName="_Status"
                                          Header="Status"
                                          UnboundType="Bound"
                                          Image="{dx:DXImage Image=Status_16x16.png}"
                                          Visible ="True"
                                          AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.BackColor}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.Status}"/>
                  </InlineUIContainer></TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn 
                                    VisibleIndex="6"
                                          FieldName="_StatusClass"
                                          Header="Status Class"
                                          UnboundType="Bound"
                                          Image="{dx:DXImage Image=Status_16x16.png}"
                                          Visible ="True"
                                          AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.BackColorStatusClass}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.StatusClass}"/>
                  </InlineUIContainer></TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>

                                <dxg:GridColumn FieldName="Company" VisibleIndex="1" Header="Company" Image="{dx:DXImage Image=Home_16x16.png}"/>
                                <dxg:GridColumn FieldName="Department" VisibleIndex="2" Header="Department" Image="{dx:DXImage Image=BO_Department.png}"/>
                                <dxg:GridColumn FieldName="Vendor" VisibleIndex="3" Header="Vendor" Image="{dx:DXImage Image=BO_Department.png}"/>
                                <dxg:GridColumn FieldName="Currency" VisibleIndex="4" Header="Currency"  Image="{dx:DXImage Image=Currency2_16x16.png}"/>
                                <dxg:GridColumn FieldName="AmountOC" VisibleIndex="5" Header="Amount(OC)"  Image="{dx:DXImage Image=Currency2_16x16.png}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="transactionType" VisibleIndex="0" Header="Transaction Type"  Image="{dx:DXImage Image=Currency2_16x16.png}">

                                </dxg:GridColumn>




                            </dxg:GridControl>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid x:Name="grdAttachments1"  Grid.RowSpan="5"  Width="300" Visibility="Collapsed" Background="Gray" Panel.ZIndex="5" VerticalAlignment="Top" Margin="315,30,65,35" HorizontalAlignment="Left" dx:ThemeManager.ThemeName="None">
                    <TreeView x:Name="treeViewAttachments1" >
                        <TreeView.Resources>
                            <HierarchicalDataTemplate  DataType="{x:Type loc:TreeItem}" ItemsSource="{Binding Items}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding name}"
                         Grid.Column="0"
                         
                         HorizontalAlignment="Stretch" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text=" [" Foreground="Blue" />
                                        <TextBlock Text="{Binding Items.Count}" Foreground="Blue" />
                                        <TextBlock Text="]" Foreground="Blue" />
                                    </StackPanel>
                                </Grid>
                            </HierarchicalDataTemplate>
                            <DataTemplate  DataType="{x:Type loc:cmbitem}" >
                                <StackPanel>
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />

                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="1*" />

                                        </Grid.ColumnDefinitions>
                                        <!--<CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>-->
                                        <TextBlock Text="{Binding id}"
                         Visibility="Collapsed" />
                                        <TextBlock Text="{Binding description}"
                         Visibility="Collapsed" />
                                        <Button Content="Open" Margin="5,0" x:Name="btnDownloadAttachment" Click="BtnDownloadAttachment_Click" Foreground="Blue"  Tag="{Binding description}"></Button>

                                        <TextBlock Text="   "
                         Background="{Binding bcolor}"
                         Width="20"
                         Margin="0,0,5,0" Grid.Column="1"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" >
                                            <TextBlock Text="{Binding name}"
                         Grid.Column="1"
                         
                         HorizontalAlignment="Stretch" />

                                            <!--<TextBlock Text=" [" Foreground="Blue" />-->
                                            <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                                            <!--<TextBlock Text="]" Foreground="Blue" />-->
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                            <!--<HierarchicalDataTemplate DataType="{x:Type self:cmbitem}"  >
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />

                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="1*" />
                                                    
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>
                                                <TextBlock Text="{Binding id}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="{Binding description}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="   "
                         Background="{Binding bcolor}"
                         Width="20"
                         Margin="0,0,5,0" Grid.Column="1"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding name}"
                         Grid.Column="1"
                         
                         HorizontalAlignment="Stretch" />
                                                
                                                    <TextBlock Text=" [" Foreground="Blue" />
                                                    <TextBlock Text="{Binding fcolor}" Foreground="Blue" />
                                                    <TextBlock Text="]" Foreground="Blue" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>-->
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
                <Grid x:Name="grdAttach1"  Grid.RowSpan="5" Width="250" Visibility="Collapsed"  Background="White"  Panel.ZIndex="5" VerticalAlignment="Top" Margin="300,32,65,35" HorizontalAlignment="Left">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />

                            <ColumnDefinition Width="1*" />

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Category"
                         
                         
                         Margin="5,0,5,0" Grid.Column="0"/>
                        <ComboBox x:Name="cmbCategory1"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                          Margin="5,5"
                      Grid.Row="0"
                      TabIndex="0"
                      >
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel  Orientation="Horizontal">
                                        <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                                        <TextBlock Text="{Binding name}"></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>


                        <!--<TextBlock Text=" [" Foreground="Blue" />-->
                        <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.ColumnSpan="2" Content="Select file" Margin="5" x:Name="btnAttachment1" Click="BtnAttachment_Click" Foreground="Blue"  Tag="{Binding description}"></Button>
                        <!--<TextBlock Text="]" Foreground="Blue" />-->

                    </Grid>

                </Grid>
                <Grid x:Name="grdComments" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed" Width="450" Height="800"  Background="Gray" Panel.ZIndex="5" VerticalAlignment="Stretch" Margin="35" HorizontalAlignment="Left">

                    <dxg:GridControl AutoExpandAllGroups="True"  Height="auto" Grid.Row="1"  dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">

                        <!--#region Columns-->
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn  Width="auto" FieldName="employee.person.Photo" Header="Image" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ImageEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                            <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                            <dxg:GridColumn Width="Auto" FieldName="Subject" />
                            <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                            <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                            <dxg:GridColumn
                            Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Descending" />

                            <dxg:GridColumn x:Name="colFlag"
                      FieldName="notificationFlag.Flag"
                      Header="Flag"
                                       Image="{dx:DXImage Image=Status_16x16.png}"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="1"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="PART_Editor">
                                            <InlineUIContainer>
                                                <Polygon Points="0,0 15,8, 0,15" Width="25" Margin="5 3 0 0" Stroke="{Binding RowData.Row.notificationFlag.backcolor}" Fill="{Binding RowData.Row.notificationFlag.backcolor}"/>
                                            </InlineUIContainer><Run Text=" "/>
                                            <InlineUIContainer>
                                                <TextBlock x:Name="PART_Editor2" Text="{Binding RowData.Row.notificationFlag.Flag}" Foreground="Black" FontWeight="Bold"  VerticalAlignment="Center" Margin="0 -3 0 0"/>
                                            </InlineUIContainer>
                                        </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <!--#endregion-->
                        <dxg:GridControl.View>
                            <dxg:TableView 
                            x:Name="GrdCommenttableView"
                            AllowEditing="False" 
                            DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                            DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0"
                            RowStyle="{StaticResource RowStyle}"
                           
                            ShowSearchPanelMode="Always"
                            SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" 
                            ShowIndicator="False" 
                            ShowVerticalLines="False"
                            CompactPanelShowMode="Always" 
                            SwitchToCompactModeWidth="700"
                            NavigationStyle="Row"
                           >

                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>

                                    <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Changed')">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'STL Approved')">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>

                                    <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'STL UnApproved')">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>

                                    <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'STL Voided')">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Background="Orange" />

                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>

                                    <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'STL UnVoided')">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Background="Orange" />

                                        </dxg:FormatCondition.Format>
