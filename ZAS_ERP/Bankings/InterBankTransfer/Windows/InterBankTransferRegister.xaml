<Window x:Class="ZAS_ERP.Bankings.Windows.InterBankTransferRegister"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Bankings.Windows"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                xmlns:self="clr-namespace:ZAS_ERP"
        WindowState="Maximized" Loaded="Window_Loaded"
        mc:Ignorable="d"
        Title="InterBankTransferRegister" Height="450" Width="800">
    <Grid>


        <dxb:BarManager  Grid.Row="1" x:Name="faBarManager">

            <dxb:BarManager.Bars>
                <dxb:Bar Caption="faOp">

                    <dxb:Bar.DockInfo>
                        <dxb:BarDockInfo ContainerType="Top"/>
                    </dxb:Bar.DockInfo>

                    <dxb:BarButtonItem x:Name="addInterBankTransBarItem" ToolTip="Add Inter-Bank Transfer" 
                                       BarItemDisplayMode="ContentAndGlyph"  
                                       Glyph="/ZAS_ERP;component/images/icon-Add-ReportGroups.png" 
                                       Content="Add" ItemClick="AddInterBankTransBarItem_ItemClick"/>
                    <dxb:BarButtonItem x:Name="grdCollapse" 
                                       ItemClick="GrdCollapse_ItemClick"
                                       ToolTip="Collapse" 
                                       Content="Collapse Grid" />

                    <dxb:BarButtonItem ToolTip="Expand" x:Name="grdExpand" 
                                       BarItemDisplayMode="ContentAndGlyph" 
                                       ItemClick="GrdExpand_ItemClick"
                                       Content="Expand Grid" />
                </dxb:Bar>


            </dxb:BarManager.Bars>
            <Grid>

                <Grid.Resources>

                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="250*"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="faLeftGrid"  Grid.Column="0" Background="White">
                    <TabControl x:Name="faLeftPaneTabControl" >
                        <TabItem Header="Transactions" x:Name="interBankTransferTabItem">
                            <Grid Background="White">
                                <TreeView x:Name="treeViewInterBankTransStatus" SelectedItemChanged="TreeViewInterBankTransStatus_SelectedItemChanged">

                                    <TreeView.Resources>

                                        <HierarchicalDataTemplate DataType="{x:Type self:cmbitem}" ItemsSource="{Binding Items}" >
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />

                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="1*" />

                                                </Grid.ColumnDefinitions>
                                                <!--<CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>-->
                                                <TextBlock Text="{Binding id}" Visibility="Collapsed" />
                                                <TextBlock Text="{Binding description}" Visibility="Collapsed" />
                                                <TextBlock Text="   " Background="{Binding bcolor}"
                                                            Width="20"
                                                            Margin="0,0,5,0" Grid.Column="1"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding name}" Grid.Column="1"
                                                                HorizontalAlignment="Stretch" />

                                                    <!--<TextBlock Text=" [" Foreground="Blue" />-->
                                                    <!--<TextBlock Text="{Binding fcolor}" Foreground="Blue" />-->
                                                    <!--<TextBlock Text="]" Foreground="Blue" />-->
                                                </StackPanel>
                                            </Grid>
                                        </HierarchicalDataTemplate>

                                    </TreeView.Resources>
                                </TreeView>
                                <!--<TreeViewItem Header="Sale Receipts" Name="treeviewItemSaleReceipts"  >
                                        <TreeViewItem Header="Sale Receipt (Open)" x:Name="openStatus">
                                            <TreeViewItem/>
                                        </TreeViewItem>
                                        <TreeViewItem Header="Sale Receipt (Close)" x:Name="closeStatus">
                                            <TreeViewItem/>
                                        </TreeViewItem>
                                    </TreeViewItem>-->



                            </Grid>
                        </TabItem>
                        <!--<TabItem Header="Transactions" x:Name="faTransactionTabItem">
                            <Grid Background="White"/>
                        </TabItem>-->
                    </TabControl>

                </Grid>
                <GridSplitter x:Name="GridSplitter"  Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                <Grid x:Name="faRightGrid"  Grid.Column="2" Background="White" >


                </Grid>


            </Grid>
        </dxb:BarManager>

    </Grid>
</Window>
