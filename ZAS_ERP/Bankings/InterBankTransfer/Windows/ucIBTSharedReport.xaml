<dx:ThemedWindow  
    x:Class="ZAS_ERP.Bankings.InterBankTransfer.Windows.ucIBTSharedReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Bankings.InterBankTransfer.Windows"
        xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:loc="clr-namespace:ZAS_ERP"
        mc:Ignorable="d"
        Title="ucIBTSharedReport" Height="450" Width="800" Loaded="Window_Loaded">
    
    <Grid>
        <GroupBox>
            <Grid x:Name="reportMainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <dxr:RibbonControl Grid.Row="0" Grid.RowSpan="2" DockPanel.Dock="Top" RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
                    <dxr:RibbonDefaultPageCategory>
                        <dxr:RibbonPage  x:Name="lblHeading" Caption="Home" ToolTip="Report Name" >
                            <dxr:RibbonPageGroup  Caption="Clipboard">

                                <dxb:BarButtonItem x:Name="btnPrintPreview" KeyGesture="Ctrl+P"  Cursor="Hand" Content="Print Preview" ItemClick="BtnPrintPreview_ItemClick"  Glyph="{dx:DXImage Image=Printer_32x32.png}" LargeGlyph="{dx:DXImage Image=Printer_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnRename"  KeyGesture="Ctrl+X" Cursor="Hand" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_16x16.png}" />
                                <dxb:BarButtonItem x:Name="btnUpdate" KeyGesture="Ctrl+U" Cursor="Hand" Content="Update" ItemClick="MbtnUpdateReport1_Click" Glyph="{dx:DXImage Image=Reset_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnDelete" KeyGesture="Delete" Cursor="Hand" Content="Delete" ItemClick="MbtnDeleteReport1_Click" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>
                                <dxb:BarButtonItem x:Name="btnCopy2" KeyGesture="Ctrl+R" Cursor="Hand" Content="Refresh" ItemClick="MbtnRefreshReport1_Click"  Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                                <dxb:BarSplitButtonItem Content="Viewers" RibbonStyle="SmallWithText" Glyph="{dx:DXImage Image=Team_16x16.png}" >
                                    <dxb:BarSplitButtonItem.PopupControl>
                                        <dxb:PopupControlContainerInfo>
                                            <dxg:GridControl x:Name="grdEmployee"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                             MaxHeight="1000"
                                             MaxWidth="300"
                                                             
                                     Grid.Row="1"
                                     SelectionMode="Row"
                                      AllowInitiallyFocusedRow="False"
                                     >
                                                <dxg:GridControl.View>
                                                    <dxg:TableView x:Name="viewTableEmployee"
                               AutoWidth="True"
                                 ShowGroupPanel="False"
                              
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">
                                                    </dxg:TableView>

                                                </dxg:GridControl.View>
                                                <dxg:GridColumn x:Name="EmpId"
                                    FieldName="EmpId"
                                    IsSmart="True"
                                    Visible="False" />
                                                <dxg:GridColumn FieldName="person.Photo"
                                                VisibleIndex="0"
                                                    Header=" ">
                                                    <dxg:GridColumn.EditSettings>
                                                        <dxe:ImageEditSettings/>
                                                    </dxg:GridColumn.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn FieldName="person.FName"
                                                  VisibleIndex="1"
                                                    Header="First Name"/>
                                                <dxg:GridColumn FieldName="person.LName"
                                                  VisibleIndex="2"
                                                    Header="Last Name"/>
                                            </dxg:GridControl>
                                        </dxb:PopupControlContainerInfo>
                                    </dxb:BarSplitButtonItem.PopupControl>
                                </dxb:BarSplitButtonItem>
                            </dxr:RibbonPageGroup>
                            <!--<dxr:RibbonPageGroup Caption="Font">
                                <dxr:BarButtonGroup>
                                    <dxb:BarButtonItem Content="Export to Standard" Glyph="{dx:DXImage Image=Bold_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Italic" Glyph="{dx:DXImage Image=Italic_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Underline" Glyph="{dx:DXImage Image=Underline_16x16.png}"/>
                                </dxr:BarButtonGroup>

                            </dxr:RibbonPageGroup>-->
                        </dxr:RibbonPage>

                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>

                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <dxe:ImageEdit Grid.Column="0" Width="100" Height="100" ShowMenu="False" x:Name="UserImage" />
                    <StackPanel Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center">
                        <Label Content="Organized By" FontWeight="DemiBold" />
                        <TextBlock x:Name="txtUserName" FontWeight="SemiBold" Margin="10 0 0 0" TextWrapping="WrapWithOverflow" HorizontalAlignment="Left" Text="User Name"/>
                        <TextBlock x:Name="txtDesignation" Margin="10 5 0 0" TextWrapping="WrapWithOverflow" HorizontalAlignment="Left" Text="Designation"/>
                    </StackPanel>
                </Grid>
                <!--ReportGridControl-->
                <dxg:GridControl Grid.Row="2"
                 Grid.ColumnSpan="2"                
            AutoGenerateColumns="AddNew"
            EnableSmartColumnsGeneration="True"
            Name="grdCntrlInterBankTransfer"
            MouseDoubleClick="GrdInterBankTransfer_MouseDoubleClick"
                         CustomUnboundColumnData="GrdCntrlInterBankTransfer_CustomUnboundColumnData">

                 

                    <dxg:GridControl.View>
                        <dxg:TableView
                        AllowEditing="False"
                        AllowPerPixelScrolling="True"
                        Name="tblViewLandTypeLst"
                        RowAnimationKind="None"
                        ShowAutoFilterRow="True"
                        ShowTotalSummary="True"
                        WaitIndicatorType="Panel">

                        </dxg:TableView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn x:Name="colstatus"
                      FieldName="interBankTransStatus.Status"
                      Header="Status"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="1"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.interBankTransStatus.backcolor}"/>
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.interBankTransStatus.Status}"/>
                  </InlineUIContainer></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>


                    <dxg:GridColumn x:Name="colCreationDate"
                      FieldName="CreationDate"
                      Header="Creation Date"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="2">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colTransactionDate"
                      FieldName="TransactionDate"
                      Header="Transaction Date"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="3" 
                      SortOrder="Ascending" 
                      SortIndex="0"/>

                    <dxg:GridColumn x:Name="colTransferType"
                      FieldName="transferType"
                      Header="Transfer Type"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="4"/>

                    <dxg:GridColumn x:Name="colSystemRefNo"
                      FieldName="SystemRefNo"
                      Header="System Ref #"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="5"/>

                    <dxg:GridColumn x:Name="colFinanceRefNo"
                      FieldName="FinanceRefNo"
                      Header="Finance Ref No"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="6"/>

                    <dxg:GridColumn x:Name="colInstrumentNo"
                      FieldName="InstrumentNo"
                      Header="Instrument No"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="7"/>

                    <dxg:GridColumn x:Name="colCompany"
                      FieldName="company.CompanyName"
                      Header="Company"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="8"/>

                    <dxg:GridColumn x:Name="colDepartment"
                      FieldName="department.DeptName"
                      Header="Department"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="9"/>

                    <dxg:GridColumn x:Name="colEmployeeId"
                      FieldName="employee.EmpId"
                      Header="Employee Id"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="10"/>

                    <dxg:GridColumn x:Name="colTransferMethod"
                      FieldName="tranferMethod.MethodName"
                      Header="Transfer Method"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="11"/>

                    <dxg:GridColumn x:Name="colBankFrom"
                      FieldName="BankFrom.BankName"
                      Header="Bank From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="12"/>

                    <dxg:GridColumn x:Name="colAccountFrom"
                      FieldName="AccountFrom.AccountNo"
                      Header="Account From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="13"/>

                    <dxg:GridColumn x:Name="colBankTo"
                      FieldName="BankTo.BankName"
                      Header="Bank To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="14"/>

                    <dxg:GridColumn x:Name="colAccountTo"
                      FieldName="AccountTo.AccountNo"
                      Header="Account To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="15"/>

                    <dxg:GridColumn x:Name="colAmountOc"
                      FieldName="AmountOC"
                      Header="Amount (OC)"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="16"
                            >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colCurrency"
                      FieldName="currency.CurrencyName"
                      Header="Currency"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="17"/>

                    <dxg:GridColumn x:Name="colMER"
                      FieldName="MER"
                      Header="MER"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="18">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colAmountMER"
                      FieldName="AmountMER"
                      Header="Amount MER"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="19">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colAmountOCpaid"
                      FieldName="AmountOCPaid"
                      Header="Amount OC Paid"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="20">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colAmountMERpaid"
                      FieldName="AmountMERPaid"
                      Header="Amount MER Paid"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="21">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colTaxFlag"
                      FieldName="taxFlag"
                      Header="Tax Flag"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="22"/>

                    <dxg:GridColumn x:Name="colTaxType"
                      FieldName="taxType.TypeName"
                      Header="Tax Type"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="23"/>

                    <dxg:GridColumn x:Name="colTaxName"
                      FieldName="taxName.Name"
                      Header="Tax Name"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="24"/>

                    <dxg:GridColumn x:Name="colTaxAmountOC"
                      FieldName="TaxAmountOC"
                      Header="Tax Amount(OC)"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="25">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colTaxAmountMER"
                      FieldName="TaxAmountMER"
                      Header="Tax Amount(MER)"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="26">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colIndustry"
                      FieldName="industryType.name"
                      Header="Vendor Industry"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="27"/>

                    <dxg:GridColumn x:Name="colVendor"
                      FieldName="vendor.company.CompanyName"
                      Header="Vendor"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="28"/>

                    <dxg:GridColumn x:Name="colCurrencyFrom"
                      FieldName="currencyFrom.CurrencyName"
                      Header="Currency From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="29"/>

                    <dxg:GridColumn x:Name="colCurrencyTo"
                      FieldName="currencyTo.CurrencyName"
                      Header="Currency To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="30"/>

                    <dxg:GridColumn x:Name="colMERfrom"
                      FieldName="MERfrom"
                      Header="MER From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="31"/>

                    <dxg:GridColumn x:Name="colAmountMERfrom"
                      FieldName="AmountMERfrom"
                      Header="Amount MER From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="32"/>

                    <dxg:GridColumn x:Name="colMERto"
                      FieldName="MERto"
                      Header="MER To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="30"/>

                    <dxg:GridColumn x:Name="colAmountMERto"
                      FieldName="AmountMERto"
                      Header="Amount MER To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="30"/>

                    <dxg:GridColumn x:Name="colAmountTo"
                      FieldName="AmountTo"
                      Header="Amount To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="30"/>

                    <dxg:GridColumn x:Name="colAmountFrom"
                      FieldName="AmountFrom"
                      Header="Amount From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="30"/>

                    <dxg:GridColumn FieldName="interBankTransStatus"
                      IsSmart="True"
                      Header="isActive"
                      Visible="False"
                      Width="auto"
                      UnboundType="Object"/>

                    <dxg:GridColumn FieldName="Open"
                      x:Name="colisOpen"
                      IsSmart="True"
                      Header="Open"
                      Visible="False"
                      Width="auto"
                            UnboundType="string"/>

                    <dxg:GridColumn FieldName="Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="company_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="company" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="dept_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="department" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="emp_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="employee" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="currency_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="currency" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="bankFrom_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="BankFrom" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="accountFrom_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="AccountFrom" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="bankTo_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="BankTo" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="accountTo_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="AccountTo" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="tranferMethod_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="tranferMethod" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="user_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

                    <dxg:GridColumn FieldName="taxTypeId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="taxType" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="taxNameId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="taxName" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="industryTypeId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="industryType" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="vendor_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="vendor" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="currencyFromId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="currencyFrom" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="currencyToId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="currencyTo" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

                </dxg:GridControl>

                <TextBlock x:Name="reportId" Text="" Visibility="Hidden"/>
            </Grid>
        </GroupBox>



    </Grid>
</dx:ThemedWindow>
