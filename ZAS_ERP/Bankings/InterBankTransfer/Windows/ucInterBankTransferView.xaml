<dx:DXWindow x:Class="ZAS_ERP.Bankings.Windows.ucInterBankTransferView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Bankings.Windows"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Title="ucInterBankTransferView" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <GroupBox>
            <Grid x:Name="reportMainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <dxr:RibbonControl Grid.Row="0" DockPanel.Dock="Top"  RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
                    <dxr:RibbonDefaultPageCategory>
                        <dxr:RibbonPage x:Name="lblHeading" ToolTip="Report Name" Caption="Home"  >
                            <dxr:RibbonPageGroup  Caption="Clipboard">
                                <dxb:BarButtonItem x:Name="btnPrintPreview" KeyGesture="Ctrl+P"  Cursor="Hand" Content="Print Preview" ItemClick="BtnPrintPreview_ItemClick"  Glyph="{dx:DXImage Image=Printer_32x32.png}" LargeGlyph="{dx:DXImage Image=Printer_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnSaveAsNew" KeyGesture="Ctrl+N" Cursor="Hand" Content="Save as new" ItemClick="MbtnSaveAsNew1_Click" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>
                                <dxb:BarButtonItem x:Name="btnRename"  KeyGesture="Ctrl+X" Cursor="Hand" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_32x32.png}" />
                                <dxb:BarButtonItem x:Name="btnUpdate" KeyGesture="Ctrl+U"  Cursor="Hand" Content="Update" ItemClick="MbtnUpdateReport1_Click" Glyph="{dx:DXImage Image=Reset_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnDelete" KeyGesture="Delete" Cursor="Hand" Content="Delete" ItemClick="MbtnDeleteReport1_Click" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>
                                <dxb:BarButtonItem x:Name="btnCopy2" KeyGesture="Ctrl+R" Cursor="Hand" Content="Refresh" ItemClick="MbtnRefreshReport1_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToMemorizedReport1" Cursor="Hand" Content="Export to memorized" ItemClick="MbtnExportToMemorizedReport1_Click" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToStandardReport1" Cursor="Hand" ItemClick="MbtnExportToStandardReport1_Click" Content="Export to standard" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnShareReport" Cursor="Hand" ItemClick="mbtnShareReport_ItemClick" Content="Share Report" Glyph="{dx:DXImage Image=Convert_32x32.png}"/>

                            </dxr:RibbonPageGroup>
                            <!--<dxr:RibbonPageGroup Caption="Font">
                                <dxr:BarButtonGroup>
                                    <dxb:BarButtonItem Content="Export to Standard" Glyph="{dx:DXImage Image=Bold_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Italic" Glyph="{dx:DXImage Image=Italic_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Underline" Glyph="{dx:DXImage Image=Underline_16x16.png}"/>
                                </dxr:BarButtonGroup>

                            </dxr:RibbonPageGroup>-->
                        </dxr:RibbonPage>

                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>


                <!--ReportGridControl-->
                <dxg:GridControl Grid.Row="2"
            AutoGenerateColumns="AddNew"
                EnableSmartColumnsGeneration="True"
                Name="grdInterBankTransfer"
                                 MouseEnter="GrdInterBankTransfer_MouseEnter"
                         MouseDoubleClick="GrdInterBankTransfer_MouseDoubleClick">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tblViewLandTypeLst"
                             ShowGroupPanel="True" ShowIndicator="True" ShowVerticalLines="False"
                             SwitchToCompactModeWidth="700"
                             NavigationStyle="Row"
                             ShowAutoFilterRow="True" 
                             ShowSearchPanelMode="Always"          
                             ShowFixedTotalSummary="True"
                             SearchPanelNullText="Search"
                             ShowTotalSummary="True"  >
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition ApplyToRow="True" Expression="[isApproved] = False">
                                    <dxg:FormatCondition.Format>
                                        <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>
                            <!--#region CompactModeFilterItems-->
                            <dxg:TableView.CompactModeFilterItems>
                                <dxg:CompactModeFilterItem DisplayValue="All" />
                                <dxg:CompactModeFilterItem DisplayValue="Approved" EditValue="[isApproved] = True" /> 
                                <dxg:CompactModeFilterItem DisplayValue="Pending for Approvals" EditValue="[isApproved] = false"   />
                                <dxg:CompactModeFilterItem DisplayValue="Pending for Closing" EditValue="[PendingForClosing] = true" />
                                <dxg:CompactModeFilterItem DisplayValue="Pending for ReApproval" EditValue="[PendingForReApproval] = true" />
                            </dxg:TableView.CompactModeFilterItems>
                        </dxg:TableView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn x:Name="colstatus"
                      FieldName="interBankTransStatus"
                      Header="Status"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="1"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.interBankTransStatus.backcolor}"/>
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.interBankTransStatus.Status}"/>
                  </InlineUIContainer></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>


                    <dxg:GridColumn x:Name="colCreationDate"
                      FieldName="CreationDate"
                      Header="Creation Date"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="2">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colTransactionDate"
                      FieldName="TransactionDate"
                      Header="Transaction Date"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="3" 
                      SortOrder="Ascending" 
                      SortIndex="0"/>

                    <dxg:GridColumn x:Name="colTransferType"
                      FieldName="transferType"
                      Header="Transfer Type"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="4"/>

                    <dxg:GridColumn x:Name="colSystemRefNo"
                      FieldName="SystemRefNo"
                      Header="System Ref #"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="5"/>

                    <dxg:GridColumn x:Name="colFinanceRefNo"
                      FieldName="FinanceRefNo"
                      Header="Finance Ref No"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="6"/>

                    <dxg:GridColumn x:Name="colInstrumentNo"
                      FieldName="InstrumentNo"
                      Header="Instrument No"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="7"/>

                    <dxg:GridColumn x:Name="colCompany"
                      FieldName="company.CompanyName"
                      Header="Company"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="8"/>

                    <dxg:GridColumn x:Name="colDepartment"
                      FieldName="department.DeptName"
                      Header="Department"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="9"/>

                    <dxg:GridColumn x:Name="colEmployeeId"
                      FieldName="employee.EmpId"
                      Header="Employee Id"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="10"/>

                    <dxg:GridColumn x:Name="colTransferMethod"
                      FieldName="tranferMethod.MethodName"
                      Header="Transfer Method"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="11"/>

                    <dxg:GridColumn x:Name="colBankFrom"
                      FieldName="BankFrom.BankName"
                      Header="Bank From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="12"/>

                    <dxg:GridColumn x:Name="colAccountFrom"
                      FieldName="AccountFrom.AccountNo"
                      Header="Account From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="13"/>

                    <dxg:GridColumn x:Name="colBankTo"
                      FieldName="BankTo.BankName"
                      Header="Bank To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="14"/>

                    <dxg:GridColumn x:Name="colAccountTo"
                      FieldName="AccountTo.AccountNo"
                      Header="Account To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="15"/>

                    <dxg:GridColumn x:Name="colAmountOc"
                      FieldName="AmountOC"
                      Header="Amount (OC)"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="16"
                            >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colCurrency"
                      FieldName="currency.CurrencyName"
                      Header="Currency"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="17"/>

                    <dxg:GridColumn x:Name="colMER"
                      FieldName="MER"
                      Header="MER"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="18">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colAmountMER"
                      FieldName="AmountMER"
                      Header="Amount MER"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="19">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="company" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="department" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="employee" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="currency" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="BankFrom" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="AccountFrom" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="BankTo" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="AccountTo" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="tranferMethod" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                    <dxg:GridColumn FieldName="company_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>


                </dxg:GridControl>
            </Grid>
        </GroupBox>
        <Image
        x:Name="loadingGif"    
       
            
        Visibility="Hidden"
        Grid.Row="2"
            
         gif:AnimationBehavior.SourceUri="/ZAS_ERP;component/images/loadingReports.gif"   
        VerticalAlignment="Center"
        HorizontalAlignment="Center" RenderTransformOrigin="12.987,0.793" Margin="5,100,5,5" Width="60" />

        <dx:WaitIndicator x:Name="Loader"  DeferedVisibility="{Binding IsWaitIndicatorVisible}"  Content="{Binding WaitIndicatorText}">
            <dx:WaitIndicator.ContentTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" BorderBrush="PowderBlue" Padding="2" CornerRadius="6">
                        <StackPanel Orientation="Vertical"  >
                            <TextBlock Text="Please Wait"  FontSize="20"/>
                            <TextBlock Text="{Binding}" />
                        </StackPanel>
                    </Border>

                </DataTemplate>
            </dx:WaitIndicator.ContentTemplate>
        </dx:WaitIndicator>

    </Grid>
</dx:DXWindow>
