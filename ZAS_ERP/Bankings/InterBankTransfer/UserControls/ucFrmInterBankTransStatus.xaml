<UserControl x:Class="ZAS_ERP.Bankings.UserControls.ucFrmInterBankTransStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Bankings.UserControls"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400">
    <Grid>
        <dxlc:LayoutGroup Header="Inter Bank Transfer Status Details"
                         View="GroupBox"
                          Margin="0 0 0 45">
            <dxlc:LayoutControl Orientation="Vertical">
                <dxlc:LayoutItem Label="Status: ">
                    <dxe:TextEdit x:Name="txtStatus" Margin="0 0 0 0"/>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Active:">
                    <dxe:CheckEdit x:Name="chkisActive" Margin="0 10 0 0"/>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Status Color:">
                    <dxe:PopupColorEdit Margin="0 10 0 0"
                                  HorizontalAlignment="Stretch"
                                  ColorChanged="CpStatus_ColorChanged"
                                  Grid.Column="1"
                                  Grid.Row="2"
                                  VerticalAlignment="Center"
                                  x:Name="cpStatus" />
                </dxlc:LayoutItem>
            </dxlc:LayoutControl>






