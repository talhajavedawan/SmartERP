<UserControl x:Class="ZAS_ERP.Bankings.UserControls.ucFrmAddTransferMethod"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Bankings.UserControls"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <dxlc:LayoutGroup Header="Sales Receipt Details" 
                                  Margin="0 0 0 45"
                                          View="GroupBox" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical">
            <dxlc:LayoutControl Orientation="Vertical" VerticalAlignment="Center">
                <dxlc:LayoutItem Label="Method Name:" Width="270">
                    <dxe:TextEdit Margin="5 0 0 0" x:Name="txtTransferMethod"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Height="10"/>
                <dxlc:LayoutItem Label="Is Active:" Width="270">
                    <dxe:CheckEdit Margin="37 0 0 0" x:Name="chkEdtIsActive" Checked="ChkEdtIsActive_Checked" Unchecked="ChkEdtIsActive_Unchecked"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutControl>
        </dxlc:LayoutGroup>
        <Button Content="Save" x:Name="btnSave" Height="40" VerticalAlignment="Bottom" Click="BtnSave_Click"/>
    </Grid>
</UserControl>
