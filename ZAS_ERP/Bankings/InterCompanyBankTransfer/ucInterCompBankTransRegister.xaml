                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="17"/>

                <dxg:GridColumn x:Name="colAmountOc"
                      FieldName="AmountOC"
                      Header="Amount (OC)"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="18"
                            >
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn x:Name="colCurrency"
                      FieldName="currency.CurrencyName"
                      Header="Currency"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="19"/>

                <dxg:GridColumn x:Name="colMER"
                      FieldName="MER"
                      Header="MER"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="20">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn x:Name="colAmountMER"
                      FieldName="AmountMER"
                      Header="Amount MER"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="21">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>


                <dxg:GridColumn x:Name="colCOAdebit"
                      FieldName="COAdebit.accountName"
                      Header="COA Debit"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="22"/>

                <dxg:GridColumn x:Name="colCOAcredit"
                      FieldName="COAcredit.accountName"
                      Header="COA Credit"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="23"/>



                <dxg:GridColumn x:Name="colCurrencyFrom"
                      FieldName="currencyFrom.CurrencyName"
                      Header="Currency From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="24"/>

                <dxg:GridColumn x:Name="colCurrencyTo"
                      FieldName="currencyTo.CurrencyName"
                      Header="Currency To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="25"/>

                <dxg:GridColumn x:Name="colMERfrom"
                      FieldName="MERfrom"
                      Header="MER From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="26"/>

                <dxg:GridColumn x:Name="colAmountMERfrom"
                      FieldName="AmountMERfrom"
                      Header="Amount MER From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="27"/>

                <dxg:GridColumn x:Name="colMERto"
                      FieldName="MERto"
                      Header="MER To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="28"/>

                <dxg:GridColumn x:Name="colAmountMERto"
                      FieldName="AmountMERto"
                      Header="Amount MER To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="29"/>

                <dxg:GridColumn x:Name="colAmountTo"
                      FieldName="AmountTo"
                      Header="Amount To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="30"/>

                <dxg:GridColumn x:Name="colAmountFrom"
                      FieldName="AmountFrom"
                      Header="Amount From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="31"/>

                <dxg:GridColumn x:Name="colIBTRefFrom"
                      FieldName="PettyCashRefFrom.BillReferenceNo"
                      Header="Petty Cash Ref From"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="32"/>

                <dxg:GridColumn x:Name="colIBTRefTo"
                      FieldName="PettyCashRefTo.BillReferenceNo"
                      Header="Petty Cash Ref To"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="33"/>



                <dxg:GridColumn FieldName="Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="companyFrom_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="companyFrom" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="deptFrom_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="departmentFrom" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

                <dxg:GridColumn FieldName="companyTo_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="companyTo" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="deptTo_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="departmentTo" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="emp_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="employee" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="currency_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="currency" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="bankFrom_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="BankFrom" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="accountFrom_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="AccountFrom" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="bankTo_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="BankTo" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="accountTo_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="AccountTo" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                <dxg:GridColumn FieldName="tranferMethod_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
