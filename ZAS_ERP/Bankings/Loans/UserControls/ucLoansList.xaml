<UserControl x:Class="ZAS_ERP.Bankings.Loans.UserControls.ucLoansList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Bankings.Loans.UserControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu DockPanel.Dock="Top"
              x:Name="menuGrid" Grid.Row="0">
            <MenuItem Header="_Print Preview"
                      x:Name="mbtnPrintPreview"
                      Click="MbtnPrintPreview_Click"/>
            <MenuItem Header="Export To Report"
                      x:Name="mbtnExportToReport"
                      Click="MbtnExportToReport_Click"
                      />
            <MenuItem Header="Refresh"
                      x:Name="mbtnRefresh"
                      Click="MbtnRefresh_Click"/>

            <MenuItem Header="Save Layout"
                      x:Name="mbtnSaveLayout"
                      Click="MbtnSaveLayout_Click"/>

            <MenuItem Header="Direct Close"
                      x:Name="mbtnDriectClose"
                      Click="MbtnDriectClose_Click"/>
            <MenuItem Header="Approve"
                          x:Name="mbtnApprove" Click="MbtnApprove_Click"/>
            <MenuItem x:Name="mbtnPending" Click="MbtnPending_Click">
                <MenuItem.Template>
                    <dxg:DefaultControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Approvals">
                                <TextBlock.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Background" Value="Transparent"/>

                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#c0ddeb"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Resources>
                            </TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0" FontWeight="Bold" x:Name="txtApprovalcount" Text="{Binding ApprovalCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </dxg:DefaultControlTemplate>
                </MenuItem.Template>
            </MenuItem>

            <MenuItem x:Name="mbtnReApprovals" Click="MbtnReApprovals_Click">
                <MenuItem.Template>
                    <dxg:DefaultControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ReApprovals" ToolTip="List of Sale Receipts which needs ReApproval due to Cost sheet">
                                <TextBlock.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Background" Value="Transparent"/>

                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#c0ddeb"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Resources>
                            </TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0" FontWeight="Bold" x:Name="txtReApprovalcount" Text="{Binding ReApprovalCount}" Foreground="Red"/>
                        </StackPanel>
                    </dxg:DefaultControlTemplate>
                </MenuItem.Template>
            </MenuItem>

            <MenuItem x:Name="mbtnPendingClosing" Click="MbtnPendingClosing_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending for Closing">
                                <TextBlock.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Background" Value="Transparent"/>

                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#c0ddeb"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Resources>
                            </TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtClosingcount" Text="{Binding ClosingCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>

            <MenuItem 
                          x:Name="mbtnApprovedUnapproved"
                          Click="MbtnApprovedUnapproved_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Loans Register">
                                <TextBlock.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Background" Value="Transparent"/>

                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#c0ddeb"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Resources>
                            </TextBlock>

                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->

                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtApproveUnapproved" Text="{Binding ApproveunapprovedCount}" Foreground="Blue"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>


            <MenuItem x:Name="mbtnVoid" Click="MbtnVoid_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Void">
                                <TextBlock.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Background" Value="Transparent"/>

                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#c0ddeb"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Resources>
                            </TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtVoidcount" Text="{Binding VoidCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
        </Menu>
        <TextBlock x:Name="lblHeading" Text="Loans" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  ></TextBlock>


        <dxg:GridControl x:Name="grdCntrlLoans" Grid.Row="2"
                         MouseDoubleClick="GrdCntrlLoans_MouseDoubleClick">
            <dxg:GridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add New"
                                Click="MbtnAdd_Click" x:Name="mbtnAdd">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Update"
                                    x:Name="mbtnUpdate" Click="MbtnUpdate_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </dxg:GridControl.ContextMenu>

            <dxg:GridControl.View>
                <dxg:TableView
                    
                        AllowEditing="False"
                        AllowPerPixelScrolling="True"
                        Name="tblViewLoans"
                        RowAnimationKind="None"
                        ShowAutoFilterRow="True"
                        ShowTotalSummary="True"
                        WaitIndicatorType="Panel">

                </dxg:TableView>
            </dxg:GridControl.View>

            <dxg:GridColumn x:Name="colstatus"
                      FieldName="Status.Status"
                      Header="Status"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="0"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                <dxg:GridColumn.CellTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.Status.backcolor}"/>
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.Status.Status}"/>
                  </InlineUIContainer></TextBlock>
                        </Grid>
                    </DataTemplate>
                </dxg:GridColumn.CellTemplate>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="CreationDate"
                            Visible="True"
                            VisibleIndex="1">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="DateTime"   MaskUseAsDisplayFormat="True" Mask="dd/MMMM/yyyy"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="company.CompanyName"
                            Header="Company"
                            Visible="True"
                            VisibleIndex="2"/>

            <dxg:GridColumn FieldName="department.DeptName"
                            Header="Department"
                            Visible="True"
                            VisibleIndex="3"/>

            <dxg:GridColumn FieldName="bank.BankName"
                            Header="Bank"
                            Visible="True"
                            VisibleIndex="4"/>

            <dxg:GridColumn FieldName="account.AccountNo"
                            Header="Account"
                            Visible="True"
                            VisibleIndex="5"/>

            <dxg:GridColumn FieldName="currency.CurrencyName"
                            Header="Currency"
                            Visible="True"
                            VisibleIndex="6"/>

            <dxg:GridColumn FieldName="MainLimitFacilityNature.NatureName"
                            Header="Main Limit Nature"
                            Visible="True"
                            VisibleIndex="7"/>

            <dxg:GridColumn FieldName="SubLimitFacilityNature.NatureName"
                            Header="Sub Limit Nature"
                            Visible="True"
                            VisibleIndex="8"/>

            <dxg:GridColumn FieldName="MainLimitAmount"
                            Header="Main Limit Amount"
                            Visible="True"
                            VisibleIndex="9">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" HorizontalContentAlignment="Left" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="SubLimitAmount"
                            Header="Sub Limit Amount"
                            Visible="True"
                            VisibleIndex="10">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" HorizontalContentAlignment="Left" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="SystemRefNo"
                            Header="System Ref No"
                            Visible="True"
                            VisibleIndex="11"/>

            <dxg:GridColumn FieldName="FinanceRefNo"
                            Header="Finance Ref No"
                            Visible="True"
                            VisibleIndex="12"/>

            <dxg:GridColumn FieldName="Creator.person.FName"
                            Header="Creator"
                            Visible="True"
                            VisibleIndex="13"/>

            <dxg:GridColumn FieldName="LimitDate"
                            Visible="True"
                            VisibleIndex="14">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="DateTime"   MaskUseAsDisplayFormat="True" Mask="dd/MMMM/yyyy"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="ExpiryDate"
                            Visible="True"
                            VisibleIndex="15">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="DateTime"   MaskUseAsDisplayFormat="True" Mask="dd/MMMM/yyyy"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="ExtensionDate"
                            Visible="True"
                            VisibleIndex="16">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="DateTime"   MaskUseAsDisplayFormat="True" Mask="dd/MMMM/yyyy"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="company" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="CompanyId" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="department" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="deptId" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="bank" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="bankId" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="account" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="accountId" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="currency" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="currencyId" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="facilityNature" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="facilityNatureId" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="Status" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="statusId" Visible="False" ShowInColumnChooser="False"/>

        </dxg:GridControl>
    </Grid>
</UserControl>
