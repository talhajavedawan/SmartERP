<UserControl x:Class="ZAS_ERP.Bankings.Loans.ucFrmFacilityNature"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Bankings.Loans"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" Loaded="UserControl_Loaded" Padding="10"
             d:DesignHeight="350" d:DesignWidth="400">
    <Grid>
        <!--comment-->
        <dxlc:LayoutGroup View="GroupBox" Header="Facility Nature">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <dxlc:LayoutItem Label="Nature: " VerticalAlignment="Center">
                    <dxe:TextEdit x:Name="txtFacilityNature"/>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Is Active: " VerticalAlignment="Top" Margin="0 10 0 0" Grid.Row="1">
                    <dxe:CheckEdit x:Name="chkIsActive"/>
                </dxlc:LayoutItem>

                <Button Content="Save" x:Name="btnSave" Click="BtnSave_Click" Grid.Row="2"/>
            </Grid>
        </dxlc:LayoutGroup> 
    </Grid>
</UserControl>
