<UserControl x:Class="ZAS_ERP.Bankings.Loans.ucLoansRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Bankings.Loans"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="40" d:DesignWidth="400">
    <Grid>
        <!--comment-->
        <Grid Height="25" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Visibility="Collapsed" x:Name="txtId" Text="0"/>
            <dxg:LookUpEdit x:Name="lookupMainLimitNature" DisplayMember="NatureName" Margin="0 0 5 0" Grid.Column="0">
                <dxg:LookUpEdit.PopupContentTemplate>
                    <ControlTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>

                            <dxg:GridControl Name="PART_GridControl"
                                                        AutoPopulateColumns="True"
                                                        Grid.Row="1">
                                <dxg:GridControl.View>
                                    <dxg:TableView Name="tbleView1"
                                                                ShowAutoFilterRow="True"/>
                                </dxg:GridControl.View>

                                <dxg:GridColumn
                                                        FieldName="Id"
                                                        Visible="False"/>

                                <dxg:GridColumn
                                                        FieldName="isActive"
                                                        Visible="False"/>

                                <dxg:GridColumn
                                                        FieldName="NatureName"
                                                        Header="Facility Nature"/>
                            </dxg:GridControl>
                        </Grid>
                    </ControlTemplate>
                </dxg:LookUpEdit.PopupContentTemplate>
            </dxg:LookUpEdit>

            <dxg:LookUpEdit x:Name="lookupSubLimitNature" DisplayMember="NatureName" Margin="0 0 5 0" Grid.Column="1">
                <dxg:LookUpEdit.PopupContentTemplate>
                    <ControlTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>

                            <dxg:GridControl Name="PART_GridControl"
                                                        AutoPopulateColumns="True"
                                                        Grid.Row="1">
                                <dxg:GridControl.View>
                                    <dxg:TableView Name="tbleView1"
                                                                ShowAutoFilterRow="True"/>
                                </dxg:GridControl.View>

                                <dxg:GridColumn
                                                        FieldName="Id"
                                                        Visible="False"/>

                                <dxg:GridColumn
                                                        FieldName="isActive"
                                                        Visible="False"/>

                                <dxg:GridColumn
                                                        FieldName="NatureName"
                                                        Header="Facility Nature"/>
                            </dxg:GridControl>
                        </Grid>
                    </ControlTemplate>
                </dxg:LookUpEdit.PopupContentTemplate>
            </dxg:LookUpEdit>

            <dxe:TextEdit x:Name="txtMainLimitAmount" 
                          Margin="5 0 0 0" 
                          Grid.Column="2" 
                          Text="0"
                          MaskType="Numeric" 
                          Mask="n2" 
                          MaskUseAsDisplayFormat="True"/>

            <dxe:TextEdit x:Name="txtSubLimitAmount" 
                          Margin="5 0 0 0" 
                          Grid.Column="3" 
                          Text="0"
                          MaskType="Numeric" 
                          Mask="n2" 
                          MaskUseAsDisplayFormat="True"/>
        </Grid>
    </Grid>
</UserControl>
