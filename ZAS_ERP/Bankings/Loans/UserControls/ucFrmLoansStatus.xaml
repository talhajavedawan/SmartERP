<UserControl x:Class="ZAS_ERP.Bankings.Loans.UserControls.ucFrmLoansStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Bankings.Loans.UserControls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
              d:DesignHeight="150" d:DesignWidth="300"
             Loaded="UserControl_Loaded">
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=" auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height=" auto" />
            <RowDefinition Height=" auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height=" 40" />
        </Grid.RowDefinitions>
        <Label Content="Status"
           ToolTip="Status Name"
           HorizontalAlignment="Right" />
        <Label Content="Status Color"
           ToolTip="Select Color of status"
           HorizontalAlignment="Right"
           Grid.Row="1" />
        <Label Content="isActive"
           ToolTip="Select Color of status"
           HorizontalAlignment="Right"
           Grid.Row="2" />
        <Label Content="Disable"
           HorizontalAlignment="Right"
           Grid.Row="3" />
        <TextBox x:Name="txtStatus"
             Grid.Column="1" />
        <Grid Grid.Column="1"
          Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <dxe:PopupColorEdit Margin="10"
                          HorizontalAlignment="Stretch"
                          ColorChanged="ColorEdit_ColorChanged"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          x:Name="cpStatus" />
        </Grid>
        <CheckBox x:Name="chkisactive"
                HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                IsChecked="True" Visibility="Visible" Grid.Row="2" Grid.Column="1"/>
        <CheckBox x:Name="chkDisable"
                HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                Visibility="Visible" Grid.Row="3" Grid.Column="1"/>
        <Button Grid.ColumnSpan="2"
            Grid.Row="4"
            Content="Save"
            x:Name="btnStatusSave"
            Click="btnStatusSave_Click" />

    </Grid>
</UserControl>
