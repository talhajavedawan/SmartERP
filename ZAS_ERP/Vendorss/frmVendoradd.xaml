                          Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                   Visibility="Collapsed"
                          Grid.Row="7"
                          TabIndex="9"
                          AutoPopulateColumns="True"
                          DisplayMember="company.CompanyName"
                          VerticalAlignment="Center"
                                    SelectedIndexChanged="lookupVendor_SelectedIndexChanged">
                                        <dxg:LookUpEdit.PopupContentTemplate>
                                            <ControlTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"></RowDefinition>
                                                        <RowDefinition Height="*"></RowDefinition>
                                                    </Grid.RowDefinitions>
                                                    <dxg:GridControl Name="PART_GridControl"
                                   AutoPopulateColumns="True"
                                   Grid.Row="1">
                                                        <dxg:GridColumn x:Name="colId"
                                    FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                                        <dxg:GridColumn FieldName="company.CompanyName"
                                    IsSmart="True"
                                    Width="auto" />
                                                        <dxg:GridColumn FieldName="company.IndustryType"
                                    IsSmart="True"
                                    Visible="False" />
                                                        <dxg:GridColumn x:Name="colBizType"
                                    FieldName="company.BizType"
                                    Visible="False"
                                    IsSmart="True" />
                                                        <dxg:GridColumn FieldName="contactPerson.FName"
                                    x:Name="colFname"
                                    IsSmart="True"
                                    Visible="True"
                                    Header="First Name"
                                    Width="auto" />
                                                        <dxg:GridColumn FieldName="contactPerson.LName"
                                    x:Name="colLname"
                                    IsSmart="True"
                                    Visible="True"
                                    Header="Last Name"
                                    Width="auto" />
                                                        <dxg:GridColumn FieldName="contact.ContactNo"
                                    IsSmart="True"
                                    x:Name="colcontactno"
                                    Visible="True"
                                    Header="Phone"
                                    Width="auto" />
                                                        <dxg:GridColumn FieldName="company.currency.CurrencyName"
                                    x:Name="colCurrency"
                                    IsSmart="True"
                                    Visible="False"
                                    Header="Currency" />
                                                        <dxg:GridColumn FieldName="contact.Fax"
                                    Visible="False"
                                    x:Name="colFax"
                                    IsSmart="True"
                                    Header="Fax" />
                                                        <dxg:GridColumn FieldName="contact.Email"
                                    x:Name="colEmail"
                                    IsSmart="True"
                                    Visible="False"
                                    Header="Email" />
                                                    </dxg:GridControl>
                                                </Grid>
                                            </ControlTemplate>
                                        </dxg:LookUpEdit.PopupContentTemplate>
                                    </dxg:LookUpEdit>
                                    <CheckBox x:Name="chkisActive"
                      VerticalAlignment="Center"
                      Grid.Column="5" Content="IsActive"
                      Grid.Row="3"
                      IsChecked="True"
                      TabIndex="12" Foreground="Gray"/>
                                    <CheckBox x:Name="chkisBlackList"
                      VerticalAlignment="Center"
                      Grid.Column="5" Content="Red List"
                      Grid.Row="4"
                      TabIndex="12" Foreground="Maroon"/>
                                    <Grid Grid.Row="5" Grid.Column="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ranking" Foreground="Black"/>
                                        <dxedit:RatingEdit Name="ratingControl"
                   Value="3"
                 
                   Grid.Column="1"
                   MinWidth="200"
                   Height="40" >
                                           
                                        </dxedit:RatingEdit>
                                    </Grid>
                                 
                                </Grid>
                            </dxlc:GroupBox>
                            <dxlc:GroupBox Header="Contact Person"
                             Grid.Row="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" />
                                        <!--<RowDefinition Height="1*" />-->
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="First Name" />
                                    <TextBox Grid.Column="1"
                           x:Name="txtfirstName"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           TabIndex="5">
                                        <TextBox.Text>
                                            <Binding Path="onlychar"
                               UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <vali:onlyalphareq required="True" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBox x:Name="txtlastName"
                           VerticalAlignment="Center"
                           Grid.Column="3"
                           TabIndex="6">
                                        <TextBox.Text>
                                            <Binding Path="onlychar"
                               UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <vali:onlyalphareq />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBlock VerticalAlignment="Center"
                             Text="Last Name"
                             Grid.Column="2" />
                                </Grid>
                            </dxlc:GroupBox>
                        </Grid>
                    </dx:DXTabItem>

