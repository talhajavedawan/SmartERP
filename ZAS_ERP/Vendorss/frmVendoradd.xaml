                    <dx:DXTabItem Header="Vendor Info">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"></RowDefinition>
                                <RowDefinition Height=".6*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <dxlc:GroupBox Header="Vendor Company">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" />
                                        <RowDefinition Height="1*" />
                                        <RowDefinition Height="1*" />
                                        <RowDefinition Height="1*" />
                                        <RowDefinition Height="1*" />
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Vendor Name" />
                                    <TextBox x:Name="txtBussinesName"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TabIndex="0">
                                        <!--<TextBox.Text>
                      <Binding Path="onlychar"
                              ValidatesOnDataErrors="True"
                              
                               UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                          <vali:minlength MinimumCharacters="5" />
                        </Binding.ValidationRules>
                      </Binding>
                    </TextBox.Text>-->
                                    </TextBox>
                                    <TextBlock Grid.Row="1"
                             x:Name="lbltIndustry">
                Industry Type :</TextBlock>
                                    <ComboBox Grid.Column="1"
                            VerticalAlignment="Center"
                            x:Name="cmbIndustry"
                            Grid.Row="1"
                            TabIndex="2"
                            SelectionChanged="cmbIndustry_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel  Orientation="Horizontal">
                                                    <TextBlock Text="{Binding id}"
                                     Visibility="Hidden" />
                                                    <TextBlock Text="{Binding name}"></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2"
                             x:Name="lblVendorNature">
                Vendor Nature :</TextBlock>
                                    <ComboBox Grid.Column="1"
                            VerticalAlignment="Center"
                            x:Name="cmbVendorNature"
                            Grid.Row="2"
                            TabIndex="2"
                            SelectionChanged="cmbVendorNature_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel  Orientation="Horizontal">
                                                    <TextBlock Text="{Binding id}"
                                     Visibility="Hidden" />
                                                    <TextBlock Text="{Binding name}"></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                             x:Name="lbltBussinesType"
                             Grid.Row="1">
                Bussines Type :</TextBlock>
                                    <ComboBox Grid.Column="3"
                            VerticalAlignment="Center"
                            Grid.Row="1"
                            x:Name="cmbBussinesType"
                            TabIndex="3" />
                                    <TextBlock Grid.Column="2"
                             x:Name="lbltEIN">
                NTN # :</TextBlock>
                                    <TextBox Grid.Column="3"
                           VerticalAlignment="Center"
                           x:Name="txtEIN"
                           TabIndex="1">
                                        <TextBox.Text>
                                            <Binding Path="onlynum"
                               UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <vali:digitvalidation />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBlock Grid.Column="0"
                             x:Name="lblCurrency"
                             Grid.Row="3">
                Currency :</TextBlock>
                                    <ComboBox x:Name="cmbCurrency"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Grid.Row="3" TabIndex="4"
                            SelectionChanged="cmbCurrency_SelectedIndexChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel  Orientation="Horizontal">
                                                    <TextBlock Text="{Binding id}"
                                     Visibility="Hidden" />
                                                    <TextBlock Text="{Binding name}"></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Is Subsidory?" Grid.Column="2" Grid.Row="2"></TextBlock>
                                    <Grid
                              Grid.Column="3"
                              Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto">

                                            </ColumnDefinition>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="chkissubsidroy"
                          
                            VerticalAlignment="Center"
                            Checked="chkissubsidroy_Checked"
                            Unchecked="chkissubsidroy_Unchecked"
                            TabIndex="5"></CheckBox>

                                        <TextBlock TextWrapping="Wrap" 
                    Text="Check the box if this is a Subsidory Vendor"
                             Grid.Column="1"
                                 ></TextBlock>

                                    </Grid>
                                    <TextBlock Text="Vendor Name"
                             x:Name="lblcustomername"
                             Grid.Column="0"
                             Grid.Row="4" Visibility="Hidden"/>
