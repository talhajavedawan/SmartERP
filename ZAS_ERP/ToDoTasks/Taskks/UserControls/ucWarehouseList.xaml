<UserControl x:Class="ZAS_ERP.ToDoTasks.Taskks.UserControls.ucWarehouseList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ToDoTasks.Taskks.UserControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <!--comment-->
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu>
            <MenuItem Header="Add">
                <MenuItem Header="Add New" Click="MbtnAddWarehouse_Click"/>
                <MenuItem Header="Update Warehouse" Click="MbtnEditWarehouse_Click"/>
            </MenuItem>
            <MenuItem Header="Refresh" x:Name="mbtnRefresh" Click="MbtnRefresh_Click"/>
        </Menu>

        <TextBlock x:Name="lblHeading" Text="Warehouse List" FontSize="22" 
                   FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  />


        <Grid Background="White" Grid.Row="2" Height="auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="293*"/>
                <ColumnDefinition Width="37*"/>
                <ColumnDefinition Width="470*"/>
            </Grid.ColumnDefinitions>
            <dxg:GridControl AutoGenerateColumns="AddNew" 
                         EnableSmartColumnsGeneration="True" 
                         Name="grdCntrlWarehouseList" Grid.ColumnSpan="3">
                <dxg:GridControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add New Warehouse"
                            x:Name="mbtnAddWarehouse"
                            Click="MbtnAddWarehouse_Click">
                            <MenuItem.Icon>
                                <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Edit Warehouse"
                            x:Name="mbtnEditWarehouse"
                            Click="MbtnEditWarehouse_Click">
                            <MenuItem.Icon>
                                <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </dxg:GridControl.ContextMenu>

                <dxg:GridControl.View>
                    <dxg:TableView ShowGroupPanel="True"
                           AllowColumnFiltering="True"
                           ShowHorizontalLines="True"
                           ShowVerticalLines="True"
                           ColumnFilterPopupMode="Excel"
                           NavigationStyle="Row"
                           ShowAutoFilterRow="True"       
                           Width="auto"   
                           RowAnimationKind="None" WaitIndicatorType="Panel"/>
                </dxg:GridControl.View>
                <dxg:GridColumn FieldName="Id" Visible="False" ShowInColumnChooser="False" AllowEditing="false"/>
                <dxg:GridColumn FieldName="WarehouseName" Header="Warehouse" AllowEditing="false"/>
                <dxg:GridColumn FieldName="isActive" Header="Is Active" AllowEditing="false"/>
            </dxg:GridControl>
        </Grid>
    </Grid>
</UserControl>
