<UserControl x:Class="ZAS_ERP.ToDoTasks.Taskks.UserControls.ucFrmTaskTracking"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ToDoTasks.Taskks.UserControls"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="500">
    <Grid>
        <dxlc:LayoutGroup View="GroupBox" Orientation="Vertical">
            <dxlc:LayoutGroup.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 0 0 5">
                    <Image Source="{dx:DXImage Image=ModelEditor_DetailView.png}" Width="20" Height="20"  Margin="0,0,10,0"/>
                    <TextBlock Text="Add Details" FontSize="15" FontWeight="Bold" Grid.Row="0" VerticalAlignment="Center"/>
                </StackPanel>
            </dxlc:LayoutGroup.Header>
            <TextBox x:Name="txtDetails" CommandManager.PreviewExecuted="TxtDetails_PreviewExecuted" TextWrapping="Wrap" TextChanged="TxtDetails_TextChanged" MaxLength="200" FontSize="16" FontWeight="DemiBold" AcceptsReturn="True" AcceptsTab="True" SpellCheck.IsEnabled="True"/>
            <dx:SimpleButton Height="30" FontSize="16" FontWeight="Bold" x:Name="btnSave" Click="BtnSave_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{dx:DXImage Image=Action_Validation_Validate_32x32.png}" Width="25" Height="25"  Margin="0,0,5,0" VerticalAlignment="Bottom"/>
                    <TextBlock Text="Save"/>
                </StackPanel>
            </dx:SimpleButton>
        </dxlc:LayoutGroup>
        <TextBlock x:Name="txtCounter" HorizontalAlignment="Right" Foreground="Green" FontWeight="Bold" VerticalAlignment="Bottom" Text="0/200" Panel.ZIndex="5" Margin="0 0 20 50"/>
    </Grid>
</UserControl>
