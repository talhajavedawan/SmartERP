<UserControl x:Class="ZAS_ERP.ToDoTasks.Taskks.ucFrmLotNumberAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ToDoTasks.Taskks"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400" Loaded="UserControl_Loaded">
    <Grid>
        <dxlc:LayoutGroup Padding="10" View="GroupBox" Header="LOT Number">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <dxlc:LayoutItem VerticalAlignment="Center" Grid.Row="0" Label="LOT #           ">
                    <dxe:TextEdit x:Name="txtLOTno"/>
                </dxlc:LayoutItem>
                
                <dxlc:LayoutItem VerticalAlignment="Center" Grid.Row="1" Label="Company     ">
                    <dxg:LookUpEdit x:Name="cmbxCompany"
                                    DisplayMember="CompanyName"
                                    SelectedIndexChanged="CmbxCompany_SelectedIndexChanged"/>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem VerticalAlignment="Center" Grid.Row="2" Label="Department  ">
                    <dxg:LookUpEdit x:Name="cmbxDepartment"
                                    DisplayMember="DeptName"/>
                </dxlc:LayoutItem>

                <dxe:CheckEdit Grid.Row="3" Content="Is Active" VerticalAlignment="Center" 
                               x:Name="chkIsActive" Margin="60 0 0 0"/>

                <Button Grid.Row="4" Content="Save" x:Name="btnSave" Click="BtnSave_Click"/>
            </Grid>
        </dxlc:LayoutGroup>
    </Grid>
</UserControl>
