<UserControl x:Class="ZAS_ERP.ToDoTasks.Taskks.UserControls.ucTaskTypeList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ToDoTasks.Taskks.UserControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu>
            <MenuItem Header="Add Task Type">
                <MenuItem Header="Add Task Type" Click="MbtnAddTaskType_Click">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Update Task Type" Click="MbtnEditTaskType_Click">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Refresh" x:Name="mbtnRefresh" Click="MbtnRefresh_Click"/>
        </Menu>

        <TextBlock x:Name="lblHeading" Text="Task Type List" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  />

        <Grid Background="White" Grid.Row="2" Height="auto">
            <dxg:GridControl AutoGenerateColumns="None" 
                         EnableSmartColumnsGeneration="True" 
                         Name="grdCntrlTaskTypeList"
                             CustomUnboundColumnData="GrdCntrlTaskTypeList_CustomUnboundColumnData">
                <dxg:GridControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add New"
                            x:Name="mbtnAddTaskType"
                            Click="MbtnAddTaskType_Click">
                            <MenuItem.Icon>
                                <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Edit"
                            x:Name="mbtnEditApplicant"
                            Click="MbtnEditTaskType_Click">
                            <MenuItem.Icon>
                                <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </dxg:GridControl.ContextMenu>

                <dxg:GridControl.View>
                    <dxg:TableView
                        AllowEditing="False"
                        AllowPerPixelScrolling="True"
                        Name="tblViewTaskType"
                        RowAnimationKind="None"
                        ShowAutoFilterRow="True"
                        ShowTotalSummary="True"
                        WaitIndicatorType="Panel">

                    </dxg:TableView>
                </dxg:GridControl.View>

                <dxg:GridColumn FieldName="TypeName"
                                AllowEditing="false"
                                VisibleIndex="1"/>

                <dxg:GridColumn FieldName="Companies"
                                Header="Companies"
                                AllowEditing="false"
                                VisibleIndex="3"
                                UnboundType="String"/>

                <dxg:GridColumn FieldName="Departments"
                                Header="Departments"
                                AllowEditing="false"
                                VisibleIndex="4"
                                UnboundType="String"/>

                <dxg:GridColumn FieldName="isSaleOrder"
                                Header="Sale Order Type"
                                AllowEditing="false"
                                VisibleIndex="5"/>
                <dxg:GridColumn FieldName="isPurchaseOrder"
                                Header="Purchase Order Type"
                                AllowEditing="false"
                                VisibleIndex="6"/>
                <dxg:GridColumn FieldName="isSaleInvoice"
                                Header="Sale Invoice Type"
                                AllowEditing="false"
                                VisibleIndex="7"/>
                <dxg:GridColumn FieldName="isOffer"
                                Header="Offer Type"
                                AllowEditing="false"
                                VisibleIndex="8"/>
                <dxg:GridColumn FieldName="isInquiry"
                                Header="Inquiry Type"
                                AllowEditing="false"
                                VisibleIndex="9"/>

            </dxg:GridControl>
        </Grid>
    </Grid>
</UserControl>
