                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Achieved Points" Grid.Column="2" Grid.Row="1" Margin="0 10 0 0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <dxe:TextEdit x:Name="txtAchievedPoints" 
                                  Grid.Row="1" 
                                  Grid.Column="3" 
                                  Height="22" 
                                  Margin="5 10 10 0" 
                                  IsReadOnly="True"
                                  Text="0"
                                  Mask="n2" 
                                  MaskType="Numeric" 
                                  MaskUseAsDisplayFormat="True"/>

                                <TextBlock Text="Achieved Field" Grid.Column="0" Grid.Row="1" Margin="0 10 0 0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <dxe:TextEdit x:Name="txtAchievedField" IsReadOnly="True" Margin="5 10 10 0"   Height="22"  Grid.Column="1" Grid.Row="1"/>
                            </Grid>

                           
                        </Grid>
                    </dxlc:LayoutGroup>
                    
                    <dxlc:LayoutGroup Grid.ColumnSpan="5" Grid.Row="4" View="GroupBox" Header="Payment Details" Margin="0 5 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Paid Amount " Grid.Column="0" Grid.Row="0" Margin="0 5 0 0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxe:TextEdit x:Name="txtPaidAmount" 
                                  Grid.Row="0" 
                                  Grid.Column="1" 
                                  Height="22" 
                                  Margin="0 5 10 0" 
                                  IsReadOnly="True"
                                  Text="0"
                                  Mask="n2" 
                                  MaskType="Numeric" 
                                  MaskUseAsDisplayFormat="True"/>

                            <TextBlock Text="Amount Due " Grid.Column="2" Grid.Row="0" Margin="0 5 0 0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxe:TextEdit x:Name="txtAmountDue" 
                                  Grid.Row="0" 
                                  Grid.Column="3" 
                                  Height="22" 
                                  Margin="0 5 10 0" 
                                  IsReadOnly="True"
                                  Text="0"
                                  Mask="n2" 
                                  MaskType="Numeric" 
                                  MaskUseAsDisplayFormat="True"/>
                        </Grid>
                    </dxlc:LayoutGroup>

                    <dx:SimpleButton Grid.Row="6" Grid.ColumnSpan="2" x:Name="btnSave" Content="Save" FontSize="14" FontWeight="Bold" Height="40" Margin="0 5 0 0" Panel.ZIndex="5" VerticalAlignment="Bottom"
                                     Click="BtnSave_Click"/>
                </Grid>
            </dx:DXTabItem>

        </dx:DXTabControl>

        <Grid Name="grdProgressBar" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Height="100" Width="300" Background="LightGray">
            <ProgressBar x:Name="pbarDownloading" Grid.ColumnSpan="2" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center"  Minimum="0" Maximum="100" Height="25" Width="280" Foreground="LightGreen"/>
            <Label Content="Downloading..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Blue"/>
            <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Margin="10,5" x:Name="txtInvoiced" Foreground="Blue" Text="Downloading" FontSize="16" FontWeight="DemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />
                <TextBlock Margin="10,5" x:Name="txtPbarValue" Foreground="Blue" FontWeight="DemiBold" FontSize="16"  Text="{Binding ElementName=pbarTarget , Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />
            </StackPanel>-->
        </Grid>
        <Grid Panel.ZIndex="6" x:Name="grdVoid" Visibility="Collapsed" 
              VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <!--<TextBox  Width="250"  VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="SearchTermTextBox" Margin="5"/>-->
            <TextBlock IsHitTestVisible="False" x:Name="txtVoid" 
                       Text="-VOID-" FontSize="200" 
                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" Foreground="Chocolate" Opacity="0.3">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTermTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.RenderTransform>

                    <RotateTransform CenterX="0" CenterY="0" Angle="-45" />

                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
