<UserControl x:Class="ZAS_ERP.ToDoTasks.TargetRewardss.ucFrmTargetRewardAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ToDoTasks.TargetRewardss"
              xmlns:loc="clr-namespace:ZAS_ERP"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1000" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <UserControl.CommandBindings>
        <CommandBinding Command="loc:CustomCommands.ReplytoComment" CanExecute="Command_CanExecute" Executed="Command_Executed" />
        <!--<CommandBinding Command="loc:CustomCommands.ResendComment" CanExecute="Resend_CanExecute" Executed="Resend_Executed" />-->
    </UserControl.CommandBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="b2v"/>
        <DataTemplate x:Key="borderTemplate">
            <Border x:Name="border"
                    Width="44" 
                        Background="White" 
                        BorderThickness="2" 
                        BorderBrush="#FF333333" 
                        CornerRadius="10"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Background" TargetName="border" Value="Green"/>
                    <Setter Property="BorderThickness" TargetName="border" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="false">
                    <Setter Property="Background" TargetName="border" Value="#6DFF0000"/>
                    <Setter Property="BorderThickness" TargetName="border" Value="0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="thumbTemplate">
            <Ellipse x:Name="thumb"
                         Fill="#FF333333" 
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         Width="10" Height="10" Margin="8,0"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Fill" TargetName="thumb" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="FocusedCellStyle" TargetType="dxg:LightweightCellEditor">
            <Style.Triggers>
                <Trigger Property="dxg:DataViewBase.IsFocusedCell" Value="True">
                    <Setter Property="Background" Value="LightGreen" />
                    <Setter Property="Foreground" Value="DarkGreen" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FocusedRowStyle" TargetType="dxg:RowControl">
            <Style.Triggers>
                <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True">
                    <Setter Property="Background" Value="LightGreen" />
                    <Setter Property="Foreground" Value="DarkGreen" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProgressBarStyle" TargetType="dxe:ProgressBarEditSettings">
            <Setter Property="ContentDisplayMode" Value="Value"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Black" HorizontalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemBaseStyle" TargetType="MenuItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Background" Value="Green" />
                    <Setter Property="Foreground" Value="Yellow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>


    <Grid>


        <StackPanel Grid.Row="0" Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Stretch"  dx:ThemeManager.ThemeName="None"
                 Grid.Column="0" Orientation="Horizontal" Margin="0 0 0 0" Height="50">
            <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">
                <Image Source="/ZAS_ERP;component/images/log.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1"  Click="BtnMarkReviewed_Click"  ToolTip="Approve - Mark as Reviewed">
                <Image  Source="/ZAS_ERP;component/images/approve.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnClose" Click="BtnClose_Click" Grid.Column="2" ToolTip="Reject">
                <Image  Source="/ZAS_ERP;component/images/block-icon.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" ToolTip="Add New Comment" Click="BtnAddComment_Click">
                <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2"  ToolTip="CommentLog" Click="BtnCommentLog_Click">
                <Image Source="/ZAS_ERP;component/images/comments.png" ></Image>
            </Button>
            <Button x:Name="btnAttachmentList" Width="30" Margin="5,0,0,0" Height="30" Grid.Column="3" ToolTip="Attachment List" Click="BtnAttachmentList_Click">
                <Image Source="/ZAS_ERP;component/images/ListAttachment.png"></Image>
            </Button>
            <Button x:Name="btnAttachNew1" Height="30" Width="30" Margin="5,0,0,0" Grid.Column="3" ToolTip="Attach document" Click="BtnAttachNew1_Click">
                <Image x:Name="imgAttachNew1"  Source="{dx:DXImage Image=Attachment_32x32.png}"></Image>
            </Button>
            <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnTrackingWindow" Click="BtnTrackingWindow_Click" Grid.Column="2" ToolTip="360 View">
                <Image Source="/ZAS_ERP;component/images/360Arrow.png" ></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnSetVoid" Click="BtnSetVoid_Click" Grid.Column="2" ToolTip="Void" Visibility="Visible">
                <Image Source="/ZAS_ERP;component/images/void_order.png" ></Image>
            </Button>
            <dx:SimpleButton Visibility="Visible" Height="30" Glyph="{dx:DXImage Image=Accounting_16x16.png}" Content="Create Payment" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"  Cursor="Hand" Margin="30,10,0,0" x:Name="btnCreatePayment" Grid.Column="2" ToolTip="Payment" Click="BtnCreatePayment_Click"/>
            <dx:SimpleButton Visibility="Visible" Height="30" Glyph="{dx:DXImage Image=Accounting_16x16.png}" Content="Gernal journal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"  Cursor="Hand" Margin="30,10,0,0" x:Name="btnGernalJournal" Grid.Column="2" ToolTip="Gernal Journal" Click="btnGernalJournal_Click"/>

        </StackPanel>

