<dx:DXWindow x:Class="ZAS_ERP.ToDoTasks.TargetRewardss.winSelectLedgerCompDept"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"     
        xmlns:local="clr-namespace:ZAS_ERP.ToDoTasks.TargetRewardss" 
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
        mc:Ignorable="d"
        Title="Select Company and Department for Debits and Credits" Height="200" Width="400"
             ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" >

    <dxlc:LayoutGroup Grid.ColumnSpan="2" Grid.Row="2" View="GroupBox" Header="Select Company Department for Debit and Credit" Margin="0 10 0 0">
        

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition  Width="auto" />
            <ColumnDefinition  />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="DemiBold"  HorizontalAlignment="Center" Grid.Row="0" Text="Company" />
        <dxg:LookUpEdit x:Name="lookupCompany"
                          Grid.Column="2"
                          Grid.Row="0"
                        Margin="5"
                          TabIndex="5"
                          DisplayMember="CompanyName"
                          AutoPopulateColumns="False"
                          VerticalAlignment="Center"
                          SelectedIndexChanged="lookupCompany_SelectedIndexChanged">
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings />
            </dxg:LookUpEdit.StyleSettings>
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView Name="tableView"
                                     ShowAutoFilterRow="True" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                            <dxg:GridColumn FieldName="CompanyName"
                                    IsSmart="True" />

                            <dxg:GridColumn x:Name="colBizType"
                                    FieldName="BizType"
                                    Visible="False"
                                    IsSmart="True" />
                            <dxg:GridColumn FieldName="EmployeerNo"
                                    x:Name="colEmployeerNo"
                                    IsSmart="True"
                                    Visible="False" />

                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="DemiBold"  HorizontalAlignment="Center"  Grid.Row="1" Text="Department" />
        <dxg:LookUpEdit Grid.Column="2" Grid.Row="1" Height="22"
                          VerticalAlignment="Center"
                        Margin="5"
                                                    x:Name="lookupDepartment" FontWeight="Bold"
                          AutoPopulateColumns="False"
                          DisplayMember="DeptName">
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <dxg:GridControl Name="PART_GridControl" SelectionMode="Row">
                        <dxg:GridControl.View>
                            <dxg:TreeListView  ShowAutoFilterRow="True"
                                        TreeDerivationMode="Selfreference"
                                        KeyFieldName="Id"
                                        ParentFieldName="ParentID"/>
                        </dxg:GridControl.View>

                        <dxg:GridColumn FieldName="Id"
                                    x:Name="coldeptid"
                                    IsSmart="True"
                                    Visible="False" />
                        <dxg:GridColumn x:Name="coldeptname"
                                    FieldName="DeptName"
                                    IsSmart="True" />
                        <dxg:GridColumn x:Name="coldeptcode"
                                    FieldName="Code"
                                    IsSmart="True" />
                        <dxg:GridColumn FieldName="Abbrivation"
                                    IsSmart="True"
                                    x:Name="coldeptabr"
                                    Visible="True" />
                        <dxg:GridColumn FieldName="Timestamp"
                                    IsSmart="True"
                                    x:Name="coldeptts"
                                    Visible="False" />
                    </dxg:GridControl>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>
        <dx:SimpleButton x:Name="btnSave" Content="Save" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="3" FontWeight="DemiBold" Click="btnSave_Click"/>
    </Grid>
    </dxlc:LayoutGroup>
    

</dx:DXWindow>
