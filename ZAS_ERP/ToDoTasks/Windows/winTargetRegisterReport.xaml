                    <!--<MenuItem Header="Add New" Click="BtnAddStep_Click"/>-->
                    <MenuItem Header="Open" Click="MenuItemOpen_Click"/>
                    <MenuItem Header="View Sale Orders Linked with Selected Target" Click="MenuItemLinkedSaleorders_Click" IsEnabled="True"/>
                    <MenuItem Header="View Sale Orders Linked with Visible Target" Click="MenuItemVisibleTargetsSaleorders_Click" IsEnabled="True"/>
                    <!--<MenuItem Header="Delete" Click="MenuItemDeleteStep_Click" IsEnabled="False"/>-->
                </ContextMenu>
            </dxg:GridControl.ContextMenu>

            <dxg:GridControl.View>
                <dxg:TableView x:Name="tableView"
                            ShowTotalSummary="True"
                                                ShowSearchPanelFindButton="True"
                                                ShowSearchPanelMode="Always"
                                                ShowGroupPanel="True" 
                                                AllowGrouping="True"
                                                AllowSorting="True"
                        CellStyle="{StaticResource FocusedCellStyle}" 
                                   RowStyle="{StaticResource FocusedRowStyle}"
                        CompactPanelShowMode="Always">
                    <dxg:TableView.FormatConditions>
                        <dxg:FormatCondition ApplyToRow="True"  Expression="Contains([Closed], 'Close')" FieldName="Closed">
                            <dx:Format Background="#FFCC1010" Foreground="#FF9BBB59" FontWeight="Bold" Icon="{dx:IconSet Name=Symbols3_1}" TextDecorations="{x:Null}"/>
                        </dxg:FormatCondition>
                        <dxg:FormatCondition ApplyToRow="True"  Expression="Contains([Closed], 'Paid')" FieldName="Closed">
                            <dx:Format Background="Green" Foreground="Yellow" FontWeight="Bold" Icon="{dx:IconSet Name=Symbols3_1}" TextDecorations="{x:Null}"/>
                        </dxg:FormatCondition>
                    </dxg:TableView.FormatConditions>
                </dxg:TableView>
            </dxg:GridControl.View>

