                                    <dx:Format Background="#FFCC1010" Foreground="#FF9BBB59" FontWeight="Bold" TextDecorations="{x:Null}"/>
                                </dxg:FormatCondition>

                                <dxg:FormatCondition ApplyToRow="True"  Expression="[UnderApprovalOrdersCount] = '0' And [ClosedOrdersCount] = '0' And [UnderClosingOrdersCount] = '0' And [ApprovedOrdersCount] &gt; '0'" FieldName="OpenOrdersCount">
                                    <dx:Format Background="Green" Foreground="#FF9BBB59" FontWeight="Bold" TextDecorations="{x:Null}"/>
                                </dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>

