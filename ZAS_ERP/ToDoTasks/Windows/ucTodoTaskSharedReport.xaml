                        <TextBlock x:Name="txtDesignation" Margin="10 5 0 0" TextWrapping="WrapWithOverflow" HorizontalAlignment="Left" Text="Designation"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="grdComments" Grid.Row="4" Visibility="Collapsed" Width="480" MaxHeight="700"  Background="Gray" Panel.ZIndex="6" VerticalAlignment="Stretch" Margin="0 -40 75 50" HorizontalAlignment="Right">

                    <dxg:GridControl AutoExpandAllGroups="True"  Height="620" Grid.Row="1"  dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">
                        <!--#region Columns-->
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                            <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                            <dxg:GridColumn Width="Auto" FieldName="Subject" />
                            <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                            <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                            <dxg:GridColumn
                            Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Descending" />
                        </dxg:GridControl.Columns>
                        <!--#endregion-->
                        <dxg:GridControl.View>
                            <dxg:TableView 
                            x:Name="GrdCommenttableView"
                            AllowEditing="False" 
                            DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                            DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0" 
                            RowStyle="{StaticResource RowStyle}"
                            ShowSearchPanelMode="Always"
                            SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" 
                            ShowIndicator="False" 
                            ShowVerticalLines="False"
                            CompactPanelShowMode="Always" 
                            SwitchToCompactModeWidth="700"
                            NavigationStyle="Row"
                           >

                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>

                                    <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Changed')">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task Approved')">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>

                                    <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task UnApproved')">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>

                                    <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task Voided')">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Background="Orange" />

                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>

                                    <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task UnVoided')">
                                        <dxg:FormatCondition.Format>
                                            <dxg:Format FontWeight="Bold" Background="Orange" />

                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>

                                </dxg:TableView.FormatConditions>
                                <!--#region CompactModeFilterItems-->
                                <!--<dxg:TableView.CompactModeFilterItems>
                            <dxg:CompactModeFilterItem DisplayValue="All" />
                            <dxg:CompactModeFilterItem DisplayValue="Read" EditValue="[isRead] = True" />
                            <dxg:CompactModeFilterItem DisplayValue="Unread" EditValue="[isRead] = False" />

                        </dxg:TableView.CompactModeFilterItems>-->
                                <!--#endregion-->

                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>

                </Grid>
