                            <dxb:BarButtonItem x:Name="mbtnUpdate" Content="Update" ItemClick="MbtnUpdate_ItemClick" Glyph="{dx:DXImage Image=EditDataSource_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                            <dxb:BarButtonItem x:Name="mbtnSaveLayout" Content="Save Layout" ItemClick="MbtnSaveLayout_ItemClick" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>
                            <!--<dxb:BarButtonItem x:Name="btnRename" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_32x32.png}" />-->
                            <dxb:BarButtonItem x:Name="mbtnDelete" Content="Delete" ItemClick="MbtnDelete_Click" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>
                            <dxb:BarButtonItem x:Name="mbtnRefresh" Content="Refresh" ItemClick="MbtnRefresh_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                            <dxb:BarButtonItem x:Name="mbtnRefreshSystemPoints" Content="Refresh System Points" ItemClick="MbtnRefreshSystemPoints_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>

                            <dxb:BarButtonItem ToolTip="Expand" x:Name="mbtnExpand" Content="Expand" ItemClick="MbtnExpand_ItemClick" Glyph="{dx:DXImage Image=Stretch_32x32.png}" LargeGlyph="{dx:DXImage Image=Stretch_32x32.png}"/>
                            <dxb:BarButtonItem ToolTip="Collapse" x:Name="mbtnCollapse" Content="Collapse" ItemClick="MbtnCollapse_ItemClick" Glyph="{dx:DXImage Image=Squeeze_32x32.png}" LargeGlyph="{dx:DXImage Image=Squeeze_32x32.png}"/>
                            <dxb:BarButtonItem ToolTip="Export to Report" x:Name="mbtnExport" Content="Export to Report" ItemClick="MbtnExport_ItemClick" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                        </dxr:RibbonPageGroup>
                        <!--<dxr:RibbonPageGroup Caption="Font">
                                <dxr:BarButtonGroup>
                                    <dxb:BarButtonItem Content="Export to Standard" Glyph="{dx:DXImage Image=Bold_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Italic" Glyph="{dx:DXImage Image=Italic_16x16.png}"/>
                                    <dxb:BarButtonItem Content="Underline" Glyph="{dx:DXImage Image=Underline_16x16.png}"/>
                                </dxr:BarButtonGroup>

                            </dxr:RibbonPageGroup>-->
                    </dxr:RibbonPage>

                </dxr:RibbonDefaultPageCategory>
            </dxr:RibbonControl>

            <Menu DockPanel.Dock="Top"
              x:Name="menuGrid"
              Grid.Row="1">

                <MenuItem Header="Export To Report"
                      x:Name="mbtnExportToReport"
                      Click="MbtnExportToReport_Click"
                              Visibility="Collapsed"/>

                <MenuItem Header="Direct Close"
                      x:Name="mbtnDriectClose"
                      Click="MbtnDriectClose_Click"
                              Visibility="Collapsed"/>

                <MenuItem Header="Approve"
