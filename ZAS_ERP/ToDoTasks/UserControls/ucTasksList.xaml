                <MenuItem x:Name="mbtnBasketedStepsCount" FontWeight="Bold"  Foreground="Blue"/>

            </Menu>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <dxe:TextEdit Text="From" FontWeight="DemiBold" Background="LightGreen" IsReadOnly="True" HorizontalContentAlignment="Center" Grid.Column="0"/>
                <dxe:DateEdit x:Name="dateFrom" NullText="Select Date" Grid.Column="1" FontWeight="DemiBold" AllowRoundOutOfRangeValue="False" 
                              MaskUseAsDisplayFormat="True" Mask="MMMyyyy" 
                                  ShowClearButton="True" UseLayoutRounding="True" 
                                  PopupFooterButtons="OkCancel" 
                                  VerticalAlignment="Center" >
                    <dxe:DateEdit.StyleSettings>
                        <dxe:DateEditPickerStyleSettings/>
                    </dxe:DateEdit.StyleSettings>
                </dxe:DateEdit>
                <dxe:TextEdit Grid.Column="2" FontWeight="DemiBold" Background="Orange" IsReadOnly="True" HorizontalContentAlignment="Center" Text="To"/>
                <!--<dxe:DateEdit x:Name="dateTo" NullText="Select Date" Grid.Column="3" FontWeight="DemiBold"
                               MaskUseAsDisplayFormat="True" Mask="MMMyyyy" 
                                  ShowClearButton="True" UseLayoutRounding="True" 
                                  PopupFooterButtons="OkCancel" 
                                  VerticalAlignment="Center">-->

                <dxe:DateEdit x:Name="dateTo" Margin="5 0 0 0" Height="22"  MaskUseAsDisplayFormat="True" Mask="MMMyyyy" 
                                  ShowClearButton="True" UseLayoutRounding="True" 
                                  PopupFooterButtons="OkCancel" 
                                 Grid.Column="3"
                              NullText="Month"
                                  VerticalAlignment="Center"  >
                    <dxe:DateEdit.StyleSettings>
                        <dxe:DateEditPickerStyleSettings/>
                    </dxe:DateEdit.StyleSettings>
                </dxe:DateEdit>
                <dx:SimpleButton x:Name="btnDateFilter" ToolTip="Filter by date range" Grid.Column="4" Content="Apply" Cursor="Hand" Click="BtnDateFilter_Click"  />
                <StackPanel x:Name="panelCheckBoxes" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="5" VerticalAlignment="Center" Margin="10 5 5 5" Orientation="Horizontal" HorizontalAlignment="Left">
                    <dxe:CheckEdit Content="All Approved SO" IsChecked="True" x:Name="chkApprovedSO" Checked="ChkApprovedSO_Checked" Unchecked="ChkApprovedSO_Unchecked"/>
                    <dxe:CheckEdit Content="All Closed SO" IsChecked="True" Margin="10 0 0 0" x:Name="chkClosedSO" Checked="ChkClosedSO_Checked" Unchecked="ChkClosedSO_Unchecked"/>
                </StackPanel>
                <Button Height="30" Width="30" Margin="5,0,5,0" Grid.Row="1"  x:Name="btnAddComment" Visibility="Visible" HorizontalAlignment="Right" Grid.Column="4" ToolTip="Add New Comment" Click="BtnAddComment_Click">
                    <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
                </Button>
                <Button Height="30" Width="30" Margin="0,0,40,0" Grid.Row="1" x:Name="btnCommentLog" Visibility="Visible" HorizontalAlignment="Right" Grid.Column="4"  ToolTip="CommentLog" Click="BtnCommentLog_Click">
                    <Image Source="/ZAS_ERP;component/images/comments.png" ></Image>
                </Button>
                <TextBlock x:Name="lblTaskHeading" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="2" FontSize="20" FontWeight="DemiBold" HorizontalAlignment="Center" Text="Open Tasks"/>
            </Grid>

            <Grid x:Name="grdComments" Grid.Row="4" Visibility="Collapsed" Width="480" MaxHeight="700"  Background="Gray" Panel.ZIndex="6" VerticalAlignment="Stretch" Margin="75 -50 50 50" HorizontalAlignment="Left">

                <dxg:GridControl AutoExpandAllGroups="True"  Height="620" Grid.Row="1"  dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">
                    <!--#region Columns-->
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                        <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                        <dxg:GridColumn Width="Auto" FieldName="Subject" />
                        <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                        <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                        <dxg:GridColumn
                            Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Descending" />
                    </dxg:GridControl.Columns>
                    <!--#endregion-->
                    <dxg:GridControl.View>
                        <dxg:TableView 
                            x:Name="GrdCommenttableView"
                            AllowEditing="False" 
                            DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                            DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0" 
                            RowStyle="{StaticResource RowStyle}"
                            ShowSearchPanelMode="Always"
                            SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" 
                            ShowIndicator="False" 
                            ShowVerticalLines="False"
                            CompactPanelShowMode="Always" 
                            SwitchToCompactModeWidth="700"
                            NavigationStyle="Row"
