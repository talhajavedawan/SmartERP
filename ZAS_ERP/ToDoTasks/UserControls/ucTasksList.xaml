                <MenuItem x:Name="mbtnGroupStepRegisterCount" FontWeight="Bold"  Foreground="Blue"/>

                <MenuItem Header="Step Register"
                          x:Name="mbtnStepRegister"
                          Padding="0 0 -3 0"
                          Click="MbtnStepRegister_Click"/>
                <MenuItem x:Name="mbtnStepRegisterCount" FontWeight="Bold"  Foreground="Blue"/>

                <MenuItem Header="Basketed Steps"
                          x:Name="mbtnBasketedSteps"
                          Padding="0 0 -3 0"
