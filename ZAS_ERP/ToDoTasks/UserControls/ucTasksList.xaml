                    Header="Open Tasks"
                    Padding="0 0 -3 0"
                          Click="MbtnOpenedTasks_Click">
                    <!--<MenuItem.Template>
                        <ControlTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Open Tasks"></TextBlock>

                                -->
                    <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                    <!--

                                <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtOpenedTasksCount" Text="{Binding OpenTasksCount}" Foreground="Blue"></TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </MenuItem.Template>-->
                </MenuItem>
                <MenuItem x:Name="mbtnOpenedTasksCounter" FontWeight="Bold"  Foreground="Blue"/>

                <MenuItem Header="Closed Tasks"
                          Padding="0 0 -3 0"
                          x:Name="mbtnClosedTaskss"
                          Click="MbtnClosedTaskss_Click">
                    <!--<MenuItem.Template>
                        <ControlTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Closed"></TextBlock>

                                -->
                    <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                    <!--

                                <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtClosedTasksCount" Text="{Binding OpenTasksCount}" Foreground="Blue"></TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </MenuItem.Template>-->
                </MenuItem>
                <MenuItem x:Name="mbtnClosedTasksCounter" FontWeight="Bold"  Foreground="Blue"/>

                <MenuItem Header="Group Register"
                    Padding="0 0 -3 0"
                          x:Name="mbtnGroupRegister"
                          Click="MbtnGroupRegister_Click">
                    <!--<MenuItem.Template>
                        <ControlTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Group Register"></TextBlock>

                                -->
                    <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                    <!--

                                <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtGroupRegisterCount" Text="{Binding GroupRegisterCount}" Foreground="Blue"></TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </MenuItem.Template>-->
                </MenuItem>
                <MenuItem x:Name="mbtnGroupRegisterCounter" FontWeight="Bold"  Foreground="Blue"/>

                <MenuItem Header="Task Register"
                          Padding="0 0 -3 0"
                          x:Name="mbtnTaskRegister"
                          
                          Click="MbtnTaskRegister_Click">
                    <!--<MenuItem.Template>
                        <ControlTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Task Register"></TextBlock>

                                -->
                    <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                    <!--

                                <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtApproveUnapproved" Text="{Binding TaskRegisterCount}" Foreground="Blue"></TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </MenuItem.Template>-->
                </MenuItem>
                <MenuItem x:Name="mbtnTaskRegisterCounter" FontWeight="Bold"  Foreground="Blue"/>

                <MenuItem Header="Basketed Targets"
                          x:Name="mbtnBasketedTargets"
                          Padding="0 0 -3 0"
                          Click="MbtnBasketedTargets_Click"/>
                <MenuItem x:Name="mbtnBasketedTargetsCount" FontWeight="Bold"  Foreground="Blue"/>

                <MenuItem Header="Void"
                          x:Name="mbtnVoid"
                          Padding="0 0 -3 0"
                          Click="MbtnVoid_Click">
                    <!--<MenuItem.Template>
                        <ControlTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Void"/>
                                -->
                    <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                    <!--
                                <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtVoidcount" Text="{Binding VoidCount}" Foreground="Red"/>
                            </StackPanel>
                        </ControlTemplate>
                    </MenuItem.Template>-->
                </MenuItem>
                <MenuItem x:Name="mbtnVoidCounter" FontWeight="Bold"  Foreground="Blue"/>

                <MenuItem Header="Step-Approvals"
                          x:Name="mbtnStepsForApproval"
                          Padding="0 0 -3 0"
                          Click="MbtnStepsForApproval_Click"/>
                <MenuItem x:Name="mbtnStepsForApprovalCount" FontWeight="Bold"  Foreground="Blue"/>
                <MenuItem Header="Step-ReApprovals"
                          x:Name="mbtnStepsForReApprovals"
                          Padding="0 0 -3 0"
                          Click="MbtnStepsForReApprovals_Click"/>
                <MenuItem x:Name="mbtnStepsForReApprovalCount" FontWeight="Bold"  Foreground="Blue"/>

                <MenuItem Header="Group Step Register"
                          x:Name="mbtnGroupStepRegister"
                          Padding="0 0 -3 0"
