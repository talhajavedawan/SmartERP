            </Grid.RowDefinitions>

            <Button ToolTip="Theme Color" Visibility="Collapsed" x:Name="btnThemeColor" Click="BtnThemeColor_Click" Width="auto" Padding="5 0 5 5" Height="20" Content="..." VerticalContentAlignment="Center" HorizontalAlignment="Right" Margin="0 0 10 0"/>

            <Grid x:Name="grdThemeColor"
