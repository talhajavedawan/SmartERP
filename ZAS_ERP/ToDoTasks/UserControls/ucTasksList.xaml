                        <dxg:DefaultControlTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Task-ReApprovals" ToolTip="List of Bill which needs ReApproval due to Cost sheet"/>
                                <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
