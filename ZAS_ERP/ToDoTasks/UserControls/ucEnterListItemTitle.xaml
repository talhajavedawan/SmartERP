                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        




                        <Grid Grid.Row="3" Grid.RowSpan="2" x:Name="gridCompDeptBulk" Grid.ColumnSpan="2" Margin="10 10 10 30">


                            <dx:DXTabControl>
                                <dx:DXTabItem Header="Companies" Width="150" x:Name="tabBulkCompanies">
