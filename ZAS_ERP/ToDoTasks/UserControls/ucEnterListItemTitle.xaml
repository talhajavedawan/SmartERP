                                    IsSmart="True"/>

                                                <dxg:GridColumn
                                    FieldName="employee.empFunction.Title"
                                    Header="Function"
                                    IsSmart="True"/>
                                            </dxg:GridControl>
                                        </Grid>


                                        <Grid VerticalAlignment="Center" Width="30">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>

                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Image Source="/ZAS_ERP;component/images/Forward_32x32.png" Grid.Row="0" Height="30" Width="30"  VerticalAlignment="Bottom" x:Name="imgLeftToRightUsersBulk" MouseDown="ImgLeftToRightUsersBulk_MouseDown" MouseUp="ImgLeftToRightUsersBulk_MouseUp"/>

                                            <Image Source="/ZAS_ERP;component/images/Backward_32x32.png" Grid.Row="1" Height="30" Width="30"  VerticalAlignment="Top" x:Name="imgRightToLeftUsersBulk" MouseDown="ImgRightToLeftUsersBulk_MouseDown" MouseUp="ImgRightToLeftUsersBulk_MouseUp"/>
                                        </Grid>

                                        <Grid Background="#bed6f6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Selected Users" HorizontalAlignment="Center" FontWeight="Bold" Padding="5 5 5 5"/>
                                            <dxg:GridControl x:Name="grdCntrlSelectedUsersBulk" 
                                 Margin="10 0 10 10"
                                 Grid.Row="3"
                                 AutoGenerateColumns="None"
                                 Grid.ColumnSpan="2"
                                 SelectionMode="Row"
                                 AllowInitiallyFocusedRow="False">
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView x:Name="gridSelectedUsersViewBulk"
