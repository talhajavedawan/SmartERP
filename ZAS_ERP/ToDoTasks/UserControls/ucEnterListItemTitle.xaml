                                    Header="Function"
                                    IsSmart="True"/>
                                            </dxg:GridControl>
                                        </Grid>
                                    </dxlc:LayoutGroup>
                                </dx:DXTabItem>
                            </dx:DXTabControl>



                        </Grid>
                    </Grid>
                </dxlc:LayoutGroup>
            </dx:DXTabItem>


            <dx:DXTabItem  Header="Group Details" x:Name="tabGroupDetails">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <dxlc:LayoutGroup Header="Group Details"   View="Group" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical">


                    <Grid Background="White">
                       

                       

                       

                        <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="gridCompDept" Grid.ColumnSpan="2" Margin="10 10 10 30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

