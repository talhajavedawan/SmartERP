<UserControl x:Class="ZAS_ERP.ToDoTasks.UserControls.ucEnterListItemTitle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ToDoTasks.UserControls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="750" d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="FocusedCellStyle" TargetType="dxg:LightweightCellEditor">
            <Style.Triggers>
                <Trigger Property="dxg:DataViewBase.IsFocusedCell" Value="True">
                    <Setter Property="Background" Value="LightGreen" />
                    <Setter Property="Foreground" Value="DarkGreen" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FocusedRowStyle" TargetType="dxg:RowControl">
            <Style.Triggers>
                <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True">
                    <Setter Property="Background" Value="Gray" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressBarStyle" TargetType="dxe:ProgressBarEditSettings">
            <Setter Property="ContentDisplayMode" Value="Value"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Black" HorizontalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="85"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Group Name" x:Name="lblGroupName" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 5 0 0"/>
        <TextBox x:Name="txtItemTitle" Grid.Column="1" Height="22" Grid.Row="0" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="5 10 10 10">
            <!--<TextBox.BorderBrush>
                <LinearGradientBrush EndPoint="1,1" StartPoint="1,0">
                    <GradientStop Color="Green" Offset="1"/>
                    <GradientStop Color="Green" Offset="0.75"/>
                    <GradientStop Color="Green" Offset="0.75"/>
                    <GradientStop Color="Green" Offset="1"/>
                </LinearGradientBrush>
            </TextBox.BorderBrush>-->
        </TextBox>


        <TextBlock x:Name="lblParentGroup" Text="Parent Group" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 5 0 0"/>

        <Grid Grid.Column="3" Margin="0 5 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <dxg:LookUpEdit x:Name="lookupParentGroup"
                            DisplayMember="GroupName"
                            Grid.Column="0"
                            Margin="5 0 0 0"
                            Height="25"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            AutoPopulateColumns="True"
                            PopupOpened="LookupParentGroup_PopupOpened">
                <dxg:LookUpEdit.PopupContentTemplate>
                    <ControlTemplate>
                        <dxg:GridControl Name="PART_GridControl"
                                         AutoGenerateColumns="None"
                                         AutoPopulateColumns="True">
                            <dxg:GridControl.View>
                                <dxg:TreeListView KeyFieldName="Id" 
                                                  ParentFieldName="parentId"
                                                  ShowAutoFilterRow="True"
                                                  TreeDerivationMode="Selfreference"/>
                            </dxg:GridControl.View>

                            <dxg:GridColumn FieldName="creationDate"
                                            IsSmart="True"
                                            Visible="False"
                                            VisibleIndex="6"/>

                            <dxg:GridColumn FieldName="GroupName"
                                    Header="Group Name"
                                    VisibleIndex="0"
                                    AllowEditing="false"/>


                            <dxg:GridColumn FieldName="Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                            <dxg:GridColumn FieldName="GroupCreatorId" VisibleIndex="2" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                            <dxg:GridColumn FieldName="GroupCreator" VisibleIndex="3" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                            <dxg:GridColumn FieldName="users" VisibleIndex="4" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                            <dxg:GridColumn FieldName="parentId" VisibleIndex="5" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                            <dxg:GridColumn FieldName="parentGroup" VisibleIndex="7" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
                        </dxg:GridControl>
                    </ControlTemplate>
                </dxg:LookUpEdit.PopupContentTemplate>
            </dxg:LookUpEdit>

            <dxe:CheckEdit x:Name="chkHasParent" Grid.Column="1" Content="Has Parent" Margin="10 0 0 0"
                               Checked="ChkHasParent_Checked"
                               Unchecked="ChkHasParent_Unchecked"/>
        </Grid>

        <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0 10 0 10" x:Name="grdCalculationType">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Calculation Type" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <dxg:LookUpEdit x:Name="lookUpCalculationType" 
                                        Grid.Row="1"
                                        IsTextEditable="False" 
                                        Grid.Column="1" 
                                        Margin="5 0 10 0"
                                        Height="22"
                                        DisplayMember="TypeName"
                                        ValueMember="Id"
                                        AutoPopulateColumns="False">

                <dxg:LookUpEdit.PopupContentTemplate>
                    <ControlTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>

                            <dxg:GridControl Name="PART_GridControl"
                                                         AutoPopulateColumns="False"
                                                         Grid.Row="1"
                                                         SelectionMode="Row">
                                <dxg:GridControl.View>
                                    <dxg:TableView Name="treeViewCalculationType"
                                                               ShowAutoFilterRow="True"    
                                                               ShowCheckBoxSelectorColumn="False"/>
                                </dxg:GridControl.View>

                                <dxg:GridColumn FieldName="Id"
                                                            Visible="False"/>

                                <dxg:GridColumn FieldName="TypeName"
                                                            Visible="True"
                                                            AllowEditing="false"/>
                            </dxg:GridControl>
                        </Grid>
                    </ControlTemplate>
                </dxg:LookUpEdit.PopupContentTemplate>
            </dxg:LookUpEdit>

            <TextBlock Text="Group Level" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <dxg:LookUpEdit x:Name="lookUpTargetGroup" 
                                                IsTextEditable="False" 
                                                AutoPopulateColumns="True"
                                                DisplayMember="GroupName" 
                                                Grid.Row="5" 
                                                ValueMember="Id"
                                                Grid.Column="3" 
                                                Margin="5 0 10 0">
                <dxg:LookUpEdit.PopupContentTemplate>
                    <ControlTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>

                            <dxg:GridControl Name="PART_GridControl"
                                                             AutoPopulateColumns="True"
                                                             Grid.Row="1">
                                <dxg:GridControl.View>
                                    <dxg:TreeListView Name="treeListView1"
                                                                       AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowAutoFilterRow="True"/>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </Grid>
                    </ControlTemplate>
                </dxg:LookUpEdit.PopupContentTemplate>
            </dxg:LookUpEdit>
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0 0 0 10" x:Name="grdModuleType">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="*"/>
                
            </Grid.ColumnDefinitions>
           

            <TextBlock Text="Module Type" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0"/>
            <dxe:ComboBoxEdit Grid.Column="1" 
                                          Height="22"
                                          Name="cmbxModuleType"
                                          TabIndex="1"
                              Margin="5 0 10 0"/>
        </Grid>

        <dx:DXTabControl Grid.Row="3" Grid.ColumnSpan="4">
