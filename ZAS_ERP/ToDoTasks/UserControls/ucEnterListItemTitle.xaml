                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Companies" HorizontalAlignment="Center" FontWeight="Bold" Padding="5 5 5 5"/>

                                            <dxg:GridControl SelectionMode="Row"
                                             x:Name="grdCntrlCompanyBulk"
                                             AutoGenerateColumns="None"
                                             AllowInitiallyFocusedRow="False"
                                             Grid.Row="1"
                                             Margin="5 5 5 5">

                                                <dxg:GridControl.View>
                                                    <dxg:TableView x:Name="viewTableBulk"
                                    AutoWidth="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    UseIndicatorForSelection="True"                                    
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True"
                                                   ShowGroupPanel="False"
                                                   ShowSearchPanelMode="Always"
                                            CellStyle="{StaticResource FocusedCellStyle}"
                                                RowStyle="{StaticResource FocusedRowStyle}"/>
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn 
                                FieldName="Id"
                                IsSmart="True"
                                Visible="False" />
                                                <dxg:GridColumn FieldName="CompanyName"
                                IsSmart="True" />
                                                <dxg:GridColumn FieldName="IndustryType"
                                IsSmart="True" />
                                                <dxg:GridColumn
                                FieldName="BizType"
                                Visible="False"
                                IsSmart="True" />
                                                <dxg:GridColumn FieldName="EmployeerNo"
                                IsSmart="True"
                                Visible="False" />
                                            </dxg:GridControl>
                                        </Grid>
                                        <Grid VerticalAlignment="Center" Width="30">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>

                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Image Source="/ZAS_ERP;component/images/Forward_32x32.png" Grid.Row="0" Height="30" Width="30"  VerticalAlignment="Bottom" x:Name="imgLeftToRightCompBulk" MouseDown="ImgLeftToRightCompBulk_MouseDown" MouseUp="ImgLeftToRightCompBulk_MouseUp"/>

                                            <Image Source="/ZAS_ERP;component/images/Backward_32x32.png" Grid.Row="1" Height="30" Width="30"  VerticalAlignment="Top" x:Name="imgRightToLeftCompBulk" MouseDown="ImgRightToLeftCompBulk_MouseDown" MouseUp="ImgRightToLeftCompBulk_MouseUp"/>
                                        </Grid>

                                        <Grid Background="#bed6f6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Selected Companies" HorizontalAlignment="Center" FontWeight="Bold" Padding="5 5 5 5"/>
                                            <dxg:GridControl SelectionMode="Row"
                                             x:Name="gridSelectedCompaniesBulk"
                                             AutoGenerateColumns="None"
                                             AllowInitiallyFocusedRow="False"
                                             Grid.Row="1"
                                             Margin="5 5 5 5">

                                                <dxg:GridControl.View>
                                                    <dxg:TableView x:Name="viewSelectedCompaniesBulk"
                                    AutoWidth="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    UseIndicatorForSelection="True"                                    
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True"
                                                   ShowGroupPanel="False"
                                                   ShowSearchPanelMode="Always"
                                            CellStyle="{StaticResource FocusedCellStyle}"
                                                RowStyle="{StaticResource FocusedRowStyle}"/>
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn
                                FieldName="Id"
                                IsSmart="True"
                                Visible="False" />
                                                <dxg:GridColumn FieldName="CompanyName"
                                IsSmart="True" />
                                                <dxg:GridColumn FieldName="IndustryType"
                                IsSmart="True" />
                                                <dxg:GridColumn
                                FieldName="BizType"
                                Visible="False"
                                IsSmart="True" />
                                                <dxg:GridColumn FieldName="EmployeerNo"
                                IsSmart="True"
                                Visible="False" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </dxlc:LayoutGroup>
                                </dx:DXTabItem>

                                <dx:DXTabItem Header="Departments" Width="150" x:Name="tabBulkDepartments">

                                    <Grid>

                                        <dxlc:LayoutGroup View="GroupBox" x:Name="layoutGrpDeptsBulk" Header="Department Level 1" Grid.Column="0" Margin="10 0 0 0" Orientation="Horizontal" Padding="-5">
                                            <Grid Background="#bed6f6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Departments"  HorizontalAlignment="Center" FontWeight="Bold" Padding="5 5 5 5"/>
                                                <dxg:GridControl x:Name="gridDepartmentBulk"
                                                                AutoGenerateColumns="None"
                                                                Grid.Row="1"
                                                                SelectionMode="Row"
                                                                AllowInitiallyFocusedRow="False"
                                                                FilterChanged="GridDepartmentBulk_FilterChanged">
                                                    <dxg:GridControl.View>
                                                        <dxg:TreeListView x:Name="griddeptviewBulk"
                                                                        AutoWidth="True"
                                                                        KeyFieldName="Id"
                                                                        ParentFieldName="ParentID"
                                                                        TreeDerivationMode="Selfreference"
                                                                        AutoExpandAllNodes="True"
                                                                        IsSynchronizedWithCurrentItem="True"
                                                                        AllowEditing="False"
                                                                        ShowSearchPanelMode="Always"
                                                                        UseIndicatorForSelection="True"
                                                                        FadeSelectionOnLostFocus="False"
                                                                        ShowSelectionRectangle="True"
                                                                        CustomUnboundColumnData="GriddeptviewBulk_CustomUnboundColumnData"
                                                                        CellStyle="{StaticResource FocusedCellStyle}"
                                                                        RowStyle="{StaticResource FocusedRowStyle}"
                                                                          ShowTotalSummary="True">
                                                        </dxg:TreeListView>
                                                    </dxg:GridControl.View>

                                                    <dxg:GridColumn FieldName="Id"
                                                                    IsSmart="True"
                                                                    Visible="False" 
                                                                    ShowInColumnChooser="False"/>
                                                    
                                                    <dxg:GridColumn FieldName="DeptName"
                                                                    IsSmart="True" 
                                                                    Width="auto"
                                                                    Visible="False"
                                                                    ShowInColumnChooser="False"/>

                                                    <dxg:GridColumn FieldName="Code"
                                                                    IsSmart="True" 
                                                                    Width="auto"
                                                                    Visible="False"
                                                                    ShowInColumnChooser="False"/>

                                                    <dxg:GridColumn Header="Department level 1" 
                                                                    UnboundType="string" 
                                                                    x:Name="colDeptLevel1" 
                                                                    ShowInColumnChooser="False"
                                                                    Width="auto"
                                                                    FieldName="departmentLevel1"/>

                                                    <dxg:GridColumn Header="Department level 2" 
                                                                    UnboundType="string" 
                                                                    x:Name="colDeptLevel2" 
                                                                    ShowInColumnChooser="False"
                                                                    FieldName="departmentLevel2"
                                                                    Width="auto"/>

                                                    <dxg:GridColumn Header="Department level 3"
                                                                    UnboundType="string"
                                                                    x:Name="colDeptLevel3"
                                                                    ShowInColumnChooser="False"
                                                                    FieldName="departmentLevel3"/>

                                                    <dxg:GridColumn Header="Department level 4"
                                                                    FieldName="departmentLevel4" 
                                                                    UnboundType="string" 
                                                                    x:Name="colDeptLevel4" 
                                                                    ShowInColumnChooser="False"
                                                                    IsSmart="True"
                                                                    Width="auto"/>

                                                    <dxg:GridColumn Header="Department level 5" 
                                                                    x:Name="colDeptLevel5" 
                                                                    ShowInColumnChooser="False"
                                                                    FieldName="departmentLevel5" 
                                                                    UnboundType="string"
                                                                    IsSmart="True"
                                                                    Width="auto"/>
                                                </dxg:GridControl>
                                            </Grid>


                                            <Grid Background="#bed6f6" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Selected Departments" HorizontalAlignment="Center" FontWeight="Bold" Padding="5 5 5 5"/>
                                                <dxg:GridControl x:Name="gridSelectedDepartmentsBulk"
                             AutoGenerateColumns="None"
                             Grid.Row="1"
                                                                     SelectionMode="Row"
                                                                     AllowInitiallyFocusedRow="False">
                                                    <dxg:GridControl.View>
                                                        <dxg:TreeListView x:Name="gridSelectedDeptviewBulk"
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowSearchPanelMode="Always"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True"
                                               CellStyle="{StaticResource FocusedCellStyle}"
                                                RowStyle="{StaticResource FocusedRowStyle}">

                                                        </dxg:TreeListView>
                                                    </dxg:GridControl.View>
                                                    <dxg:GridColumn FieldName="Id"
                              IsSmart="True"
                              Visible="False" />
                                                    <dxg:GridColumn 
                              FieldName="DeptName"
                              IsSmart="True" />
                                                    <dxg:GridColumn 
                              FieldName="Code"
                              IsSmart="True" />
                                                    <dxg:GridColumn FieldName="Abbrivation"
                              IsSmart="True"
                              Visible="False" />
                                                    <dxg:GridColumn FieldName="Timestamp"
                              IsSmart="True"
                              Visible="False" />
                                                    <dxg:GridColumn FieldName="sectionId"
                              IsSmart="True"
                              Visible="False" />
                                                    <dxg:GridColumn FieldName="sections"
                              IsSmart="True"
                              Visible="False" />
                                                </dxg:GridControl>
                                            </Grid>
                                        </dxlc:LayoutGroup>

                                    </Grid>
                                </dx:DXTabItem>

                                <dx:DXTabItem Header="Users" Width="150">
                                    <dxlc:LayoutGroup View="GroupBox" x:Name="layoutGrpUsersBulk" Header="Users" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Margin="10 0 0 0" Orientation="Horizontal" Padding="-5">

                                        <Grid Background="#bed6f6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Users" HorizontalAlignment="Center" FontWeight="Bold" Padding="5 5 5 5"/>
                                            <dxg:GridControl x:Name="grdCntrlUsersBulk" 
                                 Margin="10 0 10 10"
                                 Grid.Row="3"
                                 AutoGenerateColumns="None"
                                 Grid.ColumnSpan="2"
                                 SelectionMode="Row"
                                 AllowInitiallyFocusedRow="False">
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView x:Name="gridUsersViewBulk"
                                          AutoWidth="True"
                                          KeyFieldName="id"
                                          TreeDerivationMode="Selfreference"
                                          AutoExpandAllNodes="True"
                                          IsSynchronizedWithCurrentItem="True"
                                          AllowEditing="False"
                                          UseIndicatorForSelection="True"
                                          FadeSelectionOnLostFocus="False"
                                          ShowAutoFilterRow="True"
                                               CellStyle="{StaticResource FocusedCellStyle}"
                                                RowStyle="{StaticResource FocusedRowStyle}">
                                                    </dxg:TreeListView>
                                                </dxg:GridControl.View>

                                                <dxg:GridColumn FieldName="id"
                                    IsSmart="True"
                                    Visible="False"/>

