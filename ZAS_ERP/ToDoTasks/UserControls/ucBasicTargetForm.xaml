<UserControl x:Class="ZAS_ERP.ToDoTasks.UserControls.ucBasicTargetForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ToDoTasks.UserControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
              xmlns:loc="clr-namespace:ZAS_ERP"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="550" d:DesignWidth="900">
    <Grid>



        <StackPanel Grid.Row="1" Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                 Grid.Column="0" Orientation="Horizontal" Margin="0 5 0 0" Height="50">
            <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click" Visibility="Collapsed">
                <Image Source="/ZAS_ERP;component/images/log.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1"  Click="BtnMarkReviewed_Click" Visibility="Collapsed" ToolTip="Approve - Mark as Reviewed">
                <Image Source="/ZAS_ERP;component/images/approve.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" Visibility="Collapsed" x:Name="btnClose" Click="BtnClose_Click" Grid.Column="2" ToolTip="Reject">
                <Image Source="/ZAS_ERP;component/images/block-icon.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" ToolTip="Add New Comment" Click="BtnAddComment_Click">
                <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2"  ToolTip="CommentLog" Click="BtnCommentLog_Click">
                <Image Source="/ZAS_ERP;component/images/comments.png" ></Image>
            </Button>
            <Button x:Name="btnAttachNew" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Info" Click="BtnAttachNew_Click" Visibility="Collapsed">
                <Image x:Name="imgAttachNew" Source="/ZAS_ERP;component/images/clipattachment.png"></Image>
            </Button>
            <Button x:Name="btnAttachmentList" Width="30" Height="30" Grid.Column="3" ToolTip="Info" Click="BtnAttachmentList_Click" Visibility="Collapsed">
                <Image  Source="/ZAS_ERP;component/images/ListAttachment.png"></Image>
            </Button>
            <Button Height="30" Width="30" Visibility="Collapsed"  Margin="5,0,0,0" x:Name="btnTrackingWindow" Click="BtnTrackingWindow_Click" Grid.Column="2" ToolTip="360 View" >
                <Image Source="/ZAS_ERP;component/images/360Arrow.png" ></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnSetVoid" Click="BtnSetVoid_Click" Grid.Column="2" ToolTip="Void" Visibility="Collapsed">
                <Image Source="/ZAS_ERP;component/images/void_order.png" ></Image>
            </Button>

           
            
            <StackPanel Orientation="Horizontal" x:Name="panelGroupImages"  Margin="20 0 0 0"/>
              

        </StackPanel>

        <Grid Panel.ZIndex="5" Visibility="Collapsed" x:Name="gridTracker" Width="500" Margin="50" MaxHeight="700"  HorizontalAlignment="Left" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="btnCollapse" Click="BtnCollapse_Click" Content="Collapse"></Button>
                <TextBlock Text="Activity Tracker" FontWeight="Bold" FontSize="26" Foreground="Black" Margin="30,5"></TextBlock>
                <Button x:Name="btnexpand" Click="Btnexpand_Click" Content="Expand"></Button>

            </StackPanel>
            <dxg:GridControl x:Name="grdUsers" Visibility="Visible"
                     Grid.Row="1" MaxHeight="520"
                     Grid.RowSpan="5" HorizontalAlignment="Left"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             
                     SelectionMode="Row" 
                             
                             
                      CustomUnboundColumnData="GrdUsers_CustomUnboundColumnData"   
                    AutoGenerateColumns="None">
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       
                                   AutoWidth="True"
                       Width="auto"
                       AllowGrouping="False"
                                   ShowGroupPanel="False"
                       
                       >

                    </dxg:TableView>
                </dxg:GridControl.View>
                <dxg:GridColumn Header="User Name"
                            FieldName="User.userName"
                            IsSmart="True"
                            Width="auto" />
                <!--<dxg:GridColumn FieldName="Name" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>-->
                <dxg:GridColumn FieldName="Timestamp" UnboundType="String" ReadOnly="True" Width="auto">
                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                </dxg:GridColumn>
                <dxg:GridColumn Header="Info"
                            FieldName="Info"
                            IsSmart="True"
                            Width="auto" />
                <dxg:GridColumn 
                            FieldName="Comment"
                            IsSmart="True"
                            Width="auto" />
                <!--<dxg:GridColumn FieldName="isActive"  >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>-->
                <!--<dxg:GridColumn FieldName="SupervisorName" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Departments" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Companies" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>-->
            </dxg:GridControl>
        </Grid>
        <Grid x:Name="grdComments"  Visibility="Collapsed" Width="500" MaxHeight="700"  Background="Gray" Panel.ZIndex="5" VerticalAlignment="Stretch" Margin="50" HorizontalAlignment="Left">

            <dxg:GridControl AutoExpandAllGroups="True"  Height="620" Grid.Row="1"  dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">
                <!--#region Columns-->
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                    <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                    <dxg:GridColumn Width="Auto" FieldName="Subject" />
                    <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                    <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                    <dxg:GridColumn
                            Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Descending" />
                </dxg:GridControl.Columns>
                <!--#endregion-->
                <dxg:GridControl.View>
                    <dxg:TableView 
                            x:Name="GrdCommenttableView"
                            AllowEditing="False" 
                            DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                            DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0" 
                            RowStyle="{StaticResource RowStyle}"
                            ShowSearchPanelMode="Always"
                            SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" 
                            ShowIndicator="False" 
                            ShowVerticalLines="False"
                            CompactPanelShowMode="Always" 
                            SwitchToCompactModeWidth="700"
                            NavigationStyle="Row"
                           >

                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Changed')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>
                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task Approved')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task UnApproved')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task Voided')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="Orange" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task UnVoided')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="Orange" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                        </dxg:TableView.FormatConditions>
                        <!--#region CompactModeFilterItems-->
                        <!--<dxg:TableView.CompactModeFilterItems>
                            <dxg:CompactModeFilterItem DisplayValue="All" />
                            <dxg:CompactModeFilterItem DisplayValue="Read" EditValue="[isRead] = True" />
                            <dxg:CompactModeFilterItem DisplayValue="Unread" EditValue="[isRead] = False" />

                        </dxg:TableView.CompactModeFilterItems>-->
                        <!--#endregion-->

                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>

        </Grid>
        <Grid x:Name="grdAttachments"   Width="300" MaxHeight="500" Visibility="Collapsed" Background="Gray" Panel.ZIndex="5" VerticalAlignment="Top" Margin="210,50,65,35" HorizontalAlignment="Left">
            <TreeView x:Name="treeViewAttachments" >
                <TreeView.Resources>
                    <HierarchicalDataTemplate  DataType="{x:Type loc:TreeItem}" ItemsSource="{Binding Items}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding name}"
                         Grid.Column="0"
                         
                         HorizontalAlignment="Stretch" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text=" [" Foreground="Blue" />
                                <TextBlock Text="{Binding Items.Count}" Foreground="Blue" />
                                <TextBlock Text="]" Foreground="Blue" />
                            </StackPanel>
                        </Grid>
                    </HierarchicalDataTemplate>
                    <DataTemplate  DataType="{x:Type loc:cmbitem}" >
                        <StackPanel>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />

                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />

                                </Grid.ColumnDefinitions>
                                <!--<CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>-->
                                <TextBlock Text="{Binding id}"
                         Visibility="Collapsed" />
                                <TextBlock Text="{Binding description}"
                         Visibility="Collapsed" />
                                <Button Content="Open" Margin="5,0" x:Name="btnDownloadAttachment" Click="BtnDownloadAttachment_Click" Foreground="Blue"  Tag="{Binding description}"></Button>

                                <TextBlock Text="   "
                         Background="{Binding bcolor}"
                         Width="20"
                         Margin="0,0,5,0" Grid.Column="1"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" >
                                    <TextBlock Text="{Binding name}"
                         Grid.Column="1"
                         
                         HorizontalAlignment="Stretch" />

                                    <!--<TextBlock Text=" [" Foreground="Blue" />-->
                                    <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                                    <!--<TextBlock Text="]" Foreground="Blue" />-->
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                    <!--<HierarchicalDataTemplate DataType="{x:Type self:cmbitem}"  >
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />

                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="1*" />
                                                    
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>
                                                <TextBlock Text="{Binding id}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="{Binding description}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="   "
                         Background="{Binding bcolor}"
                         Width="20"
                         Margin="0,0,5,0" Grid.Column="1"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding name}"
                         Grid.Column="1"
                         
                         HorizontalAlignment="Stretch" />
                                                
                                                    <TextBlock Text=" [" Foreground="Blue" />
                                                    <TextBlock Text="{Binding fcolor}" Foreground="Blue" />
                                                    <TextBlock Text="]" Foreground="Blue" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>-->
                </TreeView.Resources>
            </TreeView>
        </Grid>
        <Grid x:Name="grdAttach"   Width="250" MaxHeight="500" Visibility="Collapsed"  Background="White"  Panel.ZIndex="5" VerticalAlignment="Top" Margin="175,50,65,35" HorizontalAlignment="Left">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />

                    <ColumnDefinition Width="1*" />

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Category"
                         
                         
                         Margin="5,0,5,0" Grid.Column="0"/>
                <ComboBox x:Name="cmbCategory"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                          Margin="5,5"
                      Grid.Row="0"
                      TabIndex="0"
                      >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                                <TextBlock Text="{Binding name}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>


                <!--<TextBlock Text=" [" Foreground="Blue" />-->
                <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.ColumnSpan="2" Content="Select file" Margin="5" x:Name="btnAttachment" Click="BtnAttachment_Click" Foreground="Blue"  Tag="{Binding description}"></Button>
                <!--<TextBlock Text="]" Foreground="Blue" />-->

            </Grid>

        </Grid>


        <Grid Margin="0 0 0 0" Grid.ColumnSpan="2" >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <dx:DXTabControl Margin="0 50 0 0" MaxHeight="800" Padding="10" Panel.ZIndex="6">
                <dx:DXTabItem Header="  Step  " x:Name="tabTaskInfo" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                                <TextBlock Text="Group Name"
                                       x:Name="lblGroupName"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="22"
                                       Foreground="Black"
                                           FontWeight="DemiBold"/>
                            </StackPanel>
                        </Grid>

                        <dx:SimpleButton x:Name="btnOpenTargetForm" Click="BtnOpenTargetForm_Click" Margin="0 0 0 10" Content="Open Detailed Target" HorizontalAlignment="Right" Foreground="Black"/>

                        <dxlc:LayoutGroup Background="white" Padding="10" View="GroupBox" Header="Main Target Details" Grid.Row="2" Margin="0 10 0 0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="60"/>
                            </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition/>
                                    <!--<ColumnDefinition Width="20"/>
                                <ColumnDefinition/>-->
                                </Grid.ColumnDefinitions>


                                <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Creation Date:" Grid.Row="7" VerticalAlignment="Center"/>
                                <dxe:DateEdit x:Name="datCreationDate" Grid.Column="1" IsEnabled="False" FontWeight="Bold" Grid.Row="7" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Companies:" Grid.Row="7" VerticalAlignment="Center"/>
                                <dxe:TextEdit x:Name="txtCompanies" Grid.Column="1" IsReadOnly="True" Grid.Row="7" Margin="0 2 0 0"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Departments:" Grid.Row="7" VerticalAlignment="Center"/>
                                <dxe:TextEdit x:Name="txtDepartments" Grid.Column="1" IsReadOnly="True" Grid.Row="7" Margin="0 2 0 0"/>
                            </Grid>

                            <Grid Grid.Row="3" Grid.Column="0" Margin="0 2 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Task Name:" Grid.Row="5" VerticalAlignment="Center"/>
                                <dxe:TextEdit x:Name="txtSelectedTaskName" Grid.Column="1" IsReadOnly="True"/>
                            </Grid>

                            <Grid Grid.Row="4" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Group Level:" Grid.Row="5" VerticalAlignment="Center"/>
                                <dxg:LookUpEdit x:Name="lookUpTargetGroup" 
                                                IsTextEditable="False" 
                                                AutoPopulateColumns="True"
                                                DisplayMember="GroupName" 
                                                Grid.Row="5" 
                                                ValueMember="Id"
                                                Grid.Column="1" 
                                                Margin="0 2 0 0"
                                                IsReadOnly="True">
                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"></RowDefinition>
                                                    <RowDefinition Height="*"></RowDefinition>
                                                </Grid.RowDefinitions>

                                                <dxg:GridControl Name="PART_GridControl"
                                                             AutoPopulateColumns="True"
                                                             Grid.Row="1">
                                                    <dxg:GridControl.View>
                                                        <dxg:TreeListView Name="treeListView1"
                                                                       AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowAutoFilterRow="True"/>
                                                    </dxg:GridControl.View>
                                                </dxg:GridControl>
                                            </Grid>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>
                                </dxg:LookUpEdit>
                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Target Type:" Grid.Row="5" VerticalAlignment="Center"/>
                                    <dxg:LookUpEdit x:Name="lookUpTargetType" DisplayMember="TargetTypeName" Grid.Row="5" Grid.Column="1" Margin="0 2 0 0" IsReadOnly="True"/>
                            </Grid>

                            <TextBlock x:Name="txtTaskId" Text="0" Visibility="Collapsed"/>
                            <!--<Button Grid.Column="1" Content="x" x:Name="btnClose" Click="BtnClose_Click" Panel.ZIndex="5" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"/>-->

                            <Grid Grid.Row="1" Grid.Column="2" Margin="0 2 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition/>

                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Target Year:" Grid.Row="7" VerticalAlignment="Center"/>
                                    <dxe:DateEdit x:Name="datTargetYear" Grid.Column="1" MaskType="DateTime" PopupFooterButtons="OkCancel"   MaskUseAsDisplayFormat="True" Mask="yyyy" IsReadOnly="True">
                                    <dxe:DateEdit.StyleSettings>
                                        <dxe:DateEditPickerStyleSettings/>
                                    </dxe:DateEdit.StyleSettings>
                                </dxe:DateEdit>


                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="2" Margin="0 2 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Target Month" HorizontalAlignment="Left" Grid.Column="0" VerticalAlignment="Center"/>
                                    <dxe:DateEdit x:Name="datTargetMonth" Grid.Column="3" MaskType="DateTime"  PopupFooterButtons="OkCancel"  MaskUseAsDisplayFormat="True" Mask="MMM" IsReadOnly="True">
                                    <dxe:DateEdit.StyleSettings>
                                        <dxe:DateEditPickerStyleSettings/>
                                    </dxe:DateEdit.StyleSettings>
                                </dxe:DateEdit>
                            </Grid>




                            <Grid Grid.Column="2" Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="Target Status" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Grid.Column="1"
                                        TabIndex="12" x:Name="cmbTaskStatus" Height="22" Margin="0 2 0 0" IsEnabled="False">
                                    <ComboBox.ItemTemplate>

                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding id}" Visibility="Hidden" />
                                                <TextBlock Text="   " Background="{Binding bcolor}"
                                                Width="20" Margin="10,0" />
                                                <TextBlock Text="{Binding name}" Grid.Column="1"
                                                Foreground="{Binding fcolor}"
                                                HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!--<DatePicker Grid.Column="1" SelectedDate="" Name="datePickercreationDate"/>-->


                            </Grid>

                            <TextBlock Text="Description" Grid.Row="5" VerticalAlignment="Bottom" Grid.Column="0" Margin="0 0 0 5"/>
                            <dxe:TextEdit x:Name="txtTaskDescription" VerticalContentAlignment="Top" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" 
                                      Grid.RowSpan="3"
                                      AcceptsReturn="True" 
                                      AcceptsTab="True"
                                          IsReadOnly="True"/>

                            <!--<Grid Margin="0 10 0 10" Grid.Row="10" Grid.ColumnSpan="2">

                            <Border x:Name="panelAssignedTo" Visibility="Collapsed" Padding="5 5 5 5" BorderBrush="Black" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>


