                                    <dxe:DateEdit x:Name="datStepTargetMonth" Height="22" Grid.Column="3" MaskType="DateTime"  PopupFooterButtons="OkCancel"  MaskUseAsDisplayFormat="True" Mask="MMM" IsReadOnly="True">
                                    <dxe:DateEdit.StyleSettings>
                                        <dxe:DateEditPickerStyleSettings/>
                                    </dxe:DateEdit.StyleSettings>
                                </dxe:DateEdit>
                            </Grid>

                        </Grid>
