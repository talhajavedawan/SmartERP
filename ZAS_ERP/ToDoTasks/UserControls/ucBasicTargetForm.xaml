                                          MaskUseAsDisplayFormat="True" IsReadOnly="True"/>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="0" Margin="0 10 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Target Year" Grid.Row="7" VerticalAlignment="Center"/>
                                    <dxe:DateEdit x:Name="datStepTargetYear" Height="22" Grid.Column="1" MaskType="DateTime" PopupFooterButtons="OkCancel"   MaskUseAsDisplayFormat="True" Mask="yyyy" IsReadOnly="True">
