<UserControl x:Class="ZAS_ERP.ToDoTasks.UserControls.ucFrmAddStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ToDoTasks.UserControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="420" d:DesignWidth="500">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <dx:DXTabControl>
            <dx:DXTabItem Header="Add Target Step">
                <dxlc:LayoutGroup
                    View="Group">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 0 0 10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                                <TextBlock Text="Group Name"
                                       x:Name="lblGroupName"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       Foreground="Black"
                                           FontWeight="DemiBold"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Calculation Type" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <dxg:LookUpEdit x:Name="lookUpCalculationType" 
                                        Grid.Row="1"
                                        IsTextEditable="False" 
                                        Grid.Column="1" 
                                        Margin="10 0 10 0"
                                        Height="22"
                                        DisplayMember="TypeName"
                                        ValueMember="Id"
                                        AutoPopulateColumns="False">

                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>

                                        <dxg:GridControl Name="PART_GridControl"
                                                         AutoPopulateColumns="False"
                                                         Grid.Row="1"
                                                         SelectionMode="Row">
                                            <dxg:GridControl.View>
                                                <dxg:TableView Name="treeViewCalculationType"
                                                               ShowAutoFilterRow="True"    
                                                               ShowCheckBoxSelectorColumn="False"/>
                                            </dxg:GridControl.View>

                                            <dxg:GridColumn FieldName="Id"
                                                            Visible="False"/>

                                            <dxg:GridColumn FieldName="TypeName"
                                                            Visible="True"
                                                            AllowEditing="false"/>
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>


                        <TextBlock x:Name="txtParentId" Text="0" Visibility="Collapsed"/>
                        <TextBlock Grid.Column="0" Grid.Row="2" HorizontalAlignment="Right" Text="Status " VerticalAlignment="Center"/>
                        <ComboBox VerticalAlignment="Center" Grid.Column="1" Grid.Row="2"
                                        TabIndex="12" x:Name="cmbStepStatus" Height="22" Margin="10 0 10 0" IsEnabled="False">
                            <ComboBox.ItemTemplate>

                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding id}" Visibility="Hidden" />
                                        <TextBlock Text="   " Background="{Binding bcolor}"
                                                Width="20" Margin="10,0" />
                                        <TextBlock Text="{Binding name}" Grid.Column="1"
                                                Foreground="{Binding fcolor}"
                                                HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>



                        <TextBlock Text="Step Name: " Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <dxe:TextEdit x:Name="txtStepName" Grid.Row="3" Grid.Column="1" Height="22" Margin="10 0 10 0"/>


                    
                            <TextBlock Text="Group Level:" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <dxg:LookUpEdit x:Name="lookUpTargetGroup" 
                                                IsTextEditable="False" 
                                                AutoPopulateColumns="True"
                                                DisplayMember="GroupName" 
                                                Grid.Row="4" 
                                                ValueMember="Id"
                                                Grid.Column="1" 
                                                Margin="10 0 10 0"
                                            Height="22">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>

                                            <dxg:GridControl Name="PART_GridControl"
                                                             AutoPopulateColumns="True"
                                                             Grid.Row="1">
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView Name="treeListView1"
                                                                       AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowAutoFilterRow="True"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>

                        <TextBlock Text="Step Target Points: " Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                        <Grid Grid.Column="1" Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <dxe:TextEdit x:Name="txtStepPoints" Height="22"  Margin="10 0 5 0" Mask="n2" MaskType="Numeric" Text="0"
                                          MaskUseAsDisplayFormat="True"/>
                            <Button x:Name="btnAutoCalculatePoints" Grid.Column="1" Padding="5 0 5 0" Height="22" Content="Auto" Click="BtnAutoCalculate_Click"/>
                        </Grid>

                        <TextBlock Text="Achieved Points: " Visibility="Collapsed" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <dxe:TextEdit x:Name="txtAchievedPoints" Grid.Column="1" Visibility="Collapsed" Grid.Row="3" Height="22"  Margin="10 0 5 0"
                                       Mask="n2" MaskType="Numeric" Text="0" MaskUseAsDisplayFormat="True"/>

                        <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="10 0 10 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Target Year: " Padding="0 0 10 0" Grid.Row="7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <dxe:DateEdit x:Name="datTargetYear" Height="22" Grid.Column="1" MaskType="DateTime" PopupFooterButtons="OkCancel"   MaskUseAsDisplayFormat="True" Mask="yyyy">
                                <dxe:DateEdit.StyleSettings>
                                    <dxe:DateEditPickerStyleSettings/>
                                </dxe:DateEdit.StyleSettings>
                            </dxe:DateEdit>

                            <TextBlock Text="Target Month: "  HorizontalAlignment="Right" Grid.Column="2" VerticalAlignment="Center"/>
                            <dxe:DateEdit x:Name="datTargetMonth" Height="22" Grid.Column="3" MaskType="DateTime"  PopupFooterButtons="OkCancel"  MaskUseAsDisplayFormat="True" Mask="MMM">
                                <dxe:DateEdit.StyleSettings>
                                    <dxe:DateEditPickerStyleSettings/>
                                </dxe:DateEdit.StyleSettings>
                            </dxe:DateEdit>
                        </Grid>
                        
                        <TextBlock Text="Step Due Date: " Grid.Row="7" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <dxe:DateEdit x:Name="datStepDueDate" Height="22" Grid.Column="1" Grid.Row="7" Margin="10 0 10 0"/>

                        <TextBlock Text="Updated on: " Grid.Row="8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <dxe:DateEdit x:Name="datUpdatedOn" IsEnabled="False" FontWeight="Bold" Height="22" Grid.Column="1" Grid.Row="8" Margin="10 0 10 0"/>

                        <Grid Grid.Row="9" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                        <dxe:CheckEdit x:Name="chkCompleted" Content="Completed" />
                            <dxe:CheckEdit x:Name="chkClosed" Content="Closed"  Grid.Column="1"/>
                        </Grid>
                        
                    </Grid>
                </dxlc:LayoutGroup>
            </dx:DXTabItem>

            <dx:DXTabItem Header="Sales Rewards" x:Name="tabSalesRewards">
                <dxg:GridControl x:Name="grdSalesRewards" 
                                 Grid.Row="1"
                                 SelectionMode="Cell" 
                                 CustomUnboundColumnData="GrdSalesRewards_CustomUnboundColumnData"
                                 dx:DXSerializer.SerializationID="grid">
                    <dxg:GridControl.View>
                        <dxg:TableView  ShowGroupPanel="False"
                                        NewItemRowPosition="Bottom"
                                        AllowColumnFiltering="False"
                                        ShowTotalSummary="True"
                                        RowAnimationKind="None" 
                                        WaitIndicatorType="Panel"
                                        ShowHorizontalLines="True"
                                        ShowVerticalLines="True"
                                        InitNewRow="View_InitNewRow"
                                        Name="tblViewSalesRewards"
                                        ShowGridMenu="TblViewSalesRewards_ShowGridMenu">
                            <dxg:TableView.RowCellMenuCustomizations>
                                <!--<dxb:BarButtonItem Name="deleteRowItem"
                               Content="Delete"
                               Glyph="{dx:DXImage Image=Cancel_32x32.png}"
                               ItemClick="deleteRowItem_ItemClick" />-->
                                <dxb:BarButtonItem Name="deleteRowItema"
                                                    Content="Delete"
                                                    Glyph="{dx:DXImage Image=Delete_32x32.png}"
                                                    Command="{x:Static dxg:GridCommands.DeleteFocusedRow}" />
                            </dxg:TableView.RowCellMenuCustomizations>
                        </dxg:TableView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn  VisibleIndex="1"
                                     FieldName="user"
                                     Header="Employee"
                                     IsSmart="True"
                                     UnboundType="bound"
                                     UnboundExpression="[userName]" 
                                     SortOrder="Ascending" 
                                     SortIndex="0">
                        <dxg:GridColumn.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RowData.Row.user.userName}"></TextBlock>
                            </ControlTemplate>
                        </dxg:GridColumn.DisplayTemplate>
                        <dxg:GridColumn.EditSettings>
                            <dxg:LookUpEditSettings x:Name="lookupEmployees"
                                      AutoPopulateColumns="False"
                                      IsPopupAutoWidth="False"
                                      DisplayMember="userName"
                                      NullText="Select Item">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                <dxg:GridColumn FieldName="userName" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEditSettings.PopupContentTemplate>
                            </dxg:LookUpEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn  VisibleIndex="1"
                                     FieldName="currency"
                                     Header="Currency"
                                     IsSmart="True"
                                     UnboundType="bound"
                                     UnboundExpression="[CurrencyName]" 
                                     SortOrder="Ascending" 
                                     SortIndex="0">
                        <dxg:GridColumn.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RowData.Row.currency.CurrencyName}"></TextBlock>
                            </ControlTemplate>
                        </dxg:GridColumn.DisplayTemplate>
                        <dxg:GridColumn.EditSettings>
                            <dxg:LookUpEditSettings x:Name="lookupCurrency"
                                      AutoPopulateColumns="False"
                                      IsPopupAutoWidth="False"
                                      DisplayMember="CurrencyName"
                                      NullText="Select Item">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                <dxg:GridColumn FieldName="CurrencyName" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEditSettings.PopupContentTemplate>
                            </dxg:LookUpEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn Header="Reward Amount"
                            FieldName="RewardAmount"
                            IsSmart="True"
                                    AllowEditing="true"
                            Width="auto" VisibleIndex="10" UnboundType="decimal">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                </dxg:GridControl>
            </dx:DXTabItem>

            <dx:DXTabItem Header="Finance Rewards" x:Name="tabFinanceRewards">
                <dxg:GridControl x:Name="grdFinanceRewards" 
                                 Grid.Row="1"
                                 SelectionMode="Cell" 
                                 dx:DXSerializer.SerializationID="grid">
                    <dxg:GridControl.View>
                        <dxg:TableView  ShowGroupPanel="False"
                                        NewItemRowPosition="Bottom"
                                        AllowColumnFiltering="False"
                                        ShowTotalSummary="True"
                                        RowAnimationKind="None" 
                                        WaitIndicatorType="Panel"
                                        ShowHorizontalLines="True"
                                        ShowVerticalLines="True"
                                        InitNewRow="View_InitNewRow"
                                        Name="tblViewFinanceRewards">
                            <dxg:TableView.RowCellMenuCustomizations>
                                <!--<dxb:BarButtonItem Name="deleteRowItem"
                               Content="Delete"
                               Glyph="{dx:DXImage Image=Cancel_32x32.png}"
                               ItemClick="deleteRowItem_ItemClick" />-->
                                <dxb:BarButtonItem Name="deleteRowItema1"
                                                    Content="Delete"
                                                    Glyph="{dx:DXImage Image=Delete_32x32.png}"
                                                    Command="{x:Static dxg:GridCommands.DeleteFocusedRow}" />
                            </dxg:TableView.RowCellMenuCustomizations>
                        </dxg:TableView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn  VisibleIndex="1"
                                     FieldName="user"
                                     Header="Employee"
                                     IsSmart="True"
                                     UnboundType="bound"
                                     UnboundExpression="[userName]" 
                                     SortOrder="Ascending" 
                                     SortIndex="0">
                        <dxg:GridColumn.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RowData.Row.user.userName}"></TextBlock>
                            </ControlTemplate>
                        </dxg:GridColumn.DisplayTemplate>
                        <dxg:GridColumn.EditSettings>
                            <dxg:LookUpEditSettings x:Name="lookupFinanceUsers"
                                      AutoPopulateColumns="False"
                                      IsPopupAutoWidth="False"
                                      DisplayMember="userName"
                                      NullText="Select Item">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                <dxg:GridColumn FieldName="userName" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEditSettings.PopupContentTemplate>
                            </dxg:LookUpEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn  VisibleIndex="1"
                                     FieldName="currency"
                                     Header="Currency"
                                     IsSmart="True"
                                     UnboundType="bound"
                                     UnboundExpression="[CurrencyName]" 
                                     SortOrder="Ascending" 
                                     SortIndex="0">
                        <dxg:GridColumn.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RowData.Row.currency.CurrencyName}"></TextBlock>
                            </ControlTemplate>
                        </dxg:GridColumn.DisplayTemplate>
                        <dxg:GridColumn.EditSettings>
                            <dxg:LookUpEditSettings x:Name="lookupCurrencyForFinance"
                                      AutoPopulateColumns="False"
                                      IsPopupAutoWidth="False"
                                      DisplayMember="CurrencyName"
                                      NullText="Select Item">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                <dxg:GridColumn FieldName="CurrencyName" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEditSettings.PopupContentTemplate>
                            </dxg:LookUpEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn Header="Reward Amount"
                            FieldName="RewardAmount"
                            IsSmart="True"
                                    AllowEditing="true"
                            Width="auto" VisibleIndex="10" UnboundType="decimal">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                </dxg:GridControl>
            </dx:DXTabItem>

            <dx:DXTabItem Header="Other Rewards" x:Name="tabOtherRewards">
                <dxg:GridControl x:Name="grdOtherRewards" 
                                 Grid.Row="1"
                                 SelectionMode="Cell" 
                                 dx:DXSerializer.SerializationID="grid">
                    <dxg:GridControl.View>
                        <dxg:TableView  ShowGroupPanel="False"
                                        NewItemRowPosition="Bottom"
                                        AllowColumnFiltering="False"
                                        ShowTotalSummary="True"
                                        RowAnimationKind="None" 
                                        WaitIndicatorType="Panel"
                                        ShowHorizontalLines="True"
                                        ShowVerticalLines="True"
                                        InitNewRow="View_InitNewRow"
                                        Name="tblViewOtherRewards">
                            <dxg:TableView.RowCellMenuCustomizations>
                                <!--<dxb:BarButtonItem Name="deleteRowItem"
                               Content="Delete"
                               Glyph="{dx:DXImage Image=Cancel_32x32.png}"
                               ItemClick="deleteRowItem_ItemClick" />-->
                                <dxb:BarButtonItem Name="deleteRowItema2"
                                                    Content="Delete"
                                                    Glyph="{dx:DXImage Image=Delete_32x32.png}"
                                                    Command="{x:Static dxg:GridCommands.DeleteFocusedRow}" />
                            </dxg:TableView.RowCellMenuCustomizations>
                        </dxg:TableView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn  VisibleIndex="1"
                                     FieldName="user"
                                     Header="Employee"
                                     IsSmart="True"
                                     UnboundType="bound"
                                     UnboundExpression="[userName]" 
                                     SortOrder="Ascending" 
                                     SortIndex="0">
                        <dxg:GridColumn.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RowData.Row.user.userName}"></TextBlock>
                            </ControlTemplate>
                        </dxg:GridColumn.DisplayTemplate>
                        <dxg:GridColumn.EditSettings>
                            <dxg:LookUpEditSettings x:Name="lookupOtherUsers"
                                      AutoPopulateColumns="False"
                                      IsPopupAutoWidth="False"
                                      DisplayMember="userName"
                                      NullText="Select Item">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                <dxg:GridColumn FieldName="userName" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEditSettings.PopupContentTemplate>
                            </dxg:LookUpEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn  VisibleIndex="1"
                                     FieldName="currency"
                                     Header="Currency"
                                     IsSmart="True"
                                     UnboundType="bound"
                                     UnboundExpression="[CurrencyName]" 
                                     SortOrder="Ascending" 
                                     SortIndex="0">
                        <dxg:GridColumn.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RowData.Row.currency.CurrencyName}"></TextBlock>
                            </ControlTemplate>
                        </dxg:GridColumn.DisplayTemplate>
                        <dxg:GridColumn.EditSettings>
                            <dxg:LookUpEditSettings x:Name="lookupCurrencyForOthers"
                                      AutoPopulateColumns="False"
                                      IsPopupAutoWidth="False"
                                      DisplayMember="CurrencyName"
                                      NullText="Select Item">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                <dxg:GridColumn FieldName="CurrencyName" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEditSettings.PopupContentTemplate>
                            </dxg:LookUpEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn Header="Reward Amount"
                            FieldName="RewardAmount"
                            IsSmart="True"
                                    AllowEditing="true"
                            Width="auto" VisibleIndex="10" UnboundType="decimal">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                </dxg:GridControl>
            </dx:DXTabItem>
        </dx:DXTabControl>
        <dx:SimpleButton x:Name="btnSave" Click="BtnSave_Click" Grid.Row="1" Height="35" Content="Save" FontWeight="DemiBold" VerticalAlignment="Center" />
    </Grid>
</UserControl>
