<UserControl x:Class="ZAS_ERP.ToDoTasks.UserControls.ucMainToDoTaskListItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ToDoTasks.UserControls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="{x:Type dxe:CheckEdit}"
       TargetType="{x:Type dxe:CheckEdit}">
        <Setter Property="Foreground"
          Value="Red" />
    </Style>
    </UserControl.Resources>
    <Border Background="#f2f5f3" BorderBrush="#f2f5f3" CornerRadius="10" Margin="0 0 0 2">
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtId" Visibility="Collapsed"/>
            <dxe:CheckEdit VerticalAlignment="Center" Foreground="Red" x:Name="chkCompleted" Grid.RowSpan="2" IsEnabled="False" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtTaskName" Grid.Column="1" Text="Task" FontSize="20" FontWeight="DemiBold" VerticalAlignment="Center" Margin="0 0 0 0"/>
            <Image Name="imgImportant" Grid.RowSpan="2" Grid.Column="3" VerticalAlignment="Center" Width="20" Height="20" HorizontalAlignment="Center"
                   Source="/ZAS_ERP;component/images/starred.png"
                   MouseUp="ImgImportant_MouseUp"/>

            <TextBlock x:Name="txtPercentage" Foreground="Red" Grid.Row="1" Grid.Column="1"/>
            <TextBlock x:Name="txtStartDate" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
