<UserControl x:Class="ZAS_ERP.ToDoTasks.UserControls.ucUsersList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.ToDoTasks.UserControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="400" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <dxg:GridControl x:Name="grdCntrlUsers" Margin="10 0 10 10"
                         Grid.Row="0"
                                 AutoGenerateColumns="None"
                                 Grid.ColumnSpan="2"
                                 SelectionMode="Row"
                                 AllowInitiallyFocusedRow="False">
            <dxg:GridControl.View>
                <dxg:TreeListView x:Name="gridUsersView"
                                          AutoWidth="True"
                                          KeyFieldName="id"
                                          TreeDerivationMode="Selfreference"
                                          AutoExpandAllNodes="True"
                                          IsSynchronizedWithCurrentItem="True"
                                          AllowEditing="False"
                                          UseIndicatorForSelection="True"
                                          FadeSelectionOnLostFocus="False"
                                          ShowSelectionRectangle="True"       
                                          ShowAutoFilterRow="True">
                </dxg:TreeListView>
            </dxg:GridControl.View>

            <dxg:GridColumn FieldName="id"
                                    x:Name="colId"
                                    IsSmart="True"
                                    Visible="False"/>

            <dxg:GridColumn x:Name="coluserName"
                                    FieldName="userName"
                                    Header="User"
                                    IsSmart="True"/>
        </dxg:GridControl>

        <Button x:Name="btnSave" Grid.Row="1" Content="Save" Click="BtnSave_Click"/>
    </Grid>
</UserControl>
