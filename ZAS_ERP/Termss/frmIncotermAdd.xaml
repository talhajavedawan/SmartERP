<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ZAS_ERP.Productss"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        x:Class="ZAS_ERP.Termss.frmIncotermAdd"
             mc:Ignorable="d"
             Height="180"
             Width="350" Title="Incoterm" x:Name="winIncotermAdd" 
        Loaded="winIncotermAdd_Loaded" Closing="winIncotermAdd_Closing">
  <Grid Margin="0,20,0,0">
    <Grid.Resources>
      <Style TargetType="{x:Type Label}">
        <Setter Property="Margin"
                Value="10,10" />
        <Setter Property="Foreground"
                Value="Gray" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
      </Style>
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Margin"
                Value="10,0" />
        <Setter Property="MaxWidth"
                Value="350" />
      </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width=" auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height=" auto" />
      <RowDefinition Height=" auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height=" 50" />
    </Grid.RowDefinitions>
    <Label Content="Incoterm"
           ToolTip="Incoterm"
           HorizontalAlignment="Right" />
    <Label Content="isActive"
           ToolTip="Unselect to make it inActive"
           HorizontalAlignment="Right"
           Grid.Row="1" />
    <TextBox x:Name="txtIncoterm"
             Grid.Column="1"  VerticalAlignment="Center"/>
    
      <CheckBox x:Name="chkisactive"
                Margin="10,0"
                IsChecked="True"
                Grid.Column="1"
                Grid.Row="1" />
     
    
    
    <Button Grid.ColumnSpan="2"
            Grid.Row="3"
            Content="Save"
            FontSize="26"
            x:Name="btnIncotermSave"
            Click="btnIncotermSave_Click" />

  </Grid>
</Window>
