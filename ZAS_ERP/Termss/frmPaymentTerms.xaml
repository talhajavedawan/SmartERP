      <Grid Grid.Column="1"
            Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <dxlc:GroupBox Header="Payment Term Details"
                       Background="White"
                       Margin="5">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="1*" />
              
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="40" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Label Content="Terms"
                   ToolTip="Terms"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right" />
            <Label Content="Type"
                   ToolTip="Payment term type"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Grid.Row="1" />
            <!--textblock for displaying data in colunm 2 of grid from stored company data -->
            <TextBox x:Name="txtterm"
                     VerticalAlignment="Center"
                     Grid.Column="1"
                     Margin="20,0" />
            <StackPanel Grid.Row="1"
                        Grid.Column="1" Orientation="Horizontal">
              <RadioButton x:Name="rbtnStandard" Checked="rbtnStandard_Checked" Content="Standard"
                           Margin="20,0"></RadioButton>
              <RadioButton x:Name="rbtnDatebased"
                           Content="Date Based"
                           Checked="rbtnDatebased_Checked" Margin="10,0"></RadioButton>
            </StackPanel>
            <Label Content="Is Active"
                   ToolTip="Check if is Active"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Grid.Row="2" />
            <!--textblock for displaying data in colunm 2 of grid from stored company data -->
            <CheckBox x:Name="chkIsActive"
                     Grid.Row="2"
                     VerticalAlignment="Center"
                     Grid.Column="1" IsChecked="True"
                     Margin="20,0" />
            <dxlc:GroupBox 
                           Background="White"
                           Margin="5"
                           Grid.Row="3" Grid.ColumnSpan="2"
                           TitleVisibility="Hidden">
              <Grid >
                <Grid.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment"
                            Value="Center" />
                    <Setter Property="HorizontalAlignment"
                            Value="Left" />
                    
                    <Setter Property="Margin"
                            Value="0,5" />
                  </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                  <!--<ColumnDefinition Width="auto" />-->
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="auto" />
                  <RowDefinition Height="auto" />
                  <RowDefinition Height="auto" />
                  <RowDefinition Height="auto" />
                 
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock VerticalAlignment="Center" x:Name="lblnetdue1" Text="Net due in"></TextBlock>
                  <TextBox x:Name="txtnetdue" Text="0" Width="70" Margin="10,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="lblnetdue2"
                             VerticalAlignment="Center"
                             Text=" Days"></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="2">
                  <TextBlock VerticalAlignment="Center"
                             x:Name="lbldiscPercent1"
                             Text="Discount Percentage is "></TextBlock>
                  <TextBox x:Name="txtdiscountPercent"
                           Width="70"
                           Margin="10,0"
                           Text="0"
                           VerticalAlignment="Center" />
                  <!--<TextBlock x:Name="lbldiscPercent2"
                             VerticalAlignment="Center"
                             Text=" Days"></TextBlock>-->
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Grid.Row="3">
                  <TextBlock VerticalAlignment="Center"
                             x:Name="lbldiscdays1"
                             Text="Discount if paid within"></TextBlock>
                  <TextBox x:Name="txtDiscDays"
                           Width="70"
                           Margin="10,0"
                           Text="0"
                           VerticalAlignment="Center" />
                  <TextBlock x:Name="lbldiscdays2"
                             VerticalAlignment="Center"
                             Text=" Days."></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Grid.Row="1" x:Name="stpanelduemindays">
                  <TextBlock VerticalAlignment="Center"
                             x:Name="lblduewithin1"
                             Text="Due next Month if Issued within"></TextBlock>
                  <TextBox x:Name="txtMinDueDays"
                           Width="70" Text="0"
                           Margin="10,0"
                           VerticalAlignment="Center" />
                  <TextBlock x:Name="lblduewithin2"
                             VerticalAlignment="Center"
                             Text=" Days"></TextBlock>
                </StackPanel>
                
              </Grid>
            </dxlc:GroupBox>
            <!--<Label Content="Country"
                   ToolTip="Country"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Grid.Row="3" />
            --><!--textblock for displaying data in colunm 2 of grid from stored company data --><!--
            <TextBox x:Name="txtCountry"
                     VerticalAlignment="Center"
                     Grid.Column="1"
                     Grid.Row="3"
                     Margin="20,0" />-->
            <Button Grid.Column="1"
                    Grid.Row="4"
                    Margin="20,10"
                    Content="Save"
                    x:Name="btnsave"
                    Click="btnsave_Click" />
          </Grid>
        </dxlc:GroupBox>
      </Grid>
    </Grid>
  </Grid>
</Window>
