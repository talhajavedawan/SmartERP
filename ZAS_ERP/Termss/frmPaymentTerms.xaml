<Window x:Class="ZAS_ERP.Termss.frmPaymentTerms"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Termss"
        mc:Ignorable="d"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        utilities:WindowUtilities.CloseOnEscape="True"
        Title="frmPaymentTerms" Height="450" Width="800">
  <Grid>
   
      <Grid.Resources>
        <Style TargetType="Label">
          <Setter Property="VerticalAlignment"
                  Value="Center" />
          <Setter Property="HorizontalAlignment"
                  Value="Left" />
          <Setter Property="Foreground"
                  Value="DarkGray" />
          <Setter Property="Margin"
                  Value="10,10" />
        </Style>
        
      
    </Grid.Resources>
      <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="1*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <!--<RowDefinition Height=".1*" />-->
      <RowDefinition Height="1.4*" />
    </Grid.RowDefinitions>
    <!--<dx:DXDockPanel 
                      Grid.Column="0">
        <dx:DropDownButton HorizontalAlignment="Right"
                           MinWidth="210" />
        <dx:SimpleButton Content="GO"
                         HorizontalAlignment="Right" />
      </dx:DXDockPanel>-->
    <dxg:GridControl x:Name="grdPaymentTerms"
                     AutoGenerateColumns="AddNew"
                     Grid.Row="1"
                     SelectionMode="Row"></dxg:GridControl>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
