<Window xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  x:Class="ZAS_ERP.frmWarrantyList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        mc:Ignorable="d"
        Title="Warranty Panel"
        x:Name="winWarranty"
        Loaded="winWarranty_Loaded"
        Unloaded="WinWarranty_Unloaded"
        Height="450"
        Width="450">
  <Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <!--<ColumnDefinition Width="1*" />-->
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="1.4*" />
      </Grid.RowDefinitions>
      <Menu DockPanel.Dock="Top"
            x:Name="menuFormList"
            Grid.ColumnSpan="3">
        <MenuItem Header="_Warranty"
                  x:Name="mbtnWarranty">
          <MenuItem Header="Add new Warranty"
                    x:Name="mbtnNewWarranty"
                    Click="mbtnNewWarranty_Click"></MenuItem>
          <MenuItem Header="Edit Warranty"
                    x:Name="mbtnEditWarranty"
                    Click="mbtnEditWarranty_Click"></MenuItem>
        </MenuItem>
      </Menu>
      <dxg:GridControl x:Name="grdWarranty"
                       AutoGenerateColumns="AddNew"
                       Grid.Row="1"
                      
                       SelectionMode="Row">
        <dxg:GridControl.View>
        <dxg:TableView AllowEditing="False" FadeSelectionOnLostFocus="False"></dxg:TableView>
        </dxg:GridControl.View>
        <dxg:GridControl.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Add New "
                    x:Name="btnNew"
                    Click="mbtnNewWarranty_Click" />
            <MenuItem Header="Edit "
                    x:Name="btnEdit"
                    Click="mbtnEditWarranty_Click" />
          <!--<Separator />
            <MenuItem Header="Delete Offer Status"
                      x:Name="btnDeleteOfferStatus" />-->
        </ContextMenu>
        </dxg:GridControl.ContextMenu>
      </dxg:GridControl>
