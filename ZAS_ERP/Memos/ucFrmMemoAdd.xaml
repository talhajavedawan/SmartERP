<UserControl x:Class="ZAS_ERP.Memos.ucFrmMemoAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Memos" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <dx:DXTabControl>
            <dx:DXTabItem Header="Memo">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Memo Type" VerticalAlignment="Center" Grid.Row="0" HorizontalAlignment="Right" Margin="0 0 10 0"/>
                    <dxe:ComboBoxEdit x:Name="cmbxMemoType" IsEnabled="False" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Creation Date" VerticalAlignment="Center" Grid.Row="1" HorizontalAlignment="Right" Margin="0 0 10 0"/>
                    <dxe:DateEdit x:Name="datCreationDate" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Text="Subject of Memo" VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Right" Margin="0 0 10 0"/>
                    <dxe:TextEdit x:Name="txtMemoTopic" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Text="Created By" VerticalAlignment="Center" Grid.Row="3" HorizontalAlignment="Right" Margin="0 0 10 0"/>
                    <dxg:LookUpEdit x:Name="lookupCreatedBy" 
                                    IsReadOnly="True" 
                                    VerticalAlignment="Center"         
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0 2 0 0"
                                    DisplayMember="employee.person.FullName"
                                    
                                    AutoPopulateColumns="False">

                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate>
                                <Grid>
                                    <dxg:GridControl Name="PART_GridControl" SelectionMode="Row" AutoGenerateColumns="None">
                                        <dxg:GridControl.View>
                                            <dxg:TableView Name="treeViewAssignedToUsers"/>
                                        </dxg:GridControl.View>

                                        <dxg:GridColumn  Width="auto" FieldName="employee.person.Photo" Header="Photo" >
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ImageEditSettings MaxWidth="35"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>

                                        <dxg:GridColumn
                                    FieldName="employee.person.FullName" VisibleIndex="2"
                                    Header="Name"
                                    IsSmart="True"
                                        Visible="True"
                                        ShowInColumnChooser="False"/>

                                        <dxg:GridColumn
                                    FieldName="employee.isTaskType" VisibleIndex="2"
                                    Header="Task Type"
                                    IsSmart="True"
                                        Visible="False"
                                        ShowInColumnChooser="False"/>

                                        <dxg:GridColumn FieldName="UserType"
                                                    Header="User Type"
                                                    IsSmart="True"
                                                    VisibleIndex="2"
                                                    UnboundType="String" UnboundExpression="Iif([employee.isTaskType] = True, 'Alien', 'Normal')"/>
                                    </dxg:GridControl>
                                </Grid>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>

                    <Grid Grid.Row="4" x:Name="grdCreatedFor" Visibility="Visible" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Created For" VerticalAlignment="Center" Grid.Row="4" HorizontalAlignment="Right" Margin="0 0 10 0"/>
                        <dxg:LookUpEdit x:Name="lookupCreatedFor" 
                                    VerticalAlignment="Center" 
                                    Grid.Row="4" 
                                    Grid.Column="1"
                                    DisplayMember="employee.person.FullName"
                                    
                                    AutoPopulateColumns="False">

                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <dxg:GridControl Name="PART_GridControl" SelectionMode="Row" AutoGenerateColumns="None">
                                            <dxg:GridControl.View>
                                                <dxg:TableView Name="treeViewAssignedToUsers"/>
                                            </dxg:GridControl.View>

                                            <dxg:GridColumn  Width="auto" FieldName="employee.person.Photo" Header="Photo" >
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:ImageEditSettings MaxWidth="35"/>
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>

                                            <dxg:GridColumn
                                    FieldName="employee.person.FullName" VisibleIndex="2"
                                    Header="Name"
                                    IsSmart="True"
                                        Visible="True"
                                        ShowInColumnChooser="False"/>

                                            <dxg:GridColumn
                                    FieldName="employee.isTaskType" VisibleIndex="2"
                                    Header="Task Type"
                                    IsSmart="True"
                                        Visible="False"
                                        ShowInColumnChooser="False"/>
                                            
                                            

                                            <dxg:GridColumn FieldName="UserType"
                                                    Header="User Type"
                                                    IsSmart="True"
                                                    VisibleIndex="2"
                                                    UnboundType="String" UnboundExpression="Iif([employee.isTaskType] = True, 'Alien', 'Normal')"/>

                                            <dxg:GridColumn
                                    FieldName="employee.person.FName" VisibleIndex="2"
                                    Header="First Name"
                                    IsSmart="True"
                                        Visible="True"
                                        ShowInColumnChooser="False"/>
                                            <dxg:GridColumn
                                    FieldName="employee.person.LName" VisibleIndex="2"
                                    Header="Last Name"
                                    IsSmart="True"
                                        Visible="True"
                                        ShowInColumnChooser="False"/>
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>
                    </Grid>

                    <Grid Grid.Row="4" x:Name="grdMemoGroup" Visibility="Collapsed" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Memo Group" VerticalAlignment="Center" Grid.Row="3"/>
                        <dxg:LookUpEdit x:Name="lookupMemoGroup" 
                                        DisplayMember="GroupName" 
                                        VerticalAlignment="Center" 
                                        Grid.Row="3" 
                                        Grid.Column="1"
                                        AutoPopulateColumns="False">
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <dxg:GridControl Name="PART_GridControl" SelectionMode="Row" AutoGenerateColumns="None">
                                        <dxg:GridControl.View>
                                            <dxg:TreeListView KeyFieldName="Id" ParentFieldName="parentId"/>
                                        </dxg:GridControl.View>
                                        <dxg:GridColumn Header="GroupName"
                                                        FieldName="GroupName"
                                                        AllowEditing="false"/>

                                    </dxg:GridControl>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>

                            <dxg:LookUpEdit.StyleSettings>
                                <dxg:MultiSelectLookUpEditStyleSettings />
                            </dxg:LookUpEdit.StyleSettings>
                        </dxg:LookUpEdit>
                    </Grid>

                    <Grid Grid.Row="5" x:Name="grdCCusers" Visibility="Visible" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CC" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 10 0" Grid.Row="6"/>
                        <dxe:ComboBoxEdit VerticalAlignment="Center"
                                          x:Name="cmbCCUsers"
                                          Grid.Column="1" 
                                          Visibility="Visible"
                                          Grid.Row="6" 
                                          AutoComplete="True" 
                                          IncrementalSearch="True" 
                                          ImmediatePopup="True"
                                          DisplayMember="userName"
                                          TabIndex="2">
                            <dxe:ComboBoxEdit.StyleSettings>
                                <dxe:TokenComboBoxStyleSettings />
                            </dxe:ComboBoxEdit.StyleSettings>
                            <dxe:ComboBoxEdit.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel  Orientation="Horizontal">
                                        <TextBlock Text="{Binding id}"
                             Visibility="Hidden" />
                                        <TextBlock Text="{Binding userName}"></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </dxe:ComboBoxEdit.ItemTemplate>
                        </dxe:ComboBoxEdit>
                    </Grid>

                    <dx:SimpleButton Grid.Row="6" Grid.ColumnSpan="2" Margin="20 0 20 0" FontWeight="Bold" x:Name="btnPerformanceReview" Click="btnPerformanceReview_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/ZAS_ERP;component/images/performance.png" Width="25" Height="25" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Create Performance Review" VerticalAlignment="Center"/>
                        </StackPanel>
                    </dx:SimpleButton>

                </Grid>
            </dx:DXTabItem>
        </dx:DXTabControl>

        <dx:SimpleButton x:Name="btnSave" Click="btnSave_Click" Grid.Row="1" Content="Save" FontWeight="Bold"/>
    </Grid>
</UserControl>
