<Window x:Class="ZAS_ERP.Memos.PerformanceReview.StageSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Memos.PerformanceReview"
        mc:Ignorable="d"
        Title="StageSelectionDialog" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Please select a stage:" Margin="0,0,0,10" FontWeight="Bold"/>
        <ComboBox x:Name="cmbStages" SelectedItem="{Binding SelectedStage}" DisplayMemberPath="."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Width="70" Margin="5" Click="BtnOK_Click"/>
            <Button Content="Cancel" Width="70" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
