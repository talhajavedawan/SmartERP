<Window x:Class="ZAS_ERP.Memos.PerformanceReview.PerformanceReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Memos.PerformanceReview" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        mc:Ignorable="d"
        Title="PerformanceReviewWindow" Height="750" Width="800" Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <dx:DXTabControl>
            <dx:DXTabItem>
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/ZAS_ERP;component/images/performance.png" Width="18" Height="18"  Margin="0,0,5,0"/>
                        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="Performance Review Details" FontWeight="DemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Grid>
                    <Grid x:Name="grdComments" Grid.Row="0"  Visibility="Collapsed"  Width="450" Background="Gray" Panel.ZIndex="5" VerticalAlignment="Stretch" Margin="50" HorizontalAlignment="Right" >
                        <dxg:GridControl AutoExpandAllGroups="True" Height="auto" MinHeight="500" VerticalAlignment="Stretch" Grid.Row="1"  dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">
                            <!--#region Columns-->
                            <dxg:GridControl.Columns>


                                <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                                <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                                <dxg:GridColumn Width="Auto" FieldName="Subject" />
                                <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                                <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                                <dxg:GridColumn
                            Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Descending" />
                            </dxg:GridControl.Columns>
                            <!--#endregion-->
                            <dxg:GridControl.View>
                                <dxg:TableView 
                            x:Name="GrdCommenttableView" AllowEditing="False" DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                                    DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0" RowStyle="{StaticResource RowStyle}" ShowSearchPanelMode="Always" SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" ShowIndicator="False" ShowVerticalLines="False"
                            CompactPanelShowMode="Always" SwitchToCompactModeWidth="700"
                             NavigationStyle="Row"
                           >

                                    <dxg:TableView.FormatConditions>
                                        <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                        <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Changed')">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                        <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task Approved')">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                        <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task UnApproved')">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                        <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task Voided')">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Background="Orange" />

                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                        <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task UnVoided')">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Background="Orange" />

                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                    </dxg:TableView.FormatConditions>
                                    <!--#region CompactModeFilterItems-->
                                    <!--<dxg:TableView.CompactModeFilterItems>
                            <dxg:CompactModeFilterItem DisplayValue="All" />
                            <dxg:CompactModeFilterItem DisplayValue="Read" EditValue="[isRead] = True" />
                            <dxg:CompactModeFilterItem DisplayValue="Unread" EditValue="[isRead] = False" />

                        </dxg:TableView.CompactModeFilterItems>-->
                                    <!--#endregion-->

                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>

                    </Grid>

                    <Grid x:Name="grdHiddenComments" Grid.Row="0"  Visibility="Collapsed"  Width="450" Background="Gray" Panel.ZIndex="5" VerticalAlignment="Stretch" Margin="50" HorizontalAlignment="Left" >
                        <dxg:GridControl AutoExpandAllGroups="True" Height="auto" MinHeight="500" VerticalAlignment="Stretch" Grid.Row="1"  dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdHiddenCommentss">
                            <!--#region Columns-->
                            <dxg:GridControl.Columns>


                                <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                                <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                                <dxg:GridColumn Width="Auto" FieldName="Subject" />
                                <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                                <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                                <dxg:GridColumn
                            Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Descending" />
                            </dxg:GridControl.Columns>
                            <!--#endregion-->
                            <dxg:GridControl.View>
                                <dxg:TableView 
                            x:Name="GrdHiddenCommenttableView" AllowEditing="False" DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                                    DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0" RowStyle="{StaticResource RowStyle}" ShowSearchPanelMode="Always" SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" ShowIndicator="False" ShowVerticalLines="False"
                            CompactPanelShowMode="Always" SwitchToCompactModeWidth="700"
                             NavigationStyle="Row"
                           >

                                    <dxg:TableView.FormatConditions>
                                        <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                        <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Changed')">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                        <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task Approved')">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                        <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task UnApproved')">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                        <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task Voided')">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Background="Orange" />

                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                        <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Task UnVoided')">
                                            <dxg:FormatCondition.Format>
                                                <dxg:Format FontWeight="Bold" Background="Orange" />

                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>

                                    </dxg:TableView.FormatConditions>
                                    <!--#region CompactModeFilterItems-->
                                    <!--<dxg:TableView.CompactModeFilterItems>
                            <dxg:CompactModeFilterItem DisplayValue="All" />
                            <dxg:CompactModeFilterItem DisplayValue="Read" EditValue="[isRead] = True" />
                            <dxg:CompactModeFilterItem DisplayValue="Unread" EditValue="[isRead] = False" />

                        </dxg:TableView.CompactModeFilterItems>-->
                                    <!--#endregion-->

                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>

                    </Grid>

                    <StackPanel Grid.Row="0"  Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Right"   dx:ThemeManager.ThemeName="None"
                                            Grid.Column="0" Orientation="Horizontal" Margin="0 5 15 0">
                        <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="btnInfo_Click">
                            <Image Source="/ZAS_ERP;component/images/log.png"></Image>
                        </Button>

                        <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" ToolTip="Add New Comment" Click="btnAddComment_Click">
                            <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
                        </Button>

                        <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2"  ToolTip="CommentLog" Click="btnCommentLog_Click" dx:ThemeManager.ThemeName="None">
                            <Image Source="/ZAS_ERP;component/images/comments.png" ></Image>
                        </Button>

                        <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnSetVoid" Visibility="Visible" Click="btnSetVoid_Click" Grid.Column="2" ToolTip="360 View">
                            <Image  Source="/ZAS_ERP;component/images/void_order.png" ></Image>
                        </Button>


                        <!--<dx:SimpleButton Style="{StaticResource Simplebutton}"   Grid.Column="5" x:Name="mbtnPerformanceReview" Click="mbtnPerformanceReview_Click" Foreground="Black">
                            <StackPanel Orientation="Horizontal">
                                
                                <TextBlock Text="Performance Review" Margin="0 0 0 0" Foreground="Black" />

                            </StackPanel>
                        </dx:SimpleButton>-->

                    </StackPanel>

                    <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">

                        <RadioButton x:Name="radioSelf" Checked="RadioButton_Checked" Content="Self" GroupName="OptionsGroup" Margin="5"/>
                        <RadioButton x:Name="radioLevelOne" Checked="RadioButton_Checked" Content="Level One" GroupName="OptionsGroup" Margin="5"/>
                        <RadioButton x:Name="radioLevelTwo" Checked="RadioButton_Checked" Content="Level Two" GroupName="OptionsGroup" Margin="5"/>

                    </StackPanel>

                    <StackPanel Grid.Row="0"  Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Left"   dx:ThemeManager.ThemeName="None"
                                            Grid.Column="0" Orientation="Horizontal" Margin="0 5 15 0">
                        

                        <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddHiddenComment" Visibility="Collapsed" Grid.Column="2" ToolTip="Add Hidden Comment" Click="btnHiddenAddComment_Click">
                            <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
                        </Button>

                        <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnHiddenCommentLog" Visibility="Collapsed" Grid.Column="2"  ToolTip="Hiddend Communication" Click="btnHiddenCommentLog_Click" dx:ThemeManager.ThemeName="None">
                            <Image Source="/ZAS_ERP;component/images/comments.png" ></Image>
                        </Button>


                        <!--<dx:SimpleButton Style="{StaticResource Simplebutton}"   Grid.Column="5" x:Name="mbtnPerformanceReview" Click="mbtnPerformanceReview_Click" Foreground="Black">
                            <StackPanel Orientation="Horizontal">
                                
                                <TextBlock Text="Performance Review" Margin="0 0 0 0" Foreground="Black" />

                            </StackPanel>
                        </dx:SimpleButton>-->

                    </StackPanel>

                    <Grid Margin="10 40 10 10" x:Name="MainFormGrid" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>



                        <Grid Background="DeepSkyBlue">
                            <TextBlock Text="PERFORMANCE REVIEW" Padding="10" Foreground="White" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                        </Grid>

                        <!-- Top Form -->
                        <Grid Grid.Row="1" Margin="0 10 0 0">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Text="Joining Date " Grid.Column="2" Grid.Row="0" TextAlignment="Right" Margin="0,0,0,0" VerticalAlignment="Center"/>
                            <dxe:DateEdit x:Name="datJoiningDate"  Grid.Column="3" Grid.Row="0"
                          Margin="0,0,10,0"
                          NullText="Joining Date"
                                          Height="22"
                          IsEnabled="False"
                          FontWeight="Bold"/>


                            <TextBlock Text="Tenure :" Grid.Column="4" Grid.Row="0" TextAlignment="Right" Margin="0,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="-" x:Name="txtTenure"  Grid.Column="5" Grid.Row="0" TextAlignment="Center" Margin="10,0,0,0" Padding="5" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="18"/>

                            <TextBlock Text="Stage " Grid.RowSpan="2" Grid.Column="0" Grid.Row="0" TextAlignment="Right" Margin="0,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Background="LightYellow" Text="Stage" x:Name="txtStage" Grid.RowSpan="2" Grid.Column="1" Grid.Row="0" TextAlignment="Center" Margin="0,0,0,0" Padding="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="18"/>

                            <TextBlock Text="Creation Date " Grid.Column="2" Grid.Row="1" TextAlignment="Right" Margin="0,0,0,0" VerticalAlignment="Center"/>
                            <dxe:DateEdit x:Name="datCreationDate"  Grid.Column="3" Grid.Row="1"
                          Margin="0,0,10,0"
                          NullText="Creation Date"
                                          Height="22"
                          IsEnabled="False"
                          FontWeight="Bold"/>

                            <TextBlock Text="Year  " Grid.Column="4" Grid.Row="1" TextAlignment="Right" Margin="0,10,0,0" VerticalAlignment="Center"/>
                            <dxe:DateEdit x:Name="datYear" 
                          Margin="0,10,10,0"
                          FontWeight="Bold"
                          MaskUseAsDisplayFormat="True" 
                          Mask="yyyy" 
                          ShowClearButton="True" 
                          UseLayoutRounding="True" 
                          PopupFooterButtons="OkCancel" 
                          Grid.Column="5" 
                          Grid.Row="1"
                          NullText="Year"
                          VerticalAlignment="Center"
                          IsEnabled="False">
                                <dxe:DateEdit.StyleSettings>
                                    <dxe:DateEditPickerStyleSettings/>
                                </dxe:DateEdit.StyleSettings>
                            </dxe:DateEdit>

                            <TextBlock Text="Employee  " Grid.Column="0" Grid.Row="2" Margin="0,10,0,0" TextAlignment="Right" VerticalAlignment="Center"/>
                            <dxg:LookUpEdit x:Name="lookupEmployee" Grid.Column="1" Grid.Row="2" Margin="0,10,10,0" DisplayMember="userName" NullText="Select Employee"
                            AutoPopulateColumns="False"
                            SelectedIndexChanged="lookupEmployee_SelectedIndexChanged">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <dxg:GridControl Name="PART_GridControl" SelectionMode="Row">
                                            <dxg:GridControl.View>
                                                <dxg:TableView AutoWidth="True"/>
                                            </dxg:GridControl.View>

                                            <dxg:GridColumn Header="User Name"
                                FieldName="userName"
                                AllowEditing="False"/>
                                        </dxg:GridControl>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>

                            <TextBlock Text="Department  " Grid.Column="2" Grid.Row="2" TextAlignment="Right" Margin="0,10,0,0" VerticalAlignment="Center"/>
                            <dxe:TextEdit x:Name="txtDepartment" Grid.Column="3" Grid.Row="2" Margin="0,10,10,0" NullText="Department" IsReadOnly="True"/>

                            <TextBlock Text="Position  " Grid.Column="4" Grid.Row="2" TextAlignment="Right" Margin="0,10,0,0" VerticalAlignment="Center"/>
                            <dxe:TextEdit x:Name="txtPosition" Grid.Column="5" Grid.Row="2" Margin="0,10,0,0" NullText="Position" IsReadOnly="True"/>

                            <Grid Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="6" x:Name="gridSupervisorLevel1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Supervisor (L1) " Grid.Column="0" Grid.Row="2" Margin="0,10,0,0" TextAlignment="Right" VerticalAlignment="Center"/>
                                <dxg:LookUpEdit x:Name="lookupSupervisor" Grid.Column="1" Grid.Row="2" Margin="0,10,10,0" DisplayMember="userName" NullText="Supervisor"
                            AutoPopulateColumns="False" SelectedIndexChanged="lookupSupervisor_SelectedIndexChanged">
                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl" SelectionMode="Row">
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="True"  />
                                                </dxg:GridControl.View>

                                                <dxg:GridColumn Header="User Name"
                                FieldName="userName"
                                AllowEditing="False"/>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>
                                </dxg:LookUpEdit>

                                <TextBlock Text="Department  " Grid.Column="2" Grid.Row="2" TextAlignment="Right" Margin="0,10,0,0" VerticalAlignment="Center"/>
                                <dxe:TextEdit x:Name="txtSupervisorDepartment" Grid.Column="3" Grid.Row="2" Margin="0,10,10,0" NullText="Department" IsReadOnly="True"/>

                                <TextBlock Text="Position  " Grid.Column="4" Grid.Row="2" TextAlignment="Right" Margin="0,10,0,0" VerticalAlignment="Center"/>
                                <dxe:TextEdit x:Name="txtSupervisorPosition" Grid.Column="5" Grid.Row="2" Margin="0,10,0,0" NullText="Position" IsReadOnly="True"/>

                            </Grid>

                            <Grid Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="6" x:Name="gridSupervisorLevel2">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Supervisor (L2) " Grid.Column="0" Grid.Row="3" Margin="0,10,0,0" TextAlignment="Right" VerticalAlignment="Center"/>
                                <dxg:LookUpEdit x:Name="lookupSupervisorLevel2" Grid.Column="1" Grid.Row="3" Margin="0,10,10,0" DisplayMember="userName" NullText="Supervisor"
                            AutoPopulateColumns="False" SelectedIndexChanged="lookupSupervisorLevel2_SelectedIndexChanged">
                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl" SelectionMode="Row">
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="True"  />
                                                </dxg:GridControl.View>

                                                <dxg:GridColumn Header="User Name"
                                FieldName="userName"
                                AllowEditing="False"/>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>
                                </dxg:LookUpEdit>

                                <TextBlock Text="Department  " Grid.Column="2" Grid.Row="3" TextAlignment="Right" Margin="0,10,0,0" VerticalAlignment="Center"/>
                                <dxe:TextEdit x:Name="txtSupervisorLevel2Dept" Grid.Column="3" Grid.Row="3" Margin="0,10,10,0" NullText="Department" IsReadOnly="True"/>

                                <TextBlock Text="Position  " Grid.Column="4" Grid.Row="3" TextAlignment="Right" Margin="0,10,0,0" VerticalAlignment="Center"/>
                                <dxe:TextEdit x:Name="txtSupervisorLevel2Position" Grid.Column="5" Grid.Row="3" Margin="0,10,0,0" NullText="Position" IsReadOnly="True"/>
                            </Grid>


                            <TextBlock Text="Admin  " Grid.Column="0" Grid.Row="5" Margin="0,10,0,0" TextAlignment="Right" VerticalAlignment="Center"/>
                            <dxg:LookUpEdit x:Name="lookupAdmin" Grid.Column="1" Grid.Row="5"
                AutoPopulateColumns="False"
                Margin="0,10,10,0"
                DisplayMember="userName"
                NullText="Admin">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <dxg:GridControl Name="PART_GridControl" SelectionMode="Row">
                                            <dxg:GridControl.View>
                                                <dxg:TableView AutoWidth="True" />
                                            </dxg:GridControl.View>

                                            <dxg:GridColumn Header="User Name"
                                FieldName="userName"
                                AllowEditing="False"/>
                                        </dxg:GridControl>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>


                            <TextBlock Text="Management " Grid.Column="2" Grid.Row="5" Margin="0,10,0,0" TextAlignment="Right" VerticalAlignment="Center"/>
                            <dxg:LookUpEdit x:Name="lookupManagement" Grid.Column="3" Grid.Row="5" Margin="0,10,10,0" DisplayMember="userName" NullText="Management"
                            AutoPopulateColumns="False">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <dxg:GridControl Name="PART_GridControl" SelectionMode="Row">
                                            <dxg:GridControl.View>
                                                <dxg:TableView AutoWidth="True"  />
                                            </dxg:GridControl.View>

                                            <dxg:GridColumn Header="User Name"
                                FieldName="userName"
                                AllowEditing="False"/>
                                        </dxg:GridControl>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>

                            <dxe:CheckEdit x:Name="chkLock" Content="Lock for Employee" Grid.Column="5" Grid.Row="5" VerticalAlignment="Center" Margin="0 10 0 0"
                           Checked="chkLock_Checked" Unchecked="chkLock_Unchecked"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <!-- Indicator Ratings Grid -->
                            <dxg:GridControl x:Name="gridRatings"
                         Grid.Row="2"
                         Margin="0 10 0 0">
                                <dxg:GridControl.View>
                                    <dxg:TableView Name="tableViewRatings"
                               CellValueChanged="tableViewRatings_CellValueChanged"
                               ShowTotalSummary="True"
                               ShowGroupPanel="False"/>
                                </dxg:GridControl.View>

                                <dxg:GridColumn Header="Indicator" VisibleIndex="0" FieldName="IndicatorDefinition.Name" AllowSorting="false" Binding="{Binding IndicatorDefinition.Name}" AllowMoving="false" AllowEditing="false"/>
                                <dxg:GridColumn Header="Self" VisibleIndex="1" FieldName="SelfRating" AllowMoving="false" AllowSorting="false" AllowEditing="true"/>
                                <dxg:GridColumn Header="Supervisor (L1)" VisibleIndex="2" FieldName="SupervisorLevelOneRating" AllowMoving="false" AllowSorting="false" AllowEditing="true"/>
                                <dxg:GridColumn Header="Supervisor (L2)" VisibleIndex="3" FieldName="SupervisorLevelTwoRating" AllowMoving="false" AllowSorting="false" AllowEditing="true"/>
                                <dxg:GridColumn Header="Admin" VisibleIndex="4" FieldName="AdminRating" AllowMoving="false" AllowSorting="false" AllowEditing="true"/>
                                <dxg:GridColumn Header="Management" VisibleIndex="5" FieldName="ManagementRating" AllowMoving="false" AllowSorting="false" AllowEditing="true"/>
                                <dxg:GridColumn Header="Weightage" VisibleIndex="6" FieldName="IndicatorDefinition.Weightage" AllowMoving="false" AllowSorting="false" AllowEditing="false"/>
                                <dxg:GridColumn Header="Cooment" VisibleIndex="6" FieldName="IndicatorDefinition.Cooment" AllowMoving="false" AllowSorting="false" AllowEditing="true"/>

                                <dxg:GridControl.TotalSummary>

                                    <dxg:GridSummaryItem FieldName="SelfRating" SummaryType="Sum" DisplayFormat="n"/>
                                    <dxg:GridSummaryItem FieldName="SupervisorLevelOneRating" SummaryType="Sum" DisplayFormat="n"/>
                                    <dxg:GridSummaryItem FieldName="SupervisorLevelTwoRating" SummaryType="Sum" DisplayFormat="n"/>
                                    <dxg:GridSummaryItem FieldName="AdminRating" SummaryType="Sum" DisplayFormat="n"/>
                                    <dxg:GridSummaryItem FieldName="ManagementRating" SummaryType="Sum" DisplayFormat="n"/>
                                    <dxg:GridSummaryItem FieldName="IndicatorDefinition.Weightage" SummaryType="Sum" DisplayFormat="n"/>
                                </dxg:GridControl.TotalSummary>

                            </dxg:GridControl>

                            <Grid Grid.Column="1" HorizontalAlignment="Center">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Border Height="100" Width="100" CornerRadius="10" BorderBrush="DeepSkyBlue" BorderThickness="1">
                                        <Border.Background>
                                            <ImageBrush  x:Name="UserImage" ImageSource="/ZAS_ERP;component/images/users-vector-icon-png_260862.jpg"/>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtName" Grid.Row="1" FontWeight="Bold" Margin="5 0 0 0" FontSize="20" VerticalAlignment="Center" TextAlignment="Left"/>
                                        <TextBlock x:Name="txtDesignation" Grid.Row="1" Margin="5 0 0 0" FontSize="16" VerticalAlignment="Center" TextAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Vertical" Grid.Row="3" Margin="0 15 0 0">
                                    <TextBlock Text="Self Score"  FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtSelfPercentage" FontWeight="Bold" FontSize="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Vertical" Grid.Row="4">
                                    <TextBlock Text="Supervisor (L1) Score" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtSupervisorPercentage" FontWeight="Bold" FontSize="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Vertical" Grid.Row="5">
                                    <TextBlock Text="Supervisor (L2) Score" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtSupervisorLevel2Percentage" FontWeight="Bold" FontSize="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Vertical" Grid.Row="6">
                                    <TextBlock Text="Admin Score" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtAdminPercentage" FontWeight="Bold" FontSize="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Vertical" Grid.Row="7">
                                    <TextBlock Text="Management Score" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtManagementPercentage" FontWeight="Bold" FontSize="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                            </Grid>

                        </Grid>

                        
                    </Grid>
                </Grid>
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="tabUsers" >

                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{dx:DXImage Image=User_16x16.png}" Width="18" Height="18"  Margin="0,0,5,0"/>
                        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="Hidden Communication Users" FontWeight="DemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Border Grid.Row="1" Padding="1" BorderBrush="DeepSkyBlue" BorderThickness="2" CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0"  Grid.Column="0">
                            <TextBlock  Text="CC User List" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="DemiBold" Background="Beige" FontSize="14"/>

                        </Grid>

                        <Grid Grid.Row="0"   Grid.Column="2">
                            <TextBlock  Text="Selected User" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="DemiBold" Background="Beige" FontSize="14"/>

                        </Grid>


                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="337*"/>
                                <ColumnDefinition Width="99*"/>
                            </Grid.ColumnDefinitions>
                            <dxg:GridControl x:Name="grdCntrlUsers" Margin="8"
                                 AutoGenerateColumns="None"
                                 SelectionMode="Row"
                                 AllowInitiallyFocusedRow="False" Grid.ColumnSpan="2">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="gridUsersView"
                                          AutoWidth="True"
                                          ShowGroupPanel="False"
                                          IsSynchronizedWithCurrentItem="True"
                                          AllowEditing="False"
                                          UseIndicatorForSelection="True"
                                          FadeSelectionOnLostFocus="False"
                                          ShowSelectionRectangle="True"       
                                          ShowAutoFilterRow="True"
                                          ShowIndicator="False" >
                                    </dxg:TableView>
                                </dxg:GridControl.View>

                                <dxg:GridColumn FieldName="id"
                                    x:Name="colId"
                                    IsSmart="True"
                                    Visible="False"/>

                                <dxg:GridColumn VisibleIndex="0" Width="auto" FieldName="employee.person.Photo" Header="Photo" >
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ImageEditSettings MaxWidth="40"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>

                                <dxg:GridColumn x:Name="coluserName"
                                    FieldName="userName" VisibleIndex="1"
                                    Header="User"
                                    IsSmart="True"/>

                                <dxg:GridColumn
                                    FieldName="employee.isTaskType" VisibleIndex="2"
                                    Header="Task Type"
                                    IsSmart="True"
                                        Visible="False"
                                        ShowInColumnChooser="False"/>

                                <dxg:GridColumn FieldName="UserType"
                                                    Header="User Type"
                                                    IsSmart="True"
                                                    VisibleIndex="2"
                                                    UnboundType="String" UnboundExpression="Iif([employee.isTaskType] = True, 'Alien', 'Normal')"/>
                            </dxg:GridControl>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Image Source="/ZAS_ERP;component/images/Forward_32x32.png" Grid.Row="1"  x:Name="imgLeftToRight" MouseDown="imgLeftToRight_MouseDown" Width="32" Height="32"  MouseUp="imgLeftToRight_MouseUp" Margin="10,0,10,0"/>
                            <Image Source="/ZAS_ERP;component/images/Backward_32x32.png" MouseDown="btnLeftMoveCustomer_MouseDown" MouseUp="btnLeftMoveCustomer_MouseUp"  Grid.Row="2" Name="imgRightToLeft"  Height="32" Width="32"  Margin="10,0,10,0"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="2">
                            <dxg:GridControl x:Name="grdCntrlUsersSelected" Margin="8"
                                 AutoGenerateColumns="None"
                                 SelectionMode="Row"
                                 AllowInitiallyFocusedRow="False">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="gridUsersViewSelected"
                                          AutoWidth="True"
                                          ShowGroupPanel="False"
                                          IsSynchronizedWithCurrentItem="True"
                                          AllowEditing="False"
                                          
                                          UseIndicatorForSelection="True"
                                          FadeSelectionOnLostFocus="False"
                                          ShowSelectionRectangle="True"       
                                          ShowAutoFilterRow="True"
                                          ShowIndicator="False" >
                                    </dxg:TableView>
                                </dxg:GridControl.View>

                                <dxg:GridColumn FieldName="id"
                                    x:Name="colIds"
                                    IsSmart="True"
                                    Visible="False"/>

                                <dxg:GridColumn VisibleIndex="0" Width="auto" FieldName="employee.person.Photo" Header="Photo" >
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ImageEditSettings MaxWidth="40"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>

                                <dxg:GridColumn x:Name="coluserNameSelected"
                                    FieldName="userName" VisibleIndex="1"
                                    Header="User"
                                    IsSmart="True"/>

                                <dxg:GridColumn
                                    FieldName="employee.isTaskType" VisibleIndex="2"
                                    Header="Task Type"
                                    IsSmart="True"
                                        Visible="False"
                                        ShowInColumnChooser="False"/>

                                <dxg:GridColumn FieldName="UserType"
                                                    Header="User Type"
                                                    IsSmart="True"
                                                    VisibleIndex="2"
                                                    UnboundType="String" UnboundExpression="Iif([employee.isTaskType] = True, 'Alien', 'Normal')"/>
                            </dxg:GridControl>
                        </Grid>

                    </Grid>
                </Border>
            </dx:DXTabItem>
        </dx:DXTabControl>

        <Button Content="Save Review" 
                Grid.Row="1" 
                Height="40" 
                VerticalAlignment="Bottom"
                Click="BtnSaveReview_Click" 
                Margin="0,5,0,0"/>
    </Grid>
</Window>
