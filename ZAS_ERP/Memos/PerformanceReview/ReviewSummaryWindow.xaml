<Window x:Class="ZAS_ERP.Memos.PerformanceReview.ReviewSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Memos.PerformanceReview" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        mc:Ignorable="d"
        Title="ReviewSummaryWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Performance Review Summary"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontWeight="Bold" 
                   FontSize="20" 
                   Padding="15 5 15 5"
                   Background="LightYellow"
                   Margin="5"/>

        <!-- Summary Grid -->
        <dxg:GridControl x:Name="grdCntrlSummary" 
                         Grid.Row="1">

            <dxg:GridControl.View>
                <dxg:TableView Name="tableViewRatings"
                               RowAnimationKind="None"
                    
                        ShowAutoFilterRow="True"
                        ShowTotalSummary="True"
                        WaitIndicatorType="Panel"
                               AllowEditing="False"
                        AllowPerPixelScrolling="True"/>
            </dxg:GridControl.View>

            <dxg:GridColumn x:Name="colCreationDate"
                      FieldName="Review.CreationDate"
                      Header="Creation Date"
                      UnboundType="Bound"
                            AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="0">
                <dxg:GridColumn.EditSettings>
                    <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn x:Name="colYear"
                      FieldName="Review.PerformanceYear"
                      Header="Performance Year"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="3" 
                            AllowEditing="false">
                <dxg:GridColumn.EditSettings>
                    <dxe:DateEditSettings MaskUseAsDisplayFormat="True" Mask="yyyy" />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Indicator" VisibleIndex="0" FieldName="IndicatorDefinition.Name"  AllowEditing="false"/>
            
            <dxg:GridColumn Header="Employee" VisibleIndex="0" FieldName="Review.Employee.employee.person.FullName" AllowEditing="false"/>
            <dxg:GridColumn Header="Supervisor (L1)" VisibleIndex="0" FieldName="Review.SupervisorLevelOne.employee.person.FullName" AllowEditing="false"/>
            <dxg:GridColumn Header="Supervisor (L2)" VisibleIndex="0" FieldName="Review.SupervisorLevelTwo.employee.person.FullName" AllowEditing="false"/>
            <dxg:GridColumn Header="Admin" VisibleIndex="0" FieldName="Review.Admin.employee.person.FullName" AllowEditing="false"/>
            <dxg:GridColumn Header="Management" VisibleIndex="0" FieldName="Review.Management.employee.person.FullName" AllowEditing="false"/>

            <dxg:GridColumn Header="Self Rating" VisibleIndex="1" FieldName="SelfRating" AllowEditing="false"/>
            <dxg:GridColumn Header="Supervisor (L1) Rating" VisibleIndex="2" FieldName="SupervisorLevelOneRating" AllowEditing="false"/>
            <dxg:GridColumn Header="Supervisor (L2) Rating" VisibleIndex="3" FieldName="SupervisorLevelTwoRating" AllowEditing="false"/>
            <dxg:GridColumn Header="Admin Rating" VisibleIndex="4" FieldName="AdminRating" AllowEditing="false"/>
            <dxg:GridColumn Header="Management Rating" VisibleIndex="5" FieldName="ManagementRating" AllowEditing="false"/>
            <dxg:GridColumn Header="Weightage" VisibleIndex="6" FieldName="IndicatorDefinition.Weightage" AllowEditing="false"/>

        </dxg:GridControl>
    </Grid>
</Window>
