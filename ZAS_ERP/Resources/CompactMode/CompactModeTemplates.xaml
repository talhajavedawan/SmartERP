
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
    xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
    xmlns:dxei="http://schemas.devexpress.com/winfx/2008/xaml/editors/internal"
    xmlns:local="clr-namespace:ZAS_ERP">

    <Style x:Key="HightlightTextBox" TargetType="TextBlock">
        <Setter Property="dxei:TextBlockService.EnableTextHighlighting" Value="True" />
        <Setter Property="dxei:TextBlockService.HighlightedTextCriteria" Value="Contains" />
        <!--<Setter Property="dxei:TextBlockService.HighlightText" Value="{Binding Path=View.SearchString}" />-->
        <!--<Setter Property="dxei:TextBlockService.HighlightTextAppearance">
            <Setter.Value>
                <dxe:HighligterAppearance />
            </Setter.Value>
        </Setter>-->
    </Style>
    <Style x:Key="HightlightTextBoxEmail" TargetType="TextBlock">
        <Setter Property="dxei:TextBlockService.EnableTextHighlighting" Value="True" />
        <Setter Property="dxei:TextBlockService.HighlightedTextCriteria" Value="Contains" />
        <!--<Setter Property="dxei:TextBlockService.HighlightText" Value="{Binding Path=View.SearchString}" />-->
        <!--<Setter Property="dxei:TextBlockService.HighlightTextAppearance">
            <Setter.Value>
                <dxe:HighligterAppearance />
            </Setter.Value>
        </Setter>-->
    </Style>
    <Style x:Key="ImageGlyphStyle" TargetType="Image">
        <Setter Property="Margin" Value="2,0,2,0" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Opacity" Value="0.7" />
        <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="FrameworkElement" x:Key="VisibleAnimation">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
            <Trigger Property="Visibility" Value="Visible">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubjectTextBoxStyle" TargetType="TextBlock" BasedOn="{StaticResource HightlightTextBox}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Row.IsUnread}" Value="True">
                <Setter Property="Foreground" Value="#FF0072C6" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SubjectTextBoxStyleEmail" TargetType="TextBlock" BasedOn="{StaticResource HightlightTextBox}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Row.IsUnread}" Value="True">
                <Setter Property="Foreground" Value="#FF0072C6" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="NotificationRowTemplate">
        
        <ContentControl>
            <Grid Margin="0,1,20,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Border                    Grid.RowSpan="3" Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Left"
                    Visibility="{Binding Row.IsRead, Converter={dx:BooleanToVisibilityConverter}}"
                    Background="#FF0072C6" />

                <!--<TextBlock Grid.Column="1" Grid.ColumnSpan="1" Margin="0,12,0,0" Text="{Binding Row.User.userName}" TextTrimming="CharacterEllipsis" FontSize="18" Style="{StaticResource HightlightTextBox}"
                           Foreground="{dxi:ThemeResource {dxgt:GridControlThemeKey ResourceKey=Foreground}}" FontWeight="Normal"
                           />-->
                <TextBlock
                    x:Name="tbSubject"
                    Grid.Column="1" Grid.Row="0" Margin="0,0,0,0" VerticalAlignment="Center" TextWrapping="WrapWithOverflow" Style="{StaticResource SubjectTextBoxStyle}"
                    FontSize="16" Text="{Binding Row.Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource HightlightTextBox}" TextWrapping="WrapWithOverflow"
                    Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Margin="0,0,0,12" VerticalAlignment="Center" FontWeight="Normal"
                    FontSize="12" Text="{Binding Row.Description}" TextTrimming="CharacterEllipsis" Foreground="#FF747474" >
                </TextBlock>
                <StackPanel
                    x:Name="GlyphPanel" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                    Margin="0,7,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Style="{StaticResource VisibleAnimation}">
                        <StackPanel.Visibility>
                            <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=dxg:RowControl}">
                                <Binding.Converter>
                                    <dx:BoolToVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </StackPanel.Visibility>
                        <Button Command="local:CustomCommands.MarkReadUnread" >
                            <Image Source="/ZAS_ERP;component/images/Mail/Unread_Glyph.png" Style="{StaticResource ImageGlyphStyle}" >
                                <ToolTipService.ToolTip>
                                    <Binding Path="Row.isRead">
                                        <Binding.Converter>
                                            <dx:BoolToObjectConverter TrueValue="Mark as Unread" FalseValue="Mark as Read" />
                                        </Binding.Converter>
                                    </Binding>
                                </ToolTipService.ToolTip>
                            </Image>
                        </Button>
                        <!--<Image Source="/ZAS_ERP;component/images/Mail/Edit.png" Style="{StaticResource ImageGlyphStyle}" >
                            <ToolTipService.ToolTip>
                                <TextBlock Text="Edit" />
                            </ToolTipService.ToolTip>
                        </Image>
                        <Image Source="/ZAS_ERP;component/images/Mail/Delete.png" Style="{StaticResource ImageGlyphStyle}" >
                            <ToolTipService.ToolTip>
                                <TextBlock Text="Delete" />
                            </ToolTipService.ToolTip>
                        </Image>-->
                    </StackPanel>
                    <TextBlock
                    Margin="0,2,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="2" Grid.Row="1"
                    FontSize="14" Text="{Binding Row.Timestamp, StringFormat=g}" Style="{StaticResource SubjectTextBoxStyle}"/>
                    <!--<Image Source="/ZAS_ERP;component/images/Mail/Attachment.png" Stretch="None" Visibility="{Binding Row.Attachment, Converter={dx:BooleanToVisibilityConverter}}" >
                        <ToolTipService.ToolTip>
                            <TextBlock Text="Has Attachment" />
                        </ToolTipService.ToolTip>
                    </Image>
                    <Image Stretch="None">
                        <Image.Source>
                            <Binding Path="Row.Priority">
                                <Binding.Converter>
                                    <dxmvvm:ObjectToObjectConverter>
                                        <dxmvvm:MapItem Source="2" Target="/ZAS_ERP;component/images/Mail/High.png" />
                                    </dxmvvm:ObjectToObjectConverter>
                                </Binding.Converter>
                            </Binding>
                        </Image.Source>
                        <ToolTipService.ToolTip>
                            <Binding Path="Row.Priority">
                                <Binding.Converter>
                                    <dxmvvm:ObjectToObjectConverter>
                                        <dxmvvm:MapItem Source="2" Target="High Priority" />
                                    </dxmvvm:ObjectToObjectConverter>
                                </Binding.Converter>
                            </Binding>
                        </ToolTipService.ToolTip>
                    </Image>-->
                </StackPanel>
                <TextBlock Visibility="Collapsed"
                    Margin="0,2,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="2" Grid.Row="1"
                    FontSize="14" Text="{Binding Row.Timestamp, StringFormat=d}" Style="{StaticResource SubjectTextBoxStyle}"/>
                <StackPanel  Grid.Column="1" Grid.Row="3" Orientation="Horizontal">
                    <TextBlock  Text="{Binding Row.PoReferenceNo}" Margin="5" TextTrimming="CharacterEllipsis" FontSize="14" Style="{StaticResource SubjectTextBoxStyle}"
                            FontWeight="Normal"
                           />
                    <TextBlock  Text="{Binding Row.BillReferenceNo}" Margin="5" TextTrimming="CharacterEllipsis" FontSize="14" Style="{StaticResource SubjectTextBoxStyle}"
                          FontWeight="Normal"
                           />
                </StackPanel>
            </Grid>
        </ContentControl>
    </DataTemplate>
    <DataTemplate x:Key="CommentRowTemplate">
       
        <ContentControl>
            <Grid Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>


                <StackPanel x:Name="flag" Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,0" Orientation="Horizontal">
                    <Polygon Points="0,0 25,12, 0,25" Width="35" Margin="5" Stroke="{Binding Row.notificationFlag.backcolor}" Fill="{Binding Row.notificationFlag.backcolor}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Row.notificationFlag.Flag}" Margin="5"  FontSize="20" Foreground="Black" FontWeight="DemiBold" />
                </StackPanel>

                <StackPanel x:Name="resend" 
                     Grid.Row="7" Grid.Column="2"
                    Margin="0,5,0,5" HorizontalAlignment="Right" Orientation="Horizontal">

                    <StackPanel Orientation="Horizontal" >
                        <Button Command="local:CustomCommands.ChangeFlag" ToolTip="Change Flag">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Change Flag" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>


                <StackPanel x:Name="image" Grid.Column="1" Grid.ColumnSpan="1" Margin="-5,-8" Orientation="Horizontal">
                    
                    <dxe:ImageEdit Stretch="Fill" ShowMenu="False" Width="80" Height="80" Margin="5,10,0,0" Source="{Binding Row.employee.person.Photo}"/>


                </StackPanel>
                <Border
                    Grid.RowSpan="6" Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Left"
                    
                    Background="#FF0072A0" />
                <StackPanel x:Name="name" Grid.Column="1" Grid.ColumnSpan="2" Margin="80,0,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Row.employee.person.FName}" Margin="5" TextTrimming="CharacterEllipsis" FontSize="14" Style="{StaticResource SubjectTextBoxStyle}"
                           Foreground="Black" FontWeight="DemiBold" TextDecorations="underline"
                           />
                    <TextBlock Text="{Binding Row.employee.person.LName}" Margin="5" TextTrimming="CharacterEllipsis" FontSize="14" Style="{StaticResource SubjectTextBoxStyle}"
                           Foreground="Black" FontWeight="DemiBold" TextDecorations="underline"
                           />
                   
                </StackPanel>

               


                <StackPanel x:Name="replyandTimestamp" 
                     Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                    Margin="0,5,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    
                    <StackPanel Orientation="Horizontal" Style="{StaticResource VisibleAnimation}">
                        <StackPanel.Visibility>
                            <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=dxg:RowControl}">
                                <Binding.Converter>
                                    <dx:BoolToVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </StackPanel.Visibility>
                        <Button Command="local:CustomCommands.ReplytoComment" >
                            <Image Source="/ZAS_ERP;component/images/Mail/Unread_Glyph.png" MaxHeight="20" Style="{StaticResource ImageGlyphStyle}" >
                                <ToolTipService.ToolTip>
                                    Reply
                                </ToolTipService.ToolTip>
                            </Image>
                        </Button>
                    </StackPanel>
                    <TextBlock
                    Margin="2,2,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="2" Grid.Row="1"
                    FontSize="14" Text="{Binding Row.Timestamp, StringFormat=dd-MMM-yyyy HH:mm:ss}" Style="{StaticResource SubjectTextBoxStyle}"/>

                </StackPanel>


                <Expander Header="Reply" Grid.Row="1" Grid.Column="1" Visibility="{Binding Row.ReplyComment, Converter={dx:NullableToVisibilityConverter}}">
                    <Grid x:Name="replyComment" Grid.Row="1" Grid.Column="1" Margin="2,2,0,2" Panel.ZIndex="-3" Background="AliceBlue" Visibility="{Binding Row.ReplyComment, Converter={dx:NullableToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Border
                    Grid.RowSpan="3" Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Left"
                                        Background="#3edb1a" />
                        <StackPanel Grid.Column="1" Grid.ColumnSpan="1" Margin="0,2,0,0" Orientation="Horizontal">
                            <TextBlock Text="{Binding Row.ReplyComment.employee.person.FName}"  TextTrimming="CharacterEllipsis" FontSize="16" Style="{StaticResource HightlightTextBox}"
                           Foreground="{dxi:ThemeResource {dxgt:GridControlThemeKey ResourceKey=Foreground}}" FontWeight="Normal"
                           />
                            <TextBlock Text="{Binding Row.ReplyComment.employee.person.LName}"  TextTrimming="CharacterEllipsis" FontSize="16" Style="{StaticResource HightlightTextBox}"
                           Foreground="{dxi:ThemeResource {dxgt:GridControlThemeKey ResourceKey=Foreground}}" FontWeight="Normal"
                           />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HightlightTextBox}"  TextWrapping="WrapWithOverflow" 
                    Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Margin="0,0,0,5" VerticalAlignment="Center" FontWeight="Normal"
                    FontSize="12" Text="{Binding Row.ReplyComment.Comment}" TextTrimming="CharacterEllipsis" Foreground="#FF747474" >
                        </TextBlock>
                    </Grid>
                </Expander>
                <Grid x:Name="CategoreeandAsginee" Grid.Row="2" Grid.Column="1"  Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource HightlightTextBox}"
                    Grid.Column="0" Margin="2,0" VerticalAlignment="Center" FontWeight="Normal"
                    FontSize="12" Text="Category :"  Foreground="#FF747474" >
                    </TextBlock>
                    <TextBlock Style="{StaticResource HightlightTextBox}"
                    Grid.Column="1" Margin="2,0" VerticalAlignment="Center" FontWeight="Normal"
                    FontSize="12" Text="{Binding Row.Category.category}" TextTrimming="CharacterEllipsis" Foreground="#FF747474" >
                    </TextBlock>
                    <TextBlock Style="{StaticResource HightlightTextBox}"
                    Grid.Column="2" VerticalAlignment="Center" FontWeight="Normal"
                    FontSize="12" Text="Assignee :" TextTrimming="CharacterEllipsis" Foreground="#FF747474" >
                    </TextBlock>
                                        <StackPanel Grid.Column="3" Grid.ColumnSpan="1" Margin="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding Row.Assignee.person.FName}" Margin="5" TextTrimming="CharacterEllipsis" FontSize="12" Style="{StaticResource HightlightTextBox}"
                           Foreground="{dxi:ThemeResource {dxgt:GridControlThemeKey ResourceKey=Foreground}}" FontWeight="Normal"
                           />
                        <TextBlock Text="{Binding Row.Assignee.person.LName}" Margin="0,5" TextTrimming="CharacterEllipsis" FontSize="12" Style="{StaticResource HightlightTextBox}"
                           Foreground="{dxi:ThemeResource {dxgt:GridControlThemeKey ResourceKey=Foreground}}" FontWeight="Normal"
                           />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1" Grid.Row="3" Margin="0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                     VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="1"
                    FontSize="12" Text="Subject :" Style="{StaticResource SubjectTextBoxStyle}"/>
                    <TextBlock
                     VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1" Grid.Row="1" Margin="10,0"
                    FontSize="12" Text="{Binding Row.Subject}" Style="{StaticResource SubjectTextBoxStyle}"/>
                </Grid>
                <!--<Border
                    Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4" Width="auto"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    
                    Background="LightGray" >-->
                    <TextBlock
                    x:Name="tbComment" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4" Background="AliceBlue"
                     Margin="0,12,0,12" VerticalAlignment="Center" TextWrapping="WrapWithOverflow" FontWeight="Normal"
                    FontSize="12" Text="{Binding Row.Comment}" Foreground="Black"  />
                <!--</Border>-->


                <Grid Grid.Row="5" Grid.Column="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />

                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource HightlightTextBox}"
                    Grid.ColumnSpan="1" Grid.Row="0" Margin="0,0,0,2" VerticalAlignment="Center" FontWeight="Normal"
                    FontSize="12" Text="Tagged :" TextTrimming="CharacterEllipsis" Foreground="#FF747474" >
                    </TextBlock>
                    <ItemsControl  Grid.Column="1" ItemsSource="{Binding Row.TaggedList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding userName}" Padding="5,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel></WrapPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource HightlightTextBox}"
                    Grid.Column="0" Grid.ColumnSpan="1" Grid.Row="1" Margin="0,0,0,2" VerticalAlignment="Center" FontWeight="Normal"
                    FontSize="12" Text="CC :" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="#FF747474" >
                    </TextBlock>
                    <ItemsControl Grid.Column="1" Grid.Row="1" ItemsSource="{Binding Row.CCUsersList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding userName}" Padding="5,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel></WrapPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
                <StackPanel  Grid.Column="1" Grid.Row="6" Orientation="Horizontal">

                    <TextBlock  Text="{Binding Row.poSystemRef}" Margin="5" TextTrimming="CharacterEllipsis" Foreground="#FF747474" FontSize="14" Style="{StaticResource HightlightTextBox}"
                            FontWeight="Normal"
                           />
                    <TextBlock  Text="{Binding Row.billSystemRef}" Margin="5" TextTrimming="CharacterEllipsis" Foreground="#FF747474" FontSize="14" Style="{StaticResource HightlightTextBox}"
                          FontWeight="Normal"
                           />
                </StackPanel>
            </Grid>
        </ContentControl>
    </DataTemplate>

    <ControlTemplate x:Key="{dxgt:GridRowThemeKey ResourceKey=RowDetailsTemplate, IsThemeIndependent=True}" TargetType="dxg:RowDetailsControl">
        <dx:DataContentPresenter x:Name="Content" />
    </ControlTemplate>

    <DataTemplate x:Key="DetailRowTemplate">
        <TextBlock
            Style="{StaticResource HightlightTextBox}" Margin="65,0,0,6" VerticalAlignment="Center"
                    FontSize="12" Text="{Binding Row.Description}" FontWeight="Normal" TextTrimming="CharacterEllipsis" Foreground="#FF747474" />
    </DataTemplate>

    <Style x:Key="RowStyle" TargetType="dxg:RowControl">
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="dxg:TableView.IsFocusedRow" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=BorderSelectedBrush}}" />
            </MultiTrigger>
            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=BorderFocusedBrush}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="AttachmentCellTemplate">
        <Image
            Margin="4,0,4,0" HorizontalAlignment="Left" VerticalAlignment="Center" Source="/ZAS_ERP;component/Images/Mail/Attachment.png"
            Stretch="None" Visibility="{Binding Value, Converter={dx:BooleanToVisibilityConverter}}">
            <ToolTipService.ToolTip>
                <TextBlock Text="Has Attachment" />
            </ToolTipService.ToolTip>
        </Image>
    </DataTemplate>

    <DataTemplate x:Key="PriorityCellTemplate">
        <Image Margin="4,0,4,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="None">
            <Image.Source>
                <Binding Path="Value">
                    <Binding.Converter>
                        <dxmvvm:ObjectToObjectConverter>
                            <dxmvvm:MapItem Source="2" Target="/ZAS_ERP;component/Images/Mail/High.png" />
                        </dxmvvm:ObjectToObjectConverter>
                    </Binding.Converter>
                </Binding>
            </Image.Source>
            <ToolTipService.ToolTip>
                <Binding Path="Value">
                    <Binding.Converter>
                        <dxmvvm:ObjectToObjectConverter>
                            <dxmvvm:MapItem Source="2" Target="High Priority" />
                        </dxmvvm:ObjectToObjectConverter>
                    </Binding.Converter>
                </Binding>
            </ToolTipService.ToolTip>
        </Image>
    </DataTemplate>

    <Style x:Key="{dxgt:TableViewThemeKey ResourceKey=CompactPanelOrderStyle, IsThemeIndependent=true}" TargetType="TextBlock">
        <Setter Property="Text">
            <Setter.Value>
                <MultiBinding>
                    <Binding Path="FieldName" />
                    <Binding Path="SortOrder" />
                    <MultiBinding.Converter>
                        <local:OrderNameConverter />
                    </MultiBinding.Converter>
                </MultiBinding>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="PriorityGroupValueTemplate">
        <TextBlock >
            <TextBlock.Text>
                <Binding Path="RowData.Row.Priority">
                    <Binding.Converter>
                        <local:PriorityGroupValueConverter />
                    </Binding.Converter>
                </Binding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="AttachmentGroupValueTemplate">
        <TextBlock >
            <TextBlock.Text>
                <Binding Path="RowData.Row.Attachment">
                    <Binding.Converter>
                        <local:AttachmentGroupValueConverter />
                    </Binding.Converter>
                </Binding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>

    <Style x:Key="Office365Style" TargetType="dxg:TableView">
        <Setter Property="Header" Value="Inbox" />
        <Setter Property="HeaderPosition" Value="CompactPanel" />
        <Setter Property="CompactFilterElementShowMode" Value="ContextMenuWithSorting" />
        <Setter Property="CompactSortElementShowMode" Value="Never" />
    </Style>

    <Style x:Key="Outlook2016Style" TargetType="dxg:TableView">
        <Setter Property="Header" Value="{x:Null}" />
        <Setter Property="CompactFilterElementShowMode" Value="List" />
        <Setter Property="CompactSortElementShowMode" Value="CompactMode" />
    </Style>


    <DataTemplate x:Key="CommentRowTemplateEmail">

        <ContentControl>
            <Grid Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="emialdetail" Grid.Row="2" Grid.Column="1"  Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" /> 
                        
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="1" Style="{StaticResource HightlightTextBoxEmail}" Grid.Column="0"  HorizontalAlignment="Left" FontWeight="Normal" FontSize="12" Text="From :"   ></TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1"  VerticalAlignment="Top" FontWeight="Normal" FontSize="12" Margin="10,0" Text="{Binding Row.From}"  TextTrimming="CharacterEllipsis"  ></TextBlock>
                    <TextBlock Grid.Row="1" Style="{StaticResource HightlightTextBoxEmail}" Grid.Column="2" VerticalAlignment="Center" FontWeight="Normal" FontSize="12" Text="To :" TextTrimming="CharacterEllipsis"  ></TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Row.To}" Margin="5" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Normal" />
                    <TextBlock Grid.Row="0" Style="{StaticResource SubjectTextBoxStyle}" Grid.Column="2" VerticalAlignment="Center" FontWeight="Normal" FontSize="12" Text="Received :" TextTrimming="CharacterEllipsis"  ></TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Row.Date}" Margin="5" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Normal" />
                </Grid>
                <Grid Grid.Column="1" Grid.Row="3" Margin="0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="1" FontSize="12" Text="Subject :" Style="{StaticResource SubjectTextBoxStyle}"/>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1" Grid.Row="1" Margin="10,0" FontSize="12" Text="{Binding Row.Subject}" Style="{StaticResource SubjectTextBoxStyle}"/>
                </Grid>
            </Grid>
        </ContentControl>
    </DataTemplate>
    <Style x:Key="RowStyleEmail" TargetType="dxg:RowControl">
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="dxg:TableView.IsFocusedRow" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=BorderSelectedBrush}}" />
            </MultiTrigger>
            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=BorderFocusedBrush}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


</ResourceDictionary>