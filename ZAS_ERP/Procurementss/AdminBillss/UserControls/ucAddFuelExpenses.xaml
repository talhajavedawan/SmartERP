<dx:DXWindow x:Class="ZAS_ERP.Procurementss.AdminBillss.UserControls.ucAddFuelExpenses"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.AdminBillss.UserControls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             xmlns:loc="clr-namespace:ZAS_ERP"
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded"
             Closing="DXWindow_Closing">
    <Grid>

        <Grid x:Name="grdAttachments"   Width="300" Visibility="Collapsed" Background="Gray" Panel.ZIndex="5" VerticalAlignment="Top" Margin="110,40,65,35" HorizontalAlignment="Left">
            <TreeView x:Name="treeViewAttachments" >
                <TreeView.Resources>
                    <HierarchicalDataTemplate  DataType="{x:Type loc:TreeItem}" ItemsSource="{Binding Items}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding name}"
                         Grid.Column="0"
                         
                         HorizontalAlignment="Stretch" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text=" [" Foreground="Blue" />
                                <TextBlock Text="{Binding Items.Count}" Foreground="Blue" />
                                <TextBlock Text="]" Foreground="Blue" />
                            </StackPanel>
                        </Grid>
                    </HierarchicalDataTemplate>
                    <DataTemplate  DataType="{x:Type loc:cmbitem}" >
                        <StackPanel>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />

                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />

                                </Grid.ColumnDefinitions>
                                <!--<CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>-->
                                <TextBlock Text="{Binding id}"
                         Visibility="Collapsed" />
                                <TextBlock Text="{Binding description}"
                         Visibility="Collapsed" />
                                <Button Content="Open" Margin="5,0" x:Name="btnDownloadAttachment" Click="BtnDownloadAttachment_Click" Foreground="Blue"  Tag="{Binding description}"></Button>

                                <TextBlock Text="   "
                         Background="{Binding bcolor}"
                         Width="20"
                         Margin="0,0,5,0" Grid.Column="1"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" >
                                    <TextBlock Text="{Binding name}"
                         Grid.Column="1"
                         
                         HorizontalAlignment="Stretch" />

                                    <!--<TextBlock Text=" [" Foreground="Blue" />-->
                                    <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                                    <!--<TextBlock Text="]" Foreground="Blue" />-->
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                    <!--<HierarchicalDataTemplate DataType="{x:Type self:cmbitem}"  >
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />

                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="1*" />
                                                    
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>
                                                <TextBlock Text="{Binding id}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="{Binding description}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="   "
                         Background="{Binding bcolor}"
                         Width="20"
                         Margin="0,0,5,0" Grid.Column="1"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding name}"
                         Grid.Column="1"
                         
                         HorizontalAlignment="Stretch" />
                                                
                                                    <TextBlock Text=" [" Foreground="Blue" />
                                                    <TextBlock Text="{Binding fcolor}" Foreground="Blue" />
                                                    <TextBlock Text="]" Foreground="Blue" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>-->
                </TreeView.Resources>
            </TreeView>
        </Grid>

        <Grid x:Name="grdAttach1"   Width="250" Visibility="Collapsed"  Background="White"  Panel.ZIndex="5" VerticalAlignment="Top" Margin="50,40,65,35" HorizontalAlignment="Left">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />

                    <ColumnDefinition Width="1*" />

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Category"
                         Margin="5,0,5,0" 
                           Grid.Column="0"/>

                <ComboBox x:Name="cmbCategory1"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                      Margin="5,5"
                      Grid.Row="0"
                      TabIndex="0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                                <TextBlock Text="{Binding name}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>


                <!--<TextBlock Text=" [" Foreground="Blue" />-->
                <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.ColumnSpan="2" Content="Select file" Margin="5" x:Name="btnAttachment1" Click="BtnAttachment1_Click" Foreground="Blue"  Tag="{Binding description}"></Button>
                <!--<TextBlock Text="]" Foreground="Blue" />-->

            </Grid>

        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>

                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                <dx:SimpleButton ToolTip="History" x:Name="btnHistory" Click="BtnHistory_Click" Margin="5 5 0 0" Height="32" Width="32" Padding="0">
                    <Image Source="{dx:DXImage Image=HistoryItem_32x32.png}" Height="28" Width="28"/>
                </dx:SimpleButton>

                <dx:SimpleButton x:Name="btnAttachNew1" Height="32" Width="32" Margin="5,5,5,0" Grid.Column="3" ToolTip="Attach document" Click="BtnAttachNew1_Click" dx:ThemeManager.ThemeName="None" Padding="0">
                    <Image x:Name="imgAttachNew1"  Source="/ZAS_ERP;component/images/clipattachment.png"></Image>
                </dx:SimpleButton>

                <dx:SimpleButton x:Name="btnAttachmentList" Width="32" Height="32" Margin="0,5,5,0" Grid.Column="3" ToolTip="Info" Click="BtnAttachmentList_Click" dx:ThemeManager.ThemeName="None" Padding="0">
                    <Image Source="/ZAS_ERP;component/images/ListAttachment.png"/>
                </dx:SimpleButton>
            </StackPanel>

            <TextBlock x:Name="lblHeadingMaintenance" Text="Vehicle Fuel Expense" FontSize="15" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="0" FontFamily="Segoe UI Semibold"  Margin="0 10 0 10"/>


            <Grid Grid.Row="1" Margin="0 10 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>


                <TextBlock Text="Creation Date: " HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10 0 5 0"/>
                <dxe:DateEdit x:Name="datCreationDate" Grid.Column="1" VerticalAlignment="Center" IsReadOnly="True"/>

                <TextBlock Text="Expense Type: " Grid.Column="2" Margin="15 0 5 0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <dxe:ComboBoxEdit x:Name="cmbExpenseType" Grid.Column="3" VerticalAlignment="Center" Visibility="Visible" IsReadOnly="True"/>

                <TextBlock Text="Vehicle No: " Grid.Column="4" Margin="15 0 5 0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <!--<dxe:TextEdit x:Name="txtVehicleNo" Grid.Column="5" VerticalAlignment="Center" IsReadOnly="True" Margin="0 0 10 0"/>-->

                <dxg:LookUpEdit x:Name="lookupPayee"
                            Grid.Column="5"
                            AutoPopulateColumns="False"
                            IsPopupAutoWidth="False"
                            DisplayMember="PayeeName"
                            NullText="Select Item"
                            Margin="0 0 10 0"
                            Height="22"
                            IsReadOnly="True">
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"
                                       MaxHeight="300"/>
                                </Grid.RowDefinitions>
                                <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView Name="treeListView1"
                                                                      ShowAutoFilterRow="True"
                                                                      TreeDerivationMode="Selfreference"
                                                                      KeyFieldName="Id"
                                                                      ParentFieldName="ParentId"/>
                                    </dxg:GridControl.View>

                                    <dxg:GridColumn FieldName="PayeeName" />
                                </dxg:GridControl>
                            </Grid>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>

            </Grid>

            <Grid Grid.Row="3" Margin="0 10 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Current Meter Reading: " Grid.Column="0" Margin="15 0 0 0" VerticalAlignment="Center"/>
                <dxe:TextEdit x:Name="txtCurrenctMeterReading" Grid.Column="1" VerticalAlignment="Center"
                          Text="0" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"
                          EditValueChanged="TxtCurrenctMeterReading_EditValueChanged"/>

                <TextBlock Text="Last Meter Reading: " Grid.Column="2" Margin="15 0 0 0" VerticalAlignment="Center"/>
                <dxe:TextEdit x:Name="txtLastMeterReading" Grid.Column="3" VerticalAlignment="Center" IsReadOnly="True"
                          Text="0" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>

                <TextBlock Text="Reading Difference: " Grid.Column="4" Margin="15 0 0 0" VerticalAlignment="Center"/>
                <dxe:TextEdit x:Name="txtReadingDifference" Grid.Column="5" VerticalAlignment="Center" IsReadOnly="True" Margin="0 0 10 0"
                          Text="0" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0 10 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="System Ref: " Grid.Column="0" HorizontalAlignment="Right" Margin="15 0 0 0" VerticalAlignment="Center"/>
                <dxe:TextEdit x:Name="txtSystemRefNo" Grid.Column="1" VerticalAlignment="Center" IsReadOnly="True"/>

                <TextBlock Text="Fuel Date: " Grid.Column="2" HorizontalAlignment="Right" Margin="15 0 0 0" VerticalAlignment="Center"/>
                <dxe:DateEdit x:Name="datFuelDate" Grid.Column="3" VerticalAlignment="Center" />

                <TextBlock Text="Expense Amount: " Grid.Column="4" HorizontalAlignment="Right" Margin="15 0 0 0" VerticalAlignment="Center"/>
                <dxe:TextEdit x:Name="txtExpenseAmount" Grid.Column="5" VerticalAlignment="Center" 
                          Text="0" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
            </Grid>

            <Grid Grid.Row="4" Margin="0 10 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="No. of Litres: " Grid.Column="0" HorizontalAlignment="Right" Margin="15 0 0 0" VerticalAlignment="Center"/>
                <dxe:TextEdit x:Name="txtLitres" Grid.Column="1" VerticalAlignment="Center" 
                          Text="0" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>

            </Grid>

            <Button x:Name="btnSave" Content="Save" FontSize="22" Grid.Row="5" Click="BtnSave_Click"/>
        </Grid>

        <Grid Name="grdProgressBar" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Height="100" Width="300" Background="LightGray">
            <ProgressBar x:Name="pbarTarget" Grid.ColumnSpan="2" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center"  Minimum="0" Maximum="100" Height="25" Width="280" Foreground="LightGreen"/>
            <Label Content="Downloading..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Blue"/>
            <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Margin="10,5" x:Name="txtInvoiced" Foreground="Blue" Text="Downloading" FontSize="16" FontWeight="DemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />
                <TextBlock Margin="10,5" x:Name="txtPbarValue" Foreground="Blue" FontWeight="DemiBold" FontSize="16"  Text="{Binding ElementName=pbarTarget , Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />
            </StackPanel>-->
        </Grid>

    </Grid>
</dx:DXWindow>
