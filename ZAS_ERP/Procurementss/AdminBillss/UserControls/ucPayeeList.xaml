<UserControl x:Class="ZAS_ERP.Procurementss.AdminBillss.UserControls.ucPayeeList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.AdminBillss.UserControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded"
             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu>
            <MenuItem Header="Add Payee">
                <MenuItem Header="Add Payee" Click="MbtnAddPayee_Click">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Update Payee" Click="MbtnEditPayee_Click">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Refresh" x:Name="mbtnRefresh" Click="MbtnRefresh_Click"/>
        </Menu>

        <TextBlock x:Name="lblHeading" Text="Payee List" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  />

        <dxg:GridControl 
            Grid.Row="2" 
            x:Name="grdCntrlPayee"
            AutoGenerateColumns="None"
            Grid.ColumnSpan="2"
            AllowInitiallyFocusedRow="False"
            Margin="10 10 10 10">

            <dxg:GridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem 
                        Header="Add New"
                        x:Name="mbtnAddPayee"
                        Click="MbtnAddPayee_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem 
                        Header="Edit"
                        x:Name="mbtnEditPayee"
                        Click="MbtnEditPayee_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </dxg:GridControl.ContextMenu>

            <dxg:GridControl.View>
                <dxg:TreeListView x:Name="gridPayeeView"
                                  ShowAutoFilterRow="True"
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentId"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="False"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowFocusedRectangle="True"
                                  ShowSelectionRectangle="True">
                </dxg:TreeListView>
            </dxg:GridControl.View>

            <dxg:GridColumn FieldName="Id"
                            x:Name="colCategoryId"
                            IsSmart="True"
                            Visible="False"/>

            <dxg:GridColumn x:Name="colPayeeName"
                            FieldName="PayeeName"
                            Header="Payee Name"
                            IsSmart="True"/>

        </dxg:GridControl>
    </Grid>
</UserControl>
