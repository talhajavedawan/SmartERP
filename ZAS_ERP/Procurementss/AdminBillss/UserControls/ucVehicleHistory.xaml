<UserControl x:Class="ZAS_ERP.Procurementss.AdminBillss.UserControls.ucVehicleHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.AdminBillss.UserControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblVehicleHistory" Text="Vehicle History" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10"/>

        <dxg:GridControl AutoGenerateColumns="None"
                         Grid.Row="1"
                         EnableSmartColumnsGeneration="True" 
                         Name="grdVehicleHistory">
            <!--<dxg:GridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add New"
                            x:Name="mbtnAddMaintenanceHead"
                            Click="MbtnAddMaintenanceHead_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Update"
                            x:Name="mbtnEditMaintenanceHead"
                            Click="MbtnEditMaintenanceHead_Click">
                        <MenuItem.Icon>
                            <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </dxg:GridControl.ContextMenu>-->

            <dxg:GridControl.View>
                <dxg:TableView ShowGroupPanel="True"
                           AllowColumnFiltering="True"
                           ShowHorizontalLines="True"
                           ShowVerticalLines="True"
                           ColumnFilterPopupMode="Excel"
                           NavigationStyle="Row"
                           ShowAutoFilterRow="True"       
                           Width="auto"   
                           RowAnimationKind="None" WaitIndicatorType="Panel"/>
            </dxg:GridControl.View>
            <dxg:GridColumn FieldName="Id" Visible="False" ShowInColumnChooser="False" AllowEditing="false"/>
            <dxg:GridColumn FieldName="CreationDate" Header="Creation Date" AllowEditing="false" VisibleIndex="0"/>
            <dxg:GridColumn FieldName="SystemRefNo" Header="System Ref #" AllowEditing="false" VisibleIndex="1"/>
            <dxg:GridColumn FieldName="FuelDate" Header="Fuel Date" AllowEditing="false" VisibleIndex="2"/>
            <dxg:GridColumn FieldName="expenseType" Header="Expense Type" AllowEditing="false" VisibleIndex="3"/>
            <dxg:GridColumn FieldName="CurrentMeterReading" Header="Current Meter Reading" AllowEditing="false" VisibleIndex="4">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" 
                                          Mask="n2" 
                                          MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="LastMeterReading" Header="Last Meter Reading" AllowEditing="false" VisibleIndex="5">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" 
                                          Mask="n2" 
                                          MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="MeterReadingDifference" Header="Meter Reading Difference" AllowEditing="false" VisibleIndex="6">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" 
                                          Mask="n2" 
                                          MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="Litres" Header="Litres" AllowEditing="false" VisibleIndex="7">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" 
                                          Mask="n2" 
                                          MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="ExpenseAmount" Header="Expense Amount" AllowEditing="false" VisibleIndex="8">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" 
                                          Mask="n2" 
                                          MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="payee.PayeeName" Header="Vehicle #" AllowEditing="false" VisibleIndex="9"/>
            <dxg:GridColumn FieldName="maintenanceHead.HeadName" Header="Maintenance Head" AllowEditing="false" VisibleIndex="10"/>
            <dxg:GridColumn FieldName="FuelDate" Header="Fuel Date" AllowEditing="false" VisibleIndex="11"/>
        </dxg:GridControl>
    </Grid>
</UserControl>
