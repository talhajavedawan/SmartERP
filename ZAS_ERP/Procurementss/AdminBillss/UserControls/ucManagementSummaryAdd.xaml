<UserControl x:Class="ZAS_ERP.Procurementss.AdminBillss.UserControls.ucManagementSummaryAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.AdminBillss.UserControls"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="250" d:DesignWidth="400">
    <Grid>

        <dxlc:LayoutGroup Header="Management Summary" 
                                  Margin="0 0 0 45"
                                          View="GroupBox" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical">
            <dxlc:LayoutControl Orientation="Vertical" VerticalAlignment="Center">
                <dxlc:LayoutItem Label="Summary Name:" Width="270">
                    <dxe:TextEdit Margin="2 0 0 0" x:Name="txtManagementSummary"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Height="10"/>
                <dxlc:LayoutItem Label="Parent Summary:" Width="270">
                    <dxg:LookUpEdit Margin="0 0 0 0" x:Name="lookupParentSUmmary" DisplayMember="SummaryName">
                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate>
                                <Grid>
                                   
                                    
                                    <dxg:GridControl Name="PART_GridControl"
                                   AutoPopulateColumns="True">
                                        <dxg:GridControl.View>
                                            <dxg:TreeListView Name="treeListView1"
                                        ShowAutoFilterRow="True"
                                        TreeDerivationMode="Selfreference"
                                        KeyFieldName="Id"
                                        ParentFieldName="ParentId" />
                                        </dxg:GridControl.View>
                                        <dxg:GridColumn FieldName="Id"
                                    x:Name="colSummaryId"
                                    IsSmart="True"
                                    Visible="False" />
                                        <dxg:GridColumn x:Name="colSummaryName"
                                    FieldName="SummaryName"
                                    IsSmart="True" />
                                       
                                        <dxg:GridColumn FieldName="ParentId"
                                    IsSmart="True"
                                    x:Name="colParentId"
                                    Visible="True" />
                                        <dxg:GridColumn FieldName="managementSummary"
                                    IsSmart="True"
                                    x:Name="colmanagementSummary"
                                    Visible="False" />
                                    </dxg:GridControl>
                                </Grid>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Height="10"/>
                <dxlc:LayoutItem Label="Is Active:" Width="270">
                    <dxe:CheckEdit Margin="43 0 0 0" x:Name="chkIsActive"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutControl>
        </dxlc:LayoutGroup>
        <Button Content="Save" x:Name="btnSave" Height="40" VerticalAlignment="Bottom" Click="BtnSave_Click"/>
    </Grid>
</UserControl>
