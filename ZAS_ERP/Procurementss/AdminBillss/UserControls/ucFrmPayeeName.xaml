<UserControl x:Class="ZAS_ERP.Procurementss.AdminBillss.UserControls.ucFrmPayeeName"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.AdminBillss.UserControls"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="600" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <dx:DXTabControl>
            <dx:DXTabControl.View>
                <dx:TabControlScrollView HeaderLocation="Left"
                                 HideButtonShowMode="NoWhere"
                                 HeaderOrientation="Horizontal"
                                 AllowAnimation="True"
                                 ShowHeaderMenu="False"
                                 RemoveTabItemsOnHiding="False"
                                 NewButtonShowMode="NoWhere" />
            </dx:DXTabControl.View>

            <dx:DXTabItem Header="Payee Information">
                <dxlc:LayoutGroup Header="Payee" View="GroupBox" Orientation="Vertical">

                    <dxlc:LayoutControl Orientation="Vertical">

                        <dxlc:LayoutItem Label="Payee Name / Vehicle #  " LabelHorizontalAlignment="Right" Grid.Row="0" >
                            <dxe:TextEdit Name="txtPayeeName" TabIndex="1"/>
                        </dxlc:LayoutItem>

                        <Separator Height="10" BorderBrush="Transparent" Background="Transparent"/>

                        <dxlc:LayoutItem Label="Vehicle Type  " LabelHorizontalAlignment="Right">
                            <CheckBox x:Name="chkIsVehicleType" Checked="ChkIsVehicleType_Checked" Unchecked="ChkIsVehicleType_Unchecked" TabIndex="5"/>
                        </dxlc:LayoutItem>
                        
                        <Separator Height="10" BorderBrush="Transparent" Background="Transparent"/>

                        <dxlc:LayoutItem Label="Is Subsidiary  " x:Name="layoutItemSubsidary" LabelHorizontalAlignment="Right">
                            <CheckBox x:Name="chkIsSubsidiary" Checked="ChkIsSubsidiary_Checked" Unchecked="ChkIsSubsidiary_Unchecked" TabIndex="5"/>
                        </dxlc:LayoutItem>

                        <Separator Height="10" BorderBrush="Transparent" Background="Transparent"/>

                        <dxlc:LayoutItem Label="Parent Payee  " x:Name="layoutItemParentPayee" LabelHorizontalAlignment="Right">
                            <dxg:LookUpEdit x:Name="lookupParentPayee" IsEnabled="False" TabIndex="2" SelectedIndexChanged="LookupParentPayee_SelectedIndexChanged" DisplayMember="PayeeName">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>

                                            <dxg:GridControl Name="PART_GridControl"
                                                             AutoPopulateColumns="True"
                                                             Grid.Row="1">
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView Name="treeListView1"
                                                                      ShowAutoFilterRow="True"
                                                                      TreeDerivationMode="Selfreference"
                                                                      KeyFieldName="Id"
                                                                      ParentFieldName="ParentId"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>
                        
                        <Separator Height="10" BorderBrush="Transparent" Background="Transparent"/>

                <!--<dxlc:LayoutItem Label="Company">
                    <dxg:LookUpEdit x:Name="cmbxCompany" 
                                   SelectedIndexChanged="CmbxCompany_SelectedIndexChanged"
                                   Height="22"
                                   TabIndex="3"
                                   AutoPopulateColumns="True" 
                                   DisplayMember="CompanyName"
                                   IsTextEditable="False"/>
                </dxlc:LayoutItem>
                        
                <Separator Height="20" BorderBrush="Transparent" Background="Transparent"/>

                <dxlc:LayoutItem Label="Department">
                    <dxg:LookUpEdit Height="22" 
                                            SelectedIndexChanged="CmbxDepartment_SelectedIndexChanged"
                                            IsTextEditable="False" 
                                            AutoPopulateColumns="True" 
                                            DisplayMember="DeptName"
                                            x:Name="cmbxDepartment"
                                            TabIndex="4">
                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <dxg:GridControl Name="PART_GridControl"
                                                             AutoPopulateColumns="True"
                                                             Grid.Row="1">
                                        <dxg:GridControl.View>
                                            <dxg:TreeListView Name="treeListView1"
                                                                      ShowAutoFilterRow="True"
                                                                      TreeDerivationMode="Selfreference"
                                                                      KeyFieldName="Id"
                                                                      ParentFieldName="ParentID"/>
                                        </dxg:GridControl.View>
                                    </dxg:GridControl>
                                </Grid>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>

                <Separator Height="20" BorderBrush="Transparent" Background="Transparent"/>-->

                        <dxlc:LayoutItem Label="Active  " LabelHorizontalAlignment="Right">
                            <CheckBox x:Name="chkIsActive" TabIndex="5"/>
                        </dxlc:LayoutItem>

                        <Separator Height="10" BorderBrush="Transparent" Background="Transparent"/>

                        <dxlc:LayoutItem Label="Is Owned  " LabelHorizontalAlignment="Right" x:Name="layoutItemIsOwned" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="chkIsOwned" Checked="ChkIsOwned_Checked" Unchecked="ChkIsOwned_Unchecked"/>

                                <TextBlock Text="Is Rented" Margin=" 70 0 0 0"/>
                                <CheckBox x:Name="chkIsRented" Margin="10 0 0 0" Checked="ChkIsRented_Checked" Unchecked="ChkIsRented_Unchecked"/>
                            </StackPanel>
                        </dxlc:LayoutItem>

                        <Separator Height="10" BorderBrush="Transparent" Background="Transparent"/>

                        <dxlc:LayoutItem Label="Company  " LabelHorizontalAlignment="Right" x:Name="layoutItemCompany" Visibility="Collapsed">
                            <dxg:LookUpEdit x:Name="lookupCompany"
                          Grid.Column="1"
                          Grid.Row="3"
                          TabIndex="5"
                          DisplayMember="CompanyName"
                          AutoPopulateColumns="False"
                          VerticalAlignment="Center">
                                <dxg:LookUpEdit.StyleSettings>
                                    <dxg:LookUpEditStyleSettings />
                                </dxg:LookUpEdit.StyleSettings>
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <!--<Button x:Name="btnAddCompany"
                            Click="btnAddCompany_Click"
                            VerticalAlignment="Center"
                            Content="Add New" />-->
                                            <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                                                <dxg:GridControl.View>
                                                    <dxg:TableView Name="tableView1"
                                     ShowAutoFilterRow="True" />
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                                <dxg:GridColumn FieldName="CompanyName"
                                    IsSmart="True" />
                                                <!--<dxg:GridColumn FieldName="IndustryType"
                                      IsSmart="True"
                                      Visible="False" />-->
                                                <dxg:GridColumn x:Name="colBizType"
                                    FieldName="BizType"
                                    Visible="False"
                                    IsSmart="True" />
                                                <dxg:GridColumn FieldName="EmployeerNo"
                                    x:Name="colEmployeerNo"
                                    IsSmart="True"
                                    Visible="False" />
                                                <!--<dxg:GridColumn FieldName="addressId"
                                      x:Name="coladressId"
                                      IsSmart="True"
                                      Visible="False" />
                      <dxg:GridColumn FieldName="address"
                                      IsSmart="True"
                                      x:Name="coladress"
                                      Visible="False" />
                      <dxg:GridColumn FieldName="contactId"
                                      Visible="False"
                                      x:Name="colcontactId"
                                      IsSmart="True" />-->
                                                <!--<dxg:GridColumn FieldName="contact"
                                      x:Name="colcontact"
                                      IsSmart="True"
                                      Visible="False" />-->
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>

                        <dxlc:LayoutItem Label="Rented Owner  " LabelHorizontalAlignment="Right" x:Name="layoutItemOwner" Visibility="Collapsed">
                            <dxg:LookUpEdit x:Name="lookupVehicleOwner"
                         Grid.Column="1"
                          Grid.Row="3"
                          TabIndex="5"
                          DisplayMember="OwnerName"
                          AutoPopulateColumns="False"
                          VerticalAlignment="Center">
                                <dxg:LookUpEdit.StyleSettings>
                                    <dxg:LookUpEditStyleSettings />
                                </dxg:LookUpEdit.StyleSettings>
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <!--<Button x:Name="btnAddCompany"
                            Click="btnAddCompany_Click"
                            VerticalAlignment="Center"
                            Content="Add New" />-->
                                            <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                                                <dxg:GridControl.View>
                                                    <dxg:TableView Name="tableView1"
                                     ShowAutoFilterRow="True" />
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" 
                                                                ShowInColumnChooser="False"/>
                                                <dxg:GridColumn FieldName="OwnerName"
                                    IsSmart="True" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutControl>


                </dxlc:LayoutGroup>
            </dx:DXTabItem>

            <dx:DXTabItem Header="Companies and Depts">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                <dxlc:LayoutGroup Header="Companies" View="GroupBox" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <dxg:GridControl x:Name="grdCntrlCompanies"
                             AutoGenerateColumns="None"
                             Grid.ColumnSpan="2"
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">
                            
                            <dxg:GridControl.View>
                                <dxg:TreeListView x:Name="gridCompanyView"
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True"
                                                  ShowAutoFilterRow="True">
                                </dxg:TreeListView>
                            </dxg:GridControl.View>
                            
                            <dxg:GridColumn FieldName="Id"
                              x:Name="colCategoryId"
                              IsSmart="True"
                              Visible="False"/>
                            
                            <dxg:GridColumn x:Name="colCompanyName"
                              FieldName="CompanyName"
                                            Header="Company"
                              IsSmart="True"/>
                            
                        </dxg:GridControl>
                    </Grid>

                </dxlc:LayoutGroup>

                <dxlc:GroupBox Header="Departments" Grid.Row="1">
                    <dxlc:GroupBox.TitleBackground>
                        <LinearGradientBrush EndPoint="0.5,1"
                                 StartPoint="0.5,0">
                            <GradientStop Color="#FFE6E8EB"
                            Offset="0" />
                            <GradientStop Color="#FF6CA6FB"
                            Offset="1" />
                        </LinearGradientBrush>
                    </dxlc:GroupBox.TitleBackground>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <dxg:GridControl x:Name="gridDepartment"
                             AutoGenerateColumns="None"
                             Grid.ColumnSpan="2"
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">
                            <!--<dxg:GridControl.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Add New"
                            x:Name="btnAddDepartment"
                            Click="btnAddDepartment_Click" />
                  <MenuItem Header="Edit Department"
                            x:Name="btnEditDepartment"
                            Click="btnEditDepartment_Click" />
                  <Separator />
                  <MenuItem Header="Delete Department"
                            x:Name="btnDeleteDepartment"
                            Click="btnDeleteDepartment_Click" />
                </ContextMenu>
              </dxg:GridControl.ContextMenu>-->
                            <dxg:GridControl.View>
                                <dxg:TreeListView x:Name="griddeptview"
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True"
                                  ShowAutoFilterRow="True"               >
                                    <!--<dxg:TableView.DataContext>
                  <Databases:DBContextERP />
                </dxg:TableView.DataContext>-->
                                </dxg:TreeListView>
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="Id"
                              x:Name="coldeptid"
                              IsSmart="True"
                              Visible="False" />
                            <dxg:GridColumn x:Name="coldeptname"
                              FieldName="DeptName"
                              IsSmart="True" />
                            <dxg:GridColumn x:Name="coldeptcode"
                              FieldName="Code"
                              IsSmart="True" />
                            <dxg:GridColumn FieldName="Abbrivation"
                              IsSmart="True"
                              x:Name="coldeptabr"
                              Visible="False" />
                            <dxg:GridColumn FieldName="Timestamp"
                              IsSmart="True"
                              x:Name="coldeptts"
                              Visible="False" />
                            <dxg:GridColumn FieldName="sectionId"
                              IsSmart="True"
                              Visible="False" />
                            <dxg:GridColumn FieldName="sections"
                              IsSmart="True"
                              Visible="False" />
                        </dxg:GridControl>
                    </Grid>
                </dxlc:GroupBox>
                </Grid>
            </dx:DXTabItem>

            <dx:DXTabItem Header="Vendors">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>

                    <!--<StackPanel Orientation="Horizontal">
                        <Label Content="Vendor Type  " Margin="10 0 0 0" VerticalAlignment="Center"/>
                        <ComboBox Width="250"
                            VerticalAlignment="Center"
                            x:Name="cmbIndustry"
                            SelectionChanged="CmbIndustry_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel  Orientation="Horizontal">
                                        <TextBlock Text="{Binding id}"
                                     Visibility="Hidden" />
                                        <TextBlock Text="{Binding name}"></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>-->

                    <dxlc:LayoutGroup Header="Bill Types" View="GroupBox" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                            <dxg:GridControl x:Name="grdCntrlAdminBillTypes"
                             AutoGenerateColumns="None"
                             Grid.ColumnSpan="2"
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">

                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="gridAdminBillTypeView"
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True"
                                                      ShowAutoFilterRow="True">
                                    </dxg:TreeListView>
                                </dxg:GridControl.View>

                                <dxg:GridColumn FieldName="Id"
                              x:Name="colVendorTypeId"
                              IsSmart="True"
                              Visible="False" />

                                <dxg:GridColumn x:Name="colName"
                              FieldName="name"
                                            Header="Type"
                              IsSmart="True"/>

                            </dxg:GridControl>
                        </Grid>

                    </dxlc:LayoutGroup>

                    <dxlc:LayoutGroup Header="Vendors" View="GroupBox" Grid.Row="1" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                            <dxg:GridControl x:Name="grdCntrlVendors"
                             AutoGenerateColumns="None"
                             Grid.ColumnSpan="2"
                             SelectionMode="MultipleRow"
                             AllowInitiallyFocusedRow="False">

                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="gridVendorView"
                                        AutoWidth="True"
                                        KeyFieldName="Id"
                                        TreeDerivationMode="Selfreference"
                                        AutoExpandAllNodes="True"
                                        IsSynchronizedWithCurrentItem="True"
                                        AllowEditing="False"
                                        ShowCheckboxes="True"
                                        UseIndicatorForSelection="True"
                                        FadeSelectionOnLostFocus="False"
                                        ShowSelectionRectangle="True"
                                                      ShowAutoFilterRow="True">
                                    </dxg:TreeListView>
                                </dxg:GridControl.View>

                                <dxg:GridColumn FieldName="Id"
                              x:Name="colVendorid"
                              IsSmart="True"
                              Visible="False" />
                                
                                <dxg:GridColumn x:Name="colCompany"
                              FieldName="company.CompanyName"
                                            Header="Vendor"
                              IsSmart="True"/>
                                
                            </dxg:GridControl>
                        </Grid>

                    </dxlc:LayoutGroup>
                </Grid>
            </dx:DXTabItem>
        </dx:DXTabControl>
        <Button Content="Save" x:Name="btnSave" TabIndex="6" Grid.Row="1" Click="BtnSave_Click" Height="40"/>

    </Grid>
</UserControl>
