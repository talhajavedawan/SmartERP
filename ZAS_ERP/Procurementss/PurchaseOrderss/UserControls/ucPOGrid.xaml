                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtVoidcount" Text="{Binding VoidCount}" Foreground="Red"/>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
        </Menu>
        
        <TextBlock x:Name="lblHeading" Text="Purchase Orders" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="3" FontFamily="Segoe UI Semibold"  />
