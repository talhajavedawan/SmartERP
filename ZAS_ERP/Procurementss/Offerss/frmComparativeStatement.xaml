    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*"  />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Visibility="Collapsed" Panel.ZIndex="5" dx:ThemeManager.ThemeName="None" VerticalAlignment="Top" HorizontalAlignment="Left"
                 Grid.Column="0" Orientation="Horizontal">
            <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">
                <Image Source="/ZAS_ERP;component/images/log.png"></Image>
            </Button>


            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" Click="BtnAddComment_Click"  ToolTip="Add New Comment">
                <Image  Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2" Click="BtnCommentLog_Click"  ToolTip="CommentLog">
                <Image  Source="/ZAS_ERP;component/images/comments.png" ></Image>
            </Button>
            <Button x:Name="btnAttachNew" Visibility="Collapsed" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Info" Click="BtnAttachNew_Click">
                <Image x:Name="imgAttachNew"  Source="/ZAS_ERP;component/images/clipattachment.png"></Image>
            </Button>
            <Button x:Name="btnAttachmentList" Visibility="Collapsed" Width="30" Height="30" Grid.Column="3" ToolTip="Info" Click="BtnAttachmentList_Click">
                <Image  Source="/ZAS_ERP;component/images/ListAttachment.png"></Image>
            </Button>

            <Button x:Name="btnAttachNew1" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Attach document" Click="BtnAttachNew1_Click">
                <Image x:Name="imgAttachNew1"  Source="{dx:DXImage Image=Attachment_32x32.png}"></Image>
            </Button>
            <Button x:Name="btnAttachmentList1"  Width="30" Height="30" Grid.Column="3" ToolTip="List of Attachments" Click="BtnAttachmentList1_Click">
                <Image  Source="{dx:DXImage Image=ListNumbers_32x32.png}"></Image>
            </Button>

            <!--<Button x:Name="btnInfo" Height="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">
                <Image Source="/ZAS_ERP;component/images/log.png"></Image>
            </Button>
            <Button Height="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1" Click="BtnMarkReviewed_Click"  ToolTip="Approve-Mark as Reviewed">
                <Image Source="/ZAS_ERP;component/images/approve.png"></Image>
            </Button>
            <Button Height="30" Margin="5,0,0,0" x:Name="btnReject" Grid.Column="2" Click="BtnReject_Click"  ToolTip="Reject">
                <Image Source="/ZAS_ERP;component/images/reject.png"></Image>
            </Button>
            <Button Height="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" Click="BtnAddComment_Click"  ToolTip="Add New Comment">
                <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
            </Button>
            <Button Height="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2" Click="BtnCommentLog_Click"  ToolTip="CommentLog">
                <Image Source="/ZAS_ERP;component/images/comments.png" ></Image>
            </Button>-->
        </StackPanel>



        <dxe:CheckEdit x:Name="checkSelctedVendor" Grid.Column="13" Grid.ColumnSpan="3" Content="Select Vendor Statment"/>

        <TextBlock x:Name="lblHeading" 
                   Grid.Row="1" 
                   Text="Add Vendor Statement"    
                   FontWeight="Bold"  
                   Background="Beige" 
                   FontSize="15"   
                   Margin="5"
                   Grid.ColumnSpan="16"  
                   HorizontalAlignment="Center" FontFamily="Segoe UI Semibold"  ></TextBlock>
        <Label Grid.Column="0"   
                   Grid.Row="2"
                    
                   Margin="5"
                   FontWeight="DemiBold" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"  
                   Content="Offer Currency"/>


        <!--<ComboBox x:Name="lookupOfferCurrency"
                  Grid.Column="1"
                  Grid.Row="2"
                  Margin="5"
                  
                  IsEditable="False"
                  IsEnabled="False"
                      >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>-->
        <dxg:LookUpEdit x:Name="lookupOfferCurrency" 
                                    Grid.Column="1"
                                    Grid.Row="2"
                                    Margin="5"
                                    Height="22" 
                                    Background="Beige"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                                    IsReadOnly="True"
                                    TabIndex="3" 
                                    AutoPopulateColumns="False" 
                                    DisplayMember="CurrencyName"
                                    IsTextEditable="False">
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings />
            </dxg:LookUpEdit.StyleSettings>
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView Name="offerCurrencyView"
                                     ShowAutoFilterRow="True" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn x:Name="Currency"
                                    FieldName="CurrencyName"
                                    Header="Currency"        
                                    IsSmart="True"
                                    Visible="True" />


                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>



        <Label Grid.Column="2"  
                   Grid.Row="2"
                   Margin="5"   
                    
                   FontWeight="DemiBold"
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"     
                   Content="Offer Value"/>
        <dxe:TextEdit x:Name="txtOfferValue"
                      Grid.Row="2"
                   VerticalAlignment="Center"
                   Margin="5"
                   Grid.Column="3"   
                   Background="Beige"
                   IsReadOnly="True" 
                   MaskType="Numeric" Mask="n2"
                   MaskUseAsDisplayFormat="True"
                   MinWidth="80"></dxe:TextEdit>


        <Label Grid.Column="4"
                   Grid.Row="2" 
                   Margin="5"  
                  
                   FontWeight="DemiBold" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center" 
                   Content="Offer Inco Term"/>

        <dxg:LookUpEdit x:Name="lookupOfferIncoTerm" 
                                   Grid.Column="5"
                                   Margin="5"
                                   Height="22" 
                        Background="Beige"
                             
                        IsReadOnly="True"
                                   TabIndex="3"
                                   Grid.Row="2"
                                   AutoPopulateColumns="False" 
                                   DisplayMember="term"
                                   IsTextEditable="False">
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings />
            </dxg:LookUpEdit.StyleSettings>
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView Name="offerIncoTermView"
                                     ShowAutoFilterRow="True" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn x:Name="term"
                                    FieldName="term"
                                    IsSmart="True"
                                    Visible="True" />

                            <dxg:GridColumn FieldName="discription"
                                    IsSmart="True"
                                    Width="auto" />
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>

        <Label Grid.Column="6"
                   Grid.Row="2" 
                   Margin="5"  
                  
                   FontWeight="DemiBold" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center" 
                   Content="Vendor Inco Term"/>

        <dxg:LookUpEdit x:Name="lookupVendorIncoTerm" 
                                   Grid.Column="7"
                                   Margin="5"
                                   Height="22" 
                                   Background="Beige"
                                   TabIndex="3"
                                   Grid.Row="2"
                                   AutoPopulateColumns="False" 
                                   DisplayMember="term"
                                   IsTextEditable="False">
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings />
            </dxg:LookUpEdit.StyleSettings>
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView Name="offerIncoTermView"
                                     ShowAutoFilterRow="True" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn x:Name="term"
                                    FieldName="term"
                                    IsSmart="True"
                                    Visible="True" />

                            <dxg:GridColumn FieldName="discription"
                                    IsSmart="True"
                                    Width="auto" />
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>



        <Label Grid.Column="8"  
               
              
               Margin="5" 
               FontWeight="DemiBold"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Grid.Row="2" Content="Vendor"/>

        <dxg:LookUpEdit x:Name="lookupVendor" 
                                   Grid.Column="9"
                                   Margin="5"
                        Background="Beige"
                                   Height="22" 
                                 
                                   TabIndex="3"
                                   Grid.Row="2"
                                   AutoPopulateColumns="False" 
                                   DisplayMember="company.CompanyName">
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings />
            </dxg:LookUpEdit.StyleSettings>
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView Name="offerIncoTermView"
                                     ShowAutoFilterRow="True" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="company.CompanyName"
                                    IsSmart="True"
                                    Width="auto" />
                            <dxg:GridColumn FieldName="company.IndustryType"
                                    IsSmart="True"
                                    Visible="False" />
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>
        <Label Grid.Column="12"  
                   
                   Margin="5"
                  
                   FontWeight="DemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Grid.Row="2"
                   Content="Creator"/>
        <dxg:LookUpEdit x:Name="lookupCreator" 
                                   Grid.Column="13"
                                   Margin="5"
                                   Height="22" 
                                   Background="Beige"
                                   IsReadOnly="True"
                                   TabIndex="3"
                                   Grid.Row="2"
                                   AutoPopulateColumns="False" 
                                   DisplayMember="userName">
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings />
            </dxg:LookUpEdit.StyleSettings>
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView Name="offerCreatorView"
                                     ShowAutoFilterRow="True" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="userName"
                                    IsSmart="True"
                                    Header="User Name"        
                                    Width="auto" />

                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>


        <Label Grid.Column="10"  
               
               Margin="5"
               FontWeight="DemiBold"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Grid.Row="2"  
               Content="Vendor Name"/>
        <dxe:TextEdit  x:Name="txtVendorName"
            Grid.Column="11"   
            Background="Beige"   
            Margin="5" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Stretch" 
            Grid.Row="2" />




        <Label Grid.Column="14"  
                   
                   Margin="5"
                  
                   FontWeight="DemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Grid.Row="2"
                   Content="Item"/>

        <dxg:LookUpEdit x:Name="lookupProduct" 
                                   Grid.Column="15"
                                   Margin="5"
                                   Height="22" 
                                   Background="Beige"
                                   TabIndex="3"
                                   Grid.Row="2"
                                   EditValueChanged="lookupProduct_EditValueChanged"
                                   AutoPopulateColumns="False" 
                                   DisplayMember="inquiryProduct.ownDiscription">
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings />
            </dxg:LookUpEdit.StyleSettings>
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView Name="offerProductView"
                                     ShowAutoFilterRow="True" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="inquiryProduct.ownDiscription" Header="Own Description" />
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>

      

        <dxg:GridControl x:Name="grdComparativeItems"
                         Grid.Row="4"
                         Margin="10"
                         Grid.ColumnSpan="16"
                         SelectionMode="Cell"  
                         CustomUnboundColumnData="grdComparativeItems_CustomUnboundColumnData"
                        
                          >

            <dxg:GridControl.View>
                <dxg:TableView       x:Name="view"
                                     AutoWidth="True"
                                     ShowGroupPanel="False"
                                   NewItemRowPosition="Bottom"
                                     AllowSorting="False"
                                   AllowColumnFiltering="False"
                                   ShowTotalSummary="True"  
                                   ShowVerticalLines="True"  
                                   CellValueChanged="view_CellValueChanged"  
                                   InitNewRow="view_InitNewRow"
                                   ShowHorizontalLines="True"
                                   ShowFixedTotalSummary="False"  
                                   HorizontalScrollbarVisibility="Visible"
                                   AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="-2,4,2,-4"
                                  >
                    <dxg:TableView.FormatConditions>

                        <dxg:FormatCondition ApplyToRow="false" Expression="Not IsNullOrEmpty([costSheetField])" FieldName="costSheetField">
                            <dx:Format Background="#FFADD8E6"/>
                        </dxg:FormatCondition>
                        <dxg:FormatCondition ApplyToRow="false" Expression="Not IsNullOrEmpty([itemIncoTerm])" FieldName="itemIncoTerm">
                            <dx:Format Background="#FFADD8E6"/>
                        </dxg:FormatCondition>
                        <dxg:FormatCondition ApplyToRow="false" Expression="Not IsNullOrEmpty([ownDescription])" FieldName="ownDescription">
                            <dx:Format Background="#FFADD8E6"/>
                        </dxg:FormatCondition>
                        <dxg:FormatCondition ApplyToRow="false" Expression="Not IsNullOrEmpty([itemCurrency])" FieldName="itemCurrency">
                            <dx:Format Background="#FFADD8E6"/>
                        </dxg:FormatCondition>
                        <dxg:FormatCondition ApplyToRow="false" Expression="Not IsNullOrEmpty([convertedCurrency])" FieldName="convertedCurrency">
                            <dx:Format Background="#FFADD8E6"/>
                        </dxg:FormatCondition>



                        <dxg:FormatCondition ApplyToRow="false" Expression="[MER] &gt; '0'" FieldName="MER">
                            <dx:Format Background="#FFF5F5DC"/>
                        </dxg:FormatCondition>
                        <dxg:FormatCondition ApplyToRow="false" Expression="[amountOC] &gt; '0'" FieldName="amountOC">
                            <dx:Format Background="#FFF5F5DC"/>
                        </dxg:FormatCondition>

                        <dxg:FormatCondition ApplyToRow="false" Expression="[amountMER] &gt; '0'" FieldName="amountMER">
                            <dx:Format Background="#FFF5F5DC"/>
                        </dxg:FormatCondition>

                    </dxg:TableView.FormatConditions>
                </dxg:TableView>
            </dxg:GridControl.View>

            <dxg:GridColumn x:Name="costSheetField"
                            FieldName="costSheetField"
                            VisibleIndex="0"
                            HorizontalHeaderContentAlignment="Center"
                            Header="Account Heads"
                            IsSmart="True"
                            UnboundType="bound"
                            UnboundExpression="[Title]">
                <dxg:GridColumn.DisplayTemplate>
                    <ControlTemplate>
                        <TextBlock Text="{Binding RowData.Row.costSheetField.Title}"></TextBlock>
                    </ControlTemplate>
                </dxg:GridColumn.DisplayTemplate>
                <dxg:GridColumn.EditSettings>
                    <dxg:LookUpEditSettings x:Name="lookupCostSheetField"
                                      AutoPopulateColumns="False"                  
                                      IsPopupAutoWidth="False"           
                                      DisplayMember="Title"
                                      NullText="Select Item">
                        <dxg:LookUpEditSettings.PopupContentTemplate>
                            <ControlTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                        <dxg:GridControl.View>
                                            <dxg:TableView x:Name="grdCostSheetField"
                                                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                                            AllowEditing="False"
                                                            NavigationStyle="Row"
                                                            Width="auto"      
                                                            ShowAutoFilterRow="True"      
                                                            ShowSearchPanelMode="Default"
                                                            ColumnFilterPopupMode="Excel"
                                                            CompactPanelShowMode="CompactMode"
                                                            ShowFixedTotalSummary="True"
                                                            ShowTotalSummary="True" 
                                                            RowAnimationKind="None"
                                                            WaitIndicatorType="Panel"      
                                                            FadeSelectionOnLostFocus="False"
                                                            ShowSelectionRectangle="True" />
                                        </dxg:GridControl.View>

                                        <dxg:GridColumn FieldName="Title"
                                    IsSmart="True"
                                    Width="auto" />

                                    </dxg:GridControl>
                                </Grid>
                            </ControlTemplate>
                        </dxg:LookUpEditSettings.PopupContentTemplate>
                    </dxg:LookUpEditSettings>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
        
            <dxg:GridColumn x:Name="ownDescription" 
                            FieldName="ownDescription" 
                            VisibleIndex="2"
                            HorizontalHeaderContentAlignment="Center"
                            Header="Own Description"
                            SortOrder="Ascending" 
                            SortIndex="0">

            </dxg:GridColumn>

            <dxg:GridColumn x:Name="currency"
                            FieldName="itemCurrency"
                          Header="VC"
                            HorizontalHeaderContentAlignment="Center"
                          IsSmart="True"
                          VisibleIndex="3"     
                          UnboundType="bound"
                          UnboundExpression="[CurrencyName]">
                <dxg:GridColumn.DisplayTemplate>
                    <ControlTemplate>
                        <TextBlock Text="{Binding RowData.Row.itemCurrency.CurrencyName}"></TextBlock>
                    </ControlTemplate>
                </dxg:GridColumn.DisplayTemplate>
                <dxg:GridColumn.EditSettings>
                    <dxg:LookUpEditSettings x:Name="lookupItemCurrency"
                                      AutoPopulateColumns="False"         
                                      IsPopupAutoWidth="False"           
                                      DisplayMember="CurrencyName"
                                      NullText="Select Item">
                        <dxg:LookUpEditSettings.PopupContentTemplate>
                            <ControlTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                        <dxg:GridControl.View>
                                            <dxg:TableView x:Name="grdItemCurrency"
                                                                AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                                                AllowEditing="False"
                                                                NavigationStyle="Row"
                                                                Width="auto"      
                                                                ShowAutoFilterRow="True"      
                                                                ShowSearchPanelMode="Default"
                                                                ColumnFilterPopupMode="Excel"
                                                                CompactPanelShowMode="CompactMode"
                                                                ShowFixedTotalSummary="True"
                                                                ShowTotalSummary="True" 
                                                                RowAnimationKind="None" WaitIndicatorType="Panel"      
                                                                FadeSelectionOnLostFocus="False"
                                                                ShowSelectionRectangle="True" />
                                        </dxg:GridControl.View>
                                        <dxg:GridColumn x:Name="colId"
                                    FieldName="Id"
                                    IsSmart="True"
                                    Visible="True" />
                                        <dxg:GridColumn FieldName="CurrencyName"
                                    IsSmart="True"
                                    Width="auto" />

                                    </dxg:GridControl>
                                </Grid>
                            </ControlTemplate>
                        </dxg:LookUpEditSettings.PopupContentTemplate>
                    </dxg:LookUpEditSettings>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn x:Name="convertedCurrency"
                            FieldName="convertedCurrency"
                            Header="COC"
                            HorizontalHeaderContentAlignment="Center"
                            IsSmart="True"
                            VisibleIndex="4" 
                            UnboundType="bound"
                          UnboundExpression="[CurrencyName]">
                <dxg:GridColumn.DisplayTemplate>
                    <ControlTemplate>
                        <TextBlock Text="{Binding RowData.Row.convertedCurrency.CurrencyName}"></TextBlock>
                    </ControlTemplate>
                </dxg:GridColumn.DisplayTemplate>
                <dxg:GridColumn.EditSettings>
                    <dxg:LookUpEditSettings x:Name="lookupConvertedCurrency"
                                      AutoPopulateColumns="False"             
                                      IsPopupAutoWidth="False"           
                                      DisplayMember="CurrencyName"
                                      NullText="Select Item">
                        <dxg:LookUpEditSettings.PopupContentTemplate>
                            <ControlTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                        <dxg:GridControl.View>
                                            <dxg:TableView x:Name="grdConvertedCurrency"
                                                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                                            AllowEditing="False"
                                                            NavigationStyle="Row"
                                                            Width="auto"      
                                                            ShowAutoFilterRow="True"      
                                                            ShowSearchPanelMode="Default"
                                                            ColumnFilterPopupMode="Excel"
                                                            CompactPanelShowMode="CompactMode"
                                                            ShowFixedTotalSummary="True"
                                                            ShowTotalSummary="True" 
                                                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                                                            FadeSelectionOnLostFocus="False"
                                                            ShowSelectionRectangle="True" />
                                        </dxg:GridControl.View>
                                        <dxg:GridColumn x:Name="colId"
                                                        FieldName="Id"
                                                        IsSmart="True"
                                                        />
                                        <dxg:GridColumn FieldName="CurrencyName"
                                                        IsSmart="True"
                                                         />
                                    </dxg:GridControl>
                                </Grid>
                            </ControlTemplate>
                        </dxg:LookUpEditSettings.PopupContentTemplate>
                    </dxg:LookUpEditSettings>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn x:Name="MER" 
                            FieldName="MER"
                            HorizontalHeaderContentAlignment="Center"
                            VisibleIndex="6" 
                            UnboundType="Decimal" 
                            ReadOnly="True"
                            SortOrder="Ascending" 
                            SortIndex="0">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="amountOC"
                            Header="Cost (VC)"
                            HorizontalHeaderContentAlignment="Center"
                            VisibleIndex="5">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="amountMER" 
                            ReadOnly="True" 
                            HorizontalHeaderContentAlignment="Center"
                            Header="Cost (COFC)" 
                            VisibleIndex="7" 
                            UnboundExpression="[amountOC] * [MER]">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridControl.TotalSummary >
                <dxg:GridSummaryItem x:Name="amountOC" FieldName="amountOC"  SummaryType="Sum"   DisplayFormat="{}{0:n2}" />
                <dxg:GridSummaryItem x:Name="amountMER" FieldName="amountMER"  SummaryType="Sum"   DisplayFormat="{}{0:n2}" />

            </dxg:GridControl.TotalSummary>

        </dxg:GridControl>


        <dx:SimpleButton x:Name="btnSave" ToolTip="Save Comparative Statement"  Grid.Row="5" Grid.ColumnSpan="16" MinHeight="40" Content="Save" Click="btnSave_Click" />

    </Grid>
</dx:DXWindow>
