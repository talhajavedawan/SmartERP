<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Offerss"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:loc="clr-namespace:ZAS_ERP"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             x:Class="ZAS_ERP.Procurementss.Offerss.ucOfferGrid"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:Name="ucoffergrid"
             Unloaded="Ucoffergrid_Unloaded"
             Loaded="ucofferGrid_Loaded">
    <UserControl.Resources>
        <loc:MyConv x:Key="valueconverter"/>
    </UserControl.Resources>
    <Grid DataContext="{Binding  RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ucOfferGrid}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>

            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Menu DockPanel.Dock="Top"
              x:Name="menuGrid"
              Grid.ColumnSpan="3">
            <MenuItem Header="_Print Preview"
                      x:Name="mbtnPrintPreview"
                      Click="MbtnPrintPreview_Click"/>
            <MenuItem Header="Export To Report"
                      x:Name="mbtnExportToReport"
                      Click="MbtnExportToReport_Click"/>
            <MenuItem Header="Refresh"
                      x:Name="mbtnRefresh"
                      Click="MbtnRefresh_Click"/>
            <MenuItem Header="Direct Close"
                      x:Name="mbtnDriectClose"
                      Click="MbtnDriectClose_Click"/>
            <MenuItem Header="Approve"
                          x:Name="mbtnApprove"
                          Click="MbtnApprove_Click"></MenuItem>
            <MenuItem 
                          x:Name="mbtnPending"
                          Click="MbtnPending_Click">
                <MenuItem.Template>
                    <dxg:DefaultControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending for Approval"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0" FontWeight="Bold" x:Name="txtApprovalcount" Text="{Binding ApprovalCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </dxg:DefaultControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            <MenuItem 
                          x:Name="mbtnPendingClosing"
                          Click="MbtnPendingClosing_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending for Closing"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtClosingcount" Text="{Binding ClosingCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            <MenuItem 
                          x:Name="mbtnApprovedUnapproved"
                          Click="mbtnRegister_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Offer Register"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtRegisterCount" Text="{Binding ApproveunapprovedCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            <MenuItem Header="Save Layout"
                          x:Name="mbtnSaveLayout"
                          Click="MbtnSaveLayout_Click"></MenuItem>
            <MenuItem 
                          x:Name="mbtnVoid"
                          Click="MbtnVoid_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Void"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtVoidcount" Text="{Binding VoidCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
        </Menu>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <dxe:TextEdit Text="From" FontWeight="DemiBold" Background="LightGreen" IsReadOnly="True" HorizontalContentAlignment="Center" Grid.Column="0"/>
            <dxe:DateEdit x:Name="dateFrom" NullText="Select Date" Grid.Column="1" FontWeight="DemiBold"    >
             
            </dxe:DateEdit>
            <dxe:TextEdit Grid.Column="2" FontWeight="DemiBold" Background="Orange" IsReadOnly="True" HorizontalContentAlignment="Center" Text="To"/>
            <dxe:DateEdit x:Name="dateTo" NullText="Select Date" Grid.Column="3" FontWeight="DemiBold"   >
            
            </dxe:DateEdit>
            <dx:SimpleButton x:Name="btnDateFilter" ToolTip="Filter by date range" Grid.Column="4" Content="Apply" Cursor="Hand" Click="BtnDateFilter_Click"  />

            <!--<dx:SimpleButton FontWeight="Bold" Content="Load More"  Grid.Column="0" x:Name="btnLoadMoreSO" Click="BtnLoadMoreSO_Click" Foreground="Black"/>
            <dx:SimpleButton FontWeight="Bold" Background="Orange" x:Name="btnLoadAll" Click="BtnLoadAll_Click" Content="Load All" Grid.Column="3" Foreground="Black"/>-->

        </Grid>
        <TextBlock x:Name="lblHeading" Text="Offers" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="2" FontFamily="Segoe UI Semibold"  ></TextBlock>

        <dxg:GridControl x:Name="grdoffer"
                    
                     Grid.Row="3"
                     Grid.ColumnSpan="3"
                     SelectionMode="Row"
                     AutoGenerateColumns="AddNew"
                     ItemsSource="{Binding offer}"
                     MouseDoubleClick="grdoffer_MouseDoubleClick">
            <dxg:GridControl.TotalSummary>
                <dxg:GridSummaryItem DisplayFormat="###,###,###.##" FieldName="totalBaseCFRValue" SummaryType="Sum"/>
            </dxg:GridControl.TotalSummary>
            <dxg:GridControl.View>
                <dxg:TableView  x:Name="tableView"
                        Width="auto"
                        
                        AllowMasterDetail="True"
                        ColumnFilterPopupMode="Excel"
                        ShowFixedTotalSummary="True"
                       ShowTotalSummary="True"
                        ShowAutoFilterRow="True">
                    <dxg:TableView.FormatConditions>
                        <dxg:FormatCondition FieldName=""
                                 ValueRule="Between">
                            <dx:Format>
                                <dx:Format.Icon>
                                    <BitmapImage UriSource="pack://application:,,,/DevExpress.Xpf.Core.v21.2;component/Core/ConditionalFormatting/Images/IconSets/TrafficLights3_1.png"
                               UriCachePolicy="{x:Null}" />
                                </dx:Format.Icon>
                            </dx:Format>
                        </dxg:FormatCondition>
                    </dxg:TableView.FormatConditions>
                </dxg:TableView>
            </dxg:GridControl.View>
            <!--<dxg:GridControl.DetailDescriptor>
                <dxg:DataControlDetailDescriptor ShowHeader="True"
                                           x:Name="detailGridDescriptor"
                                           ItemsSourcePath="products">
                    <dxg:GridControl>
                        <dxg:GridControl.View>
                            <dxg:TableView DetailHeaderContent="Products"
                                 AutoWidth="True"
                                 ShowGroupPanel="False" />
                        </dxg:GridControl.View>
                        <dxg:GridColumn Header="Item Code"
                              FieldName="inquiryProduct.product.code"
                                IsSmart="True"
                                Width="auto" />
                        <dxg:GridColumn Header="Item Name"
                              FieldName="inquiryProduct.product.item"
                                IsSmart="True"
                                Width="auto" />
                        <dxg:GridColumn FieldName="inquiryProduct.product.itemDescription"
                                IsSmart="True"
                                Header="Item Description"
                                Width="auto" />
                        <dxg:GridColumn FieldName="inquiryProduct.ownDiscription"
                                IsSmart="True"
                                Header="Own Description"
                                Width="auto" />
                        <dxg:GridColumn FieldName="inquiryProduct.UOM"
                                Header="Unit of Measure"
                                IsSmart="True"
                                Width="auto" />
                        <dxg:GridColumn FieldName="inquiryProduct.quantity"
                                Header="Quantity"
                                IsSmart="True"
                                Width="auto" />
                        <dxg:GridColumn FieldName="value1"
                              Header="FOB"
                                IsSmart="True"
                                Width="auto" />
                        --><!--Header="{Binding RowData.Row.caption1}"--><!--
                        <dxg:GridColumn FieldName="value2"
                              Header="CFR"
                                IsSmart="True"
                                Width="auto" />
                    </dxg:GridControl>
                </dxg:DataControlDetailDescriptor>
            </dxg:GridControl.DetailDescriptor>-->
            <!--<dxg:GridColumn FieldName="Id"
                            Visible="False" />
            <dxg:GridColumn FieldName="referenceNo"
                            Width="auto"
                            Header="Offer Reference" />
            <dxg:GridColumn FieldName="customerCompany.company.CompanyName"
                            Width="*"
                            Header="Customer Name" />
            <dxg:GridColumn FieldName="offerDate"
                            Width="auto"
                            Header="Offer Date" />-->
            <dxg:GridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add New"
                    x:Name="btnNewOffer"
                    Click="btnNewOffer_Click" />
                    <MenuItem Header="Edit Offer"
                    x:Name="btnEditOffer"
                    Click="btnEditOffer_Click" />
                    <Separator />
                    <MenuItem Header="Delete Offer"
                    x:Name="btnDeleteOffer" />
                    <Separator />
                    <MenuItem Header="Print"
                              x:Name="mbtnPrintGrid"
                              Click="Button_Click" />
                    <!--<MenuItem Header="Create Report"
                              x:Name="mbtnReportCreate"
                              Click="MbtnReportCreate_Click" />-->
                </ContextMenu>
            </dxg:GridControl.ContextMenu>
            <dxg:GridColumn Header="Company"
                            FieldName="company.CompanyName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Customer"
                            FieldName="customerCompany.company.CompanyName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Vendor"
                            FieldName="vendor.company.CompanyName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Principal"
                            FieldName="principal.company.CompanyName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn FieldName="Department" 
                            UnboundType="String"
                            UnboundExpression="[department.parentDepartment.DeptName] +' '+ [department.DeptName]"/>

            <!--<dxg:GridColumn Header="Department"
                            FieldName="department.DeptName"
                            IsSmart="True"
                            Width="auto" />-->
            <dxg:GridColumn Header="Employee"
                            FieldName="employee.person.FName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Incoterm"
                            FieldName="incoterm.term"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="PaymentTerm"
                            FieldName="paymentTerm.term"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Currency"
                            FieldName="currency.CurrencyName"
                            IsSmart="True"
                            Width="auto"
                            />
            <dxg:GridColumn Header="Total FOB Value"
                            FieldName="totalFOBValue"
                            IsSmart="True"
                            Width="auto"
                            UnboundType="Decimal"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings> 
            </dxg:GridColumn>
            <dxg:GridColumn Header="Total CFR Value"
                            FieldName="totalCFRValue"
                            IsSmart="True"
                            Width="auto"
                            UnboundType="Decimal"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Total Base FOB Value"
                            FieldName="totalBaseFOBValue"
                            IsSmart="True"
                            Width="auto"
                            UnboundType="Decimal"
                            >
                <!--<dxg:GridColumn.DisplayTemplate>
                    <ControlTemplate>
                        <dxe:TextEdit Text="{Binding RowData.Row.totalBaseFOBValue}" MaskType="Numeric" Mask="n" MaskUseAsDisplayFormat="True"></dxe:TextEdit>
                    </ControlTemplate>
                </dxg:GridColumn.DisplayTemplate>-->
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
           
            <dxg:GridColumn Header="Margin"
                            FieldName="margin"
                            IsSmart="True"
                            Width="auto" UnboundType="Decimal"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Budgeted Margin (OC)"
                            FieldName="totalbudgetCost"
                            IsSmart="True"
                            Width="auto"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Budgeted Margin (SER)"
                            FieldName="budgetMarginSER"
                            IsSmart="True"
                            Width="auto"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Budgeted Margin (MER)"
                            FieldName="budgetMarginMER"
                            IsSmart="True"
                            Width="auto"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="SER"
                            FieldName="SER"
                            IsSmart="True"
                            Width="auto"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="MER"
                            FieldName="MER"
                            IsSmart="True"
                            Width="auto">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Commision"
                            FieldName="commision"
                            IsSmart="True"
                            Width="auto" UnboundType="Decimal"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Total Cfr Base Value"
                            FieldName="totalBaseCFRValue"
                            IsSmart="True"
                            Width="auto"
                            UnboundType="Decimal"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Total Weight"
                            FieldName="TotalWeight"
                            IsSmart="True"
                            Width="auto"
                                                        >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Total Quantity"
                            FieldName="TotalQuantity"
                            IsSmart="True"
                            Width="auto"
                            
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="offerStatus.isActive"
                      x:Name="colisOpen"
                      IsSmart="True"
                      Header="Open"
                      Visible="False"
                      Width="auto">
                <dxg:GridColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock TextAlignment="Center"
                       Text="{Binding RowData.Row.offerStatus.isActive, Converter={StaticResource valueconverter}}" />
                    </DataTemplate>
                </dxg:GridColumn.CellTemplate>
            </dxg:GridColumn>
            <dxg:GridColumn x:Name="colstatus"
                      FieldName="offerStatus.Status"
                      Header="Status"
                      IsSmart="True"
                      Visible="False"
                      VisibleIndex="6">
                <dxg:GridColumn.CellTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.offerStatus.backcolor}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.offerStatus.Status}"/>
                  </InlineUIContainer></TextBlock>
                        </Grid>
                    </DataTemplate>
                </dxg:GridColumn.CellTemplate>
            </dxg:GridColumn>
        </dxg:GridControl>
    </Grid>
</UserControl>
