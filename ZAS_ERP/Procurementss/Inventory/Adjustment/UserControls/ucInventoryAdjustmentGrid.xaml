<UserControl x:Class="ZAS_ERP.Procurementss.Inventory.Adjustment.UserControls.ucInventoryAdjustmentGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Inventory.Adjustment.UserControls" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid DataContext="{Binding  RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ucInventoryAdjustmentGrid}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto" />
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu DockPanel.Dock="Top"
              x:Name="menuGrid"
              Grid.Row="0"
              Grid.ColumnSpan="3">
            <MenuItem Header="_Print Preview"
                      x:Name="mbtnPrintPreview"
                      Click="MbtnPrintPreview_Click"></MenuItem>
            <MenuItem Header="Export To Report"
                      x:Name="mbtnExportToReport"
                      Click="MbtnExportToReport_Click"></MenuItem>
            <MenuItem Header="Refresh"
                      x:Name="mbtnRefresh"
                      Click="MbtnRefresh_Click"></MenuItem>
            <MenuItem Header="Direct Close"
                      x:Name="mbtnDriectClose"
                      Click="MbtnDriectClose_Click"></MenuItem>
            <MenuItem Header="Approve"
                          x:Name="mbtnApprove"
                          Click="MbtnApprove_Click"></MenuItem>
            <MenuItem 
                          x:Name="mbtnPending"
                          Click="MbtnPending_Click">
                <MenuItem.Template>
                    <dxg:DefaultControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending for Approval"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0" FontWeight="Bold" x:Name="txtApprovalcount" Text="{Binding ApprovalCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </dxg:DefaultControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            <MenuItem 
                          x:Name="mbtnPendingClosing"
                          Click="MbtnPendingClosing_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending for Closing"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtClosingcount" Text="{Binding ClosingCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            <MenuItem 
                          x:Name="mbtnRegister"
                          Click="MbtnRegister_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Inventory Adjustment Register"></TextBlock>

                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->

                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtApproveUnapproved" Text="{Binding ApproveunapprovedCount}" Foreground="Blue"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            <MenuItem Header="Save Layout"
                          x:Name="mbtnSaveLayout"
                          Click="MbtnSaveLayout_Click"></MenuItem>
            <MenuItem 
                          x:Name="mbtnVoid"
                          Click="MbtnVoid_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Void"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtVoidcount" Text="{Binding VoidCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
        </Menu>
        <TextBlock x:Name="lblHeading" Text="Inventory Adjustments" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  ></TextBlock>

        <dxg:GridControl x:Name="grdInventoryAdjustments"
                       AutoGenerateColumns="AddNew"
                       Grid.Row="2"        
                       AutoPopulateColumns="False"
                       Grid.Column="1"
                       MouseDoubleClick="grdInventoryAdjustments_MouseDoubleClick"         
                       SelectionMode="Row">
            <dxg:GridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add New Inventory Adjustment"
                    x:Name="btnNewAdjustment"
                    Click="btnNewAdjustment_Click" />
                </ContextMenu>
            </dxg:GridControl.ContextMenu>
            <dxg:GridControl.View>
                <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       ShowAutoFilterRow="True"
                       Width="auto"
                       RowAnimationKind="None" WaitIndicatorType="Panel"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" 
                       ShowFixedTotalSummary="True"
                       ShowTotalSummary="True">
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridColumn FieldName="Id"
                        x:Name="Id"
                        IsSmart="True"
                        Width="auto"   
                            ReadOnly="True"
                        Header="Id"
                        />
            <dxg:GridColumn FieldName="ReferenceNo"
                        x:Name="ReferenceNo"
                        IsSmart="True"
                        ReadOnly="True"    
                        Header="ReferenceNo"
                        />
            <dxg:GridColumn FieldName="CreationDate"
                        x:Name="CreationDate"
                        IsSmart="True"
                        ReadOnly="True"    
                        Header="Creation Date"
                        />
            <dxg:GridColumn FieldName="AdjustmentType"
                        x:Name="AdjustmentType"
                        IsSmart="True"
                        ReadOnly="True"    
                        Header="AdjustmentType"
                        />
            <dxg:GridColumn FieldName="Creator.userName"
                        x:Name="Creator"
                        IsSmart="True"
                        ReadOnly="True"    
                        Header="Creator"
                        />
            <dxg:GridColumn FieldName="Company.CompanyName"
                        x:Name="company"
                        IsSmart="True"
                            ReadOnly="True"
                        Header="Company"
                        />
            <dxg:GridColumn FieldName="Department.DeptName"
                        x:Name="department"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="Department"
                       />
            <dxg:GridColumn FieldName="Currency.CurrencyName"
                        x:Name="currency"
                        IsSmart="True"
                            ReadOnly="True"
                        Header="Currency"
                        />
            <dxg:GridColumn FieldName="ChartofAccount.DeptName"
                        x:Name="ChartofAccount"
                        IsSmart="True"
                            ReadOnly="True"
                        Header="Account"
                       />
            <dxg:GridColumn FieldName="AdjustmentDate"
                        x:Name="AdjustmentDate"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="AdjustmentDate"
                       />
            <dxg:GridColumn FieldName="PendingForClosing"
                        x:Name="PendingForClosing"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="PendingForClosing"
                       />
            <dxg:GridColumn FieldName="PendingForReApproval"
                        x:Name="PendingForReApproval"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="PendingForReApproval"
                       />
            <dxg:GridColumn FieldName="isApproved"
                        x:Name="isApproved"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="isApproved"
                       />
            <dxg:GridColumn FieldName="isReApproved"
                        x:Name="isReApproved"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="isReApproved"
                       />
            <dxg:GridColumn FieldName="ReApprovalDate"
                        x:Name="ReApprovalDate"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="ReApproval Date"
                       />
            <dxg:GridColumn FieldName="ApprovedDate"
                        x:Name="ApprovedDate"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="Approved Date"
                       />
            <dxg:GridColumn FieldName="isVoid"
                        x:Name="isVoid"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="isVoid"
                       />
            <dxg:GridColumn FieldName="stage"
                        x:Name="stage"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="stage"
                       />
            <dxg:GridColumn FieldName="ClosingDate"
                        x:Name="ClosingDate"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="ClosingDate"
                       />
            <dxg:GridColumn FieldName="LastStatusChangeDate"
                        x:Name="LastStatusChangeDate"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="LastStatusChangeDate"
                       />
            <dxg:GridColumn FieldName="isReviewed"
                        x:Name="isReviewed"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="isReviewed"
                       />
            <dxg:GridColumn FieldName="needReview"
                        x:Name="needReview"
                        IsSmart="True"
                        ReadOnly="True"
                        Header="needReview"
                       />
        </dxg:GridControl>
    </Grid>
</UserControl>
