<Window x:Class="ZAS_ERP.Procurementss.Inventory.Adjustment.WIndows.winInventoryAdjustmentStatusList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Inventory.Adjustment.WIndows" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        mc:Ignorable="d"
      Title="Inventory Adjustment Status List" 
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded"
        Height="450"
        Width="450">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".7*" />

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="1.4*" />
            </Grid.RowDefinitions>
            <Menu DockPanel.Dock="Top"
            x:Name="menuFormList"
            Grid.ColumnSpan="3">
                <MenuItem Header="_Inventory Adjustment Status"
                  x:Name="mbtnInventoryAdjustmentStatus">
                    <MenuItem Header="Add new Inventory Adjustment Status"
                    x:Name="mbtnNewPurchaseInvoiceStatus"
                    Click="btnNewInventoryAdjustmentStatus_Click"></MenuItem>
                    <MenuItem Header="Edit Inventory Adjustment Status"
                    x:Name="mbtnEditInventoryAdjustmentStatus"
                    Click="btnEditInventoryAdjustmentStatus_Click"></MenuItem>
                </MenuItem>

            </Menu>

            <dxg:GridControl x:Name="grdInventoryAdjustmentStatus"
                       AutoGenerateColumns="AddNew"
                       Grid.Row="1"
                       Grid.Column="2"
                       SelectionMode="Row"
                       MouseDoubleClick="grdInventoryAdjustmentStatus_MouseDoubleClick"
                       
                       >
                <dxg:GridControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add New"
                      x:Name="btnNewInventoryAdjustmentStatus"
                      Click="btnNewInventoryAdjustmentStatus_Click" />
                        <MenuItem Header="Edit"
                      x:Name="btnEditInventoryAdjustmentStatus"
                      Click="btnEditInventoryAdjustmentStatus_Click" />
                    </ContextMenu>
                </dxg:GridControl.ContextMenu>
            </dxg:GridControl>

        </Grid>
    </Grid>
</Window>
