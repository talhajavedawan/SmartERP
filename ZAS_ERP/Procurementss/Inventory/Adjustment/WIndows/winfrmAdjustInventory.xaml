<dx:DXWindow x:Class="ZAS_ERP.Procurementss.Inventory.Adjustment.WIndows.winfrmAdjustInventory"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:vali="clr-namespace:ZAS_ERP.Validations"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Inventory.Adjustment.WIndows"
             mc:Ignorable="d"
             Title="Inventory Adjustment" Height="450" Width="800" Loaded="DXWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Left" dx:ThemeManager.ThemeName="None"
                 Grid.Column="0" Orientation="Horizontal">
            <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">
                <Image  Source="/ZAS_ERP;component/images/log.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1" Click="BtnMarkReviewed_Click"  ToolTip="Approve - Mark as Reviewed">
                <Image  Source="/ZAS_ERP;component/images/approve.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnDirectClose" Grid.Column="2" Click="BtnDirectClose_Click"  ToolTip="Direct Close">
                <Image Source="/ZAS_ERP;component/images/closeLogo32x32.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" Click="BtnAddComment_Click"  ToolTip="Add New Comment">
                <Image  Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2" Click="BtnCommentLog_Click"  ToolTip="CommentLog">
                <Image  Source="/ZAS_ERP;component/images/comments.png" ></Image>
            </Button>
            <Button x:Name="btnAttachNew" Visibility="Collapsed" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Info" Click="BtnAttachNew_Click">
                <Image x:Name="imgAttachNew"  Source="/ZAS_ERP;component/images/clipattachment.png"></Image>
            </Button>
            <Button x:Name="btnAttachmentList" Visibility="Collapsed" Width="30" Height="30" Grid.Column="3" ToolTip="Info" Click="BtnAttachmentList_Click">
                <Image  Source="/ZAS_ERP;component/images/ListAttachment.png"></Image>
            </Button>
            <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnSetVoid" Visibility="Collapsed" Grid.Column="2" Click="BtnSetVoid_Click"  ToolTip="Mark as void">
                <Image  Source="/ZAS_ERP;component/images/void_order.png" ></Image>
            </Button>
            <Button x:Name="btnAttachNew1" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Attach document" Click="BtnAttachNew1_Click">
                <Image x:Name="imgAttachNew1"  Source="{dx:DXImage Image=Attachment_32x32.png}"></Image>
            </Button>
            <Button x:Name="btnAttachmentList1"  Width="30" Height="30" Grid.Column="3" ToolTip="List of Attachments" Click="BtnAttachmentList1_Click">
                <Image  Source="{dx:DXImage Image=ListNumbers_32x32.png}"></Image>
            </Button>
          
        </StackPanel>
        <Grid x:Name="grdComments" Grid.Row="1" Grid.RowSpan="3"  Visibility="Collapsed" Width="450" Height="800"  Background="Gray" Panel.ZIndex="5" VerticalAlignment="Top" Margin="35" HorizontalAlignment="Left">

            <dxg:GridControl AutoExpandAllGroups="True"  Height="auto"   dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">

                <!--#region Columns-->
                <dxg:GridControl.Columns>
                    <dxg:GridColumn  Width="auto" FieldName="employee.person.Photo" Header="Image" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:ImageEditSettings />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                    <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                    <dxg:GridColumn Width="Auto" FieldName="Subject" />
                    <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                    <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                    <dxg:GridColumn
                            Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Descending" />

                    <dxg:GridColumn x:Name="colFlag"
                      FieldName="notificationFlag.Flag"
                      Header="Flag"
                                       Image="{dx:DXImage Image=Status_16x16.png}"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="1"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PART_Editor">
                                            <InlineUIContainer>
                                                <Polygon Points="0,0 15,8, 0,15" Width="25" Margin="5 3 0 0" Stroke="{Binding RowData.Row.notificationFlag.backcolor}" Fill="{Binding RowData.Row.notificationFlag.backcolor}"/>
                                            </InlineUIContainer><Run Text=" "/>
                                            <InlineUIContainer>
                                                <TextBlock x:Name="PART_Editor2" Text="{Binding RowData.Row.notificationFlag.Flag}" Foreground="Black" FontWeight="Bold"  VerticalAlignment="Center" Margin="0 -3 0 0"/>
                                            </InlineUIContainer>
                                        </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <!--#endregion-->
                <dxg:GridControl.View>
                    <dxg:TableView 
                            x:Name="GrdCommenttableView"
                            AllowEditing="False" 
                            DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                            DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0"
                            RowStyle="{StaticResource RowStyle}"
                           
                            ShowSearchPanelMode="Always"
                            SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" 
                            ShowIndicator="False" 
                            ShowVerticalLines="False"
                            CompactPanelShowMode="Always" 
                            SwitchToCompactModeWidth="700"
                            NavigationStyle="Row"
                           >

                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Changed')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>
                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Adjustment Approved')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Adjustment UnApproved')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Adjustment Voided')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="Orange" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Adjustment UnVoided')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="Orange" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>
                        </dxg:TableView.FormatConditions>
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>

        </Grid>




        <dxlc:GroupBox  Grid.Row="1" Grid.Column="0" Header="Basic Information"  Margin="10" Padding="5" >
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                
                

                <TextBlock Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                        Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                       Margin="5"
                                   Text="Inventory Adjustment"
                                   />

                <Grid x:Name="grdInventoryStage" Grid.Row="2" Height="35" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="10" Grid.Column="0" Background="LightGray" Padding="5" x:Name="grdUnderApproval">
                    <TextBlock Text="Under Approval"  TextAlignment="Center" Padding="5" TextWrapping="WrapWithOverflow" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                </Border>

                <Border CornerRadius="10" Grid.Column="1" Background="LightGray" Padding="5" x:Name="grdApproved" Margin="2 0 0 0">
                    <TextBlock Text="Approved"  Grid.Column="1" TextWrapping="Wrap" Padding="5" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                </Border>

                <Border CornerRadius="10" Grid.Column="2" Background="LightGray" Padding="5" x:Name="grdUnderClosing" Margin="2 0 0 0">
                    <TextBlock Text="Under Closing"  Grid.Column="2" TextWrapping="Wrap" Padding="5" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                </Border>

                <Border CornerRadius="10" Grid.Column="3" Background="LightGray" Padding="5" x:Name="grdClosed" Margin="2 0 0 0">
                    <TextBlock Text="Closed"  Grid.Column="3" TextWrapping="Wrap" Padding="5" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Stretch">

                    <!--<TextBlock Text="Status"
                                       x:Name="lblStage"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       Foreground="Black"/>-->

                    <TextBlock Visibility="Collapsed" Text=" (Amount Paid)"
                                       x:Name="lblBillPaid"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       Foreground="Black"/>
                </StackPanel>


            </Grid>
                <TextBlock x:Name="lblAdjustCompany" Text="Company" Grid.Row="3" Grid.Column="0" Margin="5"/>

                <dxg:LookUpEdit x:Name="lookupCompany"
                          Grid.Column="1" 
                          Grid.Row="3"
                          TabIndex="5"
                          DisplayMember="CompanyName"
                          AutoPopulateColumns="False"
                          VerticalAlignment="Center"
                          SelectedIndexChanged="lookupCompany_SelectedIndexChanged">
                    <dxg:LookUpEdit.StyleSettings>
                        <dxg:LookUpEditStyleSettings />
                    </dxg:LookUpEdit.StyleSettings>
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>
                                <!--<Button x:Name="btnAddCompany"
                            Click="btnAddCompany_Click"
                            VerticalAlignment="Center"
                            Content="Add New" />-->
                                <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                                    <dxg:GridControl.View>
                                        <dxg:TableView Name="tableView1"
                                     ShowAutoFilterRow="True" />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                    <dxg:GridColumn FieldName="CompanyName"
                                    IsSmart="True" />
                                    <!--<dxg:GridColumn FieldName="IndustryType"
                                      IsSmart="True"
                                      Visible="False" />-->
                                    <dxg:GridColumn x:Name="colBizType"
                                    FieldName="BizType"
                                    Visible="False"
                                    IsSmart="True" />
                                    <dxg:GridColumn FieldName="EmployeerNo"
                                    x:Name="colEmployeerNo"
                                    IsSmart="True"
                                    Visible="False" />
                                    <!--<dxg:GridColumn FieldName="addressId"
                                      x:Name="coladressId"
                                      IsSmart="True"
                                      Visible="False" />
                      <dxg:GridColumn FieldName="address"
                                      IsSmart="True"
                                      x:Name="coladress"
                                      Visible="False" />
                      <dxg:GridColumn FieldName="contactId"
                                      Visible="False"
                                      x:Name="colcontactId"
                                      IsSmart="True" />-->
                                    <!--<dxg:GridColumn FieldName="contact"
                                      x:Name="colcontact"
                                      IsSmart="True"
                                      Visible="False" />-->
                                </dxg:GridControl>
                            </Grid>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>

                <TextBlock x:Name="lblAdjustDepartment" Text="Department" Grid.Row="4" Grid.Column="0" Margin="5"/>
                <dxg:LookUpEdit x:Name="lookupDepartment"
                          Grid.Column="1" 
                          Grid.Row="4"
                          TabIndex="6"
                          VerticalAlignment="Center"
                          AutoPopulateColumns="True"
                          DisplayMember="DeptName"
                          SelectedIndexChanged="lookupDepartment_SelectedIndexChanged">
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Button x:Name="btnAddDepartment"
                          VerticalAlignment="Center"
                           />
                                <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1">
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView Name="treeListView1"
                                        ShowAutoFilterRow="True"
                                        TreeDerivationMode="Selfreference"
                                        KeyFieldName="Id"
                                        ParentFieldName="ParentID" />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="Id"
                                    x:Name="coldeptid"
                                    IsSmart="True"
                                    Visible="False" />
                                    <dxg:GridColumn x:Name="coldeptname"
                                    FieldName="DeptName"
                                    IsSmart="True" />
                                    <dxg:GridColumn x:Name="coldeptcode"
                                    FieldName="Code"
                                    IsSmart="True" />
                                    <dxg:GridColumn FieldName="Abbrivation"
                                    IsSmart="True"
                                    x:Name="coldeptabr"
                                    Visible="True" />
                                    <dxg:GridColumn FieldName="Timestamp"
                                    IsSmart="True"
                                    x:Name="coldeptts"
                                    Visible="False" />
                                </dxg:GridControl>
                            </Grid>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>

                <TextBlock x:Name="lblCreator" Text="Creator" Grid.Row="5" Grid.Column="0" Margin="5"/>
                <ComboBox x:Name="cmbEmployee"
                    VerticalAlignment="Top"
                    Grid.Column="1"
                    Grid.Row="5"
                    SelectionChanged="cmbEmployee_SelectionChanged" Margin="0,2,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Text="{Binding id}"
                             Visibility="Hidden" />
                                <TextBlock Text="{Binding name}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>


            </Grid>
        </dxlc:GroupBox>

        <dxlc:GroupBox x:Name="grpInventInfo" Grid.Row="1" Margin="10" Padding="5" Header="Inventory Adjustment Detail" Grid.Column="1"  >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="lblAdjustRef" Text="Adjustment ref#" Grid.Row="0" Grid.Column="0" Margin="5"/>
                <TextBlock x:Name="lblAdjustType" Text="Adjustment Type" Grid.Row="1" Grid.Column="0" Margin="5"/>
                <TextBlock x:Name="lblAdjustDate" Text="Adjustment Date" Grid.Row="2" Grid.Column="0" Margin="5"/>
                <TextBlock x:Name="lblAdjustAccount" Text="Adjustment Account" Grid.Row="1" Grid.Column="2" Margin="5"/>
                <TextBlock x:Name="lblCurrency" Text="Currency" Grid.Row="2" Grid.Column="2" Margin="5"/>
                <TextBlock x:Name="lblStatus" Text="Status" Grid.Row="0" Grid.Column="2" Margin="5"/>
                <dxe:TextEdit x:Name="txtAdjustRef" Grid.Column="1" Grid.Row="0" />
                <ComboBox x:Name="cmbAdjustmentType"
                    VerticalAlignment="Top"
                    Grid.Column="1"
                    Grid.Row="1"
                          IsEnabled="False"
                    SelectionChanged="cmbAdjustmentType_SelectionChanged" Margin="0,2,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Text="{Binding id}"
                             Visibility="Hidden" />
                                <TextBlock Text="{Binding name}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <dxe:DateEdit VerticalAlignment="Center" MaskType="DateTime"   MaskUseAsDisplayFormat="True" Mask="dd/MMMM/yyyy"
                                  x:Name="datAdjustdate"
                                  Grid.Column="1"
                                  Grid.Row="2"
                              
                                  TabIndex="2"
                                   />

                <dxg:LookUpEdit x:Name="lookupReceivableAccounts"
                    Grid.Column="5"
                              DisplayMember="accountName"    
                                     Cursor="Hand"
                                    ShowNullText="True"
                                    NullText="Select Adjustment Account"
                    Grid.Row="1">
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>

                                <dxg:GridControl Name="PART_GridControl"
                             Grid.Row="1">
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView Name="treeListView1"
                                                                   
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="Account Name"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                </dxg:GridControl>
                            </Grid>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>

                <ComboBox x:Name="cmbCurrency"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                      Grid.Row="2"
                      TabIndex="37"
                      SelectionChanged="cmbCurrency_SelectedIndexChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                                <TextBlock Text="{Binding name}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid  Grid.Column="3"
                      VerticalAlignment="Center"
                      Grid.Row="0"
                              HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbStatus" 
                                    VerticalAlignment="Center"
                    Grid.Column="0"
                    Grid.Row="0" 
                    TabIndex="10"
                    >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding id}"
                             Visibility="Hidden" />
                                    <TextBlock Text="   "
                             Background="{Binding bcolor}"
                             Width="20"
                             Margin="10,0" />
                                    <TextBlock Text="{Binding name}"
                             Grid.Column="1"
                             Foreground="{Binding fcolor}"
                             HorizontalAlignment="Stretch"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <dxe:DateEdit IsReadOnly="True" MaskType="DateTime"   MaskUseAsDisplayFormat="True" Mask="dd/MMMM/yyyy" VerticalAlignment="Center" ToolTip="Status Last Changed Date" IsEnabled="False" Grid.Column="1" HorizontalAlignment="Stretch" x:Name="datLastStatusChangeDate"></dxe:DateEdit>
                </Grid>

            </Grid>
        </dxlc:GroupBox>
        <dxlc:GroupBox Grid.Row="2" Grid.Column="0"  Header="Adjustment Items" Grid.ColumnSpan="2" >

            <dxg:GridControl x:Name="grdInventoryItem"
                         SelectionMode="Cell"       
                             CustomUnboundColumnData="grdInventoryItem_CustomUnboundColumnData"
                          ItemsSource="transactions"
                         dx:DXSerializer.SerializationID="grid">
                <dxg:GridControl.View>
                    <dxg:TableView AutoWidth="True"
                           ShowGroupPanel="False"
                           NewItemRowPosition="Bottom"
                           AllowColumnFiltering="False"
                           ShowTotalSummary="True"
                            CellValueChanged="view_CellValueChanged"      
                           ShowHorizontalLines="True"
                           ShowVerticalLines="True"                
                           x:Name="view">
                    </dxg:TableView>
                </dxg:GridControl.View>
          
                <dxg:GridColumn  x:Name="productName"
                        FieldName="Product"
                          Header="Item"
                          IsSmart="True"
                          VisibleIndex="0"          
                          UnboundType="bound"
                          UnboundExpression="[code]" SortOrder="Ascending" SortIndex="0">
                    <dxg:GridColumn.DisplayTemplate>
                        <ControlTemplate>
                            <TextBlock Text="{Binding RowData.Row.Product.code}"></TextBlock>
                        </ControlTemplate>
                    </dxg:GridColumn.DisplayTemplate>
                    <dxg:GridColumn.EditSettings>
                        <dxg:LookUpEditSettings x:Name="lookupInventoryProductsinGrid"
                                      AutoPopulateColumns="False"
                                      IsPopupAutoWidth="False"
                                      DisplayMember="code"
                                      NullText="Select Item">
                            <dxg:LookUpEditSettings.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                        </Grid.RowDefinitions>

                                        <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                            <dxg:GridColumn FieldName="code" />
                                            <dxg:GridColumn FieldName="item" />
                                            <dxg:GridColumn FieldName="itemDescription" />
                                            <dxg:GridColumn FieldName="unitOfMeasure.unitOfMeasure"
                                        Header="Unit Of Measure" />
                                            <dxg:GridColumn FieldName="nature.nature"
                                        Header="Nature" />
                                            <dxg:GridColumn FieldName="category.category"
                                        Header="Category" />
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEditSettings.PopupContentTemplate>
                        </dxg:LookUpEditSettings>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn FieldName="Product.item"
                          Header="Item Description"
                          VisibleIndex="1">
                </dxg:GridColumn>
               
                <dxg:GridColumn FieldName="UnitRate"
                          Header="Unit Rate"
                                ReadOnly="True"
                          VisibleIndex="1">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Quantity"
                          Header="New Qty"
                          VisibleIndex="2">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="OnHand"
                   x:Name="OnHand"
                        IsSmart="True"
                        Header="On Hand"
                        VisibleIndex="4"
                                ReadOnly="True"
                                UnboundType="Decimal"
                           
                       
                        Visible="True"
                        AllowSorting="false" 
                        >
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="AverageCost"
                          Header="Avg.Cost"
                               
                               
                          VisibleIndex="3">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="AmountOC"
                          Header="Amount (OC)"
                               
                             
                          VisibleIndex="4">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="AmountMER"
                          Header="Amount (MER)"
                                UnboundType="Decimal"
                              ReadOnly="True"
                                UnboundExpression="[MER] * [AmountOC]"
                          VisibleIndex="6">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="MER"
                          Header="MER"
                            
                           
                          VisibleIndex="5">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="c4" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
            </dxg:GridControl>
        </dxlc:GroupBox>
        <Button x:Name="btnSave" Grid.Row="3" Grid.ColumnSpan="2" MinHeight="30" FontWeight="DemiBold"  Content="Save" Click="btnSave_Click"/>

        <Grid Panel.ZIndex="5" Grid.ColumnSpan="3" x:Name="grdVoid" Visibility="Collapsed" 
              VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="170,0,206,290" Grid.RowSpan="4">
            <!--<TextBox  Width="250"  VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="SearchTermTextBox" Margin="5"/>-->
            <TextBlock IsHitTestVisible="False" x:Name="txtVoid" 
                       Text="-VOID-" FontSize="200" 
                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-58,210,58,-210" Foreground="Chocolate" Opacity="0.3">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTermTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.RenderTransform>

                    <RotateTransform CenterX="0" CenterY="0" Angle="-45" />

                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>

    </Grid>
</dx:DXWindow>
