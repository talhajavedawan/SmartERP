<UserControl xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" 
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Procurementss.Inventory.ucIVDetailReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Inventory"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
    xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    mc:Ignorable="d"
        Height="auto" Width="auto"  Loaded="Window_Loaded"  >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderThickness="2" BorderBrush="Beige"  CornerRadius="6"  Margin="5,5,5,5">
            <dxwui:PageAdornerControl x:Name="adornerCont" Header="Inventory Valuation Detail Report"  FontSize="22" FontWeight="Bold"   FontFamily="Segoe UI Semibold" Grid.Row="0" >
            <dxwui:PageAdornerControl.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                                <dxwui:NavigationButton FontSize="14" Margin="10, 0, 0, 0" BorderThickness="20"    Content="Refresh Report"  Cursor="Hand"  Click="MbtnRefresh_Click" />
                                <dxwui:NavigationButton x:Name="btnPrint" FontSize="14" Margin="10, 0, 0, 0" BorderThickness="20"    Content="Print Preview"  Cursor="Hand"  Click="BtnPrint_Click" />

                            </StackPanel>
                    </Grid>
                </DataTemplate>
            </dxwui:PageAdornerControl.HeaderTemplate>
        </dxwui:PageAdornerControl>
        </Border>
        <Border Grid.Row="1" BorderThickness="3" BorderBrush="Beige"  CornerRadius="6"  Margin="5,5,5,5" >
            <dxlc:LayoutGroup  Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <dxg:GridControl x:Name="grdItems"
                       AutoGenerateColumns="None"
                       Grid.Row="2"
                       SelectionMode="Row"
                                 
                       MouseDoubleClick="GrdItems_MouseDoubleClick"
                       CustomUnboundColumnData="GrdItems_CustomUnboundColumnData"
                       >
                        <dxg:GridControl.View>
                            <dxg:TableView ShowFixedTotalSummary="True" AllowGrouping="False" AutoWidth="True"  ShowGroupPanel="False" ShowTotalSummary="True"/>
                        </dxg:GridControl.View>
                        <dxg:GridControl.DetailDescriptor>
                            <dxg:DataControlDetailDescriptor ShowHeader="True"
                                         x:Name="detailGridInventories"
                                         ItemsSourcePath="Inventories">
                                <dxg:DataControlDetailDescriptor.DataControl>
                                    <dxg:GridControl x:Name="grdInventory" SelectionMode="Row" 
                                         
                                         dx:DXSerializer.SerializationID="grid" >
                                        <dxg:GridControl.View>
                                            <dxg:TableView DetailHeaderContent="All Transactions"
                              
                                               ShowGroupPanel="False" 
                                               FilterRowDelay="1000"      
                                               RowAnimationKind="Opacity" WaitIndicatorType="Panel"
                                               AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                               ShowFixedTotalSummary="True"
                                               ShowTotalSummary="True"                
                                               HorizontalScrollbarVisibility="Visible"
                                               ShowHorizontalLines="True"
                                               ShowVerticalLines="True"      
                                               Width="auto"                 
                                               ColumnFilterPopupMode="Excel"  
                                               NavigationStyle="Row"
                                               AutoWidth="True"
                                               />
                                        </dxg:GridControl.View>
                                        <dxg:GridColumn FieldName="creationDate"
                                                        Header="Creation Date"
                                                        IsSmart="True"
                                                        VisibleIndex="0"
                                                        UnboundType="String"
                                                        ReadOnly="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:DateEditSettings Mask="g" MaskUseAsDisplayFormat="True"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="transactionRefno"
                                                        Header="Transaction Ref"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        UnboundExpression="String"
                                                        VisibleIndex="1"  >

                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="TransactionsType"
                                                        ReadOnly="True"
                                                        AllowSorting="false"
                                                        Header="Transaction Type" 
                                                        VisibleIndex="2">

                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Currency.CurrencyName"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        VisibleIndex="3"
                                                        Header="Currency"  >
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="company.CompanyName"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        VisibleIndex="4"
                                                        Header="Company"  >
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="department.DeptName"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        VisibleIndex="5"
                                                        Header="Department">
                                        </dxg:GridColumn>
                                       
                                        <dxg:GridColumn FieldName="creator.userName"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        VisibleIndex="7"
                                                        Header="Creator">


                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Quantity"
                                                        VisibleIndex="8"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        Header="Quantity">
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="UnitRate"
                                                        VisibleIndex="9"
                                                        AllowSorting="false"
                                                        ReadOnly="True" 
                                                        Header="Unit Rate">
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="AverageCost"
                                                        x:Name="AverageCost"
                                                        IsSmart="True"
                                                        Header="Avg.Cost"  
                                                        AllowMoving="false"
                                                        AllowSorting="false"
                                                        VisibleIndex="10"
                                                        UnboundType="Decimal"            
                                                        ReadOnly="True"
                                                        Visible="True"
                                                        Width="auto">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="AmountOC"
                                                        Header="Amount(OC)"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        VisibleIndex="11"
                                                        UnboundExpression="Decimal">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="MER"
                                                        AllowSorting="false"
                                                        ReadOnly="True"
                                                        VisibleIndex="12"
                                                        Header="MER">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings MaskType="Numeric" Mask="c4" MaskUseAsDisplayFormat="True"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="AmountMER"
                                                        Header="Amount(PKR)"
                                                        ReadOnly="True"
                                                        VisibleIndex="13"
                                                        AllowSorting="false"
                                                        UnboundExpression="Decimal">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridControl.TotalSummary >
                                            <dxg:GridSummaryItem FieldName="Quantity"  SummaryType="Sum"    DisplayFormat="{}{0:n2}" />
                                            <dxg:GridSummaryItem FieldName="AmountOC" SummaryType="Sum" DisplayFormat="{}{0:n2}" />
                                            <dxg:GridSummaryItem FieldName="AmountMER" SummaryType="Sum" DisplayFormat="{}{0:n2}"  />
                                        </dxg:GridControl.TotalSummary>
                                    </dxg:GridControl>

                                </dxg:DataControlDetailDescriptor.DataControl>
                            </dxg:DataControlDetailDescriptor>
                        </dxg:GridControl.DetailDescriptor>
                        <dxg:GridColumn FieldName="item"
                                        x:Name="item"
                                        IsSmart="True"
                                                  
                                        Header="Item"
                                        VisibleIndex="1"   
                                        ReadOnly="True"
                                        AllowMoving="false"  
                                        AllowSorting="false" 
                                        Visible="True"            
                                        SortOrder="Ascending" SortIndex="0"/>
                        <dxg:GridColumn FieldName="code"
                                        x:Name="code"
                                        IsSmart="True"
                                        Header="Code"                            
                                        VisibleIndex="2"   
                                        AllowSorting="false" 
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        />
                        <dxg:GridColumn FieldName="company.CompanyName"
                                        x:Name="company"
                                        IsSmart="True"
                                        Header="Company"
                                        VisibleIndex="3"       
                                        ReadOnly="True"
                                        AllowSorting="false" 
                                        AllowMoving="false"  
                                        Visible="True"
                                        />
                        <dxg:GridColumn FieldName="Departments"
                                        x:Name="Departments"
                                        IsSmart="True"
                                        Header="Departments"
                                        UnboundType="String"
                                        VisibleIndex="3"       
                                        ReadOnly="True"
                                        AllowSorting="false" 
                                        AllowMoving="false"  
                                        Visible="True"/>
                        <dxg:GridColumn FieldName="OnHand"
                                        x:Name="OnHand"
                                        IsSmart="True"
                                        Header="On Hand"
                                        VisibleIndex="4"
                                        UnboundType="Decimal"        
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        AllowSorting="false" 
                                        >
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="AvgCost"
                                        x:Name="AvgCost"
                                        IsSmart="True"
                                        Header="Avg.Cost"
                                        VisibleIndex="5"
                                        UnboundType="Decimal"          
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        >
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="AmountOC"
                                        x:Name="AmountOC"
                                        IsSmart="True"
                                        Header="Amount(OC)"
                                        VisibleIndex="6"
                                        UnboundType="Decimal"    
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        AllowSorting="false" 
                                        >
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="AmountPKR"
                                        x:Name="AmountPKR"
                                        IsSmart="True"
                                        Header="Amount(PKR)"
                                        VisibleIndex="7"
                                        UnboundType="Decimal"            
                                        ReadOnly="True"
                                         AllowMoving="false"               
                                        AllowSorting="false"            
                                        Visible="True"
                                       >
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl>
                </Grid>
            </dxlc:LayoutGroup>
        </Border>
    </Grid>
</UserControl>
