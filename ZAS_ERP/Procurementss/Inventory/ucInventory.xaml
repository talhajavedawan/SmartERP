<UserControl xmlns:dxdiag="http://schemas.devexpress.com/winfx/2008/xaml/diagram"  xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" 
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Inventory"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui" x:Class="ZAS_ERP.Procurementss.Inventory.ucInventory"
    mc:Ignorable="d"
         Height="auto" Width="auto" Loaded="Window_Loaded" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderThickness="2" BorderBrush="Beige"    CornerRadius="6"  Margin="5,5,5,5">
            <dxwui:PageAdornerControl x:Name="adornerCont"  Header="Inventory Valuation Summary" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  FontSize="22" FontWeight="Bold"   FontFamily="Segoe UI Semibold" Grid.Row="0"  >
                <dxwui:PageAdornerControl.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding}" VerticalAlignment="Center"  />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                                <dxwui:NavigationButton FontSize="14" Margin="10, 0, 0, 0" BorderThickness="20"    Content="DETAIL REPORT"  Cursor="Hand" NavigateTo="ucIVDetailReport"  />
                                <dxwui:NavigationButton FontSize="14" Margin="10, 0, 0, 0" BorderThickness="20"    Content="Refresh Report"  Cursor="Hand"  Click="MbtnRefresh_Click" />
                                <dxwui:NavigationButton x:Name="btnPrint" FontSize="14" Margin="10, 0, 0, 0" BorderThickness="20"    Content="Print Preview"  Cursor="Hand"  Click="BtnPrint_Click" />

                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </dxwui:PageAdornerControl.HeaderTemplate>
            </dxwui:PageAdornerControl>
        </Border>
        <Border Grid.Row="1" BorderThickness="2" BorderBrush="Beige" CornerRadius="6" Margin="5,5,5,5">
            <dxlc:LayoutGroup  Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                
                    <!--<TextBlock Grid.Row="1" x:Name="lblHeading" Text="Inventory Valuation Summary"  FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center"  FontFamily="Segoe UI Semibold"  ></TextBlock>-->
                    <dxg:GridControl x:Name="grdItems"
                       AutoGenerateColumns="AddNew"
                       Grid.Row="2"        
                       AutoPopulateColumns="False"
                       Grid.Column="1"
                       MouseDoubleClick="GrdItems_MouseDoubleClick"         
                       SelectionMode="Row">
                        <dxg:GridControl.View>
                            <dxg:TreeListView x:Name="view"
                                    AllowEditing="False"
                                    NavigationStyle="Row"
                                    AutoExpandAllNodes="False"   
                                    ShowAutoFilterRow="True"
                                    TreeDerivationMode="Selfreference"
                                    KeyFieldName="Id"
                                    AutoPopulateServiceColumns="False"            
                                    AutoWidth="True"
                                    ShowTotalSummary="True"    
                                    ParentFieldName="parentId"
                                    CustomUnboundColumnData="view_CustomUnboundColumnData"
                                    RowAnimationKind="None" 
                                    WaitIndicatorType="Panel"      
                                    FilterMode="Extended"
                                    FadeSelectionOnLostFocus="True"
                                    ShowSelectionRectangle="True"
                                  />
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="item"
                        x:Name="item"
                        IsSmart="True"
                        Width="auto"            
                        Header="Item"
                        VisibleIndex="1"   
                        ReadOnly="True"
                        AllowSorting="false" 
                        Visible="True"            
                        SortOrder="Ascending" SortIndex="0"/>
                        <dxg:GridColumn FieldName="code"
                        x:Name="code"
                        IsSmart="True"
                        Header="Code"
                        VisibleIndex="2"   
                        AllowSorting="false" 
                        ReadOnly="True"
                        Visible="True"
                        Width="auto"/>
                        <dxg:GridColumn FieldName="company.CompanyName"
                        x:Name="company"
                        IsSmart="True"
                        Header="Company"
                        VisibleIndex="3"       
                        ReadOnly="True"
                        AllowSorting="false" 
                        Visible="True"
                        Width="auto"/>
                        <dxg:GridColumn FieldName="OnHand"
                        x:Name="OnHand"
                        IsSmart="True"
                        Header="On Hand"
                        VisibleIndex="4"
                        UnboundType="Decimal"            
                        ReadOnly="True"
                        Visible="True"
                        AllowSorting="false" 
                        Width="auto">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="AvgCost"
                        x:Name="AvgCost"
                        IsSmart="True"
                        Header="Avg.Cost"
                        VisibleIndex="5"
                        UnboundType="Decimal"            
                        ReadOnly="True"
                        Visible="True"
                        Width="auto">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="AmountOC"
                        x:Name="AmountOC"
                        IsSmart="True"
                        Header="Amount(OC)"
                        VisibleIndex="6"
                        UnboundType="Decimal"            
                        ReadOnly="True"
                        Visible="True"
                                     AllowSorting="false" 
                        Width="auto">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="AmountMER"
                        x:Name="AmountPKR"
                        IsSmart="True"
                        Header="Amount(PKR)"
                        VisibleIndex="7"
                        UnboundType="Decimal"            
                        ReadOnly="True"
                        AllowSorting="false"            
                        Visible="True"
                        Width="auto">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl>
                </Grid>
            </dxlc:LayoutGroup>
        </Border>


    </Grid>











</UserControl>
