<Window x:Class="ZAS_ERP.Inquiriess.frmInquiryadd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Inquiriess"
        xmlns:vali="clr-namespace:ZAS_ERP.Validations"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        mc:Ignorable="d"
        Title="Add New Inquiry"
        Height="650"
        Width="700"
        x:Name="wininquiryadd"
        Loaded="wininquiryadd_Loaded"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="HorizontalAlignment"
                Value="Left" />
        <Setter Property="Foreground"
                Value="DarkGray" />
        <Setter Property="Margin"
                Value="10,10" />
      </Style>
    </Grid.Resources>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="20" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="20" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="50" />
      </Grid.RowDefinitions>
      <TextBlock Text="Customer Name"
                 Grid.Column="1"
                 Grid.Row="1" />
      <dxg:LookUpEdit x:Name="lookupCustomer"
                      Grid.Column="2"
                      Grid.Row="1"
                      VerticalAlignment="Center"
                      SelectedIndexChanged="lookupCustomer_SelectedIndexChanged">
        <dxg:LookUpEdit.PopupContentTemplate>
          <ControlTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="200"></RowDefinition>
              </Grid.RowDefinitions>
              <Button x:Name="btnAddCustomer"
                      Click="btnAddCustomer_Click"
                      VerticalAlignment="Center"
                      Content="--Add New--" />
              <dxg:GridControl Name="PART_GridControl"
                               AutoPopulateColumns="True"
                               Grid.Row="1">
                <dxg:GridControl.View>
                  <dxg:TreeListView Name="treeListView1"
                                    ShowAutoFilterRow="True"
                                    TreeDerivationMode="Selfreference"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID" />
                </dxg:GridControl.View>
                <dxg:GridColumn x:Name="colId"
                                FieldName="Id"
                                IsSmart="True"
                                Visible="False" />
                <dxg:GridColumn FieldName="company.CompanyName"
                                IsSmart="True"
                                Width="auto" />
                <dxg:GridColumn FieldName="company.IndustryType"
                                IsSmart="True"
                                Visible="False" />
                <dxg:GridColumn x:Name="colBizType"
                                FieldName="company.BizType"
                                Visible="False"
                                IsSmart="True" />
                <dxg:GridColumn FieldName="contactPerson.FName"
                                x:Name="colFname"
                                IsSmart="True"
                                Visible="True"
                                Header="First Name"
                                Width="auto" />
                <dxg:GridColumn FieldName="contactPerson.LName"
                                x:Name="colLname"
                                IsSmart="True"
                                Visible="True"
                                Header="Last Name"
                                Width="auto" />
                <dxg:GridColumn FieldName="contact.ContactNo"
                                IsSmart="True"
                                x:Name="colcontactno"
                                Visible="True"
                                Header="Phone"
                                Width="auto" />
                <dxg:GridColumn FieldName="company.currency.CurrencyName"
                                x:Name="colCurrency"
                                IsSmart="True"
                                Visible="False"
                                Header="Currency" />
                <dxg:GridColumn FieldName="contact.Fax"
                                Visible="False"
                                x:Name="colFax"
                                IsSmart="True"
                                Header="Fax" />
                <dxg:GridColumn FieldName="contact.Email"
                                x:Name="colEmail"
                                IsSmart="True"
                                Visible="False"
                                Header="Email" />
              </dxg:GridControl>
            </Grid>
          </ControlTemplate>
        </dxg:LookUpEdit.PopupContentTemplate>
      </dxg:LookUpEdit>
      <TextBlock x:Name="label1"
                 VerticalAlignment="Center"
                 Grid.Row="2"
                 Grid.Column="1"><Run Text="InquiryStatus" /></TextBlock>
      <!--<ComboBox VerticalAlignment="Center"
                Grid.Column="2"
                x:Name="cmbsubcustomer"
                Grid.Row="2"
                SelectionChanged="cmbsubcustomer_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel  Orientation="Horizontal">
              <TextBlock Text="{Binding id}"
                         Visibility="Hidden" />
              <TextBlock Text="{Binding name}"></TextBlock>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>-->
      <TextBlock VerticalAlignment="Center"
                 Grid.Column="1"
                 Grid.Row="3"
                 Text="Inquiry Type " />
      <ComboBox VerticalAlignment="Center"
                Grid.Column="2"
                Grid.Row="3"
                x:Name="cmbInquiryType">
        <!--<ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel  Orientation="Horizontal">
              <TextBlock 
                         Text="{Binding id}"
                         Visibility="Hidden" />
              <TextBlock Text="{Binding name}"
                         ></TextBlock>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>-->
      </ComboBox>
      <TextBlock VerticalAlignment="Center"
                 Grid.Column="1"
                 Grid.Row="6"
                 Text="Due Date " />
      <TextBlock VerticalAlignment="Center"
                 Grid.Column="1"
                 Grid.Row="4"
                 Text="Inquiry Reference #" />
      <TextBox Grid.Column="2"
               x:Name="txtinquiryref"
               Grid.Row="4"
               VerticalAlignment="Center"></TextBox>
      <dxe:DateEdit VerticalAlignment="Center"
                    x:Name="datinquirydate"
                    Grid.Column="2"
                    Grid.Row="5" />
      <TextBlock VerticalAlignment="Center"
                 Grid.Column="1"
                 Grid.Row="5"
                 Text="Inquiry Date" />
      <dxe:DateEdit VerticalAlignment="Center"
                    x:Name="datduedate"
                    Grid.Column="2"
                    Grid.Row="6" />
      <!--<CheckBox x:Name="chkisempActive"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Grid.Column="2"
                Grid.Row="7" />-->
      <dxg:LookUpEdit x:Name="lookupCompany"
                      Grid.Column="5"
                      Grid.Row="1"
                      VerticalAlignment="Center"
                      SelectedIndexChanged="lookupCompany_SelectedIndexChanged">
        <dxg:LookUpEdit.PopupContentTemplate>
          <ControlTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
              </Grid.RowDefinitions>
              <Button x:Name="btnAddCompany"
                      Click="btnAddCompany_Click"
                      VerticalAlignment="Center"
                      Content="--Add New--" />
              <dxg:GridControl Name="PART_GridControl"
                               AutoPopulateColumns="True" Grid.Row="1">
                <dxg:GridControl.View>
                  <dxg:TableView Name="tableView1"
                                 ShowAutoFilterRow="True" />
                </dxg:GridControl.View>
                <dxg:GridColumn FieldName="CompanyName"
                                IsSmart="True" />
                <dxg:GridColumn FieldName="IndustryType"
                                IsSmart="True"
                                Visible="False" />
                <dxg:GridColumn x:Name="colBizType"
                                FieldName="BizType"
                                Visible="False"
                                IsSmart="True" />
                <dxg:GridColumn FieldName="EmployeerNo"
                                x:Name="colEmployeerNo"
                                IsSmart="True"
                                Visible="False" />
                <dxg:GridColumn FieldName="addressId"
                                x:Name="coladressId"
                                IsSmart="True"
                                Visible="False" />
                <dxg:GridColumn FieldName="address"
                                IsSmart="True"
                                x:Name="coladress"
                                Visible="False" />
                <dxg:GridColumn FieldName="contactId"
                                Visible="False"
                                x:Name="colcontactId"
                                IsSmart="True" />
                <dxg:GridColumn FieldName="contact"
                                x:Name="colcontact"
                                IsSmart="True"
                                Visible="False" />
              </dxg:GridControl>
            </Grid>
          </ControlTemplate>
        </dxg:LookUpEdit.PopupContentTemplate>
      </dxg:LookUpEdit>
      <TextBlock VerticalAlignment="Center"
                 Grid.Column="4"
                 Grid.Row="1"
                 Text="Company" />
      <dxg:LookUpEdit x:Name="lookupDepartment"
                      Grid.Column="5"
                      Grid.Row="2"
                      VerticalAlignment="Center"
                      SelectedIndexChanged="lookupDepartment_SelectedIndexChanged">
        <dxg:LookUpEdit.PopupContentTemplate>
          <ControlTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
              </Grid.RowDefinitions>
              <Button x:Name="btnAddDepartment"
                      Click="btnAddDepartment_Click"
                      VerticalAlignment="Center"
                      Content="--Add New--" />
              <dxg:GridControl Name="PART_GridControl"
                               AutoPopulateColumns="True" Grid.Row="1">
                <dxg:GridControl.View>
                  <dxg:TreeListView Name="treeListView1"
                                    ShowAutoFilterRow="True"
                                    TreeDerivationMode="Selfreference"
                                    KeyFieldName="Id"
                                    ParentFieldName="ParentID" />
                </dxg:GridControl.View>
                <dxg:GridColumn FieldName="Id"
                                x:Name="coldeptid"
                                IsSmart="True"
                                Visible="False" />
                <dxg:GridColumn x:Name="coldeptname"
                                FieldName="DeptName"
                                IsSmart="True" />
                <dxg:GridColumn x:Name="coldeptcode"
                                FieldName="Code"
                                IsSmart="True" />
                <dxg:GridColumn FieldName="Abbrivation"
                                IsSmart="True"
                                x:Name="coldeptabr"
                                Visible="False" />
                <dxg:GridColumn FieldName="Timestamp"
                                IsSmart="True"
                                x:Name="coldeptts"
                                Visible="False" />
                <dxg:GridColumn FieldName="sectionId"
                                IsSmart="True"
                                Visible="False" />
                <dxg:GridColumn FieldName="sections"
                                IsSmart="True"
                                Visible="False" />
              </dxg:GridControl>
            </Grid>
          </ControlTemplate>
        </dxg:LookUpEdit.PopupContentTemplate>
      </dxg:LookUpEdit>
      <TextBlock VerticalAlignment="Center"
                 Grid.Column="4"
                 Grid.Row="2"
                 Text="Department" />
      <ComboBox x:Name="cmbEmployee"
                VerticalAlignment="Center"
                Grid.Column="5"
                Grid.Row="3"
                SelectionChanged="cmbEmployee_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel  Orientation="Horizontal">
              <TextBlock Text="{Binding id}"
                         Visibility="Hidden" />
              <TextBlock Text="{Binding name}"></TextBlock>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock VerticalAlignment="Center"
                 Grid.Column="4"
                 Grid.Row="3"
                 Text="Allocate to" />
      <TextBox x:Name="txtfileref"
               VerticalAlignment="Center"
               Grid.Column="5"
               Grid.Row="4"></TextBox>
      <TextBlock VerticalAlignment="Center"
                 Grid.Column="4"
                 Grid.Row="4"
                 Text="File Reference #" />
      <TextBlock VerticalAlignment="Center"
                 Grid.Column="4"
                 Grid.Row="5"
                 Text="Closing Date" />
      <dxe:DateEdit VerticalAlignment="Center"
                    x:Name="datclosedate"
                    Grid.Column="5"
                    Grid.Row="5" />
      <dxe:DateEdit VerticalAlignment="Center"
                    x:Name="datalertDate"
                    Grid.Column="5"
                    Grid.Row="6" />
      <TextBlock VerticalAlignment="Center"
                 Grid.Column="4"
                 Grid.Row="6"
                 Text="Alert Date"
                 Height="16" />
      <!--<TextBlock VerticalAlignment="Center"
                 Grid.Column="1"
                 Grid.Row="7"
                 Text="Inquiry Status"
                 Height="16" />-->
      <ComboBox VerticalAlignment="Center"
                Grid.Column="2"
                Grid.Row="2"
                x:Name="cmbInquiryStatus"
                SelectionChanged="cmbInquiryStatus_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel  Orientation="Horizontal">
              <TextBlock Text="{Binding id}"
                         Visibility="Hidden" />
              <TextBlock Text="{Binding name}"></TextBlock>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <DataGrid x:Name="dGitems"
                Grid.Column="1"
                Grid.ColumnSpan="5"
                Grid.Row="8"
                Margin="0,10"
                ColumnWidth="*"
                AutoGenerateColumns="True"
                AutoGeneratingColumn="dGitems_AutoGeneratingColumn">
        <DataGrid.Resources>
          <Style TargetType="{x:Type ComboBox}">
            <EventSetter Event="SelectionChanged"
                         Handler="ComboBox_SelectionChanged" />
          </Style>
        </DataGrid.Resources>
      </DataGrid>
      <Button x:Name="btniquiryadd"
              Grid.Row="9"
              Grid.ColumnSpan="7"
              Content="Add Inquiry"
              Click="btniquiryadd_Click"></Button>
    </Grid>
  </Grid>
</Window>
