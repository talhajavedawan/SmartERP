<UserControl x:Class="ZAS_ERP.Procurementss.Inquiriess.ucStatuschange"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Inquiriess"
             mc:Ignorable="d"
             x:Name="ucinqstatuschange"
             Loaded="ucinqstatuschange_Loaded"
             d:DesignHeight="250"
             d:DesignWidth="400"
             Background="Black"
             Opacity=".5">
  <Grid Margin="0,20,0,0"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="White">
    <Grid.Resources>
      <Style TargetType="{x:Type Label}">
        <Setter Property="Margin"
                Value="10,0" />
        <Setter Property="Foreground"
                Value="Gray" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
      </Style>
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Margin"
                Value="10,10" />
        <Setter Property="MaxWidth"
                Value="350" />
      </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width=" auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height=" auto" />
      <RowDefinition Height=" auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height=" 50" />
    </Grid.RowDefinitions>
    <Label Content="Current Status"
           ToolTip="Status Name"
           HorizontalAlignment="Right" />
    <Grid HorizontalAlignment="Stretch"
          Grid.Column="1"
          IsEnabled="False">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto"></ColumnDefinition>
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="   "
                 x:Name="lblstatuscolor"
                 Background="{Binding bcolor}"
                 Width="20" />
      <TextBlock x:Name="txtStatus"
                 Grid.Column="1"
                 IsEnabled="False"></TextBlock>
    </Grid>
    <Label Content="Change to"
           ToolTip="Select if it is of active type"
           HorizontalAlignment="Right"
           Grid.Row="1" />
    <ComboBox VerticalAlignment="Center"
              Grid.Column="1"
              MinWidth="150"
              Grid.Row="1"
              Margin="10,5"
              x:Name="cmbInquiryStatus"
              SelectionChanged="cmbInquiryStatus_SelectionChanged">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="auto"></ColumnDefinition>
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding id}"
                       Visibility="Hidden" />
            <TextBlock Text="   "
                       Background="{Binding bcolor}"
                       Width="20"
                       Margin="10,0" />
            <TextBlock Text="{Binding name}"
                       Grid.Column="1"
                       Foreground="{Binding fcolor}"
                       HorizontalAlignment="Stretch"></TextBlock>
          </Grid>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <Button Grid.ColumnSpan="2"
            Grid.Row="3"
            Content="Save"
            FontSize="24"
            Margin="0,10,0,0"
            x:Name="btnStatusSave"
            Click="btnStatusSave_Click" />
  </Grid>
</UserControl>
