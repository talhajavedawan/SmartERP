<UserControl x:Class="ZAS_ERP.Procurementss.Inquiriess.ucInquiryBuckets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Inquiriess"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             mc:Ignorable="d" 
             x:Name="ucInquiryBucket" Loaded="ucInquiryBucket_Loaded"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition MinHeight="25"
                       Height="1*"
                       MaxHeight="35" />
        <RowDefinition Height="7*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.5*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="5*" />
      </Grid.ColumnDefinitions>
      <DockPanel Grid.ColumnSpan="3">
        <dxb:MainMenuControl Height="30"
                             VerticalAlignment="Top" Visibility="Hidden"
                             BarItemDisplayMode="ContentAndGlyph">
          <dxb:BarSubItem Content="Add new"
                          x:Name="mbtnaddcomp"
                          Glyph="/ZAS_ERP;component/images/appbar.add.png">
            <dxb:BarButtonItem Content="Add new"
                               Glyph="/ZAS_ERP;component/images/appbar.user.add.png" />
            <dxb:BarButtonItem  Content="New Transactions"></dxb:BarButtonItem>
          </dxb:BarSubItem>
          <dxb:BarSubItem Content="New Transactions">
            <dxb:BarButtonItem x:Name="btnestimates"
                               Content="Estimates" />
            <dxb:BarButtonItem x:Name="btnsalesOrders"
                               Content="New" />
          </dxb:BarSubItem>
        </dxb:MainMenuControl>
      </DockPanel>
      <DockPanel Grid.Row="1"
                 Grid.RowSpan="3"
                 Grid.Column="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="1.4*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <dx:DropDownButton />
            <dx:SimpleButton Content="GO"
                             HorizontalAlignment="Right" />
          </Grid>
          <dxg:GridControl x:Name="grdinquiry"
                           Grid.Row="1"
                           Grid.ColumnSpan="3"
                           SelectionMode="Row"
                           ItemsSource="{Binding inquiry}"
                           SelectionChanged="grdinquiry_SelectionChanged">
            <dxg:GridColumn FieldName="Id"
                            Visible="False" />
            <dxg:GridColumn FieldName="referenceNo"
                            Width="auto"
                            Header="Inquiry Reference" />
            <dxg:GridColumn FieldName="customerCompany.company.CompanyName"
                            Width="auto"
                            Header="Sub Customer Name" />
            <dxg:GridColumn FieldName="inquiryDate"
                            Width="auto"
                            Header="Inquiry Date" />
            
          </dxg:GridControl>
        </Grid>
      </DockPanel>
      <Grid Grid.Column="2"
            Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="50" />
          <RowDefinition Height="auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10,0">
          <TextBlock x:Name="lblinfoheader"
                     Text="Inquiry Buckets"
                     FontSize="36"
                     VerticalAlignment="Center"
                     TextDecorations="{x:Null}" />
        </StackPanel>
        <Rectangle Height="3"
                   Fill="Gray"
                   VerticalAlignment="Bottom"
                   Margin="10,0" />
        <dxlc:GroupBox Header="New Inquiry Bucket"
                       Background="White"
                       Margin="5"
                       Grid.Row="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="auto">
                
              </RowDefinition>
              <RowDefinition Height="1*" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="1*" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="Select Vendor" ToolTip="Select vendor you want to forward this Inquiry whole or Partialy!"/>
            <ComboBox VerticalAlignment="Center"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      x:Name="cmbVendor"
                      SelectionChanged="cmbVendor_SelectionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel  Orientation="Horizontal">
                    <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                    <TextBlock Text="{Binding name}"></TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="btnCreateBucket"
                    Click="btnCreateBucket_Click"
                    Grid.Column="3"
                    Content="Create Bucket"
                    Margin="10,0,0,0"></Button>
            <DataGrid x:Name="dGitems"
                      
                      Grid.ColumnSpan="4"
                      Grid.Row="1"
                      Margin="0,10"
                     ColumnWidth="*"  />
            <Button Content="Add Item to Bucket" Grid.Column=" 1" Grid.Row="2" x:Name="btnitemadd" Click="btnitemadd_Click"> </Button>
            <Button Content="Remove Item From Bucket"
                    Grid.Column=" 2"
                    Grid.Row="2"
                    x:Name="btnitemremove" Click="btnitemremove_Click"></Button>
            <DataGrid x:Name="dgrdbucketitems"
                      
                      Grid.ColumnSpan="4"
                      Grid.Row="3"
                      Margin="0,10"
                      ColumnWidth="*" />
            <dxg:LookUpEdit x:Name="lookupvendor"
                            Grid.Row="4" Grid.ColumnSpan="4" Visibility="Hidden"></dxg:LookUpEdit>
          </Grid>
        </dxlc:GroupBox>
        <!--<dxlc:GroupBox Header="Inquiry Information"
                       Background="White"
                       Margin="5"
                       Grid.Row="2"
                       IsEnabled="False">
          <Grid>
            <Grid.Resources>
              <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="HorizontalAlignment"
                        Value="Left" />
                <Setter Property="Foreground"
                        Value="DarkGray" />
                <Setter Property="Margin"
                        Value="10,05" />
              </Style>
            </Grid.Resources>
            <Grid>
              <Grid.ColumnDefinitions>
