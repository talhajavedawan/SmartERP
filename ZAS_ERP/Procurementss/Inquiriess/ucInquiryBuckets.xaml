                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="20" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="10" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Customer Name"
                         Grid.Column="1"
                         Grid.Row="1" />
              <TextBox x:Name="cmbCustomerName"
                       VerticalAlignment="Center"
                       Grid.Row="1"
                       Grid.Column="2">
                --><!--<ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                                   Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>--><!--
              </TextBox>
              <TextBlock x:Name="label1"
                         VerticalAlignment="Center"
                         Grid.Row="2"
                         Grid.Column="1"><Run Text="Sub Customer" /></TextBlock>
              <TextBox VerticalAlignment="Center"
                       Grid.Column="2"
                       x:Name="cmbsubcustomer"
                       Grid.Row="2">
                --><!--<ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                                   Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>--><!--
              </TextBox>
              <TextBlock VerticalAlignment="Center"
                         Grid.Column="1"
                         Grid.Row="3"
                         Text="Inquiry Type " />
              <TextBox VerticalAlignment="Center"
                       Grid.Column="2"
                       Grid.Row="3"
                       x:Name="cmbInquiryType">
                --><!--<ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                                   Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>--><!--
              </TextBox>
              <TextBlock VerticalAlignment="Center"
                         Grid.Column="1"
                         Grid.Row="6"
                         Text="Due Date " />
              <TextBlock VerticalAlignment="Center"
                         Grid.Column="1"
                         Grid.Row="4"
                         Text="Inquiry Reference #" />
              <TextBox Grid.Column="2"
                       x:Name="txtinquiryref"
                       Grid.Row="4"
                       VerticalAlignment="Center"></TextBox>
              <dxe:DateEdit VerticalAlignment="Center"
                            x:Name="datinquirydate"
                            Grid.Column="2"
                            Grid.Row="5" />
              <TextBlock VerticalAlignment="Center"
                         Grid.Column="1"
                         Grid.Row="5"
                         Text="Inquiry Date" />
              <dxe:DateEdit VerticalAlignment="Center"
                            x:Name="datduedate"
                            Grid.Column="2"
                            Grid.Row="6" />
              --><!--<CheckBox x:Name="chkisempActive"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Grid.Column="2"
                Grid.Row="7" />--><!--
              <TextBox x:Name="cmbDepartment"
                       VerticalAlignment="Center"
                       Grid.Column="5"
                       Grid.Row="1">
                --><!--<ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                                   Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>--><!--
              </TextBox>
              <TextBlock VerticalAlignment="Center"
                         Grid.Column="4"
                         Grid.Row="1"
                         Text="Department" />
              <TextBox x:Name="cmbSection"
                       VerticalAlignment="Center"
                       Grid.Column="5"
                       Grid.Row="2">
                --><!--<ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                                   Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>--><!--
              </TextBox>
              <TextBlock VerticalAlignment="Center"
                         Grid.Column="4"
                         Grid.Row="2"
                         Text="Section" />
              <TextBox x:Name="cmbEmployee"
                       VerticalAlignment="Center"
                       Grid.Column="5"
                       Grid.Row="3">
                --><!--<ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                                   Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>--><!--
              </TextBox>
              <TextBlock VerticalAlignment="Center"
                         Grid.Column="4"
                         Grid.Row="3"
                         Text="Allocate to" />
              <TextBox x:Name="txtfileref"
                       VerticalAlignment="Center"
                       Grid.Column="5"
                       Grid.Row="4"></TextBox>
              <TextBlock VerticalAlignment="Center"
                         Grid.Column="4"
                         Grid.Row="4"
                         Text="File Reference #" />
              <TextBlock VerticalAlignment="Center"
                         Grid.Column="4"
                         Grid.Row="5"
                         Text="Closing Date" />
              <dxe:DateEdit VerticalAlignment="Center"
                            x:Name="datclosedate"
                            Grid.Column="5"
                            Grid.Row="5" />
              <dxe:DateEdit VerticalAlignment="Center"
                            x:Name="datalertDate"
                            Grid.Column="5"
                            Grid.Row="6" />
              <TextBlock VerticalAlignment="Center"
                         Grid.Column="4"
                         Grid.Row="6"
                         Text="Alert Date"
                         Height="16" />
              <TextBlock VerticalAlignment="Center"
                         Grid.Column="1"
                         Grid.Row="7"
                         Text="Inquiry Status"
                         Height="16" />
              <TextBox VerticalAlignment="Center"
                       Grid.Column="2"
                       Grid.Row="7"
                       x:Name="txtInquiryStatus">
                --><!--<ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                                   Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>--><!--
              </TextBox>
              
              --><!--<Button x:Name="btniquiryadd"
                        Grid.Row="9"
                        Grid.ColumnSpan="7"
                        Content="Add Inquiry"
                        Click="btniquiryadd_Click"></Button>--><!--
            </Grid>
          </Grid>
        </dxlc:GroupBox>-->
      </Grid>
      <DockPanel Grid.Column="2"
                 Grid.Row="3">
        <Grid Grid.Column="2"
              Grid.Row="3"
              VerticalAlignment="Stretch"
              MaxHeight="600">
          <Grid.Resources>
            <Style TargetType="Label">
              <Setter Property="Foreground"
                      Value="DarkGray"></Setter>
              <Setter Property="Margin"
                      Value="10,0"></Setter>
            </Style>
            <Style TargetType="dx:DropDownButton">
              <Setter Property="Margin"
                      Value="10,5"></Setter>
            </Style>
          </Grid.Resources>
        </Grid>
      </DockPanel>
      <GridSplitter Grid.Column="1"
                    Grid.Row="1"
                    Grid.RowSpan="3"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
