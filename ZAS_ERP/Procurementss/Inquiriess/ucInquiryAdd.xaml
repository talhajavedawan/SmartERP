        <Grid x:Name="grdComments"  Visibility="Collapsed" Width="400" Background="Gray" Panel.ZIndex="5" VerticalAlignment="Stretch" Margin="35" Grid.RowSpan="2" HorizontalAlignment="Left">
            <dxg:GridControl AutoExpandAllGroups="True"  Height="620" Grid.Row="1"  dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">
