                                                      Text="1" 
                                                      Height="22"
                                                      IsReadOnly="True"/>
                                    </dxlc:LayoutItem>

                                    <dxlc:LayoutItem Label="Loan Aging(Days)">
                                        <dxe:TextEdit x:Name="txtAgingDays" 
                                                      MaskType="Numeric"
                                                      Mask="n0"
                                                      MaskUseAsDisplayFormat="True"
                                                      Text="1"
                                                      Height="22"
                                                      IsReadOnly="True"/>
                                    </dxlc:LayoutItem>

                                    <dxlc:LayoutItem>
                                        <TextBlock Height="22"/>
                                    </dxlc:LayoutItem>

                                </dxlc:LayoutGroup>
                            </dxlc:LayoutControl>

                            <dxlc:LayoutControl Grid.Row="18" Grid.Column="4" Orientation="Vertical" Padding="0">
                                <dxlc:LayoutGroup Orientation="Vertical" 
                                                  View="GroupBox"
                                                  Header="Payments and Receipts">
                                    <dxlc:LayoutGroup.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!--<Image Source="{dx:DXImage Image=SolidOrangeDataBar_32x32.png}" Width="16" Height="16"/>-->
                                                <Image Source="{dx:DXImage Image=Currency2_16x16.png}" Width="16" Height="16"/>
                                                <TextBlock Text="{Binding}" Margin="5 0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutGroup.HeaderTemplate>
                                    <!--<dxlc:LayoutItem Label="Total Loan Amount">
                                        <dxe:TextEdit x:Name="txtTotalLoanAmount" 
                                                      MaskType="Numeric"
                                                      Mask="n2"
                                                      MaskUseAsDisplayFormat="True"
                                                      Text="1"
                                                      Height="22"/>
                                    </dxlc:LayoutItem>-->

                                    <dxlc:LayoutItem Label="Total Advance Paid">
                                        <dxe:TextEdit x:Name="txtTotalLoanPaid" 
                                                      MaskType="Numeric"
                                                      Mask="n2"
                                                      MaskUseAsDisplayFormat="True"
                                                      Text="1"
                                                      Height="22"
                                                      IsReadOnly="True"/>
                                    </dxlc:LayoutItem>

                                    <dxlc:LayoutItem Label="Advance Returned">
                                        <dxe:TextEdit x:Name="txtLoanReturned" 
