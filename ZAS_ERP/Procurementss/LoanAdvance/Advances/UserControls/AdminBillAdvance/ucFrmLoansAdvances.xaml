                                       x:Name="cmbxPettyCashRef">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel  Orientation="Horizontal">
                                                        <TextBlock Text="{Binding id}"
                                                        Visibility="Hidden" />
                                                        <TextBlock Text="{Binding name}"></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>


                                        <TextBlock Margin="10 0 0 0" VerticalAlignment="Center" Grid.Row="12" Grid.Column="0" FontWeight="DemiBold"
                                       FontStyle="Italic" Text="Deposit" />

                                        <dxe:ToggleSwitch x:Name="btnDeposit"  
                                      SwitchBorderTemplate="{StaticResource borderTemplate}"
                                      SwitchThumbTemplate="{StaticResource thumbTemplate}"
                                      Grid.Column="1" 
                                      HorizontalAlignment="Left" 
                                      Margin="5,0,0,0"                        
                                      VerticalAlignment="Center"
                                      Content="Posted" 
                                      ContentPlacement="Inside"
                                      IsChecked="False" 
                                                          Checked="BtnDeposit_Checked"/>
