                                        <dxe:TextEdit x:Name="txtAdjustedAmount" 
                                                      MaskType="Numeric"
                                                      Mask="n2"
                                                      MaskUseAsDisplayFormat="True"
                                                      Text="1"
                                                      Height="22"
                                                      IsReadOnly="True"/>
                                    </dxlc:LayoutItem>
                                    
                                    <dxlc:LayoutItem Label="Balance Amount OC">
                                        <dxe:TextEdit x:Name="txtBalanceAmountOC" 
                                                      MaskType="Numeric"
                                                      Mask="n2"
                                                      MaskUseAsDisplayFormat="True"
                                                      Text="1"
                                                      Height="22"
