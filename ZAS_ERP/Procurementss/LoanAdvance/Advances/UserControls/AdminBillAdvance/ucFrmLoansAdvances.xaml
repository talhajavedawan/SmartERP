                                       FontStyle="Italic" Text="Payment" Margin="10 0 0 0"/>

                                        <dxe:ToggleSwitch x:Name="btnPayment"  
                                      SwitchBorderTemplate="{StaticResource borderTemplate}"
                                      SwitchThumbTemplate="{StaticResource thumbTemplate}"
                                      Grid.Column="3" 
                                      HorizontalAlignment="Left" 
                                      Margin="5,0,5,0"                        
                                      VerticalAlignment="Center"
                                      Content="Posted" 
                                      ContentPlacement="Inside"
                                      IsChecked="False"
                                                          Checked="BtnPayment_Checked"/>
                                    </StackPanel>

                                </dxlc:LayoutGroup>

                                <dxlc:LayoutGroup Margin="0 5 0 5" View="GroupBox" Header="GL Postings" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3">

                                    <dxlc:LayoutGroup.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!--<Image Source="{dx:DXImage Image=SolidOrangeDataBar_32x32.png}" Width="16" Height="16"/>-->
                                                <Image Source="{dx:DXImage Image=Financial_16x16.png}" Width="16" Height="16"/>
                                                <TextBlock Text="{Binding}" Margin="5 0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutGroup.HeaderTemplate>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Label Grid.Column="0" Grid.Row="1" Margin="5,5,0,5"  HorizontalAlignment="Left" Content="GL Posting Date"  FontWeight="DemiBold"
                                       FontStyle="Italic"/>
                                        <dxe:DateEdit MaskType="DateTime" 
                                                      Margin="0,5,5,5"  
                                                      MaskUseAsDisplayFormat="True" 
                                                      Mask="dd/MMMM/yyyy"
                                                      x:Name="datglPostingdate"
                                                      TabIndex="2"
                                                      Width="100"
                                                      Height="22"/>

                                        <TextBlock VerticalAlignment="Center"
                                                        Grid.Row="12" Grid.Column="0"
                                                 FontWeight="DemiBold"
                                       FontStyle="Italic"
                                                   Margin="10 0 0 0"
                                                        Text="Credits" />
                                        <dxe:ToggleSwitch x:Name="btnPushCredits"  
                                      SwitchBorderTemplate="{StaticResource borderTemplate}"
                                      SwitchThumbTemplate="{StaticResource thumbTemplate}"
                                      Grid.Row="12"
                                      Grid.RowSpan="2"  
                                      Grid.Column="1" 
                                      HorizontalAlignment="Center" 
                                      Margin="5,0,5,0"                        
                                      VerticalAlignment="Center"
                                      Content="Posted" 
                                      ContentPlacement="Inside"
                                      IsChecked="False"
                                       >
                                        </dxe:ToggleSwitch>
                                        <!--<TextBlock VerticalAlignment="Center"
                                                 FontWeight="DemiBold"
                                       FontStyle="Italic"
                     Text="Post Credits" />-->

                                        <TextBlock VerticalAlignment="Center"
                                                        Grid.Row="12" Grid.Column="0"
                                                 FontWeight="DemiBold"
                                       FontStyle="Italic"
                                                   Margin="10 0 0 0"
                                                        Text="Debits" />
                                        <dxe:ToggleSwitch x:Name="btnPushDebits"  
                                      SwitchBorderTemplate="{StaticResource borderTemplate}"
                                      SwitchThumbTemplate="{StaticResource thumbTemplate}"
                                      Grid.Row="12"
                                      Grid.RowSpan="2"  
                                      Grid.Column="1" 
                                      HorizontalAlignment="Center" 
                                      Margin="5,0,5,0"                        
                                      VerticalAlignment="Center"
                                      Content="Posted" 
                                      ContentPlacement="Inside"
                                      IsChecked="False"
                                       >
                                        </dxe:ToggleSwitch>
                                        <!--<TextBlock VerticalAlignment="Center"
                     Grid.Column="2"
                                                 FontWeight="DemiBold"
                                       FontStyle="Italic"
                                   HorizontalAlignment="Stretch"
                     Text="Post Debits" />-->
                                    </StackPanel>



                                </dxlc:LayoutGroup>

                            </Grid>

                            <dxlc:LayoutControl Grid.Row="18" Grid.Column="0" Orientation="Vertical" Padding="0">
                                <dxlc:LayoutGroup Orientation="Vertical" 
                                                  View="GroupBox"
                                                  Header="Currency">

                                    <dxlc:LayoutGroup.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!--<Image Source="{dx:DXImage Image=SolidOrangeDataBar_32x32.png}" Width="16" Height="16"/>-->
                                                <Image Source="{dx:DXImage Image=Currency2_16x16.png}" Width="16" Height="16"/>
                                                <TextBlock Text="{Binding}" Margin="5 0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutGroup.HeaderTemplate>

                                    <dxlc:LayoutItem Label="Amount OC">
                                        <dxe:TextEdit x:Name="txtAmountOC"
                                                      Text="0"
                                                      MaskType="Numeric" 
                                                      Mask="n2" 
                                                      MaskUseAsDisplayFormat="True"
                                                      IsReadOnly="True"
                                                      EditValueChanged="TxtAmountOC_EditValueChanged"/>
                                    </dxlc:LayoutItem>

                                    <dxlc:LayoutItem Label="Currency">
                                        <ComboBox x:Name="cmbCurrency"
                                                  VerticalAlignment="Center"
                                                  Grid.Row="0"
                                                  TabIndex="37"
                                                  SelectionChanged="cmbCurrency_SelectedIndexChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel  Orientation="Horizontal">
                                                        <TextBlock Text="{Binding id}" Visibility="Hidden" />
                                                        <TextBlock Text="{Binding name}"></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </dxlc:LayoutItem>

                                    <dxlc:LayoutItem Label="MER">
                                        <dxe:TextEdit x:Name="txtexchangerate"
                                                      Text="1"
                                                      MaskType="Numeric" 
                                                      Mask="n2" 
                                                      MaskUseAsDisplayFormat="True"
                                                      IsReadOnly="True"
                                                      EditValueChanged="Txtexchangerate_EditValueChanged"/>
                                    </dxlc:LayoutItem>

                                    <dxlc:LayoutItem Label="Amount MER">
                                        <dxe:TextEdit x:Name="txtAmoutMER" 
                                                      Text="0"
                                                      MaskType="Numeric" 
                                                      Mask="n2" 
                                                      MaskUseAsDisplayFormat="True"
                                                      IsReadOnly="True"/>
                                    </dxlc:LayoutItem>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutControl>


                            <dxlc:LayoutControl Grid.Row="18" Grid.Column="2" Orientation="Vertical" Padding="0">
                                <dxlc:LayoutGroup Orientation="Vertical" 
                                                  View="GroupBox"
                                                  Header="Tenure">

                                    <dxlc:LayoutGroup.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!--<Image Source="{dx:DXImage Image=SolidOrangeDataBar_32x32.png}" Width="16" Height="16"/>-->
                                                <Image Source="{dx:DXImage Image=Time_16x16.png}" Width="16" Height="16"/>
                                                <TextBlock Text="{Binding}" Margin="5 0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutGroup.HeaderTemplate>
                                    <dxlc:LayoutItem Label="Advance Tenure(Days)">
