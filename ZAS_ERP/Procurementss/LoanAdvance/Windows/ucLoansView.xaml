            <dxg:GridColumn FieldName="primaryCreditCardNo" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

            <dxg:GridColumn FieldName="vendor_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="vendor" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

            <dxg:GridColumn FieldName="PaymentRefNoId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="PaymentRefNo1" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

            <dxg:GridColumn FieldName="currency_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
