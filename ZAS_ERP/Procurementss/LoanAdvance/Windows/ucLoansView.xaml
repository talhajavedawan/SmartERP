<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
              x:Class="ZAS_ERP.Procurementss.LoanAdvance.Windows.ucLoansView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.LoanAdvance.Windows" 
              Title="ucLoansView"  mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="DXWindow_Loaded">
    <Grid>
        <GroupBox>
            <Grid x:Name="reportMainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <dxr:RibbonControl Grid.Row="0" DockPanel.Dock="Top"  RibbonStyle="TabletOffice" PageCategoryAlignment="Left" ToolbarShowMode="Hide" MinimizationButtonVisibility="Visible">
                    <dxr:RibbonDefaultPageCategory>
                        <dxr:RibbonPage x:Name="lblHeading" ToolTip="Report Name" Caption="Home"  >
                            <dxr:RibbonPageGroup  Caption="Clipboard">
                                <dxb:BarButtonItem x:Name="btnDelete" KeyGesture="Delete" Cursor="Hand" Content="Delete Report" ItemClick="MbtnDeleteReport1_Click" Glyph="/ZAS_ERP;component/images/Delete_32x32.png"/>

                                <dxb:BarButtonItem x:Name="btnPrintPreview" KeyGesture="Ctrl+P" Cursor="Hand" Content="Print Preview" ItemClick="BtnPrintPreview_ItemClick"  Glyph="{dx:DXImage Image=Printer_32x32.png}" LargeGlyph="{dx:DXImage Image=Printer_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnSaveAsNew" KeyGesture="Ctrl+N" Cursor="Hand" Content="Save as new" ItemClick="MbtnSaveAsNew1_Click" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}"/>
                                <dxb:BarButtonItem x:Name="btnRename" KeyGesture="Ctrl+X" Cursor="Hand" Content="Rename" ItemClick="MbtnRenameReport1_Click" Glyph="{dx:DXImage Image=Edit_32x32.png}" />
                                <dxb:BarButtonItem x:Name="btnUpdate" KeyGesture="Ctrl+U" Cursor="Hand" Content="Update" ItemClick="MbtnUpdateReport1_Click" Glyph="{dx:DXImage Image=Reset_32x32.png}" LargeGlyph="{dx:DXImage Image=Reset_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="btnCopy2" KeyGesture="Ctrl+R" Cursor="Hand" Content="Refresh" ItemClick="MbtnRefreshReport1_Click" Glyph="{dx:DXImage Image=Refresh2_32x32.png}" LargeGlyph="{dx:DXImage Image=Refresh2_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToMemorizedReport1" Cursor="Hand" Content="Export to memorized" ItemClick="MbtnExportToMemorizedReport1_Click" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnExportToStandardReport1" Cursor="Hand" ItemClick="MbtnExportToStandardReport1_Click" Content="Export to standard" Glyph="{dx:DXImage Image=Previous_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnShareReport" Cursor="Hand" ItemClick="mbtnShareReport_ItemClick" Content="Share Report" Glyph="{dx:DXImage Image=Convert_32x32.png}"/>
                                <dxb:BarButtonItem x:Name="mbtnDriectClose" Cursor="Hand" ItemClick="mbtnDriectClose_ItemClick" Content="Direct Close" />
                                <dxb:BarButtonItem x:Name="mbtnApprove" Cursor="Hand" ItemClick="mbtnApprove_ItemClick" Content="Approve" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxg:GridControl Grid.Row="2"
                         AutoGenerateColumns="None"
                         EnableSmartColumnsGeneration="True"
                         Name="grdLoansList"
                         MouseDoubleClick="grdLoansAdvancesRegister_MouseDoubleClick"
                         CustomUnboundColumnData="grdLoansAdvancesRegister_CustomUnboundColumnData">

                    <dxg:GridControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add New"
                                Click="mbtnAdd_Click" x:Name="mbtnAdd">
                                <MenuItem.Icon>
                                    <Image Source="/ZAS_ERP;component/images/icon-Add-ReportGroups.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Update"
                                    x:Name="mbtnUpdate" Click="mbtnUpdate_Click">
                                <MenuItem.Icon>
                                    <Image Source="/ZAS_ERP;component/images/icon-edit-ReportGroups.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </dxg:GridControl.ContextMenu>

                    <dxg:GridControl.View>
                        <dxg:TableView
                        AllowEditing="False"
                        AllowPerPixelScrolling="True"
                        Name="tblViewLoansAdvances"
                        RowAnimationKind="None"
                    
                        ShowAutoFilterRow="True"
                        ShowTotalSummary="True"
                        WaitIndicatorType="Panel">

                        </dxg:TableView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn x:Name="colstatus"
                      FieldName="Status.Status"
                      Header="Status"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="1"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.Status.backcolor}"/>
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.Status.Status}"/>
                  </InlineUIContainer></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colCreationDate"
                      FieldName="CreationDate"
                      Header="Creation Date"
                      UnboundType="Bound"
                            AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="2">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings Mask="G" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="advanceTemplate"
                            Header="Template"
                            UnboundType="Bound"
                            Visible ="True"
                            AllowEditing="false"
                            VisibleIndex="2"/>

                    <dxg:GridColumn
                      FieldName="loansAdvanceType"
                      Header="Loans Advance Type"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="2"/>



                    <dxg:GridColumn x:Name="colCompany"
                      FieldName="company.CompanyName"
                      Header="Company"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="3"/>

                    <dxg:GridColumn x:Name="colDepartment"
                      FieldName="department.DeptName"
                      Header="Department"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="4"/>

                    <dxg:GridColumn 
                      FieldName="vendor.company.CompanyName"
                      Header="Vendor"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="5"/>


                    <dxg:GridColumn x:Name="colApplicantType"
                      FieldName="applicantType.TypeName"
                      Header="Applicant Type"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="5"/>

                    <dxg:GridColumn x:Name="colApplicant"
                      FieldName="applicant.Name"
                      Header="Applicant Name"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="6"/>

                    <dxg:GridColumn x:Name="colApplicantEmployee"
                      FieldName="Employee"
                      Header="Applicant Employee"
                      UnboundType="string"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="9"/>

                    <dxg:GridColumn x:Name="colCurrency"
                      FieldName="currency.CurrencyName"
                      Header="Currency Name"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="6"/>


                    <dxg:GridColumn 
                      FieldName="SystemRef"
                      Header="System Ref #"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="6"/>

                    <dxg:GridColumn x:Name="colLoanAmount"
                      FieldName="LoanAmountOC"
                      Header="Loan Amount Approved(OC)"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="10">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>


                    <dxg:GridColumn x:Name="colLoanAmountApprovedMER"
                      FieldName="LoanAmountMER"
                      Header="Loan Amount Approved(MER)"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="10">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colMER"
                      FieldName="MER"
                      Header="MER"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="11">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>



                    <dxg:GridColumn x:Name="colAppliedAmountOC"
                      FieldName="AppliedAmountOC"
                      Header="Applied Loan Amount (OC)"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="12">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colBalanceAmountOC"
                      FieldName="BalanaceAmountOC"
                      Header="Balanace Amount (OC)"
                      UnboundType="Decimal"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="10">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colPurpose"
                      FieldName="Purpose"
                      Header="Purpose"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="13"/>

                    <dxg:GridColumn x:Name="colLoanTenureDays"
                      FieldName="LoanTenureDays"
                      Header="Tenure (In Days)"
                      UnboundType="Bound"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="14"/>

                    <dxg:GridColumn x:Name="colLoanReturnDate"
                      FieldName="LoanReturnDate"
                      Header="Loan Return Date"
                      UnboundType="Bound"
                            AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="15">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings MaskUseAsDisplayFormat="True" Mask="dd/MM/yyyy"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <!--<dxg:GridColumn x:Name="colIndustryType"
                      FieldName="industryType.name"
                      Header="Industry Type"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="12"/>-->



                    <dxg:GridColumn x:Name="colIsVoid"
                      FieldName="isVoid"
                      Header="Is Void"
                      UnboundType="String"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="16"/>

                    <dxg:GridColumn x:Name="colPendingForClosing"
                      FieldName="PendingForClosing"
                      Header="Pending For Closing"
                      UnboundType="Bound"
                            AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="17"/>

                    <dxg:GridColumn x:Name="colPendingForReApproval"
                      FieldName="PendingForReApproval"
                      Header="PendingForReApproval"
                      UnboundType="Bound"
                            AllowEditing="false"
                      Visible ="True"
                      VisibleIndex="18"/>

                    <dxg:GridColumn x:Name="colIsApproved"
                      FieldName="isApproved"
                      Header="Is Approved"
                      UnboundType="String"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="19"/>

                    <dxg:GridColumn x:Name="colBillNumber"
                      FieldName="BillNumber"
                      Header="Bill Number"
                      UnboundType="String"
                      Visible ="False"
                            ShowInColumnChooser="False"
                            AllowEditing="false"
                      VisibleIndex="20"/>

                    <dxg:GridColumn x:Name="colApprovedDate"
                      FieldName="ApprovedDate"
                      Header="Approved Date"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="21" 
                            AllowEditing="false">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings MaskUseAsDisplayFormat="True" Mask="MMM yyyy" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colIsReApproved"
                      FieldName="isReApproved"
                      Header="Is ReApproved"
                      UnboundType="String"
                      Visible ="True"
                            AllowEditing="false"
                      VisibleIndex="22"/>


                    <dxg:GridColumn x:Name="colReApprovalDate"
                      FieldName="ReApprovalDate"
                      Header="ReApprovalDate"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="23" 
                            AllowEditing="false">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings MaskUseAsDisplayFormat="True" Mask="MMM yyyy" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>





                    <!--<dxg:GridColumn FieldName="Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="transactionGroupId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="AdminBill_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="adminBill" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
