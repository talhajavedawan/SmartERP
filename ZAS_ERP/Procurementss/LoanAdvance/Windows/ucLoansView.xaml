            <dxg:GridColumn FieldName="InterCompany_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="InterCompany" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

            <dxg:GridColumn FieldName="InterDepartment" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="InterDepartment_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>

            <dxg:GridColumn FieldName="dept_Id" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="department" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="creditCardBankId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="creditCardBank" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
