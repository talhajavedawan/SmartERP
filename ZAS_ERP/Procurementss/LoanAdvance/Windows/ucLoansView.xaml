            <dxg:GridColumn FieldName="Status" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="paymentMethodId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="paymentMethod" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="bankId" UnboundType="Integer" Visible="False"/>
            <dxg:GridColumn FieldName="bank" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="accountId" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>
            <dxg:GridColumn FieldName="account" IsSmart="True" Visible="False" ShowInColumnChooser="False"/>-->

                </dxg:GridControl>

            </Grid>

        </GroupBox>


        <Image
        x:Name="loadingGif"    
       
            
        Visibility="Hidden"
        Grid.Row="2"
            
         gif:AnimationBehavior.SourceUri="/ZAS_ERP;component/images/loadingReports.gif"   
        VerticalAlignment="Center"
        HorizontalAlignment="Center" RenderTransformOrigin="12.987,0.793" Margin="5,100,5,5" Width="60" />
    </Grid>
</dx:DXWindow>
