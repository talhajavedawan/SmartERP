<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Procurementss.StatusClasses.Windows.winStatusClassAdd"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.StatusClasses.Windows"
        mc:Ignorable="d"
        Title="Add Status Class" Height="220" Width="320" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,20,0,0" Grid.Row="0">
            <Grid.Resources>
                <Style TargetType="{x:Type Label}">
                    <Setter Property="Margin"
                Value="10,0" />
                    <Setter Property="Foreground"
                Value="Gray" />
                    <Setter Property="VerticalAlignment"
                Value="Center" />
                </Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="Margin"
                Value="10,0" />
                    <Setter Property="MaxWidth"
                Value="350" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=" auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height=" auto" />
                <RowDefinition Height=" auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Content="Status"
           ToolTip="Status Name"
           HorizontalAlignment="Right" />
            <Label Content="Active"
           ToolTip="Select if it is of active type"
           HorizontalAlignment="Right"
           Grid.Row="1" />
            <Label Content="Disable"
           HorizontalAlignment="Right"
           Grid.Row="2" />
            <Label Content="Module Type"
           HorizontalAlignment="Right"
           Grid.Row="3" />
            <TextBox x:Name="txtStatus"
             Grid.Column="1" />
            <CheckBox x:Name="chkDisable"
                  Grid.Row="2"
                  Grid.Column="1"
                Margin="10,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                 />
            <dxe:ComboBoxEdit x:Name="gridTransactionType" Grid.Row="3" Margin="5"
                           TabIndex="2"                          
                           Grid.Column="1"/>


            <Grid Grid.Column="1" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="chkisactive"
                Margin="10,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                IsChecked="True" />
                <dxe:PopupColorEdit Margin="10"
                          HorizontalAlignment="Stretch"
                          ColorChanged="ColorEdit_ColorChanged"
                          Grid.Column="1"
                         
                          VerticalAlignment="Center"
                          x:Name="cpStatus" />
            </Grid>
        </Grid>
        <Button 
            Grid.Row="1"
            Content="Save"
            FontSize="26"
            x:Name="btnStatusSave"
            Click="btnStatusSave_Click" />
    </Grid>
</dx:DXWindow>
