<UserControl x:Class="ZAS_ERP.Procurementss.PurchaseInvoice.UserControls.ucPIGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.PurchaseInvoice.UserControls"
             xmlns:loc="clr-namespace:ZAS_ERP"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <loc:MyConv x:Key="valueconverter"></loc:MyConv>
        <!---->
    </UserControl.Resources>
    <Grid DataContext="{Binding  RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ucPIGrid}}"
       >
        <Grid.RowDefinitions>
           <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>

            
            <RowDefinition Height="auto"></RowDefinition>
        
            <RowDefinition Height="*" MinHeight="28"></RowDefinition>
        </Grid.RowDefinitions>
        <Menu DockPanel.Dock="Top"
              x:Name="menuGrid"
              Grid.Row="0"
              Grid.ColumnSpan="3">
            <MenuItem Header="_Print Preview"
                      x:Name="mbtnPrintPreview"
                      Click="MbtnPrintPreview_Click"></MenuItem>
            <MenuItem Header="Export To Report"
                      x:Name="mbtnExportToReport"
                      Click="MbtnExportToReport_Click"></MenuItem>
            <MenuItem Header="Refresh"
                      x:Name="mbtnRefresh"
                      Click="MbtnRefresh_Click"></MenuItem>
            <MenuItem Header="Direct Close"
                      x:Name="mbtnDriectClose"
                      Click="MbtnDriectClose_Click"></MenuItem>
            <MenuItem Header="Approve"
                          x:Name="mbtnApprove"
                          Click="MbtnApprove_Click"></MenuItem>
            <MenuItem 
                          x:Name="mbtnPending"
                          Click="MbtnPending_Click">
                <MenuItem.Template>
                    <dxg:DefaultControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending for Approval"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0" FontWeight="Bold" x:Name="txtApprovalcount" Text="{Binding ApprovalCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </dxg:DefaultControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            <MenuItem 
                          x:Name="mbtnPendingClosing"
                          Click="MbtnPendingClosing_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending for Closing"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtClosingcount" Text="{Binding ClosingCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            <MenuItem 
                          x:Name="mbtnRegister"
                          Click="MbtnRegister_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Purchase Invoice Register"></TextBlock>

                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->

                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtApproveUnapproved" Text="{Binding ApproveunapprovedCount}" Foreground="Blue"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            <MenuItem Header="Save Layout"
                          x:Name="mbtnSaveLayout"
                          Click="MbtnSaveLayout_Click"></MenuItem>
            <MenuItem 
                          x:Name="mbtnVoid"
                          Click="MbtnVoid_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Void"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtVoidcount" Text="{Binding VoidCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            <MenuItem 
                          x:Name="mbtnFullyInvoiced"
                          Click="mbtnFullyInvoiced_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fully Received"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtVoidcount" Text="{Binding VoidCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            <MenuItem 
                          x:Name="mbtnPartially"
                          Click="mbtnPartially_Click">
                <MenuItem.Template>
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Partially Received"></TextBlock>
                            <!--<Ellipse x:Name="elpApproval" Margin="5,0" Fill="Red" Width="10" Height="10">
                                </Ellipse>-->
                            <TextBlock Margin="5,0"  FontWeight="Bold" x:Name="txtVoidcount" Text="{Binding VoidCount}" Foreground="Red"></TextBlock>
                        </StackPanel>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
        </Menu>
    
        <TextBlock x:Name="lblHeading" Text="Purchase Invoices" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="2" FontFamily="Segoe UI Semibold"  ></TextBlock>
        <dxg:GridControl x:Name="grdpurchaseInvoice"
                 
                     Grid.Row="3"
                     Grid.ColumnSpan="3"
                     SelectionMode="Row"
                     ShowLoadingPanel="{Binding IsLoadingData}"
                      CustomUnboundColumnData="grid_CustomUnboundColumnData"   
                    AutoGenerateColumns="AddNew"
                     MouseDoubleClick="GrdpurchaseInvoice_MouseDoubleClick">

            <dxg:GridControl.View>
                <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       ShowAutoFilterRow="True"
                       Width="auto"
                       RowAnimationKind="None" WaitIndicatorType="Panel"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" 
                       ShowFixedTotalSummary="True"
                       ShowTotalSummary="True">
                </dxg:TableView>
            </dxg:GridControl.View>

            <dxg:GridColumn Header="Id"
                            FieldName="Id"
                            UnboundType="Integer"/>

            <dxg:GridColumn Header="Paid Amount"
                            FieldName="PaidAmount" UnboundType="decimal" ReadOnly="True" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Unpaid Amount"
                            FieldName="UnpaidAmount" UnboundType="decimal" ReadOnly="True" >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Company"
                            Binding="{Binding company.CompanyName}"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Customer"
                            FieldName="customerCompany.company.CompanyName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Vendor"
                            FieldName="vendor.company.CompanyName"
                            IsSmart="True"
                            Width="auto" />

            <dxg:GridColumn Header="Department level 1" UnboundType="string" x:Name="colDeptLevel1" ShowInColumnChooser="False"
                            
                            FieldName="departmentLevel1" 
                           />
            <dxg:GridColumn Header="Department level 2" UnboundType="string" x:Name="colDeptLevel2" ShowInColumnChooser="False"
                            FieldName="departmentLevel2"
                            />
            <dxg:GridColumn Header="Department level 3"  UnboundType="string" x:Name="colDeptLevel3" ShowInColumnChooser="False"
                            FieldName="departmentLevel3"
                            />
            <dxg:GridColumn Header="Department level 4"
                FieldName="departmentLevel4" UnboundType="string" x:Name="colDeptLevel4" ShowInColumnChooser="False"
                         IsSmart="True"
                            Width="auto"
                            />
            <dxg:GridColumn Header="Department level 5"
                FieldName="departmentLevel5" UnboundType="string" x:Name="colDeptLevel5" ShowInColumnChooser="False"
                         IsSmart="True"
                            Width="auto"
                            />



            <dxg:GridColumn Header="Allocate to"
                            FieldName="employee.person.FName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="Currency"
                            FieldName="currency.CurrencyName"
                            IsSmart="True"
                            Width="auto" />
            <dxg:GridColumn Header="P.O (O/C)"
                            FieldName="company.currency.CurrencyName"
                            IsSmart="True"
                            Width="auto" />
            
            <dxg:GridColumn Header="E.R(PKR)"
                            FieldName="marginExchangeRate"
                            IsSmart="True"
                            Width="auto"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="M.E.R"
                            FieldName="exchangeRate"
                            IsSmart="True"
                            Width="auto"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Invoice Amount(O.C)"
                            FieldName="totalInvoiceAmount"
                            IsSmart="True"
                            Width="auto" 
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
             <dxg:GridColumn Header="Tax Amount"
                            FieldName="totaltaxAmount"
                            IsSmart="True"
                            Width="auto" 
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="P.O Amount(O.C)"
                            FieldName="totalCFRValue"
                            IsSmart="True"
                            Width="auto"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            
            
            <dxg:GridColumn Header="Invoice Amount(PKR)"
                            FieldName="totalBaseCFRValue"
                            IsSmart="True"
                            Width="auto"
                            
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Total Weight"
                            FieldName="TotalWeight"
                            IsSmart="True"
                            Width="auto"
                            
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="Total Quantity"
                            FieldName="TotalQuantity"
                            IsSmart="True"
                            Width="auto"
                            
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="PurchaseInvoiceStatus.isActive"
                      x:Name="colisOpen"
                      IsSmart="True"
                      Header="Open"
                      Visible="False"
                      Width="auto">
                <dxg:GridColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock TextAlignment="Center"
                       Text="{Binding RowData.Row.PurchaseInvoiceStatus.isActive, Converter={StaticResource valueconverter}}" />
                    </DataTemplate>
                </dxg:GridColumn.CellTemplate>
            </dxg:GridColumn>
          
            <dxg:GridColumn x:Name="colstatus"
                      FieldName="PurchaseInvoiceStatus.Status"
                      Header="Status"
                      UnboundType="Bound"
                     Visible ="True"
                      VisibleIndex="6"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                <dxg:GridColumn.CellTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.PurchaseInvoiceStatus.backcolor}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.PurchaseInvoiceStatus.Status}"/>
                  </InlineUIContainer></TextBlock>
                        </Grid>
                    </DataTemplate>
                </dxg:GridColumn.CellTemplate>
            </dxg:GridColumn>
          
            <dxg:GridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add New"
                    x:Name="btnNewPurchaseInvoice"
                    Click="BtnNewPurchaseInvoice_Click" />
                    <MenuItem Header="Edit SaleInvoice"
                    x:Name="btnEditPurchaseInvoice"
                    Click="BtnEditPurchaseInvoice_Click" />
                    <Separator />
                    <MenuItem Header="Delete PurchaseInvoice"
                    x:Name="btnDeletePurchaseInvoice" />
                    <Separator />
                    <MenuItem Header="Print"
                              x:Name="mbtnPrintGrid" Click="Button_Click" />
                  
                </ContextMenu>
            </dxg:GridControl.ContextMenu>
        </dxg:GridControl>
   

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <dxe:TextEdit Text="From" FontWeight="DemiBold" Background="LightGreen" IsReadOnly="True" HorizontalContentAlignment="Center" Grid.Column="0" Grid.Row="1"/>
            <dxe:ComboBoxEdit x:Name="cmbxDepartmentFrom" NullText="Select Department" Grid.Column="1" Grid.Row="1" FontWeight="DemiBold" SelectedIndexChanged="cmbxDepartmentFrom_SelectedIndexChanged"/>
            <dxe:TextEdit Grid.Column="2" FontWeight="DemiBold" Background="Orange" IsReadOnly="True" Grid.Row="1" HorizontalContentAlignment="Center" Text="To"/>
            <dxe:ComboBoxEdit x:Name="cmbxDepartmentTo" NullText="Select Department" Grid.Column="3" Grid.Row="1" FontWeight="DemiBold" SelectedIndexChanged="cmbxDepartmentTo_SelectedIndexChanged" />
            <dx:SimpleButton x:Name="btnDepartmentFilter" ToolTip="Filter by department level" Grid.Column="4" Grid.Row="1" Content="Apply Department Filter" Cursor="Hand" Click="btnDepartmentFilter_Click"  />

            <dxe:TextEdit Text="From" FontWeight="DemiBold" Background="LightGreen" IsReadOnly="True" HorizontalContentAlignment="Center" Grid.Column="0"/>
            <dxe:DateEdit x:Name="dateFrom" NullText="Select Date" Grid.Column="1" FontWeight="DemiBold"    >

            </dxe:DateEdit>
            <dxe:TextEdit Grid.Column="2" FontWeight="DemiBold" Background="Orange" IsReadOnly="True" HorizontalContentAlignment="Center" Text="To"/>
            <dxe:DateEdit x:Name="dateTo" NullText="Select Date" Grid.Column="3" FontWeight="DemiBold"   >

            </dxe:DateEdit>
            <dx:SimpleButton x:Name="btnDateFilter" ToolTip="Filter by date range" Grid.Column="4" Content="Apply" Cursor="Hand" Click="BtnDateFilter_Click"  />

            <!--<dx:SimpleButton FontWeight="Bold" Content="Load More"  Grid.Column="0" x:Name="btnLoadMoreSO" Click="BtnLoadMoreSO_Click" Foreground="Black"/>
            <dx:SimpleButton FontWeight="Bold" Background="Orange" x:Name="btnLoadAll" Click="BtnLoadAll_Click" Content="Load All" Grid.Column="3" Foreground="Black"/>-->

        </Grid>
        </Grid>
</UserControl>
