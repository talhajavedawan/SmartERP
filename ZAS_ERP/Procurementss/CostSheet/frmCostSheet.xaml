<dx:DXWindow x:Class="ZAS_ERP.Procurementss.SaleOrderss.frmCostSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SaleOrderss"
        xmlns:loc="clr-namespace:ZAS_ERP"
        
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" 
             xmlns:dxnav="http://schemas.devexpress.com/winfx/2008/xaml/navigation"
             mc:Ignorable="d" 
        WindowState="Normal" WindowStartupLocation="CenterScreen"
        Title="Cost Center"  Height="450" Width="500"
        x:Name="formCostSheet" Loaded="FrmCostSheet_Loaded" 
        Unloaded="FrmCostSheet_Unloaded" >
    <Window.CommandBindings>
        <CommandBinding Command="loc:CustomCommands.ReplytoComment" CanExecute="Command_CanExecute" Executed="Command_Executed" />
        <CommandBinding Command="loc:CustomCommands.ChangeFlag" CanExecute="Resend_CanExecute" Executed="Resend_Executed" />
    </Window.CommandBindings>
    <Window.Resources>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>

        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <StackPanel  VerticalAlignment="Top" HorizontalAlignment="Left" dx:ThemeManager.ThemeName="None"
                 Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">
                    <Image Source="/ZAS_ERP;component/images/log.png"></Image>
                </Button>
                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2" Click="BtnCommentLog_Click"  ToolTip="CommentLog for R.S.B.C">
                    <Image  Source="/ZAS_ERP;component/images/comments.png" ></Image>
                </Button>
                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" Click="BtnAddComment_Click"  ToolTip="Add New Comment for R.S.B.C">
                    <Image  Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
                </Button>
                <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnTrackingWindow" Grid.Column="2" Click="BtnTrackingWindow_Click"  ToolTip="360 View">
                    <Image  Source="/ZAS_ERP;component/images/360Arrow.png" ></Image>
                </Button>
                <Button x:Name="btnStageTracking"  Width="30" Height="30"  Grid.Column="3" Margin="5,0,0,0" ToolTip="Orders Stage Tracking" Click="btnStageTracking_Click" Visibility="Visible">
                    <Image   Source="{dx:DXImage Image=PackageProduct_32x32.png}"></Image>
                </Button>
                <Button x:Name="btnPOTracking"  Width="30" Height="30" Margin="5,0,0,0" Grid.Column="3" ToolTip="Vendor Profile By PO" Click="btnPOTracking_Click" Visibility="Visible">
                    <Image   Source="{dx:DXImage Image=TimeLineView_32x32.png}"></Image>
                </Button>
                <Button x:Name="btnLinkedSO"  Width="30" Height="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Linked SO" Click="btnLinkedSO_Click" Visibility="Visible">
                    <Image   Source="{dx:DXImage Image=LinkToPrevious_16x16.png}"></Image>
                </Button>
                <StackPanel Orientation="Horizontal" x:Name="stackPanelCheckBoxes">
                    <dxe:CheckEdit x:Name="checkHideRevisedCost" Margin="5,5,5,5"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Content="Hide Revised Cost" Checked="CheckHideRevisedCost_Checked" Unchecked="CheckHideRevisedCost_Unchecked" />
                    <dxe:CheckEdit x:Name="checkHideUnHideTransactions"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Content="Hide Null Transactions" Checked="CheckHideUnHideTransactions_Checked" Unchecked="CheckHideUnHideTransactions_Unchecked" />
                    <dxe:CheckEdit x:Name="checkHideActualCost"  Margin="5,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Content="Hide Actual Cost" Checked="CheckHideActualCost_Checked" Unchecked="CheckHideActualCost_Unchecked" />
                    <dxe:CheckEdit x:Name="checkPOTerms"  Margin="5,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Content="Hide PO-Terms" Checked="CheckPOTerms_Checked" Unchecked="CheckPOTerms_Unchecked" />
                    <dxe:CheckEdit x:Name="checkCostSheetFields"  Margin="5,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Content="Hide Costing" Checked="CheckCostSheetFields_Checked" Unchecked="CheckCostSheetFields_Unchecked" />
                    <dxe:CheckEdit x:Name="checkVendorProfile" IsChecked="True" Margin="5,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Content="Hide Vendor Profile" Checked="checkVendorProfile_Checked" Unchecked="checkVendorProfile_Unchecked" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid x:Name="gridVendorProfileByPO"     Visibility="Collapsed"    Panel.ZIndex="5" Grid.RowSpan="3" Width="900"  Margin="35"  HorizontalAlignment="Left" >
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="135*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <dxnav:TileNavPane  VerticalAlignment="Center" Grid.ColumnSpan="2">
                    <dxnav:TileNavPane.NavButtons>
                        <dxnav:NavButton x:Name="btnVendorProfileByPO"    FontWeight="Bold" Content="   Vendor Profile By Cost Sheet" ToolTip="Vendor Profile By Cost Sheet" Cursor="Hand" GlyphAlignment="Left" Glyph="{dx:DXImageGrayscale Image=Home_32x32.png}" AllowGlyphTheming="True" HorizontalAlignment="Stretch" Click="btnVendorProfileByPO_Click" />
                        <dxnav:NavButton x:Name="btnSavePoLayout" Content="Save Layout" Click="btnSavePOLayout_Click" Glyph="{dx:DXImageGrayscale Image=Save_32x32.png}" ToolTip="Save Layout"  AllowGlyphTheming="True" />
                        <dxnav:NavButton Content="Dashboard..." HorizontalAlignment="Right" AllowGlyphTheming="True"  Glyph="{dx:DXImageGrayscale Image=Pie_32x32.png}">
                            <dxnav:TileNavItem x:Name="btnOpenVendorProfile" Content="Open"  Cursor="Hand"  FontWeight="DemiBold" AllowGlyphTheming="True"  TileGlyph="{dx:DXImageGrayscale Image=Apply_16x16.png}" Background="SeaGreen"  Click="btnOpenVendorProfile_Click"/>
                            <dxnav:TileNavItem x:Name="btnCloseVendorProfile" Content="Close"  Cursor="Hand"  FontWeight="DemiBold" AllowGlyphTheming="True" TileGlyph="{dx:DXImageGrayscale Image=Close_16x16.png}" Background="IndianRed"  Click="btnCloseVendorProfile_Click"/>
                            <dxnav:TileNavItem x:Name="btnPendingForApprovalVendorProfile" Cursor="Hand"  FontWeight="DemiBold" AllowGlyphTheming="True" TileGlyph="{dx:DXImageGrayscale Image=Pie_16x16.png}" Background="YellowGreen"  Width="200" Content="Pending for Approval" Click="btnPendingForApprovalVendorProfile_Click"/>
                            <dxnav:TileNavItem x:Name="btnAllVendorProfile" Content="All" Cursor="Hand"  FontWeight="DemiBold" AllowGlyphTheming="True" TileGlyph="{dx:DXImageGrayscale Image=AddNewDataSource_16x16.png}" Background="MediumBlue"  Click="btnAllVendorProfile_Click"/>
                        </dxnav:NavButton>

                    </dxnav:TileNavPane.NavButtons>
                </dxnav:TileNavPane>
                <Grid  Grid.Row="1" Grid.ColumnSpan="2"  Background="White" >

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="5" Grid.RowSpan="2">
                        <Border x:Name="brdraingGold" BorderThickness="2" Height="100" Width="100" Visibility="Collapsed"  CornerRadius="25" Background="Goldenrod" >
                            <TextBlock x:Name="txtTotalRatingGold"  FontSize="50" Visibility="Collapsed" Background="Goldenrod" FontWeight="DemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border  x:Name="brdraingGray" BorderThickness="2" Height="100" Width="100" Visibility="Collapsed"  CornerRadius="25" Background="Gray" >
                            <TextBlock x:Name="txtTotalRatingGray"  FontSize="50" Foreground="White" FontWeight="DemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>
                        <Border x:Name="brdraingGreen" BorderThickness="2" Height="100" Width="100" Visibility="Collapsed"  CornerRadius="25" Background="green" >
                            <TextBlock x:Name="txtTotalRatingGreen"  FontSize="50" Foreground="White" FontWeight="DemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>
                        <Border x:Name="brdrainglightblue" BorderThickness="2" Height="100" Width="100" Visibility="Collapsed"  CornerRadius="25" BorderBrush="Blue" >
                            <TextBlock x:Name="txtTotalRatingBlue" Visibility="Collapsed" FontSize="50" Foreground="White" FontWeight="DemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>
                 

                    </Grid>



                    <Grid Grid.Row="1"  Grid.Column="1"  Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="DemiBold" Text="Cost Sheet Vendors"/>

                        <dxg:LookUpEdit x:Name="lookupSelectVendor"
                          Grid.Column="1"
                          Margin="25,0,0,0"                      
                          AutoPopulateColumns="True"
                          DisplayMember="company.CompanyName"
                                    SelectedIndexChanged="lookupSelectVendor_SelectedIndexChanged">
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>

                                        <dxg:GridControl Name="PART_GridControl"
                                   AutoPopulateColumns="True"
                                   Grid.Row="1">
                                            <dxg:GridColumn x:Name="colId"
                                    FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                            <dxg:GridColumn FieldName="company.CompanyName"
                                    IsSmart="True"
                                    Width="auto" />
                                            <dxg:GridColumn FieldName="company.IndustryType"
                                    IsSmart="True"
                                    Visible="False" />
                                            <dxg:GridColumn x:Name="colBizType"
                                    FieldName="company.BizType"
                                    Visible="False"
                                    IsSmart="True" />
                                            <dxg:GridColumn FieldName="contactPerson.FName"
                                    x:Name="colFname"
                                    IsSmart="True"
                                    Visible="True"
                                    Header="First Name"
                                    Width="auto" />
                                            <dxg:GridColumn FieldName="contactPerson.LName"
                                    x:Name="colLname"
                                    IsSmart="True"
                                    Visible="True"
                                    Header="Last Name"
                                    Width="auto" />
                                            <dxg:GridColumn FieldName="contact.ContactNo"
                                    IsSmart="True"
                                    x:Name="colcontactno"
                                    Visible="True"
                                    Header="Phone"
                                    Width="auto" />
                                            <dxg:GridColumn FieldName="company.currency.CurrencyName"
                                    x:Name="colCurrency"
                                    IsSmart="True"
                                    Visible="False"
                                    Header="Currency" />
                                            <dxg:GridColumn FieldName="contact.Fax"
                                    Visible="False"
                                    x:Name="colFax"
                                    IsSmart="True"
                                    Header="Fax" />
                                            <dxg:GridColumn FieldName="contact.Email"
                                    x:Name="colEmail"
                                    IsSmart="True"
                                    Visible="False"
                                    Header="Email" />
                                        </dxg:GridControl>
                                    </Grid>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>

                    </Grid>
                    <TextBlock x:Name="lblVendorProfileByPO" Grid.Column="1" Grid.Row="0" Text="Vendor Profile By PO" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center"  FontFamily="Segoe UI Semibold"  ></TextBlock>



                    <dxg:GridControl x:Name="grdVendorProfileByPO" MinHeight="500" Grid.ColumnSpan="2" MaxHeight="790" AutoGenerateColumns="None"  SelectionMode="Row" AutoExpandAllGroups="True" IsRecursiveExpand="True" AllowInitiallyFocusedRow="False" Grid.Row="2">
                        <dxg:GridControl.View>
                            <dxg:TableView ColumnFilterPopupMode="Excel"
                                                   NavigationStyle="Row"
                                           AutoWidth="True"
                                                   ShowAutoFilterRow="True"
                                                   RowAnimationKind="None" WaitIndicatorType="Panel"
                                                   AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                                   ShowFixedTotalSummary="True"
                                                   ShowTotalSummary="True"/>
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="Id" Visible="False" Width="auto" IsSmart="True"/>
                      

                        <dxg:GridColumn FieldName="stage" Header="Stage" IsSmart="True" Width="auto"  Image="{dx:DXImage Image=Action_Show_PivotGrid_Designer.png}"/>
                        <dxg:GridColumn x:Name="piStatus" Width="auto" IsSmart="True"
                                                Image="{dx:DXImage Image=Status_16x16.png}"
                      FieldName="PurchaseInvoiceStatus.Status"
                      Header="Status"
                      UnboundType="Bound"
                     Visible ="True"
                    AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.PurchaseInvoiceStatus.backcolor}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.PurchaseInvoiceStatus.Status}"/>
                  </InlineUIContainer></TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="vendor" Header="Vendor" IsSmart="True" Image="{dx:DXImage Image=BO_Department.png}"/>

                    </dxg:GridControl>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="gridOrderStageTrack"  Grid.RowSpan="5"   Visibility="Collapsed"  Background="White"  Panel.ZIndex="5" VerticalAlignment="Top"  Margin="50,30,65,35" HorizontalAlignment="Left">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <dxnav:TileNavPane  VerticalAlignment="Center">
                    <dxnav:TileNavPane.NavButtons>
                        <dxnav:NavButton x:Name="btnOrderStageByTrack"    FontWeight="Bold" Content="   Orders Tracking" ToolTip="Orders Tracking" Cursor="Hand" GlyphAlignment="Left"  AllowGlyphTheming="True" HorizontalAlignment="Stretch" />
                        <dxnav:NavButton x:Name="btnRefresh" Content="Refresh" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top"  Glyph="{dx:DXImageGrayscale Image=Refresh_32x32.png}" Click="btnRefresh_Click"/>
                        <dxnav:NavButton x:Name="btnExpand" Content="Expand" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top"  Glyph="{dx:DXImage Image=ExpandFieldPivotTable_32x32.png}" Click="btnExpand_Click_1"/>
                        <dxnav:NavButton x:Name="btnCollapsed" Content="Collapse" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top"  Glyph="{dx:DXImage Image=CollapseFieldPivotTable_32x32.png}" Click="btnCollapsed_Click"/>


                    </dxnav:TileNavPane.NavButtons>
                </dxnav:TileNavPane>
                <Grid  Grid.Row="1" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                    </Grid>

                    <TextBlock x:Name="lblOrdersStage" Grid.Row="0" Text="Orders Tracking" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center"  FontFamily="Segoe UI Semibold"  ></TextBlock>



                    <dxg:GridControl x:Name="grdOrdersTracking"  MinHeight="400"  MaxHeight="790"  SelectionMode="Row"   AllowInitiallyFocusedRow="True" Grid.Row="2">
                        <dxg:GridControl.View>
                            <dxg:TreeListView x:Name="grdTrackingTree"
                                        KeyFieldName="Id"
                                                       MouseDoubleClick="TreeListView_MouseDoubleClick"
                            ParentFieldName="ParentId"
                           AllowEditing="False"
                            NavigationStyle="Row"
                            Width="auto"
                            AutoWidth="True"      
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoPopulateServiceColumns="False"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True"      
                            ShowTotalSummary="True"    
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True"                           
                                                       >
                                <dxg:TreeListView.FormatConditions>
                                    <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Closed">
                                        <dx:Format Background="#FFFF0000"/>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Approved">
                                        <dx:Format Background="#FF9BBB59"/>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Under Closing">
                                        <dx:Format Background="#FFF79646"/>
                                    </dxg:FormatCondition>

                                    <dxg:FormatCondition FieldName="Stage" ValueRule="Equal" Value1="Under Approval" ApplyToRow="false">
                                        <dx:Format Background="#8E4CACC7"/>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="Stage" ValueRule="Equal" Value1="Void" ApplyToRow="false">
                                        <dx:Format Background="#FFBFBFBF"/>
                                    </dxg:FormatCondition>
                                </dxg:TreeListView.FormatConditions>

                            </dxg:TreeListView>
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="Id" Visible="False"/>
                        <dxg:GridColumn FieldName="GroupId" Header="Group Id"  Visible="False" />
                        <dxg:GridColumn FieldName="Stage" VisibleIndex="7" Header="Stage"  Image="{dx:DXImage Image=Action_Show_PivotGrid_Designer.png}"/>

                        <dxg:GridColumn 
                                    VisibleIndex="6"
                                          FieldName="_Status"
                                          Header="Status"
                                          UnboundType="Bound"
                                          Image="{dx:DXImage Image=Status_16x16.png}"
                                          Visible ="True"
                                          AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.BackColor}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.Status}"/>
                  </InlineUIContainer></TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn 
                                    VisibleIndex="6"
                                          FieldName="_StatusClass"
                                          Header="Status Class"
                                          UnboundType="Bound"
                                          Image="{dx:DXImage Image=Status_16x16.png}"
                                          Visible ="True"
                                          AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.BackColorStatusClass}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.StatusClass}"/>
                  </InlineUIContainer></TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>


                        <dxg:GridColumn FieldName="Company" VisibleIndex="1" Header="Company" Image="{dx:DXImage Image=Home_16x16.png}"/>
                        <dxg:GridColumn FieldName="Department" VisibleIndex="2" Header="Department" Image="{dx:DXImage Image=BO_Department.png}"/>
                        <dxg:GridColumn FieldName="Vendor" VisibleIndex="3" Header="Vendor" Image="{dx:DXImage Image=BO_Department.png}"/>
                        <dxg:GridColumn FieldName="Currency" VisibleIndex="4" Header="Currency"  Image="{dx:DXImage Image=Currency2_16x16.png}"/>
                        <dxg:GridColumn FieldName="AmountOC" VisibleIndex="5" Header="Amount(OC)"  Image="{dx:DXImage Image=Currency2_16x16.png}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="transactionType" VisibleIndex="0" Header="Transaction Type"  Image="{dx:DXImage Image=Currency2_16x16.png}">

                        </dxg:GridColumn>




                    </dxg:GridControl>
                </Grid>
            </Grid>
        </Grid>
        <Grid  Visibility="Collapsed" x:Name="gridTracker"  Panel.ZIndex="5" Grid.RowSpan="5" Width="500" Margin="35"  HorizontalAlignment="Left" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="btnCollapse" Click="BtnCollapse_Click" Content="Collapse"></Button>
                <TextBlock Text="Activity Tracker" FontWeight="Bold" FontSize="26" Foreground="Black" Margin="30,5"></TextBlock>
                <Button x:Name="btnexpand" Click="Btnexpand_Click" Content="Expand"></Button>

            </StackPanel>
            <dxg:GridControl x:Name="grdUsers" Visibility="Visible"
                     Grid.Row="1" 
                     Grid.RowSpan="5" HorizontalAlignment="Left"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             
                     SelectionMode="Row" 
                             
                             
                      CustomUnboundColumnData="GrdUsers_CustomUnboundColumnData"   
                    AutoGenerateColumns="None">
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       
                                   AutoWidth="True"
                       Width="auto"
                       AllowGrouping="False"
                                   ShowGroupPanel="False"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       
                       >

                    </dxg:TableView>
                </dxg:GridControl.View>
                <dxg:GridColumn Header="User Name"
                            FieldName="User.userName"
                            IsSmart="True"
                            Width="auto" />

                <dxg:GridColumn FieldName="Timestamp" UnboundType="String" ReadOnly="True" Width="auto">

                </dxg:GridColumn>
                <dxg:GridColumn Header="Info"
                            FieldName="Info"
                            IsSmart="True"
                            Width="auto" />
                <dxg:GridColumn 
                            FieldName="Comment"
                            IsSmart="True"
                            Width="auto" />

            </dxg:GridControl>
        </Grid>
        <Grid x:Name="grdComments"  Visibility="Collapsed" Margin="35"  Panel.ZIndex="5" Grid.RowSpan="6" Width="500"   HorizontalAlignment="Left" Background="White">
            <dxg:GridControl AutoExpandAllGroups="True"     dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">
                <!--#region Columns-->
                <dxg:GridControl.Columns>


                    <dxg:GridColumn Width="Auto"  FieldName="employee.person.FName" Header="Sender"/>
                    <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                    <dxg:GridColumn Width="Auto" FieldName="Subject" />
                    <dxg:GridColumn Width="Auto" FieldName="Comment"/>
