<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Procurementss.CostSheet.winSystemCostingLedger"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.CostSheet" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Title="System Cost Ledger"  Height="400" Width="1000" WindowStartupLocation="CenterScreen" WindowStyle="ThreeDBorderWindow" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Background="Beige" FontSize="15" FontWeight="DemiBold" Text="SYSTEM COST LEDGER" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <dxg:GridControl
            x:Name="grdCostItems"
                         Grid.Row="1"
                         Grid.ColumnSpan="4"
                         SelectionMode="Row"
                         MouseDoubleClick="GrdCostItems_MouseDoubleClick"
                        TabIndex="45" >
            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="False"
                           ShowGroupPanel="False"
                          AllowBandMoving="False"
                               AllowColumnMoving="False"
                              
                               AllowFilterEditor="False"
                               AllowColumnFiltering="False"
                               ShowHorizontalLines="True"
                               ShowVerticalLines="True"
                               HorizontalScrollbarVisibility="Visible"
                               AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"

                           x:Name="view"
                          ShowFixedTotalSummary="False" ShowTotalSummary="True">

                </dxg:TableView>
            </dxg:GridControl.View>

            <dxg:GridColumn FieldName="Field.Title"
                            Header="Account Head"
                            ReadOnly="True"
                            VisibleIndex="1"
                            >
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="refNo"
                            Header="Reference No."
                            VisibleIndex="0"
                            ReadOnly="True"
                            >
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="Value"
                            Header="System Cost"
                            VisibleIndex="2"
                            ReadOnly="True"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="TimeStamp"
                            Header="Time Stamp" 
                            VisibleIndex="3"                   
                            ReadOnly="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:DateEditSettings/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="isPO"
                            Header="Purchase Order"
                            ReadOnly="True"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:CheckEditSettings/>
                </dxg:GridColumn.EditSettings>

            </dxg:GridColumn>
            <dxg:GridColumn FieldName="isPI"
                            Header="Purchase Invoice"
                            ReadOnly="True"
                          >
                <dxg:GridColumn.EditSettings>
                    <dxe:CheckEditSettings/>
                </dxg:GridColumn.EditSettings>

            </dxg:GridColumn>

            <dxg:GridColumn FieldName="isBill"
                            Header="Vendor Bill"
                            ReadOnly="True"
                             >
                <dxg:GridColumn.EditSettings>
                    <dxe:CheckEditSettings/>
                </dxg:GridColumn.EditSettings>

            </dxg:GridColumn>
            <dxg:GridColumn FieldName="isReceipt"
                            Header="Sales Receipt"
                            ReadOnly="True"
                           >
                <dxg:GridColumn.EditSettings>
                    <dxe:CheckEditSettings/>
                </dxg:GridColumn.EditSettings>

            </dxg:GridColumn>
            <dxg:GridColumn FieldName="isPayment"
                            Header="Payment"
                            ReadOnly="True"
                             >
                <dxg:GridColumn.EditSettings>
                    <dxe:CheckEditSettings/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="isSaleInvoice"
                            Header="Sales Invoice"
                            ReadOnly="True"
                             >
                <dxg:GridColumn.EditSettings>
                    <dxe:CheckEditSettings/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>


        </dxg:GridControl>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="29"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="30"/>


            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1"
                       Background="Beige" 
                       FontWeight="DemiBold" 
                       Text="Total SO Cost" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Margin="5,8"/>
            <dxe:TextEdit Grid.Column="2" 
                          x:Name="txtTotalSOCost"
                          Margin="5" 
                          Mask="n2"
                          IsReadOnly="True"
                          MaskUseAsDisplayFormat="True"
                          MaskType="Numeric"/>
            <TextBlock Grid.Column="3"
                       Background="Beige" 
                       FontWeight="DemiBold" 
                       Text="Total Budgeted/RSBC Cost" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Margin="5,8"/>
            <dxe:TextEdit Grid.Column="4" 
                          x:Name="txtTotalBudgtedCost"
                          Margin="5" 
                          Mask="n2"
                          IsReadOnly="True"
                          MaskUseAsDisplayFormat="True"
                          MaskType="Numeric"/>


            <!--<TextBlock Grid.Column="5"
                       Background="Beige" 
                       FontWeight="DemiBold" 
                       Text="Total Budgeted Cost %" 
                       HorizontalAlignment="Stretch" 
                       VerticalAlignment="Stretch"
                       Margin="5"/>
            <dxe:TextEdit Grid.Column="7" x:Name=
                          "txtTotalBudgtedCostPerc"
                          Margin="5"/>-->

            <TextBlock Grid.Column="5"
                       Background="Beige" 
                    
                       FontWeight="DemiBold" 
                       Text="Total System Cost" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       
                       Margin="5,8"/>
            <dxe:TextEdit Grid.Column="6" 
                          x:Name="txtTotalSystemCost" 
                          Margin="5" 
                          Mask="n2" 
                          MaskType="Numeric"
                          IsReadOnly="True"
                          MaskUseAsDisplayFormat="True"
                          />


            <TextBlock Grid.Column="7"
                       Background="Beige" 
                       FontWeight="DemiBold" 
                       Text="System Cost %" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Margin="5,8"/>
            <dxe:TextEdit Grid.Column="8" x:Name=
                          "txtTotalSystemCostPerc" 
                          IsReadOnly="True"
                          MaskUseAsDisplayFormat="True"
                          Margin="5" MaskType="Numeric" Mask="P"/>



        </Grid>

    </Grid>
</dx:DXWindow>
