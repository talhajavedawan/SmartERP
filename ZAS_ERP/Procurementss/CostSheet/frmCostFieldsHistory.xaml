<Window x:Class="ZAS_ERP.Procurementss.SaleOrderss.frmCostFieldsHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SaleOrderss"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Title="frmCostFieldsHistory" Height="450" Width="800">
    <Grid>
        <dxg:GridControl
            Margin="10,0" x:Name="grdCostItems"
                         Grid.Row="4"
                         Grid.ColumnSpan="4"
                         SelectionMode="Cell"
                         OverridesDefaultStyle="True"
            
                        TabIndex="45" AutoGenerateColumns="None" >
            <dxg:GridControl.View>
                <dxg:TableView x:Name="view" ShowFixedTotalSummary="False" ShowGroupPanel="False" AllowGrouping="False" ShowTotalSummary="False"/>
            </dxg:GridControl.View>

            <dxg:GridColumn FieldName="Field.Title"
                            IsSmart="True" Width="auto"
                          Header="Account Heads" ReadOnly="True" />


            <dxg:GridColumn FieldName="Value"
                          Header="Cost"
                            IsSmart="True" Width="auto">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn FieldName="timeStamp"
                          Header="Date"
                                IsSmart="True" Width="auto" GroupIndex="0">

            </dxg:GridColumn>
            <dxg:GridColumn FieldName="FieldType"
                          Header="Cost Type"
                                 Width="auto" GroupIndex="1">

            </dxg:GridColumn>
            <!--
            <dxg:GridColumn FieldName="actualValue"
                          Header="Actual Cost"
                                IsSmart="True" Width="auto">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn x:Name="colactualValuePrint"
                          Header="Actual Cost" ShowInColumnChooser="False" Visible="False">

            </dxg:GridColumn>-->
        </dxg:GridControl>
    </Grid>
</Window>
