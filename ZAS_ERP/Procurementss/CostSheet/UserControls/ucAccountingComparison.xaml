<UserControl x:Class="ZAS_ERP.Procurementss.CostSheet.UserControls.ucAccountingComparison"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.CostSheet.UserControls" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!--label Accounting Comparison-->
            <Grid Grid.Row="0" Grid.ColumnSpan="4" >

                <TextBlock  x:Name="lblAccounting"   HorizontalAlignment="Center"  Background="LightGray" Padding="5" FontSize="20" VerticalAlignment="Top" FontWeight="DemiBold" Text="Merge Cost-Sheets"/>

            </Grid>

            <!--Lable Parent and Child-->
            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="lblParentSO" FontSize="20"  HorizontalAlignment="Center" Background="LightGray" FontWeight="DemiBold" Text="Parent SO-Cost Sheet"/>
                <TextBlock Grid.Column="1" x:Name="lblChildSO" FontSize="20" HorizontalAlignment="Center" Background="LightGray"  FontWeight="DemiBold" Text="Child SO-Cost Sheet"/>
            </Grid>

            <!--Parent SO-->
            <Grid Grid.Row="2"  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="lblCompany"      Grid.Row="0"  FontWeight="DemiBold" Text="Company"    />
                <dxe:TextEdit x:Name="txtCompany"   Grid.Row="0" Grid.Column="1"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold"  ></dxe:TextEdit>
                <TextBlock x:Name="lblCustomer"     Grid.Row="1" Grid.Column="2"   FontWeight="DemiBold" Text="Customer"    />
                <dxe:TextEdit x:Name="txtCustomer"  Grid.Row="1" Grid.Column="3"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold"  ></dxe:TextEdit>
                <TextBlock x:Name="lblDepartment"   Grid.Row="0" Grid.Column="2"  FontWeight="DemiBold" Text="Department"   />
                <dxe:TextEdit x:Name="txtDepartment" Grid.Row="0" Grid.Column="3"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold"  ></dxe:TextEdit>
                <TextBlock x:Name="lblPrincipal"     Grid.Row="1"  FontWeight="DemiBold" Text="Principal"    />
                <dxe:TextEdit x:Name="txtPrincipal"  Grid.Row="1" Grid.Column="1" IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold"  ></dxe:TextEdit>
                <TextBlock x:Name="lblSaleOrderDate" Grid.Row="2"   Text="Sale Order Date" FontWeight="DemiBold"   ></TextBlock>
                <dxe:TextEdit x:Name="txtSaleOrderDate"  Grid.Row="2" Grid.Column="1"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold"  ></dxe:TextEdit>
                <TextBlock x:Name="lblSOreferenceNo"    Grid.Row="2" Grid.Column="2"    Text="SO Ref. No." FontWeight="DemiBold"    ></TextBlock>
                <dxe:TextEdit x:Name="txtSORef"        Grid.Row="2" Grid.Column="3"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold" ></dxe:TextEdit>
                <TextBlock x:Name="lblSalesReferenceNo"  Grid.Row="3" Grid.Column="2"   
                                   Text="Sales Ref. No." FontWeight="DemiBold"    ></TextBlock>
                <dxe:TextEdit x:Name="txtSalesRef"     Grid.Row="3" Grid.Column="3"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold" MaskType="Numeric" ></dxe:TextEdit>
                <TextBlock x:Name="lblCreationDate"     Grid.Row="3" Grid.Column="0"   Text="Creation Date." FontWeight="DemiBold"    ></TextBlock>
                <dxe:TextEdit x:Name="txtCreationDate"  Grid.Row="3" Grid.Column="1"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold"  ></dxe:TextEdit>
                <TextBlock x:Name="lblFinanceRef"      Grid.Column="2"  Grid.Row="4"   Text="Finance Ref." FontWeight="DemiBold"    ></TextBlock>
                <dxe:TextEdit x:Name="txtFinanceRef"    Grid.Row="4" Grid.Column="3"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold"  ></dxe:TextEdit>

                <TextBlock x:Name="lblParentCurrencyOC"         Grid.Row="4"   Text="Currency (OC)" FontWeight="DemiBold"    ></TextBlock>
                <dxe:TextEdit x:Name="txtParentCurrencyOC"      Grid.Row="4" Grid.Column="1"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold"  ></dxe:TextEdit>

                <TextBlock x:Name="lblParentCurrencyCC"         Grid.Row="5"   Text="Currency(CC)" FontWeight="DemiBold"    ></TextBlock>
                <dxe:TextEdit x:Name="txtParentCurrencyCC"      Grid.Row="5" Grid.Column="1"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold"  ></dxe:TextEdit>
                <TextBlock x:Name="lblTotalParentSOAmount"     Grid.Row="6"   Text="Total SO-Amount" FontWeight="DemiBold"    ></TextBlock>
                <dxe:TextEdit x:Name="txtTotalParentSOAmount"   Grid.Row="6" Grid.Column="1"   Text="0"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"  Mask="n2"   FontWeight="DemiBold" MaskType="Numeric" />
                <TextBlock x:Name="lblTotalParentSupplyCCER"      Grid.Row="5" Grid.Column="2"   Text="Cost Center Exchange Rate" FontWeight="DemiBold"    ></TextBlock>
                <dxe:TextEdit x:Name="txtTotalParentSupplyCCER"   Grid.Row="5" Grid.Column="3"  Text="0"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"  Mask="n2"  FontWeight="DemiBold" MaskType="Numeric" />
                <TextBlock x:Name="lblSupplyCCAmount"   Grid.Column="2"  Grid.Row="6"    Text="Total SO-Amount Supply(CCC)" FontWeight="DemiBold"    ></TextBlock>
                <dxe:TextEdit x:Name="txtParentSupplyCCTAmount"   Grid.Row="6" Grid.Column="3"  Text="0"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"  Mask="n2"  FontWeight="DemiBold" MaskType="Numeric" />
                <TextBlock x:Name="lblTotalAmount"       Grid.Row="7" Grid.Column="0"    Text="Total Amount" FontWeight="DemiBold"    ></TextBlock>
                <dxe:TextEdit x:Name="txtTotalParentAmount"   Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Text="0"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"  Mask="n2" FontWeight="DemiBold" MaskType="Numeric" />
                <dxe:TextEdit x:Name="txtTotalChildBudgetedCost"  Visibility="Collapsed"  Grid.Row="6" Grid.Column="3"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold" MaskType="Numeric" />
                <dxe:TextEdit x:Name="txtTotalChildActualCost"  Visibility="Collapsed"  Grid.Row="6" Grid.Column="3"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold" MaskType="Numeric" />
                <dxe:TextEdit x:Name="txtTotalChildSystemCost"  Visibility="Collapsed"  Grid.Row="6" Grid.Column="3"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold" MaskType="Numeric" />
                <dxe:TextEdit x:Name="txtTotalParentBudgetedCost"  Visibility="Collapsed"  Grid.Row="6" Grid.Column="3"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold" MaskType="Numeric" />
                <dxe:TextEdit x:Name="txtTotalParentActualCost"  Visibility="Collapsed"  Grid.Row="6" Grid.Column="3"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold" MaskType="Numeric" />
                <dxe:TextEdit x:Name="txtTotalParentSystemCost"  Visibility="Collapsed"  Grid.Row="6" Grid.Column="3"  IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold" MaskType="Numeric" />
                <TextBlock x:Name="lblStatus"     Grid.Row="8"  
                                   Text="SO Status" FontWeight="DemiBold"    ></TextBlock>
                <ComboBox 
                    Grid.Column="1"
                    Grid.ColumnSpan="3"              
                    Grid.Row="8" 
                    TabIndex="11"
                            IsEnabled="False"
                            IsReadOnly="True"
                    x:Name="cmbStatus"
                   >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding id}"
                             Visibility="Hidden" />
                                <TextBlock Text="   "
                             Background="{Binding bcolor}"
                             Width="20"
                             Margin="10,0" />
                                <TextBlock Text="{Binding name}"
                             Grid.Column="1"
                             Foreground="{Binding fcolor}"
                             HorizontalAlignment="Stretch"></TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>


                <dxg:GridControl x:Name="grdParentCostItems"
                                         SelectionMode="Cell"
                                         Grid.Column="0"
                                         Grid.ColumnSpan="4"
                                         Grid.Row="9"
                                         MaxHeight="1500"
                                         CustomSummary="grdParentCostItems_CustomSummary"
                                         CustomUnboundColumnData="grdParentCostItems_CustomUnboundColumnData"
                                         TabIndex="45" >
                    <dxg:GridControl.View>
                        <dxg:TableView AutoWidth="False"
                                               ShowGroupPanel="False"
                                               AllowBandMoving="False"
                                               AllowColumnMoving="False"
                                               AllowSorting="False"
                                               AllowFilterEditor="False"
                                               AllowColumnFiltering="False"
                                               ShowHorizontalLines="True"
                                               ShowVerticalLines="True"
                                               HorizontalScrollbarVisibility="Visible"
                                               AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                               x:Name="parentView"
                                               CellValueChanged="parentView_CellValueChanged" 
                                               ShowFixedTotalSummary="False" 
                                               ShowTotalSummary="True">
                        </dxg:TableView>
                    </dxg:GridControl.View>


                    <dxg:GridColumn x:Name="vendorName"
                                            FieldName="vendor"
                                            Header="Vendor"
                                            IsSmart="True"
                                            VisibleIndex="1" 
                                            UnboundType="bound"
                                            UnboundExpression="[company.CompanyName]">
                        <dxg:GridColumn.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RowData.Row.vendor.company.CompanyName}"></TextBlock>
                            </ControlTemplate>
                        </dxg:GridColumn.DisplayTemplate>
                        <dxg:GridColumn.EditSettings>
                            <dxg:LookUpEditSettings x:Name="lookupVendors"
                                      AutoPopulateColumns="False"                 
                                      IsPopupAutoWidth="False"           
                                      DisplayMember="company.CompanyName"
                                      NullText="Select Item">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Button x:Name="btnAddItem"
                              Click="btnAddItem_Click"
                              
                              Content="--Add New--" />
                                            <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                <dxg:GridControl.View>
                                                    <dxg:TableView x:Name="grdVendors"
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            Width="auto"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            ShowTotalSummary="True" 
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" />
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn x:Name="colId"
                                    FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                                <dxg:GridColumn FieldName="company.CompanyName"
                                    IsSmart="True"
                                    Width="auto" />
                                                <dxg:GridColumn FieldName="company.IndustryType"
                                    IsSmart="True"
                                    Visible="False" />
                                                <dxg:GridColumn x:Name="colBizType"
                                    FieldName="company.BizType"
                                    Visible="False"
                                    IsSmart="True" />
                                                <dxg:GridColumn FieldName="contactPerson.FName"
                                    x:Name="colFname"
                                    IsSmart="True"
                                    Visible="True"
                                    Header="First Name"
                                    Width="auto" />
                                                <dxg:GridColumn FieldName="contactPerson.LName"
                                    x:Name="colLname"
                                    IsSmart="True"
                                    Visible="True"
                                    Header="Last Name"
                                    Width="auto" />
                                                <dxg:GridColumn FieldName="contact.ContactNo"
                                    IsSmart="True"
                                    x:Name="colcontactno"
                                    Visible="True"
                                    Header="Phone"
                                    Width="auto" />
                                                <dxg:GridColumn FieldName="company.currency.CurrencyName"
                                    x:Name="colCurrency"
                                    IsSmart="True"
                                    Visible="False"
                                    Header="Currency" />
                                                <dxg:GridColumn FieldName="contact.Fax"
                                    Visible="False"
                                    x:Name="colFax"
                                    IsSmart="True"
                                    Header="Fax" />
                                                <dxg:GridColumn FieldName="contact.Email"
                                    x:Name="colEmail"
                                    IsSmart="True"
                                    Visible="False"
                                    Header="Email" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEditSettings.PopupContentTemplate>
                            </dxg:LookUpEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>


                    <dxg:GridColumn FieldName="Title"
                                    VisibleIndex="2"
                            IsSmart="True" 
                          Header="Account Heads" 
                                    ReadOnly="True" 
                                    x:Name="colBudgetedCostTitle"/>


                    <dxg:GridColumn FieldName="budgetedValue"
                          Header="Budgeted Cost"
                            VisibleIndex="3"
                            IsEnabled="True"
                      
                            IsSmart="True" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="budgetedValuePerc"
                          Header="BM %"
                                    HorizontalHeaderContentAlignment="Center"
                                    ReadOnly="True"
                            VisibleIndex="4"
                             UnboundType="decimal">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ProgressBarEditSettings ContentDisplayMode="Value"/>
                        </dxg:GridColumn.EditSettings>

                    </dxg:GridColumn> 
                    <dxg:GridColumn FieldName="actualValuePerc"
                          Header="AV %"
                                    HorizontalHeaderContentAlignment="Center"
                                    ReadOnly="True"
                            VisibleIndex="4"
                             UnboundType="decimal">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ProgressBarEditSettings ContentDisplayMode="Value"/>
                        </dxg:GridColumn.EditSettings>

                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="revisedValue"
                          Header="Revised Cost"
                                VisibleIndex="5"
                                            Visible="False"
                                            ShowInColumnChooser="False"
                                IsSmart="True" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="revisedValuePerc"
                          Header="RM %"
                                            Visible="False"
                                            ShowInColumnChooser="False"
                                    HorizontalHeaderContentAlignment="Center"
                                    ReadOnly="True"
                            VisibleIndex="6"
                            UnboundType="decimal">

                        <dxg:GridColumn.EditSettings>
                            <dxe:ProgressBarEditSettings ContentDisplayMode="Value"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="actualValue"
                          Header="Actual Cost"
                                VisibleIndex="9"
                                IsSmart="True" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn 
                        FieldName="SRBC"
                          Header="R.S.B.C "
                                    VisibleIndex="7"
                                 ReadOnly="True"
                                    
                                    IsEnabled="False"    
                                IsSmart="True" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="SRBCValuePerc"
                          Header="RSBC %"
                                    HorizontalHeaderContentAlignment="Center"
                                    ReadOnly="True"
                            VisibleIndex="8"
                              UnboundType="decimal">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ProgressBarEditSettings ContentDisplayMode="Value"/>
                        </dxg:GridColumn.EditSettings>

                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="systemValue"
                          Header="System Cost"
                                 ReadOnly="True"
                                    VisibleIndex="10"
                                    UnboundType="decimal"
                                    IsEnabled="False"    
                                IsSmart="True"  >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="adjSCost"
                          Header="Adj. S. Cost"
                               UnboundType="decimal"
                                     VisibleIndex="11"
                                        
                                IsSmart="True" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="systemValuePerc"
                          Header="SC %"
                                    HorizontalHeaderContentAlignment="Center"
                                    ReadOnly="True"
                            VisibleIndex="12"
                              UnboundType="decimal">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ProgressBarEditSettings ContentDisplayMode="Value"/>
                        </dxg:GridColumn.EditSettings>

                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="colactualValuePrint"
                          Header="Actual Cost" ShowInColumnChooser="False" Visible="False">
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="oc"
                            FieldName="OC"
                          Header="OC"
                          IsSmart="True"
                          VisibleIndex="13" 
                                    
                          UnboundType="bound"
                          UnboundExpression="[CurrencyName]">
                        <dxg:GridColumn.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RowData.Row.OC.CurrencyName}"></TextBlock>
                            </ControlTemplate>
                        </dxg:GridColumn.DisplayTemplate>
                        <dxg:GridColumn.EditSettings>
                            <dxg:LookUpEditSettings x:Name="lookupOC"
                                      AutoPopulateColumns="False"
                                                       
                                      IsPopupAutoWidth="False"           
                                      DisplayMember="CurrencyName"
                                      NullText="Select Item">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                            </Grid.RowDefinitions>

                                            <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                <dxg:GridControl.View>
                                                    <dxg:TableView x:Name="grdOC"
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            Width="auto"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            ShowTotalSummary="True" 
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" />
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn x:Name="colId"
                                    FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                                <dxg:GridColumn FieldName="CurrencyName"
                                    IsSmart="True"
                                    Width="auto" />

                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEditSettings.PopupContentTemplate>
                            </dxg:LookUpEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="exchangeRate"
                          Header="Exchange Rate"
                            VisibleIndex="14"
                            IsSmart="True" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="OCamount"
                          Header="OC Amount"
                            VisibleIndex="15"
                            IsSmart="True" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>


                    <dxg:GridColumn FieldName="Maker"
                                    VisibleIndex="16"
                            IsSmart="True" 
                          Header="Maker"  x:Name="maker"/>
                    <dxg:GridColumn FieldName="Origin"
                                    VisibleIndex="17"
                            IsSmart="True" 
                          Header="Origin"  x:Name="Origin"/>
                    <dxg:GridColumn FieldName="Packing"
                                    VisibleIndex="18"
                            IsSmart="True"
                          Header="Packing"  x:Name="pakcing"/>
                    <dxg:GridColumn FieldName="deliveryDate"
                                    VisibleIndex="19"
                            IsSmart="True"
                          Header="Delivery Date"  >
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="deliveryDays"
                                    VisibleIndex="20"
                            IsSmart="True"
                          Header="Delivery Days"  >
                        <dxg:GridColumn.EditSettings>
                            <dxe:SpinEditSettings/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="paymentTerm"
                            FieldName="PaymentTerm"
                          Header="Payment Terms"
                          IsSmart="True"
                          VisibleIndex="21" 
                                    
                          UnboundType="bound"
                          UnboundExpression="[term]">
                        <dxg:GridColumn.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RowData.Row.PaymentTerm.term}"></TextBlock>
                            </ControlTemplate>
                        </dxg:GridColumn.DisplayTemplate>
                        <dxg:GridColumn.EditSettings>
                            <dxg:LookUpEditSettings x:Name="lookupPaymentTerms"
                                      AutoPopulateColumns="False"
                                                       
                                      IsPopupAutoWidth="False"           
                                      DisplayMember="term"
                                      NullText="Select Item">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                            </Grid.RowDefinitions>

                                            <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                <dxg:GridControl.View>
                                                    <dxg:TableView x:Name="grdPaymentTerms"
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            Width="auto"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
