                <dxe:TextEdit Grid.Row="1" x:Name="txtTotalSystemMarginPerc" Text="0"  Margin="5"   Grid.Column="3" VerticalAlignment="Top" IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold" MaskType="Numeric" Mask="P2"  ></dxe:TextEdit>
               
                
                
                <TextBlock Grid.Row="2" Text="Total Actual Margin = " FontWeight="DemiBold" HorizontalAlignment="Center" Grid.Column="0" VerticalAlignment="Center"/>
                <dxe:TextEdit Grid.Row="2" x:Name="txtTotalActualMargin" MaskType="Numeric"   Text="0"    Mask="n2" Margin="5"  Grid.Column="1" VerticalAlignment="Top" IsReadOnly="True"  MaskUseAsDisplayFormat="True"  EditValueChanged="txtTotalActualMargin_EditValueChanged" FontWeight="DemiBold"  ></dxe:TextEdit>
                <dxe:TextEdit Grid.Row="1" x:Name="txtTotalChildActualMargin" Visibility="Collapsed"  Margin="5"   Grid.Column="1" VerticalAlignment="Top" IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold"  ></dxe:TextEdit>



                <TextBlock Grid.Row="2" Text="Total Actual Margin % " FontWeight="DemiBold" HorizontalAlignment="Center" Grid.Column="2" VerticalAlignment="Center"/>
                <dxe:TextEdit Grid.Row="2" x:Name="txtTotalActualMarginPerc" Text="0"  Margin="5"   Grid.Column="3" VerticalAlignment="Top" IsReadOnly="True"  MaskUseAsDisplayFormat="True"   FontWeight="DemiBold" MaskType="Numeric" Mask="P2"  ></dxe:TextEdit>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
