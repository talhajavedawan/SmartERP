<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        x:Class="ZAS_ERP.Procurementss.frmTestGrid"
        mc:Ignorable="d"
        Title="frmTestGrid"
        Height="650"
        Width="800">
  <Window.Resources>
    <dx:UnboundDataSource x:Key="UnboundDataSource"
                          Count="0">
      <dx:DesignDataManager.DesignData>
        <dx:DesignDataSettings RowCount="5" />
      </dx:DesignDataManager.DesignData>
    </dx:UnboundDataSource>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <dxg:GridControl x:Name="griditem"
                     Grid.Row="0" 
                     SelectionMode="Cell">
      <dxg:GridControl.View>
        <dxg:TableView AutoWidth="True"
                       ShowGroupPanel="False"
                       NewItemRowPosition="Bottom"
                       AllowColumnFiltering="False"
                       AlternateRowBackground="LightGray"
                       ShowHorizontalLines="True"
                       ShowVerticalLines="True"
                       x:Name="view">
          <dxg:TableView.RowCellMenuCustomizations>
            <!--<dxb:BarButtonItem Name="deleteRowItem"
                               Content="Delete"
                               Glyph="{dx:DXImage Image=Cancel_32x32.png}"
                               ItemClick="deleteRowItem_ItemClick" />-->
          
            <dxb:BarButtonItem Name="deleteRowItema"
                               Content="Delete"
                               Glyph="{dx:DXImage Image=Delete_32x32.png}"
                               
                               Command="{x:Static dxg:GridCommands.DeleteFocusedRow}" />
          </dxg:TableView.RowCellMenuCustomizations>
        </dxg:TableView>
      </dxg:GridControl.View>
      <dxg:GridColumn FieldName="inquiryProduct.product"
                      Header="Item"
                      IsSmart="True"
                      >
        <dxg:GridColumn.EditSettings>
          <dxg:LookUpEditSettings x:Name="lookupProductsinGrid"
                                  AutoPopulateColumns="False"
                                  IsPopupAutoWidth="False"
                                  DisplayMember="code">
            <dxg:LookUpEditSettings.PopupContentTemplate>
              <ControlTemplate >
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*" MaxHeight="300"></RowDefinition>
                  </Grid.RowDefinitions>
                  <Button x:Name="btnAddItem"
                          Click="btnAddItem_Click"
                          VerticalAlignment="Center"
                          Content="--Add New--"  />
                <dxg:GridControl x:Name="PART_GridControl"
                                 ShowBorder="True"
                                   MaxHeight="300"
                                  Grid.Row="1" SelectionChanged="PART_GridControl_SelectionChanged">
                  <dxg:GridColumn FieldName="code" />
                  <dxg:GridColumn FieldName="item" />
                  <dxg:GridColumn FieldName="itemDescription" />
                  <dxg:GridColumn FieldName="unitOfMeasure.unitOfMeasure"
                                  Header="Unit Of Measure" />
                  <dxg:GridColumn FieldName="nature.nature"
                                  Header="Nature" />
                  <dxg:GridColumn FieldName="category.category"
                                  Header="Category" />
                </dxg:GridControl>
                  </Grid>
              </ControlTemplate>
            </dxg:LookUpEditSettings.PopupContentTemplate>
          </dxg:LookUpEditSettings>
        </dxg:GridColumn.EditSettings>
      </dxg:GridColumn>
      <dxg:GridColumn FieldName="inquiryProduct.product.itemDescription"
                      Header="Item Discription" />
      <dxg:GridColumn FieldName="inquiryProduct.ownDiscription" />
      <dxg:GridColumn FieldName="inquiryProduct.product.unitOfMeasure.unitOfMeasure"
                      Header="Unit Of Measure" />
      <dxg:GridColumn FieldName="inquiryProduct.quantity"
                      Header=" Quantity">
        <dxg:GridColumn.EditSettings>
          <dxe:SpinEditSettings MaxValue="99999"
                                MinValue="1" />
        </dxg:GridColumn.EditSettings>
        
      </dxg:GridColumn>
      <dxg:GridColumn FieldName="value1"
                      Header="FOB Value"></dxg:GridColumn>
      <dxg:GridColumn FieldName="value2"
                      Header="CFR Value"></dxg:GridColumn>
    </dxg:GridControl>
    <dxg:GridControl 
       x:Name="grdInquiryItems"
                     
                     Grid.Row="1"
                     
                     >
      <dxg:GridControl.View>
        <dxg:TableView AutoWidth="True"
                       ShowGroupPanel="False"
                       NewItemRowPosition="Bottom"
                       AllowColumnFiltering="False"
                       AlternateRowBackground="Silver">
          <dxg:TableView.RowCellMenuCustomizations>
            <dxb:BarButtonItem Name="deleteRowItems"
                               Content="Delete"
                               Glyph="{dx:DXImage Image=
                               Delete_32x32.png}"
                               Command="{x:Static dxg:GridCommands.DeleteFocusedRow}" />
          </dxg:TableView.RowCellMenuCustomizations>
        </dxg:TableView>
      </dxg:GridControl.View>
      <dxg:GridColumn FieldName="product"
                      Header="Item"
                      IsSmart="True"
                      UnboundType="Object" >
        <dxg:GridColumn.EditSettings>
          <dxg:LookUpEditSettings x:Name="lookupProductinGrid"
                                  AutoPopulateColumns="False"
                                  IsPopupAutoWidth="False"
 
                                                  DisplayMember="code">
            <dxg:LookUpEditSettings.PopupContentTemplate>
              <ControlTemplate TargetType="{x:Type ContentControl}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"
                                   MaxHeight="300"></RowDefinition>
                  </Grid.RowDefinitions>
                  <Button x:Name="btnAddItem"
                          Click="btnAddItem_Click"
                          VerticalAlignment="Center"
                          Content="--Add New--" />
                  <dxg:GridControl 
                    x:Name="PART_GridControl"
                                   Grid.Row="1"
                                   ShowBorder="True"
                                   MaxHeight="300"  SelectionChanged="PART_GridControl_SelectionChanged">
                    <dxg:GridColumn FieldName="code" />
                    <dxg:GridColumn FieldName="item" />
                    <dxg:GridColumn FieldName="itemDescription" />
                    <dxg:GridColumn FieldName="unitOfMeasure.unitOfMeasure"
                                    Header="Unit Of Measure" />
                    <dxg:GridColumn FieldName="nature.nature"
                                    Header="Nature" />
                    <dxg:GridColumn FieldName="category.category"
                                    Header="Category" />
                  </dxg:GridControl>
                </Grid>
              </ControlTemplate>
            </dxg:LookUpEditSettings.PopupContentTemplate>
          </dxg:LookUpEditSettings>
        </dxg:GridColumn.EditSettings>
      </dxg:GridColumn>
      <dxg:GridColumn FieldName="product.itemDescription" Header="Item Discription" />
      <dxg:GridColumn FieldName="ownDiscription" />
      <dxg:GridColumn FieldName="product.unitOfMeasure.unitOfMeasure" Header="Unit Of Measure"/>
      <dxg:GridColumn FieldName="quantity" Header=" Quantity">
        <dxg:GridColumn.EditSettings>
          <dxe:SpinEditSettings MaxValue="99999"
                                MinValue="1" />
        </dxg:GridColumn.EditSettings>
      </dxg:GridColumn>
    </dxg:GridControl>
    <Button x:Name="btnSave"
            Grid.Row="9"
            Grid.ColumnSpan="7"
            Content="Save"
            Click="btnSave_Click"
            TabIndex="14" />
  </Grid>
</Window>
