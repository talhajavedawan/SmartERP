<UserControl x:Class="ZAS_ERP.Procurementss.SaleInvoicess.UserControls.ucfrmAddSubject"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SaleInvoicess.UserControls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="LightSkyBlue" BorderThickness="1" CornerRadius="5">
            <TextBox  Grid.Row="0" x:Name="txtSubject" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" BorderThickness="0"  FontSize="14" FontWeight="Bold" TextDecorations="Underline" LostFocus="TxtComments_LostFocus"/>
        </Border>

        <Button x:Name="btnSave" Content="Save" Grid.Row="2"/>
    </Grid>
</UserControl>
