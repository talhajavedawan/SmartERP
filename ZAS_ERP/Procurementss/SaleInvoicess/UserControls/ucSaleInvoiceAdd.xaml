<UserControl x:Class="ZAS_ERP.Procurementss.SaleInvoicess.ucSaleInvoiceAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SaleInvoicess"
             xmlns:vali="clr-namespace:ZAS_ERP.Validations"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:loc="clr-namespace:ZAS_ERP"
             xmlns:local1="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesigner/internal" 
             xmlns:dxnav="http://schemas.devexpress.com/winfx/2008/xaml/navigation"
             mc:Ignorable="d"
                  d:DesignHeight="925"
             d:DesignWidth="1500"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             x:Name="winSaleInvoiceadd"
             Loaded="winSaleInvoiceadd_Loaded"
             Unloaded="winSaleInvoiceadd_Unloaded" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.CommandBindings>
        <CommandBinding Command="loc:CustomCommands.ReplytoComment" CanExecute="Command_CanExecute" Executed="Command_Executed" />
        <CommandBinding Command="loc:CustomCommands.ChangeFlag" CanExecute="Resend_CanExecute" Executed="Resend_Executed" />
    </UserControl.CommandBindings>
    <UserControl.Resources>
        <!--comment-->
        <!--<ControlTemplate x:Key="{dxet:ImageEditThemeKey ResourceKey=BorderTemplate,IsThemeIndependent=true}" TargetType="{x:Type ContentControl}">
            <Grid x:Name="RootElement">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="InternalFocusStates">
                        <VisualState x:Name="InternalFocused">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FocusElement" Storyboard.TargetProperty="Opacity" Duration="0" To="1" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="InternalUnfocused" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Background="Transparent" BorderBrush="#FF515151" BorderThickness="1" >
                    <ContentPresenter />
                </Border>
                <Border x:Name="FocusElement" BorderBrush="#FFF78A09" BorderThickness="1" Opacity="0" />
            </Grid>
        </ControlTemplate>-->
        <BooleanToVisibilityConverter x:Key="b2v"/>
        <DataTemplate x:Key="borderTemplate">
            <Border x:Name="border"
                    Width="44" 
                        Background="White" 
                        BorderThickness="2" 
                    
                        BorderBrush="#FF333333" 
                        CornerRadius="10"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Background" TargetName="border" Value="Green"/>
                    <Setter Property="BorderThickness" TargetName="border" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="false">
                    <Setter Property="Background" TargetName="border" Value="#6DFF0000"/>
                    <Setter Property="BorderThickness" TargetName="border" Value="0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="thumbTemplate">
            <Ellipse x:Name="thumb"
                         Fill="#FF333333" 
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         Width="10" Height="10" Margin="8,0"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Fill" TargetName="thumb" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment"
                Value="Center" />
                <Setter Property="HorizontalAlignment"
                Value="Left" />

                <Setter Property="Margin"
                Value="10,1" />
            </Style>
        </Grid.Resources>

        <StackPanel Grid.Row="0" Panel.ZIndex="5" VerticalAlignment="Top" dx:ThemeManager.ThemeName="None" HorizontalAlignment="Left"
                 Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">
                <Image  Source="/ZAS_ERP;component/images/log.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1" Click="BtnMarkReviewed_Click"  ToolTip="Approve - Mark as Reviewed">
                <Image  Source="/ZAS_ERP;component/images/approve.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnReject" Grid.Column="2" Click="BtnReject_Click"  ToolTip="Reject">
                <Image  Source="/ZAS_ERP;component/images/reject.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnClose" Grid.Column="2" Click="BtnClose_Click"  ToolTip="Direct Close">
                <Image  Source="/ZAS_ERP;component/images/block-icon.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" Click="BtnAddComment_Click"  ToolTip="Add New Comment">
                <Image  Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2" Click="BtnCommentLog_Click"  ToolTip="CommentLog">
                <Image  Source="/ZAS_ERP;component/images/comments.png" ></Image>
            </Button>
            <Button x:Name="btnAttachNew" Visibility="Collapsed" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Info" Click="BtnAttachNew_Click">
                <Image x:Name="imgAttachNew" Source="/ZAS_ERP;component/images/clipattachment.png"></Image>
            </Button>
            <Button x:Name="btnAttachmentList" Visibility="Collapsed" Width="30" Height="30" Grid.Column="3" ToolTip="Info" Click="BtnAttachmentList_Click">
                <Image Source="/ZAS_ERP;component/images/ListAttachment.png"></Image>
            </Button>
            <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnTrackingWindow" Grid.Column="2" Click="BtnTrackingWindow_Click"  ToolTip="360 View">
                <Image  Source="/ZAS_ERP;component/images/360Arrow.png" ></Image>
            </Button>
            <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnSetVoid" Visibility="Collapsed" Grid.Column="2" Click="BtnSetVoid_Click"  ToolTip="360 View">
                <Image  Source="/ZAS_ERP;component/images/void_order.png" ></Image>
            </Button>

            <Button x:Name="btnAttachNew1" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Attach document" Click="BtnAttachNew1_Click">
                <Image x:Name="imgAttachNew1"  Source="{dx:DXImage Image=Attachment_32x32.png}"></Image>
            </Button>
            <Button x:Name="btnAttachmentList1"  Width="30" Height="30" Grid.Column="3" ToolTip="List of Attachments" Click="BtnAttachmentList1_Click">
                <Image  Source="{dx:DXImage Image=ListNumbers_32x32.png}"></Image>
            </Button>

            <!--<Button x:Name="btnInfo" Height="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">
                <Image Source="/ZAS_ERP;component/images/log.png"></Image>
            </Button>
            <Button Height="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1" Click="BtnMarkReviewed_Click"  ToolTip="Approve-Mark as Reviewed">
                <Image Source="/ZAS_ERP;component/images/approve.png"></Image>
            </Button>
            <Button Height="30" Margin="5,0,0,0" x:Name="btnReject" Grid.Column="2" Click="BtnReject_Click"  ToolTip="Reject">
                <Image Source="/ZAS_ERP;component/images/reject.png"></Image>
            </Button>
            <Button Height="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" Click="BtnAddComment_Click"  ToolTip="Add New Comment">
                <Image Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
            </Button>
            <Button Height="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2" Click="BtnCommentLog_Click"  ToolTip="CommentLog">
                <Image Source="/ZAS_ERP;component/images/comments.png" ></Image>
            </Button>-->
            <Button x:Name="btnStageTracking" Margin="2"  Width="30" Height="30"  Grid.Column="3" ToolTip="Orders Stage Tracking" Click="btnStageTracking_Click" Visibility="Visible">
                <Image   Source="{dx:DXImage Image=PackageProduct_32x32.png}"></Image>
            </Button> 
            <Button x:Name="btnCustomerCredit" Margin="2" Width="30" Height="30"  Grid.Column="3" ToolTip="Attach Customer Credits" Click="btnCustomerCredit_Click"  >
                <Image   Source="{dx:DXImage Image=Cards_32x32.png}"></Image>
            </Button>
        </StackPanel>
        <Grid x:Name="gridOrderStageTrack"     Visibility="Collapsed"   Grid.RowSpan="2"  Panel.ZIndex="5" VerticalAlignment="Top"  Margin="80,32,65,35" HorizontalAlignment="Left">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <dxnav:TileNavPane  VerticalAlignment="Center">
                    <dxnav:TileNavPane.NavButtons>
                        <dxnav:NavButton x:Name="btnOrderStageByTrack"    FontWeight="Bold" Content="   Orders Tracking" ToolTip="Orders Tracking" Cursor="Hand" GlyphAlignment="Left"  AllowGlyphTheming="True" HorizontalAlignment="Stretch" />
                        <dxnav:NavButton x:Name="btnRefresh" Content="Refresh" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top"  Glyph="{dx:DXImageGrayscale Image=Refresh_32x32.png}" Click="btnRefresh_Click"/>
                        <dxnav:NavButton x:Name="btnExpand" Content="Expand" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top" Glyph="{dx:DXImage Image=CollapseFieldPivotTable_32x32.png}"  Click="btnExpand_Click_1"/>
                        <dxnav:NavButton x:Name="btnCollapsed" Content="Collapse" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top" Glyph="{dx:DXImage Image=ExpandFieldPivotTable_32x32.png}"   Click="btnCollapsed_Click"/>
                    </dxnav:TileNavPane.NavButtons>
                </dxnav:TileNavPane>
                <dxg:GridControl x:Name="grdOrdersTracking" Grid.Row="1"    MaxHeight="1500" AutoGenerateColumns="None"  SelectionMode="Row" AutoExpandAllGroups="True" IsRecursiveExpand="True" AllowInitiallyFocusedRow="False" >
                    <dxg:GridControl.View>
                        <dxg:TreeListView       x:Name="grdTrackingTree"  
                                KeyFieldName="Id"
                                                       MouseDoubleClick="TreeListView_MouseDoubleClick"
                            ParentFieldName="ParentId"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            AutoExpandAllNodes="False"      
                            Width="auto"
                            AutoWidth="True"      
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoPopulateServiceColumns="False"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True"      
                            ShowTotalSummary="True"    
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True">
                            <dxg:TreeListView.FormatConditions>
                                <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Closed">
                                    <dx:Format Background="#FFFF0000"/>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Approved">
                                    <dx:Format Background="#FF9BBB59"/>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Under Closing">
                                    <dx:Format Background="#FFF79646"/>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition FieldName="Stage" ValueRule="Equal" Value1="Under Approval" ApplyToRow="false">
                                    <dx:Format Background="#8E4CACC7"/>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition FieldName="Stage" ValueRule="Equal" Value1="Void" ApplyToRow="false">
                                    <dx:Format Background="#FFBFBFBF"/>
                                </dxg:FormatCondition>
                            </dxg:TreeListView.FormatConditions>
                        </dxg:TreeListView>
                    </dxg:GridControl.View>
                    <dxg:GridColumn FieldName="Id" Visible="False"/>
                    <dxg:GridColumn FieldName="GroupId" Header="Group Id"  Visible="False" />
                    <dxg:GridColumn FieldName="Stage" VisibleIndex="7" Header="Stage"  Image="{dx:DXImage Image=Action_Show_PivotGrid_Designer.png}"/>
                    <dxg:GridColumn 
                                    VisibleIndex="6"
                                          FieldName="_Status"
                                          Header="Status"
                                          UnboundType="Bound"
                                          Image="{dx:DXImage Image=Status_16x16.png}"
                                          Visible ="True"
                                          AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.BackColor}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.Status}"/>
                  </InlineUIContainer></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn 
                                    VisibleIndex="6"
                                          FieldName="_StatusClass"
                                          Header="Status Class"
                                          UnboundType="Bound"
                                          Image="{dx:DXImage Image=Status_16x16.png}"
                                          Visible ="True"
                                          AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.BackColorStatusClass}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.StatusClass}"/>
                  </InlineUIContainer></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="Company" VisibleIndex="1" Header="Company" Image="{dx:DXImage Image=Home_16x16.png}"/>
                    <dxg:GridColumn FieldName="Department" VisibleIndex="2" Header="Department" Image="{dx:DXImage Image=BO_Department.png}"/>
                    <dxg:GridColumn FieldName="Vendor" VisibleIndex="3" Header="Vendor" Image="{dx:DXImage Image=BO_Department.png}"/>
                    <dxg:GridColumn FieldName="Currency" VisibleIndex="4" Header="Currency"  Image="{dx:DXImage Image=Currency2_16x16.png}"/>
                    <dxg:GridColumn FieldName="AmountOC" VisibleIndex="5" Header="Amount(OC)"  Image="{dx:DXImage Image=Currency2_16x16.png}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="transactionType" VisibleIndex="0" Header="Transaction Type"  Image="{dx:DXImage Image=Currency2_16x16.png}">
                    </dxg:GridColumn>
                </dxg:GridControl>
            </Grid>
        </Grid>

        <!--comment-->
        <Grid x:Name="gridCustomerCredits"    Visibility="Collapsed"   Grid.RowSpan="2" Margin="430,30,55,55"  Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Left"  >
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <dxnav:TileNavPane  VerticalAlignment="Center">
                    <dxnav:TileNavPane.NavButtons>
                        <dxnav:NavButton x:Name="btnOrderCustomerCredits"    FontWeight="Bold" Content="   Customer Credits" ToolTip="Customer Credits" Cursor="Hand" GlyphAlignment="Left"  AllowGlyphTheming="True" HorizontalAlignment="Stretch" />
                       
                    </dxnav:TileNavPane.NavButtons>
                </dxnav:TileNavPane>
                <dxg:GridControl x:Name="grdCustomerCredits"                        
                                 Grid.Row="1" 
                                 Grid.RowSpan="9"
                                 MaxHeight="90000" 
                                 AutoGenerateColumns="None"
                                 SelectionMode="Row"
                                  dx:DXSerializer.SerializationID="grid"
                                 DataContext="customerCredits"
                                 AutoExpandAllGroups="True"
                                 IsRecursiveExpand="True"
                                 AllowInitiallyFocusedRow="False" 
                                 CustomUnboundColumnData="grdCustomerCredits_CustomUnboundColumnData">
                    <dxg:GridControl.View>
                        <dxg:TableView       
                            x:Name="grdCustomerCreditsView"  
                            ShowGroupPanel="False"
                           NewItemRowPosition="Bottom"
                           AllowColumnFiltering="False"
                           ShowTotalSummary="True"
                           ShowHorizontalLines="True"
                            ShowFixedTotalSummary="True"
InitNewRow="grdCustomerCreditsView_InitNewRow"
                           ShowVerticalLines="True">
                        </dxg:TableView>
                        
                    </dxg:GridControl.View>

                    <dxg:GridControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Create Sale Receipt" Name="btnCreateSaleReceipt" Click="btnCreateSaleReceipt_Click"/>
                        </ContextMenu>
                    </dxg:GridControl.ContextMenu>
                    <dxg:GridColumn x:Name="customerCompany"
                            FieldName="CustomerCompany"
                          Header="Customer"
                          IsSmart="True"
                          VisibleIndex="1" 
                          UnboundType="bound"
                          UnboundExpression="[CompanyName]">
                        <dxg:GridColumn.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RowData.Row.CustomerCompany.company.CompanyName}"></TextBlock>
                            </ControlTemplate>
                        </dxg:GridColumn.DisplayTemplate>
                        <dxg:GridColumn.EditSettings>
                            <dxg:LookUpEditSettings x:Name="lookupCustomerinGrid"
                                      AutoPopulateColumns="False"
                                                       
                                      IsPopupAutoWidth="False"           
                                      DisplayMember="company.CompanyName"
                                      NullText="Select Item">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"
                                       MaxHeight="300"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <dxg:GridControl x:Name="PART_GridControl"
                                       ShowBorder="True"
                                       MaxHeight="300"
                                       Grid.Row="1">
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView x:Name="grdCustomerTree"
                            KeyFieldName="Id"
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            ParentFieldName="parentId"
                            AllowEditing="False"
                            NavigationStyle="Row"
                            Width="auto"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoExpandAllNodes="False"
                            AutoPopulateServiceColumns="True"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            ShowTotalSummary="True" 
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FilterMode="Extended"
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True" />
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn FieldName="company.CompanyName" Header="Company" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEditSettings.PopupContentTemplate>
                            </dxg:LookUpEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn x:Name="creditAmount"
                            FieldName="creditAmount"
                          Header="Credit Amount" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn x:Name="collectedCustomerCredit"
                            FieldName="collectedCustomerCredit"
                            ReadOnly="True"
                                    Width="auto"
                          Header="Collected Amount" 
                                    UnboundType="decimal">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn x:Name="balanceCustomerCredit"
                            FieldName="balanceCustomerCredit"
                                    Width="auto"
                                    ReadOnly="True"
                          Header="Balance Amount" 
                                    UnboundType="decimal">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn x:Name="serialNo"
                            FieldName="SerialNo"
                                    Width="auto"
                                    ReadOnly="True"
                          Header="Serial No" />

                    <dxg:GridControl.TotalSummary >
                        <dxg:GridSummaryItem FieldName="creditAmount" SummaryType="Sum" DisplayFormat="{}{0:n2}" />
                        <dxg:GridSummaryItem FieldName="collectedCustomerCredit" SummaryType="Sum" DisplayFormat="{}{0:n2}" />
                        <dxg:GridSummaryItem FieldName="balanceCustomerCredit" SummaryType="Sum" DisplayFormat="{}{0:n2}" />

                    </dxg:GridControl.TotalSummary>
                </dxg:GridControl>
            </Grid>
        </Grid>




        <Grid Panel.ZIndex="5" Visibility="Collapsed" x:Name="gridTracker" Width="500" Margin="35"  HorizontalAlignment="Left" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="btnCollapse" Click="BtnCollapse_Click" Content="Collapse"></Button>
                <TextBlock Text="Activity Tracker" FontWeight="Bold" FontSize="26" Foreground="Black" Margin="30,5"></TextBlock>
                <Button x:Name="btnexpand" Click="Btnexpand_Click" Content="Expand"></Button>

            </StackPanel>
            <dxg:GridControl x:Name="grdUsers" Visibility="Visible"
                     Grid.Row="1" MaxHeight="520"
                     Grid.RowSpan="5" HorizontalAlignment="Left"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             ItemsSource="procurementProducts"
                     SelectionMode="Row" 
                             dx:DXSerializer.SerializationID="grid"
                             
                      CustomUnboundColumnData="GrdUsers_CustomUnboundColumnData"   
                    AutoGenerateColumns="None">
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       
                                   AutoWidth="True"
                       Width="auto"
                       AllowGrouping="False"
                                   ShowGroupPanel="False"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                       
                       >

                    </dxg:TableView>
                </dxg:GridControl.View>
                <dxg:GridColumn Header="User Name"
                            FieldName="User.userName"
                            IsSmart="True"
                            Width="auto" />
                <dxg:GridColumn FieldName="Timestamp" UnboundType="String" ReadOnly="True" Width="auto">
                </dxg:GridColumn>
                <dxg:GridColumn Header="Info"
                            FieldName="Info"
                            IsSmart="True"
                            Width="auto" />
                <dxg:GridColumn 
                            FieldName="Comment"
                            IsSmart="True"
                            Width="auto" />
