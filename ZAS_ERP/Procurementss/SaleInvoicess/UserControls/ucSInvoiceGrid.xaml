            <dxg:GridControl.View>
                <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       ShowAutoFilterRow="True"
                       Width="auto"
                       RowAnimationKind="None" WaitIndicatorType="Panel"
                       AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                      
                       ShowFixedTotalSummary="True"
                       ShowTotalSummary="True">

                    <dxg:TableView.FormatConditions>
                        <!--<dxg:FormatCondition ApplyToRow="true" Expression="[daysLeft] &lt; '1'" FieldName="RowData.Row.company.CompanyName">
                            <dx:Format Background="#FFFF0000" Foreground="#FFFFFFFF"/>
                        </dxg:FormatCondition>-->
                        <!--<dxg:FormatCondition ApplyToRow="true" Expression="[isApproved] = False">
                            <dx:Format FontWeight="Bold" Foreground="#FF0072C6"/>
                        </dxg:FormatCondition>-->
                        <dxg:FormatCondition   ApplyToRow="true"  Expression="[isSTLGenerated] = 'True'" FieldName="RowData.Row.company.CompanyName">
                            <dx:Format Background="#FF8B0000" FontWeight="SemiBold" Foreground="#FFFFFFFF" />
                        </dxg:FormatCondition>
                        <dxg:FormatCondition   ApplyToRow="true"  Expression="[isRedInvoice] = 'True'" FieldName="RowData.Row.company.CompanyName">
                            <dx:Format Background="Orange" FontWeight="SemiBold" Foreground="#FFFFFFFF" />
                        </dxg:FormatCondition>
                    </dxg:TableView.FormatConditions>

                </dxg:TableView>
            </dxg:GridControl.View>
