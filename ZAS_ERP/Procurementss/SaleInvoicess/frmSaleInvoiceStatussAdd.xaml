<dx:DXWindow xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"  
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Inquiriess"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        utilities:WindowUtilities.CloseOnEscape="True"
        WindowStartupLocation="CenterOwner"
        x:Class="ZAS_ERP.Procurementss.SaleInvoicess.frmSaleInvoiceStatussAdd"
             mc:Ignorable="d"
             Height="500"
             Width="350" Title="Sale Invoice Status" x:Name="winSaleInvoiceStatusAdd" 
        Loaded="winSaleInvoiceStatusAdd_Loaded" Closing="winSaleInvoiceStatusAdd_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>


        <dxlc:LayoutGroup >
            <Grid Margin="0,20,0,0" Grid.Row="0">
                <Grid.Resources>
                    <Style TargetType="{x:Type Label}">
                        <Setter Property="Margin"
                Value="10,0" />
                        <Setter Property="Foreground"
                Value="Gray" />
                        <Setter Property="VerticalAlignment"
                Value="Center" />
                    </Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="Margin"
                Value="10,0" />
                        <Setter Property="MaxWidth"
                Value="350" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=" auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height=" auto" />
                    <RowDefinition Height=" auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>



                <Label Content="Status"
           ToolTip="Status Name"
           HorizontalAlignment="Right" />
                <Label Content="Active"
           ToolTip="Select if it is of active type"
           HorizontalAlignment="Right"
           Grid.Row="1" />
                <Label Content="Disable"
           HorizontalAlignment="Right"
           Grid.Row="2" />
                <TextBox x:Name="txtStatus"
             Grid.Column="1" />
                <CheckBox x:Name="chkDisable"
                  Grid.Row="2"
                  Grid.Column="1"
                Margin="10,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                 />
                <Grid Grid.Column="1" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="chkisactive"
                Margin="10,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                IsChecked="True" />
                    <dxe:PopupColorEdit Margin="10"
                          HorizontalAlignment="Stretch"
                          ColorChanged="ColorEdit_ColorChanged"
                          Grid.Column="1"
                         
                          VerticalAlignment="Center"
                          x:Name="cpStatus" />
                </Grid>
                <Grid Grid.Row="3" Grid.ColumnSpan="2">

                    <dxg:GridControl SelectionMode="MultipleRow"
                               x:Name="grdStatusClasses"
                               AutoGenerateColumns="None"
                               AllowInitiallyFocusedRow="False">

                        <dxg:GridControl.View>
                            <dxg:TreeListView x:Name="viewTable"
                                    AutoWidth="True"
                                    KeyFieldName="Id"
                                    TreeDerivationMode="Selfreference"
                                    AutoExpandAllNodes="True"
                                    AllowEditing="False"
                                    ShowAutoFilterRow="True"
                                    FilterMode="Smart"
                                    UseIndicatorForSelection="True"
                                    ShowCheckboxes="True"
                                    FadeSelectionOnLostFocus="False"
                                    ShowSelectionRectangle="True"></dxg:TreeListView>
                        </dxg:GridControl.View>

                        <dxg:GridColumn AllowColumnFiltering="false" FieldName="ClassName"
                                IsSmart="True" />
                    </dxg:GridControl>
                </Grid>


            </Grid>
        </dxlc:LayoutGroup>
       
        
      
        <Button 
            Grid.Row="1"
            Content="Save"
            FontSize="26"
            x:Name="btnStatusSave"
            Click="btnStatusSave_Click" />
    </Grid>

</dx:DXWindow>
