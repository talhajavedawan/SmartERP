                                <TextBlock Grid.Column="1" Text="{Binding fcolor}" Margin="10,2" Foreground="Gray" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding description}" Margin="5,2" TextWrapping="WrapWithOverflow" HorizontalAlignment="Stretch"
