                        <Border BorderBrush="DarkBlue" BorderThickness="1" CornerRadius="5"    
   Background="{Binding bcolor}">
                            <Grid MaxWidth="620"  Margin="2,2"   HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions >
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding id}"
                                               Visibility="Hidden" />
