        <Grid x:Name="grdComments" Grid.Row="6" Grid.ColumnSpan="4" Visibility="Collapsed"   VerticalAlignment="Stretch" Margin="5" HorizontalAlignment="Stretch">

            <ListBox  Margin="5,1" Grid.ColumnSpan="2" x:Name="lstComments"  >

