<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Procurementss.SaleOrderss.winPerformanceSheetHeadAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SaleOrderss" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Height="275"
              WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
             Width="400" Title=" Performance Sheet Field" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=" auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height=" 50" />
            </Grid.RowDefinitions>
            <Label Content="Field Title"
           ToolTip="Cost Sheet Field"
           HorizontalAlignment="Right" />
            <TextBox x:Name="txtcostSheetField"
             Grid.Column="1"    Margin="10,0"
             VerticalAlignment="Center" />

            <Label Content="Hierarchical Index"
           ToolTip="Select Unique Hierarchical Index(Higher index# means higher priority level)"
           HorizontalAlignment="Right"
           Grid.Row="1" />
            <dxe:SpinEdit x:Name="spnHierarchicalIndex"
                Margin="10,0"
                MinValue="1"
                      
                      MaxValue="100"
                VerticalAlignment="Center"
                Grid.Column="1"
                Grid.Row="1" />
            <Label Content="isActive"
           ToolTip="Unselect to make it inActive"
           HorizontalAlignment="Right"
           Grid.Row="3" />
            <TextBlock Grid.Row="2" Text="Total Points" Grid.Column="0"  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
            <dxe:TextEdit x:Name="txtTotalPoints" NullText="0" Mask="n2" 
                VerticalAlignment="Center" MaskType="Numeric" Grid.Row="2" Grid.Column="1" Margin="5" />
            <CheckBox x:Name="chkisactive"
                Margin="10,0"
                IsChecked="True"
              VerticalAlignment="Center"
                Grid.Column="1"
                Grid.Row="3" />
        </Grid>
        <Button Grid.ColumnSpan="2"
            Grid.Row="6"
            Content="Save"
            FontSize="26"
            x:Name="btncostSheetFieldSave"
            Click="btncostSheetFieldSave_Click" />
    </Grid>
</dx:DXWindow>
