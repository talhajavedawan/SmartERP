                              IsSmart="True"
                              Width="auto" />
            </dxg:GridControl>
          </Grid>
        </ControlTemplate>
      </dxg:LookUpEdit.PopupContentTemplate>-->
    </ComboBox>
    <Button Grid.ColumnSpan="2"
            Grid.Row="5"
            Content="Save"
            FontSize="26"
            x:Name="btnsummarySheetFieldSave"
            Click="btnsummarySheetFieldSave_Click" />

  </Grid>
</Window>
