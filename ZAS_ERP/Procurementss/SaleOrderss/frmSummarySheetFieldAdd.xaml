<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        x:Class="ZAS_ERP.Procurementss.frmSummarySheetFieldAdd"
             mc:Ignorable="d"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        WindowStartupLocation="CenterOwner"
             Height="250"
             Width="400" Title=" Summary Sheet Field" x:Name="winSummarySheetFieldAdd" 
        Loaded="winSummarySheetFieldAdd_Loaded" Closing="winSummarySheetFieldAdd_Closing">
  <Grid Margin="0,20,0,0">
    <Grid.Resources>
      <Style TargetType="{x:Type Label}">
        <Setter Property="Margin"
                Value="10,10" />
        <Setter Property="Foreground"
                Value="Gray" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
      </Style>
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Margin"
                Value="10,0" />
        <Setter Property="MaxWidth"
                Value="350" />
      </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width=" auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <!--<RowDefinition Height=" auto" />-->
      <RowDefinition Height=" auto" />
      <!--<RowDefinition Height="*" />-->
      <RowDefinition Height="auto" />
      
      <RowDefinition Height="*" />
      
      <RowDefinition Height=" 50" />
    </Grid.RowDefinitions>
    <Label Content="Field Title"
           ToolTip="Summary Sheet Field"
           HorizontalAlignment="Right" />
    <TextBox x:Name="txtsummarySheetField"
             Grid.Column="1"
             VerticalAlignment="Center" />
   
    
    <Label Content="isActive"
           ToolTip="Unselect to make it inActive"
           HorizontalAlignment="Right"
           Grid.Row="2" />
    <CheckBox x:Name="chkisactive"
                Margin="10,0"
                IsChecked="True"
                Grid.Column="1"
                Grid.Row="2" />
    <Label Content="Field Type"
           HorizontalAlignment="Right"
           Grid.Row="1" />
    <ComboBox x:Name="cmbType"
                    Grid.Column="1"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Margin="10,5"
            
                    TabIndex="3">
            <ComboBoxItem Content="Dynamic" IsSelected="True"/>
            <ComboBoxItem Content="Static"/>

            <!--<dxg:LookUpEdit.PopupContentTemplate>
        <ControlTemplate>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="auto"></RowDefinition>
              <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            --><!--<Button x:Name="btnAddCategory"
                    Click="btnAddCategory_Click"
                    VerticalAlignment="Center"
                    Content="Add New"
                    Foreground="BlueViolet" />--><!--
            <dxg:GridControl Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
              <dxg:GridControl.View>
                <dxg:TreeListView Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
              </dxg:GridControl.View>
              <dxg:GridColumn x:Name="colId"
                              FieldName="Id"
                              Visible="False" />
