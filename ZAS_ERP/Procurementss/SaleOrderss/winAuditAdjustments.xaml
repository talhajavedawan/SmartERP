<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Procurementss.SaleOrderss.winAuditAdjustments"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SaleOrderss" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        d:DesignHeight="450" Title="Audit Adjustments" d:DesignWidth="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        

        <Menu>
            <MenuItem Header="Refresh" x:Name="btnRefresh" Click="BtnRefresh_Click"/>
            <MenuItem Header="Save Layout" x:Name="btnSaveLayout" Click="btnSaveLayout_Click"/>
            <MenuItem Header="_Print Preview"
                      x:Name="mbtnPrintPreview"
                      Click="MbtnPrintPreview_Click"></MenuItem>
            <MenuItem Header="Export to Report" x:Name="btnExporttoReport" Click="btnExporttoReport_Click" Visibility="Collapsed"/>
        </Menu>
        <TextBlock x:Name="lblHeading" Text="Audit Year Adjustment Register" FontSize="22" FontWeight="Bold"  HorizontalAlignment="Center" Grid.Row="1" FontFamily="Segoe UI Semibold"  ></TextBlock>
        <dxg:GridControl Grid.Row="2" x:Name="grdAuditAdjustmentgrid" MouseDoubleClick="grdAuditAdjustmentgrid_MouseDoubleClick"                           
                         SelectionMode="Row"        
                        >

            <dxg:GridControl.View>
                <dxg:TableView x:Name="tableView"
                             ShowGroupPanel="True" ShowIndicator="True" ShowVerticalLines="False"
                             SwitchToCompactModeWidth="700"
                             NavigationStyle="Row"
                             ShowAutoFilterRow="True"          
                             ShowFixedTotalSummary="True"
                             ShowSearchPanelMode="Always"          
                             SearchPanelNullText="Search"
                             ShowTotalSummary="True">
                    <dxg:TableView.CompactModeFilterItems>
                        <dxg:CompactModeFilterItem DisplayValue="All" />
                        <dxg:CompactModeFilterItem DisplayValue="Approved" EditValue="[isApproved] = True" />
                        <dxg:CompactModeFilterItem DisplayValue="Pending for Approvals" EditValue="[isApproved] = false" />
                        <dxg:CompactModeFilterItem DisplayValue="Pending for Closing" EditValue="[PendingForClosing] = true" />
                        <dxg:CompactModeFilterItem DisplayValue="Pending for ReApproval" EditValue="[PendingForReApproval] = true" />
                    </dxg:TableView.CompactModeFilterItems>
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridColumn Header="Template"
                            FieldName="AuditYearAdjustment.auditYearAdjustmentType"
                            IsSmart="True"/>
            <dxg:GridColumn Header="Audit Currency"
                            FieldName="AuditYearAdjustment.auditCurrency.CurrencyName"
                            IsSmart="True"/>
            <dxg:GridColumn Header="Revenue"
                            FieldName="AuditYearAdjustment.revenue"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Deffered Income"
                            FieldName="AuditYearAdjustment.defferedIncome"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>  
            <dxg:GridColumn Header="Comission (OC)"
                            FieldName="AuditYearAdjustment.comissionOC"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn> 
            <dxg:GridColumn Header="Net Comission (OC)"
                            FieldName="AuditYearAdjustment.netComissionOC"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn> 
            <dxg:GridColumn Header="Net Comission (Audit)"
                            FieldName="AuditYearAdjustment.netComissionAudit"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn> 
            <dxg:GridColumn Header="Comission (Audit)"
                            FieldName="AuditYearAdjustment.comissionAudit"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn> 
            <dxg:GridColumn Header="CGS"
                            FieldName="AuditYearAdjustment.cgs"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Account Receivable"
                            FieldName="AuditYearAdjustment.accountReceivable"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>    
            <dxg:GridColumn Header="Account Payble"
                            FieldName="AuditYearAdjustment.accountPayable"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Bank"
                            FieldName="AuditYearAdjustment.bank"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="System Margin (Audit)"
                            FieldName="AuditYearAdjustment.SystemMarginAudit"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Exhange Rate"
                            FieldName="AuditYearAdjustment.ExhangeRate"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>  
            <dxg:GridColumn Header="Actual Margin (Audit)"
                            FieldName="AuditYearAdjustment.ActualMarginAudit"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>   
            <dxg:GridColumn Header="BudgetMargin (Audit)"
                            FieldName="AuditYearAdjustment.BudgetMarginAudit"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="BudgetCost (OC)"
                            FieldName="AuditYearAdjustment.BudgetCost"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="ActualCost (OC)"
                            FieldName="AuditYearAdjustment.ActualCost"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="SystemCost (OC)"
                            FieldName="AuditYearAdjustment.SystemCost"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="BudgetCost (Audit)"
                            FieldName="AuditYearAdjustment.BudgetCostAudit"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="ActualCost (Audit)"
                            FieldName="AuditYearAdjustment.ActualCostAudit"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="SystemCost (Audit)"
                            FieldName="AuditYearAdjustment.SystemCostAudit"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn Header="SO Amount (Audit)"
                            FieldName="AuditYearAdjustment.SOAmountAudit"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>   
            <dxg:GridColumn Header="SO Amount (OC)"
                            FieldName="AuditYearAdjustment.SOAmount"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Budget Margin (OC)"
                            FieldName="AuditYearAdjustment.BudgetMargin"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="Actual Margin (OC)"
                            FieldName="AuditYearAdjustment.ActualMargin"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn Header="System Margin (OC)"
                            FieldName="AuditYearAdjustment.SystemMargin"
                            IsSmart="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            
            
            
            <dxg:GridColumn Header="Company"
                            FieldName="AuditYearAdjustment.company.CompanyName"
                            IsSmart="True"/>

            <dxg:GridColumn Header="Department"
                            FieldName="AuditYearAdjustment.department.DeptName"
                            IsSmart="True"/>
            <dxg:GridColumn Header="Customer"
                            FieldName="AuditYearAdjustment.customerCompany.company.CompanyName"
                            IsSmart="True"/>

            <dxg:GridColumn Header="Audit Year"
                            FieldName="AuditYearAdjustment.auditYear"
                            IsSmart="True"
                            >
                <dxg:GridColumn.EditSettings>
                    <dxe:DateEditSettings Mask="yyyy"
                       MaskUseAsDisplayFormat="True" MaskType="DateTime"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <dxg:GridColumn x:Name="colVendor"
                            FieldName="saleOrder.Vendorss"                      
                            Header="Vendor"                      
                            UnboundType="string"                      
                            Visible ="True"                            
                            AllowEditing="false"/>

            <dxg:GridColumn Header="Principal"
                            FieldName="AuditYearAdjustment.principal.company.CompanyName"
                            IsSmart="True"/>
            <dxg:GridColumn Header="Allocated To"
                            FieldName="AuditYearAdjustment.employee.person.FName"
                            IsSmart="True"
                             />


        </dxg:GridControl>

    </Grid>
</dx:DXWindow>
