<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Procurementss.SaleOrderss.winPerformanceSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SaleOrderss" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Title="Performance Sheet" WindowStartupLocation="CenterScreen" Height="450" Width="800" Loaded="DXWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="SO Number" Grid.Row="0" FontWeight="DemiBold" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <dxe:TextEdit x:Name="txtSoNumber" Grid.Column="1" IsReadOnly="True"  NullText="Enter SO Number" Grid.Row="0" Margin="5"/>

        <TextBlock Grid.Column="4" Grid.Row="0" FontWeight="DemiBold" Text="Customer" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <dxg:LookUpEdit x:Name="lookupCustomer"
                          Grid.Column="5"
                          Grid.Row="0"
                        IsReadOnly="True"
                                VerticalAlignment="Center"
                          AutoPopulateColumns="True"
                          DisplayMember="company.CompanyName"
                                Margin="5"
                          >
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <dxg:GridControl Name="PART_GridControl"
                                   AutoPopulateColumns="True"
                                   Grid.Row="1">
                            <dxg:GridControl.View>
                                <dxg:TreeListView Name="treeListView1"
                                        ShowAutoFilterRow="True"
                                        TreeDerivationMode="Selfreference"
                                        KeyFieldName="Id"
                                        ParentFieldName="ParentID" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn x:Name="colId"
                                    FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                            <dxg:GridColumn FieldName="company.CompanyName"
                                    IsSmart="True"
                                    Width="auto" 
                                                       />
                            <dxg:GridColumn FieldName="company.IndustryType"
                                    IsSmart="True"
                                    Visible="False" />
                            <dxg:GridColumn x:Name="colBizType"
                                    FieldName="company.BizType"
                                    Visible="False"
                                    IsSmart="True" />
                            <dxg:GridColumn FieldName="contactPerson.FName"
                                    x:Name="colFname"
                                    IsSmart="True"
                                    Visible="True"
                                    Header="First Name"
                                    Width="auto" />
                            <dxg:GridColumn FieldName="contactPerson.LName"
                                    x:Name="colLname"
                                    IsSmart="True"
                                    Visible="True"
                                    Header="Last Name"
                                    Width="auto" />
                            <dxg:GridColumn FieldName="contact.ContactNo"
                                    IsSmart="True"
                                    x:Name="colcontactno"
                                    Visible="False"
                                    Header="Phone"
                                    Width="auto" />
                            <dxg:GridColumn FieldName="company.currency.CurrencyName"
                                    x:Name="colCurrency"
                                    IsSmart="True"
                                    Visible="False"
                                    Header="Currency" />
                            <dxg:GridColumn FieldName="contact.Fax"
                                    Visible="False"
                                    x:Name="colFax"
                                    IsSmart="True"
                                    Header="Fax" />
                            <dxg:GridColumn FieldName="contact.Email"
                                    x:Name="colEmail"
                                    IsSmart="True"
                                    Visible="False"
                                    Header="Email" />
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>

        <TextBlock Grid.Column="2" Grid.Row="0" FontWeight="DemiBold" Text="Department" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <dxg:LookUpEdit x:Name="lookupDepartment"
                          Grid.Column="3"
                          Grid.Row="0"
                        IsReadOnly="True"
                          TabIndex="6"
                          VerticalAlignment="Center"
                          AutoPopulateColumns="True"
                          DisplayMember="DeptName"
                          EditValueChanged="lookupDepartment_EditValueChanged"
                          Margin="5"
                          >
            <dxg:LookUpEdit.PopupContentTemplate>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        
                        <dxg:GridControl Name="PART_GridControl"
                                   AutoPopulateColumns="True"
                                   Grid.Row="1">
                            <dxg:GridControl.View>
                                <dxg:TreeListView Name="treeListView1"
                                        ShowAutoFilterRow="True"
                                        TreeDerivationMode="Selfreference"
                                        KeyFieldName="Id"
                                        ParentFieldName="ParentID" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="Id"
                                    x:Name="coldeptid"
                                    IsSmart="True"
                                    Visible="False" />
                            <dxg:GridColumn x:Name="coldeptname"
                                    FieldName="DeptName"
                                    IsSmart="True" />
                            <dxg:GridColumn x:Name="coldeptcode"
                                    FieldName="Code"
                                    IsSmart="True" />
                            <dxg:GridColumn FieldName="Abbrivation"
                                    IsSmart="True"
                                    x:Name="coldeptabr"
                                    Visible="True" />
                            <dxg:GridColumn FieldName="Timestamp"
                                    IsSmart="True"
                                    x:Name="coldeptts"
                                    Visible="False" />
                        </dxg:GridControl>
                    </Grid>
                </ControlTemplate>
            </dxg:LookUpEdit.PopupContentTemplate>
        </dxg:LookUpEdit>

        <TextBlock Text="Allocated to" FontWeight="DemiBold" Grid.Row="1" Grid.Column="0" Margin="5" HorizontalAlignment="Center"/>
        <ComboBox x:Name="cmbAllocatedTo"
                    VerticalAlignment="Top"
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="5">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                             Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Supervisor" FontWeight="DemiBold" Grid.Row="1" Grid.Column="2" Margin="5" HorizontalAlignment="Center"/>
        <ComboBox x:Name="cmbStaffLevelone"
                    VerticalAlignment="Top"
                    Grid.Column="3"
                    Grid.Row="1"
                    Margin="5">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                             Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Department Head" FontWeight="DemiBold" Grid.Row="1" Grid.Column="4" Margin="5" HorizontalAlignment="Center"/>
        <ComboBox x:Name="cmbStaffLevetwo"
                    VerticalAlignment="Top"
                    Grid.Column="5"
                    Grid.Row="1"
                    Margin="5"
                     >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="{Binding id}"
                             Visibility="Hidden" />
                        <TextBlock Text="{Binding name}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <dxg:GridControl x:Name="grdEfficiency"
                         Grid.Row="2"
                         SelectionMode="Cell"
                         Grid.ColumnSpan="6"
                         
                         >
            <dxg:GridControl.View>
                <dxg:TableView     AutoWidth="True"
                                   ShowGroupPanel="False"
                                   NewItemRowPosition="Bottom"
                                   AllowSorting="False"
                                   AllowColumnFiltering="False"
                                   ShowTotalSummary="True" 
                                   CellValueChanged="view_CellValueChanged"
                                   ShowVerticalLines="True"  
                                   ShowHorizontalLines="True"
                                   ShowFixedTotalSummary="False"  
                                   HorizontalScrollbarVisibility="Visible"
                                   x:Name="view">
                    
                </dxg:TableView>
            </dxg:GridControl.View>


            <dxg:GridColumn  x:Name="PerformanceSheetHead"
                        FieldName="PerformanceSheetHead.HeadName"
                          Header="Efficency Head"
                          IsSmart="True"
                             ReadOnly="True"
                          VisibleIndex="0"          
                         
               
            />



            <dxg:GridColumn FieldName="totalPoints"
                            Header="Total Points"
                            VisibleIndex="1"
                            ReadOnly="True"
                            IsSmart="True"  >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" 
                                          Mask="n2" 
                                          MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <!--//secured points are initial points-->
            <dxg:GridColumn FieldName="initialPoints"
                            Header="Supervisor Points"
                            VisibleIndex="2"
                            IsSmart="True"  >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" 
                                          Mask="n2" 
                                          MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="revisedPoints"
                            Header="Dep. Head Points"
                            VisibleIndex="2"
                            ReadOnly="False"
                            IsSmart="True"  >
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings MaskType="Numeric" 
                                          Mask="n2" 
                                          MaskUseAsDisplayFormat="True"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>




        </dxg:GridControl>
        <Grid Grid.Row="3" Grid.ColumnSpan="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" Text="Total Points" Margin="5"/>
            <dxe:TextEdit x:Name="txtTotalPoints" Grid.Column="1" Margin="5"  Grid.Row="3" IsReadOnly="True" Text="0" MaskUseAsDisplayFormat="True" MaskType="Numeric" Mask="n2"/>
            <TextBlock Grid.Column="2" Grid.Row="3" VerticalAlignment="Center" Text="Final Points" Margin="5"/>
            <dxe:TextEdit x:Name="txtTotalFinalPoints" Grid.Column="3" Margin="5"  Grid.Row="3" IsReadOnly="True" Text="0" MaskUseAsDisplayFormat="True" MaskType="Numeric" Mask="n2"/>
            <dxe:TextEdit x:Name="txtAveragePoints" Grid.Column="3" Margin="5" IsReadOnly="True" Grid.ColumnSpan="2" Grid.Row="3" Text="0" MaskUseAsDisplayFormat="True" MaskType="Numeric" Visibility="Collapsed" Mask="n2"/>
            <TextBlock Grid.Column="4" Grid.Row="4" VerticalAlignment="Center" Text="Points Percentage" Margin="5"/>
            <dxe:TextEdit x:Name="txtPointsPerc" Grid.Column="5" Margin="5" IsReadOnly="True"  Grid.Row="3" Text="0" MaskUseAsDisplayFormat="True" MaskType="Numeric" Visibility="Visible" Mask="P2"/>
        </Grid>
        

        <dx:SimpleButton x:Name="btnSave" Grid.Row="4" Content="Save" Grid.ColumnSpan="6" Click="btnSave_Click" />

    </Grid>
</dx:DXWindow>
