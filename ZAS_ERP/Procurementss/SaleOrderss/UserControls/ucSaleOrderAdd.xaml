<UserControl x:Class="ZAS_ERP.Procurementss.SaleOrderss.ucSaleOrderAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SaleOrderss"

             xmlns:vali="clr-namespace:ZAS_ERP.Validations"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:loc="clr-namespace:ZAS_ERP" xmlns:dxnav="http://schemas.devexpress.com/winfx/2008/xaml/navigation" xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1000"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             x:Name="winSaleOrderadd"
             Loaded="winSaleOrderadd_Loaded"
             Unloaded="winSaleOrderadd_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="b2v"/>
    </UserControl.Resources>
    <UserControl.CommandBindings>
        <CommandBinding Command="loc:CustomCommands.ReplytoComment" CanExecute="Command_CanExecute" Executed="Command_Executed" />
        <CommandBinding Command="loc:CustomCommands.ChangeFlag" CanExecute="Resend_CanExecute" Executed="Resend_Executed" />
    </UserControl.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Padding="0 0 0 0" >

            <dxdo:DockLayoutManager>
                <dxdo:DockLayoutManager.AutoHideGroups>
                    <dxdo:AutoHideGroup DockType="Right" >
                        <dxdo:LayoutPanel Caption="Status Tracking" MinWidth="800" >
                            <Grid x:Name="gridOrderStatusTrack"         Panel.ZIndex="5" VerticalAlignment="Top"   HorizontalAlignment="Stretch">

                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <dxnav:TileNavPane  VerticalAlignment="Center">
                                        <dxnav:TileNavPane.NavButtons>
                                            <dxnav:NavButton x:Name="btnOrderStatusByTrack"    FontWeight="Bold" Content="   Status Tracking" ToolTip="Orders Tracking" Cursor="Hand" GlyphAlignment="Left"  AllowGlyphTheming="True" HorizontalAlignment="Stretch" />
                                            <dxnav:NavButton x:Name="btnRefreshStatusTracking" Content="Refresh" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top"  Glyph="{dx:DXImageGrayscale Image=Refresh_32x32.png}" Click="btnRefreshStatusTracking_Click"/>
                                            <dxnav:NavButton x:Name="btnExpandStatusTracking" Content="Expand" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top"  Glyph="{dx:DXImage Image=ExpandFieldPivotTable_32x32.png}" Click="btnExpandStatusTracking_Click"/>
                                            <dxnav:NavButton x:Name="btnCollapsedStatusTracking" Content="Collapse" HorizontalAlignment="Right" AllowGlyphTheming="True" GlyphAlignment="Top"  Glyph="{dx:DXImage Image=CollapseFieldPivotTable_32x32.png}" Click="btnCollapsedStatusTracking_Click"/>


                                        </dxnav:TileNavPane.NavButtons>
                                    </dxnav:TileNavPane>
                                </Grid>
                                <Grid Grid.Row="1" >
                                    <dxg:GridControl x:Name="grdStatusTracking" MinHeight="1500"   MaxHeight="790"  SelectionMode="Row"   AllowInitiallyFocusedRow="True" Grid.Row="1" >
                                        <dxg:GridControl.View>
                                            <dxg:TreeListView x:Name="grdStatusTrackingTree"
                                        KeyFieldName="Id"
                                                       MouseDoubleClick="grdStatusTrackingTree_MouseDoubleClick"
                            ParentFieldName="ParentId"
                           AllowEditing="False"
                            NavigationStyle="Row"
                            Width="auto"
                            AutoWidth="True"      
                            AlternateRowBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"      
                            ShowAutoFilterRow="True"      
                            ShowSearchPanelMode="Default"
                            TreeDerivationMode="Selfreference"
                            AutoPopulateServiceColumns="False"
                            ColumnFilterPopupMode="Excel"
                            CompactPanelShowMode="CompactMode"
                            ShowFixedTotalSummary="True"
                            AllowDragDrop="True"      
                            ShowTotalSummary="True"    
                            RowAnimationKind="None" WaitIndicatorType="Panel"      
                            FadeSelectionOnLostFocus="False"
                            ShowSelectionRectangle="True"                           
                                                       >
                                                <!--<dxg:TreeListView.FormatConditions>
                                                        <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Closed">
                                                            <dx:Format Background="#FFFF0000"/>
                                                        </dxg:FormatCondition>
                                                        <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Approved">
                                                            <dx:Format Background="#FF9BBB59"/>
                                                        </dxg:FormatCondition>
                                                        <dxg:FormatCondition FieldName="Stage" ApplyToRow="false" ValueRule="Equal" Value1="Under Closing">
                                                            <dx:Format Background="#FFF79646"/>
                                                        </dxg:FormatCondition>

                                                        <dxg:FormatCondition FieldName="Stage" ValueRule="Equal" Value1="Under Approval" ApplyToRow="false">
                                                            <dx:Format Background="#8E4CACC7"/>
                                                        </dxg:FormatCondition>
                                                        <dxg:FormatCondition FieldName="Stage" ValueRule="Equal" Value1="Void" ApplyToRow="false">
                                                            <dx:Format Background="#FFBFBFBF"/>
                                                        </dxg:FormatCondition>
                                                    </dxg:TreeListView.FormatConditions>-->

                                            </dxg:TreeListView>
                                        </dxg:GridControl.View>
                                        <dxg:GridColumn FieldName="Id" Visible="False"/>
                                        <dxg:GridColumn FieldName="GroupId" Header="Group Id"  Visible="False" />
                                        <!--<dxg:GridColumn FieldName="Stage" VisibleIndex="7" Header="Stage"  Image="{dx:DXImage Image=Action_Show_PivotGrid_Designer.png}"/>-->

                                        <dxg:GridColumn 
                                    VisibleIndex="6"
                                          FieldName="_Status"
                                          Header="Status"
                                            
                                          UnboundType="Bound"
                                          Image="{dx:DXImage Image=Status_16x16.png}"
                                          Visible ="True"
                                          AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                            <ColumnDefinition Width="1*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.BackColor}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.Status}"/>
                  </InlineUIContainer></TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn 
                                    VisibleIndex="6"
                                          FieldName="_StatusClass"
                                          Header="Status Class"
                                          UnboundType="Bound"
                                          Image="{dx:DXImage Image=Status_16x16.png}"
                                          Visible ="True"
                                          AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                            <ColumnDefinition Width="1*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.BackColorStatusClass}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.StatusClass}"/>
                  </InlineUIContainer></TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>

                                        <dxg:GridColumn FieldName="Company" VisibleIndex="1" Header="Company" Image="{dx:DXImage Image=Home_16x16.png}"/>
                                        <dxg:GridColumn FieldName="Department" VisibleIndex="2" Header="Department" Image="{dx:DXImage Image=BO_Department.png}"/>
                                        <dxg:GridColumn FieldName="Vendor" VisibleIndex="3" Header="Vendor" Image="{dx:DXImage Image=BO_Department.png}"/>
                                        <dxg:GridColumn FieldName="Currency" VisibleIndex="4" Header="Currency"  Image="{dx:DXImage Image=Currency2_16x16.png}"/>
                                        <dxg:GridColumn FieldName="AmountOC" VisibleIndex="5" Header="Amount(OC)"  Image="{dx:DXImage Image=Currency2_16x16.png}">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="transactionType" VisibleIndex="0" Header="Transaction Type"  Image="{dx:DXImage Image=Currency2_16x16.png}">

                                        </dxg:GridColumn>




                                    </dxg:GridControl>
                                </Grid>
                            </Grid>

                        </dxdo:LayoutPanel>
                    </dxdo:AutoHideGroup>
                </dxdo:DockLayoutManager.AutoHideGroups>

                <dxdo:LayoutGroup  Orientation="Vertical" >

                    <dxdo:LayoutPanel Caption="Sale Order Details" x:Name="layoutSaleOrderDetails">


                        <Grid Height="auto">


                            <StackPanel Grid.Row="1" Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Left" dx:ThemeManager.ThemeName="None"
                 Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="3" ToolTip="Info" Click="BtnInfo_Click">
                                    <Image  Source="/ZAS_ERP;component/images/log.png"></Image>
                                </Button>
                                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1" Click="BtnMarkReviewed_Click"  ToolTip="Approve - Mark as Reviewed">
                                    <Image  Source="/ZAS_ERP;component/images/approve.png"></Image>
                                </Button>
                                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnDirectClose" Grid.Column="2" Click="BtnDirectClose_Click"  ToolTip="Direct Close">
                                    <Image Source="/ZAS_ERP;component/images/closeLogo32x32.png"></Image>
                                </Button>
                                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="2" Click="BtnAddComment_Click"  ToolTip="Add New Comment">
                                    <Image  Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
                                </Button>
                                <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="2" Click="BtnCommentLog_Click"  ToolTip="CommentLog">
                                    <Image  Source="/ZAS_ERP;component/images/comments.png" ></Image>
                                </Button>
                                <Button x:Name="btnAttachNew" Visibility="Collapsed" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Info" Click="BtnAttachNew_Click">
                                    <Image x:Name="imgAttachNew"  Source="/ZAS_ERP;component/images/clipattachment.png"></Image>
                                </Button>
                                <Button x:Name="btnAttachmentList" Visibility="Collapsed" Width="30" Height="30" Grid.Column="3" ToolTip="Info" Click="BtnAttachmentList_Click">
                                    <Image  Source="/ZAS_ERP;component/images/ListAttachment.png"></Image>
                                </Button>
                                <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnTrackingWindow" Grid.Column="2" Click="BtnTrackingWindow_Click"  ToolTip="360 View">
                                    <Image  Source="/ZAS_ERP;component/images/360Arrow.png" ></Image>
                                </Button>
                                <Button Height="30" Width="30"  Margin="5,0,0,0" x:Name="btnSetVoid" Visibility="Collapsed" Grid.Column="2" Click="BtnSetVoid_Click"  ToolTip="Mark as void">
                                    <Image  Source="/ZAS_ERP;component/images/void_order.png" ></Image>
                                </Button>
                                <Button x:Name="btnAttachNew1" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Attach document" Click="BtnAttachNew1_Click">
                                    <Image x:Name="imgAttachNew1"  Source="{dx:DXImage Image=Attachment_32x32.png}"></Image>
                                </Button>
                                <Button x:Name="btnAttachmentList1"  Width="30" Height="30" Grid.Column="3" ToolTip="List of Attachments" Click="BtnAttachmentList1_Click">
                                    <Image  Source="{dx:DXImage Image=ListNumbers_32x32.png}"></Image>
                                </Button>
                                <Button x:Name="btnLinkedSO"  Width="30" Height="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Linked SO" Click="btnLinkedSO_Click" Visibility="Visible">
                                    <Image   Source="{dx:DXImage Image=LinkToPrevious_16x16.png}"></Image>
                                </Button>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Panel.ZIndex="5" VerticalAlignment="Top"  Margin="0,30,0,0" HorizontalAlignment="Left" dx:ThemeManager.ThemeName="None">
                                <Button x:Name="btnSOTracking"  Width="30" Height="30"  Grid.Column="3" ToolTip="Customer Profile By SO" Click="btnSOTracking_Click" Visibility="Visible">
                                    <Image   Source="{dx:DXImage Image=TimeLineView_32x32.png}"></Image>
                                </Button>
                                <Button x:Name="btnPOTracking"  Width="30" Height="30" Margin="5,0,0,0" Grid.Column="3" ToolTip="Vendor Profile By PO" Click="btnPOTracking_Click" Visibility="Visible">
                                    <Image   Source="{dx:DXImage Image=TimeLineView_32x32.png}"></Image>
                                </Button>
                                <Button x:Name="btnLinkBudget"  Width="30" Height="30" Margin="5,0,5,0" Grid.Column="3" ToolTip="Link Budget" Click="btnLinkBudget_Click" Visibility="Visible">
                                    <Image   Source="{dx:DXImage Image=Attach_16x16.png}"></Image>
                                </Button>
                                <Button x:Name="btnPerforSheet"  Width="30" Height="30" Margin="0,0,5,0" Grid.Column="3" ToolTip="Performance Sheet" Click="btnPerforSheet_Click" Visibility="Visible">
                                    <Image   Source="{dx:DXImage Image=BOPivotChart_32x32.png}"></Image>
                                </Button>
                                <Button x:Name="btnGenerateRef"  Width="30" Height="30" Margin="0,0,5,0" Grid.Column="3" ToolTip="Generate Ref" Click="btnGenerateRef_Click" Visibility="Visible">
                                    <Image   Source="{dx:DXImage Image=Upload_32x32.png}"></Image>
                                </Button>
                                <Button x:Name="btnFetchRef"  Width="30" Height="30" Margin="0,0,5,0" Grid.Column="3" ToolTip="Fetch Ref" Click="btnFetchRef_Click" Visibility="Visible">
                                    <Image   Source="{dx:DXImage Image=Download_32x32.png}"></Image>
                                </Button>
                                <Button x:Name="btnStageTracking"  Width="30" Height="30"  Grid.Column="3" ToolTip="Orders Stage Tracking" Click="btnStageTracking_Click" Visibility="Visible">
                                    <Image   Source="{dx:DXImage Image=PackageProduct_32x32.png}"></Image>
                                </Button>
                                <Button x:Name="btnAuditAdjustment"   Width="30" Height="30"  Grid.Column="3" ToolTip="Add Audit Adjustment" Click="btnAuditAdjustment_Click" Visibility="Collapsed">
                                    <Image   Source="{dx:DXImage Image=BO_Audit_ChangeHistory.png}"></Image>
                                </Button>
                                <Button x:Name="btnUnlinkParent" Margin="5,0,5,0" Width="30" Height="30"  Grid.Column="3" ToolTip="Unlink Key" Click="btnUnlinkParent_Click" Visibility="Visible">
                                    <Image   Source="{dx:DXImage Image=CrossbandLine_32x32.png}"></Image>
                                </Button>
                            </StackPanel>
                            <Grid Panel.ZIndex="5" Visibility="Collapsed" x:Name="gridTracker" Width="500" Margin="35"  HorizontalAlignment="Left" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button x:Name="btnCollapse" Click="BtnCollapse_Click" Content="Collapse"></Button>
                                    <TextBlock Text="Activity Tracker" FontWeight="Bold" FontSize="26" Foreground="Black" Margin="30,5"></TextBlock>
                                    <Button x:Name="btnexpand" Click="Btnexpand_Click" Content="Expand"></Button>

                                </StackPanel>
                                <dxg:GridControl x:Name="grdUsers" Visibility="Visible"
                     Grid.Row="1" MaxHeight="520"
                     Grid.RowSpan="5" HorizontalAlignment="Left"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             
                     SelectionMode="Row" 
                             
                             
                      CustomUnboundColumnData="GrdUsers_CustomUnboundColumnData"   
                    AutoGenerateColumns="None">
                                    <dxg:GridControl.View>
                                        <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       
                                   AutoWidth="True"
                       Width="auto"
                       AllowGrouping="False"
                                   ShowGroupPanel="False"
                       
                       >

                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn Header="User Name"
                            FieldName="User.userName"
                            IsSmart="True"
                            Width="auto" />
                                    <!--<dxg:GridColumn FieldName="Name" UnboundType="String" ReadOnly="True" >
                    -->
                                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                                    <!--
                </dxg:GridColumn>-->
                                    <dxg:GridColumn FieldName="Timestamp" UnboundType="String" ReadOnly="True" Width="auto">
                                        <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Info"
                            FieldName="Info"
                            IsSmart="True"
                            Width="auto" />
                                    <dxg:GridColumn 
                            FieldName="Comment"
                            IsSmart="True"
                            Width="auto" />
                                    <!--<dxg:GridColumn FieldName="isActive"  >
                    -->
                                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                                    <!--
                </dxg:GridColumn>-->
                                    <!--<dxg:GridColumn FieldName="SupervisorName" UnboundType="String" ReadOnly="True" >
                    -->
                                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                                    <!--
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Departments" UnboundType="String" ReadOnly="True" >
                    -->
                                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                                    <!--
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Companies" UnboundType="String" ReadOnly="True" >
                    -->
                                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                                    <!--
                </dxg:GridColumn>-->
                                </dxg:GridControl>
                            </Grid>
                            <Grid x:Name="grdComments"  Visibility="Collapsed" Width="450" Height="800"  Background="Gray" Panel.ZIndex="5" VerticalAlignment="Top" Margin="35" HorizontalAlignment="Left">

                                <dxg:GridControl AutoExpandAllGroups="True"  Height="auto" Grid.Row="1"  dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">

                                    <!--#region Columns-->
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn  Width="auto" FieldName="employee.person.Photo" Header="Image" >
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ImageEditSettings />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                                        <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                                        <dxg:GridColumn Width="Auto" FieldName="Subject" />
                                        <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                                        <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                                        <dxg:GridColumn
                            Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Descending" />

                                        <dxg:GridColumn x:Name="colFlag"
                      FieldName="notificationFlag.Flag"
                      Header="Flag"
                                       Image="{dx:DXImage Image=Status_16x16.png}"
                      UnboundType="Bound"
                      Visible ="True"
                      VisibleIndex="1"  AllowColumnFiltering="Default" ColumnFilterMode="DisplayText">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                            <ColumnDefinition Width="1*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="PART_Editor">
                                            <InlineUIContainer>
                                                <Polygon Points="0,0 15,8, 0,15" Width="25" Margin="5 3 0 0" Stroke="{Binding RowData.Row.notificationFlag.backcolor}" Fill="{Binding RowData.Row.notificationFlag.backcolor}"/>
                                            </InlineUIContainer><Run Text=" "/>
                                            <InlineUIContainer>
                                                <TextBlock x:Name="PART_Editor2" Text="{Binding RowData.Row.notificationFlag.Flag}" Foreground="Black" FontWeight="Bold"  VerticalAlignment="Center" Margin="0 -3 0 0"/>
                                            </InlineUIContainer>
                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <!--#endregion-->
                                    <dxg:GridControl.View>
                                        <dxg:TableView 
                            x:Name="GrdCommenttableView"
                            AllowEditing="False" 
                            DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                            DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0"
                            RowStyle="{StaticResource RowStyle}"
                           
                            ShowSearchPanelMode="Always"
                            SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" 
                            ShowIndicator="False" 
                            ShowVerticalLines="False"
                            CompactPanelShowMode="Always" 
                            SwitchToCompactModeWidth="700"
                            NavigationStyle="Row"
                           >

                                            <dxg:TableView.FormatConditions>
                                                <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                                    <dxg:FormatCondition.Format>
                                                        <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                                    </dxg:FormatCondition.Format>
                                                </dxg:FormatCondition>

                                                <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Class Changed')">
                                                    <dxg:FormatCondition.Format>
                                                        <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                                    </dxg:FormatCondition.Format>
                                                </dxg:FormatCondition>
                                                
                                                <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Changed')">
                                                    <dxg:FormatCondition.Format>
                                                        <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                                    </dxg:FormatCondition.Format>
                                                </dxg:FormatCondition>
                                                <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'SO Approved')">
                                                    <dxg:FormatCondition.Format>
                                                        <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                                    </dxg:FormatCondition.Format>
                                                </dxg:FormatCondition>

                                                <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'SO UnApproved')">
                                                    <dxg:FormatCondition.Format>
                                                        <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                                    </dxg:FormatCondition.Format>
                                                </dxg:FormatCondition>

                                                <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'SO Voided')">
                                                    <dxg:FormatCondition.Format>
                                                        <dxg:Format FontWeight="Bold" Background="Orange" />

                                                    </dxg:FormatCondition.Format>
                                                </dxg:FormatCondition>

                                                <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'SO UnVoided')">
                                                    <dxg:FormatCondition.Format>
                                                        <dxg:Format FontWeight="Bold" Background="Orange" />

                                                    </dxg:FormatCondition.Format>
