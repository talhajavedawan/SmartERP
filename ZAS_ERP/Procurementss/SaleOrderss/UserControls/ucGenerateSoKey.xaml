<dx:DXWindow x:Class="ZAS_ERP.Procurementss.SaleOrderss.UserControls.ucGenerateSoKey"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SaleOrderss.UserControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:Databases="clr-namespace:ERP_BL.Databases;assembly=ERP_BL"
              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
             Height="400" Width="400" Loaded="DXWindow_Loaded">
   
    <Grid>
        <Grid.Resources>
            <dx:EntitySimpleDataSource x:Key="EntitySimpleDataSource" ContextType="{x:Type Databases:DBContextERP}" Path="Companies">
                <dx:DesignDataManager.DesignData>
                    <dx:DesignDataSettings RowCount="5"/>
                </dx:DesignDataManager.DesignData>
            </dx:EntitySimpleDataSource>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>


        <Label Content="Sale Order Key Generation" HorizontalAlignment="Center"  FontWeight="DemiBold" Grid.ColumnSpan="4" />

        <Label Content="Sale Order key" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1"/>
        <TextBox x:Name="txtSOKey" Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" IsReadOnly="True" Margin="15"/>
        <Label Content="Key Generation Date" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1"/>
        <dxe:DateEdit x:Name="datKeyGen" Grid.Column="2" VerticalAlignment="Center" Grid.Row="2"  Margin="15" NullText="Select Date" IsReadOnly="True"/>

        <Label   Content="Company" Grid.Row="3" VerticalAlignment="Center"  Grid.Column="1"    />
        <dxg:LookUpEdit x:Name="mbtnAllCompanies" Grid.Column="2" VerticalAlignment="Center" Grid.Row="3" Margin="15" NullText="Select Company"  ItemsSource="{Binding Data, Source={StaticResource EntitySimpleDataSource}}" DisplayMember="CompanyName"   >
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings/>
            </dxg:LookUpEdit.StyleSettings>
        </dxg:LookUpEdit>

        <Label   Content="Department" Grid.Row="4" VerticalAlignment="Center"   Grid.Column="1"     />
        <dxg:LookUpEdit x:Name="mbtnAllDepartments" Grid.Column="2" VerticalAlignment="Center" Grid.Row="4" Margin="15" NullText="Select Company"  ItemsSource="{Binding Data, Source={StaticResource EntitySimpleDataSource}}" DisplayMember="DeptName"   >
            <dxg:LookUpEdit.StyleSettings>
                <dxg:LookUpEditStyleSettings/>
            </dxg:LookUpEdit.StyleSettings>
        </dxg:LookUpEdit>
        <Label   Content="Creator" Grid.Row="6" VerticalAlignment="Center" Grid.Column="1" />

        <dxe:TextEdit x:Name="txtNoOfSaleOrder" Margin="15" Grid.Column="2" Grid.Row="5" VerticalAlignment="Center" Text="0" MaskType="Numeric" Mask="d"/>
        <Label   Content="No. Of Sale Orders" Grid.Row="5" VerticalAlignment="Center" Grid.Column="1" />

        <TextBlock x:Name="txtCreator" Margin="15" Grid.Column="2" Grid.Row="6" VerticalAlignment="Center" Text="Creator"/>
        <dx:SimpleButton x:Name="btnSave" Content="Save" Grid.Row="7" Grid.ColumnSpan="4" Click="btnSave_Click" />

    </Grid>
</dx:DXWindow>
