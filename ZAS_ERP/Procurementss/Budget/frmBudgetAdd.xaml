<dx:DXWindow xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Budget"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Procurementss.Budget.frmBudgetAdd"
        mc:Ignorable="d"
        xmlns:loc="clr-namespace:ZAS_ERP"
        Title="Add Month Budget"  
        d:DesignHeight="850"
        d:DesignWidth="1000" 
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>

            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>


        <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnInfo" Height="30" Width="30" Grid.Column="0" ToolTip="Info" Click="btnInfo_Click">
                <Image  Source="/ZAS_ERP;component/images/log.png"></Image>
            </Button>
            <Button  Height="30" Width="30" Margin="5,0,0,0" x:Name="btnMarkReviewed" Grid.Column="1"  Click="BtnMarkReviewed_Click"  ToolTip="Approve - Mark as Reviewed">
                <Image  Source="/ZAS_ERP;component/images/approve.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnDirectClose" Grid.Column="2" Click="BtnDirectClose_Click"  ToolTip="Direct Close">
                <Image Source="/ZAS_ERP;component/images/closeLogo32x32.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnAddComment" Grid.Column="3" Click="BtnAddComment_Click"  ToolTip="Add New Comment">
                <Image  Source="/ZAS_ERP;component/images/CommentAdd.png"></Image>
            </Button>
            <Button Height="30" Width="30" Margin="5,0,0,0" x:Name="btnCommentLog" Grid.Column="4" Click="BtnCommentLog_Click"  ToolTip="CommentLog">
                <Image  Source="/ZAS_ERP;component/images/comments.png" ></Image>
            </Button>
            <Button x:Name="btnAttachNew" Height="30" Width="30" Margin="5,0,5,0" Grid.Column="5" ToolTip="Attach document" Click="btnAttachNew_Click">
                <Image x:Name="imgAttachNew1"  Source="{dx:DXImage Image=Attachment_32x32.png}"></Image>
            </Button>
            <Button x:Name="btnAttachmentList"  Width="30" Height="30" Grid.Column="6" ToolTip="List of Attachments" Click="btnAttachmentList_Click">
                <Image  Source="{dx:DXImage Image=ListNumbers_32x32.png}"></Image>
            </Button>

        </Grid>



        <Grid Panel.ZIndex="5" Visibility="Collapsed" Grid.RowSpan="2" x:Name="gridTracker" Width="500" Margin="35"  HorizontalAlignment="Left" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="btnCollapse" Click="BtnCollapse_Click" Content="Collapse"></Button>
                <TextBlock Text="Activity Tracker" FontWeight="Bold" FontSize="26" Foreground="Black" Margin="30,5"></TextBlock>
                <Button x:Name="btnexpand" Click="Btnexpand_Click" Content="Expand"></Button>

            </StackPanel>
            <dxg:GridControl x:Name="grdUsers" Visibility="Visible"
                     Grid.Row="1" 
                     Grid.RowSpan="3" HorizontalAlignment="Left"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                             
                     SelectionMode="Row" 
                             
                             
                      CustomUnboundColumnData="GrdUsers_CustomUnboundColumnData"   
                    AutoGenerateColumns="None">
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView"
                       ColumnFilterPopupMode="Excel"
                       NavigationStyle="Row"
                       
                                   AutoWidth="True"
                       Width="auto"
                       AllowGrouping="False"
                                   ShowGroupPanel="False"
                       
                       >

                    </dxg:TableView>
                </dxg:GridControl.View>
                <dxg:GridColumn Header="User Name"
                            FieldName="User.userName"
                            IsSmart="True"
                            Width="auto" />
                <!--<dxg:GridColumn FieldName="Name" UnboundType="String" ReadOnly="True" >
                    -->
                <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                <!--
                </dxg:GridColumn>-->
                <dxg:GridColumn FieldName="Timestamp" UnboundType="String" ReadOnly="True" Width="auto">
                    <!--<dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings  Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>-->
                </dxg:GridColumn>
                <dxg:GridColumn Header="Info"
                            FieldName="Info"
                            IsSmart="True"
                            Width="auto" />
                <dxg:GridColumn 
                            FieldName="Comment"
                            IsSmart="True"
                            Width="auto" />

            </dxg:GridControl>
        </Grid>

        <Grid x:Name="grdComments" Grid.RowSpan="2"  Visibility="Collapsed" Width="400"   Background="Gray" Panel.ZIndex="5" VerticalAlignment="Stretch" Margin="35" HorizontalAlignment="Left">

            <dxg:GridControl AutoExpandAllGroups="True"  Height="auto" Grid.Row="1"  dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" x:Name="grdCommentss">
                <!--#region Columns-->
                <dxg:GridControl.Columns>
                    <dxg:GridColumn  Width="auto" FieldName="employee.person.Photo" Header="Image" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:ImageEditSettings />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Width="Auto" FieldName="employee.person.FName" Header="Sender"/>
                    <dxg:GridColumn Width="Auto" FieldName="Asignee.person.FName" Header="Asignee"/>
                    <dxg:GridColumn Width="Auto" FieldName="Subject" />
                    <dxg:GridColumn Width="Auto" FieldName="Comment"/>
                    <dxg:GridColumn Width="Auto" FieldName="Category.category" Header="Category"/>
                    <dxg:GridColumn
                            Width="Auto" FieldName="Timestamp" GroupIndex="1" Header="Date" ShowGroupedColumn="True" GroupInterval="DateRange"
                            SortOrder="Descending" />
                </dxg:GridControl.Columns>
                <!--#endregion-->
                <dxg:GridControl.View>
                    <dxg:TableView 
                            x:Name="GrdCommenttableView"
                            AllowEditing="False" 
                            DataRowCompactTemplate="{StaticResource CommentRowTemplate}"
                            DataRowTemplate="{StaticResource CommentRowTemplate}"
                            LeftGroupAreaIndent="0"
                            RowStyle="{StaticResource RowStyle}"
                           
                            ShowSearchPanelMode="Always"
                            SearchPanelNullText="Search Comment Box"
                            ShowGroupPanel="True" 
                            ShowIndicator="False" 
                            ShowVerticalLines="False"
                            CompactPanelShowMode="Always" 
                            SwitchToCompactModeWidth="700"
                            NavigationStyle="Row"
                           >

                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition ApplyToRow="True" Expression="[isRead] = False">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Foreground="#FF0072C6" />
                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'Status Changed')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightCoral" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>
                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'SO Approved')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'SO UnApproved')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="LightGreen" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'SO Voided')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="Orange" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                            <dxg:FormatCondition ApplyToRow="True"  Expression=" Contains([Subject], 'SO UnVoided')">
                                <dxg:FormatCondition.Format>
                                    <dxg:Format FontWeight="Bold" Background="Orange" />

                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>

                        </dxg:TableView.FormatConditions>
                        <!--#region CompactModeFilterItems-->
                        <!--<dxg:TableView.CompactModeFilterItems>
                            <dxg:CompactModeFilterItem DisplayValue="All" />
                            <dxg:CompactModeFilterItem DisplayValue="Read" EditValue="[isRead] = True" />
                            <dxg:CompactModeFilterItem DisplayValue="Unread" EditValue="[isRead] = False" />

                        </dxg:TableView.CompactModeFilterItems>-->
                        <!--#endregion-->

                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>

        </Grid>

        <Grid x:Name="grdAttachments"  Grid.RowSpan="2"  Width="300" Visibility="Collapsed" Background="Gray" Panel.ZIndex="5" VerticalAlignment="Top" Margin="315,30,65,35"  HorizontalAlignment="Left">
            <TreeView x:Name="treeViewAttachments" >
                <TreeView.Resources>
                    <HierarchicalDataTemplate  DataType="{x:Type loc:TreeItem}" ItemsSource="{Binding Items}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding name}"
                         Grid.Column="0"
                         
                         HorizontalAlignment="Stretch" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text=" [" Foreground="Blue" />
                                <TextBlock Text="{Binding Items.Count}" Foreground="Blue" />
                                <TextBlock Text="]" Foreground="Blue" />
                            </StackPanel>
                        </Grid>
                    </HierarchicalDataTemplate>
                    <DataTemplate  DataType="{x:Type loc:cmbitem}" >
                        <StackPanel>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />

                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />

                                </Grid.ColumnDefinitions>
                                <!--<CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>-->
                                <TextBlock Text="{Binding id}"
                         Visibility="Collapsed" />
                                <TextBlock Text="{Binding description}"
                         Visibility="Collapsed" />
                                <Button Content="Open" Margin="5,0" x:Name="btnDownloadAttachment" Click="BtnDownloadAttachment_Click" Foreground="Blue"  Tag="{Binding description}"></Button>

                                <TextBlock Text="   "
                         Background="{Binding bcolor}"
                         Width="20"
                         Margin="0,0,5,0" Grid.Column="1"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" >
                                    <TextBlock Text="{Binding name}"
                         Grid.Column="1"
                         
                         HorizontalAlignment="Stretch" />

                                    <!--<TextBlock Text=" [" Foreground="Blue" />-->
                                    <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                                    <!--<TextBlock Text="]" Foreground="Blue" />-->
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                    <!--<HierarchicalDataTemplate DataType="{x:Type self:cmbitem}"  >
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />

                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="1*" />
                                                    
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding isActive}" IsEnabled="False"/>
                                                <TextBlock Text="{Binding id}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="{Binding description}"
                         Visibility="Collapsed" />
                                                <TextBlock Text="   "
                         Background="{Binding bcolor}"
                         Width="20"
                         Margin="0,0,5,0" Grid.Column="1"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding name}"
                         Grid.Column="1"
                         
                         HorizontalAlignment="Stretch" />
                                                
                                                    <TextBlock Text=" [" Foreground="Blue" />
                                                    <TextBlock Text="{Binding fcolor}" Foreground="Blue" />
                                                    <TextBlock Text="]" Foreground="Blue" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>-->
                </TreeView.Resources>
            </TreeView>
        </Grid>

        <Grid x:Name="grdAttach" Grid.RowSpan="3"  Width="250" Visibility="Collapsed"  Background="White"  Panel.ZIndex="5" VerticalAlignment="Top" Margin="240,32,65,35" HorizontalAlignment="Left">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />

                    <ColumnDefinition Width="1*" />

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Category"
                         
                         
                         Margin="5,0,5,0" Grid.Column="0"/>
                <ComboBox x:Name="cmbCategory1"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                          Margin="5,5"
                      Grid.Row="0"
                      TabIndex="0"
                      >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Text="{Binding id}"
                               Visibility="Hidden" />
                                <TextBlock Text="{Binding name}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>


                <!--<TextBlock Text=" [" Foreground="Blue" />-->
                <TextBlock Text="{Binding fcolor}" Margin="5,0" Foreground="Blue" />
                <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.ColumnSpan="2" Content="Select file" Margin="5" x:Name="btnAttachment" Click="BtnAttachment_Click" Foreground="Blue"  Tag="{Binding description}"></Button>
                <!--<TextBlock Text="]" Foreground="Blue" />-->

            </Grid>

        </Grid>






        <Grid Grid.Row="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
   
            <dx:DXTabControl Grid.Row="0" Grid.Column="0" >
                <dx:DXTabItem Header="Budget Stage" FontWeight="DemiBold" >
                    <dxlc:LayoutGroup >


                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Border CornerRadius="10" Grid.Row="0" Grid.Column="0" Background="DeepSkyBlue" x:Name="grdTaskCreated" Visibility="Collapsed"  Height="25">
                                <Border.Style>                                    <Style TargetType="Border">                                        <Setter Property="Effect">                                            <Setter.Value>                                                <DropShadowEffect BlurRadius="14" Color="Blue" ShadowDepth="5"/>                                            </Setter.Value>                                        </Setter>                                    </Style>                                </Border.Style>
                                <TextBlock x:Name="txtTaskCreated" Text="Task has been Created!" Foreground="Black" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Padding="0 5 0 6.5" TextAlignment="Center" TextWrapping="WrapWithOverflow" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="Black"
                                   Text="Budget"
                                  Grid.Row="1"/>

                            <Grid x:Name="grdBillStage" Grid.Row="2" Height="35" Grid.Column="0" Margin="0 0 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Border CornerRadius="10" Grid.Column="0" Background="LightGray" x:Name="grdUnderApproval">
                                    <TextBlock Text="Under Approval" Padding="0 5 0 5" TextAlignment="Center" TextWrapping="WrapWithOverflow" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                                </Border>

                                <Border CornerRadius="10" Grid.Column="1" Background="LightGray" x:Name="grdApproved" Margin="2 0 0 0">
                                    <TextBlock Text="Approved" Padding="0 5 0 5" Grid.Column="1" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                                </Border>

                                <Border CornerRadius="10" Grid.Column="2" Background="LightGray" x:Name="grdUnderClosing" Margin="2 0 0 0">
                                    <TextBlock Text="Under Closing" Padding="0 5 0 5" Grid.Column="2" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                                </Border>

                                <Border CornerRadius="10" Grid.Column="3" Background="LightGray" x:Name="grdClosed" Margin="2 0 0 0">
                                    <TextBlock Text="Closed" Padding="0 5 0 5" Grid.Column="3" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Center"/>
                                </Border>

                                <StackPanel Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Stretch">

                                    <!--<TextBlock Text="Status"
                                       x:Name="lblStage"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       Foreground="Black"/>-->

                                    <TextBlock Visibility="Collapsed" Text=" (Amount Paid)"
                                       x:Name="lblBillPaid"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       Foreground="Black"/>
                                </StackPanel>


                            </Grid>


                            <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16" 
                                   x:Name="lblStage"
                                   Foreground="Black"
                                   Text="aaaa"
                                   Margin="0,0,0,0"/>
                            <Grid x:Name="grdInvoiceProgressBar" Grid.Row="4">
                                <ProgressBar x:Name="pbarTarget" Grid.ColumnSpan="2" Minimum="0" MinHeight="26" Margin="5 0 5 0" Foreground="LightGreen"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Margin="10,5" x:Name="txtInvoiced" Foreground="Blue" Text="Achieved" FontSize="16" FontWeight="DemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />
                                    <TextBlock Margin="10,5" x:Name="txtPbarValue" Foreground="Blue" FontWeight="DemiBold" FontSize="16"  Text="{Binding ElementName=pbarTarget , Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />

                                </StackPanel>
                            </Grid>
                        </Grid>



                    </dxlc:LayoutGroup>
                </dx:DXTabItem>
            </dx:DXTabControl>
            <dx:DXTabControl Grid.Row="0" Grid.Column="1">
                <dx:DXTabItem Header="Basic Information" FontWeight="DemiBold" >
                    <dxlc:LayoutGroup >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Company" Margin="5" FontWeight="DemiBold"/>
                            <dxg:LookUpEdit x:Name="lookupCompany"
                        Grid.Column="1" Grid.Row="1" Margin="5"
                          DisplayMember="CompanyName"
                          AutoPopulateColumns="False"
                          VerticalAlignment="Center"
                          SelectedIndexChanged="lookupCompany_SelectedIndexChanged"          
                          >
                                <dxg:LookUpEdit.StyleSettings>
                                    <dxg:LookUpEditStyleSettings />
                                </dxg:LookUpEdit.StyleSettings>
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>

                                            <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                                                <dxg:GridControl.View>
                                                    <dxg:TableView Name="tableView1"
                                     ShowAutoFilterRow="True" />
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                                <dxg:GridColumn FieldName="CompanyName"
                                    IsSmart="True" />

                                                <dxg:GridColumn x:Name="colBizType"
                                    FieldName="BizType"
                                    Visible="False"
                                    IsSmart="True" />
                                                <dxg:GridColumn FieldName="EmployeerNo"
                                    x:Name="colEmployeerNo"
                                    IsSmart="True"
                                    Visible="False" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>
                            <TextBlock Grid.Column="0" Grid.Row="2" Text="Department" Margin="5" FontWeight="DemiBold"/>
                            <dxg:LookUpEdit x:Name="lookupDepartment"
                                    Grid.Column="1" 
                                    Grid.Row="2" 
                                    Margin="5" 
                                    VerticalAlignment="Center"
                                    AutoPopulateColumns="True"
                                    DisplayMember="DeptName" SelectedIndexChanged="lookupDepartment_SelectedIndexChanged">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <dxg:GridControl Name="PART_GridControl"
                                   AutoPopulateColumns="True"
                                   Grid.Row="1">
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView Name="treeListView1"
                                        ShowAutoFilterRow="True"
                                        TreeDerivationMode="Selfreference"
                                        KeyFieldName="Id"
                                        ParentFieldName="ParentID" />
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn FieldName="Id"
                                    x:Name="coldeptid"
                                    IsSmart="True"
                                    Visible="False" />
                                                <dxg:GridColumn x:Name="coldeptname"
                                    FieldName="DeptName"
                                    IsSmart="True" />
                                                <dxg:GridColumn x:Name="coldeptcode"
                                    FieldName="Code"
                                    IsSmart="True" />
                                                <dxg:GridColumn FieldName="Abbrivation"
                                    IsSmart="True"
                                    x:Name="coldeptabr"
                                    Visible="True" />
                                                <dxg:GridColumn FieldName="Timestamp"
                                    IsSmart="True"
                                    x:Name="coldeptts"
                                    Visible="False" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>

                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Creation Date" Margin="5" FontWeight="DemiBold"/>
                            <dxe:DateEdit x:Name="datCreationDate" Grid.Column="1"  Grid.Row="0" Margin="5" />
                            <TextBlock Grid.Column="2" Grid.Row="2" Text="From" Margin="5" FontWeight="DemiBold"/>
                            <dxe:DateEdit x:Name="datFrom" Grid.Column="3"  Grid.Row="2" Margin="5" />
                            <TextBlock Grid.Column="2" Grid.Row="3" Text="To" Margin="5" FontWeight="DemiBold"/>
                            <dxe:DateEdit x:Name="datTo" Grid.Column="3"  Grid.Row="3" Margin="5"  />
                            <TextBlock Grid.Column="2" Grid.Row="4" Text="Budget Month" Margin="5" FontWeight="DemiBold"/>
                            <dxe:DateEdit x:Name="budgetMonth"
                                          Visibility="Visible"
                                          MaskType="DateTime"
                                 
                                          MaskUseAsDisplayFormat="True"
                                          Mask="MMMyyyy" 
                                          ShowClearButton="True"
                                          UseLayoutRounding="True" 
                                          PopupFooterButtons="OkCancel" 
                                          Grid.Column="3"  Grid.Row="4" Margin="5" 
                                         
                                          NullText="Month"
                                          VerticalAlignment="Center"  >
                                <dxe:DateEdit.StyleSettings>
                                    <dxe:DateEditPickerStyleSettings/>
                                </dxe:DateEdit.StyleSettings>
                            </dxe:DateEdit>
