<dx:DXWindow  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Procurementss.Budget.frmBudgetCostSheetFieldAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Budget" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
           Height="275"
              WindowStartupLocation="CenterScreen"
             Width="400" Title=" Budget Cost Sheet Field" x:Name="winBudgetCostSheetFieldAdd" 
        Loaded="winBudgetCostSheetFieldAdd_Loaded" Closing="winBudgetCostSheetFieldAdd_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=" auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height=" auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height=" 50" />
            </Grid.RowDefinitions>
            <Label Content="Field Title"
           ToolTip="Cost Sheet Field"
           HorizontalAlignment="Right" />
            <TextBox x:Name="txtcostSheetField"
             Grid.Column="1"    Margin="10,0"
             VerticalAlignment="Center" />

            <Label Content="Hierarchical Index"
           ToolTip="Select Unique Hierarchical Index(Higher index# means higher priority level)"
           HorizontalAlignment="Right"
           Grid.Row="1" />
            <dxe:SpinEdit x:Name="spnHierarchicalIndex"
                Margin="10,0"
                MinValue="1"
                      
                      MaxValue="100"
                VerticalAlignment="Center"
                Grid.Column="1"
                Grid.Row="1" />
            <Label Content="isActive"
           ToolTip="Unselect to make it inActive"
           HorizontalAlignment="Right"
           Grid.Row="2" />
            <CheckBox x:Name="chkisactive"
                Margin="10,0"
                IsChecked="True"
              VerticalAlignment="Center"
                Grid.Column="1"
                Grid.Row="2" />
            <Label Content="isIncome"
           HorizontalAlignment="Right"
           Grid.Row="3" />
            <CheckBox x:Name="chkisIncome"
                Margin="10,0"
                IsChecked="True"
              VerticalAlignment="Center"
                Grid.Column="1"
                Grid.Row="3" />
            <Label Content="isExpense"
           HorizontalAlignment="Right"
           Grid.Row="4" />
            <CheckBox x:Name="chkisExpense"
                Margin="10,0"
                IsChecked="True"
              VerticalAlignment="Center"
                Grid.Column="1"
                Grid.Row="4" />
            <Label Content="isCGS"
           HorizontalAlignment="Right"
           Grid.Row="5" />
            <CheckBox x:Name="chkisCGS"
                Margin="10,0"
                IsChecked="True"
              VerticalAlignment="Center"
                Grid.Column="1"
                Grid.Row="5" />



        </Grid>
        <Button Grid.ColumnSpan="2"
            Grid.Row="6"
            Content="Save"
            FontSize="26"
            x:Name="btncostSheetFieldSave"
            Click="btncostSheetFieldSave_Click" />
    </Grid>
</dx:DXWindow>
