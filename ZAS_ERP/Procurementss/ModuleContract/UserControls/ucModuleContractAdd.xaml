                        <StackPanel Orientation="Horizontal" Height="20" >
                            <dx:SimpleButton Height="16" ToolTip="Oldest" Margin="2,2,2,2"  HorizontalAlignment="Stretch" x:Name="btnOldestComment" Click="BtnOldestComment_Click" >
                                <Image Source="/ZAS_ERP;component/images/Latest.png" RenderTransformOrigin="0.5,0.5" >
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="-179.721"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </dx:SimpleButton>

                            <dx:SimpleButton Height="16" ToolTip="Previous" HorizontalAlignment="Stretch"  x:Name="btnPreviousComment" Click="BtnPreviousComment_Click">
                                <Image Source="/ZAS_ERP;component/images/FArrow.png" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="-179.621"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </dx:SimpleButton>


                            <dx:SimpleButton Height="16"  ToolTip="Next" HorizontalAlignment="Stretch"  x:Name="btnNextComment" Click="BtnNextComment_Click">
                                <Image Source="/ZAS_ERP;component/images/FArrow.png" />
                            </dx:SimpleButton>


                            <dx:SimpleButton Height="16" Margin="2,2,2,2" ToolTip="Latest" HorizontalAlignment="Stretch" x:Name="btnLatestComment" Click="BtnLatestComment_Click">
                                <Image Source="/ZAS_ERP;component/images/Latest.png" />
                            </dx:SimpleButton>

                        </StackPanel>
                    </dx:DXTabItem.Header>
                    <dxlc:LayoutGroup>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>

                            </Grid.RowDefinitions>


                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Sender" Grid.Column="0"/>
                                <TextBox Grid.Column="1" Margin="5,5,5,5" Grid.Row="2" TabIndex="45"  TextWrapping="WrapWithOverflow"  VerticalAlignment="Stretch" x:Name="txtSenderName" IsReadOnly="True" />
                                <Label Content="Date" Grid.Column="2"/>
                                <dxe:DateEdit  Grid.Column="3" x:Name="dteCommit" IsReadOnly="True" IsEnabled="False"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>
                                <Label Content="Subject" Grid.Column="0"/>
                                <TextBox Grid.Column="1"  TabIndex="45" Margin="5,5,5,5" TextWrapping="WrapWithOverflow"  VerticalAlignment="Stretch" x:Name="txtSubject" IsReadOnly="True"  />

                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>
                                <Label Content="Comment" Grid.Column="0"/>

                                <TextBox Grid.Column="1" TabIndex="45" Margin="5,5,5,5"  TextWrapping="WrapWithOverflow" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Visible" MaxHeight="40"  VerticalAlignment="Stretch" x:Name="txtCommentss" IsReadOnly="True"  />

                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>
                                <Label Content="Tagged" Grid.Column="0"/>
                                <TextBox Grid.Column="1" TabIndex="45" Margin="5,5,5,5"  TextWrapping="WrapWithOverflow"  VerticalAlignment="Stretch" x:Name="txtTagged" IsReadOnly="True"  />
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>
                                <Label Content="CC" Grid.Column="0"/>
                                <TextBox Grid.Column="1" TabIndex="45"  TextWrapping="WrapWithOverflow"  VerticalAlignment="Stretch" x:Name="txtCC" IsReadOnly="True" Margin="5,5,5,5"  />

                            </Grid>

                        </Grid>

                    </dxlc:LayoutGroup>
                </dx:DXTabItem>

            </dx:DXTabControl>


            <Button x:Name="btniquiryadd"
              Grid.Row="6"
              Grid.ColumnSpan="5"
              TabIndex="41"
              Content="Save ModuleContract"
              Click="btnModuleContractSave_Click"></Button>
        </Grid>
        <TextBlock x:Name="labeltopStatus"
               Text="Status"
               FontSize="64"
               MinWidth="600"
               MaxWidth="200"
               HorizontalAlignment="Stretch"
               TextAlignment="Center"
               VerticalAlignment="Stretch"
               Margin="153,396,189,-29"
               Visibility="Hidden">
            <TextBlock.RenderTransform>
                <RotateTransform Angle="-30" />
            </TextBlock.RenderTransform></TextBlock>
        <Grid Panel.ZIndex="5" x:Name="grdVoid" Visibility="Collapsed" 
              VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <!--<TextBox  Width="250"  VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="SearchTermTextBox" Margin="5"/>-->
            <TextBlock IsHitTestVisible="False" x:Name="txtVoid" 
                       Text="-VOID-" FontSize="200" 
                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" Foreground="Chocolate" Opacity="0.3">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTermTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.RenderTransform>

                    <RotateTransform CenterX="0" CenterY="0" Angle="-45" />

                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
        <Grid Name="grdProgressBar" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Height="100" Width="300" Background="LightGray">
            <ProgressBar x:Name="pbarDownloading" Grid.ColumnSpan="2" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center"  Minimum="0" Maximum="100" Height="25" Width="280" Foreground="LightGreen"/>
            <Label Content="Downloading..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Blue"/>
        </Grid>
    </Grid>
</UserControl>
