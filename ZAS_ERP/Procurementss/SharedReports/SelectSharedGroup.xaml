<dx:DXWindow xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" 
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Procurementss.SharedReports.SelectSharedGroup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SharedReports"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        Title="SelectSharedGroup" Icon="{dx:DXImage Image=Report_16x16.png}"  Height="200" Width="400" Loaded="DXWindow_Loaded">
    <Grid Margin="0,20,0,0">
       
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=" auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height=" auto" />
        </Grid.RowDefinitions>
        
        
        
        <!--<Label Content="Report Group Name"
           ToolTip="Report Group Name"
           HorizontalAlignment="Right" />
        <TextBox x:Name="txtreportGroup"
             Grid.Column="1"
             VerticalAlignment="Center" />-->


        <dxlc:LayoutGroup Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical">

            <dxlc:LayoutItem Label="Report Name" Margin="10,10,10,10">
                <dxe:TextEdit x:Name="txtReportName"  Margin="10,5"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Report Group" Margin="10,10,10,10">
                <dxg:LookUpEdit x:Name="lookupGroup"
                    Grid.Column="1"
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Margin="10,5"
                    DisplayMember="groupName"            
                    AutoPopulateColumns="False"            
                    TabIndex="3">
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>

                                <dxg:GridControl Name="PART_GridControl"
                             AutoPopulateColumns="False"
                             Grid.Row="1">
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView Name="treeListView1"
                                  ShowAutoFilterRow="False"
                                  AutoPopulateServiceColumns="False"                        
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                                          
                                  ParentFieldName="parentId"
                                  />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="groupName"
                              IsSmart="True"
                              Width="auto"
                              Visible="True"/>
                                 
                                </dxg:GridControl>
                            </Grid>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <Button Grid.ColumnSpan="2"
            Grid.Row="5"
            Content="Save"
            FontSize="26"
            x:Name="btnreportGroupSave"
            Click="btnreportGroupSave_Click" />

    </Grid>
</dx:DXWindow>
