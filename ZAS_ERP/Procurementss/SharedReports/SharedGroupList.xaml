<dx:ThemedWindow
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Procurementss.SharedReports.SharedGroupList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SharedReports"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    mc:Ignorable="d"
        Title="Shared Group List" Height="450" Width="800" Icon="{dx:DXImage Image=Team_16x16.png}" Loaded="ThemedWindow_Loaded">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <!--<ColumnDefinition Width=".7*" />
        <ColumnDefinition Width="auto" />-->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="1.4*" />

            </Grid.RowDefinitions>
            <dxr:RibbonControl RibbonTitleBarVisibility="Collapsed"
                        RibbonStyle="OfficeSlim"
                               Grid.ColumnSpan="2"
                            ToolbarShowMode="Hide"  
                        ShowApplicationButton="False" 
                        MinimizationButtonVisibility="Visible" PageCategoryAlignment="Left"
                               >
                <dxr:RibbonDefaultPageCategory Caption="{x:Null}">
                    <dxr:RibbonPage Caption="Exchange Rates">
                        <dxr:RibbonPageGroup Caption="{x:Null}" ShowCaptionButton="False"  >
                            <dxb:BarButtonItem x:Name="barNewGroup" Content="New" ItemClick="BarNewGroup_ItemClick" Glyph="{dx:DXImageGrayscale Image=Add_32x32.png}"/>
                            <dxb:BarButtonItem x:Name="barEditGroup" Content="Edit" ItemClick="BarEditGroup_ItemClick" Glyph="{dx:DXImageGrayscale Image=Edit_32x32.png}" />
                            <dxb:BarButtonItem x:Name="barRefreshRates" Content="Refresh" ItemClick="BarRefreshRates_ItemClick" Glyph="{dx:DXImageGrayscale Image=Refresh_32x32.png}" />
                            <dxb:BarButtonItem x:Name="barByPassGroups" Content="Bypass Permission" ItemClick="BarByPassGroups_ItemClick" Glyph="{dx:DXImageGrayscale Image=Refresh_32x32.png}" />
                        </dxr:RibbonPageGroup>
                    </dxr:RibbonPage>
                </dxr:RibbonDefaultPageCategory>
            </dxr:RibbonControl>

            <Grid  Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="lblHeading" Text="Shared Groups Register"    
                   FontWeight="Bold"  
                  
                   FontStyle="Italic"                
                   Grid.ColumnSpan="3" FontSize="22"   
                   HorizontalAlignment="Center" Grid.Row="0" FontFamily="Segoe UI Semibold"  ></TextBlock>
                <dxg:GridControl x:Name="grdSahredGroups"
                       AutoGenerateColumns="None"
                     Grid.Row="1"
                                 MaxHeight="10000"
                       SelectionMode="Row"
                       SelectionChanged="GrdSahredGroups_SelectionChanged"          
                       MouseDoubleClick="GrdSahredGroups_MouseDoubleClick"
                       >
                    <dxg:GridControl.View>
                        <dxg:TreeListView Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                    </dxg:GridControl.View>
                    <dxg:GridColumn FieldName="Id"
                                        x:Name="Id"
                                        IsSmart="True"      
                                        Header="Id"
                                        VisibleIndex="1"   
                                        ReadOnly="True"
                                    
                                Visible="False"
                                        AllowMoving="false"  
                                        AllowSorting="false"            
                                        SortOrder="Ascending" SortIndex="0"/>
                    <dxg:GridColumn FieldName="groupName"
                                        x:Name="groupName"
                                        IsSmart="True"
                                        Header="Group Name"                            
                                        VisibleIndex="2"   
                                        AllowSorting="false" 
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        />
                    <dxg:GridColumn FieldName="isVoid"
                                        x:Name="isVoid"
                                        IsSmart="True"
                                        Header="isVoid"
                                        VisibleIndex="7"  
                                        AllowMoving="false"  
                                        ReadOnly="True"
                                        Visible="True"
                                        AllowSorting="false" 
                                        >

                    </dxg:GridColumn>

                </dxg:GridControl>
            </Grid>
            <dxdo:DockLayoutManager Grid.Row="1"  Grid.Column="1">
                <dxdo:LayoutGroup Caption="LayoutRoot" AllowMove="False" AllowDock="False" AllowFloat="False" AllowDrag="False" AllowDrop="False"  ShowCloseButton="False">
                    <dxdo:TabbedGroup >
                        <dxdo:LayoutPanel Caption="Companies" AllowMove="False"  AllowDock="False" AllowDrag="False" AllowDrop="False" AllowFloat="False" FontWeight="DemiBold" ShowCloseButton="False">
                            <dxg:GridControl x:Name="grdCompany"
                                     Grid.Column="0"
                                     Grid.Row="0"
                                     MaxHeight="1000"        
                                     SelectionMode="MultipleRow"
                                     AllowInitiallyFocusedRow="False"
                                     >
                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="viewTable"
                              
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"            
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">

                                    </dxg:TreeListView>

                                </dxg:GridControl.View>
                                <dxg:GridColumn Header="Id"
                            VisibleIndex="0"
                            FieldName="Id"
                          Visible="False"
                            />
                                <dxg:GridColumn Header="Company Name"
                            VisibleIndex="1"
                            FieldName="CompanyName"
                            IsSmart="True"
                            />

                                <dxg:GridColumn VisibleIndex="2"
                                Header="Industry Type"
                                FieldName="industryType.name"
                                IsSmart="True" />
                            </dxg:GridControl>
                        </dxdo:LayoutPanel>
                        <dxdo:LayoutPanel Caption="Departments" AllowMove="False"  AllowDock="False" AllowDrag="False" AllowDrop="False" AllowFloat="False" FontWeight="DemiBold" ShowCloseButton="False">
                            <dxg:GridControl x:Name="grdDepartment"   
                                 Grid.Column="1"
                                 Grid.Row="0" 
                                             MaxHeight="1000"
                                 SelectionMode="MultipleRow"
                                 AllowInitiallyFocusedRow="False">
                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="viewTableDepartment"
                               AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"            
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">
                                    </dxg:TreeListView>
                                </dxg:GridControl.View>
                                <dxg:GridColumn Header="Id"
                            VisibleIndex="2"
                            FieldName="Id"
                            IsSmart="True"
                            Visible="False"
                            Width="auto" />
                                <dxg:GridColumn Header="Department Name"
                            VisibleIndex="1"
                            FieldName="DeptName"
                            IsSmart="True"
                             />
                                <dxg:GridColumn Header="Code"
                            VisibleIndex="2"
                            FieldName="Code"
                            IsSmart="True"
                            />
                            </dxg:GridControl>
                        </dxdo:LayoutPanel>
                        <dxdo:LayoutPanel Caption="Employees" AllowMove="False"  AllowDock="False" AllowDrag="False" AllowDrop="False" AllowFloat="False" FontWeight="DemiBold">
                            <dxg:GridControl x:Name="grdEmployee"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                             MaxHeight="1000"
                                             
                                     Grid.Row="1"
                                     SelectionMode="Row"
                                      AllowInitiallyFocusedRow="False"
                                     >
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="viewTableEmployee"
                               AutoWidth="True"
                                 
                              
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">
                                    </dxg:TableView>

                                </dxg:GridControl.View>
                                <dxg:GridColumn x:Name="EmpId"
                                    FieldName="EmpId"
                                    IsSmart="True"
                                    Visible="False" />
                                <dxg:GridColumn FieldName="person.Photo"
                                                VisibleIndex="0"
                                                    Header=" ">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ImageEditSettings/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="person.FName"
                                                  VisibleIndex="1"
                                                    Header="First Name"/>
                                <dxg:GridColumn FieldName="person.LName"
                                                  VisibleIndex="2"
                                                    Header="Last Name"/>
                            </dxg:GridControl>
                        </dxdo:LayoutPanel>
                    </dxdo:TabbedGroup>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </Grid>
    </Grid>
</dx:ThemedWindow>
