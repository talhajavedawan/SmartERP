<UserControl x:Class="ZAS_ERP.Procurementss.SharedReports.ucSharedCompDepUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SharedReports"
             xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <dxwui:PageAdornerControl FontWeight="DemiBold" Header="Select Company, Departments and Employees" Grid.Row="0">
        </dxwui:PageAdornerControl>
        <Border Grid.Row="1" Background="Salmon">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <dxg:GridControl x:Name="grdCompany"
                                     Grid.Column="0"
                                 Grid.Row="0"
                                 
                                     SelectionChanged="GrdCompany_SelectionChanged"
                                     SelectionMode="MultipleRow"
                                     AllowInitiallyFocusedRow="False"
                                     >
                    <dxg:GridControl.View>
                        <dxg:TreeListView x:Name="viewTable"
                              
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"            
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">

                        </dxg:TreeListView>

                    </dxg:GridControl.View>
                    <dxg:GridColumn Header="Id"
                            VisibleIndex="0"
                            FieldName="Id"
                          Visible="False"
                            />
                    <dxg:GridColumn Header="Company Name"
                            VisibleIndex="1"
                            FieldName="CompanyName"
                            IsSmart="True"
                            />

                    <dxg:GridColumn VisibleIndex="2"
                                Header="Industry Type"
                                FieldName="industryType.name"
                                IsSmart="True" />
                </dxg:GridControl>
                <dxg:GridControl x:Name="grdDepartment"   
                                 Grid.Column="1"
                                 Grid.Row="0"
                                 SelectionChanged="GrdDepartment_SelectionChanged"   
                                 SelectionMode="MultipleRow"
                                 AllowInitiallyFocusedRow="False">
                    <dxg:GridControl.View>
                        <dxg:TreeListView x:Name="viewTableDepartment"
                               AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"            
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">
                        </dxg:TreeListView>
                    </dxg:GridControl.View>
                    <dxg:GridColumn Header="Id"
                            VisibleIndex="2"
                            FieldName="Id"
                            IsSmart="True"
                            Visible="False"
                            Width="auto" />
                    <dxg:GridColumn Header="Department Name"
                            VisibleIndex="1"
                            FieldName="DeptName"
                            IsSmart="True"
                             />
                    <dxg:GridColumn Header="Code"
                            VisibleIndex="2"
                            FieldName="Code"
                            IsSmart="True"
                            />
                </dxg:GridControl>
                <dxg:GridControl x:Name="grdEmployee"
                                     SelectionChanged="GrdEmployee_SelectionChanged" 
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     Grid.Row="1"
                                 
                                
                                     SelectionMode="MultipleRow"
                                      AllowInitiallyFocusedRow="False"
                                     >
                    <dxg:GridControl.View>
                        <dxg:TreeListView x:Name="viewTableEmployee"
                               AutoWidth="True"
                                  KeyFieldName="Id"
                                     SearchPanelAllowFilter="False"
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"                  
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">

                        </dxg:TreeListView>

                    </dxg:GridControl.View>
           
                    <dxg:GridColumn x:Name="EmpId"
                                    FieldName="EmpId"
                                    IsSmart="True"
                                     VisibleIndex="1"
                                    Visible="False" />
                    <dxg:GridColumn FieldName="person.FName"
                                       VisibleIndex="2"
                                                    Header="First Name"/>
                    <dxg:GridColumn FieldName="person.LName"
                                                    Header="Last Name"/>
                </dxg:GridControl>
            </Grid>


        </Border>
    </Grid>
</UserControl>
