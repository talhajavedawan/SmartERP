<dx:ThemedWindow
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="ZAS_ERP.Procurementss.SharedReports.SharedGroupEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.SharedReports"
        xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    mc:Ignorable="d"
    Icon="{dx:DXImage Image=Team_16x16.png}"
        Title="Update Shared Group" Height="700" Width="800" Loaded="ThemedWindow_Loaded" WindowStartupLocation="CenterScreen" TitleAlignment="Center">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
       
        <dxwui:PageAdornerControl FontWeight="DemiBold" Header="Update Shared Group" Grid.Row="0">
        </dxwui:PageAdornerControl>
        <Grid Grid.Row="1"  Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="5,5,5,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content=" Group Name" VerticalAlignment="Center" Grid.Column="0"/>
                <dxe:TextEdit x:Name="txtGroupName"  Grid.Column="1"   Margin="5,5,5,5"/>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Parent Group"
                 Margin="5,5,5,5"
           HorizontalAlignment="Right"
           />
                <dxg:LookUpEdit x:Name="lookupGroup"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="10,5"
                    IsEnabled="False"            
                    PopupContentSelectionChanged="LookupGroup_PopupContentSelectionChanged"            
                  
                    TabIndex="3">
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>

                                <dxg:GridControl Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn x:Name="colId"
                              FieldName="Id"
                              Visible="False" />
                                    <dxg:GridColumn FieldName="group"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                    <dxg:GridColumn FieldName="userId"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                    <dxg:GridColumn FieldName="user"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                    <dxg:GridColumn FieldName="parent"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                </dxg:GridControl>
                            </Grid>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>
            </Grid>
            
        </Grid>
        <Border Grid.Row="2" Background="Salmon">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <dxg:GridControl x:Name="grdCompany"
                                     Grid.Column="0"
                                 Grid.Row="0"
                                
                                     SelectionChanged="GrdCompany_SelectionChanged"
                                     SelectionMode="MultipleRow"
                                     AllowInitiallyFocusedRow="False"
                                     >
                    <dxg:GridControl.View>
                        <dxg:TreeListView x:Name="viewTable"
                              
                                  AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"            
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">

                        </dxg:TreeListView>

                    </dxg:GridControl.View>
                    <dxg:GridColumn Header="Id"
                            VisibleIndex="0"
                            FieldName="Id"
                          Visible="False"
                            />
                    <dxg:GridColumn Header="Company Name"
                            VisibleIndex="1"
                            FieldName="CompanyName"
                            IsSmart="True"
                            />

                    <dxg:GridColumn VisibleIndex="2"
                                Header="Industry Type"
                                FieldName="industryType.name"
                                IsSmart="True" />
                </dxg:GridControl>
                <dxg:GridControl x:Name="grdDepartment"   
                                 Grid.Column="1"
                                 Grid.Row="0"
                                 SelectionChanged="GrdDepartment_SelectionChanged"   
                                 SelectionMode="MultipleRow"
                                 AllowInitiallyFocusedRow="False">
                    <dxg:GridControl.View>
                        <dxg:TreeListView x:Name="viewTableDepartment"
                               AutoWidth="True"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentID"            
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">
                        </dxg:TreeListView>
                    </dxg:GridControl.View>
                    <dxg:GridColumn Header="Id"
                            VisibleIndex="2"
                            FieldName="Id"
                            IsSmart="True"
                            Visible="False"
                            Width="auto" />
                    <dxg:GridColumn Header="Department Name"
                            VisibleIndex="1"
                            FieldName="DeptName"
                            IsSmart="True"
                             />
                    <dxg:GridColumn Header="Code"
                            VisibleIndex="2"
                            FieldName="Code"
                            IsSmart="True"
                            />
                </dxg:GridControl>
                <dxg:GridControl x:Name="grdEmployee"
                                     SelectionChanged="GrdEmployee_SelectionChanged" 
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     Grid.Row="1"
                                     SelectionMode="MultipleRow"
                                      AllowInitiallyFocusedRow="False"
                                     >
                    <dxg:GridControl.View>
                        <dxg:TreeListView x:Name="viewTableEmployee"
                               AutoWidth="True"
                                  KeyFieldName="Id"
                                       SearchPanelAllowFilter="True"
                                          
                                  TreeDerivationMode="Selfreference"
                                  AutoExpandAllNodes="True"
                                  IsSynchronizedWithCurrentItem="True"
                                  AllowEditing="False"
                                  ShowCheckboxes="True"                  
                                  UseIndicatorForSelection="True"
                                  FadeSelectionOnLostFocus="False"
                                  ShowSelectionRectangle="True">

                        </dxg:TreeListView>

                    </dxg:GridControl.View>
                   
                    <dxg:GridColumn x:Name="EmpId"
                                    FieldName="EmpId"
                                    IsSmart="True"
                                     VisibleIndex="1"
                                    Visible="False" />
                    <dxg:GridColumn FieldName="person.FName"
                                       VisibleIndex="2"
                                                    Header="First Name"/>
                    <dxg:GridColumn FieldName="person.LName"
                                                    Header="Last Name"/>
                    <dxg:GridColumn FieldName="empFunction.Title"
                                                    Header="Function"/>
                </dxg:GridControl>
            </Grid>


        </Border>
        <Button x:Name="btnSave" Content="Update Group" FontWeight="DemiBold" Grid.Column="1" Grid.Row="3" Click="BtnSave_Click"/>

    </Grid>
</dx:ThemedWindow>
