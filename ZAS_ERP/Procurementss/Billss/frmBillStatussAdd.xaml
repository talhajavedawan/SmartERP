<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Inquiriess"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="True"
        WindowStartupLocation="CenterOwner"
        x:Class="ZAS_ERP.Procurementss.Billss.frmBillStatussAdd"
             mc:Ignorable="d"
             Height="200"
             Width="350" Title="Vendor Bill Status" x:Name="winBillStatusAdd" 
        Loaded="winBillStatusAdd_Loaded" Closing="winBillStatusAdd_Closing">
  <Grid Margin="0,20,0,0">
    <Grid.Resources>
      <Style TargetType="{x:Type Label}">
        <Setter Property="Margin"
                Value="10,0" />
        <Setter Property="Foreground"
                Value="Gray" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
      </Style>
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Margin"
                Value="10,0" />
        <Setter Property="MaxWidth"
                Value="350" />
      </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width=" auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height=" auto" />
      <RowDefinition Height=" auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height=" 50" />
    </Grid.RowDefinitions>
    <Label Content="Status"
           ToolTip="Status Name"
           HorizontalAlignment="Right" />
    <Label Content="Active"
           ToolTip="Select if it is of active type"
           HorizontalAlignment="Right"
           Grid.Row="1" />  
      <Label Content="Disable"
           HorizontalAlignment="Right"
           Grid.Row="2" />
    <TextBox x:Name="txtStatus"
             Grid.Column="1" />
    <Grid Grid.Column="1" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto"></ColumnDefinition>
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <CheckBox x:Name="chkisactive"
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsChecked="True" />  
     
      <dxe:PopupColorEdit Margin="10"
                          HorizontalAlignment="Stretch"
                          ColorChanged="ColorEdit_ColorChanged"
                          Grid.Column="1"
                         
                          VerticalAlignment="Center"
                          x:Name="cpStatus" />
    </Grid>
        <CheckBox x:Name="chkDisable"
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                  Grid.Column="1"
                  Grid.Row="2"
                IsChecked="True" />
        <Button Grid.ColumnSpan="2"
            Grid.Row="3"
            Content="Save"
            FontSize="26"
            x:Name="btnStatusSave"
            Click="btnStatusSave_Click" />

  </Grid>
</Window>
