<UserControl x:Class="ZAS_ERP.Procurementss.Billss.UserControls.ucFrmVendorBillNatureAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Billss.UserControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <dx:DXTabControl>
            <dx:DXTabItem Header="Vendor Bill Nature" >
                <dxlc:LayoutGroup     
                    IsCollapsible="False" 
                    IsCollapsed="False" 
                    Orientation="Vertical">

                    <dxlc:LayoutControl Orientation="Vertical" VerticalAlignment="Center">
                        <!--<dxlc:LayoutItem Label="Company:" Width="270">
                            <dxg:LookUpEdit x:Name="lookupCompany"
                                    DisplayMember="CompanyName"
                                    Margin="10 0 0 0"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Height="10"/>-->
                        <dxlc:LayoutItem Label="Bill Nature:" Width="270">
                            <dxe:TextEdit Margin="5 0 0 0" x:Name="txtVendorBillNature"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Height="10"/>
                        <dxlc:LayoutItem Label="Is Active:" Width="270">
                            <dxe:CheckEdit Margin="16 0 0 0" x:Name="chkIsActive"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutControl>
                </dxlc:LayoutGroup>
            </dx:DXTabItem>

            <dx:DXTabItem Header="Companies">
                <dxg:GridControl x:Name="grdCntrlCompanies"
                                 AutoGenerateColumns="None"
                                 Grid.ColumnSpan="2"
                                 SelectionMode="MultipleRow"
                                 AllowInitiallyFocusedRow="False">
                    <dxg:GridControl.View>
                        <dxg:TreeListView x:Name="gridCompanyView"
                                          AutoWidth="True"
                                          KeyFieldName="Id"
                                          TreeDerivationMode="Selfreference"
                                          AutoExpandAllNodes="True"
                                          IsSynchronizedWithCurrentItem="True"
                                          AllowEditing="False"
                                          ShowCheckboxes="True"
                                          UseIndicatorForSelection="True"
                                          FadeSelectionOnLostFocus="False"
                                          ShowSelectionRectangle="True"       
                                          ShowAutoFilterRow="True">
                        </dxg:TreeListView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn FieldName="Id"
                                    x:Name="colCategoryId"
                                    IsSmart="True"
                                    Visible="False"/>

                    <dxg:GridColumn x:Name="colCompanyName"
                                    FieldName="CompanyName"
                                    Header="Company"
                                    IsSmart="True"/>
                </dxg:GridControl>
            </dx:DXTabItem>
        </dx:DXTabControl>
        <dx:SimpleButton Grid.Row="1" Content="Save" FontWeight="DemiBold" FontSize="18" x:Name="btnSave" Height="40" VerticalAlignment="Bottom" Click="BtnSave_Click"/>
    </Grid>
</UserControl>
