<dx:DXWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Procurementss.Inquiriess"
        xmlns:lox="clr-namespace:ZAS_ERP.Procurementss.Offerss"
        xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        utilities:WindowUtilities.CloseOnEscape="False"
        WindowStartupLocation="CenterScreen"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        x:Class="ZAS_ERP.Procurementss.frmProcurmentPanel"
        mc:Ignorable="d"
        MinHeight="700" 
        MinWidth="1100"
        Width="1000"
        Title="Procurment Panel"
        SizeChanged="winProcpanel_SizeChanged"        
        x:Name="winProcpanel"
        WindowState="Maximized"
        ShowActivated="True"
        Icon="/ZAS_ERP;component/images/mk logo new.png"
        Loaded="WinProcpanel_Loaded"
      
        Closing="winProcpanel_Closing">


    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="61*" />
            <ColumnDefinition Width="303*"/>
            <!--<ColumnDefinition Width="200" />-->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <!--Margin="150,-26,150,0"-->
        <Menu DockPanel.Dock="Top"  Grid.RowSpan="1" Grid.ColumnSpan="2" x:Name="mainMenu" Background="#bed6f6" >
            <Menu.Resources>
                <Style TargetType="Image">
                    <Setter Property="Margin" Value="-2.5"></Setter>
                </Style>
            </Menu.Resources>
            <MenuItem Header="New Transaction" >
                <MenuItem.Icon>
                    <Image  Source="/ZAS_ERP;component/images/transactionsAdd.png"/>
                </MenuItem.Icon>

                <MenuItem Header="_New Inquiry" x:Name="btnNewInquiry"
                  Click="btnNewInquiry_Click" >
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/new inquiry.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_New Offer"  x:Name="btnNewOffer"
                  Click="btnNewOffer_Click" >
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/offer.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_New Sale Order" x:Name="btnNewSO"
                  Click="BtnNewSO_Click">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/salesOrder.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_New Memorandum Sale" x:Name="btnNewMemorandumSale"
                  Click="BtnNewMemorandumSale_Click">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/document/docHistory.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!--<MenuItem Header="_New Purchase Order" x:Name="btnNewPO" 
                  Click="btnNewPO_Click">
                    <MenuItem.Icon>
                        <Image Source="/ZAS_ERP;component/images/purchaseorder.png"/>
                    </MenuItem.Icon>
                </MenuItem>-->

            </MenuItem>

            <MenuItem Header="_Create Offer" IsEnabled="False" x:Name="btnCreateOffer" Click="btnCreateOffer_Click" >
                <MenuItem.Icon>
                    <Image Source="/ZAS_ERP;component/images/offerAdd.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Create Module Contract" x:Name="btnCreateModuleContract" 
                  Click="btnCreateModuleContract_Click" IsEnabled="False"  >
                <MenuItem.Icon>
                    <Image Source="/ZAS_ERP;component/images/SalesOrder.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Create SaleOrder" x:Name="btnCreateSO"
                  Click="btnCreateSO_Click" IsEnabled="False"  >
                <MenuItem.Icon>
                    <Image Source="/ZAS_ERP;component/images/SalesOrder.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Create Invoice" x:Name="btnNewInvoice" 
                  Click="btnCreateSaleinvoice_Click" IsEnabled="False" >
                <MenuItem.Icon>
                    <Image Source="/ZAS_ERP;component/images/createinvoice.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Create Memorandum Sale" x:Name="btnCreateMemorandumSale" IsEnabled="False"
                  Click="BtnCreateMemorandumSale_Click"  >
                <MenuItem.Icon>
                    <Image Source="/ZAS_ERP;component/images/document/docAdd.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Create Purchase Order" x:Name="btnCreatePO"
                  Click="btnCreatePO_Click" IsEnabled="False"
                      >
                <MenuItem.Icon>
                    <Image  Source="/ZAS_ERP;component/images/purchaseOrder.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Create Bill" x:Name="btnCreateBill"
                  Click="btnCreateBill_Click" IsEnabled="False"
                      >
                <MenuItem.Icon>
                    <Image  Source="/ZAS_ERP;component/images/purchaseOrder.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Create Sale Recipt" x:Name="btnCreateReciept"
                  Click="btnCreateReciept_Click" IsEnabled="False"
                      >
                <MenuItem.Icon>
                    <Image  Source="/ZAS_ERP;component/images/purchaseOrder.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Create Report Layout" 
                      >


                <MenuItem.Icon>
                    <Image  Source="/ZAS_ERP;component/images/purchaseOrder.png"/>
                </MenuItem.Icon>

                <MenuItem x:Name="btnCreateReportLayout" Header="Purchase Order Report"
                  Click="BtnCreateReportLayout_Click" IsEnabled="True" />

                <MenuItem Header="Create Delivery Note" x:Name="btnCreateDNReportLayout"
                  Click="BtnCreateDNReportLayout_Click" IsEnabled="False"  
                      />
                <MenuItem Header="Create Tax Report" x:Name="btnCreateSITaxReport" IsEnabled="False"
                          Click="BtnCreateSITaxReport_Click"/>
                <MenuItem Header="Create Commission Report" x:Name="btnCreateCommissionSIReport" Visibility="Collapsed"
                          Click="BtnCreateCommissionSIReport_Click"/>
                <MenuItem Header="Test Click ABT UK"
                  Click="MenuItem_Click" IsEnabled="True" Visibility="Collapsed" />

            </MenuItem>

            <MenuItem Header="Create JV" x:Name="btnCreateJV"
                  Click="BtnCreateJV_Click" IsEnabled="True" 
                      >
                <MenuItem.Icon>
                    <Image Source="/ZAS_ERP;component/images/SalesOrder.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Create Purchase Invoice" x:Name="btnCreatePurchaseInvoice"
                  Click="BtnCreatePurchaseInvoice_Click" IsEnabled="True" 
                      >
                <MenuItem.Icon>
                    <Image Source="/ZAS_ERP;component/images/createinvoice.png"/>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Create Payment" x:Name="btnCreatePayment"
                  Click="BtnCreatePayment_Click" IsEnabled="True" 
                      >
                <MenuItem.Icon>
                    <Image Source="/ZAS_ERP;component/images/purchaseOrder.png"/>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Create Task" x:Name="btnCreateTask"
                  Click="BtnCreateTask_Click" IsEnabled="True">
                <MenuItem.Icon>
                    <Image Source="{dx:DXImage Image=Task_32x32.png}"/>
                </MenuItem.Icon>
            </MenuItem>


            <MenuItem Header="Link IBT" x:Name="btnLinkIBT" Visibility="Collapsed"
                  Click="BtnLinkIBT_Click" IsEnabled="True" 
                      >
                <MenuItem.Icon>
                    <Image Source="/ZAS_ERP;component/images/purchaseOrder.png"/>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Create Loan" x:Name="btnCreateLoan" Visibility="Collapsed"
                  Click="btnCreateLoan_Click" IsEnabled="True">
                <MenuItem.Icon>
                    <Image Source="/ZAS_ERP;component/images/purchaseOrder.png"/>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Create Advance" x:Name="btnCreateAdvance" Visibility="Collapsed"
                  Click="btnCreateAdvance_Click" IsEnabled="True">
                <MenuItem.Icon>
                    <Image Source="/ZAS_ERP;component/images/purchaseOrder.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </Menu>
