                                     SelectionMode="Row" AutoExpandAllGroups="True" IsRecursiveExpand="True" AllowInitiallyFocusedRow="False" Margin="0,0,0,0.4">

                        <dxg:GridControl.View>

                            <dxg:CardView ShowTotalSummary="False"
                                          ShowGroupPanel="False"
                                           x:Name="viewTransactions"                                         
                                          
                                          AllowEditing="False"
                                          AllowGrouping="False" CardLayout="Columns"    ScrollingMode="Normal" >
                                <dxg:CardView.CardHeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                   <Run Text="{Binding Data.TransactionType}" /></TextBlock>
                                    </DataTemplate>
                                </dxg:CardView.CardHeaderTemplate>



