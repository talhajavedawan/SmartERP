        mc:Ignorable="d"
        Title="Modules Merging Engine" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
       
            
        <dx:DXTabControl SelectedIndex="0" >
            <dx:DXTabControl.View>
                <dx:TabControlStretchView/>
            </dx:DXTabControl.View>
            <dx:DXTabItem x:Name="tabTransactions" Header="Transactions">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="173*"/>
                        <ColumnDefinition Width="595*"/>
                    </Grid.ColumnDefinitions>
                    <dxg:GridControl x:Name="grdTransactionListing"
                                     AutoGenerateColumns="None"
                                     MouseDoubleClick="GrdTransactionListing_MouseDoubleClick"
                                     Grid.ColumnSpan="2"
