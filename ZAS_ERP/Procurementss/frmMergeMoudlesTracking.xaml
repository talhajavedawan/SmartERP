                                        IsSmart="True"  MergeWithPreviousGroup="True" HorizontalHeaderContentAlignment="Stretch" ShowInColumnChooser="False" VisibleIndex="-1" Visible="False"
                                        
                                         />
                        
                        
                    </dxg:GridControl>
                </Grid>
            </dx:DXTabItem>
            <dx:DXTabItem  x:Name="tabMergeCostSheet" Header="Merge Cost-Sheets" >
                <Grid x:Name="gridMergeCostSheet">
                    
