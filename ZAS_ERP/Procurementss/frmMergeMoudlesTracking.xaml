                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PART_Editor"><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor1"
                          Width="20"
                          Margin="10,0"
                          Background="{Binding RowData.Row.BackColor}"
                           />
                  </InlineUIContainer><Run Text=" "/><InlineUIContainer>
                      <TextBlock x:Name="PART_Editor2"
                          Text="{Binding RowData.Row.Status}"/>
                  </InlineUIContainer></TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Id"
                                        IsSmart="True"
                                        
                                        Visible="False" ShowInColumnChooser="False"
                                        SortIndex="0" />
                        <dxg:GridColumn FieldName="Customer"
                                        IsSmart="True"
                                        
                                        VisibleIndex="1"
                                       />
                        <dxg:GridColumn FieldName="Company"
                                        IsSmart="True"
                                        Header="Company"
                                        VisibleIndex="2"
                                         />
                        <dxg:GridColumn FieldName="Department"
                                        IsSmart="True"
                                        x:Name="colDepartment"
                                        
                                        Width="auto" />
                        <dxg:GridColumn FieldName="SalesReferenceNo"
                                        IsSmart="True"
                                        x:Name="colcontactno"
                                        
                                        Header="Sales Ref#"
                                        Width="auto" />
                        <dxg:GridColumn FieldName="SyetmReferenceNo"
                                        IsSmart="True"
                                        x:Name="SyetmReferenceNo"
                                        Header="Syetem Ref#"
                                        Width="auto" />
