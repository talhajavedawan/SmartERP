<dx:ThemedWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Productss"
        xmlns:Validations="clr-namespace:ZAS_ERP.Validations"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        x:Class="ZAS_ERP.Productss.frmItemadd"
        utilities:WindowUtilities.CloseOnEscape="True"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="Add Item"
        Height="600"
        
        Width="800" Loaded="winItemAdd_Loaded"
        x:Name="winItemAdd" Closing="winItemAdd_Closing">
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="b2v"/>

          
        </Grid.Resources>
       
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <dx:DXTabControl >
            <dx:DXTabControl.View>
                <dx:TabControlScrollView/>
            </dx:DXTabControl.View>
            <dx:DXTabItem Header="Item Details"  BorderThickness="8" BorderColor="Black" Glyph="{dx:DXImage Image=BO_Order_Item.png}">
                <dxlc:LayoutGroup Header="Item Details"   View="Group" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>


                        </Grid.RowDefinitions>
                        <dxlc:LayoutItem Label="Item Code" Grid.Row="0" LabelPosition="Left">
                            <TextBox  x:Name="txtItemCode" Height="26" VerticalContentAlignment="Center" Margin="32,0,0,0"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Item Name" Grid.Row="0" Grid.Column="2" LabelPosition="Left">
                            <TextBox  Margin="32,0,0,0"
           TextChanged="TxtItemName_TextChanged"
                                      VerticalContentAlignment="Center"
                        Height="26"              
             x:Name="txtItemName" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Item Description" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" LabelPosition="Left">
                            <TextBox   VerticalAlignment="Center" Height="26" VerticalContentAlignment="Center"
             x:Name="txtItemDiscription" />
                        </dxlc:LayoutItem>

                        <dxlc:LayoutItem Label="Unit Of Measure" Grid.Column="2" Grid.Row="1" LabelPosition="Left">
                            <ComboBox 
              VerticalAlignment="Center"
              Grid.Column="1"
              Grid.Row="3"
              Height="26"                  
              x:Name="cmbUnitOfMeasure"
                                VerticalContentAlignment="Center"
              Margin="5,5"
              SelectionChanged="cmbUnitOfMeasure_SelectionChanged"
              TabIndex="4"
              DisplayMemberPath="{Binding name}"
      >

                                <!--<ComboBoxItem>
        <Button Content="Add New"
                Foreground="BlueViolet" Height="20"></Button>
      </ComboBoxItem>-->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>



                                        <StackPanel  Orientation="Horizontal">
                                            <TextBlock Text="{Binding id}"
                       Visibility="Hidden" />
                                            <TextBlock Text="{Binding name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Item's Nature" Grid.Column="0" Grid.Row="2" LabelPosition="Left">
                            <ComboBox VerticalAlignment="Center"
             Height="26"
                                      VerticalContentAlignment="Center"
              x:Name="cmbItemNature"
             Margin="17,0,0,0"
              SelectionChanged="cmbItemNature_SelectionChanged"
              TabIndex="4"
              DisplayMemberPath="{Binding name}">

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel  Orientation="Horizontal">
                                            <TextBlock Text="{Binding id}"
                       Visibility="Hidden" />
                                            <TextBlock Text="{Binding name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </dxlc:LayoutItem>

                        <dxlc:LayoutItem Label="Category" Grid.Column="2" Grid.Row="2" LabelPosition="Left">
                            <dxg:LookUpEdit x:Name="lookupCategory"
                    Grid.Column="1"
                    Grid.Row="5"
                             Height="26"     
                                            VerticalContentAlignment="Center"
                                            Margin="44,0,0,0"
                    VerticalAlignment="Center"
                    
                  SelectedIndexChanged="lookupCategory_SelectedIndexChanged"
                    TabIndex="3">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Button x:Name="btnAddCategory"
                    Click="btnAddCategory_Click"
                    VerticalAlignment="Center"
                    Content="--Add New--" Foreground="BlueViolet" />
                                            <dxg:GridControl x:Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView x:Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId" />
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn x:Name="colId"
                              FieldName="Id"
                              
                              Visible="False" />
                                                <dxg:GridColumn FieldName="category"
                              IsSmart="True"
                              Width="auto" />
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Item type" Grid.Column="0" Grid.Row="3" LabelPosition="Left">
                            <ComboBox 
                Margin="38,5,0,0"   
              x:Name="cmbItemType"
             Height="26"
                                VerticalContentAlignment="Center"
              SelectionChanged="CmbItemType_SelectionChanged"
              TabIndex="4"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Parent Product" Grid.Column="2" Grid.Row="3" LabelPosition="Left">
                            <dxg:LookUpEdit x:Name="lookupParentProduct"
                    Grid.Row="11"
                         Height="26"                  
                        Grid.Column="1"
                        Visibility="{Binding IsChecked, Converter={StaticResource b2v}, ElementName=isSubProduct}"    
                        Margin="14,5,0,0"   
                        
                    DisplayMember="item"
                    SelectedIndexChanged="LookupParentProduct_SelectedIndexChanged">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <dxg:GridControl x:Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView x:Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn FieldName="item"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="isActive" Grid.Row="4" Grid.Column="0" LabelPosition="Left">
                            <CheckBox Grid.Column="1" 
             Grid.Row="6" x:Name="chkIsActive" IsChecked="True"
             VerticalAlignment="Center" Margin="10,5"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="isTitle" Grid.Row="5" Grid.Column="0" LabelPosition="Left">
                            <CheckBox Grid.Column="1" 
             Grid.Row="6" x:Name="chkIsTitle" 
                                      Checked="chkIsTitle_Checked"
                                      Unchecked="chkIsTitle_Unchecked"
             VerticalAlignment="Center" Margin="20,5"/>
                        </dxlc:LayoutItem>

                        <dxlc:LayoutItem Label="Company" Grid.Column="2" Grid.Row="4" 
                                         LabelPosition="Left"
                                    
                                         >
                            <dxg:LookUpEdit x:Name="lookupCompany"
                          Margin="41,5,0,0"
                          Height="26"
                          DisplayMember="CompanyName"
                          AutoPopulateColumns="False"
                          VerticalAlignment="Center"
                          SelectedIndexChanged="lookupCompany_SelectedIndexChanged">
                                <dxg:LookUpEdit.StyleSettings>
                                    <dxg:LookUpEditStyleSettings />
                                </dxg:LookUpEdit.StyleSettings>
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <!--<Button x:Name="btnAddCompany"
                            Click="btnAddCompany_Click"
                            VerticalAlignment="Center"
                            Content="Add New" />-->
                                            <dxg:GridControl Name="PART_GridControl"
                                   Grid.Row="1"
                                   AutoGenerateColumns="None">
                                                <dxg:GridControl.View>
                                                    <dxg:TableView Name="tableView1"
                                     ShowAutoFilterRow="True" />
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn FieldName="Id"
                                    IsSmart="True"
                                    Visible="False" />
                                                <dxg:GridColumn FieldName="CompanyName"
                                    IsSmart="True" />
                                                <!--<dxg:GridColumn FieldName="IndustryType"
                                      IsSmart="True"
                                      Visible="False" />-->
                                                <dxg:GridColumn x:Name="colBizType"
                                    FieldName="BizType"
                                    Visible="False"
                                    IsSmart="True" />
                                                <dxg:GridColumn FieldName="EmployeerNo"
                                    x:Name="colEmployeerNo"
                                    IsSmart="True"
                                    Visible="False" />
                                                <!--<dxg:GridColumn FieldName="addressId"
                                      x:Name="coladressId"
                                      IsSmart="True"
                                      Visible="False" />
                      <dxg:GridColumn FieldName="address"
                                      IsSmart="True"
                                      x:Name="coladress"
                                      Visible="False" />
                      <dxg:GridColumn FieldName="contactId"
                                      Visible="False"
                                      x:Name="colcontactId"
                                      IsSmart="True" />-->
                                                <!--<dxg:GridColumn FieldName="contact"
                                      x:Name="colcontact"
                                      IsSmart="True"
                                      Visible="False" />-->
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>




                        <dxlc:LayoutItem  Label="Departments"
                                          LabelPosition="Top"
                                          FontWeight="DemiBold"
                                          Grid.ColumnSpan="3" 
                                          HorizontalContentAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                 Grid.Row="7" >


                            <dxg:GridControl x:Name="gridDepartment"
                                 AutoGenerateColumns="None"
                                 SelectionChanged="GridDepartment_SelectionChanged"
                                 SelectionMode="MultipleRow"
                                 AllowInitiallyFocusedRow="False">
                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="griddeptview"
                                          AutoWidth="True"
                                          KeyFieldName="Id"
                                          ParentFieldName="ParentID"
                                          TreeDerivationMode="Selfreference"
                                          AutoExpandAllNodes="True"
                                          IsSynchronizedWithCurrentItem="True"
                                          AllowEditing="False"
                                          ShowCheckboxes="True"
                                          UseIndicatorForSelection="True"
                                          FadeSelectionOnLostFocus="False"
                                          ShowSelectionRectangle="True">

                                    </dxg:TreeListView>
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="Id"
                                    x:Name="coldeptid"
                                    IsSmart="True"
                                    Visible="False" />
                                <dxg:GridColumn x:Name="coldeptname"
                                    FieldName="DeptName"
                                    Image="{dx:DXImage Image=BODepartment_16x16.png}"            
                                    IsSmart="True" />
                                <dxg:GridColumn x:Name="coldeptcode"
                                    FieldName="Code"
                                        Image="{dx:DXImage Image=General_16x16.png}"         
                                    IsSmart="True" />
                                <dxg:GridColumn FieldName="Abbrivation"
                                    IsSmart="True"
                                    x:Name="coldeptabr"
                                    Visible="False" />
                                <dxg:GridColumn FieldName="Timestamp"
                                    IsSmart="True"
                                    x:Name="coldeptts"
                                    Visible="False" />
                                <dxg:GridColumn FieldName="sectionId"
                                    IsSmart="True"
                                    Visible="False" />
                                <dxg:GridColumn FieldName="sections"
                                    IsSmart="True"
                                    Visible="False" />
                            </dxg:GridControl>
                        </dxlc:LayoutItem>
                    </Grid>










                </dxlc:LayoutGroup>
            </dx:DXTabItem>

            <dx:DXTabItem x:Name="tabAccountant"  Header="Accountant" BorderThickness="8" BorderColor="Black"  Glyph="{dx:DXImage Image=Accounting_16x16.png}">
                
                
                
                <dxlc:LayoutGroup Header="Item Details"   View="Group" 
                                          IsCollapsible="False" 
                                          IsCollapsed="False" 
                                          Orientation="Vertical">
                    <dx:DXTabControl TabContentCacheMode="None" >
                        <dx:DXTabItem x:Name="tabInventory"
                            Header="Inventory" BorderThickness="8" BorderColor="Black" Glyph="{dx:DXImage Image=Accounting_16x16.png}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <dxlc:LayoutItem Grid.Row="0" x:Name="siItemName"
                                    Label="Item Name"  LabelPosition="Top"   >
                                    <dxe:TextEdit x:Name="txtInventoryItem" Margin="10,5" Height="26"  IsReadOnly="True"/>
                                </dxlc:LayoutItem>
                                    <dxlc:LayoutItem x:Name="currAssetAccount"
                                    Label="Account Current Asset" Grid.Row="1" LabelPosition="Top" >
                                    <dxg:LookUpEdit x:Name="lookupCAssetAccounts"
                    
                        Margin="10,5"   
                         Height="26"
                        Grid.Column="1"
                    DisplayMember="accountName"
                    SelectedIndexChanged="LookupCAssetAccounts_SelectedIndexChanged">
                                        <dxg:LookUpEdit.PopupContentTemplate>
                                            <ControlTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <dxg:GridControl x:Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                                        <dxg:GridControl.View>
                                                            <dxg:TreeListView x:Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                                        </dxg:GridControl.View>
                                                        <dxg:GridColumn FieldName="Account Name"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                                    </dxg:GridControl>
                                                </Grid>
                                            </ControlTemplate>
                                        </dxg:LookUpEdit.PopupContentTemplate>
                                    </dxg:LookUpEdit>
                                </dxlc:LayoutItem>

                            </Grid>

                        </dx:DXTabItem>

                        <dx:DXTabItem Header="Sale Invoices" BorderThickness="2"  BorderColor="Black" Glyph="{dx:DXImage Image=Accounting_16x16.png}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <dxlc:LayoutItem Label="Credit Account(Income)" Grid.Row="0" LabelPosition="Top" >
                                    <dxg:LookUpEdit x:Name="lookupIncomeAccounts"
                     Height="26"
                        Margin="10,5"   
                        
                        Grid.Column="1"
                    DisplayMember="accountName"
                    SelectedIndexChanged="LookupIncomeAccounts_SelectedIndexChanged">
                                        <dxg:LookUpEdit.PopupContentTemplate>
                                            <ControlTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <dxg:GridControl x:Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                                        <dxg:GridControl.View>
                                                            <dxg:TreeListView x:Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                                        </dxg:GridControl.View>
                                                        <dxg:GridColumn FieldName="Account Name"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                                    </dxg:GridControl>
                                                </Grid>
                                            </ControlTemplate>
                                        </dxg:LookUpEdit.PopupContentTemplate>
                                    </dxg:LookUpEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem x:Name="lblInvenCGS" Grid.Column="1" Grid.Row="0" Label="Dr. Account (CGS)" LabelPosition="Top">
                                    <dxg:LookUpEdit x:Name="lookupInvenCGSAccounts"
                    Height="26"
                        Margin="10,5"  
                        
                        Grid.Column="1"
                    DisplayMember="accountName"
                    SelectedIndexChanged="LookupCGSAccounts_SelectedIndexChanged">
                                        <dxg:LookUpEdit.PopupContentTemplate>
                                            <ControlTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <dxg:GridControl x:Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                                        <dxg:GridControl.View>
                                                            <dxg:TreeListView x:Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                                        </dxg:GridControl.View>
                                                        <dxg:GridColumn FieldName="Account Name"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                                    </dxg:GridControl>
                                                </Grid>
                                            </ControlTemplate>
                                        </dxg:LookUpEdit.PopupContentTemplate>
                                    </dxg:LookUpEdit>
                                </dxlc:LayoutItem>
                                <dxg:GridControl x:Name="grdSIDepartment"
                                 AutoGenerateColumns="None"
                                  Grid.Row="3" 
                                                 
                                 Grid.ColumnSpan="2"
                                         
                                 SelectionMode="MultipleRow"
                                 AllowInitiallyFocusedRow="False">
                                    <dxg:GridControl.View>
                                        <dxg:TableView x:Name="grdReceivableview"
                                          AutoWidth="True"
                                          Header="Accounts Receivable"
                                          AllowGrouping="False"
                                          IsSynchronizedWithCurrentItem="True"
                                          AllowEditing="False"
                                          ShowSearchPanelMode="Never"
                                          ShowColumnHeaders="True"
                                          ShowGroupedColumns="False" 
                                               ShowGroupPanel="False"
                                          UseIndicatorForSelection="True"
                                          FadeSelectionOnLostFocus="False"
                                          ShowSelectionRectangle="True">

                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn x:Name="department"
                                     Header="Department"           
                                    FieldName="DeptName"
                                                                                        Image="{dx:DXImage Image=BODepartment_16x16.png}"            

                                    VisibleIndex="0"            
                                    IsSmart="True" />
                                    <dxg:GridColumn x:Name="receivableAccount"
                                                 VisibleIndex="1"
                                                                                                                                            Image="{dx:DXImage Image=Accounting_16x16.png}"            

                                                Header=" DR. Account Receivable"
                                    FieldName="ChartofAccount.accountName"
                                    IsSmart="True" />



                                </dxg:GridControl>
                                <dxlc:LayoutItem Label=" CR. Account (Current Asset)"  Margin="10,5"   Grid.Row="2" LabelPosition="Top" >
                                    <dxe:TextEdit x:Name="txtCreditCurrentAsset" Height="26"/>
                                </dxlc:LayoutItem>

                            </Grid>
                            
                        </dx:DXTabItem>
                        <dx:DXTabItem Header="Purchase Invoices" BorderThickness="8" BorderColor="Black" Glyph="{dx:DXImage Image=Accounting_16x16.png}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <dxlc:LayoutItem x:Name="lblCGS" Grid.Row="0" Label="Dr. Account (CGS)" LabelPosition="Top">
                                    <dxg:LookUpEdit x:Name="lookupCGSAccounts"
                   Height="26"
                        Margin="10,5"
                       
                        Grid.Column="1"
                    DisplayMember="accountName"
                    SelectedIndexChanged="LookupCGSAccounts_SelectedIndexChanged">
                                        <dxg:LookUpEdit.PopupContentTemplate>
                                            <ControlTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <dxg:GridControl x:Name="PART_GridControl"
                             AutoPopulateColumns="True"
                             Grid.Row="1">
                                                        <dxg:GridControl.View>
                                                            <dxg:TreeListView x:Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="parentId"
                                  />
                                                        </dxg:GridControl.View>
                                                        <dxg:GridColumn FieldName="Account Name"
                              IsSmart="True"
                              Width="auto"
                              Visible="False"/>
                                                    </dxg:GridControl>
                                                </Grid>
                                            </ControlTemplate>
                                        </dxg:LookUpEdit.PopupContentTemplate>
                                    </dxg:LookUpEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Db. Account(Current Asset)" Grid.Row="1" LabelPosition="Top" Margin="10,5">
                                    <dxe:TextEdit x:Name="txtDebitCurrentAsset" Height="26"/>
                                </dxlc:LayoutItem>
                                <dxg:GridControl x:Name="grdPIDepartment"
                                 AutoGenerateColumns="None"
                                 Grid.ColumnSpan="2"
                                   Grid.Row="2"         
                                 SelectionMode="MultipleRow"
                                 AllowInitiallyFocusedRow="False">
                                    <dxg:GridControl.View>
                                        <dxg:TableView x:Name="grdPayableleview"
                                          AutoWidth="True"
                                          Header="Accounts Payable"
                                          AllowGrouping="False"
                                          IsSynchronizedWithCurrentItem="True"
                                          AllowEditing="False"
                                          ShowSearchPanelMode="Never"
                                          ShowColumnHeaders="True"
                                          ShowGroupedColumns="False" 
                                               ShowGroupPanel="False"
                                          UseIndicatorForSelection="True"
                                          FadeSelectionOnLostFocus="False"
                                          ShowSelectionRectangle="True">

                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn x:Name="departmentPI"
                                     Header="Department"           
                                    FieldName="DeptName"
                                    VisibleIndex="0"  
                                                                                        Image="{dx:DXImage Image=BODepartment_16x16.png}"            

                                    IsSmart="True" />
                                    <dxg:GridColumn x:Name="payableAccount"
                                                VisibleIndex="2" 
                                                                                                                                            Image="{dx:DXImage Image=Accounting_16x16.png}"            

                                                Header="CR. Account Payable"
                                    FieldName="AccountPayable.accountName"
                                    IsSmart="True" />
                                </dxg:GridControl>

                            </Grid>
                        </dx:DXTabItem>
                    </dx:DXTabControl>
                </dxlc:LayoutGroup>


            </dx:DXTabItem>

        </dx:DXTabControl>
        <Button Content="Save"
            Grid.Row="1"
                Cursor="Hand"
            FontSize="24"
            x:Name="btnSaveProduct"
            Click="btnSaveProduct_Click"
            FontWeight="Medium"
              />
    </Grid>
</dx:ThemedWindow>
