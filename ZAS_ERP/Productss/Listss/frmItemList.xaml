<dx:ThemedWindow xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Productss"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:utilities="clr-namespace:ZAS_ERP.BussinessLogicss"
                 xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
                 xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        x:Class="ZAS_ERP.Productss.frmItemList"
        WindowStartupLocation="CenterScreen"
                 utilities:WindowUtilities.CloseOnEscape="True"
             
        mc:Ignorable="d"
        Title="Item's List"
        x:Name="winItemList"
        Loaded="winItemList_Loaded"
        Unloaded="WinItemList_Unloaded"
        Height="450"
                 
        Width="700" WindowStyle="SingleBorderWindow" TitleAlignment="Center" WindowKind="Ribbon">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <!--<ColumnDefinition Width=".7*" />
        <ColumnDefinition Width="auto" />-->
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="1.4*" />
            </Grid.RowDefinitions>
            <dxr:RibbonControl RibbonTitleBarVisibility="Collapsed"
                        RibbonStyle="OfficeSlim"
                            ToolbarShowMode="Hide"  
                        ShowApplicationButton="False" 
                        MinimizationButtonVisibility="Visible" PageCategoryAlignment="Left"
                               >
                <dxr:RibbonDefaultPageCategory Caption="{x:Null}">
                    <dxr:RibbonPage Caption="List of Items">
                        <dxr:RibbonPageGroup Caption="{x:Null}" ShowCaptionButton="False"  >
                            <dxb:BarButtonItem x:Name="barNewItem" Content="New" ItemClick="BarNewItem_ItemClick" Glyph="{dx:DXImageGrayscale Image=Add_32x32.png}"/>
                            <dxb:BarButtonItem x:Name="barEditItem" Content="Edit" ItemClick="BarEditItem_ItemClick" Glyph="{dx:DXImageGrayscale Image=Edit_32x32.png}" />
                            <dxb:BarButtonItem x:Name="barDuplicateItem" Content="Duplicate" ItemClick="barDuplicateItem_ItemClick" Glyph="{dx:DXImageGrayscale Image=Edit_32x32.png}" />
                            <dxb:BarButtonItem x:Name="barInActiveList" Content="InActive List" ItemClick="BarInActiveList_ItemClick" Glyph="{dx:DXImage Image=ListBox_32x32.png}"/>
                            <dxb:BarButtonItem x:Name="barRefreshItems" Content="Refresh" ItemClick="BarRefreshItems_ItemClick" Glyph="{dx:DXImageGrayscale Image=Refresh_32x32.png}" />
                            <dxb:BarButtonItem x:Name="barbyPassItems" Content="ByPass Authorities" ItemClick="barbyPassItems_ItemClick" Glyph="{dx:DXImageGrayscale Image=Refresh_32x32.png}" />
                        </dxr:RibbonPageGroup>
                    </dxr:RibbonPage>
                </dxr:RibbonDefaultPageCategory>







            </dxr:RibbonControl>



            <GridSplitter Grid.Column="1"
                    Grid.Row="1" Width="5"
                    Grid.RowSpan="2"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Center" />
            <dxg:GridControl x:Name="grdproducts"
                       AutoGenerateColumns="AddNew"
                       Grid.Row="1"
                       AutoPopulateColumns="False"
                       Grid.Column="2"
                       SelectionMode="Row"
                       MouseDoubleClick="grdproducts_MouseDoubleClick"
                       
                       >
                <dxg:GridControl.View>
                    <dxg:TreeListView x:Name="treeListView1"
                                  ShowAutoFilterRow="True"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                      AutoPopulateServiceColumns="False"
                                  ParentFieldName="parentId"
                                  />
                </dxg:GridControl.View>

              

                <dxg:GridColumn FieldName="Id"
                        x:Name="Id"
                        IsSmart="True"
                        Header="Id"
                        VisibleIndex="0"      
                        Visible="False"
                        Width="auto"/>
                <dxg:GridColumn FieldName="item"
                        x:Name="item"
                        IsSmart="True"
                        Header="Item"
                        VisibleIndex="1"      
                        Visible="True"
                        Width="auto"/>
                <dxg:GridColumn FieldName="code"
                        x:Name="code"
                        IsSmart="True"
                        Header="Code"
                        VisibleIndex="2"      
                        Visible="True"
                        Width="auto"/>
                <dxg:GridColumn FieldName="nature.nature"
                        x:Name="nature"
                        IsSmart="True"
                        Header="Nature"
                        VisibleIndex="3"      
                        Visible="True"
                        Width="auto"/>
                <dxg:GridColumn FieldName="category.category"
                        x:Name="category"
                        IsSmart="True"
                        Header="Category"
                        VisibleIndex="4"        
                        Visible="True"
                        Width="auto"/>
                <dxg:GridColumn FieldName="itemDescription"
                        x:Name="itemDescription"
                        IsSmart="True"
                        VisibleIndex="5"   
                        Header="Item Description"
                        Visible="True"
                        Width="auto"/>
                <dxg:GridColumn FieldName="ownDescription"
                        x:Name="ownDescription"
                        IsSmart="True"
                        Header="Own Description"
                        Visible="True"
                        VisibleIndex="6"
                        Width="auto"/>
                <dxg:GridColumn FieldName="isActive"
                        x:Name="isActive"
                        IsSmart="True"
                        Header="isActive"
                        Visible="True"
                                VisibleIndex="7"
                        Width="auto"/>
                <dxg:GridColumn FieldName="user.userName"
                        x:Name="user"
                        IsSmart="True"
                        Header="user"
                        Visible="True"
                                VisibleIndex="8"
                        Width="auto"/>
                <dxg:GridColumn FieldName="productType"
                        x:Name="productType"
                        IsSmart="True"
                        Header="Product Type"
                                VisibleIndex="9"
                        Visible="True"
                        Width="auto"/>
                <dxg:GridColumn FieldName="cgsAccount.accountName"
                     
                        IsSmart="True"
                        Header="CGS Account"
                                VisibleIndex="10"
                        Visible="True"
                        Width="auto"/>
                <dxg:GridColumn FieldName="incomeAccount.accountName"
                        x:Name="incomeAccount"
                        IsSmart="True"
                        Header="Income Account"
                                VisibleIndex="11"
                        Visible="True"
                        Width="auto"/>

            </dxg:GridControl>

        </Grid>
    </Grid>
</dx:ThemedWindow>
