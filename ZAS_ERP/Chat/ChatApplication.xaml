<Window xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"  
        x:Class="ZAS_ERP.Chat.ChatApplication"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZAS_ERP.Chat"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:local1="clr-namespace:ZAS_ERP.Chat.ChatUsercontrols"
        mc:Ignorable="d"
        Title="ZAS Connect"
        Height="auto"
        Width="auto"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen" 
        Icon="Images/iconTitle.png"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Closing="Window_Closing" 
        ShowInTaskbar="True"     
       >
    <Window.Resources>


        <Style x:Key="Chromeless" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border BorderThickness="0" Width="54" Height="54">
                            <ContentPresenter/>
                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="placeHolder" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid>
                            <TextBox Text="{Binding Path=Text,
                                                RelativeSource={RelativeSource TemplatedParent}, 
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="textSource" 
                                 Background="Transparent"
                                 Panel.ZIndex="2" />
                            <TextBox Text="{TemplateBinding Tag}" Background="{TemplateBinding Background}" Panel.ZIndex="1">
                                <TextBox.Style>
                                    <Style TargetType="{x:Type TextBox}">
                                        <Setter Property="Foreground" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=Text, Source={x:Reference textSource}}" Value="">
                                                <Setter Property="Foreground" Value="LightGray"/>
                                            </DataTrigger>
                                        </Style.Triggers>

                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransparentStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="LightBlue"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Background="Transparent">
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundCorner" TargetType="{x:Type Button}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="grid">
                            <Border x:Name="border" CornerRadius="15"  BorderBrush="DeepSkyBlue" BorderThickness="2">
                                <Border.Background>
                                    <RadialGradientBrush GradientOrigin="0.496,1.052">
                                        <RadialGradientBrush.RelativeTransform>
                                            <TransformGroup>
                                                <ScaleTransform CenterX="0.5" CenterY="0.5" 
                                                        ScaleX="1.5" ScaleY="1.5"/>
                                                <TranslateTransform X="0.02" Y="0.3"/>
                                            </TransformGroup>
                                        </RadialGradientBrush.RelativeTransform>
                                        <GradientStop Offset="1" Color="#00000000"/>
                                        <GradientStop Offset="0.3" Color="Transparent"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontWeight="Bold"/>
                            </Border>

                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border">
                                    <Setter.Value>
                                        <RadialGradientBrush GradientOrigin="0.496,1.052">
                                            <RadialGradientBrush.RelativeTransform>
                                                <TransformGroup>
                                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1.5" ScaleY="1.5"/>
                                                    <TranslateTransform X="0.02" Y="0.3"/>
                                                </TransformGroup>
                                            </RadialGradientBrush.RelativeTransform>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                            <GradientStop Color="#FF303030" Offset="0.3"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#FF33962B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="grid" Value="0.25"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="FlatButtonStyle">
            <Setter Property="Background" Value="DarkCyan"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="0"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}" >
                        <Border CornerRadius="20" Background="LightGray" BorderThickness="1" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="TextBoxBaseControlTemplate" TargetType="{x:Type TextBoxBase}">
            <Border Background="{TemplateBinding Background}" 
                x:Name="Bd" BorderBrush="#FF305590"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Height="30">
                <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" TargetName="Bd"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                </Trigger>
                <Trigger Property="Width" Value="Auto">
                    <Setter Property="MinWidth" Value="100"/>
                </Trigger>
                <Trigger Property="Height" Value="Auto">
                    <Setter Property="MinHeight" Value="20"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="TextBoxBaseControlTemplateChat" TargetType="{x:Type TextBoxBase}">
            <Border Background="{TemplateBinding Background}" 
                x:Name="Bd" BorderBrush="Black"
                BorderThickness="{TemplateBinding BorderThickness}"  CornerRadius="14" Height="39">
                <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" TargetName="Bd"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                </Trigger>
                <Trigger Property="Width" Value="Auto">
                    <Setter Property="MinWidth" Value="100"/>
                </Trigger>
                <Trigger Property="Height" Value="Auto">
                    <Setter Property="MinHeight" Value="20"/>
                </Trigger>
            </ControlTemplate.Triggers>

        </ControlTemplate>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" TargetName="Bd" Value="lightblue"/>
                                <!--<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>-->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border   BorderThickness="2" BorderBrush="Black" >
        <Grid Background="AliceBlue"  >
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!--titile  Bar-->
            <Border x:Name="titleBar" BorderBrush="Gray" BorderThickness="1"  >
                <Grid Background="#FF305590" Grid.Row="0" MouseDown="Grid_MouseDown" VerticalAlignment="Top" Margin="0,0,0,0">
                    <Grid   HorizontalAlignment="Right" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Button  x:Name="btnMinimize" ToolTip="Minimize" Grid.Column="0" Style="{StaticResource ResourceKey=TransparentStyle}" Click="BtnMinimize_Click" Margin="5,5,5,5" VerticalAlignment="Bottom" Visibility="Visible" Padding="5">
                            <Image Width="30"  VerticalAlignment="Bottom" Source="Images/iconMinimize.png"   />
                        </Button>

                        <Button x:Name="btnClose" ToolTip="Close"  Grid.Column="2" Style="{StaticResource ResourceKey=TransparentStyle}" Click="BtnClose_Click" Margin="5,5,5,5" Visibility="Visible"  Padding="5">
                            <Image  Height="30"    HorizontalAlignment="Center" VerticalAlignment="Center" Source="Images/iconClose.png"  />
                        </Button>

                        <Button x:Name="btnMaximize" ToolTip="Close"  Grid.Column="1" Style="{StaticResource ResourceKey=TransparentStyle}" Click="BtnMaximize_Click" Margin="5,5,5,5" Visibility="Visible"  Padding="5">
                            <Image     HorizontalAlignment="Center" VerticalAlignment="Center" Source="Images/iconMaximize.png"    />
                        </Button>
                    </Grid>
                    <Grid HorizontalAlignment="Center">

                        <StackPanel Orientation="Horizontal"  >
                            <Image Source="Images/iconTitle.png" Margin="0,5" />

                            <Label Grid.Column="1" Content="ZAS Connect" Foreground="White" FontFamily="arialRounded" FontStretch="ExtraExpanded" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Opacity="0.9" />

                            <Label Content="1.2.0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="arialRounded" FontSize="15" Foreground="WhiteSmoke" FontWeight="DemiBold" Margin="5,2"  />

                        </StackPanel>

                    </Grid>
                </Grid>

            </Border>
            <!--login and chat header names-->

            <Border x:Name="loginAndChatHeader" BorderBrush="Red"  BorderThickness="1" Grid.Row="1" Padding="2"  >
                <Grid   Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--Login Name-->
                    <Grid x:Name="loginGrid" Grid.Column="0" Background="LightGray" >

                    </Grid>

                    <!--Chat Header Name-->
                    <Border x:Name="ChatHeaderName" BorderBrush="Gray" BorderThickness="1" Grid.Column="1" Padding="1" >
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!--Header Name-->
                            <Border Grid.Column="1" BorderBrush="Transparent" BorderThickness="2" >
                                <Grid  Background="Transparent" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="chatHeaderName" Grid.Column="0"  Text=""    FontSize="22"  FontFamily="ArialRounded"  FontWeight="Medium" Opacity="0.8"  Margin="10,10,10,10" />
                                    <dxg:LookUpEdit 
                                    x:Name="groupUsers"
                                    Grid.Column="2" 
                                    Height="35"

                                    Margin="5,5,5,5"
                                    Visibility="Collapsed"
                                    AutoPopulateColumns="True"
                                    DisplayMember="name"
                                    />


                                    <Grid Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>

                                        </Grid.RowDefinitions>

                                        <Button Grid.Column="0" Grid.Row="0"   Style="{StaticResource ResourceKey=RoundedButtonStyle}"   Margin="5,5,5,5" ToolTip="Video Call" Visibility="Collapsed">

                                            <Image x:Name="btnVideoCall" Width="28" Height="30"  Source="/ZAS_ERP;component/images/Chat/iconVideoCall.png" Opacity="0.7" MouseEnter="Image_MouseEnter" MouseLeave="VideoButton_MouseLeave" Cursor="Hand"/>

                                        </Button>

                                        <Button Grid.Column="1"  Style="{StaticResource ResourceKey=RoundedButtonStyle}"   HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="5,5,5,5" ToolTip="Audio Call" Visibility="Collapsed">

                                            <Image x:Name="btnAudioCall" Width="28" Height="22" Source="/ZAS_ERP;component/images/Chat/iconCall.png" Opacity="0.7" MouseEnter="BtnAudioCall_MouseEnter" MouseLeave="BtnAudioCall_MouseLeave" Cursor="Hand"/>

                                        </Button>



                                        <Button Grid.Column="2" x:Name="btnMakeNewGroup"  Style="{StaticResource ResourceKey=RoundedButtonStyle}"  HorizontalAlignment="Right" Margin="5,5,5,5" ToolTip="Create Group" Visibility="Visible" Click="BtnMakeNewGroup_Click" >

                                            <Image x:Name="btnCreatGroup" Width="28" Height="22" Source="/ZAS_ERP;component/images/Chat/iconCreateGroup.png" Opacity="0.7" MouseEnter="BtnCreatGroup_MouseEnter" MouseLeave="BtnCreatGroup_MouseLeave" Cursor="Hand" />
                                        </Button>


                                    </Grid>


                                </Grid>

                            </Border>

                        </Grid>

                    </Border>


                </Grid>
            </Border>


            <Grid x:Name="mainChatGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="304"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="2" />
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!--Navigations Grid-->




                <Border x:Name="Navigations" Grid.Column="0"  BorderBrush="Gray" BorderThickness="1" Padding="2" Margin="0,0,2,0">

                    <Grid x:Name="navigationsGrid"  Background="LightGray"  >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>




                        <Border Grid.Row="1" BorderBrush="#FF305590" BorderThickness="1"  Padding="2" Margin="2,2,2,2" >

                            <Grid x:Name="contactsSearchGrid" Grid.Row="1" Background="LightGray" Visibility="Visible"  >

                                <TextBox x:Name="searchContact"  Template="{StaticResource TextBoxBaseControlTemplate}"   VerticalAlignment="Center" Text=""     FontFamily="ArialRounded" FontSize="18"  ToolTip="People, Groups, Recent"  TextChanged="SearchContact_TextChanged" Style="{StaticResource placeHolder}" Tag="Search" Height="40" Margin="5,0,5,0"/>

                                <Image  Width="30" Height="22"   VerticalAlignment="Center" HorizontalAlignment="Right"   Visibility="Visible" Source="/ZAS_ERP;component/images/Chat/iconSearch.png" Margin="12,5,12,5"  />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" BorderBrush="#FF305590" BorderThickness="1"  Padding="2" Margin="2,2,2,2" >
                            <Grid x:Name="recentSearchGrid" Grid.Row="1" Background="LightGray" Visibility="Collapsed"  >

                                <TextBox x:Name="searchRecent"   Template="{StaticResource TextBoxBaseControlTemplate}"   VerticalAlignment="Center" Text=""     FontFamily="ArialRounded" FontSize="18"  ToolTip="People, Groups, Recent"  TextChanged="SearchRecent_TextChanged" Style="{StaticResource placeHolder}"  Tag="Search"   Margin="5,0,5,0"/>
                                <Image  Width="30" Height="22"  VerticalAlignment="Center" HorizontalAlignment="Right"   Visibility="Visible" Source="/ZAS_ERP;component/images/Chat/iconSearch.png" Margin="12,5,12,5" />

                            </Grid>

                        </Border>
                        <Border BorderBrush="#FF305590" BorderThickness="1" Padding="2" Margin="2,2,2,2">
                            <Grid Grid.Row="2" x:Name="navigationGrid"  >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition  Width="*"/>
                                    <ColumnDefinition  Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="btnRecentChat" Style="{StaticResource Chromeless}" Grid.Column="0" Grid.Row="0"  IsChecked="True"   ToolTip="Chats" Click="BtnRecentChat_Click" Cursor="Hand" Margin="5,5,5,5" >

                                    <Image Height="35"  Cursor="Hand" Source="Images/iconRecentChats.png"/>

                                </ToggleButton>

                                <Border x:Name="brdrOneToOneMsgCounter"
                                    CornerRadius="12"
                                    Background="Red"
                                    BorderThickness="1"
                                    Width="20"
                                    Height="20" 
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed" Margin="10,10,10,10" >
                                    <TextBlock 
                                    x:Name="mainRecentCounter" 
                                    Grid.Column="0" Grid.Row="0"
                                    Foreground="White" 
                                    Text=""
                                    FontSize="10"
                                    FontWeight="Bold"
                                    TextAlignment="Center" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                        />

                                </Border>
                                <ToggleButton x:Name="btnActive" Style="{StaticResource Chromeless}" Grid.Column="1" Grid.Row="0"    Click="BtnActive_Click" ToolTip="Active Users" IsEnabled="False" Cursor="Hand" Margin="5,5,5,5">
                                    <Image  Width="40" Source="/ZAS_ERP;component/images/Chat/iconOnline.png" Cursor="Hand"  />
                                </ToggleButton>
                                <ToggleButton x:Name="btnContacts" Style="{StaticResource Chromeless}"  Grid.Column="2" Grid.Row="0"   Click="BtnContacts_Click" ToolTip="Contacts" Cursor="Hand" Margin="5,5,5,5" >
                                    <Image Height="30" Width="40" Source="Images/iconContacts.png" Cursor="Hand"/>
                                </ToggleButton>
                                <ToggleButton x:Name="btnGroups" Style="{StaticResource Chromeless}"  Grid.Column="3" Grid.Row="0" IsEnabled="True"   Click="BtnGroups_Click" ToolTip="Groups" Cursor="Hand" Margin="5,5,5,5">
                                    <Image Width="35" Height="40" Source="Images/iconGroups.png" Cursor="Hand" />
                                </ToggleButton>

                                <Border x:Name="bdrGroupMsgCounter"
                                    CornerRadius="12" 
                                    Grid.Column="3" 
                                    Grid.Row="0" 
                                    Background="Red"
                                    BorderThickness="2"
                                    Width="20" 
                                    Height="20"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom" 
                                    Visibility="Collapsed" Margin="10,10,10,10" >
                                    <TextBlock x:Name="groupMainCounter"
                                           Foreground="White"
                                           Text=""
                                           FontSize="10"
                                           FontWeight="Bold" 
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock x:Name="lblChats" Grid.Column="0" Grid.Row="1" FontWeight="DemiBold" Text="Chats" Foreground="Black" HorizontalAlignment="Center" FontFamily="ArialRounded" Margin="5,5,5,5"/>
                                <TextBlock x:Name="lblActive" Grid.Column="1" Grid.Row="1" FontWeight="DemiBold" HorizontalAlignment="Center" Text="Active" FontFamily="ArialRounded" Margin="5,5,5,5"/>
                                <TextBlock x:Name="lblContacts" Grid.Column="2" Grid.Row="1" FontWeight="DemiBold" HorizontalAlignment="Center" Text="Contacts" FontFamily="ArialRounded" Margin="5,5,5,5" />
                                <TextBlock x:Name="lblGroups" Grid.Column="3" Grid.Row="1" FontWeight="DemiBold" HorizontalAlignment="Center" Text="Groups" FontFamily="ArialRounded" Margin="5,5,5,5"/>
                            </Grid>
                        </Border>



                    </Grid>

                </Border>









                <!--Contacts listbox -->

                <Border  Grid.Column="0" Grid.Row="3" BorderBrush="#FF305590" BorderThickness="2" Padding="2" Margin="2,2,2,2">


                    <Grid x:Name="listboxesGrid" Grid.Column="0" Grid.Row="3">
                        <ListBox  x:Name="lstContacts"   Background="LightGray" Visibility="Collapsed" SelectionChanged="LstContacts_SelectionChanged"  >
                        </ListBox>

                        <ListBox Grid.Column="0" Grid.Row="3" x:Name="lstRecentChat"   Visibility="Visible" SelectionChanged="LstRecentChat_SelectionChanged" Background="LightGray"  >

                        </ListBox>
                        <ListBox x:Name="lstGroups"  Grid.Column="0" Grid.Row="3"    Visibility="Collapsed"  Background="LightGray"  SelectionMode="Single" SelectionChanged="LstGroups_SelectionChanged" >

                        </ListBox>

                    </Grid>
                </Border>

                <!--Active listbox-->
                <ListBox x:Name="lstActive" Grid.Column="0" Grid.Row="3" Background="LightGray" Visibility="Collapsed"/>

                <!--Chat Grid-->

                <Grid x:Name="chatGrid" Grid.Column="2" Grid.RowSpan="4" Visibility="Visible" KeyUp="ChatGrid_KeyUp">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>

                    </Grid.RowDefinitions>


                    <!--Chat listbox-->

                    <ListBox x:Name="lstChat" Grid.Row="0"  Visibility="Visible"    >
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Reply" Click="Reply_Click"/>
                                <MenuItem Header="Delete" IsEnabled="False"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.Background>

                            <ImageBrush  Stretch="Fill" ImageSource="Images/imgChatbox.png" />
                        </ListBox.Background>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Margin" Value="15"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch">

                                </Setter>

                            </Style>
                        </ListBox.ItemContainerStyle>

                        <!--<ListBoxItem Content=" "/>-->
                        <ListBox.ItemsPanel >

                            <ItemsPanelTemplate >

                                <!--<VirtualizingStackPanel VerticalAlignment="Bottom" Orientation="Vertical" IsItemsHost="True"/>-->
                                <WrapPanel VerticalAlignment="Bottom"   Orientation="Vertical" IsItemsHost="True"/>

                            </ItemsPanelTemplate>

                        </ListBox.ItemsPanel>
                    </ListBox>
                    <Grid x:Name="replyGrid" Visibility="Collapsed">
                        <Button x:Name="replyCLose"   Margin="0,0,143.429,45" Content="X" FontSize="14" FontWeight="Bold" RenderTransformOrigin="0.5,0.5" Click="ReplyCLose_Click" Height="23" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="34">
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform AngleY="-0.818"/>
                                    <RotateTransform/>
                                    <TranslateTransform Y="-0.057"/>
                                </TransformGroup>
                            </Button.RenderTransform>
                        </Button>
                        <TextBlock x:Name="replyMsg"
                       Margin="0,0,178.429,49" TextWrapping="Wrap" 
                       VerticalAlignment="Bottom" Height="23" 
                       TextTrimming="CharacterEllipsis"
                       Foreground="#FF6E6E6E" FontWeight="Bold"/>

                    </Grid>
                    
                    
                    <!--Chatbox-->


                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox  Grid.Column="0" >

                            <Grid x:Name="grpboxChat">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>


                                <Border x:Name="brdChatBox"
                                    CornerRadius="8" 
                                    BorderBrush="#FF305590" 
                                    BorderThickness="2" 
                                    Padding="2"
                                    Grid.Row="1">
                                    <RichTextBox x:Name="chatBox"                                 
                                           AcceptsTab="True"
                                           AcceptsReturn="True"                                     
                                           SpellCheck.IsEnabled="True"
                                           Language="en-US"            
                                           FontSize="17"
                                           Focusable="True"          
                                           VerticalScrollBarVisibility="Auto"         
                                           Tag="Type a message..."
                                           AllowDrop="True"               
                                           Loaded="ChatBox_Loaded"               
                                 />
                                </Border>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Column="1"  VerticalAlignment="Bottom" >

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                
                                
                                <Border BorderBrush="Transparent" 
                                        Grid.Column="0"
                                Background="Green"
                                Visibility="Visible"
                                BorderThickness="2"
                                CornerRadius="30"
                                Padding="1"  
                                >
                                    <Button x:Name="btnAttach"
                                    Style="{StaticResource ResourceKey=RoundedButtonStyle}"
                                    ToolTip="Add File"  
                                    MouseEnter="BtnAddFile_MouseEnter"
                                    MouseLeave="BtnAddFile_MouseLeave"
                                    Cursor="Hand" 
                                            
                                    Click="BtnAttach_Click"          
                                     >
                                        <Image x:Name="btnAddFile" Width="30"  Height="30" Source="/ZAS_ERP;component/images/Chat/iconAdd.png" Opacity="0.7"/>
                                    </Button>
                                </Border>



                                <Border BorderBrush="Transparent" 
                                        Grid.Column="1"
                                Background="Green"
                                Visibility="Visible"
                                BorderThickness="2"
                                CornerRadius="30"
                                Padding="1"
                                
                                >

                                    <Button 
                                   Click="Button_Click"
                                    Style="{StaticResource ResourceKey=RoundedButtonStyle}"
                                    ToolTip="Send Contacts"
                                    Visibility="Visible">
                                        <Image x:Name="btnSendContact" Width="30" Height="22" Source="/ZAS_ERP;component/images/Chat/iconSendContacts.png" Opacity="0.7"  MouseEnter="BtnSendContact_MouseEnter" MouseLeave="BtnSendContact_MouseLeave" Cursor="Hand" />
                                    </Button>
                                </Border>

                                <Border BorderBrush="Transparent" 
                                        Grid.Column="2"
                                Background="Green"
                                Visibility="Visible"
                                BorderThickness="2"
                                CornerRadius="30"
                                Padding="1"
                               
                                >
                                    <Button 
                                    
                                    Style="{StaticResource ResourceKey=RoundedButtonStyle}" 
                                    ToolTip="Record Voice" 
                                    Visibility="Visible">
                                        <Image x:Name="btnVoiceRecord"
                                           Height="22" 
                                           Width="30" 
                                           Source="/ZAS_ERP;component/images/Chat/iconRecord.png" 
                                           Opacity="0.7" 
                                           MouseEnter="BtnVoiceRecord_MouseEnter"
                                           MouseLeave="BtnVoiceRecord_MouseLeave"
                                           Cursor="Hand" />
                                    </Button>
                                </Border>



                                    
                            </Grid>
                            


                        </GroupBox>
                    </Grid>
                    
