<UserControl x:Class="ZAS_ERP.Chat.ucReplyMsg"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Chat"
             mc:Ignorable="d" 
             Height="43.568" Width="381.902">
    <UserControl.Resources>
        <Style TargetType="{x:Type Button}" x:Key="adminBtn">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <StackPanel  x:Name="panel">
                            <ContentPresenter  />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" Value="Transparent" TargetName="panel" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="Blue" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Speech bubble rectangle -->
        <Border CornerRadius="10"
            Padding="15"
            Background="#FFE9F7F8" Margin="0,0,0.286,9.857"
                    >

            <!-- Message text -->
            <!-- Message text -->
            <!-- Message text -->
            <!-- Message text -->
            <!-- Message text -->
            <!-- Message text -->
            <!-- Message text -->
            <TextBlock  VerticalAlignment="Center"
                TextWrapping="Wrap"
                FontFamily="arial"
                TextTrimming="CharacterEllipsis"
                Foreground="#FF939393"
                x:Name="replyTxt"
                FontSize="11" Margin="-5,-6,10.714,-15.286" Height="25"
                           />

        </Border>
        <Button x:Name="replyClose"  Style="{StaticResource adminBtn}" Content="x" Width="9" Panel.ZIndex="3" Margin="0,6,8.286,18.429" HorizontalAlignment="Right" Background="#FFE9F7F8" BorderBrush="#FFE9F7F8" RenderTransformOrigin="0.48,0.575" FontSize="16" Click="ReplyClose_Click">

        </Button>


        <!-- Chat bubble anchor -->


    </Grid>
</UserControl>
