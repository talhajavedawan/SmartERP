<UserControl x:Class="ZAS_ERP.Chat.ChatUsercontrols.ucLogin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Chat.ChatUsercontrols"
             mc:Ignorable="d" 
             Height="auto" Width="auto" MinWidth="297" >
    <Grid>
        <Border x:Name="brdRecents" BorderBrush="Gray" BorderThickness="1" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="2,5,5,5" >
                    <Border  Padding="8" 
                BorderBrush="Transparent"  
                HorizontalAlignment="Left"    
                CornerRadius="30"
                 Background="Gray" Height="50" Width="50" Opacity="0.5">
                        <!--profile picture initials(text)-->

                    </Border>
                    <TextBlock x:Name="ucInitials" Text="{Binding initials}" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"          
                           FontSize="15"   TextAlignment="Center" Foreground="#FF006CFF"   FontWeight="Bold" Visibility="Visible"  FontFamily="arialRounded"/>
                </Grid>
                <Grid Grid.Column="1" Margin="5,5,5,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="userName"  Grid.Column="0"  HorizontalAlignment="Stretch" VerticalAlignment="Center" Foreground="Black"  FontFamily="ArialRounded"  Text="{Binding userName}" FontSize="15"  FontWeight="Medium" Opacity="0.9"/>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center"  >
                        <Image Width="40" Source="/ZAS_ERP;component/images/Chat/iconOnline.png" />
                    </TextBlock>
                </Grid>



            </Grid>
        </Border>

    </Grid>
</UserControl>
