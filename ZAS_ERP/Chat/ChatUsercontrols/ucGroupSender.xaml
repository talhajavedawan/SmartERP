<UserControl x:Class="ZAS_ERP.Chat.ChatUsercontrols.ucGroupSender"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Chat.ChatUsercontrols"
            
     Height="auto" Width="auto" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="600,0,0,0">
    <Grid >



        <!-- Chat message container -->
        <Grid  
                HorizontalAlignment="Right" 
                Width="Auto" 
                Height="Auto"
                MaxWidth="300">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Speech bubble rectangle -->
            <TextBlock 
                Grid.Row="1"
                Text="{Binding senderName}"
                HorizontalAlignment="Left"
                Foreground="Black"
                Panel.ZIndex="1"
                Padding="2" Margin="10,0,15,0" FontWeight="Bold" Opacity="0.7" />
           
            <Border CornerRadius="25"
                    Padding="15"
                    Background="LightGreen" Grid.RowSpan="3" Opacity="0.8"
                    >
                <!-- Message text -->
                <TextBlock  VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontFamily="OpenSans"
                           Foreground="Black"
                            FontWeight="DemiBold"                  
                           x:Name="sender_chatbox"
                           Text="{Binding msgBody}" 
                            Grid.Row="2"
                            Margin="0,5,0,0"
                            FontSize="12"  HorizontalAlignment="Left"/>

            </Border>
            <!-- Chat bubble anchor -->
            <Path Grid.Row="3" 
                      Stroke="Black"
                      Panel.ZIndex="1"
                      HorizontalAlignment="Right"
                      Margin="0,0,20,0"
                      Data="M 0,0 L 10,10 L 20,0 L 0,0" 
                      StrokeThickness="0"
                      Fill="LightGreen"
                  />
            <TextBlock Grid.Row="3"
                           Margin="0,5,0,0"
                           Text="{Binding seenStamp, IsAsync=true}"
                           FontWeight="DemiBold"
                       
                           Foreground="Black"
                           HorizontalAlignment="Right"
                           FontSize="14"  
                           
                           x:Name="time" 
                           />
            
            <Label x:Name="replyMsgBox"
                   Content="{Binding replyMsg, StringFormat= '&quot; {0} &quot;' }"
                   HorizontalAlignment="Left" 
                   Margin="14,1,0,0"
                   VerticalAlignment="Top" 
                   Width="Auto"
                   Height="Auto"
                   MaxWidth="150" 
                   FontSize="10" 
                   RenderTransformOrigin="0.5,0.5"
                   Grid.Row="1">
                <Label.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Label.RenderTransform>
            </Label>
        </Grid>
        <TextBlock x:Name="readReceipt" 
                   Background="Transparent" 
                   Width="auto"
                   Height="17"
                   Grid.Column="0"
                   Margin="0,0,5,10"
                   Foreground="ForestGreen" 
                   Text="{Binding readReceipt}"
                   FontWeight="Medium"
                   TextAlignment="Center" 
                   Visibility="Hidden"/>
    </Grid>
</UserControl>
