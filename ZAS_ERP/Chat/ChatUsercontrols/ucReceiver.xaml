<UserControl x:Class="ZAS_ERP.Chat.Usercontrols.ChatUsercontrols.ucReceiver"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Chat.Usercontrols.ChatUsercontrols"
             mc:Ignorable="d" 
             Height="auto" Width="auto">
    <Grid Width="163" HorizontalAlignment="Left" Margin="50,0,0,0"  >

        <!-- Profile picture -->

        <!-- Chat message container -->
        <Grid   Width="Auto" Height="Auto" MaxWidth="300">

            <Grid.RowDefinitions>
                <RowDefinition Height="13*" />
                <RowDefinition Height="22*"/>
                <RowDefinition Height="17" />
            </Grid.RowDefinitions>
            <!-- Speech bubble rectangle -->
            <Border CornerRadius="10"
                    Padding="15"
                    Background="DarkOrange" Grid.RowSpan="2"
                     Opacity="0.8">

                <!-- Message text -->
                <TextBlock  VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           
                           Foreground="Black"
                            FontFamily="OpenSans" 
                               x:Name="Receiver_chatbox"
                           Text="{Binding msgBody, IsAsync=true}" FontSize="13" Margin="20,0.333,-5.333,-0.333" />

            </Border>

            <!-- Chat bubble anchor -->
            <Path Grid.Row="2" 
                      Stroke="Black"
                      Panel.ZIndex="1"
                      Margin="10,0,20,7.333"
                      Data="M 0,0 L 10,10 L 20,0 L 0,0" 
                      StrokeThickness="0"
                      Fill="DarkOrange" Opacity="0.8" />

            <TextBlock Grid.Row="2"   FontFamily="OpenSans"
                           Text="{Binding seenStamp, IsAsync=true}"
                           Foreground="Black"
                           HorizontalAlignment="Right"
                           FontSize="13" Margin="0,7,0,-5" Width="150"
                           x:Name="time"
                          
                           />

        </Grid>
        <Label x:Name="recName" Content="{Binding recName}"  VerticalAlignment="Top" Height="19" FontSize="10" Margin="10,0,412,0" FontFamily="OpenSans"  />
    </Grid>
</UserControl>
