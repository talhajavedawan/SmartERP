<UserControl xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  x:Class="ZAS_ERP.Chat.Usercontrols.ChatUsercontrols.ucContacts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             Height="auto" Width="auto" MinWidth="255" MouseEnter="UserControl_MouseEnter" MouseLeave="UserControl_MouseLeave" Cursor="Hand">
    <Grid>
        <Border x:Name="brdContact" BorderBrush="Gray" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"  >
                    <Border  Padding="8" 
                BorderBrush="Transparent"  
                HorizontalAlignment="Left"    
                CornerRadius="30"
                 Background="Gray" Height="50" Width="45" Opacity="0.2" Margin="5,5,5,5"  >
                        <!--profile picture initials(text)-->

                    </Border>
                    <TextBlock x:Name="ucInitials" Text="{Binding initials}" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="#FF006CFF"         
                           FontSize="15"   TextAlignment="Center"    FontWeight="Bold" Visibility="Visible"  FontFamily="arialRounded"/>
                </Grid>
                <Grid Grid.Column="1" Margin="5,5,5,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="userName" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"  FontFamily="ArialRounded"  Text="{Binding userName}" FontSize="15" Foreground="Black" FontWeight="Medium" Opacity="0.9"/>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center"  >
                        <!--<Image Width="40" Source="/ZAS_ERP;component/images/Chat/iconOnline.png" />-->
                    </TextBlock>
                </Grid>



            </Grid>
        </Border>

     <TextBlock x:Name="msgBody" Visibility="Hidden"   FontFamily="ArialRounded" Text="{Binding msgBody}" TextTrimming="CharacterEllipsis" Opacity="0.9" />
    <TextBlock x:Name="seenStamp" Visibility="Hidden"   FontFamily="ArialRounded" Text="{Binding seenStamp}" HorizontalAlignment="Left" Opacity="0.7"/>
    <TextBlock x:Name="contactId"  Text="{Binding contactId}" Visibility="Hidden"/>
    <TextBlock x:Name="receiverId"  Text="{Binding receiverId}" Visibility="Hidden"/>
    <TextBlock x:Name="senderId"  Text="{Binding senderId}" Visibility="Hidden"/>
    <TextBlock x:Name="lastMsgId"  Text="{Binding msgId}" Visibility="Hidden"/>
    </Grid>
   
</UserControl>
