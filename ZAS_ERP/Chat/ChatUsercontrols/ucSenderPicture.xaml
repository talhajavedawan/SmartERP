<UserControl x:Class="ZAS_ERP.Chat.ChatUsercontrols.ucSenderPicture"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Chat.ChatUsercontrols"
             mc:Ignorable="d" 
             Height="auto" Width="auto" MinHeight="200" MinWidth="250" HorizontalAlignment="Left" VerticalAlignment="Center" >
    <UserControl.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="45,0,0,0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border Name="MenuBorder" SnapsToDevicePixels="True" BorderBrush="Black" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" >
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Button.IsFocused" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter TargetName="MenuBorder" Property="BorderBrush" Value="#FFED6A2B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>

        </Grid.RowDefinitions>


        <Border x:Name="brdrClose" Grid.Row="0"
                BorderBrush="Red"
                BorderThickness="2"
                CornerRadius="16"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"             
                >
            <Button x:Name="close" Height="20" Width="20" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"  >

                <Image  Source="/ZAS_ERP;component/images/Chat/iconClose.png" />
            </Button>
        </Border>

        <Grid Background="LightGreen"  Grid.Row="1">
            <Border BorderBrush="Blue" BorderThickness="2" CornerRadius="6"  Padding="5" >
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent"  Opacity="0.8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Label x:Name="fileName"
                               Content="{Binding fileName}"
                               FontSize="24"
                               HorizontalContentAlignment="Left"
                               FontFamily="arialRounded"
                               VerticalContentAlignment="Center"
                               FontWeight="Bold" Padding="10" />
                        <Label x:Name="fileSize"
                               Grid.Row="1" 
                               Content="{Binding fileSize}"
                               FontSize="18"
                               HorizontalContentAlignment="Left"
                               VerticalContentAlignment="Stretch"
                               Padding="10"/>
                        <Image x:Name="fileIcon" 
                               Grid.Row="2" 
                               Source="{Binding fileIcon}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom" 
                               Width="50" 
                               Margin="5,5,5,5"   />
                    </Grid>

                    <GridSplitter Grid.Row="1"
                                  HorizontalAlignment="Stretch" 
                                  BorderBrush="LightGray" 
                                  Background="Black" 
                                  Margin="2,2,2,2"/>


                    <Border Grid.Row="2" BorderBrush="LightBlue"  HorizontalAlignment="Stretch" >
                        <Button x:Name="btnFile" Grid.Row="1" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"  Background="Transparent" Content="Open" HorizontalAlignment="Stretch" />
                    </Border>
                    

                </Grid>
            </Border>
          
        </Grid >
        <TextBlock x:Name="seenStamp" Grid.Row="3" Text="{Binding seenStamp}"/>
    </Grid>
</UserControl>
