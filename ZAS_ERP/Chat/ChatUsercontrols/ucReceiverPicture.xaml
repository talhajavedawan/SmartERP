<UserControl x:Class="ZAS_ERP.Chat.ChatUsercontrols.ucReceiverPicture"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZAS_ERP.Chat.ChatUsercontrols"
             mc:Ignorable="d" 
             MinHeight="200" MinWidth="250" Height="auto" Width="auto" MouseDown="UserControl_MouseDown">
    <UserControl.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="45,0,0,0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border Name="MenuBorder" SnapsToDevicePixels="True" BorderBrush="Black" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" >
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Button.IsFocused" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter TargetName="MenuBorder" Property="BorderBrush" Value="#FFED6A2B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>


    <Grid Background="DarkOrange" >


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="brdAtt" Grid.Row="0" Grid.Column="0" BorderBrush="LightGreen" BorderThickness="2" CornerRadius="6"  Padding="5" Visibility="Collapsed" >
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Label x:Name="fileName" Content="Attachements" FontSize="24" HorizontalContentAlignment="Left" FontFamily="arialRounded" VerticalContentAlignment="Center" FontWeight="Bold" Padding="10" />
                    <Label x:Name="fileSize" Grid.Row="1" Content="102Kb Download Complete" FontSize="18" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  Padding="10"/>
                    <Image x:Name="fileIcon" Grid.Row="2"  HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="50" Margin="5,5,5,5"   />
                </Grid>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" BorderBrush="LightGray"  Background="Black" Margin="2,2,2,2"/>


                <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" HorizontalAlignment="Stretch" >
                    <Button x:Name="btnDownload" Grid.Row="1" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"  Background="Transparent" Content="Download" HorizontalAlignment="Stretch" />
                </Border>
                <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="3" HorizontalAlignment="Stretch" >
                    <Button x:Name="btnOpen" Grid.Row="1" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"  Background="Transparent" Content="Open" FontWeight="ExtraBold" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                </Border>
                <TextBlock x:Name="fileType" Visibility="Hidden"/>
                <TextBlock x:Name="localPath" Visibility="Hidden"/>
                <TextBlock x:Name="sender" Visibility="Hidden"/>
                <TextBlock x:Name="receiver" Visibility="Hidden"/>
                <TextBlock x:Name="downloadPath" Visibility="Hidden"/>


            </Grid>
        </Border>


        <Border x:Name="brdClickME" Grid.Row="0" Grid.Column="0" BorderBrush="LightGreen" BorderThickness="2" CornerRadius="6"  Padding="5" Visibility="Visible">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="1" Text="Click Me">

                </TextBlock>
                <Image Grid.Row="0" Source="/ZAS_ERP;component/images/down.png"/>

            </Grid>
        </Border>



    </Grid>
</UserControl>
